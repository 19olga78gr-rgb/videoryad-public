Dialogue: 0,0:00:00.10,0:00:02.68,Caption,,0,0,0,,ЕВРОПА СНОВА СОБИРАЕТСЯ НА ВОСТОК. БРИТАНИЯ
Dialogue: 0,0:00:02.68,0:00:05.16,Caption,,0,0,0,,ПОДТАЛКИВАЕТ, НАТО ПЕРЕСТРАИВАЕТСЯ,
Dialogue: 0,0:00:05.40,0:00:08.68,Caption,,0,0,0,,ГЕРМАНИЯ ВООРУЖАЕТСЯ. ВСЁ ВРОДЕ ПО ПЛАНУ. ТОЛЬКО
Dialogue: 0,0:00:08.68,0:00:11.16,Caption,,0,0,0,,ФРАНЦИЯ ПОЧЕМУ ТО ВМЕСТО АПЛОДИСМЕНТОВ НАЧАЛА
Dialogue: 0,0:00:11.16,0:00:13.40,Caption,,0,0,0,,ВНИМАТЕЛЬНО СМОТРЕТЬ НА БЕРЛИН И СПРАШИВАТЬ,
Dialogue: 0,0:00:13.72,0:00:16.44,Caption,,0,0,0,,ЧТО ИМЕННО НЕМЦЫ СОБИРАЮТСЯ ДЕЛАТЬ СО СВОИМИ НОВЫМИ
Dialogue: 0,0:00:16.44,0:00:19.24,Caption,,0,0,0,,ВОЗМОЖНОСТЯМИ. И ЗДЕСЬ ИСТОРИЯ НАЧИНАЕТ ОЧЕНЬ
Dialogue: 0,0:00:19.24,0:00:22.36,Caption,,0,0,0,,НЕХОРОШО УХМЫЛЯТЬСЯ. ПОТОМУ ЧТО ФРАНЦИЯ УЖЕ НЕ РАЗ
Dialogue: 0,0:00:22.44,0:00:25.88,Caption,,0,0,0,,ВИДЕЛА ВООРУЖЁННУЮ ГЕРМАНИЮ, КОТОРАЯ СНАЧАЛА ОБЪЯСНЯЛА,
Dialogue: 0,0:00:26.03,0:00:29.00,Caption,,0,0,0,,ЗАЧЕМ ЕЙ ВСЁ ЭТО ПОНАДОБИЛОСЬ. ПОДПИШИТЕСЬ НА КАНАЛ.
Dialogue: 0,0:00:29.24,0:00:31.56,Caption,,0,0,0,,ЗДЕСЬ МЫ КАК РАЗ И РАЗБИРАЕМ ТАКИЕ ИСТОРИИ,
Dialogue: 0,0:00:31.80,0:00:34.44,Caption,,0,0,0,,ГДЕ ОДНА СЕГОДНЯШНЯЯ НОВОСТЬ ВДРУГ ТЯНЕТ ЗА СОБОЙ
Dialogue: 0,0:00:34.52,0:00:37.88,Caption,,0,0,0,,ХВОСТ ДЛИНОЙ В НЕСКОЛЬКО ВЕКОВ. ПАРИЖ СЕЙЧАС ТРЕБУЕТ
Dialogue: 0,0:00:37.96,0:00:40.76,Caption,,0,0,0,,ОТ БЕРЛИНА ЯСНОСТИ ПО ПОВОДУ НОВОГО ДАЛЬНОБОЙНОГО
Dialogue: 0,0:00:40.76,0:00:44.36,Caption,,0,0,0,,ОРУЖИЯ. ВОПРОС У ФРАНЦУЗОВ ПРОСТОЙ. ЕСЛИ ГЕРМАНИЯ
Dialogue: 0,0:00:44.44,0:00:47.48,Caption,,0,0,0,,ПОЛУЧАЕТ РАКЕТЫ, СПОСОБНЫЕ БИТЬ НА ОГРОМНУЮ ГЛУБИНУ,
Dialogue: 0,0:00:47.73,0:00:50.12,Caption,,0,0,0,,КТО БУДЕТ РЕШАТЬ, КОГДА ИХ ПРИМЕНЯТЬ,
Dialogue: 0,0:00:50.43,0:00:53.16,Caption,,0,0,0,,ПО КАКИМ ЦЕЛЯМ И ЧТО ДЕЛАТЬ ПОСЛЕ ОТВЕТА?
Dialogue: 0,0:00:53.55,0:00:55.88,Caption,,0,0,0,,ПОТОМУ ЧТО КРАСИВОЕ СЛОВО "СДЕРЖИВАНИЕ" ХОРОШО
Dialogue: 0,0:00:55.88,0:00:59.96,Caption,,0,0,0,,ЗВУЧИТ ДО ТОГО МОМЕНТА, ПОКА КТО ТО ДЕЙСТВИТЕЛЬНО НЕ НАЖАЛ КНОПКУ. ПО
Dialogue: 0,0:01:00.04,0:01:03.96,Caption,,0,0,0,,ДАННЫМ FINANCIAL TIMES, ФРАНЦУЗСКИЕ ВОЕННЫЕ ПОТРЕБОВАЛИ ОТ ГЕРМАНИИ
Dialogue: 0,0:01:03.96,0:01:07.24,Caption,,0,0,0,,ОБЪЯСНИТЬ, КАК ИМЕННО БЕРЛИН СОБИРАЕТСЯ ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:01:07.24,0:01:10.60,Caption,,0,0,0,,РАЗРАБАТЫВАЕМЫЕ ДАЛЬНОБОЙНЫЕ СИСТЕМЫ. РЕЧЬ ИДЁТ НЕ О
Dialogue: 0,0:01:10.68,0:01:12.84,Caption,,0,0,0,,КАКОЙ ТО ВЫСТАВОЧНОЙ ИГРУШКЕ ДЛЯ ГЕНЕРАЛОВ.
Dialogue: 0,0:01:15.12,0:01:17.68,Caption,,0,0,0,,ЕВРОПА ВКЛАДЫВАЕТ ДЕСЯТКИ МИЛЛИАРДОВ ЕВРО В
Dialogue: 0,0:01:17.68,0:01:20.80,Caption,,0,0,0,,ДАЛЬНОБОЙНОЕ ОРУЖИЕ. ГЕРМАНИЯ И БРИТАНИЯ РАЗВИВАЮТ
Dialogue: 0,0:01:20.80,0:01:24.80,Caption,,0,0,0,,НОВЫЕ ВОЗМОЖНОСТИ, КОТОРЫЕ ДОЛЖНЫ ДОСТАВАТЬ ДАЛЕКО ЗА ПРЕДЕЛЫ НЫНЕШНЕЙ
Dialogue: 0,0:01:24.88,0:01:27.44,Caption,,0,0,0,,ЛИНИИ БОЕВЫХ ДЕЙСТВИЙ. И ВОТ ТУТ У ПАРИЖА
Dialogue: 0,0:01:27.44,0:01:30.40,Caption,,0,0,0,,ВКЛЮЧИЛАСЬ ПАМЯТЬ. ФРАНЦИЯ С ГЕРМАНИЕЙ ЗНАКОМА
Dialogue: 0,0:01:30.48,0:01:33.28,Caption,,0,0,0,,ДАВНО. ОЧЕНЬ ДАВНО. И ЗНАКОМСТВО У НИХ,
Dialogue: 0,0:01:33.36,0:01:37.60,Caption,,0,0,0,,МЯГКО ГОВОРЯ, НЕ ВСЕГДА ПРОХОДИЛО ЗА БОКАЛОМ ШАМПАНСКОГО. ФРАНКО
Dialogue: 0,0:01:37.68,0:01:40.24,Caption,,0,0,0,,ПРУССКАЯ ВОЙНА ЗАКОНЧИЛАСЬ ДЛЯ ФРАНЦИИ ПОРАЖЕНИЕМ.
Dialogue: 0,0:01:40.45,0:01:43.76,Caption,,0,0,0,,ПОТОМ БЫЛА ПЕРВАЯ МИРОВАЯ. ПОТОМ ВТОРАЯ МИРОВАЯ.
Dialogue: 0,0:01:44.08,0:01:46.80,Caption,,0,0,0,,МЕЖДУ ПАРИЖЕМ И БЕРЛИНОМ СЕГОДНЯ ОТКРЫТЫЕ ГРАНИЦЫ,
Dialogue: 0,0:01:46.91,0:01:50.88,Caption,,0,0,0,,ОБЩИЕ САММИТЫ, ОБЩИЙ РЫНОК И БЕСКОНЕЧНЫЕ РАЗГОВОРЫ О ЕВРОПЕЙСКОМ
Dialogue: 0,0:01:50.88,0:01:53.76,Caption,,0,0,0,,ЕДИНСТВЕ. НО ИСТОРИЧЕСКУЮ ПАМЯТЬ НА ПАСПОРТНОМ
Dialogue: 0,0:01:53.76,0:01:56.56,Caption,,0,0,0,,КОНТРОЛЕ НЕ СДАЮТ. ПОЭТОМУ ДЛЯ ФРАНЦИИ ВОПРОС О
Dialogue: 0,0:01:56.56,0:01:59.28,Caption,,0,0,0,,ВООРУЖЕНИИ ГЕРМАНИИ ИМЕЕТ ДВА СЛОЯ. ПЕРВЫЙ
Dialogue: 0,0:01:59.28,0:02:03.20,Caption,,0,0,0,,ОЧЕВИДНЫЙ. ЧТО БУДЕТ, ЕСЛИ НЕМЕЦКАЯ РАКЕТА ПОЛЕТИТ ПО РОССИЙСКОЙ
Dialogue: 0,0:02:03.20,0:02:07.36,Caption,,0,0,0,,ТЕРРИТОРИИ И МОСКВА РЕШИТ, ЧТО РЕЧЬ ИДЁТ УЖЕ О СТРАТЕГИЧЕСКОЙ УГРОЗЕ?
Dialogue: 0,0:02:07.76,0:02:10.80,Caption,,0,0,0,,А ВТОРОЙ НАМНОГО НЕПРИЯТНЕЕ. ЧТО ВООБЩЕ ПРОИСХОДИТ С
Dialogue: 0,0:02:10.80,0:02:12.88,Caption,,0,0,0,,БАЛАНСОМ СИЛ ВНУТРИ САМОЙ ЕВРОПЫ,
Dialogue: 0,0:02:13.12,0:02:15.76,Caption,,0,0,0,,ЕСЛИ ГЕРМАНИЯ СНОВА ПРЕВРАЩАЕТСЯ В КРУПНЕЙШУЮ
Dialogue: 0,0:02:15.76,0:02:20.00,Caption,,0,0,0,,ВОЕННУЮ СИЛУ КОНТИНЕНТА? И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ НАСТОЯЩАЯ ЕВРОПЕЙСКАЯ
Dialogue: 0,0:02:20.00,0:02:22.96,Caption,,0,0,0,,МАТЕМАТИКА. МАКРОН УЖЕ ДАВНО ГОВОРИТ О РАСШИРЕНИИ
Dialogue: 0,0:02:22.96,0:02:25.52,Caption,,0,0,0,,РОЛИ ФРАНЦУЗСКОГО ЯДЕРНОГО СДЕРЖИВАНИЯ В ЕВРОПЕ.
Dialogue: 0,0:02:25.68,0:02:30.68,Caption,,0,0,0,,КРАСИВО. ФРАНЦУЗСКАЯ АТОМНАЯ БОМБА ДОЛЖНА ДОБАВИТЬ
Dialogue: 0,0:02:30.68,0:02:33.80,Caption,,0,0,0,,УВЕРЕННОСТИ СОЮЗНИКАМ. ГЕРМАНИЯ ПОЛУЧАЕТ ВСЁ БОЛЬШЕ
Dialogue: 0,0:02:33.88,0:02:36.60,Caption,,0,0,0,,ОБЫЧНЫХ ВООРУЖЕНИЙ. БРИТАНИЯ ЗАНИМАЕТСЯ СВОИМ
Dialogue: 0,0:02:36.60,0:02:39.88,Caption,,0,0,0,,НАПРАВЛЕНИЕМ. ПОЛЬША УВЕЛИЧИВАЕТ АРМИЮ. ВРОДЕ ВСЕ
Dialogue: 0,0:02:39.88,0:02:42.76,Caption,,0,0,0,,РАБОТАЮТ НА ОДНУ ЗАДАЧУ. ТОЛЬКО ФРАНЦИЯ ПОЧЕМУ ТО
Dialogue: 0,0:02:42.84,0:02:44.92,Caption,,0,0,0,,НЕ РАССЛАБИЛАСЬ. И ВЕДЬ КАКАЯ ПОЛУЧАЕТСЯ
Dialogue: 0,0:02:44.92,0:02:48.20,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ ИСТОРИЯ. ФРАНЦИЯ ПРЕКРАСНО ПОМНИТ,
Dialogue: 0,0:02:48.37,0:02:52.52,Caption,,0,0,0,,ЧТО СЛУЧАЛОСЬ, КОГДА ГЕРМАНИЯ НАБИРАЛА ВОЕННУЮ СИЛУ. А ТЕПЕРЬ САМА
Dialogue: 0,0:02:52.52,0:02:55.40,Caption,,0,0,0,,УЧАСТВУЕТ В ЕЁ ВООРУЖЕНИИ. ДА ЕЩЁ И ЯДЕРНЫЙ
Dialogue: 0,0:02:55.40,0:02:58.28,Caption,,0,0,0,,ЗОНТИК ОБСУЖДАЕТ. ТО ЕСТЬ МАЛО НАМ СНОВА СИЛЬНОЙ
Dialogue: 0,0:02:58.28,0:03:01.80,Caption,,0,0,0,,НЕМЕЦКОЙ АРМИИ, ДАВАЙТЕ ЕЩЁ И АТОМНУЮ БОМБУ НАД НЕЙ РАСКРОЕМ.
Dialogue: 0,0:03:02.20,0:03:04.68,Caption,,0,0,0,,ПАРИЖ, ВЫ ТАМ ТОЧНО ВСЁ ХОРОШО ПОСЧИТАЛИ?
Dialogue: 0,0:03:05.00,0:03:09.48,Caption,,0,0,0,,ПОТОМУ ЧТО АТОМНЫЙ ЗОНТИК, ЭТО НЕ ЗОНТИК ВОЗЛЕ КАФЕ. ЕГО НЕЛЬЗЯ ОТКРЫТЬ
Dialogue: 0,0:03:09.48,0:03:12.44,Caption,,0,0,0,,НАД ПОЛОВИНОЙ ЕВРОПЫ, А ПОТОМ СКАЗАТЬ НУ ЕСЛИ ЧТО,
Dialogue: 0,0:03:12.53,0:03:15.64,Caption,,0,0,0,,КАЖДЫЙ САМ ЗА СЕБЯ. ЕСЛИ НЕМЕЦКАЯ РАКЕТА СОЗДАЁТ
Dialogue: 0,0:03:15.72,0:03:19.32,Caption,,0,0,0,,УГРОЗУ ЭСКАЛАЦИИ, А ФРАНЦИЯ БЕРЁТ НА СЕБЯ ДОПОЛНИТЕЛЬНУЮ РОЛЬ В
Dialogue: 0,0:03:19.32,0:03:23.24,Caption,,0,0,0,,ЯДЕРНОМ СДЕРЖИВАНИИ, У ПАРИЖА ПОЯВЛЯЕТСЯ ОЧЕНЬ КОНКРЕТНЫЙ ВОПРОС.
Dialogue: 0,0:03:23.58,0:03:27.80,Caption,,0,0,0,,ГЕРМАНИЯ ПРИНИМАЕТ РЕШЕНИЕ, А КТО ПОТОМ БУДЕТ РАЗГРЕБАТЬ ПОСЛЕДСТВИЯ?
Dialogue: 0,0:03:28.04,0:03:30.52,Caption,,0,0,0,,ВОТ ЭТО УЖЕ ГОРАЗДО ИНТЕРЕСНЕЕ ЛЮБЫХ РЕЧЕЙ ПРО
Dialogue: 0,0:03:30.60,0:03:33.56,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ЕДИНСТВО. И БРИТАНИЯ В ЭТОЙ КОНСТРУКЦИИ
Dialogue: 0,0:03:33.64,0:03:39.28,Caption,,0,0,0,,ВООБЩЕ ОТДЕЛЬНАЯ ПЕСНЯ. БЫВШИЙ СОВЕТНИК ПО НАЦИОНАЛЬНОЙ БЕЗОПАСНОСТИ
Dialogue: 0,0:03:39.28,0:03:41.68,Caption,,0,0,0,,БРИТАНИИ МАРК СЕДВИЛЛ ПРЯМО ГОВОРИТ,
Dialogue: 0,0:03:41.92,0:03:44.16,Caption,,0,0,0,,ЧТО НАТО ДОЛЖНО НЕ ТОЛЬКО ОБОРОНЯТЬСЯ,
Dialogue: 0,0:03:44.40,0:03:47.36,Caption,,0,0,0,,НО И СОЗДАВАТЬ РОССИИ СТРАТЕГИЧЕСКИЕ ДИЛЕММЫ. ТО
Dialogue: 0,0:03:47.36,0:03:49.36,Caption,,0,0,0,,ЕСТЬ НЕ СИДЕТЬ ЗА ЗАБОРОМ С ТАБЛИЧКОЙ "НЕ
Dialogue: 0,0:03:49.36,0:03:53.20,Caption,,0,0,0,,ВХОДИТЬ", А САМИМ СОЗДАВАТЬ ДАВЛЕНИЕ. СРЕДИ ПРЕДЛОЖЕНИЙ
Dialogue: 0,0:03:53.20,0:03:56.64,Caption,,0,0,0,,КИБЕРАТАКИ, ДАВЛЕНИЕ НА ТАК НАЗЫВАЕМЫЙ ТЕНЕВОЙ ФЛОТ,
Dialogue: 0,0:03:56.88,0:03:59.36,Caption,,0,0,0,,РАБОТА ПРОТИВ РОССИЙСКИХ РАЗВЕДЫВАТЕЛЬНЫХ СЕТЕЙ,
Dialogue: 0,0:03:59.52,0:04:02.64,Caption,,0,0,0,,ИНФОРМАЦИОННЫЕ ОПЕРАЦИИ. СЕДВИЛЛ СЕЙЧАС НЕ ЗАНИМАЕТ
Dialogue: 0,0:04:02.64,0:04:05.36,Caption,,0,0,0,,ГОСУДАРСТВЕННУЮ ДОЛЖНОСТЬ. НО ИНТЕРЕСЕН САМ ХОД
Dialogue: 0,0:04:05.36,0:04:08.64,Caption,,0,0,0,,МЫСЛИ. ЛОНДОНСКАЯ ШКОЛА НИКУДА НЕ ДЕЛАСЬ. ДАВИТЬ
Dialogue: 0,0:04:08.64,0:04:12.16,Caption,,0,0,0,,НАДО. СТАВКИ НАДО ПОВЫШАТЬ. ПРОБЛЕМЫ ПРОТИВНИКУ НАДО
Dialogue: 0,0:04:12.16,0:04:15.12,Caption,,0,0,0,,СОЗДАВАТЬ ЗАРАНЕЕ. МЫ ЭТУ ЛИНИЮ УЖЕ ВИДЕЛИ. КОГДА
Dialogue: 0,0:04:15.12,0:04:17.76,Caption,,0,0,0,,БРИТАНИИ ПОНАДОБИЛСЯ ПРЯМОЙ ВОЕННЫЙ КАНАЛ СВЯЗИ С
Dialogue: 0,0:04:17.76,0:04:20.80,Caption,,0,0,0,,МОСКВОЙ, ЭТО СОВСЕМ НЕ ВЫГЛЯДЕЛО КАК ВНЕЗАПНАЯ ЛЮБОВЬ К
Dialogue: 0,0:04:20.80,0:04:23.84,Caption,,0,0,0,,МИРНЫМ ПЕРЕГОВОРАМ. ПЯТЬ ЛЕТ ПЛАНКА ЭСКАЛАЦИИ
Dialogue: 0,0:04:23.84,0:04:26.64,Caption,,0,0,0,,ДВИГАЛАСЬ ВСЁ ВЫШЕ. РАКЕТЫ, РАЗВЕДКА,
Dialogue: 0,0:04:26.76,0:04:30.88,Caption,,0,0,0,,НОВЫЕ РАЗРЕШЕНИЯ, НОВЫЕ ЗОНЫ ПРИМЕНЕНИЯ. И В КАКОЙ ТО МОМЕНТ
Dialogue: 0,0:04:30.96,0:04:34.96,Caption,,0,0,0,,СТАЛО ПОНЯТНО, ЧТО СЛЕДУЮЩИЙ ШАГ УЖЕ МОЖЕТ ПРИЛЕТЕТЬ ОБРАТНО СОВСЕМ
Dialogue: 0,0:04:35.04,0:04:38.40,Caption,,0,0,0,,НЕ ТУДА, КУДА ХОТЕЛОСЬ БЫ. ВОТ ТОГДА ТЕЛЕФОН ПОЧЕМУ ТО
Dialogue: 0,0:04:38.40,0:04:40.80,Caption,,0,0,0,,РЕЗКО СТАЛ ПОЛЕЗНОЙ ВЕЩЬЮ. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:04:40.80,0:04:43.36,Caption,,0,0,0,,КОНСТРУКЦИЯ. МЫ ДАЛЬШЕ БУДЕМ ПОВЫШАТЬ СТАВКИ,
Dialogue: 0,0:04:43.68,0:04:45.52,Caption,,0,0,0,,НО НА ВСЯКИЙ СЛУЧАЙ ДАВАЙТЕ ИМЕТЬ НОМЕР,
Dialogue: 0,0:04:45.84,0:04:47.60,Caption,,0,0,0,,ПО КОТОРОМУ МОЖНО БЫСТРО ОБЪЯСНИТЬ,
Dialogue: 0,0:04:47.76,0:04:49.28,Caption,,0,0,0,,ЧТО ВЫ НАС НЕПРАВИЛЬНО ПОНЯЛИ.
Dialogue: 0,0:04:51.49,0:04:53.65,Caption,,0,0,0,,ПО УКРАИНЕ ПУСКАЙ ЛЕТИТ. А ЕСЛИ ЧТО ТО
Dialogue: 0,0:04:53.65,0:04:55.81,Caption,,0,0,0,,ПОЛЕТИТ В СТОРОНУ ЛОНДОНА, ТУТ УЖЕ,
Dialogue: 0,0:04:55.99,0:04:58.21,Caption,,0,0,0,,ПОЖАЛУЙСТА, ДАВАЙТЕ БЕЗ РЕЗКИХ ДВИЖЕНИЙ.
Dialogue: 0,0:04:58.76,0:05:01.73,Caption,,0,0,0,,И СЕЙЧАС БРИТАНСКАЯ ЛИНИЯ СНОВА ВИДНА. СЕДВИЛЛ
Dialogue: 0,0:05:01.73,0:05:04.61,Caption,,0,0,0,,ПРЕДЛАГАЕТ ЗАСТАВИТЬ МОСКВУ ЧУВСТВОВАТЬ УГРОЗУ. НО
Dialogue: 0,0:05:04.61,0:05:07.57,Caption,,0,0,0,,РЯДОМ СИДИТ НОРВЕЖСКИЙ ВИЦЕ АДМИРАЛ РУНЕ АНДЕРСЕН И
Dialogue: 0,0:05:07.57,0:05:10.77,Caption,,0,0,0,,ГОВОРИТ ВЕЩЬ ГОРАЗДО МЕНЕЕ ВЕСЁЛУЮ. НАТО ДОЛЖНО
Dialogue: 0,0:05:10.77,0:05:14.05,Caption,,0,0,0,,ПОНИМАТЬ, КАК ЕГО ДЕЙСТВИЯ ВОСПРИНИМАЕТ РОССИЙСКАЯ СТОРОНА,
Dialogue: 0,0:05:14.37,0:05:18.93,Caption,,0,0,0,,И НЕ СОЗДАВАТЬ СИТУАЦИЮ, ГДЕ ДВЕ СТОРОНЫ НЕПРАВИЛЬНО ОЦЕНИЛИ НАМЕРЕНИЯ ДРУГ
Dialogue: 0,0:05:19.01,0:05:22.05,Caption,,0,0,0,,ДРУГА. ЕЩЁ ЖЁСТЧЕ ГОВОРИТ РОБ ДЖОНСОН ИЗ ОКСФОРДА.
Dialogue: 0,0:05:22.37,0:05:24.37,Caption,,0,0,0,,ВОЕННЫЕ ИЗДЕРЖКИ, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:05:24.60,0:05:27.73,Caption,,0,0,0,,ТОЛЬКО ВЫЗОВУТ ОТВЕТНЫЕ МЕРЫ. ТО ЕСТЬ ВНУТРИ ОДНОЙ
Dialogue: 0,0:05:27.73,0:05:30.85,Caption,,0,0,0,,ЗАПАДНОЙ ДИСКУССИИ УЖЕ ТРИ РАЗНЫХ ПОДХОДА. ОДИН
Dialogue: 0,0:05:30.93,0:05:34.05,Caption,,0,0,0,,ГОВОРИТ ДАВИТЬ СИЛЬНЕЕ. ВТОРОЙ ГОВОРИТ ОСТОРОЖНЕЕ,
Dialogue: 0,0:05:34.13,0:05:37.33,Caption,,0,0,0,,МОЖНО НАРВАТЬСЯ. ТРЕТИЙ ГОВОРИТ ВОЕННЫМ ПУТЁМ ВООБЩЕ
Dialogue: 0,0:05:37.41,0:05:41.25,Caption,,0,0,0,,НЕ ЛЕЗЬТЕ, ПОЛУЧИТЕ ОТВЕТ. ВОТ ВАМ И ЕДИНАЯ СТРАТЕГИЯ. А
Dialogue: 0,0:05:41.25,0:05:43.57,Caption,,0,0,0,,ТЕПЕРЬ НА ЭТОТ ФОН НАКЛАДЫВАЕТСЯ КРУПНЕЙШАЯ
Dialogue: 0,0:05:43.57,0:05:46.93,Caption,,0,0,0,,ПЕРЕСТРОЙКА НАТО ЗА ДВА ДЕСЯТИЛЕТИЯ. АЛЬЯНС МЕНЯЕТ
Dialogue: 0,0:05:47.01,0:05:50.05,Caption,,0,0,0,,САМ ПРИНЦИП ВОЕННОГО ПЛАНИРОВАНИЯ. РАНЬШЕ СОЮЗНИКИ
Dialogue: 0,0:05:50.05,0:05:52.21,Caption,,0,0,0,,ДОЛЖНЫ БЫЛИ ДЕРЖАТЬ ЧАСТЬ СИЛ ДЛЯ КРИЗИСОВ НА
Dialogue: 0,0:05:52.29,0:05:56.45,Caption,,0,0,0,,БЛИЖНЕМ ВОСТОКЕ, В АФРИКЕ И ДРУГИХ РЕГИОНАХ. ТЕПЕРЬ ЭТУ СИСТЕМУ
Dialogue: 0,0:05:56.45,0:06:01.77,Caption,,0,0,0,,СОБИРАЮТСЯ ПЕРЕДЕЛЫВАТЬ. ВОСЕМНАДЦАТЬ РЕЗЕРВНЫХ БРИГАД,
Dialogue: 0,0:06:01.91,0:06:03.93,Caption,,0,0,0,,ОКОЛО ДЕВЯНОСТА ТЫСЯЧ ВОЕННОСЛУЖАЩИХ,
Dialogue: 0,0:06:04.25,0:06:06.73,Caption,,0,0,0,,КОТОРЫЕ РАНЬШЕ ПРЕДПОЛАГАЛОСЬ ДЕРЖАТЬ ДЛЯ ВНЕШНИХ
Dialogue: 0,0:06:06.73,0:06:09.85,Caption,,0,0,0,,КРИЗИСОВ, СТАНОВЯТСЯ УЖЕ НЕ ТАКОЙ ОБЯЗАТЕЛЬНОЙ ЧАСТЬЮ
Dialogue: 0,0:06:09.85,0:06:13.85,Caption,,0,0,0,,КОНСТРУКЦИИ. ПОЧЕМУ? ПОТОМУ ЧТО ГЛАВНЫЙ СЦЕНАРИЙ ТЕПЕРЬ НАХОДИТСЯ В
Dialogue: 0,0:06:13.85,0:06:15.85,Caption,,0,0,0,,ЕВРОПЕ. КАЖДОЙ СТРАНЕ СЧИТАЮТ,
Dialogue: 0,0:06:16.01,0:06:17.93,Caption,,0,0,0,,СКОЛЬКО ОНА ДОЛЖНА ИМЕТЬ ЛЮДЕЙ,
Dialogue: 0,0:06:18.01,0:06:23.45,Caption,,0,0,0,,САМОЛЁТОВ, СИСТЕМ ПВО, РАКЕТ И ДРУГИХ СРЕДСТВ ДЛЯ БОЛЬШОГО ПРОТИВОСТОЯНИЯ
Dialogue: 0,0:06:23.53,0:06:26.57,Caption,,0,0,0,,НА ЕВРОПЕЙСКОМ НАПРАВЛЕНИИ. И ЗДЕСЬ ВАШИНГТОН ДЕЛАЕТ
Dialogue: 0,0:06:26.66,0:06:29.29,Caption,,0,0,0,,ОЧЕНЬ АМЕРИКАНСКИЙ ФОКУС. ЕВРОПА ДОЛЖНА БЫТЬ
Dialogue: 0,0:06:29.29,0:06:32.81,Caption,,0,0,0,,СИЛЬНЕЕ. ЕВРОПА ДОЛЖНА БОЛЬШЕ ТРАТИТЬ. ЕВРОПА ДОЛЖНА
Dialogue: 0,0:06:32.81,0:06:35.69,Caption,,0,0,0,,ВЗЯТЬ НА СЕБЯ БОЛЬШЕ ОТВЕТСТВЕННОСТИ. А АМЕРИКАНЦЕВ
Dialogue: 0,0:06:35.77,0:06:38.41,Caption,,0,0,0,,ПРИ ЭТОМ МОЖНО ОСТАВИТЬ МЕНЬШЕ. США СОБИРАЮТСЯ
Dialogue: 0,0:06:38.41,0:06:40.97,Caption,,0,0,0,,СОКРАЩАТЬ ЧАСТЬ СВОЕГО КОНТИНГЕНТА В ЕВРОПЕ,
Dialogue: 0,0:06:41.29,0:06:43.93,Caption,,0,0,0,,А СОЮЗНИКАМ ПРЕДЛАГАЮТ УВЕЛИЧИВАТЬ ВОЕННЫЕ РАСХОДЫ
Dialogue: 0,0:06:44.01,0:06:47.77,Caption,,0,0,0,,ДО ПЯТИ ПРОЦЕНТОВ ВВП. КРАСИВО. ПЯТЬ ЛЕТ ЕВРОПЕЙЦАМ
Dialogue: 0,0:06:47.77,0:06:51.53,Caption,,0,0,0,,РАССКАЗЫВАЛИ, ЧТО ВСЁ ЭТО ОБЩАЯ БОРЬБА. ТЕПЕРЬ ПРИХОДИТ СЧЁТ,
Dialogue: 0,0:06:51.77,0:06:54.33,Caption,,0,0,0,,А КАССИР ПОЧЕМУ ТО СМОТРИТ ИМЕННО НА ЕВРОПУ.
Dialogue: 0,0:06:54.71,0:06:57.53,Caption,,0,0,0,,КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР БЕЗ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:06:57.53,0:07:00.57,Caption,,0,0,0,,ЖВАЧКИ, ПОДПИШИТЕСЬ. ДАЛЬШЕ СТАНОВИТСЯ ЕЩЁ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:07:00.76,0:07:03.37,Caption,,0,0,0,,ПОТОМУ ЧТО СЛЕДУЮЩИЙ УЧАСТНИК ЭТОЙ ИСТОРИИ ПОЛЬША.
Dialogue: 0,0:07:03.82,0:07:07.53,Caption,,0,0,0,,ДОНАЛЬД ТУСК ОБЪЯВИЛ, ЧТО ПОЛЬША СПРАВИТСЯ С ВНЕШНИМ ПРОТИВНИКОМ,
Dialogue: 0,0:07:07.77,0:07:09.85,Caption,,0,0,0,,СОЗДАЁТ КРУПНЕЙШУЮ АРМИЮ РЕГИОНА,
Dialogue: 0,0:07:10.17,0:07:12.41,Caption,,0,0,0,,А БАЛТИЙСКОЕ МОРЕ СТАНОВИТСЯ ПОЛЬСКИМ МОРЕМ.
Dialogue: 0,0:07:14.69,0:07:17.89,Caption,,0,0,0,,ВОТ ТУТ ХОЧЕТСЯ УТОЧНИТЬ ГЕОГРАФИЮ. БАЛТИЙСКОЕ МОРЕ
Dialogue: 0,0:07:17.97,0:07:22.13,Caption,,0,0,0,,ПОКА ЕЩЁ НЕ ЗАМЕТИЛО, ЧТО СМЕНИЛО ВЛАДЕЛЬЦА. НО РИТОРИКА ВАЖНА НЕ САМА
Dialogue: 0,0:07:22.21,0:07:26.13,Caption,,0,0,0,,ПО СЕБЕ. ОНА ПОКАЗЫВАЕТ, КАКУЮ РОЛЬ ВАРШАВА ХОЧЕТ ЗАНИМАТЬ В НОВОЙ
Dialogue: 0,0:07:26.13,0:07:29.33,Caption,,0,0,0,,КОНСТРУКЦИИ. ПОЛЬША ДАВНО НАРАЩИВАЕТ ВООРУЖЁННЫЕ
Dialogue: 0,0:07:29.41,0:07:32.85,Caption,,0,0,0,,СИЛЫ. КАЛИНИНГРАД РЯДОМ. ГЕРМАНИЯ РЯДОМ. БАЛТИЯ
Dialogue: 0,0:07:32.85,0:07:36.53,Caption,,0,0,0,,РЯДОМ. РОССИЯ РЯДОМ. И ЕСЛИ НАТО ПЕРЕНОСИТ ОСНОВНОЙ
Dialogue: 0,0:07:36.53,0:07:40.61,Caption,,0,0,0,,ВОЕННЫЙ ФОКУС В ЕВРОПУ, ПОЛЬША АВТОМАТИЧЕСКИ ПОЛУЧАЕТ ГОРАЗДО БОЛЬШИЙ
Dialogue: 0,0:07:40.69,0:07:43.65,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ И ВОЕННЫЙ ВЕС. ПОЭТОМУ ФРАЗА ПРО
Dialogue: 0,0:07:43.65,0:07:47.25,Caption,,0,0,0,,ПОЛЬСКОЕ МОРЕ, ЭТО НЕ ПРОСТО КРАСИВЫЙ ЗВУК ДЛЯ МИТИНГА. ЭТО
Dialogue: 0,0:07:47.25,0:07:50.13,Caption,,0,0,0,,ЗАЯВКА НА МЕСТО ОДНОГО ИЗ ГЛАВНЫХ ИГРОКОВ СЕВЕРО
Dialogue: 0,0:07:50.13,0:07:52.61,Caption,,0,0,0,,ВОСТОЧНОГО НАПРАВЛЕНИЯ. ПАРАЛЛЕЛЬНО РОССИЙСКАЯ
Dialogue: 0,0:07:52.61,0:07:54.93,Caption,,0,0,0,,СТОРОНА СООБЩИЛА О ЛИКВИДАЦИИ СЕТИ,
Dialogue: 0,0:07:55.17,0:07:57.33,Caption,,0,0,0,,КОТОРУЮ СВЯЗЫВАЕТ С ПОЛЬСКИМИ СПЕЦСЛУЖБАМИ В
Dialogue: 0,0:07:57.33,0:08:00.05,Caption,,0,0,0,,КАЛИНИНГРАДСКОЙ ОБЛАСТИ. И СНОВА ОДИН И ТОТ ЖЕ
Dialogue: 0,0:08:00.05,0:08:03.33,Caption,,0,0,0,,РИСУНОК. ВОЕННАЯ ИНФРАСТРУКТУРА ДВИЖЕТСЯ НА ВОСТОК.
Dialogue: 0,0:08:03.59,0:08:05.97,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНАЯ АКТИВНОСТЬ ДВИЖЕТСЯ НА ВОСТОК.
Dialogue: 0,0:08:06.22,0:08:09.17,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ РИТОРИКА ДВИЖЕТСЯ НА ВОСТОК. ДЕНЬГИ
Dialogue: 0,0:08:09.17,0:08:11.65,Caption,,0,0,0,,ДВИЖУТСЯ ТУДА ЖЕ. НО У ЭТОГО ДВИЖЕНИЯ НА
Dialogue: 0,0:08:11.65,0:08:14.53,Caption,,0,0,0,,ВОСТОК ЕСТЬ ЕЩЁ ОДНА СТОРОНА. ВОЗМОЖНО,
Dialogue: 0,0:08:14.69,0:08:19.41,Caption,,0,0,0,,ЕГО ИСТОРИЯ НАМНОГО ДЛИННЕЕ, ЧЕМ ПРИНЯТО СЧИТАТЬ. И ЗДЕСЬ ВОЗНИКАЕТ ИНТЕРЕСНЫЙ
Dialogue: 0,0:08:19.41,0:08:22.69,Caption,,0,0,0,,ВОПРОС. А НЫНЕШНИЙ КОНФЛИКТ ТОЧНО НАЧАЛСЯ ТОЛЬКО
Dialogue: 0,0:08:22.69,0:08:28.34,Caption,,0,0,0,,СЕЙЧАС? ИЛИ ЭТО ПРОДОЛЖЕНИЕ ГОРАЗДО БОЛЕЕ СТАРОЙ ИСТОРИИ,
Dialogue: 0,0:08:28.52,0:08:31.30,Caption,,0,0,0,,КОТОРАЯ ТЯНЕТСЯ ЕЩЁ ОТ РАСПАДА РОССИЙСКОЙ ИМПЕРИИ,
Dialogue: 0,0:08:31.53,0:08:33.70,Caption,,0,0,0,,РЕВОЛЮЦИЙ ТЫСЯЧА ДЕВЯТЬСОТ СЕМНАДЦАТОГО ГОДА И
Dialogue: 0,0:08:33.78,0:08:38.02,Caption,,0,0,0,,ГРАЖДАНСКОЙ ВОЙНЫ? В ОТВЕТ "ЗЕРАДА" ПОШЛА ЕЩЁ ДАЛЬШЕ. НЕ СТО
Dialogue: 0,0:08:38.10,0:08:43.14,Caption,,0,0,0,,ЛЕТ. ТЫСЯЧУ. ЛОГИКА ТАКАЯ. ЕВРОПА ИСТОРИЧЕСКИ ИСПЫТЫВАЕТ ДЕФИЦИТ
Dialogue: 0,0:08:43.14,0:08:46.26,Caption,,0,0,0,,ЧАСТИ РЕСУРСОВ. ВОСТОК ЭТИМИ РЕСУРСАМИ БОГАТ.
Dialogue: 0,0:08:46.57,0:08:48.82,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ ЦЕНТРЫ МЕНЯЛИСЬ. КИЕВ,
Dialogue: 0,0:08:48.90,0:08:53.62,Caption,,0,0,0,,НОВГОРОД, МОСКВА, ПЕТЕРБУРГ. ГОСУДАРСТВЕННЫЕ ФОРМЫ МЕНЯЛИСЬ. ИМПЕРИИ
Dialogue: 0,0:08:53.62,0:08:58.10,Caption,,0,0,0,,ПОЯВЛЯЛИСЬ, РАСПАДАЛИСЬ, СОБИРАЛИСЬ СНОВА. А НАПРАВЛЕНИЕ СТОЛКНОВЕНИЯ
Dialogue: 0,0:08:58.10,0:09:01.38,Caption,,0,0,0,,УДИВИТЕЛЬНО ЧАСТО ОСТАВАЛОСЬ ТЕМ ЖЕ. ЗАПАД И ВОСТОК.
Dialogue: 0,0:09:01.78,0:09:04.42,Caption,,0,0,0,,И ЗДЕСЬ ГЛАВНОЕ НЕ ПРЕВРАЩАТЬ ТЫСЯЧУ ЛЕТ ИСТОРИИ
Dialogue: 0,0:09:04.42,0:09:07.22,Caption,,0,0,0,,В ОДНУ ПРЯМУЮ ЛИНИЮ. ПОТОМУ ЧТО НАПОЛЕОН,
Dialogue: 0,0:09:07.30,0:09:10.58,Caption,,0,0,0,,КАЙЗЕР, ГИТЛЕР, СОВРЕМЕННЫЙ ЕВРОСОЮЗ И НАТО,
Dialogue: 0,0:09:10.89,0:09:12.98,Caption,,0,0,0,,ЭТО НЕ ОДНА И ТА ЖЕ ПОЛИТИЧЕСКАЯ СИСТЕМА
Dialogue: 0,0:09:13.06,0:09:14.82,Caption,,0,0,0,,И НЕ ОДИН И ТОТ ЖЕ НАБОР ЦЕЛЕЙ.
Dialogue: 0,0:09:15.05,0:09:17.46,Caption,,0,0,0,,НО САМА ПОВТОРЯЕМОСТЬ НАПРАВЛЕНИЯ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:09:17.46,0:09:20.42,Caption,,0,0,0,,БРОСАЕТСЯ В ГЛАЗА. КОГДА ЕВРОПА СТАЛКИВАЛАСЬ С
Dialogue: 0,0:09:20.42,0:09:22.82,Caption,,0,0,0,,НЕХВАТКОЙ ПРОСТРАНСТВА, РЕСУРСОВ,
Dialogue: 0,0:09:22.92,0:09:27.06,Caption,,0,0,0,,РЫНКОВ ИЛИ ВЛИЯНИЯ, ВОСТОК РЕГУЛЯРНО СТАНОВИЛСЯ ОДНИМ ИЗ НАПРАВЛЕНИЙ
Dialogue: 0,0:09:27.06,0:09:29.30,Caption,,0,0,0,,ДАВЛЕНИЯ. И СЕГОДНЯ МЫ ОПЯТЬ ВИДИМ,
Dialogue: 0,0:09:29.54,0:09:32.50,Caption,,0,0,0,,КАК ОГРОМНЫЙ ВОЕННЫЙ МЕХАНИЗМ РАЗВОРАЧИВАЕТСЯ ИМЕННО
Dialogue: 0,0:09:32.58,0:09:35.46,Caption,,0,0,0,,ТУДА. ТОЛЬКО ТЕПЕРЬ НИКТО НЕ СОБИРАЕТ РЫЦАРЕЙ ВОЗЛЕ
Dialogue: 0,0:09:35.46,0:09:38.74,Caption,,0,0,0,,ЗАМКА И НЕ ОБЪЯВЛЯЕТ ПОХОД ЧЕРЕЗ ГЛАШАТАЯ. ТЕПЕРЬ
Dialogue: 0,0:09:38.74,0:09:40.98,Caption,,0,0,0,,СОБИРАЮТ САММИТ. УТВЕРЖДАЮТ БЮДЖЕТ.
Dialogue: 0,0:09:43.25,0:09:45.97,Caption,,0,0,0,,РИСУЮТ ТРЕБОВАНИЯ ПО ЧИСЛУ САМОЛЁТОВ. СЧИТАЮТ
Dialogue: 0,0:09:45.97,0:09:49.17,Caption,,0,0,0,,БРИГАДЫ. ПОКУПАЮТ РАКЕТЫ. И ВСЁ ВЫГЛЯДИТ ОЧЕНЬ
Dialogue: 0,0:09:49.17,0:09:52.21,Caption,,0,0,0,,СОВРЕМЕННО. ХОТЯ НАПРАВЛЕНИЕ СТАРОЕ. ОСОБЕННО
Dialogue: 0,0:09:52.21,0:09:54.85,Caption,,0,0,0,,ИНТЕРЕСНА ЗДЕСЬ ФРАНЦУЗСКАЯ ПОЗИЦИЯ. ПОТОМУ ЧТО
Dialogue: 0,0:09:54.85,0:09:57.17,Caption,,0,0,0,,ФРАНЦИЯ ТОЖЕ МНОГО РАЗ ХОДИЛА НА ВОСТОК.
Dialogue: 0,0:09:57.41,0:10:00.29,Caption,,0,0,0,,НАПОЛЕОНОВСКАЯ АРМИЯ ДОШЛА ДО МОСКВЫ. НО ФРАНЦИЯ
Dialogue: 0,0:10:00.29,0:10:03.41,Caption,,0,0,0,,ОДНОВРЕМЕННО ВЕКАМИ ВОЕВАЛА С ГЕРМАНИЕЙ. ВОТ ВАМ И
Dialogue: 0,0:10:03.41,0:10:06.61,Caption,,0,0,0,,ГЛАВНАЯ ЕВРОПЕЙСКАЯ ШИЗОФРЕНИЯ СЕГОДНЯШНЕГО ДНЯ. С
Dialogue: 0,0:10:06.61,0:10:10.69,Caption,,0,0,0,,ОДНОЙ СТОРОНЫ, ПАРИЖ УЧАСТВУЕТ В ОБЩЕЙ ЛИНИИ ПРОТИВ РОССИИ. С
Dialogue: 0,0:10:10.69,0:10:13.97,Caption,,0,0,0,,ДРУГОЙ, ЧЕМ СИЛЬНЕЕ ДЛЯ ЭТОГО ВООРУЖАЕТСЯ ГЕРМАНИЯ,
Dialogue: 0,0:10:14.29,0:10:16.85,Caption,,0,0,0,,ТЕМ ВНИМАТЕЛЬНЕЕ ПАРИЖ НАЧИНАЕТ СМОТРЕТЬ УЖЕ НЕ НА
Dialogue: 0,0:10:16.85,0:10:20.45,Caption,,0,0,0,,МОСКВУ, А НА БЕРЛИН. ПОТОМУ ЧТО РОССИЯ ДАЛЕКО. А
Dialogue: 0,0:10:20.45,0:10:25.49,Caption,,0,0,0,,ГЕРМАНИЯ ЧЕРЕЗ ГРАНИЦУ. ИСТОРИЯ В ТАКИХ ВОПРОСАХ ОЧЕНЬ ПОРТИТ НАСТРОЕНИЕ.
Dialogue: 0,0:10:25.81,0:10:28.29,Caption,,0,0,0,,МАКРОН МОЖЕТ СКОЛЬКО УГОДНО ГОВОРИТЬ О ЕВРОПЕЙСКОЙ
Dialogue: 0,0:10:28.37,0:10:31.33,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ АВТОНОМИИ. БЕРЛИН МОЖЕТ ОБЪЯСНЯТЬ,
Dialogue: 0,0:10:31.57,0:10:34.13,Caption,,0,0,0,,ЧТО НОВЫЕ РАКЕТЫ НУЖНЫ ДЛЯ СДЕРЖИВАНИЯ РОССИИ.
Dialogue: 0,0:10:34.37,0:10:37.33,Caption,,0,0,0,,БРИТАНИЯ МОЖЕТ ПОДТАЛКИВАТЬ СОЮЗНИКОВ ВПЕРЁД. НО
Dialogue: 0,0:10:37.33,0:10:40.69,Caption,,0,0,0,,ФРАНЦИЯ ПРЕКРАСНО ЗНАЕТ ОДНУ ПРОСТУЮ ВЕЩЬ. ВОЕННЫЕ
Dialogue: 0,0:10:40.69,0:10:42.85,Caption,,0,0,0,,ВОЗМОЖНОСТИ СОЗДАЮТСЯ ПОД ОДНУ УГРОЗУ,
Dialogue: 0,0:10:43.09,0:10:46.29,Caption,,0,0,0,,А ЖИВУТ ПОТОМ ДЕСЯТИЛЕТИЯМИ. ПРАВИТЕЛЬСТВА МЕНЯЮТСЯ.
Dialogue: 0,0:10:46.53,0:10:50.61,Caption,,0,0,0,,КАНЦЛЕРЫ МЕНЯЮТСЯ. СОЮЗЫ МЕНЯЮТСЯ. РАКЕТА ОСТАЁТСЯ.
Dialogue: 0,0:10:50.88,0:10:54.29,Caption,,0,0,0,,АРМИЯ ОСТАЁТСЯ. ПРОМЫШЛЕННОСТЬ ОСТАЁТСЯ. И ЭТО УЖЕ
Dialogue: 0,0:10:54.37,0:10:57.81,Caption,,0,0,0,,РАЗГОВОР НЕ О ТОМ, ДОВЕРЯЕТ ЛИ МАКРОН НЫНЕШНЕМУ НЕМЕЦКОМУ
Dialogue: 0,0:10:57.81,0:11:01.93,Caption,,0,0,0,,ПРАВИТЕЛЬСТВУ. ЭТО РАЗГОВОР О ТОМ,
Dialogue: 0,0:11:02.09,0:11:04.81,Caption,,0,0,0,,КАКУЮ ГЕРМАНИЮ ФРАНЦИЯ ПОЛУЧИТ ЧЕРЕЗ ДЕСЯТЬ,
Dialogue: 0,0:11:04.95,0:11:09.61,Caption,,0,0,0,,ДВАДЦАТЬ ИЛИ ТРИДЦАТЬ ЛЕТ, ЕСЛИ БЕРЛИН СНОВА СТАНЕТ КРУПНЕЙШЕЙ ВОЕННОЙ СИЛОЙ
Dialogue: 0,0:11:09.69,0:11:13.37,Caption,,0,0,0,,ЕВРОПЫ. ВОТ ПОЧЕМУ ФРАНЦУЗСКАЯ НЕРВОЗНОСТЬ ВЫГЛЯДИТ СОВСЕМ
Dialogue: 0,0:11:13.37,0:11:16.65,Caption,,0,0,0,,ИНАЧЕ, ЕСЛИ УБРАТЬ СЕГОДНЯШНИЕ ПРЕСС РЕЛИЗЫ И ОТКРЫТЬ
Dialogue: 0,0:11:16.65,0:11:20.41,Caption,,0,0,0,,ИСТОРИЮ. НО ЕСТЬ ЕЩЁ ОДНА ВАЖНАЯ ИСТОРИЧЕСКАЯ ПАРАЛЛЕЛЬ.
Dialogue: 0,0:11:20.72,0:11:23.21,Caption,,0,0,0,,СОВРЕМЕННЫЙ КОНФЛИКТ ПРЕДЛАГАЕТСЯ РАССМАТРИВАТЬ КАК
Dialogue: 0,0:11:23.21,0:11:26.25,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ ПРОЦЕССОВ РАСПАДА БОЛЬШИХ ГОСУДАРСТВ И
Dialogue: 0,0:11:26.33,0:11:30.25,Caption,,0,0,0,,БОРЬБЫ ЗА ТЕРРИТОРИИ, КОТОРЫЕ ПОСЛЕ ЭТОГО РАСПАДА ОСТАЮТСЯ СПОРНЫМИ,
Dialogue: 0,0:11:30.49,0:11:33.21,Caption,,0,0,0,,ПОЛИТИЧЕСКИ РАЗДЕЛЁННЫМИ ИЛИ ВСТРОЕННЫМИ В РАЗНЫЕ
Dialogue: 0,0:11:33.29,0:11:36.81,Caption,,0,0,0,,СИСТЕМЫ. В СЛУЧАЕ РОССИЙСКОЙ ИМПЕРИИ ЗДЕСЬ НУЖНО РАЗДЕЛЯТЬ
Dialogue: 0,0:11:36.89,0:11:40.01,Caption,,0,0,0,,ТРИ ВЕЩИ. ФЕВРАЛЬСКУЮ РЕВОЛЮЦИЮ. ОКТЯБРЬСКУЮ
Dialogue: 0,0:11:40.01,0:11:45.53,Caption,,0,0,0,,РЕВОЛЮЦИЮ. ГРАЖДАНСКУЮ ВОЙНУ. ПИХАТЬ ИХ В ОДИН МЕШОК НЕЛЬЗЯ. ФЕВРАЛЬ РАЗРУШИЛ
Dialogue: 0,0:11:45.61,0:11:48.65,Caption,,0,0,0,,ПРЕЖНЮЮ МОНАРХИЧЕСКУЮ КОНСТРУКЦИЮ. ОКТЯБРЬ ПРИВЁЛ К
Dialogue: 0,0:11:48.65,0:11:51.69,Caption,,0,0,0,,ВЛАСТИ БОЛЬШЕВИКОВ. ГРАЖДАНСКАЯ ВОЙНА ПРЕВРАТИЛА
Dialogue: 0,0:11:51.69,0:11:54.09,Caption,,0,0,0,,ВНУТРЕННИЙ ПОЛИТИЧЕСКИЙ КОНФЛИКТ В ОГРОМНУЮ
Dialogue: 0,0:11:54.09,0:11:58.65,Caption,,0,0,0,,ВООРУЖЁННУЮ БОРЬБУ, В КОТОРОЙ УЧАСТВОВАЛИ И ИНОСТРАННЫЕ СИЛЫ. И ДАЛЬШЕ
Dialogue: 0,0:11:58.73,0:12:01.37,Caption,,0,0,0,,НА МЕСТЕ ИМПЕРИИ ВОЗНИКЛА НОВАЯ ГОСУДАРСТВЕННАЯ
Dialogue: 0,0:12:01.37,0:12:04.41,Caption,,0,0,0,,СИСТЕМА. ЧЕРЕЗ ДЕСЯТИЛЕТИЯ РАСПАЛСЯ УЖЕ СОВЕТСКИЙ
Dialogue: 0,0:12:04.41,0:12:07.69,Caption,,0,0,0,,СОЮЗ. ПОЯВИЛИСЬ НОВЫЕ ГРАНИЦЫ. НО ЛЮДИ,
Dialogue: 0,0:12:07.86,0:12:10.65,Caption,,0,0,0,,ЭКОНОМИКА, ИНФРАСТРУКТУРА, ПОРТЫ,
Dialogue: 0,0:12:10.73,0:12:14.49,Caption,,0,0,0,,ДОРОГИ, ВОЕННЫЕ ОБЪЕКТЫ И ИСТОРИЧЕСКАЯ ПАМЯТЬ НИКУДА
Dialogue: 0,0:12:14.49,0:12:20.61,Caption,,0,0,0,,МГНОВЕННО НЕ ИСЧЕЗЛИ. ПОЭТОМУ ВОПРОС ЧИТАТЕЛЯ "ЗЕРАДЫ" ВПОЛНЕ ПОНЯТЕН.
Dialogue: 0,0:12:21.01,0:12:23.97,Caption,,0,0,0,,НАСКОЛЬКО НЫНЕШНЕЕ СТОЛКНОВЕНИЕ ДЕЙСТВИТЕЛЬНО НОВОЕ,
Dialogue: 0,0:12:24.29,0:12:26.85,Caption,,0,0,0,,А НАСКОЛЬКО ОНО ИДЁТ ПО СТАРЫМ ЛИНИЯМ РАЗЛОМА?
Dialogue: 0,0:12:27.56,0:12:29.09,Caption,,0,0,0,,А ЕСЛИ ПРОДОЛЖИТЬ ЭТУ ПАРАЛЛЕЛЬ,
Dialogue: 0,0:12:29.33,0:12:32.53,Caption,,0,0,0,,КАРТИНА ПОЛУЧАЕТСЯ ЕЩЁ ЖЁСТЧЕ. НЫНЕШНЕЕ ВНЕШНЕЕ
Dialogue: 0,0:12:32.53,0:12:35.17,Caption,,0,0,0,,УЧАСТИЕ ЗДЕСЬ МОЖНО СРАВНИТЬ С ИНТЕРВЕНЦИЕЙ ВРЕМЁН
Dialogue: 0,0:12:35.17,0:12:38.37,Caption,,0,0,0,,ГРАЖДАНСКОЙ ВОЙНЫ. ТОЛЬКО ТОГДА ИНОСТРАННЫЕ АРМИИ
Dialogue: 0,0:12:38.37,0:12:41.41,Caption,,0,0,0,,ЗАХОДИЛИ ЛЮДЬМИ. СЕГОДНЯ ЗНАЧИТЕЛЬНАЯ ЧАСТЬ УЧАСТИЯ
Dialogue: 0,0:12:41.49,0:12:44.05,Caption,,0,0,0,,ИДЁТ ДЕНЬГАМИ, ОРУЖИЕМ, РАЗВЕДКОЙ,
Dialogue: 0,0:12:44.22,0:12:47.73,Caption,,0,0,0,,ТЕХНОЛОГИЯМИ И ЛОГИСТИКОЙ. ФОРМА ДРУГАЯ. СМЫСЛ
Dialogue: 0,0:12:47.73,0:12:50.85,Caption,,0,0,0,,ДАВЛЕНИЯ ОСТАЁТСЯ УЗНАВАЕМЫМ. И ВОТ НА ЭТОМ ФОНЕ
Dialogue: 0,0:12:50.85,0:12:53.73,Caption,,0,0,0,,ЗАЯВЛЕНИЕ КАИ КАЛЛАС ЗВУЧИТ УЖЕ СОВСЕМ ИНТЕРЕСНО.
Dialogue: 0,0:12:53.97,0:12:57.25,Caption,,0,0,0,,ОНА ГОВОРИТ, ЧТО РЕШЕНИЕ О СНЯТИИ ЕВРОПЕЙСКИХ САНКЦИЙ И
Dialogue: 0,0:12:57.25,0:12:59.97,Caption,,0,0,0,,РАЗМОРОЗКЕ РОССИЙСКИХ АКТИВОВ МОЖЕТ ПРИНИМАТЬ ТОЛЬКО
Dialogue: 0,0:12:59.97,0:13:03.57,Caption,,0,0,0,,ЕВРОПА. ЛОГИЧНО. ДЕНЬГИ ЛЕЖАТ В ЕВРОПЕ. САНКЦИИ
Dialogue: 0,0:13:03.65,0:13:06.61,Caption,,0,0,0,,ВВОДИЛА ЕВРОПА. РЕШЕНИЕ ДОЛЖНА ПРИНИМАТЬ ЕВРОПА.
Dialogue: 0,0:13:06.88,0:13:09.89,Caption,,0,0,0,,ТОЛЬКО ЕСТЬ ОДНА НЕПРИЯТНАЯ МЕЛОЧЬ. НА ТРЁХСТОРОННИХ
Dialogue: 0,0:13:09.89,0:13:13.57,Caption,,0,0,0,,ПЕРЕГОВОРАХ РОССИИ, США И УКРАИНЫ В АБУ ДАБИ ЕВРОПЕЙЦЕВ ЗА
Dialogue: 0,0:13:13.65,0:13:16.61,Caption,,0,0,0,,СТОЛОМ НЕ БЫЛО. ПОЛУЧАЕТСЯ УДИВИТЕЛЬНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:13:16.86,0:13:19.89,Caption,,0,0,0,,ВОЕННУЮ НАГРУЗКУ ЕВРОПА НА СЕБЯ БЕРЁТ. РАСХОДЫ
Dialogue: 0,0:13:19.89,0:13:23.41,Caption,,0,0,0,,УВЕЛИЧИВАЕТ. АРМИИ ПЕРЕСТРАИВАЕТ. САНКЦИИ ДЕРЖИТ.
Dialogue: 0,0:13:23.57,0:13:26.29,Caption,,0,0,0,,АКТИВЫ ДЕРЖИТ. А КОГДА НАЧИНАЕТСЯ РАЗГОВОР О
Dialogue: 0,0:13:26.37,0:13:28.45,Caption,,0,0,0,,ПОЛИТИЧЕСКОМ УСТРОЙСТВЕ ПОСЛЕ КОНФЛИКТА,
Dialogue: 0,0:13:28.69,0:13:32.29,Caption,,0,0,0,,ЕВРОПА ВДРУГ ОБНАРУЖИВАЕТ, ЧТО СТУЛ ДЛЯ НЕЁ ЗАБЫЛИ ПОСТАВИТЬ.
Dialogue: 0,0:13:34.56,0:13:36.41,Caption,,0,0,0,,И КАЛЛАС ПОЭТОМУ НАПОМИНАЕТ РЕБЯТА,
Dialogue: 0,0:13:36.56,0:13:38.41,Caption,,0,0,0,,У НАС ВООБЩЕ ТО ТОЖЕ КОЕ ЧТО ЕСТЬ.
Dialogue: 0,0:13:38.56,0:13:41.77,Caption,,0,0,0,,САНКЦИИ. АКТИВЫ. ТО ЕСТЬ ЕСЛИ ВЫ ХОТИТЕ ДОГОВОРИТЬСЯ
Dialogue: 0,0:13:41.77,0:13:45.53,Caption,,0,0,0,,БЕЗ НАС, ХОРОШО. ТОЛЬКО ЧАСТЬ КЛЮЧЕЙ ЛЕЖИТ У НАС. ЭТО
Dialogue: 0,0:13:45.53,0:13:47.85,Caption,,0,0,0,,И ЕСТЬ РЕАЛЬНАЯ БОРЬБА ЗА МЕСТО В БУДУЩЕМ
Dialogue: 0,0:13:47.93,0:13:50.97,Caption,,0,0,0,,УСТРОЙСТВЕ ЕВРОПЫ. НЕ ТОЛЬКО РОССИЯ И УКРАИНА. НЕ
Dialogue: 0,0:13:50.97,0:13:53.37,Caption,,0,0,0,,ТОЛЬКО РОССИЯ И НАТО. ТАМ ЕЩЁ ИДЁТ БОРЬБА
Dialogue: 0,0:13:53.37,0:13:56.57,Caption,,0,0,0,,ВНУТРИ САМОГО ЗАПАДА. США ХОТЯТ МЕНЬШЕ ПЛАТИТЬ И
Dialogue: 0,0:13:56.57,0:13:59.53,Caption,,0,0,0,,БОЛЬШЕ КОНТРОЛИРОВАТЬ. БРИТАНИЯ ХОЧЕТ СОХРАНЯТЬ РОЛЬ
Dialogue: 0,0:13:59.61,0:14:02.49,Caption,,0,0,0,,ОДНОГО ИЗ ГЛАВНЫХ АРХИТЕКТОРОВ ДАВЛЕНИЯ. ПОЛЬША
Dialogue: 0,0:14:02.49,0:14:04.97,Caption,,0,0,0,,ХОЧЕТ СТАТЬ КЛЮЧЕВОЙ СИЛОЙ НА БАЛТИКЕ И ВОСТОЧНОМ
Dialogue: 0,0:14:04.97,0:14:08.09,Caption,,0,0,0,,ФЛАНГЕ. ГЕРМАНИЯ ПОЛУЧАЕТ ВОЕННЫЕ ВОЗМОЖНОСТИ,
Dialogue: 0,0:14:08.29,0:14:11.05,Caption,,0,0,0,,КОТОРЫХ У НЕЁ ДЕСЯТИЛЕТИЯМИ НЕ БЫЛО. ФРАНЦИЯ
Dialogue: 0,0:14:11.13,0:14:14.01,Caption,,0,0,0,,ПЫТАЕТСЯ СОХРАНИТЬ СОБСТВЕННУЮ СТРАТЕГИЧЕСКУЮ РОЛЬ И
Dialogue: 0,0:14:14.01,0:14:17.45,Caption,,0,0,0,,ОДНОВРЕМЕННО СЛЕДИТ, ЧТОБЫ ГЕРМАНИЯ СЛУЧАЙНО НЕ СТАЛА СЛИШКОМ
Dialogue: 0,0:14:17.45,0:14:20.33,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОЙ. ВОТ ТЕПЕРЬ ВСЯ ЭТА ИСТОРИЯ НАЧИНАЕТ
Dialogue: 0,0:14:20.33,0:14:22.81,Caption,,0,0,0,,ВЫГЛЯДЕТЬ НАМНОГО ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО ЕСЛИ
Dialogue: 0,0:14:22.81,0:14:25.05,Caption,,0,0,0,,СМОТРЕТЬ ТОЛЬКО НА ОФИЦИАЛЬНЫЕ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:14:25.24,0:14:30.41,Caption,,0,0,0,,У НАС ЕСТЬ ЕДИНАЯ ЕВРОПА, ЕДИНОЕ НАТО И ОБЩИЙ ПРОТИВНИК. А ЕСЛИ СМОТРЕТЬ
Dialogue: 0,0:14:30.49,0:14:34.41,Caption,,0,0,0,,НА РЕАЛЬНЫЕ ИНТЕРЕСЫ, У КАЖДОГО СВОЙ КАЛЬКУЛЯТОР. И У ФРАНЦИИ ОН
Dialogue: 0,0:14:34.41,0:14:37.61,Caption,,0,0,0,,ОСОБЕННЫЙ. ПАРИЖ СМОТРИТ НА РОССИЮ И СЧИТАЕТ РИСК
Dialogue: 0,0:14:37.69,0:14:40.41,Caption,,0,0,0,,РОССИЙСКОЙ ЭСКАЛАЦИИ. ПОТОМ ПЕРЕВОДИТ ГЛАЗА НА
Dialogue: 0,0:14:40.41,0:14:43.29,Caption,,0,0,0,,ГЕРМАНИЮ И СЧИТАЕТ УЖЕ СОВСЕМ ДРУГОЙ РИСК. И
Dialogue: 0,0:14:43.37,0:14:48.13,Caption,,0,0,0,,ЭТО НЕ ПАРАНОЙЯ. ЭТО ИСТОРИЧЕСКИЙ ОПЫТ СТРАНЫ,
Dialogue: 0,0:14:48.29,0:14:53.25,Caption,,0,0,0,,КОТОРАЯ ПРЕКРАСНО ЗНАЕТ, ЧТО ЕВРОПЕЙСКИЕ СОЮЗЫ НЕ ВЫСЕЧЕНЫ В КАМНЕ. СЕГОДНЯ
Dialogue: 0,0:14:53.33,0:14:55.81,Caption,,0,0,0,,ВЫ ВМЕСТЕ ВООРУЖАЕТЕСЬ ПРОТИВ ОДНОГО ПРОТИВНИКА.
Dialogue: 0,0:14:56.13,0:14:59.41,Caption,,0,0,0,,ЗАВТРА ПОЛИТИЧЕСКАЯ КОНСТРУКЦИЯ МЕНЯЕТСЯ. А ОРУЖИЕ
Dialogue: 0,0:14:59.41,0:15:02.93,Caption,,0,0,0,,УЖЕ ПРОИЗВЕДЕНО. АРМИЯ УЖЕ СОЗДАНА. ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:15:03.01,0:15:05.81,Caption,,0,0,0,,УЖЕ РАЗОГНАНА. ВОТ ПОЧЕМУ ИСТОРИЯ С ФРАНЦУЗСКИМИ
Dialogue: 0,0:15:05.81,0:15:07.89,Caption,,0,0,0,,ВОПРОСАМИ К ГЕРМАНИИ НАМНОГО БОЛЬШЕ,
Dialogue: 0,0:15:08.05,0:15:11.33,Caption,,0,0,0,,ЧЕМ СПОР О НЕСКОЛЬКИХ РАКЕТАХ. ОНА ПОКАЗЫВАЕТ СТАРУЮ
Dialogue: 0,0:15:11.33,0:15:14.29,Caption,,0,0,0,,ПРОБЛЕМУ ЕВРОПЫ. ДЛЯ ПОХОДА НА ВОСТОК ЕВРОПЕЙЦАМ
Dialogue: 0,0:15:14.29,0:15:17.33,Caption,,0,0,0,,НУЖНО ОБЪЕДИНИТЬСЯ. НО ЧЕМ СИЛЬНЕЕ ОНИ ОБЪЕДИНЯЮТ
Dialogue: 0,0:15:17.33,0:15:21.97,Caption,,0,0,0,,ВОЕННЫЕ ВОЗМОЖНОСТИ, ТЕМ СИЛЬНЕЕ ВНУТРИ САМОГО СОЮЗА МЕНЯЕТСЯ БАЛАНС СИЛ.
Dialogue: 0,0:15:22.41,0:15:25.17,Caption,,0,0,0,,И ТУТ НАЧИНАЕТСЯ САМОЕ НЕПРИЯТНОЕ. ПОТОМУ ЧТО
Dialogue: 0,0:15:25.17,0:15:28.29,Caption,,0,0,0,,ФРАНЦИИ НУЖНА СИЛЬНАЯ ГЕРМАНИЯ ПРОТИВ РОССИИ. НО
Dialogue: 0,0:15:28.29,0:15:31.17,Caption,,0,0,0,,СЛИШКОМ СИЛЬНАЯ ГЕРМАНИЯ ФРАНЦИИ ТОЖЕ СОВЕРШЕННО НЕ
Dialogue: 0,0:15:31.17,0:15:34.29,Caption,,0,0,0,,НУЖНА. БРИТАНИИ НУЖНА АКТИВНАЯ ГЕРМАНИЯ,
Dialogue: 0,0:15:34.69,0:15:36.69,Caption,,0,0,0,,НО НЕ ТАКАЯ, КОТОРАЯ ОДНАЖДЫ РЕШИТ,
Dialogue: 0,0:15:36.85,0:15:39.81,Caption,,0,0,0,,ЧТО СОВЕТЫ ЛОНДОНА ЕЙ БОЛЬШЕ НЕ ТРЕБУЮТСЯ. ПОЛЬШЕ
Dialogue: 0,0:15:39.81,0:15:41.89,Caption,,0,0,0,,НУЖНА ГЕРМАНИЯ КАК СОЮЗНИК ПО НАТО,
Dialogue: 0,0:15:42.21,0:15:45.09,Caption,,0,0,0,,НО ИСТОРИЧЕСКАЯ ПАМЯТЬ ВАРШАВЫ ОТНОСИТЕЛЬНО БЕРЛИНА
Dialogue: 0,0:15:45.09,0:15:47.57,Caption,,0,0,0,,ТОЖЕ НИКУДА НЕ ДЕЛАСЬ. И ВСЁ ЭТО ДЕРЖИТСЯ
Dialogue: 0,0:15:47.57,0:15:51.57,Caption,,0,0,0,,ВМЕСТЕ, ПОКА СУЩЕСТВУЕТ ОБЩИЙ ВНЕШНИЙ ПРОТИВНИК. ИМЕННО
Dialogue: 0,0:15:51.57,0:15:54.13,Caption,,0,0,0,,ПОЭТОМУ НЫНЕШНИЙ ПОВОРОТ НАТО НА ВОСТОК СТОИТ
Dialogue: 0,0:15:54.13,0:15:56.37,Caption,,0,0,0,,СМОТРЕТЬ НЕ ТОЛЬКО ЧЕРЕЗ РОССИЙСКО ЗАПАДНОЕ
Dialogue: 0,0:15:56.37,0:15:59.73,Caption,,0,0,0,,ПРОТИВОСТОЯНИЕ. ОН ОДНОВРЕМЕННО МЕНЯЕТ САМУ ЕВРОПУ.
Dialogue: 0,0:16:00.05,0:16:06.02,Caption,,0,0,0,,ПЕРЕРАСПРЕДЕЛЯЕТ ДЕНЬГИ. ПЕРЕРАСПРЕДЕЛЯЕТ АРМИИ. ПЕРЕРАСПРЕДЕЛЯЕТ
Dialogue: 0,0:16:06.02,0:16:09.14,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ВЕС. ПОДНИМАЕТ ГЕРМАНИЮ. УСИЛИВАЕТ
Dialogue: 0,0:16:09.22,0:16:12.18,Caption,,0,0,0,,ПОЛЬШУ. ЗАСТАВЛЯЕТ ФРАНЦИЮ ДУМАТЬ О СВОЁМ ЯДЕРНОМ
Dialogue: 0,0:16:12.18,0:16:15.38,Caption,,0,0,0,,СТАТУСЕ. ДАЁТ БРИТАНИИ ВОЗМОЖНОСТЬ СНОВА ИГРАТЬ РОЛЬ
Dialogue: 0,0:16:15.38,0:16:18.58,Caption,,0,0,0,,ОТДЕЛЬНОГО СТРАТЕГИЧЕСКОГО ЦЕНТРА. А США ПОСТЕПЕННО
Dialogue: 0,0:16:18.58,0:16:21.54,Caption,,0,0,0,,ПЕРЕКЛАДЫВАЮТ ЧАСТЬ РАСХОДОВ НА ЕВРОПЕЙЦЕВ. ОДИН
Dialogue: 0,0:16:21.62,0:16:24.34,Caption,,0,0,0,,ПУТЬ ДЕЙСТВИТЕЛЬНО ТЯНЕТСЯ ЧЕРЕЗ ВЕКА. МЕНЯЮТСЯ
Dialogue: 0,0:16:24.34,0:16:28.34,Caption,,0,0,0,,ФЛАГИ, НАЗВАНИЯ СОЮЗОВ И СПОСОБЫ ВЕДЕНИЯ ВОЙНЫ. НО ВОСТОК
Dialogue: 0,0:16:28.42,0:16:31.22,Caption,,0,0,0,,СНОВА ОКАЗЫВАЕТСЯ НАПРАВЛЕНИЕМ БОЛЬШОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:16:31.22,0:16:34.34,Caption,,0,0,0,,УСИЛИЯ. И ФРАНЦИЯ СНОВА ИДЁТ ВМЕСТЕ СО ВСЕМИ.
Dialogue: 0,0:16:34.66,0:16:37.46,Caption,,0,0,0,,ТОЛЬКО ВРЕМЯ ОТ ВРЕМЕНИ ОГЛЯДЫВАЕТСЯ ЧЕРЕЗ ПЛЕЧО. НА
Dialogue: 0,0:16:37.46,0:16:38.02,Caption,,0,0,0,,ГЕРМАНИЮ.
