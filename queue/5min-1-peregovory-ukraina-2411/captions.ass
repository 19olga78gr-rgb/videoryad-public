Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ВОТ ИНТЕРЕСНО, СКОЛЬКО РАЗ НУЖНО СКАЗАТЬ "НЕТ",
Dialogue: 0,0:00:03.08,0:00:05.48,Caption,,0,0,0,,ЧТОБЫ ТЕБЯ НАКОНЕЦ УСЛЫШАЛИ? ОДИН РАЗ,
Dialogue: 0,0:00:05.56,0:00:09.88,Caption,,0,0,0,,ДЕСЯТЬ, СТО? МОСКВА УЖЕ КОТОРЫЙ ГОД ПОВТОРЯЕТ СВОЮ ПОЗИЦИЮ ПО
Dialogue: 0,0:00:09.88,0:00:12.20,Caption,,0,0,0,,НАТО. А ЕЙ СНОВА НЕСУТ ТУ ЖЕ САМУЮ
Dialogue: 0,0:00:12.20,0:00:15.40,Caption,,0,0,0,,ПАПКУ, ТОЛЬКО ОБЛОЖКУ ПОМЕНЯЛИ. И САМОЕ ЗАБАВНОЕ,
Dialogue: 0,0:00:15.64,0:00:19.16,Caption,,0,0,0,,ЧТО ТЕПЕРЬ НАХОДЯТСЯ ЛЮДИ, КОТОРЫЕ УВЕРЯЮТ ДА ВСЁ НОРМАЛЬНО,
Dialogue: 0,0:00:19.32,0:00:22.04,Caption,,0,0,0,,МОСКВА ПОЧТИ СОГЛАСНА. СОГЛАСНА НА ЧТО,
Dialogue: 0,0:00:22.13,0:00:25.08,Caption,,0,0,0,,ХОТЕЛОСЬ БЫ ПОНЯТЬ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:25.19,0:00:27.88,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ТРАМП РАССКАЗЫВАЕТ,
Dialogue: 0,0:00:28.04,0:00:30.44,Caption,,0,0,0,,ЧТО ПОСЛЕ РАЗГОВОРА С ПУТИНЫМ УСЛЫШАЛ ОТ НЕГО
Dialogue: 0,0:00:30.44,0:00:33.32,Caption,,0,0,0,,ОЧЕНЬ УДОБНУЮ ДЛЯ СЕБЯ ФРАЗУ. ПРИ ТРАМПЕ,
Dialogue: 0,0:00:33.40,0:00:37.00,Caption,,0,0,0,,ГОВОРИТ ОН, ЭТОГО КОНФЛИКТА ВООБЩЕ БЫ НЕ БЫЛО. ПУТИН,
Dialogue: 0,0:00:37.08,0:00:39.48,Caption,,0,0,0,,ПО СЛОВАМ ТРАМПА, ПРЯМО ОТВЕТИЛ ЕМУ,
Dialogue: 0,0:00:39.64,0:00:43.40,Caption,,0,0,0,,ЧТО НЕ НАЧАЛ БЫ ВТОРЖЕНИЕ, ЕСЛИ БЫ В БЕЛОМ ДОМЕ ОСТАВАЛСЯ ОН,
Dialogue: 0,0:00:43.56,0:00:46.20,Caption,,0,0,0,,А НЕ БАЙДЕН. ТРАМП ТУТ ЖЕ ПРИПОМНИЛ ВЫБОРЫ,
Dialogue: 0,0:00:46.45,0:00:48.36,Caption,,0,0,0,,КОТОРЫЕ СЧИТАЕТ СФАЛЬСИФИЦИРОВАННЫМИ,
Dialogue: 0,0:00:48.52,0:00:51.72,Caption,,0,0,0,,ЧЕТЫРЕ ПОТЕРЯННЫХ ГОДА И НЕУМЕЛЫЕ ДЕЙСТВИЯ ПРЕЖНЕЙ
Dialogue: 0,0:00:51.80,0:00:54.60,Caption,,0,0,0,,АМЕРИКАНСКОЙ АДМИНИСТРАЦИИ. ЗАОДНО ПОДЧЕРКНУЛ,
Dialogue: 0,0:00:54.82,0:00:57.64,Caption,,0,0,0,,ЧТО ПУТИН ХОЧЕТ ЗАКОНЧИТЬ КОНФЛИКТ ПУТЁМ ПЕРЕГОВОРОВ
Dialogue: 0,0:00:57.88,0:00:59.96,Caption,,0,0,0,,И ЧТО ЕГО СОБСТВЕННЫЕ ПРЕДСТАВИТЕЛИ ХОРОШО
Dialogue: 0,0:00:59.96,0:01:03.00,Caption,,0,0,0,,СПРАВЛЯЮТСЯ СО СВОЕЙ РАБОТОЙ. ЗЕЛЕНСКИЙ ОТВЕЧАЕТ
Dialogue: 0,0:01:03.00,0:01:05.96,Caption,,0,0,0,,СВОЕЙ СТАРОЙ ИСТОРИЕЙ. ТРАМП ЕЩЁ ДО ВОЗВРАЩЕНИЯ В
Dialogue: 0,0:01:05.96,0:01:08.20,Caption,,0,0,0,,БЕЛЫЙ ДОМ ОБЕЩАЛ ЗАКОНЧИТЬ ВСЁ ЗА СУТКИ.
Dialogue: 0,0:01:10.47,0:01:13.91,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ГОВОРИТ, ЧТО СРАЗУ ПРЕДУПРЕЖДАЛ ЗА СУТКИ НЕ ПОЛУЧИТСЯ,
Dialogue: 0,0:01:14.15,0:01:16.39,Caption,,0,0,0,,ПОТОМУ ЧТО МОСКВА МОЖЕТ ГОВОРИТЬ О МИРЕ И
Dialogue: 0,0:01:16.39,0:01:18.79,Caption,,0,0,0,,ОДНОВРЕМЕННО ДОБИВАТЬСЯ СВОИХ ТЕРРИТОРИАЛЬНЫХ ЦЕЛЕЙ.
Dialogue: 0,0:01:19.38,0:01:22.15,Caption,,0,0,0,,НО СЕЙЧАС ВОПРОС ДРУГОЙ. ЧТО ПРЕДЛАГАЮТ НА ЭТОТ
Dialogue: 0,0:01:22.15,0:01:25.51,Caption,,0,0,0,,РАЗ? МЕЛАНИЯ ТРАМП ДОПУСТИЛА ЕЩЁ ОДНО ПЕРЕМИРИЕ ДО
Dialogue: 0,0:01:25.51,0:01:28.79,Caption,,0,0,0,,РОЖДЕСТВА, ЕСЛИ ОБЕ СТОРОНЫ БУДУТ К НЕМУ ГОТОВЫ. НА
Dialogue: 0,0:01:28.87,0:01:31.83,Caption,,0,0,0,,ЭТОМ ВСЁ. ПЕРЕМИРИЕ ЭТО ПЕРЕМИРИЕ. ЭТО ЕЩЁ НЕ
Dialogue: 0,0:01:31.91,0:01:35.03,Caption,,0,0,0,,ОТВЕТ НА ВОПРОС, ЧТО БУДЕТ ДАЛЬШЕ И НА КАКИХ УСЛОВИЯХ БУДЕТ
Dialogue: 0,0:01:35.03,0:01:38.23,Caption,,0,0,0,,УСТРОЕН МИР ПОСЛЕ НЕГО. А ВОТ БУДАНОВ СФОРМУЛИРОВАЛ
Dialogue: 0,0:01:38.23,0:01:41.19,Caption,,0,0,0,,ГОРАЗДО ТОЧНЕЕ. ЗАКОНЧИТЬ ВСЁ ДО КОНЦА ГОДА,
Dialogue: 0,0:01:41.27,0:01:45.03,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, БЫЛО БЫ ПРАКТИЧЕСКИ ЧУДОМ. РАБОТАТЬ БУДУТ,
Dialogue: 0,0:01:45.26,0:01:48.31,Caption,,0,0,0,,НО ЧУДО ОСТАЁТСЯ ЧУДОМ. И ЭТО ВАЖНЫЙ КОНТРАСТ.
Dialogue: 0,0:01:48.55,0:01:51.51,Caption,,0,0,0,,СРОКИ УЖЕ БЕГУТ ВПЕРЕДИ САМОГО СОГЛАШЕНИЯ. ДО
Dialogue: 0,0:01:51.51,0:01:54.47,Caption,,0,0,0,,РОЖДЕСТВА ПЕРЕМИРИЕ, ДО НОВОГО ГОДА ФИНАЛ,
Dialogue: 0,0:01:54.71,0:01:56.55,Caption,,0,0,0,,А ОСНОВНЫЕ УСЛОВИЯ ВЫГЛЯДЯТ ТАК,
Dialogue: 0,0:01:56.71,0:02:00.39,Caption,,0,0,0,,БУДТО ИХ СОСТАВЛЯЛИ ЛЮДИ, КОТОРЫЕ СИДЕЛИ В РАЗНЫХ КОМНАТАХ И ДРУГ С
Dialogue: 0,0:02:00.39,0:02:02.63,Caption,,0,0,0,,ДРУГОМ НЕ РАЗГОВАРИВАЛИ. ВОТ ОДИН ИЗ ТАКИХ
Dialogue: 0,0:02:02.71,0:02:05.51,Caption,,0,0,0,,ВАРИАНТОВ. ПО СООБЩЕНИЮ "УОЛЛ СТРИТ ДЖОРНАЛ",
Dialogue: 0,0:02:05.70,0:02:07.59,Caption,,0,0,0,,АМЕРИКАНЦЫ ОБСУЖДАЮТ КОНСТРУКЦИЮ,
Dialogue: 0,0:02:07.78,0:02:10.39,Caption,,0,0,0,,ПРИ КОТОРОЙ УКРАИНА ПОЛУЧАЕТ ПЕРСПЕКТИВУ НАТО,
Dialogue: 0,0:02:10.71,0:02:12.87,Caption,,0,0,0,,А РОССИЯ ПОЛУЧАЕТ ТЕРРИТОРИАЛЬНЫЙ РЕЗУЛЬТАТ ПО
Dialogue: 0,0:02:12.87,0:02:16.55,Caption,,0,0,0,,ДОНБАССУ. И ТУТ ХОЧЕТСЯ ОСТАНОВИТЬСЯ. МОСКВА ГОДАМИ
Dialogue: 0,0:02:16.63,0:02:19.99,Caption,,0,0,0,,ГОВОРИТ, ЧТО ЧЛЕНСТВО УКРАИНЫ В НАТО ДЛЯ НЕЁ НЕПРИЕМЛЕМО.
Dialogue: 0,0:02:20.31,0:02:22.55,Caption,,0,0,0,,ТЕПЕРЬ НА СТОЛ СНОВА КЛАДУТ ТУ ЖЕ ПАПКУ.
Dialogue: 0,0:02:24.84,0:02:27.72,Caption,,0,0,0,,ТОЛЬКО НА ОБЛОЖКЕ УЖЕ НАПИСАНО КОМПРОМИСС. ТАКОЕ
Dialogue: 0,0:02:27.72,0:02:31.00,Caption,,0,0,0,,ВПЕЧАТЛЕНИЕ, ЧТО ПРОСТО НЕ ПОНИМАЕТСЯ СЛОВО "НЕТ". ВОТ И
Dialogue: 0,0:02:31.00,0:02:33.48,Caption,,0,0,0,,ВСЁ. СКОЛЬКО ЕЩЁ РАЗ ЕГО НАДО ПОВТОРИТЬ?
Dialogue: 0,0:02:33.98,0:02:37.24,Caption,,0,0,0,,НО ЗДЕСЬ ПРОТИВОРЕЧИЕ ЕЩЁ ЖЁСТЧЕ. ЕСЛИ НЕДОПУЩЕНИЕ
Dialogue: 0,0:02:37.32,0:02:39.64,Caption,,0,0,0,,УКРАИНЫ В НАТО БЫЛО ОДНОЙ ИЗ ЗАЯВЛЕННЫХ ЦЕЛЕЙ
Dialogue: 0,0:02:39.72,0:02:42.92,Caption,,0,0,0,,РОССИИ, ТО СОГЛАСИТЬСЯ НА ВСТУПЛЕНИЕ УКРАИНЫ В НАТО В
Dialogue: 0,0:02:43.00,0:02:45.80,Caption,,0,0,0,,ОБМЕН НА ДОНБАСС ОЗНАЧАЕТ ОТКАЗАТЬСЯ ОТ ОДНОЙ ИЗ
Dialogue: 0,0:02:45.80,0:02:49.32,Caption,,0,0,0,,ПРИЧИН, КОТОРЫМИ МОСКВА ОБЪЯСНЯЛА НАЧАЛО КОНФЛИКТА. ТО ЕСТЬ
Dialogue: 0,0:02:49.32,0:02:52.44,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ СТРАННАЯ ПОБЕДА. ЗЕМЛЮ ПОЛУЧИЛИ,
Dialogue: 0,0:02:52.76,0:02:56.20,Caption,,0,0,0,,А СТРАТЕГИЧЕСКУЮ ПРОБЛЕМУ, РАДИ КОТОРОЙ ВСЁ ЭТО НАЧИНАЛОСЬ,
Dialogue: 0,0:02:56.28,0:02:59.80,Caption,,0,0,0,,ЗАКРЕПИЛИ ДОКУМЕНТОМ. И ВОТ ТУТ ГЛАВНЫЙ ВОПРОС. ЕСЛИ
Dialogue: 0,0:02:59.80,0:03:01.96,Caption,,0,0,0,,МОСКВА НА ТАКОЕ ДЕЙСТВИТЕЛЬНО СОГЛАСИТСЯ,
Dialogue: 0,0:03:02.20,0:03:05.00,Caption,,0,0,0,,ЧЕМ ЭТО ОТЛИЧАЕТСЯ ОТ КАПИТУЛЯЦИИ ПО ОДНОМУ ИЗ
Dialogue: 0,0:03:05.00,0:03:09.32,Caption,,0,0,0,,КЛЮЧЕВЫХ ПУНКТОВ? НЕ КАПИТУЛЯЦИИ УКРАИНЫ. НЕ КОМПРОМИССА ПОСЕРЕДИНЕ. А
Dialogue: 0,0:03:09.32,0:03:12.44,Caption,,0,0,0,,КАПИТУЛЯЦИИ МОСКВЫ ИМЕННО ПО ВОПРОСУ НАТО. ПОТОМУ
Dialogue: 0,0:03:12.52,0:03:15.80,Caption,,0,0,0,,ЧТО ДАЛЬШЕ ПАКЕТ СТАНОВИТСЯ ЕЩЁ ВЕСЕЛЕЕ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:03:15.80,0:03:18.44,Caption,,0,0,0,,ТРЕБУЕТ ПИСЬМЕННЫХ ГАРАНТИЙ БЕЗОПАСНОСТИ НЕ НА СРОК
Dialogue: 0,0:03:18.44,0:03:22.68,Caption,,0,0,0,,ПРЕЗИДЕНТСТВА ТРАМПА, А НА ДЕСЯТИЛЕТИЯ. ОН ХОЧЕТ ЗАРАНЕЕ ПОНИМАТЬ,
Dialogue: 0,0:03:23.00,0:03:25.80,Caption,,0,0,0,,КАКИЕ СТРАНЫ И КАК БУДУТ ЗАЩИЩАТЬ УКРАИНУ ПРИ
Dialogue: 0,0:03:25.88,0:03:28.36,Caption,,0,0,0,,НОВОМ КОНФЛИКТЕ. И ОТДЕЛЬНО ОБЪЯСНЯЕТ,
Dialogue: 0,0:03:28.52,0:03:33.32,Caption,,0,0,0,,ЧТО ЧЛЕНСТВО В НАТО ДЕШЕВЛЕ, ЧЕМ СОДЕРЖАНИЕ МИЛЛИОННОЙ АРМИИ ВНЕ АЛЬЯНСА.
Dialogue: 0,0:03:35.60,0:03:38.24,Caption,,0,0,0,,ЕСЛИ РАСХОДЫ МОЖНО РАЗДЕЛИТЬ МЕЖДУ СОЮЗНИКАМИ,
Dialogue: 0,0:03:38.48,0:03:41.36,Caption,,0,0,0,,ЗАЧЕМ КИЕВУ ОДНОМУ ОПЛАЧИВАТЬ ОГРОМНУЮ АРМИЮ
Dialogue: 0,0:03:41.36,0:03:44.24,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯМИ? ПРИ ЭТОМ КОНКРЕТНЫЕ РЕШЕНИЯ,
Dialogue: 0,0:03:44.32,0:03:48.24,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, БУДУТ ЗАВИСЕТЬ ОТ ЗАВЕРШЕНИЯ КОНФЛИКТА. ТОЛЬКО ТОГДА
Dialogue: 0,0:03:48.32,0:03:50.96,Caption,,0,0,0,,НАДО ЧЕСТНО СПРОСИТЬ КТО В ЭТОЙ КОНСТРУКЦИИ ПЛАТИТ,
Dialogue: 0,0:03:51.20,0:03:54.40,Caption,,0,0,0,,КТО ПОЛУЧАЕТ ГАРАНТИИ И КТО ЧЕМ РИСКУЕТ. ПОТОМУ
Dialogue: 0,0:03:54.48,0:03:57.28,Caption,,0,0,0,,ЧТО ДАЛЬШЕ ПОЯВЛЯЕТСЯ ПУБЛИКАЦИЯ ДЭВИДА ИГНАТИУСА В
Dialogue: 0,0:03:57.28,0:04:00.08,Caption,,0,0,0,,"ВАШИНГТОН ПОСТ". ОН, ССЫЛАЯСЬ НА ИСТОЧНИК,
Dialogue: 0,0:04:00.16,0:04:05.12,Caption,,0,0,0,,БЛИЗКИЙ К ПЕРЕГОВОРАМ, ПИШЕТ, ЧТО ПУТИН В ЧАСТНОМ ПОРЯДКЕ СОГЛАСИЛСЯ НА ГАРАНТИИ
Dialogue: 0,0:04:05.12,0:04:08.24,Caption,,0,0,0,,УКРАИНЕ ПО МОДЕЛИ ПЯТОЙ СТАТЬИ НАТО. ВОТ ЗДЕСЬ
Dialogue: 0,0:04:08.24,0:04:11.04,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:04:11.27,0:04:14.00,Caption,,0,0,0,,МОСКВА ПУБЛИЧНО ОТВЕРГАЛА КВАЗИЧЛЕНСТВО УКРАИНЫ В
Dialogue: 0,0:04:14.00,0:04:18.48,Caption,,0,0,0,,НАТО. РЯБКОВ ГОВОРИЛ, ЧТО ТАКИЕ КОНСТРУКЦИИ НЕПРИЕМЛЕМЫ. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:04:18.80,0:04:22.56,Caption,,0,0,0,,НАМ ТЕПЕРЬ СООБЩАЮТ, ЧТО ПУТИН ЯКОБЫ СОГЛАСИЛСЯ НА ГАРАНТИИ,
Dialogue: 0,0:04:22.79,0:04:27.28,Caption,,0,0,0,,ПОХОЖИЕ НА ПЯТУЮ СТАТЬЮ, ЕСЛИ ВОЙСК НАТО ПОСТОЯННО НА УКРАИНЕ НЕ БУДЕТ.
Dialogue: 0,0:04:27.63,0:04:32.32,Caption,,0,0,0,,ХОРОШО. РАЗБИРАЕМ, ЧТО ЕЩЁ ЛЕЖИТ В ЭТОМ ПАКЕТЕ. РОССИЙСКИЕ ВОЙСКА
Dialogue: 0,0:04:32.32,0:04:35.04,Caption,,0,0,0,,ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ ДОЛЖНЫ ОТОЙТИ ОТ УКРАИНСКОЙ
Dialogue: 0,0:04:35.04,0:04:38.40,Caption,,0,0,0,,ГРАНИЦЫ. ЕСЛИ РОССИЯ СНОВА НАЧНЁТ СТЯГИВАТЬ СИЛЫ ДЛЯ
Dialogue: 0,0:04:38.40,0:04:43.04,Caption,,0,0,0,,НОВОГО НАСТУПЛЕНИЯ, САНКЦИИ, КОТОРЫЕ ЕЙ ПЕРЕД ЭТИМ МОГУТ НЕМНОГО ОСЛАБИТЬ,
Dialogue: 0,0:04:43.14,0:04:46.32,Caption,,0,0,0,,ВЕРНУТ ОБРАТНО. ЕСЛИ НОВОЕ НАСТУПЛЕНИЕ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:46.32,0:04:50.16,Caption,,0,0,0,,НАЧНЁТСЯ, СИЛЫ НАТО ДОЛЖНЫ ОПЕРАТИВНО ПРИБЫТЬ НА УКРАИНУ.
Dialogue: 0,0:04:52.27,0:04:55.31,Caption,,0,0,0,,ТО ЕСТЬ РОССИИ ПРЕДЛАГАЮТ ОТВЕСТИ ВОЙСКА. УКРАИНЕ
Dialogue: 0,0:04:55.39,0:04:58.19,Caption,,0,0,0,,ДАЮТ ДОЛГОСРОЧНЫЕ ГАРАНТИИ. ЗАПАДУ ОСТАВЛЯЮТ
Dialogue: 0,0:04:58.19,0:05:01.23,Caption,,0,0,0,,МЕХАНИЗМ БЫСТРОГО ВОЕННОГО РЕАГИРОВАНИЯ. САНКЦИИ
Dialogue: 0,0:05:01.23,0:05:04.67,Caption,,0,0,0,,МОГУТ ЧУТЬ ОСЛАБИТЬ, НО ДЕРЖАТ ИХ РЯДОМ НА ПОЛКЕ И ОБЕЩАЮТ
Dialogue: 0,0:05:04.67,0:05:07.31,Caption,,0,0,0,,ВЕРНУТЬ ПРИ ПЕРВОМ ЖЕ СЕРЬЁЗНОМ ДВИЖЕНИИ РОССИЙСКИХ
Dialogue: 0,0:05:07.39,0:05:12.67,Caption,,0,0,0,,ВОЙСК. А РОССИЯ ЧТО ПОЛУЧАЕТ? ПОСЛАБЛЕНИЕ САНКЦИЙ. КОГДА НИБУДЬ. В КАКОМ ОБЪЁМЕ,
Dialogue: 0,0:05:12.91,0:05:14.91,Caption,,0,0,0,,НА КАКОЙ СРОК И С КАКИМИ УСЛОВИЯМИ,
Dialogue: 0,0:05:15.23,0:05:17.87,Caption,,0,0,0,,ИЗ ЭТОЙ КОНСТРУКЦИИ ВООБЩЕ НЕ ЯСНО. НУ СЕРЬЁЗНО.
Dialogue: 0,0:05:18.12,0:05:21.39,Caption,,0,0,0,,ЭТО ПРЕФЕРЕНЦИИ? ЕСЛИ ОПИСАНИЕ ЭТОЙ СХЕМЫ ВЕРНО,
Dialogue: 0,0:05:21.63,0:05:24.11,Caption,,0,0,0,,ЭТО УЖЕ НЕ ВЫГЛЯДИТ КАК ОБМЕН УСТУПКАМИ. ЭТО
Dialogue: 0,0:05:24.11,0:05:27.47,Caption,,0,0,0,,ВЫГЛЯДИТ КАК ЧИСТЕЙШИЙ ПЛАН КАПИТУЛЯЦИИ. НЕ ХВАТАЕТ
Dialogue: 0,0:05:27.47,0:05:29.79,Caption,,0,0,0,,ТОЛЬКО ПУНКТА "СЛОЖИТЬ ОРУЖИЕ". ПОТОМУ ЧТО
Dialogue: 0,0:05:29.79,0:05:32.59,Caption,,0,0,0,,СТРАТЕГИЧЕСКИЙ ВОПРОС НАТО НЕ РЕШЁН В ПОЛЬЗУ МОСКВЫ,
Dialogue: 0,0:05:32.84,0:05:34.99,Caption,,0,0,0,,ВОЕННЫЙ РЫЧАГ ОСТАВЛЯЮТ ЗА ЗАПАДОМ,
Dialogue: 0,0:05:35.07,0:05:37.55,Caption,,0,0,0,,САНКЦИОННЫЙ РЫЧАГ ТОЖЕ ОСТАВЛЯЮТ ЗА ЗАПАДОМ,
Dialogue: 0,0:05:37.71,0:05:40.35,Caption,,0,0,0,,А РОССИЙСКИЕ СИЛЫ ЕЩЁ И ДОЛЖНЫ ОТОЙТИ. КРАСИВО
Dialogue: 0,0:05:40.35,0:05:42.51,Caption,,0,0,0,,УСТРОИЛИСЬ. И ТУТ ОСОБЕННО ИНТЕРЕСНО,
Dialogue: 0,0:05:42.83,0:05:45.31,Caption,,0,0,0,,ЧТО КУШНЕР ОДНОВРЕМЕННО РАССКАЗЫВАЕТ УЖЕ О БОЛЕЕ
Dialogue: 0,0:05:45.31,0:05:48.59,Caption,,0,0,0,,ШИРОКОЙ СИСТЕМЕ БЕЗОПАСНОСТИ ДЛЯ ВСЕЙ ЕВРОПЫ. ПО ЕГО
Dialogue: 0,0:05:48.67,0:05:52.03,Caption,,0,0,0,,СЛОВАМ, ГОТОВНОСТЬ РОССИИ ОБСУЖДАТЬ ГАРАНТИИ ДЛЯ КИЕВА ПО
Dialogue: 0,0:05:52.03,0:05:54.99,Caption,,0,0,0,,АНАЛОГИИ С ПЯТОЙ СТАТЬЁЙ ЭТО СЕРЬЁЗНЫЙ ШАГ ВПЕРЁД
Dialogue: 0,0:05:55.07,0:05:58.91,Caption,,0,0,0,,И ПРИЗНАК ТОГО, ЧТО МОСКВА НАСТРОЕНА НА УРЕГУЛИРОВАНИЕ. ПРИ ЭТОМ
Dialogue: 0,0:05:58.91,0:06:01.39,Caption,,0,0,0,,ГАРАНТИИ УКРАИНЕ ВООБЩЕ НЕ ДОЛЖНЫ СУЩЕСТВОВАТЬ
Dialogue: 0,0:06:01.39,0:06:06.48,Caption,,0,0,0,,ОТДЕЛЬНО. ОНИ ДОЛЖНЫ СТАТЬ ЧАСТЬЮ НОВОЙ КОНСТРУКЦИИ,
Dialogue: 0,0:06:06.72,0:06:08.72,Caption,,0,0,0,,ГДЕ УКРАИНА ПОЛУЧАЕТ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:06:08.96,0:06:12.32,Caption,,0,0,0,,ЕВРОПА СТАНОВИТСЯ СИЛЬНЕЕ, РОССИЯ ДОЛЖНА БЫТЬ УВЕРЕНА,
Dialogue: 0,0:06:12.40,0:06:14.56,Caption,,0,0,0,,ЧТО НАТО НЕ СОБИРАЕТСЯ С НЕЙ ВОЕВАТЬ,
Dialogue: 0,0:06:14.82,0:06:18.96,Caption,,0,0,0,,А НАТО ДОЛЖНО БЫТЬ УВЕРЕНО, ЧТО РОССИЯ УВАЖАЕТ БЕЗОПАСНОСТЬ СОСЕДЕЙ.
Dialogue: 0,0:06:19.60,0:06:21.92,Caption,,0,0,0,,НА БУМАГЕ ВСЁ АККУРАТНО КОНСУЛЬТАЦИИ,
Dialogue: 0,0:06:22.13,0:06:24.80,Caption,,0,0,0,,ПРОЗРАЧНОСТЬ, ПРЕДОТВРАЩЕНИЕ СТОЛКНОВЕНИЙ,
Dialogue: 0,0:06:24.89,0:06:27.92,Caption,,0,0,0,,СНИЖЕНИЕ НАПРЯЖЁННОСТИ. В БЛИЖАЙШИЕ НЕДЕЛИ США
Dialogue: 0,0:06:27.92,0:06:30.56,Caption,,0,0,0,,СОБИРАЮТСЯ ОБСУЖДАТЬ ЭТУ КОНСТРУКЦИЮ С МОСКВОЙ,
Dialogue: 0,0:06:30.72,0:06:34.00,Caption,,0,0,0,,КИЕВОМ И ЕВРОПЕЙЦАМИ. НО ТУТ ЖЕ ОСТАЁТСЯ ГЛАВНЫЙ
Dialogue: 0,0:06:34.00,0:06:37.52,Caption,,0,0,0,,КАМЕНЬ. КИЕВ ХОЧЕТ ЗАПАДНЫЕ ВОЙСКА. МОСКВА ПРОТИВ И
Dialogue: 0,0:06:37.52,0:06:41.12,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ, ЧТО ИХ ВВОД ПРИВЕДЁТ К ВОЗОБНОВЛЕНИЮ КОНФЛИКТА.
Dialogue: 0,0:06:41.38,0:06:44.08,Caption,,0,0,0,,ВАШИНГТОН ПРОДВИГАЕТ ГАРАНТИИ БЕЗ ПОСТОЯННОГО
Dialogue: 0,0:06:44.08,0:06:46.56,Caption,,0,0,0,,РАЗМЕЩЕНИЯ ВОЙСК. ПРИ ЭТОМ В СЛУЧАЕ НОВОГО
Dialogue: 0,0:06:46.56,0:06:49.68,Caption,,0,0,0,,НАСТУПЛЕНИЯ ЭТИ САМЫЕ СИЛЫ ДОЛЖНЫ БЫСТРО ПОЯВИТЬСЯ
Dialogue: 0,0:06:49.76,0:06:52.48,Caption,,0,0,0,,НА УКРАИНЕ. ТО ЕСТЬ СПОР НЕ ИСЧЕЗ. ЕГО
Dialogue: 0,0:06:52.48,0:06:55.04,Caption,,0,0,0,,ПРОСТО ПЕРЕНЕСЛИ ИЗ ВОПРОСА "БУДУТ ЛИ ВОЙСКА" В
Dialogue: 0,0:06:55.12,0:06:58.32,Caption,,0,0,0,,ВОПРОС "КОГДА ИМЕННО ОНИ ПОЯВЯТСЯ". ПОДПИШИТЕСЬ НА
Dialogue: 0,0:06:58.32,0:07:01.12,Caption,,0,0,0,,КАНАЛ, ЕСЛИ ХОТИТЕ ДАЛЬШЕ РАЗБИРАТЬ ИМЕННО ТАКИЕ
Dialogue: 0,0:07:01.12,0:07:04.08,Caption,,0,0,0,,НЕСТЫКОВКИ. ПОТОМУ ЧТО САМОЕ ИНТЕРЕСНОЕ В БОЛЬШИХ
Dialogue: 0,0:07:04.08,0:07:06.80,Caption,,0,0,0,,СОГЛАШЕНИЯХ ЧАСТО ПРЯЧЕТСЯ НЕ В КРАСИВОМ НАЗВАНИИ,
Dialogue: 0,0:07:07.04,0:07:10.00,Caption,,0,0,0,,А В ОДНОМ МАЛЕНЬКОМ УСЛОВИИ. КУШНЕР ДОБАВЛЯЕТ ЕЩЁ
Dialogue: 0,0:07:10.00,0:07:11.92,Caption,,0,0,0,,ОДНУ ФРАЗУ НИЧЕГО НЕ СОГЛАСОВАНО,
Dialogue: 0,0:07:12.07,0:07:14.40,Caption,,0,0,0,,ПОКА НЕ СОГЛАСОВАНО ВСЁ. ВОТ ЭТО,
Dialogue: 0,0:07:14.51,0:07:17.36,Caption,,0,0,0,,ПОЖАЛУЙ, САМАЯ ПОЛЕЗНАЯ ФРАЗА ВО ВСЕЙ ИСТОРИИ.
Dialogue: 0,0:07:19.63,0:07:22.11,Caption,,0,0,0,,ПОТОМУ ЧТО ПОКА ДЕЙСТВИТЕЛЬНО НИЧЕГО НЕ СКЛАДЫВАЕТСЯ
Dialogue: 0,0:07:22.19,0:07:25.31,Caption,,0,0,0,,В ОДНУ РОВНУЮ КАРТИНУ. МОСКВА ЯКОБЫ СОГЛАСНА НА
Dialogue: 0,0:07:25.31,0:07:27.23,Caption,,0,0,0,,ГАРАНТИИ ПО ОБРАЗЦУ ПЯТОЙ СТАТЬИ,
Dialogue: 0,0:07:27.55,0:07:30.43,Caption,,0,0,0,,НО ОДНОВРЕМЕННО ПРОТИВ КВАЗИЧЛЕНСТВА УКРАИНЫ В НАТО.
Dialogue: 0,0:07:30.86,0:07:33.55,Caption,,0,0,0,,ЗАПАД ОБЕЩАЕТ УЧИТЫВАТЬ РОССИЙСКУЮ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:07:33.86,0:07:36.59,Caption,,0,0,0,,НО ОБСУЖДАЕТ МЕХАНИЗМ БЫСТРОГО ВХОДА СИЛ НАТО НА
Dialogue: 0,0:07:36.59,0:07:39.47,Caption,,0,0,0,,УКРАИНУ ПРИ НОВОМ КОНФЛИКТЕ. ГОВОРЯТ О СНИЖЕНИИ
Dialogue: 0,0:07:39.47,0:07:43.31,Caption,,0,0,0,,НАПРЯЖЁННОСТИ, НО ОДНОВРЕМЕННО ЗАРАНЕЕ ГОТОВЯТ МЕХАНИЗМ ВОЗВРАТА
Dialogue: 0,0:07:43.31,0:07:46.27,Caption,,0,0,0,,САНКЦИЙ И ВОЕННОГО РЕАГИРОВАНИЯ. ВОТ И ХОЧЕТСЯ
Dialogue: 0,0:07:46.27,0:07:48.27,Caption,,0,0,0,,ПОНЯТЬ ГДЕ ЗДЕСЬ ТА ЧАСТЬ СДЕЛКИ,
Dialogue: 0,0:07:48.51,0:07:50.43,Caption,,0,0,0,,РАДИ КОТОРОЙ МОСКВА ДОЛЖНА СКАЗАТЬ "ДА"?
Dialogue: 0,0:07:51.06,0:07:53.31,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ОТДЕЛЬНАЯ ИСТОРИЯ С ЯДЕРНОЙ
Dialogue: 0,0:07:53.31,0:07:57.87,Caption,,0,0,0,,ДЕКЛАРАЦИЕЙ РОССИИ, США И КИТАЯ ЗДЕСЬ ОКАЗЫВАЕТСЯ ОЧЕНЬ К МЕСТУ.
Dialogue: 0,0:07:58.08,0:08:00.19,Caption,,0,0,0,,ТАМ ВОПРОС ВООБЩЕ НЕ О КРАСИВОЙ БУМАГЕ,
Dialogue: 0,0:08:00.43,0:08:04.51,Caption,,0,0,0,,А О ТОМ, ЧЕГО БУМАГА СТОИТ В РЕАЛЬНОЙ ПОЛИТИКЕ. ДЛЯ МНОГИХ
Dialogue: 0,0:08:04.51,0:08:07.47,Caption,,0,0,0,,В РОССИИ ЯДЕРНОЕ ОРУЖИЕ ВОСПРИНИМАЕТСЯ КАК ПОСЛЕДНИЙ
Dialogue: 0,0:08:07.47,0:08:10.99,Caption,,0,0,0,,СДЕРЖИВАЮЩИЙ АРГУМЕНТ. ОТСЮДА И ВОПРОС ЕСЛИ РОССИЯ,
Dialogue: 0,0:08:11.13,0:08:13.87,Caption,,0,0,0,,США И КИТАЙ ПОДПИСЫВАЮТ ДЕКЛАРАЦИЮ О СНИЖЕНИИ
Dialogue: 0,0:08:13.87,0:08:17.07,Caption,,0,0,0,,ЯДЕРНЫХ РИСКОВ, ЧТО ОНА РЕАЛЬНО ЗАПРЕЩАЕТ И,
Dialogue: 0,0:08:17.15,0:08:20.75,Caption,,0,0,0,,НАПРИМЕР, СВЯЗЫВАЕТ ЛИ ОНА РУКИ ВАШИНГТОНУ В ОТНОШЕНИИ ИРАНА?
Dialogue: 0,0:08:21.04,0:08:24.19,Caption,,0,0,0,,ДЕКЛАРАЦИЯ ОСТАЁТСЯ ДЕКЛАРАЦИЕЙ. ОНА НЕ ПРЕВРАЩАЕТСЯ
Dialogue: 0,0:08:24.19,0:08:26.83,Caption,,0,0,0,,АВТОМАТИЧЕСКИ В ПОЛНОЦЕННЫЙ МЕЖДУНАРОДНЫЙ ДОГОВОР.
Dialogue: 0,0:08:27.17,0:08:29.39,Caption,,0,0,0,,НО ДАЖЕ ДОГОВОР САМ ПО СЕБЕ НЕ СОЗДАЁТ
Dialogue: 0,0:08:29.39,0:08:33.15,Caption,,0,0,0,,ВОЛШЕБНУЮ СТЕНУ, ЧЕРЕЗ КОТОРУЮ ГОСУДАРСТВА НИКОГДА НЕ ПЕРЕСТУПАЮТ.
Dialogue: 0,0:08:35.44,0:08:38.16,Caption,,0,0,0,,У ЛЮБОГО ОБЯЗАТЕЛЬСТВА ЕСТЬ ДВЕ ПРОСТЫЕ СОСТАВЛЯЮЩИЕ
Dialogue: 0,0:08:38.16,0:08:40.80,Caption,,0,0,0,,ЖЕЛАНИЕ ЕГО ВЫПОЛНИТЬ И РЕАЛЬНЫЕ ВОЗМОЖНОСТИ ЭТО
Dialogue: 0,0:08:40.80,0:08:43.36,Caption,,0,0,0,,СДЕЛАТЬ. А ЭТО УЖЕ НАПРЯМУЮ КАСАЕТСЯ БУДУЩИХ
Dialogue: 0,0:08:43.36,0:08:46.40,Caption,,0,0,0,,ГАРАНТИЙ УКРАИНЕ. МОЖНО НАПИСАТЬ ХОТЬ ДЕСЯТЬ СТРАНИЦ
Dialogue: 0,0:08:46.48,0:08:49.12,Caption,,0,0,0,,ПРО КОЛЛЕКТИВНУЮ ЗАЩИТУ. МОЖНО ПРИДУМАТЬ КРАСИВОЕ
Dialogue: 0,0:08:49.12,0:08:52.56,Caption,,0,0,0,,НАЗВАНИЕ. МОЖНО ПРОВЕСТИ ТОРЖЕСТВЕННУЮ ЦЕРЕМОНИЮ. НО
Dialogue: 0,0:08:52.64,0:08:55.20,Caption,,0,0,0,,В КРИТИЧЕСКИЙ МОМЕНТ ЗНАЧЕНИЕ БУДЕТ ИМЕТЬ НЕ ШРИФТ
Dialogue: 0,0:08:55.28,0:08:58.96,Caption,,0,0,0,,НА БУМАГЕ, А РЕШЕНИЕ КОНКРЕТНЫХ ПРАВИТЕЛЬСТВ. В ЭТОЙ ЛОГИКЕ
Dialogue: 0,0:08:58.96,0:09:02.00,Caption,,0,0,0,,ВСПОМИНАЮТСЯ СТАРЫЕ ОБЕЩАНИЯ ВОКРУГ РАСШИРЕНИЯ НАТО,
Dialogue: 0,0:09:02.24,0:09:05.04,Caption,,0,0,0,,СОЮЗНИЧЕСКИЕ ОБЯЗАТЕЛЬСТВА БРИТАНИИ И ФРАНЦИИ ПЕРЕД
Dialogue: 0,0:09:05.04,0:09:07.44,Caption,,0,0,0,,ПОЛЬШЕЙ В ТЫСЯЧА ДЕВЯТЬСОТ ТРИДЦАТЬ ДЕВЯТОМ ГОДУ,
Dialogue: 0,0:09:07.68,0:09:10.24,Caption,,0,0,0,,СОВРЕМЕННЫЕ ЭПИЗОДЫ С РАКЕТАМИ И БЕСПИЛОТНИКАМИ НА
Dialogue: 0,0:09:10.24,0:09:13.84,Caption,,0,0,0,,ТЕРРИТОРИИ ПОЛЬШИ И РУМЫНИИ. СМЫСЛ ОДИН. ФОРМАЛЬНОЕ
Dialogue: 0,0:09:13.84,0:09:16.00,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВО И РЕАЛЬНОЕ ДЕЙСТВИЕ НЕ ВСЕГДА
Dialogue: 0,0:09:16.00,0:09:19.52,Caption,,0,0,0,,СОВПАДАЮТ. ЕСТЬ И БОЛЕЕ ЖЁСТКАЯ ВЕРСИЯ США ВЫПОЛНЯЮТ
Dialogue: 0,0:09:19.52,0:09:22.08,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ ОБЯЗАТЕЛЬСТВА РОВНО ДО ТОЙ ТОЧКИ,
Dialogue: 0,0:09:22.32,0:09:24.64,Caption,,0,0,0,,ПОКА ОНИ СОВПАДАЮТ С АМЕРИКАНСКИМ ИНТЕРЕСОМ.
Dialogue: 0,0:09:25.04,0:09:27.28,Caption,,0,0,0,,ВСПОМНИТЕ ИСТОРИЮ С МАДУРО И ДЕЙСТВИЯ ПРОТИВ
Dialogue: 0,0:09:27.28,0:09:30.00,Caption,,0,0,0,,РУКОВОДСТВА ИРАНА. ОТДЕЛЬНО УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:09:30.16,0:09:32.88,Caption,,0,0,0,,ЧТО ПОЛНОМОЧИЯ ТРАМПА В ВОПРОСЕ ЯДЕРНОГО УДАРА ПО
Dialogue: 0,0:09:32.88,0:09:36.16,Caption,,0,0,0,,ИРАНУ ОГРАНИЧЕНЫ КОНГРЕССОМ. И НА ЭТОМ ФОНЕ ОСОБЕННО
Dialogue: 0,0:09:36.16,0:09:37.92,Caption,,0,0,0,,ИРОНИЧНО ЗВУЧАТ РАЗГОВОРЫ О ТОМ,
Dialogue: 0,0:09:38.08,0:09:40.96,Caption,,0,0,0,,ЧТО ЛИЧНАЯ БЕЗОПАСНОСТЬ ЛИДЕРОВ ГОСУДАРСТВ ЯВЛЯЕТСЯ
Dialogue: 0,0:09:40.96,0:09:43.12,Caption,,0,0,0,,ВАЖНОЙ ЧАСТЬЮ МЕЖДУНАРОДНОЙ СТАБИЛЬНОСТИ.
Dialogue: 0,0:09:45.39,0:09:48.35,Caption,,0,0,0,,ОТДЕЛЬНЫЙ ВОПРОС О РОССИИ. ЕСЛИ ПУТИН ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:09:48.35,0:09:50.91,Caption,,0,0,0,,ВОСПРИНИМАЕТ СОБСТВЕННЫЕ ОБЯЗАТЕЛЬСТВА СЕРЬЁЗНЕЕ,
Dialogue: 0,0:09:51.00,0:09:55.63,Caption,,0,0,0,,ЧЕМ АМЕРИКАНСКАЯ СТОРОНА, ТОГДА ДЛЯ МОСКВЫ ЦЕНА ПОДПИСИ СТАНОВИТСЯ ЕЩЁ ВЫШЕ.
Dialogue: 0,0:09:55.95,0:09:59.31,Caption,,0,0,0,,ОТСЮДА И ЯДЕРНАЯ ЧАСТЬ. ПУТИН ГОВОРИЛ О КАЛИНИНГРАДЕ
Dialogue: 0,0:09:59.31,0:10:02.59,Caption,,0,0,0,,НА ВАЛДАЕ. ЗАТЕМ РЯБКОВ ИСПОЛЬЗОВАЛ ФОРМУЛУ "ВСЕ
Dialogue: 0,0:10:02.59,0:10:06.83,Caption,,0,0,0,,ДОКТРИНАЛЬНЫЕ СРЕДСТВА", НЕ ПРОИЗНОСЯ СЛОВО "ЯДЕРНЫЕ". ПОТОМ ПОЯВИЛАСЬ
Dialogue: 0,0:10:06.83,0:10:09.87,Caption,,0,0,0,,ДЕКЛАРАЦИЯ О СНИЖЕНИИ ЯДЕРНЫХ РИСКОВ. А СЛЕДОМ
Dialogue: 0,0:10:09.87,0:10:13.87,Caption,,0,0,0,,ПРОИЗОШЛА АТАКА. СОВПАДЕНИЕ? СОВПАДЕНИЕ ЕЩЁ НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:10:13.97,0:10:16.51,Caption,,0,0,0,,ЧТО ЭТИ СОБЫТИЯ СВЯЗАНЫ. НО ВОПРОС К НОВОЙ
Dialogue: 0,0:10:16.51,0:10:19.71,Caption,,0,0,0,,СИСТЕМЕ ГАРАНТИЙ ОСТАЁТСЯ. ЕСЛИ КРУПНЕЙШИЕ ДЕРЖАВЫ
Dialogue: 0,0:10:19.71,0:10:23.47,Caption,,0,0,0,,СПОРЯТ ДАЖЕ О ТОМ, НАСКОЛЬКО РЕАЛЬНО ОГРАНИЧИВАЮТ ИХ ДЕКЛАРАЦИИ В
Dialogue: 0,0:10:23.47,0:10:27.15,Caption,,0,0,0,,ЯДЕРНОЙ СФЕРЕ, ТО НАСКОЛЬКО АВТОМАТИЧЕСКИ БУДЕТ РАБОТАТЬ БУДУЩАЯ
Dialogue: 0,0:10:27.15,0:10:31.31,Caption,,0,0,0,,БУМАГА ПО УКРАИНЕ? И ЗДЕСЬ МЫ СНОВА ВОЗВРАЩАЕМСЯ К ЗЕЛЕНСКОМУ. ОН
Dialogue: 0,0:10:31.39,0:10:33.71,Caption,,0,0,0,,ВЕДЬ ИМЕННО ПОЭТОМУ ТРЕБУЕТ ГАРАНТИИ НЕ НА ЧЕТЫРЕ
Dialogue: 0,0:10:33.71,0:10:38.03,Caption,,0,0,0,,ГОДА, А НА ДЕСЯТИЛЕТИЯ. НЕ ОБЕЩАНИЕ ТРАМПА. НЕ КРАСИВУЮ
Dialogue: 0,0:10:38.03,0:10:41.47,Caption,,0,0,0,,ФОТОГРАФИЮ. НЕ ФРАЗУ "МЫ ОБЯЗАТЕЛЬНО ПОМОЖЕМ". ЕМУ
Dialogue: 0,0:10:41.47,0:10:46.19,Caption,,0,0,0,,НУЖЕН МЕХАНИЗМ, КОТОРЫЙ ПЕРЕЖИВЁТ КОНКРЕТНОГО ПРЕЗИДЕНТА США. И ТУТ
Dialogue: 0,0:10:46.19,0:10:49.15,Caption,,0,0,0,,ВОЗНИКАЕТ ВТОРОЙ ВОПРОС. ЕСЛИ ТАКОЙ МЕХАНИЗМ БУДЕТ
Dialogue: 0,0:10:49.15,0:10:53.31,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ЖЁСТКИМ, ЧТО ПОЛУЧАЕТ МОСКВА В ОБМЕН НА ЕГО ПРИНЯТИЕ?
Dialogue: 0,0:10:53.50,0:10:55.95,Caption,,0,0,0,,ПОКА ОТВЕТ ВЫГЛЯДИТ ОЧЕНЬ СКРОМНО САНКЦИОННОЕ
Dialogue: 0,0:10:55.95,0:10:58.51,Caption,,0,0,0,,ПОСЛАБЛЕНИЕ И ОБЕЩАНИЕ УЧИТЫВАТЬ РОССИЙСКИЕ
Dialogue: 0,0:10:58.59,0:11:03.44,Caption,,0,0,0,,ИНТЕРЕСЫ. НО ПАРАЛЛЕЛЬНО ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ЧАСТЬ
Dialogue: 0,0:11:03.44,0:11:07.04,Caption,,0,0,0,,КОНСТРУКЦИИ. ЭКОНОМИКА. КУШНЕР ПО ПОРУЧЕНИЮ ТРАМПА
Dialogue: 0,0:11:07.04,0:11:10.00,Caption,,0,0,0,,ГОВОРИТ О ПРОЕКТЕ "УСПЕШНОЙ И СИЛЬНОЙ УКРАИНЫ" ПОСЛЕ
Dialogue: 0,0:11:10.00,0:11:12.80,Caption,,0,0,0,,КОНФЛИКТА. НАД НИМ РАБОТАЮТ ВСЕМИРНЫЙ БАНК,
Dialogue: 0,0:11:12.91,0:11:16.88,Caption,,0,0,0,,"БЛЭКРОК", ЕВРОСОЮЗ И КОМАНДА ЗЕЛЕНСКОГО. КУШНЕР ГОВОРИТ,
Dialogue: 0,0:11:17.11,0:11:19.60,Caption,,0,0,0,,ЧТО В РАБОТЕ С ЗЕЛЕНСКИМ УЖЕ ДОСТИГНУТ СЕРЬЁЗНЫЙ
Dialogue: 0,0:11:19.60,0:11:23.04,Caption,,0,0,0,,ПРОГРЕСС, А ЗНАЧИМЫЕ АМЕРИКАНСКИЕ ОБЯЗАТЕЛЬСТВА ДОЛЖНЫ ПРОЙТИ
Dialogue: 0,0:11:23.12,0:11:25.84,Caption,,0,0,0,,ЧЕРЕЗ КОНГРЕСС. ОДНОВРЕМЕННО, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:11:26.08,0:11:28.48,Caption,,0,0,0,,РОССИЯ СОГЛАСИЛАСЬ УЧАСТВОВАТЬ В МНОГОСТОРОННЕМ
Dialogue: 0,0:11:28.48,0:11:32.48,Caption,,0,0,0,,ФОРМАТЕ С ЕВРОПЕЙЦАМИ, ПОТОМУ ЧТО УЧАСТИЕ ЕВРОПЫ СЧИТАЮТ ВАЖНЫМ ДЛЯ
Dialogue: 0,0:11:32.48,0:11:35.20,Caption,,0,0,0,,ЗАВЕРШЕНИЯ КОНФЛИКТА. ТО ЕСТЬ ПЫТАЮТСЯ СОБРАТЬ УЖЕ
Dialogue: 0,0:11:35.28,0:11:39.52,Caption,,0,0,0,,НЕ ОДИН ДОГОВОР, А ЦЕЛУЮ ПОСЛЕВОЕННУЮ СИСТЕМУ. УКРАИНЕ ГАРАНТИРУЮТ
Dialogue: 0,0:11:39.52,0:11:42.32,Caption,,0,0,0,,БЕЗОПАСНОСТЬ, ЕВРОПЕ ДАЮТ МЕСТО ЗА СТОЛОМ,
Dialogue: 0,0:11:42.56,0:11:44.96,Caption,,0,0,0,,РОССИИ ПРЕДЛАГАЮТ ЭКОНОМИЧЕСКИЕ ПОСЛАБЛЕНИЯ,
Dialogue: 0,0:11:45.20,0:11:47.60,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ СТРУКТУРЫ ГОТОВЯТ ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:11:47.84,0:11:50.00,Caption,,0,0,0,,А АМЕРИКАНСКИЕ ОБЯЗАТЕЛЬСТВА ПРОВОДЯТ ЧЕРЕЗ
Dialogue: 0,0:11:50.00,0:11:52.56,Caption,,0,0,0,,КОНГРЕСС. И ВОТ ТЕПЕРЬ СТАНОВИТСЯ ПОНЯТНЕЕ,
Dialogue: 0,0:11:52.80,0:11:55.92,Caption,,0,0,0,,ПОЧЕМУ ПЕРЕГОВОРЫ ТАКИЕ ТЯЖЁЛЫЕ. ЭТО УЖЕ НЕ ВОПРОС
Dialogue: 0,0:11:55.92,0:11:58.80,Caption,,0,0,0,,ОДНОЙ ЛИНИИ НА КАРТЕ. ЗДЕСЬ ПЫТАЮТСЯ ОДНОВРЕМЕННО
Dialogue: 0,0:11:58.80,0:12:02.08,Caption,,0,0,0,,РЕШИТЬ ТЕРРИТОРИЮ, НАТО, ИНОСТРАННЫЕ ВОЙСКА,
Dialogue: 0,0:12:02.24,0:12:04.88,Caption,,0,0,0,,САНКЦИИ, БУДУЩУЮ АРМИЮ УКРАИНЫ,
Dialogue: 0,0:12:05.12,0:12:09.28,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ, АМЕРИКАНСКИЕ ОБЯЗАТЕЛЬСТВА И ОГРОМНЫЕ ДЕНЬГИ НА
Dialogue: 0,0:12:09.28,0:12:14.20,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ. НО ЧЕМ БОЛЬШЕ ДЕТАЛЕЙ ПОЯВЛЯЕТСЯ,
Dialogue: 0,0:12:14.45,0:12:17.80,Caption,,0,0,0,,ТЕМ СИЛЬНЕЕ БРОСАЕТСЯ В ГЛАЗА ПЕРЕКОС. КИЕВ ПРОСИТ
Dialogue: 0,0:12:17.80,0:12:21.08,Caption,,0,0,0,,ГАРАНТИИ НА ДЕСЯТИЛЕТИЯ. НАТО СОХРАНЯЕТ МЕХАНИЗМ
Dialogue: 0,0:12:21.08,0:12:24.36,Caption,,0,0,0,,ВОЕННОГО ВКЛЮЧЕНИЯ. ЕВРОПА ХОЧЕТ УЧАСТВОВАТЬ В НОВОЙ
Dialogue: 0,0:12:24.36,0:12:27.72,Caption,,0,0,0,,СИСТЕМЕ. "БЛЭКРОК" И ВСЕМИРНЫЙ БАНК УЖЕ ФИГУРИРУЮТ В
Dialogue: 0,0:12:27.72,0:12:30.52,Caption,,0,0,0,,ПОСЛЕВОЕННОЙ ЭКОНОМИЧЕСКОЙ МОДЕЛИ. ВАШИНГТОН
Dialogue: 0,0:12:30.52,0:12:33.32,Caption,,0,0,0,,ОСТАВЛЯЕТ САНКЦИОННЫЙ КНУТ. А ДЛЯ МОСКВЫ ПОКА
Dialogue: 0,0:12:33.40,0:12:36.36,Caption,,0,0,0,,ПУБЛИЧНО ВИДНЫ ГЛАВНЫМ ОБРАЗОМ ОБЕЩАНИЯ ПОСЛАБЛЕНИЙ
Dialogue: 0,0:12:36.44,0:12:40.68,Caption,,0,0,0,,И СЛОВА О ТОМ, ЧТО ЕЁ ОПАСЕНИЯ ТОЖЕ БУДУТ УЧИТЫВАТЬ. ВОТ ТУТ
Dialogue: 0,0:12:40.76,0:12:43.40,Caption,,0,0,0,,И ПРОВЕРЯЕТСЯ ВСЯ КОНСТРУКЦИЯ. ЕСЛИ РОССИЯ
Dialogue: 0,0:12:43.40,0:12:45.16,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПОЛУЧАЕТ ДРУГОЕ,
Dialogue: 0,0:12:45.25,0:12:47.32,Caption,,0,0,0,,СЕРЬЁЗНОЕ ВСТРЕЧНОЕ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:12:47.64,0:12:50.20,Caption,,0,0,0,,ЕГО ПОКА НИКТО ПУБЛИЧНО НЕ НАЗВАЛ. А ЕСЛИ
Dialogue: 0,0:12:50.20,0:12:53.72,Caption,,0,0,0,,ЕГО НЕТ, ТОГДА ВОПРОС О КАПИТУЛЯЦИОННОМ ХАРАКТЕРЕ ЭТОЙ СХЕМЫ
Dialogue: 0,0:12:53.72,0:12:56.60,Caption,,0,0,0,,НИКУДА НЕ ДЕВАЕТСЯ. ПРИЧЁМ ТРАМП САМ ГОВОРИТ,
Dialogue: 0,0:12:56.84,0:12:59.48,Caption,,0,0,0,,ЧТО ПУТИН ХОЧЕТ ЗАКОНЧИТЬ КОНФЛИКТ ПЕРЕГОВОРАМИ.
Dialogue: 0,0:12:59.65,0:13:02.68,Caption,,0,0,0,,ХОРОШО. НО ЖЕЛАНИЕ ЗАКОНЧИТЬ КОНФЛИКТ НЕ ОЗНАЧАЕТ
Dialogue: 0,0:13:02.68,0:13:04.36,Caption,,0,0,0,,ЖЕЛАНИЕ ПОДПИСАТЬ ЛЮБОЙ ТЕКСТ,
Dialogue: 0,0:13:04.60,0:13:07.48,Caption,,0,0,0,,КОТОРЫЙ ПОЛОЖАТ НА СТОЛ. МЕЖДУ ЭТИМИ ДВУМЯ ВЕЩАМИ
Dialogue: 0,0:13:07.48,0:13:10.76,Caption,,0,0,0,,ОГРОМНАЯ РАЗНИЦА. ИМЕННО ПОЭТОМУ СЛОВА БУДАНОВА ПРО
Dialogue: 0,0:13:10.84,0:13:13.24,Caption,,0,0,0,,ЧУДО ДО КОНЦА ГОДА ЗВУЧАТ ВПОЛНЕ ЛОГИЧНО ДАЖЕ
Dialogue: 0,0:13:13.32,0:13:16.20,Caption,,0,0,0,,БЕЗ ВСЯКОЙ МИСТИКИ. СОГЛАСОВАТЬ НУЖНО НЕ ОДНУ ФРАЗУ.
Dialogue: 0,0:13:16.38,0:13:20.68,Caption,,0,0,0,,НУЖНО СОСТЫКОВАТЬ УСЛОВИЯ, КОТОРЫЕ ПОКА СМОТРЯТ В РАЗНЫЕ СТОРОНЫ. А НА
Dialogue: 0,0:13:20.76,0:13:23.32,Caption,,0,0,0,,САМОМ ВЕРХУ ВСЁ ЭТО НАЗЫВАЕТСЯ БУДУЩЕЙ СИСТЕМОЙ
Dialogue: 0,0:13:23.32,0:13:29.28,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ВОТ ТОЛЬКО СИСТЕМА БЕЗОПАСНОСТИ НАЧИНАЕТСЯ НЕ С
Dialogue: 0,0:13:29.28,0:13:32.48,Caption,,0,0,0,,КРАСИВОГО НАЗВАНИЯ. ОНА НАЧИНАЕТСЯ С ОТВЕТА НА ОЧЕНЬ
Dialogue: 0,0:13:32.48,0:13:35.60,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС ПОЧЕМУ КАЖДАЯ СТОРОНА ДОЛЖНА СЧИТАТЬ,
Dialogue: 0,0:13:35.84,0:13:38.48,Caption,,0,0,0,,ЧТО ПОСЛЕ ПОДПИСАНИЯ ЕЙ СТАЛО БЕЗОПАСНЕЕ,
Dialogue: 0,0:13:38.64,0:13:43.04,Caption,,0,0,0,,А НЕ НАОБОРОТ? У УКРАИНЫ СВОЙ ОТВЕТ ЕСТЬ. ДОЛГОСРОЧНЫЕ ГАРАНТИИ,
Dialogue: 0,0:13:43.20,0:13:46.96,Caption,,0,0,0,,СОЮЗНИКИ, СНИЖЕНИЕ НЕОБХОДИМОСТИ СОДЕРЖАТЬ МИЛЛИОННУЮ АРМИЮ В
Dialogue: 0,0:13:46.96,0:13:50.24,Caption,,0,0,0,,ОДИНОЧКУ. У ЕВРОПЫ ТОЖЕ ЕСТЬ ОТВЕТ. МЕХАНИЗМ
Dialogue: 0,0:13:50.24,0:13:52.96,Caption,,0,0,0,,СДЕРЖИВАНИЯ НОВОГО КОНФЛИКТА И УЧАСТИЕ В БУДУЩЕЙ
Dialogue: 0,0:13:52.96,0:13:56.08,Caption,,0,0,0,,КОНСТРУКЦИИ. У США ОТВЕТ ВООБЩЕ ПРОСМАТРИВАЕТСЯ
Dialogue: 0,0:13:56.08,0:13:58.80,Caption,,0,0,0,,ПРЕКРАСНО. КОНТРОЛЬ НАД МЕХАНИЗМОМ ГАРАНТИЙ,
Dialogue: 0,0:13:58.96,0:14:03.28,Caption,,0,0,0,,ВЛИЯНИЕ НА САНКЦИОННЫЙ РЕЖИМ, УЧАСТИЕ АМЕРИКАНСКОГО КАПИТАЛА И КОНГРЕССА В
Dialogue: 0,0:14:03.28,0:14:06.16,Caption,,0,0,0,,ПОСЛЕВОЕННОЙ КОНСТРУКЦИИ. А ГДЕ ОТВЕТ ДЛЯ РОССИИ?
Dialogue: 0,0:14:06.47,0:14:10.72,Caption,,0,0,0,,ВОТ ЭТО И ЕСТЬ ТОТ ВОПРОС, КОТОРЫЙ ПОКА ВИСИТ НАД ВСЕЙ ИСТОРИЕЙ. ПОТОМУ ЧТО
Dialogue: 0,0:14:10.72,0:14:14.16,Caption,,0,0,0,,ЕСЛИ ОТВЕТ СВОДИТСЯ К "ВАМ НЕМНОГО ОСЛАБЯТ САНКЦИИ,
Dialogue: 0,0:14:14.40,0:14:18.72,Caption,,0,0,0,,А ВЫ ОТВЕДИТЕ ВОЙСКА, СОГЛАСИТЕСЬ НА ГАРАНТИИ ПО ОБРАЗЦУ НАТО И ПРИМИТЕ
Dialogue: 0,0:14:18.72,0:14:20.88,Caption,,0,0,0,,МЕХАНИЗМ БЫСТРОГО ВХОДА СИЛ АЛЬЯНСА",
Dialogue: 0,0:14:21.36,0:14:23.60,Caption,,0,0,0,,ТО СТАРУЮ ПАПКУ С НАТО ДЕЙСТВИТЕЛЬНО МОЖНО БЫЛО
Dialogue: 0,0:14:23.60,0:14:26.16,Caption,,0,0,0,,ДАЖЕ НЕ ПЕРЕИМЕНОВЫВАТЬ. И ТОГДА СПОР УЖЕ НЕ
Dialogue: 0,0:14:26.24,0:14:29.68,Caption,,0,0,0,,О ТОМ, ХОРОШИЙ ЭТО МИР ИЛИ ПЛОХОЙ. ТОГДА ВОПРОС ГОРАЗДО
Dialogue: 0,0:14:29.68,0:14:32.00,Caption,,0,0,0,,ПРОЩЕ. МОСКВА СТОЛЬКО ЛЕТ ГОВОРИЛА,
Dialogue: 0,0:14:32.24,0:14:34.08,Caption,,0,0,0,,ЧТО ИМЕННО ДЛЯ НЕЁ НЕПРИЕМЛЕМО.
Dialogue: 0,0:14:36.37,0:14:38.69,Caption,,0,0,0,,ЕСЛИ ТЕПЕРЬ ЕЙ ПРЕДЛАГАЮТ ПРИНЯТЬ ПОЧТИ ТУ ЖЕ
Dialogue: 0,0:14:38.69,0:14:40.93,Caption,,0,0,0,,КОНСТРУКЦИЮ, ТОЛЬКО В НОВОЙ УПАКОВКЕ,
Dialogue: 0,0:14:41.32,0:14:43.17,Caption,,0,0,0,,ТО ЧТО ИЗМЕНИЛОСЬ НАСТОЛЬКО СИЛЬНО,
Dialogue: 0,0:14:43.33,0:14:45.17,Caption,,0,0,0,,ЧТО ЭТО ВДРУГ ДОЛЖНО СТАТЬ ПРИЕМЛЕМЫМ?
Dialogue: 0,0:14:45.56,0:14:47.65,Caption,,0,0,0,,ВОТ КОГДА ПОЯВИТСЯ ОТВЕТ НА ЭТОТ ВОПРОС,
Dialogue: 0,0:14:47.96,0:14:52.61,Caption,,0,0,0,,ТОГДА И СТАНЕТ ПОНЯТНО, ГДЕ ЗДЕСЬ РЕАЛЬНАЯ СДЕЛКА. А ПОКА СЛОВО "НЕТ"
Dialogue: 0,0:14:52.61,0:14:55.97,Caption,,0,0,0,,ВСЁ ЕЩЁ ЛЕЖИТ НА СТОЛЕ. И, СУДЯ ПО ВСЕМУ,
Dialogue: 0,0:14:56.13,0:14:58.45,Caption,,0,0,0,,КТО ТО ОПЯТЬ ДЕЛАЕТ ВИД, ЧТО ЕГО ТАМ НЕТ.
