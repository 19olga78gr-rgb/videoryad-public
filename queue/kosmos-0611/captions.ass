Dialogue: 0,0:00:00.12,0:00:03.80,Caption,,0,0,0,,ЗНАЕТЕ, КОСМОС ДОЛГО БЫЛ ДОВОЛЬНО УДОБНЫМ МЕСТОМ. ДАЛЕКО,
Dialogue: 0,0:00:03.88,0:00:06.20,Caption,,0,0,0,,ТИХО, СОСЕД СВЕРХУ НЕ СВЕРЛИТ,
Dialogue: 0,0:00:06.36,0:00:09.00,Caption,,0,0,0,,СНИЗУ НИКТО НЕ СТУЧИТ. А ПОТОМ ТУДА НАЧАЛИ
Dialogue: 0,0:00:09.00,0:00:11.72,Caption,,0,0,0,,ТАЩИТЬ ОРУЖИЕ. И ВОТ ТУТ НАЧИНАЕТСЯ ИНТЕРЕСНАЯ
Dialogue: 0,0:00:11.72,0:00:14.68,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКАЯ ЛОГИКА. ПОТОМУ ЧТО ЕСЛИ ОДИН ПРИНЁС
Dialogue: 0,0:00:14.68,0:00:17.96,Caption,,0,0,0,,НАВЕРХ РУЖЬЁ, ОСТАЛЬНЫЕ ПОЧЕМУ ТО СРАЗУ НАЧИНАЮТ ИСКАТЬ,
Dialogue: 0,0:00:18.12,0:00:21.16,Caption,,0,0,0,,ЧЕМ ЭТО РУЖЬЁ СБИВАТЬ. МАРСИАНЕ И ЛУНАТИКИ,
Dialogue: 0,0:00:21.26,0:00:24.76,Caption,,0,0,0,,ПРЯЧЬТЕСЬ. ЗЕМЛЯНЕ ВОШЛИ В КУРАЖ. ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:00:24.92,0:00:26.84,Caption,,0,0,0,,КОГДА НОВОСТИ НЕ ПРОСТО ПЕРЕСКАЗЫВАЮТ,
Dialogue: 0,0:00:26.99,0:00:29.24,Caption,,0,0,0,,А ПЫТАЮТСЯ ПОНЯТЬ, К ЧЕМУ ВСЁ ЭТО ВЕДЁТ,
Dialogue: 0,0:00:29.40,0:00:31.88,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:32.12,0:00:34.60,Caption,,0,0,0,,КОГДА ОДНА КОРОТКАЯ НОВОСТЬ ОТКРЫВАЕТ ДВЕРЬ В
Dialogue: 0,0:00:34.60,0:00:39.16,Caption,,0,0,0,,ИСТОРИЮ КУДА БОЛЬШЕ, ЧЕМ КАЖЕТСЯ СНАЧАЛА. В СЕНТЯБРЕ МИНИСТР ВОЕННО
Dialogue: 0,0:00:39.16,0:00:41.96,Caption,,0,0,0,,ВОЗДУШНЫХ СИЛ США ТРОЙ МЕЙНК СКАЗАЛ ВЕЩЬ,
Dialogue: 0,0:00:42.20,0:00:45.00,Caption,,0,0,0,,КОТОРУЮ ЕЩЁ ПАРУ ЛЕТ НАЗАД ПРОИЗНОСИЛИ БЫ СИЛЬНО
Dialogue: 0,0:00:45.00,0:00:48.68,Caption,,0,0,0,,ОСТОРОЖНЕЕ. КОСМИЧЕСКИЕ СИЛЫ США УЖЕ ИМЕЮТ НА ОРБИТЕ
Dialogue: 0,0:00:48.68,0:00:51.72,Caption,,0,0,0,,ОРУЖИЕ КОНТРОЛЯ КОСМОСА. НЕ ПЛАНЫ НА ДВАДЦАТЬ КАКОЙ
Dialogue: 0,0:00:51.72,0:00:54.84,Caption,,0,0,0,,НИБУДЬ ГОД. НЕ ПРЕЗЕНТАЦИЮ С КРАСИВЫМИ СТРЕЛОЧКАМИ.
Dialogue: 0,0:00:55.00,0:00:58.52,Caption,,0,0,0,,ОРУЖИЕ УЖЕ НА ОРБИТЕ. ЧТО ИМЕННО ТАМ ЛЕТАЕТ,
Dialogue: 0,0:00:58.60,0:01:01.00,Caption,,0,0,0,,АМЕРИКАНЦЫ НЕ РАССКАЗЫВАЮТ. КИНЕТИКА ЭТО,
Dialogue: 0,0:01:01.24,0:01:06.12,Caption,,0,0,0,,ЭЛЕКТРОНИКА ИЛИ ЧТО ТО ЕЩЁ, ДЕТАЛИ ОСТАВИЛИ ЗА ЗАКРЫТОЙ ДВЕРЬЮ. НО САМ ФАКТ
Dialogue: 0,0:01:06.14,0:01:09.72,Caption,,0,0,0,,ВАШИНГТОН ПРОИЗНЁС ВСЛУХ. И ПРОИЗНЁС НЕ СЛУЧАЙНО. У
Dialogue: 0,0:01:09.72,0:01:11.96,Caption,,0,0,0,,АМЕРИКАНСКИХ КОСМИЧЕСКИХ СИЛ ЕСТЬ ОТДЕЛЬНОЕ
Dialogue: 0,0:01:11.96,0:01:15.24,Caption,,0,0,0,,НАПРАВЛЕНИЕ ORBITAL WARFARE. ОРБИТАЛЬНАЯ ВОЙНА.
Dialogue: 0,0:01:17.52,0:01:22.64,Caption,,0,0,0,,УЖЕ САМО НАЗВАНИЕ ЗВУЧИТ ТАК, БУДТО СЦЕНАРИСТЫ ФАНТАСТИКИ ОСТАЛИСЬ БЕЗ РАБОТЫ. И
Dialogue: 0,0:01:22.64,0:01:24.40,Caption,,0,0,0,,ТУТ ВОПРОС СОВСЕМ НЕ КОСМИЧЕСКИЙ,
Dialogue: 0,0:01:24.56,0:01:27.28,Caption,,0,0,0,,А ДВОРОВЫЙ. ЕСЛИ ТЫ ПЕРВЫМ ПРИНЁС НА КРЫШУ
Dialogue: 0,0:01:27.28,0:01:31.20,Caption,,0,0,0,,РУЖЬЁ, ЧЕГО ПОТОМ УДИВЛЯТЬСЯ, ЧТО СОСЕД ПОЛЕЗ В САРАЙ ИСКАТЬ,
Dialogue: 0,0:01:31.40,0:01:35.68,Caption,,0,0,0,,ЧЕМ ЭТО РУЖЬЁ СБИТЬ? ТЫ САМ ПОМЕНЯЛ ПРАВИЛА. САМ СКАЗАЛ РЕБЯТА,
Dialogue: 0,0:01:35.94,0:01:38.80,Caption,,0,0,0,,ТЕПЕРЬ ЗДЕСЬ ТОЖЕ ВОЕННАЯ ПЛОЩАДКА. НУ ПРЕКРАСНО.
Dialogue: 0,0:01:39.12,0:01:42.32,Caption,,0,0,0,,ТОГДА ГОТОВЬСЯ, ЧТО ОСТАЛЬНЫЕ ПРИДУТ ТУДА НЕ С ТЕЛЕСКОПАМИ.
Dialogue: 0,0:01:42.54,0:01:45.68,Caption,,0,0,0,,АМЕРИКАНЦЫ НАЗЫВАЮТ ЭТО ЗАЩИТОЙ СВОИХ СИЛ И
Dialogue: 0,0:01:45.68,0:01:48.96,Caption,,0,0,0,,ОБЕСПЕЧЕНИЕМ ПРЕВОСХОДСТВА. ХОРОШО. ТОЛЬКО У ДРУГОЙ
Dialogue: 0,0:01:49.04,0:01:51.76,Caption,,0,0,0,,СТОРОНЫ ЛОГИКА БУДЕТ ЗЕРКАЛЬНАЯ. ЕСЛИ НАД ГОЛОВОЙ
Dialogue: 0,0:01:51.84,0:01:55.52,Caption,,0,0,0,,ВИСИТ АППАРАТ, КОТОРЫЙ В НУЖНЫЙ МОМЕНТ СПОСОБЕН ЛИШИТЬ ТЕБЯ СВЯЗИ,
Dialogue: 0,0:01:55.76,0:01:59.36,Caption,,0,0,0,,РАЗВЕДКИ, НАВИГАЦИИ ИЛИ УДАРИТЬ ПО ТВОЕЙ СИСТЕМЕ,
Dialogue: 0,0:01:59.69,0:02:01.44,Caption,,0,0,0,,ТЫ НЕ БУДЕШЬ СИДЕТЬ И НАДЕЯТЬСЯ,
Dialogue: 0,0:02:01.62,0:02:03.84,Caption,,0,0,0,,ЧТО ОН ДОБРЫЙ. ТЫ БУДЕШЬ ГОТОВИТЬ СРЕДСТВО,
Dialogue: 0,0:02:03.96,0:02:06.08,Caption,,0,0,0,,КОТОРОЕ ЕГО ОТКЛЮЧИТ, ОСЛЕПИТ,
Dialogue: 0,0:02:06.21,0:02:08.56,Caption,,0,0,0,,УВЕДЁТ С ОРБИТЫ ИЛИ ПРОСТО СНИМЕТ С ДОСКИ.
Dialogue: 0,0:02:08.86,0:02:11.52,Caption,,0,0,0,,ТАК ВСЕГДА И ПРОИСХОДИЛО. ПОЯВИЛСЯ ТАНК,
Dialogue: 0,0:02:11.63,0:02:14.96,Caption,,0,0,0,,ПОЯВИЛАСЬ ПРОТИВОТАНКОВАЯ ПУШКА. ПОЯВИЛАСЬ АВИАЦИЯ,
Dialogue: 0,0:02:15.04,0:02:17.52,Caption,,0,0,0,,ПОЯВИЛАСЬ ПВО. ПОЯВИЛИСЬ РАКЕТЫ,
Dialogue: 0,0:02:17.60,0:02:20.56,Caption,,0,0,0,,ПОЯВИЛИСЬ ПРОТИВОРАКЕТЫ. ТЕПЕРЬ ДОБРАЛИСЬ ДО ОРБИТЫ.
Dialogue: 0,0:02:20.87,0:02:23.76,Caption,,0,0,0,,НИЧЕГО НОВОГО В ЧЕЛОВЕЧЕСКОЙ ПРИРОДЕ. ПРОСТО ВЫСОТА
Dialogue: 0,0:02:23.76,0:02:26.88,Caption,,0,0,0,,СТАЛА ПОБОЛЬШЕ. И АМЕРИКАНЦЫ ТАМ НЕ ОДНИ. КИТАЙ
Dialogue: 0,0:02:26.88,0:02:29.12,Caption,,0,0,0,,ТОЖЕ ДВИГАЕТСЯ В ЭТУ СТОРОНУ ОЧЕНЬ БОДРО.
Dialogue: 0,0:02:31.40,0:02:34.20,Caption,,0,0,0,,REUTERS РАЗБИРАЛ КИТАЙСКИЕ СПУТНИКИ ОХОТНИКИ,
Dialogue: 0,0:02:34.44,0:02:36.60,Caption,,0,0,0,,МАНЕВРИРУЮЩИЕ АППАРАТЫ И РАЗРАБОТКИ,
Dialogue: 0,0:02:36.84,0:02:39.16,Caption,,0,0,0,,КОТОРЫЕ ПОЗВОЛЯЮТ ПОДХОДИТЬ К ДРУГИМ ОБЪЕКТАМ,
Dialogue: 0,0:02:39.32,0:02:42.35,Caption,,0,0,0,,СОПРОВОЖДАТЬ ИХ, ОСМАТРИВАТЬ И ДЕЛАТЬ С НИМИ ТО,
Dialogue: 0,0:02:42.52,0:02:45.32,Caption,,0,0,0,,ПОСЛЕ ЧЕГО ВЛАДЕЛЬЦУ СТАНЕТ СИЛЬНО НЕ ДО АСТРОНОМИИ.
Dialogue: 0,0:02:45.68,0:02:49.08,Caption,,0,0,0,,У США СВОИ ПРОГРАММЫ. У КИТАЯ СВОИ. РОССИЯ
Dialogue: 0,0:02:49.16,0:02:51.88,Caption,,0,0,0,,ТОЖЕ НЕ СИДИТ С БИНОКЛЕМ НА ЛАВОЧКЕ. КОРОЧЕ,
Dialogue: 0,0:02:51.96,0:02:56.92,Caption,,0,0,0,,ВСЕ, КТО УМЕЕТ ЛЕТАТЬ, ПОЛЕЗЛИ В КОСМОС. КРОМЕ КУР И ПИНГВИНОВ. ЭТИ
Dialogue: 0,0:02:56.92,0:03:00.12,Caption,,0,0,0,,ПОКА ЕДИНСТВЕННЫЕ СОХРАНЯЮТ ЗДРАВЫЙ СМЫСЛ. ЕСЛИ ВАМ
Dialogue: 0,0:03:00.12,0:03:01.88,Caption,,0,0,0,,ИНТЕРЕСЕН ИМЕННО ТАКОЙ РАЗБОР,
Dialogue: 0,0:03:02.04,0:03:05.24,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:03:05.24,0:03:08.04,Caption,,0,0,0,,ЗЕМНОЕ ИЗ ВСЕГО КОСМИЧЕСКОГО. КАК ТОЛЬКО НАВЕРХУ
Dialogue: 0,0:03:08.04,0:03:10.76,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ОРУЖИЕ, ОЧЕНЬ БЫСТРО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:03:11.00,0:03:13.48,Caption,,0,0,0,,ЧТО РЯДОМ УЖЕ КТО ТО КРУТИТСЯ И ПРИМЕРЯЕТСЯ.
Dialogue: 0,0:03:13.64,0:03:15.72,Caption,,0,0,0,,И ВОТ НА ЭТОМ ФОНЕ ИСТОРИЯ С РОССИЙСКИМ
Dialogue: 0,0:03:15.72,0:03:18.20,Caption,,0,0,0,,СПУТНИКОМ "КОСМОС ДВЕ ТЫСЯЧИ ШЕСТЬСОТ ДВЕНАДЦАТЬ"
Dialogue: 0,0:03:18.59,0:03:21.08,Caption,,0,0,0,,ВЫГЛЯДИТ УЖЕ СОВСЕМ НЕ КАК СЛУЧАЙНАЯ ПРОГУЛКА ПО
Dialogue: 0,0:03:21.08,0:03:24.12,Caption,,0,0,0,,ОРБИТЕ. В СЕРЕДИНЕ ОКТЯБРЯ РОССИЙСКИЙ ВОЕННЫЙ
Dialogue: 0,0:03:24.12,0:03:26.76,Caption,,0,0,0,,СПУТНИК ПРИБЛИЗИЛСЯ К АППАРАТУ ИКС ТРИДЦАТЬ ШЕСТЬ
Dialogue: 0,0:03:26.76,0:03:29.48,Caption,,0,0,0,,КОМПАНИИ ICEYE. ЭТО НЕ СПУТНИК,
Dialogue: 0,0:03:29.60,0:03:33.00,Caption,,0,0,0,,КОТОРЫЙ РАЗДАЁТ ИНТЕРНЕТ ДАЧНИКАМ. ICEYE ДЕЛАЕТ
Dialogue: 0,0:03:33.00,0:03:36.20,Caption,,0,0,0,,РАДИОЛОКАЦИОННЫЕ СНИМКИ ЗЕМЛИ И ПРЕДОСТАВЛЯЕТ ДАННЫЕ
Dialogue: 0,0:03:36.28,0:03:38.12,Caption,,0,0,0,,ЗАПАДНЫМ ПРАВИТЕЛЬСТВАМ И ВОЕННЫМ,
Dialogue: 0,0:03:38.36,0:03:40.68,Caption,,0,0,0,,В ТОМ ЧИСЛЕ УКРАИНЕ. ТО ЕСТЬ СВЕРХУ ВИСИТ
Dialogue: 0,0:03:40.68,0:03:45.32,Caption,,0,0,0,,ВПОЛНЕ КОММЕРЧЕСКАЯ ЖЕЛЕЗКА, А РАБОТАЕТ ОНА В ОЧЕНЬ НЕКОММЕРЧЕСКОЙ ОБСТАНОВКЕ.
Dialogue: 0,0:03:47.60,0:03:51.35,Caption,,0,0,0,,REUTERS ПИШЕТ, ЧТО "КОСМОС ДВЕ ТЫСЯЧИ ШЕСТЬСОТ ДВЕНАДЦАТЬ" ПОДОШЁЛ
Dialogue: 0,0:03:51.43,0:03:53.67,Caption,,0,0,0,,К ИКС ТРИДЦАТЬ ШЕСТЬ ПРИМЕРНО НА КИЛОМЕТР,
Dialogue: 0,0:03:53.99,0:03:55.51,Caption,,0,0,0,,А ПО НЕКОТОРЫМ ОЦЕНКАМ И БЛИЖЕ.
Dialogue: 0,0:03:56.07,0:03:58.63,Caption,,0,0,0,,АМЕРИКАНСКИЙ ЧИНОВНИК НАЗВАЛ МАНЁВР НАМЕРЕННЫМ.
Dialogue: 0,0:03:58.80,0:04:01.35,Caption,,0,0,0,,СПЕЦИАЛИСТ ПО ВОЕННОЙ КОСМОНАВТИКЕ ГРЕГ ГИЛЛИНГЕР
Dialogue: 0,0:04:01.36,0:04:04.07,Caption,,0,0,0,,СФОРМУЛИРОВАЛ ЕЩЁ ВЕСЕЛЕЕ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:04:04.23,0:04:06.95,Caption,,0,0,0,,ЭТО ВЫГЛЯДЕЛО КАК РЕПЕТИЦИЯ АТАКИ. И ВОТ ТУТ
Dialogue: 0,0:04:07.03,0:04:09.43,Caption,,0,0,0,,ХОЧЕТСЯ СПРОСИТЬ А ЧЕМУ, СОБСТВЕННО,
Dialogue: 0,0:04:09.51,0:04:13.03,Caption,,0,0,0,,УДИВИЛИСЬ? ЗАПАД ГОДАМИ ИСПОЛЬЗУЕТ КОММЕРЧЕСКИЕ СПУТНИКИ ДЛЯ
Dialogue: 0,0:04:13.11,0:04:15.59,Caption,,0,0,0,,ВОЕННЫХ ЗАДАЧ НА УКРАИНЕ. ОНИ СМОТРЯТ,
Dialogue: 0,0:04:15.74,0:04:20.79,Caption,,0,0,0,,СНИМАЮТ, ПЕРЕДАЮТ ДАННЫЕ, ПОМОГАЮТ ВИДЕТЬ ПРОИСХОДЯЩЕЕ НА ЗЕМЛЕ. ВСЁ УДОБНО.
Dialogue: 0,0:04:21.03,0:04:23.51,Caption,,0,0,0,,ФОРМАЛЬНО КОМПАНИЯ КОММЕРЧЕСКАЯ. АППАРАТ
Dialogue: 0,0:04:23.51,0:04:26.15,Caption,,0,0,0,,КОММЕРЧЕСКИЙ. А РЕЗУЛЬТАТ ПОТОМ ЛЕЖИТ НА СТОЛЕ У
Dialogue: 0,0:04:26.15,0:04:29.43,Caption,,0,0,0,,ВОЕННЫХ. ТАКАЯ СОВРЕМЕННАЯ МАГИЯ. МАГАЗИН ВРОДЕ
Dialogue: 0,0:04:29.43,0:04:33.19,Caption,,0,0,0,,ГРАЖДАНСКИЙ, НО ПОКУПАТЕЛИ ПРИХОДЯТ В ФОРМЕ. А ТЕПЕРЬ РЯДОМ
Dialogue: 0,0:04:33.19,0:04:35.11,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ РОССИЙСКИЙ ВОЕННЫЙ АППАРАТ,
Dialogue: 0,0:04:35.43,0:04:38.15,Caption,,0,0,0,,И ВНЕЗАПНО ВСЕМ СТАНОВИТСЯ ТРЕВОЖНО. НУ А КАК
Dialogue: 0,0:04:38.15,0:04:41.51,Caption,,0,0,0,,ДОЛЖНО БЫЛО БЫТЬ? ЕСЛИ КОСМОС ПРЕВРАЩАЮТ В ЧАСТЬ ВОЕННОЙ
Dialogue: 0,0:04:41.51,0:04:45.51,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ, ЭТА ИНФРАСТРУКТУРА ПОПАДАЕТ В ЧУЖИЕ ВОЕННЫЕ РАСЧЁТЫ.
Dialogue: 0,0:04:45.83,0:04:48.55,Caption,,0,0,0,,НЕЛЬЗЯ ОДНОЙ РУКОЙ ТАЩИТЬ ТУДА ОРУЖИЕ И РАЗВЕДКУ,
Dialogue: 0,0:04:48.79,0:04:50.55,Caption,,0,0,0,,А ВТОРОЙ ВЕШАТЬ ТАБЛИЧКУ НЕ ТРОГАТЬ,
Dialogue: 0,0:04:50.71,0:04:53.83,Caption,,0,0,0,,ЗДЕСЬ ЧАСТНАЯ СОБСТВЕННОСТЬ. ПРИЧЁМ ИСТОРИЯ НА ОДНОМ
Dialogue: 0,0:04:53.83,0:04:55.51,Caption,,0,0,0,,ИКС ТРИДЦАТЬ ШЕСТЬ НЕ ЗАКОНЧИЛАСЬ.
Dialogue: 0,0:04:57.79,0:05:01.62,Caption,,0,0,0,,REUTERS ПИШЕТ, ЧТО ДВА ДРУГИХ РОССИЙСКИХ АППАРАТА НАЧАЛИ СМЕЩАТЬСЯ
Dialogue: 0,0:05:01.70,0:05:04.50,Caption,,0,0,0,,В СТОРОНУ ЕЩЁ ОДНОГО СПУТНИКА ICEYE,
Dialogue: 0,0:05:04.77,0:05:08.02,Caption,,0,0,0,,ИКС ТРИДЦАТЬ СЕМЬ. ТО ЕСТЬ РЕЧЬ УЖЕ НЕ ПРО ОДИН СТРАННЫЙ
Dialogue: 0,0:05:08.02,0:05:11.46,Caption,,0,0,0,,МАНЁВР, КОТОРЫЙ МОЖНО ЗАБЫТЬ ЧЕРЕЗ НЕДЕЛЮ. НА ОРБИТЕ
Dialogue: 0,0:05:11.46,0:05:14.67,Caption,,0,0,0,,НАЧИНАЕТСЯ СТАРАЯ ЗЕМНАЯ ИГРА. КТО ЗА КЕМ СЛЕДИТ.
Dialogue: 0,0:05:15.01,0:05:17.70,Caption,,0,0,0,,КТО К КОМУ ПОДХОДИТ. КТО КОГО ЗАСТАВЛЯЕТ
Dialogue: 0,0:05:17.70,0:05:20.90,Caption,,0,0,0,,МАНЕВРИРОВАТЬ. КТО ПЕРВЫМ МОРГНЁТ. КОСМОС ДАВНО
Dialogue: 0,0:05:20.90,0:05:23.23,Caption,,0,0,0,,ПЕРЕСТАЛ БЫТЬ ПРОСТО КРАСИВЫМ ВЕРХНИМ ЭТАЖОМ,
Dialogue: 0,0:05:23.48,0:05:26.74,Caption,,0,0,0,,ГДЕ ЛЕТАЮТ ДОРОГИЕ КАМЕРЫ. СОВРЕМЕННАЯ АРМИЯ БЕЗ
Dialogue: 0,0:05:26.74,0:05:30.34,Caption,,0,0,0,,КОСМОСА СЛЕПНЕТ ОЧЕНЬ БЫСТРО. СВЯЗЬ. НАВИГАЦИЯ.
Dialogue: 0,0:05:30.50,0:05:33.86,Caption,,0,0,0,,РАЗВЕДКА. ПРЕДУПРЕЖДЕНИЕ О ПУСКАХ. ЦЕЛЕУКАЗАНИЕ.
Dialogue: 0,0:05:34.28,0:05:36.42,Caption,,0,0,0,,ВЫДЕРНИ НЕСКОЛЬКО КЛЮЧЕВЫХ ЭЛЕМЕНТОВ,
Dialogue: 0,0:05:36.59,0:05:39.62,Caption,,0,0,0,,И ВНИЗУ ВНЕЗАПНО НАЧНУТСЯ ОЧЕНЬ НЕПРИЯТНЫЕ СЮРПРИЗЫ.
Dialogue: 0,0:05:40.02,0:05:42.50,Caption,,0,0,0,,ВОТ ПОЭТОМУ НАВЕРХ И ТАЩАТ ВСЁ БОЛЬШЕ ВОЕННЫХ
Dialogue: 0,0:05:42.50,0:05:45.30,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ. НЕ ПОТОМУ ЧТО ГЕНЕРАЛАМ СТАЛО СКУЧНО
Dialogue: 0,0:05:45.38,0:05:48.50,Caption,,0,0,0,,НА ЗЕМЛЕ. ПОТОМУ ЧТО ТОТ, КТО КОНТРОЛИРУЕТ ОРБИТУ,
Dialogue: 0,0:05:48.74,0:05:53.30,Caption,,0,0,0,,ПОЛУЧАЕТ РЫЧАГ НАД ТЕМ, ЧТО ПРОИСХОДИТ ВНИЗУ. И ЕВРОПА РЕШИЛА НЕ ПРОСТО
Dialogue: 0,0:05:53.30,0:05:56.98,Caption,,0,0,0,,СМОТРЕТЬ, КАК БОЛЬШИЕ ДЯДИ ДЕЛЯТ ВЕРХНИЙ ЭТАЖ. НЕМЕЦКАЯ
Dialogue: 0,0:05:56.98,0:06:00.10,Caption,,0,0,0,,КОМПАНИЯ ATMOS SPACE CARGO РАЗРАБАТЫВАЕТ ПРОЕКТ
Dialogue: 0,0:06:00.11,0:06:03.30,Caption,,0,0,0,,PODS. ИДЕЯ ПРОСТАЯ ДО БЕЗОБРАЗИЯ. НА ОРБИТЕ
Dialogue: 0,0:06:03.30,0:06:05.54,Caption,,0,0,0,,НАХОДИТСЯ АППАРАТ СО СПУСКАЕМОЙ КАПСУЛОЙ,
Dialogue: 0,0:06:05.78,0:06:09.06,Caption,,0,0,0,,ВНУТРИ ОБЫЧНЫЙ БОЕПРИПАС. В НУЖНЫЙ МОМЕНТ КАПСУЛА
Dialogue: 0,0:06:09.06,0:06:11.46,Caption,,0,0,0,,ВХОДИТ В АТМОСФЕРУ И ДОСТАВЛЯЕТ ЕГО К ЦЕЛИ.
Dialogue: 0,0:06:13.75,0:06:16.39,Caption,,0,0,0,,ДАЛЬНОСТЬ В ТАКОЙ СХЕМЕ СТАНОВИТСЯ ПОЧТИ ФИЛОСОФСКИМ
Dialogue: 0,0:06:16.39,0:06:18.79,Caption,,0,0,0,,ПОНЯТИЕМ. ЕСЛИ ТЫ УЖЕ НА ОРБИТЕ,
Dialogue: 0,0:06:18.95,0:06:21.67,Caption,,0,0,0,,СПОР О ДВУХ ТЫСЯЧАХ КИЛОМЕТРОВ ВЫГЛЯДИТ НЕМНОГО ПО
Dialogue: 0,0:06:21.67,0:06:26.55,Caption,,0,0,0,,СТАРОМУ. THE TIMES ПИШЕТ, ЧТО ПРОЕКТ РАССМАТРИВАЕТСЯ КАК СИСТЕМА ВЫСОКОТОЧНОГО
Dialogue: 0,0:06:26.55,0:06:29.51,Caption,,0,0,0,,ДАЛЬНЕГО УДАРА. КОМПАНИЯ ХОЧЕТ ПОДКЛЮЧИТЬ КРУПНОГО
Dialogue: 0,0:06:29.51,0:06:32.79,Caption,,0,0,0,,ОБОРОННОГО ПАРТНЁРА ВРОДЕ MBDA. И ЗДЕСЬ ЕВРОПА
Dialogue: 0,0:06:32.79,0:06:36.15,Caption,,0,0,0,,ДЕЛАЕТ ОЧЕНЬ ХАРАКТЕРНЫЙ ШАГ. ЕЩЁ ВЧЕРА РАЗГОВОР ШЁЛ
Dialogue: 0,0:06:36.23,0:06:39.91,Caption,,0,0,0,,О ТОМ, ГДЕ ВЗЯТЬ РАКЕТЫ НА ТЫСЯЧУ КИЛОМЕТРОВ. СЕГОДНЯ УЖЕ
Dialogue: 0,0:06:39.91,0:06:44.31,Caption,,0,0,0,,ОБСУЖДАЮТ, КАК ПРИНЕСТИ БОЕПРИПАС СВЕРХУ. НЕМЕЦКИЙ ГЕНЕРАЛ ИНГО
Dialogue: 0,0:06:44.31,0:06:47.27,Caption,,0,0,0,,ГЕРХАРТЦ ОБЪЯСНИЛ НОВУЮ ЛОГИКУ СОВСЕМ БЕЗ КРУЖЕВ.
Dialogue: 0,0:06:47.70,0:06:49.43,Caption,,0,0,0,,РАНЬШЕ ПЫТАЛИСЬ ПОПАСТЬ В СТРЕЛУ,
Dialogue: 0,0:06:49.63,0:06:52.07,Caption,,0,0,0,,КОТОРУЮ В ТЕБЯ ВЫПУСТИЛИ. ТЕПЕРЬ ХОТЯТ ПОПАДАТЬ В
Dialogue: 0,0:06:52.07,0:06:53.99,Caption,,0,0,0,,ЛУЧНИКА. А ДАЛЬШЕ И В КУЗНИЦУ,
Dialogue: 0,0:06:54.07,0:06:56.79,Caption,,0,0,0,,ГДЕ ЭТИ СТРЕЛЫ ДЕЛАЮТ. СМЫСЛ ПОНЯТЕН И БЕЗ
Dialogue: 0,0:06:56.79,0:06:59.67,Caption,,0,0,0,,ГЕНЕРАЛЬСКИХ ПОГОН. ЗАЩИЩАТЬСЯ ТОЛЬКО НА ПОСЛЕДНЕМ
Dialogue: 0,0:06:59.67,0:07:01.75,Caption,,0,0,0,,МЕТРЕ ДОРОГО И ТЯЖЕЛО. ЗНАЧИТ,
Dialogue: 0,0:07:01.91,0:07:04.15,Caption,,0,0,0,,ХОЧЕТСЯ ДОСТАТЬ ТОГО, КТО СТРЕЛЯЕТ,
Dialogue: 0,0:07:04.25,0:07:07.27,Caption,,0,0,0,,ЕЩЁ ДО ВЫСТРЕЛА. А ПОТОМ ХОЧЕТСЯ ДОСТАТЬ ЗАВОД.
Dialogue: 0,0:07:07.43,0:07:10.47,Caption,,0,0,0,,ПОТОМ СКЛАД. ПОТОМ ТРАНСПОРТ. И ВОТ УЖЕ КАРТА
Dialogue: 0,0:07:10.47,0:07:12.31,Caption,,0,0,0,,ДАЛЬНОСТИ РАСПОЛЗАЕТСЯ ДО ТЕХ ПОР,
Dialogue: 0,0:07:12.63,0:07:14.79,Caption,,0,0,0,,ПОКА СВЕРХУ НЕ ОСТАЁТСЯ ПРИВЫЧНЫХ ГРАНИЦ.
Dialogue: 0,0:07:15.22,0:07:17.51,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО БРИТАНИЯ И ГЕРМАНИЯ РАБОТАЮТ НАД
Dialogue: 0,0:07:17.51,0:07:20.71,Caption,,0,0,0,,РАКЕТАМИ ДАЛЬНОСТЬЮ БОЛЕЕ ДВУХ ТЫСЯЧ КИЛОМЕТРОВ. ЭТО
Dialogue: 0,0:07:20.71,0:07:25.35,Caption,,0,0,0,,ОТДЕЛЬНЫЙ РАКЕТНЫЙ ПРОЕКТ, НЕ СВЯЗАННЫЙ НАПРЯМУЮ С PODS. НО НАПРАВЛЕНИЕ ОДНО.
Dialogue: 0,0:07:25.59,0:07:27.83,Caption,,0,0,0,,ЕВРОПА ХОЧЕТ ВСЁ БОЛЕЕ ДЛИННУЮ РУКУ.
Dialogue: 0,0:07:30.10,0:07:32.90,Caption,,0,0,0,,И ТУТ СНОВА ТА ЖЕ ДВОРОВАЯ АРИФМЕТИКА. ЕСЛИ
Dialogue: 0,0:07:32.90,0:07:36.26,Caption,,0,0,0,,ОДНА СТОРОНА УДЛИНЯЕТ РУКУ, ВТОРАЯ БУДЕТ СТРОИТЬ ЩИТ,
Dialogue: 0,0:07:36.34,0:07:39.86,Caption,,0,0,0,,ПРЯТАТЬ ОБЪЕКТЫ, РАССРЕДОТОЧИВАТЬ ПРОИЗВОДСТВО И ИСКАТЬ,
Dialogue: 0,0:07:40.02,0:07:42.74,Caption,,0,0,0,,ЧЕМ ЭТУ РУКУ УКОРОТИТЬ. А ПОТОМ ВСЕ ОЧЕНЬ
Dialogue: 0,0:07:42.74,0:07:46.98,Caption,,0,0,0,,УДИВЛЯЮТСЯ, ОТКУДА ВЗЯЛАСЬ НОВАЯ ГОНКА ВООРУЖЕНИЙ. ОТТУДА ЖЕ,
Dialogue: 0,0:07:47.15,0:07:50.02,Caption,,0,0,0,,ОТКУДА СТАРАЯ. ОДИН ШАГ ДЕЛАЕТ СЛЕДУЮЩИЙ ШАГ
Dialogue: 0,0:07:50.02,0:07:52.82,Caption,,0,0,0,,ВЫГОДНЫМ ДЛЯ ДРУГОГО. А ТЕПЕРЬ СПУСКАЕМСЯ С ОРБИТЫ
Dialogue: 0,0:07:52.90,0:07:55.70,Caption,,0,0,0,,НЕМНОГО НИЖЕ. УКРАИНСКАЯ РАЗВЕДКА РЕШИЛА ПОСЧИТАТЬ
Dialogue: 0,0:07:55.70,0:07:57.70,Caption,,0,0,0,,РОССИЙСКИЕ РАКЕТЫ. ПО ЕЁ ДАННЫМ,
Dialogue: 0,0:07:58.02,0:08:00.82,Caption,,0,0,0,,НА ОКТЯБРЬ У РОССИИ БЫЛО ДО СЕМИСОТ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:08:00.82,0:08:04.02,Caption,,0,0,0,,РАКЕТ И НЕСКОЛЬКО ТЫСЯЧ КРЫЛАТЫХ. ПРОИЗВОДСТВЕННЫЕ
Dialogue: 0,0:08:04.02,0:08:08.50,Caption,,0,0,0,,МОЩНОСТИ, ПО ОЦЕНКЕ ГУР, ПОЗВОЛЯЮТ ВЫПУСКАТЬ БОЛЬШЕ ДВУХСОТ КРЫЛАТЫХ И
Dialogue: 0,0:08:08.50,0:08:11.30,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИХ РАКЕТ В МЕСЯЦ. ИЗ НИХ ДО СТА
Dialogue: 0,0:08:11.30,0:08:13.94,Caption,,0,0,0,,ДЕСЯТИ БАЛЛИСТИЧЕСКИХ. ВОТ ЭТО УЖЕ НЕ ЦИФРА ИЗ
Dialogue: 0,0:08:13.94,0:08:17.30,Caption,,0,0,0,,СЕРИИ "МНОГО". ЭТО КОНВЕЙЕР. БОЛЬШЕ ДВУХСОТ РАКЕТ В
Dialogue: 0,0:08:17.30,0:08:19.78,Caption,,0,0,0,,МЕСЯЦ ЭТО ПРИМЕРНО ШЕСТЬ ИЛИ СЕМЬ НОВЫХ РАКЕТ
Dialogue: 0,0:08:19.78,0:08:22.26,Caption,,0,0,0,,В ДЕНЬ. ПОКА ЧЕЛОВЕК ПРОСНУЛСЯ,
Dialogue: 0,0:08:22.34,0:08:25.38,Caption,,0,0,0,,ВЫПИЛ КОФЕ, СЪЕЗДИЛ НА РАБОТУ И ВЕРНУЛСЯ ДОМОЙ,
Dialogue: 0,0:08:25.77,0:08:28.18,Caption,,0,0,0,,РОССИЙСКИЙ ВПК ПО ЭТОЙ ОЦЕНКЕ ДОБАВИЛ В ОБЩИЙ
Dialogue: 0,0:08:28.26,0:08:30.98,Caption,,0,0,0,,СЧЁТ ЕЩЁ НЕСКОЛЬКО ЕДИНИЦ. И ТУТ ВОЗНИКАЕТ
Dialogue: 0,0:08:30.98,0:08:34.26,Caption,,0,0,0,,НЕПРИЯТНЫЙ ДЛЯ КИЕВА ВОПРОС. ЧУЖИЕ РАКЕТЫ СЧИТАТЬ
Dialogue: 0,0:08:34.26,0:08:37.22,Caption,,0,0,0,,НАУЧИЛИСЬ ОТЛИЧНО. А СВОИ ВОЗМОЖНОСТИ КТО СЧИТАТЬ
Dialogue: 0,0:08:37.30,0:08:40.26,Caption,,0,0,0,,БУДЕТ? ПОТОМУ ЧТО ПРОТИВ ЭТИХ РАКЕТ НУЖНЫ СРЕДСТВА
Dialogue: 0,0:08:40.26,0:08:43.62,Caption,,0,0,0,,ОБНАРУЖЕНИЯ, ПЕРЕХВАТА, САМИ РАКЕТЫ ПВО,
Dialogue: 0,0:08:43.79,0:08:46.58,Caption,,0,0,0,,РАСЧЁТЫ, КОМПЛЕКСЫ И ЗАПАСНЫЕ ПОЗИЦИИ.
Dialogue: 0,0:08:48.86,0:08:51.02,Caption,,0,0,0,,И ЖЕЛАТЕЛЬНО НЕ В ДВЕ ТЫСЯЧИ ТРИДЦАТОМ ГОДУ,
Dialogue: 0,0:08:51.26,0:08:54.30,Caption,,0,0,0,,КОГДА КРАСИВЫЙ КОНТРАКТ НАКОНЕЦ ДОЕДЕТ ДО СКЛАДА. А
Dialogue: 0,0:08:54.38,0:08:56.86,Caption,,0,0,0,,СЕЙЧАС. ТОРГОВАЯ МОДЕЛЬ, КОНЕЧНО,
Dialogue: 0,0:08:56.95,0:08:59.42,Caption,,0,0,0,,ЧУДЕСНАЯ. ДЕНЬГИ МОЖНО ВЗЯТЬ СЕГОДНЯ,
Dialogue: 0,0:08:59.58,0:09:02.38,Caption,,0,0,0,,А ТОВАР ПРИВЕЗТИ ПОТОМ. АМЕРИКАНСКИЙ ГЕШЕФТ
Dialogue: 0,0:09:02.38,0:09:04.94,Caption,,0,0,0,,ПРЕКРАСЕН СВОЕЙ ПРОСТОТОЙ. ТОЛЬКО РАКЕТА,
Dialogue: 0,0:09:05.11,0:09:08.62,Caption,,0,0,0,,КОТОРАЯ ЛЕТИТ СЕГОДНЯ, ПОЧЕМУ ТО НЕ ХОЧЕТ ПОДОЖДАТЬ НЕСКОЛЬКО ЛЕТ,
Dialogue: 0,0:09:08.86,0:09:11.82,Caption,,0,0,0,,ПОКА ЗАКОНЧИТСЯ ОЧЕРЕДЬ У ПРОИЗВОДИТЕЛЯ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:09:11.82,0:09:14.46,Caption,,0,0,0,,ЗАНЯТНАЯ КАРТИНА. НАВЕРХУ СТРОЯТ ОРБИТАЛЬНЫЕ
Dialogue: 0,0:09:14.46,0:09:17.90,Caption,,0,0,0,,СИСТЕМЫ. В ЕВРОПЕ ДУМАЮТ О ГЛОБАЛЬНОЙ ДАЛЬНОСТИ. НА
Dialogue: 0,0:09:17.98,0:09:20.78,Caption,,0,0,0,,ЗЕМЛЕ РОССИЯ ДЕРЖИТ БОЛЬШОЙ ЗАПАС РАКЕТ И ПРОДОЛЖАЕТ
Dialogue: 0,0:09:20.78,0:09:23.50,Caption,,0,0,0,,ПРОИЗВОДСТВО. А УКРАИНА ДОЛЖНА СЧИТАТЬ НЕ ТОЛЬКО
Dialogue: 0,0:09:23.50,0:09:26.14,Caption,,0,0,0,,СКОЛЬКО ЛЕТИТ, НО И СКОЛЬКО ОСТАЛОСЬ ТОГО,
Dialogue: 0,0:09:26.23,0:09:30.14,Caption,,0,0,0,,ЧЕМ ЭТО СБИВАТЬ. НО ВОЙНА МЕНЯЕТСЯ НЕ ТОЛЬКО ДОРОГИМИ РАКЕТАМИ И
Dialogue: 0,0:09:30.14,0:09:33.10,Caption,,0,0,0,,КОСМОСОМ. ИНОГДА НОВАЯ ИДЕЯ СТОИТ КУДА ДЕШЕВЛЕ И
Dialogue: 0,0:09:33.10,0:09:35.66,Caption,,0,0,0,,ВЫГЛЯДИТ ТАК, ЧТО СНАЧАЛА ДАЖЕ НЕ ПОНИМАЕШЬ,
Dialogue: 0,0:09:35.90,0:09:40.22,Caption,,0,0,0,,ЧТО ПЕРЕД ТОБОЙ ОРУЖИЕ. РОССИЙСКИЕ F P V ДРОНЫ "ЖДУНЫ" НАЧАЛИ СИДЕТЬ
Dialogue: 0,0:09:40.30,0:09:43.18,Caption,,0,0,0,,НА ВЫСОКОВОЛЬТНЫХ ПРОВОДАХ. ИМЕННО СИДЕТЬ. КАК
Dialogue: 0,0:09:43.26,0:09:48.38,Caption,,0,0,0,,ВОРОБЬИ. ПОДЛЕТЕЛ, ЗАЦЕПИЛСЯ, ВЫКЛЮЧИЛ МОТОР И ЖДЁТ. И В ЭТОМ ВЕСЬ
Dialogue: 0,0:09:48.38,0:09:51.50,Caption,,0,0,0,,СМЫСЛ. ОБЫЧНЫЙ FPV ВО ВРЕМЯ ПОИСКА ЦЕЛИ ЖРЁТ
Dialogue: 0,0:09:51.58,0:09:54.14,Caption,,0,0,0,,БАТАРЕЮ. ВРЕМЯ ИДЁТ, ЗАРЯД ПАДАЕТ,
Dialogue: 0,0:09:54.38,0:09:57.26,Caption,,0,0,0,,ОПЕРАТОРУ ПРИХОДИТСЯ БЫСТРО ИСКАТЬ ЦЕЛЬ. А ЗДЕСЬ
Dialogue: 0,0:09:57.26,0:09:59.58,Caption,,0,0,0,,ДРОН ВИСИТ НА ПРОВОДЕ И НЕ ТРАТИТ ЭНЕРГИЮ
Dialogue: 0,0:09:59.58,0:10:03.34,Caption,,0,0,0,,НА ТО, ЧТОБЫ ДЕРЖАТЬСЯ В ВОЗДУХЕ. КАМЕРА СМОТРИТ. ОПЕРАТОР
Dialogue: 0,0:10:03.42,0:10:07.47,Caption,,0,0,0,,ЖДЁТ. ПОЯВИЛАСЬ ПОДХОДЯЩАЯ ЦЕЛЬ,
Dialogue: 0,0:10:07.63,0:10:10.59,Caption,,0,0,0,,АППАРАТ ОТЦЕПИЛСЯ И ПОЛЕТЕЛ. ПРОСТЕЙШАЯ ИДЕЯ.
Dialogue: 0,0:10:10.84,0:10:14.59,Caption,,0,0,0,,КРЮЧОК, ПРОВОД И ТЕРПЕНИЕ. ПРИЧЁМ УКРАИНСКИЙ СПЕЦИАЛИСТ
Dialogue: 0,0:10:14.59,0:10:16.83,Caption,,0,0,0,,СЕРГЕЙ БЕСКРЕСТНОВ, ИЗВЕСТНЫЙ КАК ФЛЕШ,
Dialogue: 0,0:10:17.07,0:10:20.11,Caption,,0,0,0,,ПИСАЛ, ЧТО РОССИЙСКИЕ ВОЕННЫЕ ПЕРЕНЯЛИ ТАКТИКУ,
Dialogue: 0,0:10:20.34,0:10:22.91,Caption,,0,0,0,,КОТОРУЮ РАНЬШЕ ПРИМЕНЯЛИ УКРАИНСКИЕ ПОДРАЗДЕЛЕНИЯ.
Dialogue: 0,0:10:23.15,0:10:26.19,Caption,,0,0,0,,ВОТ ВАМ И ВСЯ СОВРЕМЕННАЯ ВОЕННАЯ ИННОВАЦИЯ. НЕ
Dialogue: 0,0:10:26.19,0:10:29.07,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО ИЗОБРЕТАТЬ ЛАЗЕР ИЗ БУДУЩЕГО. ИНОГДА
Dialogue: 0,0:10:29.07,0:10:31.79,Caption,,0,0,0,,ДОСТАТОЧНО ПОСМОТРЕТЬ, ЧТО СДЕЛАЛ ПРОТИВНИК,
Dialogue: 0,0:10:31.95,0:10:34.59,Caption,,0,0,0,,СКАЗАТЬ "А ТАК МОЖНО БЫЛО?" И СДЕЛАТЬ ТО
Dialogue: 0,0:10:34.67,0:10:37.55,Caption,,0,0,0,,ЖЕ САМОЕ. ЭТО ОДИН ИЗ САМЫХ НЕПРИЯТНЫХ ЗАКОНОВ
Dialogue: 0,0:10:37.55,0:10:40.43,Caption,,0,0,0,,ЗАТЯЖНОГО КОНФЛИКТА. ЛЮБОЕ ПРЕИМУЩЕСТВО ЖИВЁТ
Dialogue: 0,0:10:40.51,0:10:42.67,Caption,,0,0,0,,НЕДОЛГО. НАШЁЛ ХОРОШУЮ ТАКТИКУ,
Dialogue: 0,0:10:42.76,0:10:45.55,Caption,,0,0,0,,РАДУЙСЯ БЫСТРО. ПРОТИВНИК УЖЕ СМОТРИТ ВИДЕО,
Dialogue: 0,0:10:45.79,0:10:50.27,Caption,,0,0,0,,РАЗБИРАЕТ ДЕТАЛИ И ДУМАЕТ, КАК ПОВТОРИТЬ ИЛИ ОБОЙТИ. ПОЭТОМУ РАССКАЗЫ ОБ
Dialogue: 0,0:10:50.27,0:10:52.83,Caption,,0,0,0,,ОКОНЧАТЕЛЬНОМ ТЕХНОЛОГИЧЕСКОМ ПРЕИМУЩЕСТВЕ ОБЫЧНО
Dialogue: 0,0:10:52.91,0:10:54.99,Caption,,0,0,0,,ЖИВУТ ДО СЛЕДУЮЩЕЙ СМЕНЫ ПРОШИВКИ,
Dialogue: 0,0:10:55.23,0:10:58.99,Caption,,0,0,0,,ЧАСТОТЫ, МАРШРУТА ИЛИ КАКОГО НИБУДЬ ПЛАСТИКОВОГО КРЮЧКА НА
Dialogue: 0,0:10:58.99,0:11:02.59,Caption,,0,0,0,,ПРОВОДЕ. А ТЕПЕРЬ К ВЕЩИ КУДА МЕНЕЕ ЭКЗОТИЧЕСКОЙ. К
Dialogue: 0,0:11:02.59,0:11:05.07,Caption,,0,0,0,,ПОРТАМ. ТУТ НИКАКИХ СПУТНИКОВ,
Dialogue: 0,0:11:05.31,0:11:07.63,Caption,,0,0,0,,ОРБИТ И МАРСИАН. ПРОСТО ДЕНЬГИ,
Dialogue: 0,0:11:07.71,0:11:12.91,Caption,,0,0,0,,ЗЕРНО, ПРИЧАЛЫ И ЛЮДИ, КОТОРЫМ НАДО ПЛАТИТЬ ЗАРПЛАТУ. ГУБЕРНАТОР РОСТОВСКОЙ
Dialogue: 0,0:11:12.91,0:11:16.83,Caption,,0,0,0,,ОБЛАСТИ ЮРИЙ СЛЮСАРЬ СООБЩИЛ, ЧТО РАБОТА ТРЁХ ПОРТОВ РЕГИОНА,
Dialogue: 0,0:11:17.00,0:11:19.47,Caption,,0,0,0,,РОСТОВА НА ДОНУ, АЗОВА И ТАГАНРОГА,
Dialogue: 0,0:11:19.63,0:11:22.43,Caption,,0,0,0,,ФАКТИЧЕСКИ ПРИОСТАНОВЛЕНА ПОСЛЕ АТАК БЕСПИЛОТНИКОВ.
Dialogue: 0,0:11:24.71,0:11:26.55,Caption,,0,0,0,,ПОВРЕЖДАЛИСЬ ПРИЧАЛЬНЫЕ СТЕНКИ,
Dialogue: 0,0:11:26.63,0:11:29.75,Caption,,0,0,0,,РЕЗЕРВУАРЫ И ПЕРЕВАЛОЧНОЕ ОБОРУДОВАНИЕ. ОБЪЁМ
Dialogue: 0,0:11:29.75,0:11:32.55,Caption,,0,0,0,,ПЕРЕВАЛКИ РЕЗКО УПАЛ. ТОЛЬКО ЗА ОДИН МЕСЯЦ,
Dialogue: 0,0:11:32.67,0:11:36.63,Caption,,0,0,0,,ПО ЕГО ДАННЫМ, СТИВИДОРНЫЕ И СУДОХОДНЫЕ КОМПАНИИ НЕДОПОЛУЧИЛИ ПЯТЬ
Dialogue: 0,0:11:36.63,0:11:39.75,Caption,,0,0,0,,ЦЕЛЫХ ТРИ ДЕСЯТЫХ МИЛЛИАРДА РУБЛЕЙ. В ПОРТАХ И
Dialogue: 0,0:11:39.75,0:11:42.39,Caption,,0,0,0,,СВЯЗАННЫХ С НИМИ ПРЕДПРИЯТИЯХ РАБОТАЮТ БОЛЬШЕ СЕМИ
Dialogue: 0,0:11:42.39,0:11:44.63,Caption,,0,0,0,,ТЫСЯЧ ЧЕЛОВЕК. ЛЮДЕЙ ПОКА ДЕРЖАТ,
Dialogue: 0,0:11:44.78,0:11:47.11,Caption,,0,0,0,,ПОТОМУ ЧТО СПЕЦИАЛИСТА МОЖНО УВОЛИТЬ ЗА ОДИН ДЕНЬ,
Dialogue: 0,0:11:47.43,0:11:49.43,Caption,,0,0,0,,А ПОТОМ ПОПРОБУЙ СОБЕРИ ОБРАТНО КОЛЛЕКТИВ,
Dialogue: 0,0:11:49.58,0:11:52.39,Caption,,0,0,0,,КОГДА СУДОХОДСТВО ВОССТАНОВИТСЯ. КРЕДИТЫ ПРИ ЭТОМ
Dialogue: 0,0:11:52.39,0:11:55.67,Caption,,0,0,0,,НИКУДА НЕ ДЕЛИСЬ. НАЛОГИ ТОЖЕ. АРЕНДА ПРИЧАЛОВ ТОЖЕ.
Dialogue: 0,0:11:55.96,0:11:59.11,Caption,,0,0,0,,ОЧЕНЬ УДОБНО. ПОРТ СТОИТ, ДЕНЬГИ НЕ ЗАРАБАТЫВАЕТ,
Dialogue: 0,0:11:59.36,0:12:01.75,Caption,,0,0,0,,А СЧЕТА ПРОДОЛЖАЮТ ХОДИТЬ НА РАБОТУ БЕЗ ВЫХОДНЫХ.
Dialogue: 0,0:12:02.10,0:12:05.27,Caption,,0,0,0,,СЛЕДОМ ПРИЛЕТАЕТ ПО АГРАРИЯМ. ЕСЛИ ПОРТ НЕ ГРУЗИТ,
Dialogue: 0,0:12:05.38,0:12:08.39,Caption,,0,0,0,,ЗЕРНО ОСТАЁТСЯ НА СКЛАДАХ. ЕСЛИ ЗЕРНО СТОИТ,
Dialogue: 0,0:12:08.52,0:12:11.43,Caption,,0,0,0,,ДЕНЬГИ НЕ ВОЗВРАЩАЮТСЯ В ХОЗЯЙСТВА. ЕСЛИ ДЕНЬГИ НЕ
Dialogue: 0,0:12:11.43,0:12:14.15,Caption,,0,0,0,,ВОЗВРАЩАЮТСЯ, ДАЛЬШЕ НАЧИНАЮТСЯ КРЕДИТЫ,
Dialogue: 0,0:12:14.31,0:12:17.51,Caption,,0,0,0,,ПОСЕВНАЯ, ТЕХНИКА, ТОПЛИВО И ВСЯ ЦЕПОЧКА,
Dialogue: 0,0:12:17.75,0:12:20.07,Caption,,0,0,0,,КОТОРУЮ УЖЕ НЕ ПОЧИНИШЬ ОДНИМ НОВЫМ КРАНОМ НА
Dialogue: 0,0:12:20.15,0:12:23.43,Caption,,0,0,0,,ПРИЧАЛЕ. РЕГИОН ПРОСИТ ФЕДЕРАЛЬНЫЙ ЦЕНТР О НАЛОГОВЫХ
Dialogue: 0,0:12:23.43,0:12:27.19,Caption,,0,0,0,,ОТСРОЧКАХ, КРЕДИТНЫХ КАНИКУЛАХ И ЛЬГОТНЫХ ЗАЙМАХ. И ЗДЕСЬ
Dialogue: 0,0:12:27.19,0:12:30.15,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ СОВСЕМ НЕУДОБНЫЙ ВОПРОС. А ВЛАДЕЛЬЦЫ
Dialogue: 0,0:12:30.15,0:12:32.63,Caption,,0,0,0,,КРИТИЧЕСКОЙ ИНФРАСТРУКТУРЫ ОБЯЗАНЫ ЗАНИМАТЬСЯ
Dialogue: 0,0:12:32.63,0:12:35.35,Caption,,0,0,0,,ПРОТИВОДРОНОВОЙ ЗАЩИТОЙ СВОИХ ОБЪЕКТОВ. ТО ЕСТЬ
Dialogue: 0,0:12:35.35,0:12:38.71,Caption,,0,0,0,,КОГДА ВСЁ ХОРОШО, ОБЪЕКТ ЧАСТНЫЙ И ПРИБЫЛЬ ЧАСТНАЯ.
Dialogue: 0,0:12:40.99,0:12:43.95,Caption,,0,0,0,,КОГДА ОБЪЕКТ РАЗБИЛИ, ВНЕЗАПНО ОЧЕНЬ ХОЧЕТСЯ,
Dialogue: 0,0:12:44.12,0:12:47.55,Caption,,0,0,0,,ЧТОБЫ СПАСАЛО ГОСУДАРСТВО. НИЧЕГО НЕОБЫЧНОГО. СТАРЫЙ
Dialogue: 0,0:12:47.55,0:12:50.67,Caption,,0,0,0,,ДОБРЫЙ КАПИТАЛИЗМ С НАЦИОНАЛЬНЫМИ ОСОБЕННОСТЯМИ. НО
Dialogue: 0,0:12:50.67,0:12:53.39,Caption,,0,0,0,,ПРОБЛЕМА ОТ ЭТОГО НИКУДА НЕ ДЕВАЕТСЯ. ПОРТЫ ЮГА
Dialogue: 0,0:12:53.39,0:12:55.55,Caption,,0,0,0,,РОССИИ ЭТО НЕ ТРИ ОТДЕЛЬНЫХ ПРИЧАЛА,
Dialogue: 0,0:12:55.79,0:12:58.91,Caption,,0,0,0,,КОТОРЫЕ МОЖНО ЗАКРЫТЬ И ЗАБЫТЬ. ЭТО ЧАСТЬ ЭКСПОРТНОЙ
Dialogue: 0,0:12:58.99,0:13:01.47,Caption,,0,0,0,,И ЗЕРНОВОЙ ЛОГИСТИКИ. УДАР ПО ТЕРМИНАЛУ
Dialogue: 0,0:13:01.55,0:13:04.59,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ НЕ У ВОРОТ ТЕРМИНАЛА. ОН ПОЛЗЁТ ДАЛЬШЕ
Dialogue: 0,0:13:04.67,0:13:08.03,Caption,,0,0,0,,ПО ЦЕПОЧКЕ. К СУДОХОДНОЙ КОМПАНИИ. К ЭЛЕВАТОРУ. К
Dialogue: 0,0:13:08.03,0:13:11.31,Caption,,0,0,0,,ФЕРМЕРУ. К БАНКУ. К БЮДЖЕТУ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:13:11.31,0:13:14.27,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ НОВАЯ НЕПРИЯТНОСТЬ. ТЕХНИКА МЕНЯЕТСЯ
Dialogue: 0,0:13:14.27,0:13:17.39,Caption,,0,0,0,,БЫСТРЕЕ, ЧЕМ ЛЮДИ УСПЕВАЮТ ДОГОВОРИТЬСЯ О ПРАВИЛАХ ЕЁ
Dialogue: 0,0:13:17.39,0:13:19.95,Caption,,0,0,0,,ПРИМЕНЕНИЯ. ВЧЕРА АППАРАТ БЫЛ КОММЕРЧЕСКИМ
Dialogue: 0,0:13:19.95,0:13:23.55,Caption,,0,0,0,,СПУТНИКОМ. СЕГОДНЯ ЕГО ДАННЫЕ НУЖНЫ ВОЕННЫМ. ЗАВТРА
Dialogue: 0,0:13:23.55,0:13:25.31,Caption,,0,0,0,,РЯДОМ ПОЯВЛЯЕТСЯ ЧУЖОЙ АППАРАТ,
Dialogue: 0,0:13:25.54,0:13:28.19,Caption,,0,0,0,,КОТОРЫЙ СПОСОБЕН ПОДОБРАТЬСЯ ПОЧТИ ВПЛОТНУЮ. И
Dialogue: 0,0:13:28.19,0:13:32.43,Caption,,0,0,0,,ПОПРОБУЙ ТЕПЕРЬ ОБЪЯСНИ, ГДЕ ЗАКАНЧИВАЕТСЯ ОБЫЧНАЯ КОСМИЧЕСКАЯ ДЕЯТЕЛЬНОСТЬ И
Dialogue: 0,0:13:32.43,0:13:35.63,Caption,,0,0,0,,НАЧИНАЕТСЯ ВОЕННОЕ ПРОТИВОСТОЯНИЕ. С КАЖДОЙ НОВОЙ
Dialogue: 0,0:13:35.63,0:13:37.95,Caption,,0,0,0,,ТЕХНОЛОГИЕЙ ЭТА ГРАНИЦА СТАНОВИТСЯ ВСЁ МЕНЕЕ
Dialogue: 0,0:13:37.95,0:13:42.99,Caption,,0,0,0,,УДОБНОЙ. СНАЧАЛА ПРИДУМЫВАЮТ, КАК ПОЛУЧИТЬ ПРЕИМУЩЕСТВО. ПОТОМ ПРОТИВНИК НАХОДИТ
Dialogue: 0,0:13:43.07,0:13:45.71,Caption,,0,0,0,,ОТВЕТ. А УЖЕ ПОСЛЕ ЭТОГО ПОЛИТИКИ И ГЕНЕРАЛЫ
Dialogue: 0,0:13:45.71,0:13:49.47,Caption,,0,0,0,,НАЧИНАЮТ РАЗБИРАТЬСЯ, КАК ТЕПЕРЬ ВООБЩЕ СО ВСЕМ ЭТИМ ЖИТЬ. ПРИЧЁМ
Dialogue: 0,0:13:49.47,0:13:51.63,Caption,,0,0,0,,К ТОМУ МОМЕНТУ КТО НИБУДЬ ОБЯЗАТЕЛЬНО УСПЕЕТ
Dialogue: 0,0:13:51.63,0:13:57.36,Caption,,0,0,0,,ПРИДУМАТЬ ЕЩЁ ОДНУ ШТУКУ. ТАК ЧТО МАРСИАНАМ Я ВСЁ ТАКИ СОВЕТОВАЛ БЫ
Dialogue: 0,0:13:57.36,0:14:00.24,Caption,,0,0,0,,НЕ ВЫСОВЫВАТЬСЯ. ЗЕМЛЯНЕ ВОШЛИ В КУРАЖ ВСЕРЬЁЗ.
