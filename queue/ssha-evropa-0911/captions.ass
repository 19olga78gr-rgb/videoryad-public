Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,НУ ЧТО, ВЫБОРЫ В АМЕРИКЕ ЗАКОНЧИЛИСЬ. ТЕПЕРЬ,
Dialogue: 0,0:00:03.14,0:00:07.24,Caption,,0,0,0,,ПО ИДЕЕ, МОЖНО БЫЛО БЫ НЕМНОГО УСПОКОИТЬСЯ. НО В ВАШИНГТОНЕ,
Dialogue: 0,0:00:07.39,0:00:10.36,Caption,,0,0,0,,ПОХОЖЕ, СЛОВО "УСПОКОИТЬСЯ" ОПЯТЬ ПОТЕРЯЛИ ВМЕСТЕ С
Dialogue: 0,0:00:10.36,0:00:12.44,Caption,,0,0,0,,ИНСТРУКЦИЕЙ. ТАМ УЖЕ ВЫЯСНЯЮТ,
Dialogue: 0,0:00:12.60,0:00:15.88,Caption,,0,0,0,,КОГО СНИМАТЬ, КОГО РАССЛЕДОВАТЬ И КОМУ ТЕПЕРЬ РАЗРЕШЕНО
Dialogue: 0,0:00:15.88,0:00:18.92,Caption,,0,0,0,,КОМАНДОВАТЬ ПАРАДОМ. ЕВРОПА СМОТРИТ НА ВСЁ ЭТО СО
Dialogue: 0,0:00:19.00,0:00:21.64,Caption,,0,0,0,,СВОЕЙ СТОРОНЫ И ТОЖЕ ЯВНО НЕ СКУЧАЕТ. А
Dialogue: 0,0:00:21.72,0:00:25.40,Caption,,0,0,0,,РЯДОМ ЕЩЁ ЕСТЬ ЛЮДИ, КОТОРЫМ АМЕРИКАНСКИЕ ВЫБОРЫ ВООБЩЕ НЕ МЕШАЮТ
Dialogue: 0,0:00:25.40,0:00:28.44,Caption,,0,0,0,,ЗАНИМАТЬСЯ СВОИМИ ДЕЛАМИ. ВОТ И ХОЧЕТСЯ ПОНЯТЬ,
Dialogue: 0,0:00:28.60,0:00:30.76,Caption,,0,0,0,,ЧТО ЗАПАД ПРЕДСТАВЛЯЕТ СОБОЙ СЕГОДНЯ,
Dialogue: 0,0:00:31.00,0:00:33.00,Caption,,0,0,0,,КОГДА КАЖДЫЙ ЗАНЯТ ЧЕМ ТО СВОИМ.
Dialogue: 0,0:00:33.70,0:00:35.40,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗБОР,
Dialogue: 0,0:00:35.48,0:00:37.64,Caption,,0,0,0,,ГДЕ НОВОСТИ НЕ ПРОСТО СКЛАДЫВАЮТ В СТОПКУ,
Dialogue: 0,0:00:37.88,0:00:40.20,Caption,,0,0,0,,А СМОТРЯТ, ЧТО ИЗ НИХ ПОЛУЧАЕТСЯ ВМЕСТЕ,
Dialogue: 0,0:00:40.50,0:00:43.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:43.41,0:00:46.20,Caption,,0,0,0,,КОГДА ОДНОЙ ГАЗЕТНОЙ ЗАМЕТКОЙ НИЧЕГО НЕ ПОНЯТЬ.
Dialogue: 0,0:00:46.43,0:00:49.16,Caption,,0,0,0,,НАЧНЁМ С АМЕРИКИ. БЕЛЫЙ ДОМ УЖЕ УСПОКАИВАЕТ СВОИХ
Dialogue: 0,0:00:49.24,0:00:52.12,Caption,,0,0,0,,СТОРОННИКОВ ДЕМОКРАТЫ ЗА ОСТАВШИЕСЯ ДВА ГОДА ТРАМПА
Dialogue: 0,0:00:52.36,0:00:54.28,Caption,,0,0,0,,НЕ СМОГУТ ПРОСТО ВЗЯТЬ И ОТМЕНИТЬ ВСЁ,
Dialogue: 0,0:00:54.37,0:00:57.48,Caption,,0,0,0,,ЧТО ОН СДЕЛАЛ. ЗВУЧИТ БОДРО. ТОЛЬКО САМ ФАКТ,
Dialogue: 0,0:00:57.72,0:01:00.12,Caption,,0,0,0,,ЧТО ЭТО ПРИХОДИТСЯ ОТДЕЛЬНО ОБЪЯСНЯТЬ СРАЗУ ПОСЛЕ
Dialogue: 0,0:01:00.20,0:01:04.04,Caption,,0,0,0,,ВЫБОРОВ, УЖЕ МНОГОЕ ГОВОРИТ О НАСТРОЕНИИ В ВАШИНГТОНЕ. ТРАМП
Dialogue: 0,0:01:04.07,0:01:07.16,Caption,,0,0,0,,ОСТАЛСЯ ПРЕЗИДЕНТОМ. КАБИНЕТ ОСТАЛСЯ ЕГО.
Dialogue: 0,0:01:07.39,0:01:10.36,Caption,,0,0,0,,ИСПОЛНИТЕЛЬНАЯ ВЛАСТЬ НИКУДА НЕ ИСПАРИЛАСЬ. НО
Dialogue: 0,0:01:10.36,0:01:15.59,Caption,,0,0,0,,ПРЕЖНЕГО УДОБСТВА УЖЕ НЕТ. ТЕПЕРЬ НАПРОТИВ СИДЯТ ЛЮДИ,
Dialogue: 0,0:01:15.91,0:01:18.95,Caption,,0,0,0,,КОТОРЫЕ ПОЛУЧИЛИ НОВЫЕ РЫЧАГИ И ЯВНО СОБИРАЮТСЯ ИМИ
Dialogue: 0,0:01:18.95,0:01:22.39,Caption,,0,0,0,,ПОЛЬЗОВАТЬСЯ. И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ НЕ ТРАГЕДИЯ ВЕКА,
Dialogue: 0,0:01:22.72,0:01:25.75,Caption,,0,0,0,,А ОБЫЧНОЕ АМЕРИКАНСКОЕ БОДАНИЕ. ПРОСТО НА ЭТОТ РАЗ
Dialogue: 0,0:01:25.83,0:01:28.31,Caption,,0,0,0,,ОНО БУДЕТ ИДТИ ПРЯМО ВНУТРИ ПОСЛЕДНИХ ДВУХ ЛЕТ
Dialogue: 0,0:01:28.31,0:01:31.51,Caption,,0,0,0,,ТРАМПОВСКОГО СРОКА. ПЕРВЫМ ПОД РАЗДАЧУ МОЖЕТ ПОПАСТЬ
Dialogue: 0,0:01:31.59,0:01:34.31,Caption,,0,0,0,,ПИТ ХЕГСЕТ. В КОНГРЕССЕ УЖЕ ГОВОРЯТ О ПРОЦЕДУРЕ
Dialogue: 0,0:01:34.39,0:01:37.03,Caption,,0,0,0,,ИМПИЧМЕНТА ГЛАВЫ ПЕНТАГОНА. ОДНОВРЕМЕННО ИДУТ
Dialogue: 0,0:01:37.11,0:01:40.55,Caption,,0,0,0,,РАЗГОВОРЫ, ЧТО ЕГО ВООБЩЕ ХОТЯТ УБРАТЬ С ДОЛЖНОСТИ. ПРИЧЁМ
Dialogue: 0,0:01:40.63,0:01:42.55,Caption,,0,0,0,,ИСТОРИЯ НЕПРИЯТНАЯ ИМЕННО ПОТОМУ,
Dialogue: 0,0:01:42.78,0:01:44.87,Caption,,0,0,0,,ЧТО ЭТО УЖЕ НЕ ВЫГЛЯДИТ КАК ПРОСТОЙ НОМЕР
Dialogue: 0,0:01:44.87,0:01:47.35,Caption,,0,0,0,,ИЗ ПРОГРАММЫ "ДЕМОКРАТЫ ОПЯТЬ НЕНАВИДЯТ ТРАМПА".
Dialogue: 0,0:01:47.68,0:01:50.23,Caption,,0,0,0,,ВОПРОС К ХЕГСЕТУ ЗВУЧИТ И ВНУТРИ РЕСПУБЛИКАНСКОГО
Dialogue: 0,0:01:50.23,0:01:53.43,Caption,,0,0,0,,ЛАГЕРЯ. ВОТ ВАМ И ПЕРВАЯ ПРОВЕРКА НОВОЙ КОНСТРУКЦИИ.
Dialogue: 0,0:01:53.75,0:01:58.07,Caption,,0,0,0,,НЕ АБСТРАКТНЫЙ СПОР О ТОМ, У КОГО СКОЛЬКО КРЕСЕЛ. КОНКРЕТНЫЙ МИНИСТР.
Dialogue: 0,0:01:58.32,0:02:01.35,Caption,,0,0,0,,КОНКРЕТНАЯ ДОЛЖНОСТЬ. КОНКРЕТНЫЙ КОНФЛИКТ. ЕЩЁ
Dialogue: 0,0:02:01.35,0:02:03.67,Caption,,0,0,0,,НЕДАВНО МОЖНО БЫЛО МАХНУТЬ РУКОЙ И СКАЗАТЬ НУ
Dialogue: 0,0:02:03.67,0:02:06.47,Caption,,0,0,0,,ПОКРИЧАТ И РАЗОЙДУТСЯ. ТЕПЕРЬ РАЗОЙТИСЬ БУДЕТ
Dialogue: 0,0:02:06.55,0:02:08.95,Caption,,0,0,0,,СЛОЖНЕЕ. САМ ХЕГСЕТ, СУДЯ ПО ВСЕМУ,
Dialogue: 0,0:02:09.20,0:02:11.75,Caption,,0,0,0,,УХОДИТЬ ТИХО НЕ СОБИРАЕТСЯ. А ТРАМПУ В ТАКОЙ
Dialogue: 0,0:02:11.75,0:02:14.15,Caption,,0,0,0,,СИТУАЦИИ ТОЖЕ НЕ ОЧЕНЬ УДОБНО ПРОСТО ВЗЯТЬ И
Dialogue: 0,0:02:14.15,0:02:16.79,Caption,,0,0,0,,СДАТЬ СВОЕГО МИНИСТРА. ПОТОМУ ЧТО ТОГДА ПОЛУЧИТСЯ
Dialogue: 0,0:02:16.79,0:02:19.35,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ КАРТИНА. ВЫБОРЫ ПРОИГРАЛИ,
Dialogue: 0,0:02:19.59,0:02:23.75,Caption,,0,0,0,,ДАВЛЕНИЕ НАЧАЛОСЬ, ПЕРВЫЙ КРУПНЫЙ ЧЕЛОВЕК ИЗ КОМАНДЫ ВЫЛЕТЕЛ. ДЛЯ
Dialogue: 0,0:02:23.75,0:02:25.67,Caption,,0,0,0,,ПОЛИТИЧЕСКИХ ПРОТИВНИКОВ ПОДАРОК.
Dialogue: 0,0:02:27.95,0:02:30.51,Caption,,0,0,0,,ДЛЯ СВОИХ ТОЖЕ СИГНАЛ НЕ САМЫЙ ПРИЯТНЫЙ. И
Dialogue: 0,0:02:30.51,0:02:33.31,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ДЕМОКРАТЫ УЖЕ ГОТОВЯТ НОВЫЙ ПАКЕТ ПОМОЩИ
Dialogue: 0,0:02:33.31,0:02:35.47,Caption,,0,0,0,,УКРАИНЕ НА ПЯТНАДЦАТЬ МИЛЛИАРДОВ ДОЛЛАРОВ.
Dialogue: 0,0:02:36.03,0:02:38.51,Caption,,0,0,0,,ВОТ ЗДЕСЬ АМЕРИКАНСКАЯ ВНУТРЕННЯЯ ДРАКА ПЕРЕСТАЁТ
Dialogue: 0,0:02:38.51,0:02:41.47,Caption,,0,0,0,,БЫТЬ ИСКЛЮЧИТЕЛЬНО АМЕРИКАНСКОЙ. ПОТОМУ ЧТО ДЕНЬГИ,
Dialogue: 0,0:02:41.55,0:02:46.03,Caption,,0,0,0,,ОРУЖИЕ, САНКЦИИ И ВНЕШНЯЯ ПОЛИТИКА СРАЗУ ВЫНОСЯТ ПОСЛЕДСТВИЯ
Dialogue: 0,0:02:46.11,0:02:49.23,Caption,,0,0,0,,ЗА ПРЕДЕЛЫ ВАШИНГТОНА. РАНЬШЕ МОЖНО БЫЛО РАССУЖДАТЬ,
Dialogue: 0,0:02:49.47,0:02:51.71,Caption,,0,0,0,,ЧТО ВЫБОРЫ ТАМ ДАЛЕКО И НАС НЕ КАСАЮТСЯ.
Dialogue: 0,0:02:51.88,0:02:57.15,Caption,,0,0,0,,КАСАЮТСЯ. ПРОСТО НЕ ПОТОМУ, ЧТО ДЕМОКРАТАМ ДОСТАЛОСЬ БОЛЬШЕ КАБИНЕТОВ. А ПОТОМУ,
Dialogue: 0,0:02:57.30,0:02:59.55,Caption,,0,0,0,,ЧТО ТЕПЕРЬ У НИХ ПОЯВИЛОСЬ БОЛЬШЕ ВОЗМОЖНОСТЕЙ
Dialogue: 0,0:02:59.55,0:03:03.55,Caption,,0,0,0,,ДАВИТЬ НА РЕШЕНИЯ, КОТОРЫЕ ПОТОМ ПРИЛЕТАЮТ УЖЕ СОВСЕМ В ДРУГИЕ СТРАНЫ.
Dialogue: 0,0:03:04.11,0:03:06.83,Caption,,0,0,0,,ТРАМП ОТВЕЧАЕТ В СВОЁМ СТИЛЕ. НЕ СТАЛ ДОЛГО
Dialogue: 0,0:03:06.91,0:03:09.31,Caption,,0,0,0,,РАССКАЗЫВАТЬ О ЕДИНСТВЕ НАЦИИ И НОВОЙ СТРАНИЦЕ
Dialogue: 0,0:03:09.31,0:03:12.11,Caption,,0,0,0,,АМЕРИКАНСКОЙ ДЕМОКРАТИИ. ПОТРЕБОВАЛ РАССЛЕДОВАТЬ
Dialogue: 0,0:03:12.11,0:03:14.99,Caption,,0,0,0,,САМИХ ДЕМОКРАТОВ ЗА УГРОЗЫ ИМПИЧМЕНТОМ. ТО ЕСТЬ ОДНА
Dialogue: 0,0:03:14.99,0:03:17.63,Caption,,0,0,0,,СТОРОНА ГОТОВИТ РАССЛЕДОВАНИЯ ДЛЯ КОМАНДЫ ТРАМПА,
Dialogue: 0,0:03:17.95,0:03:19.63,Caption,,0,0,0,,ТРАМП ТРЕБУЕТ РАССЛЕДОВАТЬ ТЕХ,
Dialogue: 0,0:03:19.83,0:03:22.83,Caption,,0,0,0,,КТО ГОТОВИТ РАССЛЕДОВАНИЯ. АМЕРИКА УМЕЕТ ЭКОНОМИТЬ
Dialogue: 0,0:03:22.91,0:03:26.27,Caption,,0,0,0,,ВРЕМЯ. ВСЕ РАССЛЕДУЮТ ВСЕХ СРАЗУ. ЕСЛИ ВАМ НРАВИТСЯ
Dialogue: 0,0:03:26.27,0:03:28.75,Caption,,0,0,0,,ТАКОЙ СПОКОЙНЫЙ БАРДАК БЕЗ ПОПЫТКИ ДЕЛАТЬ ВИД,
Dialogue: 0,0:03:28.91,0:03:33.23,Caption,,0,0,0,,ЧТО ВСЁ ИДЁТ СТРОГО ПО ПЛАНУ, ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ЕВРОПА,
Dialogue: 0,0:03:33.47,0:03:36.35,Caption,,0,0,0,,А ТАМ СВОИ СПЕЦИАЛИСТЫ ПО ПОРЯДКУ. ФРИДРИХ МЕРЦ,
Dialogue: 0,0:03:36.50,0:03:38.67,Caption,,0,0,0,,ПОХОЖЕ, ОСОБЫХ ИЛЛЮЗИЙ НЕ ПИТАЕТ.
Dialogue: 0,0:03:40.93,0:03:43.49,Caption,,0,0,0,,ЕГО МЫСЛЬ ПРОСТАЯ ТРАМП И РАНЬШЕ УПРАВЛЯЛ ТАК,
Dialogue: 0,0:03:43.80,0:03:45.57,Caption,,0,0,0,,ЧТОБЫ КОНГРЕСС НЕ МЕШАЛ ЕМУ ТАМ,
Dialogue: 0,0:03:45.81,0:03:48.37,Caption,,0,0,0,,ГДЕ ПРЕЗИДЕНТ МОЖЕТ ДЕЙСТВОВАТЬ САМ. ЗНАЧИТ,
Dialogue: 0,0:03:48.50,0:03:50.93,Caption,,0,0,0,,ПРОДОЛЖИТ ДЕЛАТЬ ТО ЖЕ САМОЕ. И ВОТ ЭТО
Dialogue: 0,0:03:51.01,0:03:54.93,Caption,,0,0,0,,ДЛЯ ЕВРОПЫ ВАЖНЕЕ, ЧЕМ РАДОСТЬ ПО ПОВОДУ НОВЫХ ВОЗМОЖНОСТЕЙ ДЕМОКРАТОВ.
Dialogue: 0,0:03:55.41,0:03:57.65,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО СЧИТАТЬ МЕСТА В АМЕРИКАНСКОМ
Dialogue: 0,0:03:57.65,0:04:01.17,Caption,,0,0,0,,КОНГРЕССЕ, НО В БЕРЛИНЕ ПОНИМАЮТ ЕЩЁ ДВА ГОДА РАЗГОВАРИВАТЬ
Dialogue: 0,0:04:01.17,0:04:04.37,Caption,,0,0,0,,ПРИДЁТСЯ ИМЕННО С ТРАМПОМ. НЕ С БУДУЩИМ ПРЕЗИДЕНТОМ,
Dialogue: 0,0:04:04.69,0:04:07.01,Caption,,0,0,0,,НЕ С МЕЧТОЙ О ВОЗВРАЩЕНИИ СТАРОЙ АМЕРИКИ,
Dialogue: 0,0:04:07.23,0:04:10.05,Caption,,0,0,0,,А С НЫНЕШНИМ ХОЗЯИНОМ БЕЛОГО ДОМА. ОТСЮДА И
Dialogue: 0,0:04:10.13,0:04:12.93,Caption,,0,0,0,,СТРАННАЯ ЕВРОПЕЙСКАЯ ПОЗА. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:04:13.25,0:04:14.93,Caption,,0,0,0,,ОТ ТРАМПА ЖДУТ ПРЕДСКАЗУЕМОСТИ,
Dialogue: 0,0:04:15.14,0:04:18.53,Caption,,0,0,0,,СОЮЗНИЧЕСКОЙ ДИСЦИПЛИНЫ И УВАЖЕНИЯ К ОБЩЕЙ ЛИНИИ. С
Dialogue: 0,0:04:18.53,0:04:20.69,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ, ОН ДАВНО ПОКАЗЫВАЕТ,
Dialogue: 0,0:04:20.93,0:04:23.33,Caption,,0,0,0,,ЧТО ОБЩАЯ ЛИНИЯ ДЛЯ НЕГО ХОРОША РОВНО ДО
Dialogue: 0,0:04:23.41,0:04:27.41,Caption,,0,0,0,,ТОГО МОМЕНТА, ПОКА СОВПАДАЕТ С ЕГО СОБСТВЕННЫМ ИНТЕРЕСОМ. ИСТОРИЯ
Dialogue: 0,0:04:27.41,0:04:30.37,Caption,,0,0,0,,С ДИЗЕЛЬНЫМ ТОПЛИВОМ ПОЛУЧИЛАСЬ ОСОБЕННО КРАСИВАЯ. В
Dialogue: 0,0:04:30.37,0:04:32.77,Caption,,0,0,0,,ЕВРОПЕ ВОЗНИКЛА ПАНИКА ИЗ ЗА СДЕЛКИ ТРАМПА И
Dialogue: 0,0:04:32.77,0:04:36.13,Caption,,0,0,0,,ПУТИНА. И ТУТ МАРК РЮТТЕ НАПОМНИЛ ЕВРОПЕЙЦАМ ОЧЕНЬ
Dialogue: 0,0:04:36.13,0:04:39.41,Caption,,0,0,0,,НЕУДОБНУЮ ВЕЩЬ. ЕВРОСОЮЗ САМ ПРОДОЛЖАЕТ ПОКУПАТЬ
Dialogue: 0,0:04:39.41,0:04:43.49,Caption,,0,0,0,,РОССИЙСКИЕ ЭНЕРГОРЕСУРСЫ, А РОССИЙСКОГО СЖИЖЕННОГО ГАЗА ЗАКУПИЛ СТОЛЬКО,
Dialogue: 0,0:04:43.73,0:04:46.05,Caption,,0,0,0,,ЧТО НА ЭТОМ ФОНЕ АМЕРИКАНСКАЯ ДИЗЕЛЬНАЯ ИСТОРИЯ
Dialogue: 0,0:04:46.05,0:04:48.77,Caption,,0,0,0,,ВЫГЛЯДИТ СОВСЕМ НЕ ТАК ВЕЛИЧЕСТВЕННО. ТО ЕСТЬ СХЕМА
Dialogue: 0,0:04:48.77,0:04:54.34,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ. КОГДА ТРАМП ДОГОВАРИВАЕТСЯ О РОССИЙСКОМ ТОПЛИВЕ,
Dialogue: 0,0:04:54.58,0:04:57.62,Caption,,0,0,0,,В ЕВРОПЕ ХВАТАЮТСЯ ЗА ГОЛОВУ. КОГДА ЕВРОПА САМА
Dialogue: 0,0:04:57.70,0:04:59.94,Caption,,0,0,0,,ПОКУПАЕТ РОССИЙСКИЙ ГАЗ, ЭТО УЖЕ,
Dialogue: 0,0:05:00.08,0:05:02.50,Caption,,0,0,0,,ВИДИМО, СОВСЕМ ДРУГОЙ ГАЗ. ОН,
Dialogue: 0,0:05:02.58,0:05:06.18,Caption,,0,0,0,,НАВЕРНОЕ, ПРОХОДИТ СПЕЦИАЛЬНОЕ ОЧИЩЕНИЕ ОТ ГЕОПОЛИТИКИ ГДЕ ТО
Dialogue: 0,0:05:06.26,0:05:08.26,Caption,,0,0,0,,ПО ДОРОГЕ. И ВОТ ЗДЕСЬ НЕ НАДО ДАЖЕ
Dialogue: 0,0:05:08.26,0:05:11.14,Caption,,0,0,0,,НИЧЕГО УСЛОЖНЯТЬ. ОДИН И ТОТ ЖЕ РОССИЙСКИЙ РЕСУРС
Dialogue: 0,0:05:11.14,0:05:13.86,Caption,,0,0,0,,СТАНОВИТСЯ МОРАЛЬНО РАЗНЫМ В ЗАВИСИМОСТИ ОТ ТОГО,
Dialogue: 0,0:05:13.96,0:05:17.54,Caption,,0,0,0,,КТО ОФОРМИЛ СЧЁТ. ОЧЕНЬ СОВРЕМЕННЫЙ ПОДХОД. НО У
Dialogue: 0,0:05:17.54,0:05:20.50,Caption,,0,0,0,,ЕВРОПЫ ХВАТАЕТ ЗАНЯТИЙ И БЕЗ ТРАМПА. ЭММАНЮЭЛЬ
Dialogue: 0,0:05:20.50,0:05:22.98,Caption,,0,0,0,,МАКРОН, НАПРИМЕР, УСПЕЛ ПОЖАЛОВАТЬСЯ,
Dialogue: 0,0:05:23.14,0:05:25.46,Caption,,0,0,0,,ЧТО ЕМУ НЕ ХВАТАЕТ АНГЕЛЫ МЕРКЕЛЬ И ЧТО
Dialogue: 0,0:05:25.46,0:05:27.86,Caption,,0,0,0,,С НЫНЕШНИМ РУКОВОДСТВОМ ЕВРОСОЮЗА СКУЧНО.
Dialogue: 0,0:05:28.07,0:05:31.70,Caption,,0,0,0,,СОГЛАСИТЕСЬ, РЕДКАЯ ПРОБЛЕМА ДЛЯ СОВРЕМЕННОЙ ЕВРОПЫ. ОБЫЧНО
Dialogue: 0,0:05:31.70,0:05:34.26,Caption,,0,0,0,,ЖАЛУЮТСЯ НА ЭКОНОМИКУ, БЕЗОПАСНОСТЬ,
Dialogue: 0,0:05:34.34,0:05:38.26,Caption,,0,0,0,,МИГРАЦИЮ, ЦЕНЫ. А ТУТ ЕЩЁ И СКУЧНО. ПРИЧЁМ РЯДОМ
Dialogue: 0,0:05:38.26,0:05:40.90,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ СОВСЕМ ДРУГАЯ ФРАНЦУЗСКАЯ ИСТОРИЯ. ПО
Dialogue: 0,0:05:40.98,0:05:44.90,Caption,,0,0,0,,СООБЩЕНИЯМ ПРЕССЫ, ДЛЯ МАКРОНА ПОДГОТОВИЛИ СЕКРЕТНЫЙ БУНКЕР В ПРИГОРОДЕ
Dialogue: 0,0:05:44.90,0:05:49.54,Caption,,0,0,0,,ПАРИЖА НА СЛУЧАЙ, ЕСЛИ ПРОТЕСТУЮЩИЕ ЗАХВАТЯТ ЕЛИСЕЙСКИЙ ДВОРЕЦ. ЭТИ
Dialogue: 0,0:05:49.62,0:05:52.26,Caption,,0,0,0,,ДВЕ НОВОСТИ НЕ НАДО СКЛЕИВАТЬ КЛЕЕМ. ОДНА ПРО
Dialogue: 0,0:05:52.26,0:05:55.46,Caption,,0,0,0,,НАСТРОЕНИЕ ВНУТРИ ЕВРОПЕЙСКОЙ ВЕРХУШКИ. ДРУГАЯ ПРО
Dialogue: 0,0:05:55.54,0:05:58.42,Caption,,0,0,0,,УРОВЕНЬ НЕРВОЗНОСТИ ВНУТРИ ФРАНЦИИ. НО СТОЯТ ОНИ
Dialogue: 0,0:05:58.42,0:06:01.38,Caption,,0,0,0,,РЯДОМ ОЧЕНЬ ВЫРАЗИТЕЛЬНО. ПРЕЗИДЕНТ СКУЧАЕТ ПО
Dialogue: 0,0:06:01.46,0:06:07.09,Caption,,0,0,0,,ПРЕЖНЕЙ ЕВРОПЕ. И ОДНОВРЕМЕННО РЯДОМ С ПАРИЖЕМ ОБСУЖДАЮТ МЕСТО,
Dialogue: 0,0:06:07.41,0:06:09.17,Caption,,0,0,0,,КУДА ПРЕЗИДЕНТУ ПРИДЁТСЯ УЕЗЖАТЬ,
Dialogue: 0,0:06:09.41,0:06:12.61,Caption,,0,0,0,,ЕСЛИ ВОЗЛЕ ДВОРЦА СТАНЕТ СОВСЕМ ВЕСЕЛО. ФРАНЦУЗСКАЯ
Dialogue: 0,0:06:12.61,0:06:15.57,Caption,,0,0,0,,ПОЛИТИКА УМЕЕТ БОРОТЬСЯ СО СКУКОЙ. А НА ВОСТОКЕ
Dialogue: 0,0:06:15.57,0:06:18.77,Caption,,0,0,0,,ЕВРОПЫ ВООБЩЕ ДРУГАЯ КАРТИНА. КАРТА НАВИГАЦИОННЫХ
Dialogue: 0,0:06:18.85,0:06:21.81,Caption,,0,0,0,,ПОМЕХ ПОКАЗЫВАЕТ МОЩНУЮ ПОЛОСУ ПОЧТИ ВДОЛЬ ВСЕГО
Dialogue: 0,0:06:21.81,0:06:24.85,Caption,,0,0,0,,ВОСТОЧНОГО ФЛАНГА НАТО. ТУТ УЖЕ НЕ ДО НОСТАЛЬГИИ
Dialogue: 0,0:06:24.93,0:06:27.73,Caption,,0,0,0,,ПО МЕРКЕЛЬ. СПУТНИКОВАЯ НАВИГАЦИЯ НАЧИНАЕТ ВЕСТИ
Dialogue: 0,0:06:27.73,0:06:30.37,Caption,,0,0,0,,СЕБЯ ТАК, БУДТО КТО ТО РЕШИЛ ПРОВЕРИТЬ,
Dialogue: 0,0:06:30.60,0:06:33.33,Caption,,0,0,0,,НАСКОЛЬКО СОВРЕМЕННЫЙ МИР ЛЮБИТ НЕВИДИМЫЕ СИГНАЛЫ ИЗ
Dialogue: 0,0:06:33.33,0:06:35.89,Caption,,0,0,0,,КОСМОСА. И ВОТ ЭТО ХОРОШИЙ ПРИМЕР ТОГО,
Dialogue: 0,0:06:36.09,0:06:39.01,Caption,,0,0,0,,КАК СУХАЯ ТЕХНИЧЕСКАЯ ВЕЩЬ ВНЕЗАПНО СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:06:39.01,0:06:41.49,Caption,,0,0,0,,ПОНЯТНОЙ. ПОКА НАВИГАЦИЯ РАБОТАЕТ,
Dialogue: 0,0:06:41.68,0:06:44.45,Caption,,0,0,0,,О НЕЙ НИКТО НЕ ДУМАЕТ. КОГДА ОГРОМНАЯ ПОЛОСА
Dialogue: 0,0:06:44.45,0:06:46.77,Caption,,0,0,0,,ВДОЛЬ ГРАНИЦЫ НАЧИНАЕТ СВЕТИТЬСЯ ПОМЕХАМИ,
Dialogue: 0,0:06:47.01,0:06:50.85,Caption,,0,0,0,,СТАНОВИТСЯ ЯСНО, НАСКОЛЬКО МНОГО ВОКРУГ ДЕРЖИТСЯ НА СИСТЕМЕ,
Dialogue: 0,0:06:51.07,0:06:53.65,Caption,,0,0,0,,КОТОРУЮ ЧЕЛОВЕК ДАЖЕ ГЛАЗАМИ НЕ ВИДИТ. А ТЕПЕРЬ
Dialogue: 0,0:06:53.73,0:06:56.77,Caption,,0,0,0,,ИРАН. И ВОТ ЗДЕСЬ АМЕРИКАНСКИЕ ВЫБОРЫ ЗАКАНЧИВАЮТСЯ
Dialogue: 0,0:06:56.77,0:06:59.49,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО. ПОТОМУ ЧТО ТЕГЕРАНУ СОВЕРШЕННО ВСЁ
Dialogue: 0,0:06:59.57,0:07:02.69,Caption,,0,0,0,,РАВНО, СКОЛЬКО ДЕМОКРАТОВ ТЕПЕРЬ СИДИТ В КОНГРЕССЕ И
Dialogue: 0,0:07:02.69,0:07:05.81,Caption,,0,0,0,,СКОЛЬКО РАССЛЕДОВАНИЙ ОНИ СОБИРАЮТСЯ ОТКРЫТЬ. ИРАНЦЫ
Dialogue: 0,0:07:05.81,0:07:08.77,Caption,,0,0,0,,УЖЕ ШУТЯТ, ЧТО В ИТОГЕ ИМЕННО ИРАН СМЕНИЛ РЕЖИМ В
Dialogue: 0,0:07:08.77,0:07:11.57,Caption,,0,0,0,,США, А НЕ НАОБОРОТ. ШУТКА ЗЛАЯ,
Dialogue: 0,0:07:11.80,0:07:13.57,Caption,,0,0,0,,НО МОМЕНТ ОНИ ВЫБРАЛИ ПОДХОДЯЩИЙ.
Dialogue: 0,0:07:15.84,0:07:18.08,Caption,,0,0,0,,АМЕРИКАНСКАЯ ПОЛИТИКА ПОСЛЕ ИРАНСКОЙ ИСТОРИИ
Dialogue: 0,0:07:18.08,0:07:20.72,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПОЛУЧИЛА НОВЫЙ ВНУТРЕННИЙ КОНФЛИКТ,
Dialogue: 0,0:07:21.04,0:07:25.44,Caption,,0,0,0,,И ТЕПЕРЬ В ВАШИНГТОНЕ ИЩУТ, КТО ЗА ЧТО ОТВЕЧАЕТ. НО ТЕГЕРАН НА ШУТКАХ
Dialogue: 0,0:07:25.52,0:07:30.16,Caption,,0,0,0,,НЕ ОСТАНОВИЛСЯ. ИРАН ОБЪЯВИЛ, ЧТО БОЛЬШЕ НЕ СЧИТАЕТ СЕБЯ СВЯЗАННЫМ ПРЕЖНИМ
Dialogue: 0,0:07:30.16,0:07:32.64,Caption,,0,0,0,,ДОБРОВОЛЬНЫМ ОГРАНИЧЕНИЕМ ДАЛЬНОСТИ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:07:32.72,0:07:35.52,Caption,,0,0,0,,РАКЕТ В ДВЕ ТЫСЯЧИ КИЛОМЕТРОВ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:07:35.60,0:07:38.56,Caption,,0,0,0,,НЕ СЛОВЕСНАЯ ИГРА. ДВЕ ТЫСЯЧИ КИЛОМЕТРОВ РАНЬШЕ БЫЛИ
Dialogue: 0,0:07:38.56,0:07:41.60,Caption,,0,0,0,,ПОЛИТИЧЕСКИ ОБОЗНАЧЕННЫМ ПОТОЛКОМ. ТЕПЕРЬ ТЕГЕРАН
Dialogue: 0,0:07:41.60,0:07:44.80,Caption,,0,0,0,,ГОВОРИТ, ЧТО ЭТОГО ПОТОЛКА ДЛЯ СЕБЯ БОЛЬШЕ НЕ ПРИЗНАЁТ.
Dialogue: 0,0:07:45.20,0:07:48.08,Caption,,0,0,0,,И СРАЗУ ПОЯВЛЯЕТСЯ СЛЕДУЮЩИЙ ВОПРОС. ЕСЛИ СТАРУЮ
Dialogue: 0,0:07:48.08,0:07:51.20,Caption,,0,0,0,,РАМКУ УБРАЛИ, ДЛЯ КОГО ИМЕННО ПРЕДНАЗНАЧЕНА НОВАЯ?
Dialogue: 0,0:07:51.74,0:07:54.56,Caption,,0,0,0,,В ЗАЯВЛЕНИЯХ УЖЕ ЗВУЧАТ АМЕРИКАНСКИЕ БАЗЫ В ЕВРОПЕ.
Dialogue: 0,0:07:54.80,0:07:58.16,Caption,,0,0,0,,ТО ЕСТЬ ГЕОГРАФИЯ УГРОЗЫ СТАНОВИТСЯ ШИРЕ. И ЕВРОПА,
Dialogue: 0,0:07:58.28,0:08:00.32,Caption,,0,0,0,,КОТОРАЯ ТОЛЬКО ЧТО ОБСУЖДАЛА ТРАМПА,
Dialogue: 0,0:08:00.41,0:08:02.72,Caption,,0,0,0,,ДИЗЕЛЬ И СВОИ ОТНОШЕНИЯ С ВАШИНГТОНОМ,
Dialogue: 0,0:08:02.96,0:08:06.08,Caption,,0,0,0,,ПОЛУЧАЕТ ЕЩЁ ОДНУ ТЕМУ ДЛЯ РАЗМЫШЛЕНИЙ. НА ЭТОТ
Dialogue: 0,0:08:06.08,0:08:10.16,Caption,,0,0,0,,РАЗ НЕ ПРО ТО, КТО КОГО ОБОШЁЛ В КОНГРЕССЕ. КОРПУС СТРАЖЕЙ
Dialogue: 0,0:08:10.24,0:08:13.12,Caption,,0,0,0,,ИСЛАМСКОЙ РЕВОЛЮЦИИ ДОБАВЛЯЕТ КРАСОК. ОБЪЯВЛЯЕТ О
Dialogue: 0,0:08:13.12,0:08:16.00,Caption,,0,0,0,,НОВЫХ РАКЕТНЫХ ГОРОДАХ В ТЕГЕРАНЕ И МЕШХЕДЕ. И
Dialogue: 0,0:08:16.00,0:08:20.64,Caption,,0,0,0,,ЗАОДНО ОБЕЩАЕТ СЮРПРИЗ, СВЯЗАННЫЙ С КОСМОСОМ. ОЧЕНЬ УДОБНОЕ СЛОВО "СЮРПРИЗ".
Dialogue: 0,0:08:20.96,0:08:22.88,Caption,,0,0,0,,ОСОБЕННО КОГДА ЕГО ПРОИЗНОСЯТ ЛЮДИ,
Dialogue: 0,0:08:23.12,0:08:26.08,Caption,,0,0,0,,КОТОРЫЕ ПЕРЕД ЭТИМ РАССКАЗЫВАЮТ О РАКЕТАХ. ЧТО
Dialogue: 0,0:08:26.16,0:08:27.84,Caption,,0,0,0,,ИМЕННО ОНИ СОБИРАЮТСЯ ПОКАЗАТЬ,
Dialogue: 0,0:08:27.92,0:08:33.73,Caption,,0,0,0,,ЗАРАНЕЕ РАСКРЫВАТЬ НЕ СТАЛИ. И ПРАВИЛЬНО. КАКОЙ ЖЕ ЭТО СЮРПРИЗ,
Dialogue: 0,0:08:34.05,0:08:36.93,Caption,,0,0,0,,ЕСЛИ ПРИСЛАТЬ ПРОГРАММУ МЕРОПРИЯТИЯ. НО САМАЯ
Dialogue: 0,0:08:36.93,0:08:39.81,Caption,,0,0,0,,ИНТЕРЕСНАЯ ИСТОРИЯ ДАЖЕ НЕ ОБЯЗАТЕЛЬНО ЛЕТАЕТ. ЗА
Dialogue: 0,0:08:39.89,0:08:42.29,Caption,,0,0,0,,ПОСЛЕДНИЕ НЕДЕЛИ КАК МИНИМУМ ЧЕТЫРЕ СУДНА,
Dialogue: 0,0:08:42.37,0:08:46.37,Caption,,0,0,0,,СВЯЗАННЫЕ С ИРАНОМ, ЗАМЕТИЛИ ЗА НЕОБЫЧНЫМИ МАНЁВРАМИ ВОЗЛЕ ПОДВОДНЫХ
Dialogue: 0,0:08:46.37,0:08:49.09,Caption,,0,0,0,,КАБЕЛЕЙ СВЯЗИ В ОМАНСКОМ ЗАЛИВЕ. ВОТ ТУТ УЖЕ
Dialogue: 0,0:08:49.09,0:08:52.21,Caption,,0,0,0,,СТАНОВИТСЯ СОВСЕМ ЗАНЯТНО. ПОТОМУ ЧТО РАКЕТА ПОНЯТНА
Dialogue: 0,0:08:52.29,0:08:57.73,Caption,,0,0,0,,ВСЕМ. ОНА ЛЕТИТ, ЕЁ ВИДНО, ВОКРУГ НЕЁ СТРОЯТ СИСТЕМЫ ЗАЩИТЫ. А КАБЕЛЬ ЛЕЖИТ
Dialogue: 0,0:08:57.81,0:09:01.97,Caption,,0,0,0,,ГДЕ ТО ГЛУБОКО ПОД ВОДОЙ, И ОБЫЧНЫЙ ЧЕЛОВЕК ВСПОМИНАЕТ О НЁМ ТОЛЬКО ТОГДА,
Dialogue: 0,0:09:02.28,0:09:04.69,Caption,,0,0,0,,КОГДА ИНТЕРНЕТ ВНЕЗАПНО РЕШАЕТ УЙТИ В ОТПУСК.
Dialogue: 0,0:09:05.24,0:09:08.37,Caption,,0,0,0,,ЧЕРЕЗ ТАКИЕ ЛИНИИ ИДЁТ СВЯЗЬ, ФИНАНСОВЫЕ ОПЕРАЦИИ,
Dialogue: 0,0:09:08.61,0:09:11.65,Caption,,0,0,0,,РАБОТА ЦИФРОВЫХ СЕРВИСОВ. ОГРОМНАЯ СОВРЕМЕННАЯ
Dialogue: 0,0:09:11.65,0:09:13.65,Caption,,0,0,0,,ЭКОНОМИКА БУКВАЛЬНО ВИСИТ НА НИТКАХ,
Dialogue: 0,0:09:13.89,0:09:16.29,Caption,,0,0,0,,КОТОРЫЕ ЛЕЖАТ НА МОРСКОМ ДНЕ. И КОГДА ВОЗЛЕ
Dialogue: 0,0:09:16.37,0:09:18.85,Caption,,0,0,0,,ЭТИХ НИТОК НАЧИНАЮТ СТРАННО КРУТИТЬСЯ СУДА,
Dialogue: 0,0:09:19.17,0:09:22.05,Caption,,0,0,0,,ВНИМАНИЕ ВОЗНИКАЕТ САМО СОБОЙ. ЭТО УЖЕ СОВСЕМ ДРУГОЙ
Dialogue: 0,0:09:22.05,0:09:24.93,Caption,,0,0,0,,ИНСТРУМЕНТ ДАВЛЕНИЯ. НЕ ОБЯЗАТЕЛЬНО БИТЬ ПО БАЗЕ,
Dialogue: 0,0:09:25.24,0:09:27.97,Caption,,0,0,0,,ЧТОБЫ СОЗДАТЬ ОГРОМНУЮ ПРОБЛЕМУ. ИНОГДА ДОСТАТОЧНО
Dialogue: 0,0:09:28.05,0:09:30.69,Caption,,0,0,0,,ЗАСТАВИТЬ ВСЕХ НЕРВНО СМОТРЕТЬ НА КАРТУ КАБЕЛЕЙ И
Dialogue: 0,0:09:30.69,0:09:35.01,Caption,,0,0,0,,СЧИТАТЬ, ЧТО ПРОИЗОЙДЁТ, ЕСЛИ В ОДНОМ МЕСТЕ ЧТО ТО ИСЧЕЗНЕТ. И
Dialogue: 0,0:09:35.01,0:09:39.09,Caption,,0,0,0,,РЯДОМ КРАСНОЕ МОРЕ. ХУСИТЫ, ПО СООБЩЕНИЯМ АМЕРИКАНСКОЙ ПРЕССЫ,
Dialogue: 0,0:09:39.32,0:09:42.45,Caption,,0,0,0,,УСИЛИВАЮТ КОНТРОЛЬ ЗА ДВИЖЕНИЕМ СУДОВ. ЭТО НЕ НАДО
Dialogue: 0,0:09:42.53,0:09:44.45,Caption,,0,0,0,,ОБЪЯВЛЯТЬ ПРОДОЛЖЕНИЕМ ИСТОРИИ С КАБЕЛЯМИ.
Dialogue: 0,0:09:46.73,0:09:49.85,Caption,,0,0,0,,ЭТО ОТДЕЛЬНАЯ ГОЛОВНАЯ БОЛЬ. ПРОСТО ГЕОГРАФИЯ ОПЯТЬ
Dialogue: 0,0:09:49.93,0:09:52.17,Caption,,0,0,0,,ТА ЖЕ БОЛЬШАЯ. ТОРГОВЫЕ МАРШРУТЫ,
Dialogue: 0,0:09:52.32,0:09:57.85,Caption,,0,0,0,,МОРЕ, ИНФРАСТРУКТУРА, ДВИЖЕНИЕ ТОВАРОВ. ПОЛУЧАЕТСЯ ИНТЕРЕСНАЯ КАРТИНА. В
Dialogue: 0,0:09:57.85,0:10:01.93,Caption,,0,0,0,,ВАШИНГТОНЕ ВЫЯСНЯЮТ, КОГО БУДУТ СНИМАТЬ И КТО КОГО БУДЕТ РАССЛЕДОВАТЬ.
Dialogue: 0,0:10:02.33,0:10:04.57,Caption,,0,0,0,,В ЕВРОПЕ СПОРЯТ, КАК ЖИТЬ С ТРАМПОМ,
Dialogue: 0,0:10:04.75,0:10:07.37,Caption,,0,0,0,,КТО ПОКУПАЕТ ПРАВИЛЬНЫЙ РОССИЙСКИЙ ГАЗ И КУДА
Dialogue: 0,0:10:07.37,0:10:11.45,Caption,,0,0,0,,ЭВАКУИРОВАТЬ ПРЕЗИДЕНТА, ЕСЛИ ГРАЖДАНЕ СЛИШКОМ АКТИВНО ЗАХОТЯТ ПОГОВОРИТЬ С
Dialogue: 0,0:10:11.45,0:10:14.33,Caption,,0,0,0,,ВЛАСТЬЮ. НА ВОСТОКЕ НАТО ИДУТ ПОМЕХИ. В ИРАНЕ
Dialogue: 0,0:10:14.33,0:10:17.45,Caption,,0,0,0,,УБИРАЮТ СТАРЫЕ ОГРАНИЧЕНИЯ НА РАКЕТЫ. ВОЗЛЕ КАБЕЛЕЙ
Dialogue: 0,0:10:17.45,0:10:20.65,Caption,,0,0,0,,ХОДЯТ СУДА. В КРАСНОМ МОРЕ СНОВА СЧИТАЮТ КОРАБЛИ.
Dialogue: 0,0:10:20.89,0:10:23.53,Caption,,0,0,0,,И САМОЕ НЕПРИЯТНОЕ ЗДЕСЬ ДАЖЕ НЕ КОЛИЧЕСТВО ПРОБЛЕМ.
Dialogue: 0,0:10:23.71,0:10:27.29,Caption,,0,0,0,,ЗАПАД ПРИВЫК К СИТУАЦИИ, КОГДА ЕСТЬ ОДНА БОЛЬШАЯ ЗАДАЧА,
Dialogue: 0,0:10:27.61,0:10:30.65,Caption,,0,0,0,,ПОД НЕЁ СОБИРАЮТ КОАЛИЦИЮ, НАЗНАЧАЮТ ВИНОВАТОГО,
Dialogue: 0,0:10:30.80,0:10:33.61,Caption,,0,0,0,,ВЫПУСКАЮТ ЗАЯВЛЕНИЕ И НАЧИНАЮТ ДВИГАТЬ ТЯЖЁЛЫЕ ПАПКИ
Dialogue: 0,0:10:33.61,0:10:37.13,Caption,,0,0,0,,ПО СТОЛУ. А ЗДЕСЬ ЗАДАЧИ РАЗНЫЕ. ПРИЧИНЫ РАЗНЫЕ.
Dialogue: 0,0:10:37.34,0:10:40.57,Caption,,0,0,0,,ИГРОКИ РАЗНЫЕ. И ОБЩЕГО ВЫКЛЮЧАТЕЛЯ ДЛЯ НИХ НЕТ.
Dialogue: 0,0:10:40.96,0:10:43.29,Caption,,0,0,0,,АМЕРИКА ЕЩЁ ДВА ГОДА БУДЕТ ЖИТЬ С ТРАМПОМ
Dialogue: 0,0:10:43.29,0:10:46.49,Caption,,0,0,0,,И НОВЫМ КОНГРЕССОМ. ЕВРОПА ЕЩЁ ДОЛГО БУДЕТ ВЫЯСНЯТЬ,
Dialogue: 0,0:10:46.73,0:10:49.13,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЕТСЯ СОЮЗНИЧЕСТВО И НАЧИНАЕТСЯ
Dialogue: 0,0:10:49.13,0:10:51.77,Caption,,0,0,0,,СОБСТВЕННЫЙ ИНТЕРЕС. ИРАН УЖЕ ПОКАЗЫВАЕТ,
Dialogue: 0,0:10:52.00,0:10:54.65,Caption,,0,0,0,,ЧТО СТАРЫЕ ОГРАНИЧЕНИЯ ДЛЯ НЕГО БОЛЬШЕ НЕ СВЯЩЕННАЯ
Dialogue: 0,0:10:54.65,0:10:57.69,Caption,,0,0,0,,КОРОВА. ТАК ЧТО ГЛАВНЫЙ ДЕФИЦИТ ЗАПАДА СЕЙЧАС НЕ
Dialogue: 0,0:10:57.69,0:11:00.97,Caption,,0,0,0,,ДЕНЬГИ, НЕ ЗАЯВЛЕНИЯ И ДАЖЕ НЕ ЛЮДИ В КАБИНЕТАХ.
Dialogue: 0,0:11:03.24,0:11:06.68,Caption,,0,0,0,,ГЛАВНЫЙ ДЕФИЦИТ ГОРАЗДО ПРОЩЕ. ВНИМАНИЕ. ПОТОМУ ЧТО
Dialogue: 0,0:11:06.76,0:11:09.32,Caption,,0,0,0,,КОГДА ОДНОВРЕМЕННО ГОРИТ СЛИШКОМ МНОГО ЛАМПОЧЕК,
Dialogue: 0,0:11:09.57,0:11:13.96,Caption,,0,0,0,,ОЧЕНЬ ЛЕГКО ДОЛГО СПОРИТЬ, КАКУЮ ВЫКЛЮЧИТЬ ПЕРВОЙ. А ПОТОМ ОБНАРУЖИТЬ,
Dialogue: 0,0:11:14.04,0:11:16.20,Caption,,0,0,0,,ЧТО ОДНА ИЗ НИХ ВООБЩЕ БЫЛА НЕ ЛАМПОЧКОЙ.
