Dialogue: 0,0:00:00.12,0:00:03.88,Caption,,0,0,0,,ВОТ ЕВРОПА ГОВОРИТ, С РОССИЕЙ РАЗГОВАРИВАТЬ НЕЛЬЗЯ. ОСТАНАВЛИВАТЬСЯ
Dialogue: 0,0:00:03.88,0:00:06.76,Caption,,0,0,0,,НЕЛЬЗЯ. УКРАИНЕ НАДО ДАВАТЬ ЕЩЁ БОЛЬШЕ ДЕНЕГ,
Dialogue: 0,0:00:06.99,0:00:11.48,Caption,,0,0,0,,БОЛЬШЕ СТРЕЛЯЛОК. ХОРОШО, ДОПУСТИМ. А ДО КАКОЙ ТОЧКИ ВЫ СОБИРАЕТЕСЬ ИДТИ?
Dialogue: 0,0:00:11.56,0:00:14.28,Caption,,0,0,0,,ДО МОСКВЫ? ДО УРАЛА? ГДЕ ТА ТОЧКА,
Dialogue: 0,0:00:14.45,0:00:16.04,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ВЫ СМОЖЕТЕ СКАЗАТЬ,
Dialogue: 0,0:00:16.22,0:00:20.12,Caption,,0,0,0,,ВОТ ОНА НАША ПОБЕДА? ПОТОМУ ЧТО КОГДА ПЛАН СОСТОИТ ТОЛЬКО ИЗ СЛОВА
Dialogue: 0,0:00:20.12,0:00:23.56,Caption,,0,0,0,,"ДАЛЬШЕ", ЭТО УЖЕ ОЧЕНЬ НЕИНТЕРЕСНЫЙ ПЛАН. НЕ НАХОДИТЕ?
Dialogue: 0,0:00:23.84,0:00:26.12,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗГОВОР БЕЗ КРАСИВЫХ
Dialogue: 0,0:00:26.12,0:00:27.96,Caption,,0,0,0,,ЛОЗУНГОВ И ДИПЛОМАТИЧЕСКОЙ ВАТЫ,
Dialogue: 0,0:00:28.04,0:00:30.52,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ БУДЕМ ЗАДАВАТЬ ТЕ
Dialogue: 0,0:00:30.52,0:00:34.12,Caption,,0,0,0,,ВОПРОСЫ, КОТОРЫЕ ОБЫЧНО ПОРТЯТ ХОРОШИЙ ОФИЦИАЛЬНЫЙ ДОКЛАД.
Dialogue: 0,0:00:34.60,0:00:37.00,Caption,,0,0,0,,ПОТОМУ ЧТО С ДЕНЬГАМИ НАЧИНАЕТСЯ ВООБЩЕ ПРЕКРАСНАЯ
Dialogue: 0,0:00:37.00,0:00:40.12,Caption,,0,0,0,,ИСТОРИЯ. ЕВРОПЕЙСКОМУ СОЮЗУ ОПЯТЬ НУЖНЫ ДЕСЯТКИ
Dialogue: 0,0:00:40.12,0:00:43.24,Caption,,0,0,0,,МИЛЛИАРДОВ ДЛЯ УКРАИНЫ. ПО РАСЧЁТАМ WELT AM SONNTAG,
Dialogue: 0,0:00:43.48,0:00:45.96,Caption,,0,0,0,,РЕЧЬ ИДЁТ ЕЩЁ БОЛЕЕ ЧЕМ О СОРОКА МИЛЛИАРДАХ
Dialogue: 0,0:00:45.96,0:00:48.84,Caption,,0,0,0,,ЕВРО СОВМЕСТНЫХ КРЕДИТОВ. А ОБЩИЙ ОБЪЁМ ТАКИХ
Dialogue: 0,0:00:48.84,0:00:51.32,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ СПОСОБЕН ПЕРЕВАЛИТЬ ЗА ДВЕСТИ
Dialogue: 0,0:00:51.32,0:00:54.60,Caption,,0,0,0,,МИЛЛИАРДОВ. ДВЕСТИ МИЛЛИАРДОВ. ЭТО УЖЕ НЕ КОРОБКА
Dialogue: 0,0:00:54.60,0:00:58.20,Caption,,0,0,0,,ПАТРОНОВ, КОТОРУЮ ЗАБЫЛИ ПОСЧИТАТЬ НА СКЛАДЕ. ЭТО ДЕНЬГИ,
Dialogue: 0,0:00:58.44,0:01:00.68,Caption,,0,0,0,,КОТОРЫЕ НАДО ГДЕ ТО ВЗЯТЬ, ЗАНЯТЬ,
Dialogue: 0,0:01:00.76,0:01:03.96,Caption,,0,0,0,,ОБСЛУЖИВАТЬ И ПОТОМ ВОЗВРАЩАТЬ. ПРИЧЁМ ДОХОДОВ ОТ
Dialogue: 0,0:01:03.96,0:01:06.20,Caption,,0,0,0,,ЗАМОРОЖЕННЫХ РОССИЙСКИХ АКТИВОВ НА ВЕСЬ ЭТОТ
Dialogue: 0,0:01:06.28,0:01:09.00,Caption,,0,0,0,,ПРАЗДНИК НЕ ХВАТАЕТ. ЗА БОЛЕЕ ЧЕМ ДВА ГОДА
Dialogue: 0,0:01:09.08,0:01:11.16,Caption,,0,0,0,,ОНИ ДАЛИ ОКОЛО ВОСЬМИ МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:01:13.45,0:01:16.65,Caption,,0,0,0,,А НОВЫЙ ЗАПРОС ИЗМЕРЯЕТСЯ ДЕСЯТКАМИ МИЛЛИАРДОВ. И
Dialogue: 0,0:01:16.73,0:01:19.77,Caption,,0,0,0,,ТУТ ПОЯВЛЯЕТСЯ ПРОСТАЯ АРИФМЕТИКА. ДЕНЕГ НЕ ХВАТАЕТ,
Dialogue: 0,0:01:19.86,0:01:22.49,Caption,,0,0,0,,ЗНАЧИТ, ЗАНИМАЕМ. НЕ ХВАТАЕТ СНОВА,
Dialogue: 0,0:01:22.57,0:01:25.29,Caption,,0,0,0,,ЗАНИМАЕМ ЕЩЁ. ПОТОМ ОБЪЯСНЯЕМ ГРАЖДАНАМ,
Dialogue: 0,0:01:25.44,0:01:28.81,Caption,,0,0,0,,ПОЧЕМУ БЮДЖЕТ ОПЯТЬ ТУГОЙ, ПОЧЕМУ НА ВСЁ СРАЗУ ДЕНЕГ НЕТ,
Dialogue: 0,0:01:29.02,0:01:31.37,Caption,,0,0,0,,ПОЧЕМУ СОЦИАЛЬНЫЕ РАСХОДЫ НАДО ПЕРЕСМАТРИВАТЬ,
Dialogue: 0,0:01:31.53,0:01:34.09,Caption,,0,0,0,,ПОЧЕМУ ЭКОНОМИКА ДОЛЖНА ПОТЕРПЕТЬ. И ВСЁ ЭТО
Dialogue: 0,0:01:34.09,0:01:36.41,Caption,,0,0,0,,СОПРОВОЖДАЕТСЯ ОДНОЙ И ТОЙ ЖЕ ФРАЗОЙ НАДО
Dialogue: 0,0:01:36.41,0:01:41.29,Caption,,0,0,0,,ПРОДОЛЖАТЬ. ХОРОШО. А ЗАЧЕМ? РОССИЙСКАЯ АРМИЯ ДОЛЖНА УЙТИ КУДА?
Dialogue: 0,0:01:41.52,0:01:43.37,Caption,,0,0,0,,РОССИЯ ДОЛЖНА ОТКАЗАТЬСЯ ОТ ЧЕГО?
Dialogue: 0,0:01:43.60,0:01:45.53,Caption,,0,0,0,,МОСКВА ДОЛЖНА ПОДПИСАТЬ КАКОЙ ДОКУМЕНТ?
Dialogue: 0,0:01:45.59,0:01:48.65,Caption,,0,0,0,,ПУТИН ДОЛЖЕН УЙТИ? РОССИЙСКАЯ ЭКОНОМИКА ДОЛЖНА РУХНУТЬ?
Dialogue: 0,0:01:48.81,0:01:51.05,Caption,,0,0,0,,ДОЛЖНА СМЕНИТЬСЯ ВСЯ ПОЛИТИЧЕСКАЯ СИСТЕМА?
Dialogue: 0,0:01:51.28,0:01:55.61,Caption,,0,0,0,,ЧТО ИМЕННО СЧИТАЕТСЯ ПОБЕДОЙ? ПОТОМУ ЧТО ЕСЛИ КОНЕЧНАЯ ЦЕЛЬ НЕ НАЗВАНА,
Dialogue: 0,0:01:55.89,0:01:58.01,Caption,,0,0,0,,ЛЮБОЕ КОЛИЧЕСТВО ДЕНЕГ ПРЕВРАЩАЕТСЯ ПРОСТО В
Dialogue: 0,0:01:58.01,0:02:00.89,Caption,,0,0,0,,СЛЕДУЮЩИЙ ВЗНОС ЗА ПРОДОЛЖЕНИЕ ПРОЦЕССА. НА САНКЦИИ
Dialogue: 0,0:02:00.89,0:02:03.61,Caption,,0,0,0,,УЖЕ БЫЛА ОГРОМНАЯ СТАВКА. ЛОГИКА БЫЛА ПОНЯТНОЙ
Dialogue: 0,0:02:03.61,0:02:05.37,Caption,,0,0,0,,ДАВЛЕНИЕ СТАНЕТ ТАКИМ СИЛЬНЫМ,
Dialogue: 0,0:02:05.53,0:02:07.45,Caption,,0,0,0,,ЧТО РОССИЙСКАЯ ЭКОНОМИКА НЕ ВЫДЕРЖИТ,
Dialogue: 0,0:02:07.69,0:02:11.53,Caption,,0,0,0,,ВНУТРИ НАЧНУТСЯ ПРОБЛЕМЫ, ПОЛИТИЧЕСКАЯ КОНСТРУКЦИЯ ЗАШАТАЕТСЯ,
Dialogue: 0,0:02:11.82,0:02:14.57,Caption,,0,0,0,,И МОСКВА БУДЕТ ВЫНУЖДЕНА ОТСТУПИТЬ. ПРОШЛО ПОЧТИ
Dialogue: 0,0:02:14.57,0:02:17.93,Caption,,0,0,0,,ПЯТЬ ЛЕТ ВОЙНЫ. РОССИЯ НЕ ИСЧЕЗЛА. ГОСУДАРСТВЕННАЯ
Dialogue: 0,0:02:18.01,0:02:21.13,Caption,,0,0,0,,СИСТЕМА НЕ РАССЫПАЛАСЬ. КРЕМЛЬ НЕ ПОДНЯЛ БЕЛЫЙ ФЛАГ.
Dialogue: 0,0:02:23.32,0:02:26.76,Caption,,0,0,0,,ЗНАЧИТ, ВОЗНИКАЕТ НЕУДОБНЫЙ ВОПРОС НА КАКОМ ОСНОВАНИИ СТАРЫЙ
Dialogue: 0,0:02:26.76,0:02:29.16,Caption,,0,0,0,,РАСЧЁТ ДОЛЖЕН ВНЕЗАПНО СРАБОТАТЬ ЗАВТРА,
Dialogue: 0,0:02:29.41,0:02:31.40,Caption,,0,0,0,,ЕСЛИ ОН НЕ ДАЛ ТОГО РЕЗУЛЬТАТА ВЧЕРА?
Dialogue: 0,0:02:31.97,0:02:34.28,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ОСОБЕННО ИНТЕРЕСНО СЛУШАТЬ ЗАПАДНУЮ
Dialogue: 0,0:02:34.28,0:02:39.08,Caption,,0,0,0,,ПРЕССУ. ТАМ УЖЕ САМИ ПИШУТ, ЧТО ОДНОЙ ЗАПАДНОЙ ПОМОЩЬЮ ПРОБЛЕМУ НЕ РЕШИТЬ И
Dialogue: 0,0:02:39.16,0:02:41.56,Caption,,0,0,0,,ЧТО ГЕРМАНИЯ, ПРИ ВСЕЙ ПОДДЕРЖКЕ КИЕВА,
Dialogue: 0,0:02:41.86,0:02:44.68,Caption,,0,0,0,,ВСЁ БОЛЬШЕ ВЫГЛЯДИТ БЕСПОМОЩНЫМ ПАРТНЁРОМ. БЕРЛИН
Dialogue: 0,0:02:44.76,0:02:47.80,Caption,,0,0,0,,МОЖЕТ ДАВАТЬ ДЕНЬГИ, ОРУЖИЕ, ОБЕЩАНИЯ,
Dialogue: 0,0:02:48.12,0:02:50.84,Caption,,0,0,0,,НО РЕШАЮЩИЕ РАЗГОВОРЫ О БУДУЩЕМ УКРАИНЫ ИДУТ МЕЖДУ
Dialogue: 0,0:02:50.84,0:02:53.88,Caption,,0,0,0,,МОСКВОЙ И ВАШИНГТОНОМ. НА ЗАПАДЕ УЖЕ САМИ ГОВОРЯТ
Dialogue: 0,0:02:53.96,0:02:57.08,Caption,,0,0,0,,О ПЕРСПЕКТИВЕ ПОРАЖЕНИЯ УКРАИНЫ. А ВЫВОД ЕЩЁ ЖЁСТЧЕ
Dialogue: 0,0:02:57.17,0:03:01.32,Caption,,0,0,0,,ПОРАЖЕНИЕ НЕИЗБЕЖНО, НО НЫНЕШНИЕ ЕВРОПЕЙСКИЕ ВЛАСТИ ВСЁ РАВНО ПРОДОЛЖАЮТ
Dialogue: 0,0:03:01.32,0:03:04.28,Caption,,0,0,0,,ПРЕЖНИЙ КУРС. И КАРТИНА ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ.
Dialogue: 0,0:03:04.52,0:03:07.80,Caption,,0,0,0,,ГЕРМАНИЯ ПЛАТИТ. ЕВРОПА ЗАНИМАЕТ. А РЕШАТЬ БУДУТ
Dialogue: 0,0:03:07.80,0:03:10.60,Caption,,0,0,0,,ДРУГИЕ. ВОТ ТУТ УЖЕ ДАЖЕ БУХГАЛТЕР ДОЛЖЕН СНЯТЬ
Dialogue: 0,0:03:10.68,0:03:13.56,Caption,,0,0,0,,ОЧКИ И СПРОСИТЬ РЕБЯТА, А СХЕМА ТОЧНО РАБОЧАЯ?
Dialogue: 0,0:03:13.88,0:03:16.20,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЧТО ДАЖЕ ПО УЖЕ ОБЕЩАННОЙ ПОМОЩИ
Dialogue: 0,0:03:16.20,0:03:18.76,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ ДЫРКИ. ПО ДАННЫМ POLITICO,
Dialogue: 0,0:03:19.00,0:03:22.04,Caption,,0,0,0,,СТРАНАМ НАТО НЕ ХВАТАЕТ ОКОЛО СЕМИ МИЛЛИАРДОВ ЕВРО
Dialogue: 0,0:03:22.04,0:03:26.76,Caption,,0,0,0,,НА ВОЕННУЮ ПОМОЩЬ УКРАИНЕ, ПРЕДУСМОТРЕННУЮ НА ЭТОТ ГОД. СЕМЬ МИЛЛИАРДОВ ВРОДЕ
Dialogue: 0,0:03:26.84,0:03:29.88,Caption,,0,0,0,,МЕЛОЧЬ НА ФОНЕ ДВУХСОТ. НО ЭТО ОЧЕНЬ ПОКАЗАТЕЛЬНАЯ
Dialogue: 0,0:03:29.88,0:03:35.29,Caption,,0,0,0,,МЕЛОЧЬ. ПОТОМУ ЧТО ОДНО ДЕЛО ТОРЖЕСТВЕННО ОБЪЯВИТЬ ПОМОЩЬ,
Dialogue: 0,0:03:35.54,0:03:37.69,Caption,,0,0,0,,ДРУГОЕ ДЕЛО ПОТОМ НАЙТИ ЖИВЫЕ ДЕНЬГИ,
Dialogue: 0,0:03:37.92,0:03:42.57,Caption,,0,0,0,,КУПИТЬ НУЖНОЕ ОРУЖИЕ, ПРОИЗВЕСТИ ЕГО И ДОВЕЗТИ. И ТУТ СНОВА ВОЗНИКАЕТ
Dialogue: 0,0:03:42.57,0:03:46.09,Caption,,0,0,0,,ВОПРОС, КОТОРЫЙ ОЧЕНЬ НЕ ЛЮБЯТ. А БЕЗ СОЕДИНЁННЫХ ШТАТОВ
Dialogue: 0,0:03:46.09,0:03:50.17,Caption,,0,0,0,,ВЫ ЭТО КАК СОБРАЛИСЬ ДЕЛАТЬ? ЕСЛИ ВАШИНГТОН НАЧИНАЕТ ДУМАТЬ НЕ О ТОМ,
Dialogue: 0,0:03:50.33,0:03:52.25,Caption,,0,0,0,,КАК ЕЩЁ СИЛЬНЕЕ ДАВИТЬ НА МОСКВУ,
Dialogue: 0,0:03:52.42,0:03:54.41,Caption,,0,0,0,,А О ТОМ, КАК ЗАКОНЧИТЬ КОНФЛИКТ,
Dialogue: 0,0:03:54.73,0:03:57.21,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ПРИДЁТСЯ ОТВЕЧАТЬ НА ОЧЕНЬ НЕПРИЯТНЫЙ
Dialogue: 0,0:03:57.21,0:03:59.29,Caption,,0,0,0,,ВОПРОС ВЫ ДЕЙСТВИТЕЛЬНО ГОТОВЫ ТАЩИТЬ ЭТУ
Dialogue: 0,0:03:59.29,0:04:03.53,Caption,,0,0,0,,КОНСТРУКЦИЮ ДАЛЬШЕ САМИ? И ТУТ КАК РАЗ ПОЯВЛЯЕТСЯ ДОНАЛЬД ТРАМП. В
Dialogue: 0,0:04:03.61,0:04:06.01,Caption,,0,0,0,,ИНТЕРВЬЮ CBS ОН ОПЯТЬ ПРОШЁЛСЯ ПО ЗЕЛЕНСКОМУ И
Dialogue: 0,0:04:06.01,0:04:09.05,Caption,,0,0,0,,ВСПОМНИЛ, ЧТО В САМОМ НАЧАЛЕ ОТНОШЕНИЙ С РОССИЕЙ БЫЛО
Dialogue: 0,0:04:09.05,0:04:12.01,Caption,,0,0,0,,ПРОЯВЛЕНО ОГРОМНОЕ НЕУВАЖЕНИЕ. ТАМ ЖЕ ОН СНОВА
Dialogue: 0,0:04:12.01,0:04:14.09,Caption,,0,0,0,,ГОВОРИЛ О СКОРОМ СОГЛАШЕНИИ И О ТОМ,
Dialogue: 0,0:04:14.25,0:04:16.89,Caption,,0,0,0,,ЧТО УКРАИНА ПОСЛЕ НЕГО БУДЕТ ИМЕТЬ НЕМНОГО ДРУГУЮ
Dialogue: 0,0:04:16.89,0:04:20.57,Caption,,0,0,0,,ФОРМУ. МОЖНО СПОРИТЬ С ТРАМПОМ СКОЛЬКО УГОДНО. ОН САМ
Dialogue: 0,0:04:20.65,0:04:22.73,Caption,,0,0,0,,ЗА ПОСЛЕДНИЕ ГОДЫ СТОЛЬКО РАЗ МЕНЯЛ ТОН,
Dialogue: 0,0:04:22.99,0:04:25.53,Caption,,0,0,0,,ЧТО РЯДОМ С НИМ ФЛЮГЕР ВЫГЛЯДИТ ЧЕЛОВЕКОМ ТВЁРДЫХ
Dialogue: 0,0:04:25.53,0:04:28.89,Caption,,0,0,0,,УБЕЖДЕНИЙ. НО ВАЖНО ДРУГОЕ. ПРЕЗИДЕНТ СОЕДИНЁННЫХ
Dialogue: 0,0:04:28.89,0:04:31.37,Caption,,0,0,0,,ШТАТОВ УЖЕ НЕ РАЗГОВАРИВАЕТ ЯЗЫКОМ БЕСКОНЕЧНОЙ
Dialogue: 0,0:04:31.37,0:04:34.25,Caption,,0,0,0,,ПОДДЕРЖКИ ДО АБСТРАКТНОЙ ПОБЕДЫ. ОН РАЗГОВАРИВАЕТ
Dialogue: 0,0:04:34.25,0:04:36.97,Caption,,0,0,0,,ЯЗЫКОМ СДЕЛКИ. А ЕВРОПА ПОКА ПРОДОЛЖАЕТ
Dialogue: 0,0:04:36.97,0:04:40.01,Caption,,0,0,0,,РАЗГОВАРИВАТЬ ЯЗЫКОМ СЧЁТА. ЕСЛИ СЧИТАЕТЕ ТАКИЕ
Dialogue: 0,0:04:40.01,0:04:41.93,Caption,,0,0,0,,РАЗБОРЫ ПОЛЕЗНЫМИ, ПОДПИШИТЕСЬ.
Dialogue: 0,0:04:44.12,0:04:47.08,Caption,,0,0,0,,ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ САМАЯ ИНТЕРЕСНАЯ ЧАСТЬ.
Dialogue: 0,0:04:47.48,0:04:50.52,Caption,,0,0,0,,ДЕНЬГИ И ОРУЖИЕ ЭТО ТОЛЬКО ПОВЕРХНОСТЬ. ПОД НИМИ
Dialogue: 0,0:04:50.52,0:04:52.68,Caption,,0,0,0,,УЖЕ ИДЁТ ПОЛИТИЧЕСКАЯ ДРАКА ЗА ТО,
Dialogue: 0,0:04:52.92,0:04:55.40,Caption,,0,0,0,,КАКИМ ВООБЩЕ ДОЛЖЕН БЫТЬ СЛЕДУЮЩИЙ КУРС ЕВРОПЫ.
Dialogue: 0,0:04:55.76,0:04:58.68,Caption,,0,0,0,,ПОСМОТРИТЕ НА ФРИДРИХА МЕРЦА. ГЕРМАНИЯ ОСТАЁТСЯ
Dialogue: 0,0:04:58.68,0:05:01.88,Caption,,0,0,0,,ОДНИМ ИЗ ГЛАВНЫХ СТОРОННИКОВ ПОДДЕРЖКИ КИЕВА. САМ
Dialogue: 0,0:05:01.96,0:05:06.36,Caption,,0,0,0,,МЕРЦ ЕЩЁ В ОКТЯБРЕ ГОВОРИЛ, ЧТО ПОМОЩЬ ПРИДЁТСЯ УВЕЛИЧИВАТЬ. И ОДНОВРЕМЕННО
Dialogue: 0,0:05:06.44,0:05:09.64,Caption,,0,0,0,,ТЕПЕРЬ ГОВОРИТ, ЧТО ЕСЛИ ПУТИН ПРИЕДЕТ НА САММИТ ДВАДЦАТКИ В
Dialogue: 0,0:05:09.64,0:05:13.96,Caption,,0,0,0,,МАЙАМИ, ОН НЕ СТАНЕТ ИЗБЕГАТЬ РАЗГОВОРА. ОПА. ТАК
Dialogue: 0,0:05:13.96,0:05:16.04,Caption,,0,0,0,,РАЗГОВАРИВАТЬ ВСЁ ТАКИ МОЖНО? НЕТ,
Dialogue: 0,0:05:16.44,0:05:18.68,Caption,,0,0,0,,ЭТО ЕЩЁ НЕ РАЗВОРОТ ГЕРМАНИИ НА СТО ВОСЕМЬДЕСЯТ
Dialogue: 0,0:05:18.68,0:05:21.48,Caption,,0,0,0,,ГРАДУСОВ. МЕРЦ НЕ СТАЛ СТОРОННИКОМ КРЕМЛЯ,
Dialogue: 0,0:05:21.81,0:05:24.52,Caption,,0,0,0,,И БЕРЛИН НЕ ОТКАЗАЛСЯ ОТ ПОМОЩИ УКРАИНЕ. НО
Dialogue: 0,0:05:24.52,0:05:27.40,Caption,,0,0,0,,САМА ФОРМУЛА УЖЕ ДРУГАЯ. РАНЬШЕ РАЗГОВОР С МОСКВОЙ
Dialogue: 0,0:05:27.40,0:05:30.20,Caption,,0,0,0,,ЧАСТО ВЫГЛЯДЕЛ КАК ПОЛИТИЧЕСКАЯ ЗАРАЗА ПРИКОСНУЛСЯ И
Dialogue: 0,0:05:30.28,0:05:34.52,Caption,,0,0,0,,ПОТОМ НЕДЕЛЮ ОБЪЯСНЯЕШЬ, ЧТО ТЫ НЕ ЗАРАЗИЛСЯ. ТЕПЕРЬ КАНЦЛЕР ГЕРМАНИИ
Dialogue: 0,0:05:34.52,0:05:37.00,Caption,,0,0,0,,СПОКОЙНО ГОВОРИТ ПОЛИТИКА ВООБЩЕ ТО И СОСТОИТ В
Dialogue: 0,0:05:37.08,0:05:38.84,Caption,,0,0,0,,ТОМ, ЧТОБЫ РАЗГОВАРИВАТЬ С ЛЮДЬМИ,
Dialogue: 0,0:05:39.08,0:05:41.88,Caption,,0,0,0,,С КОТОРЫМИ У ТЕБЯ ПРОТИВОПОЛОЖНЫЕ ВЗГЛЯДЫ. СПАСИБО.
Dialogue: 0,0:05:42.16,0:05:45.16,Caption,,0,0,0,,ЧЕЛОВЕЧЕСТВО СНОВА ОТКРЫЛО ТЕЛЕФОН. И РЯДОМ С МЕРЦЕМ
Dialogue: 0,0:05:45.16,0:05:48.28,Caption,,0,0,0,,СТОИТ СОВСЕМ ДРУГАЯ ГЕРМАНИЯ. АДГ ПРЕДЛАГАЕТ УЖЕ НЕ
Dialogue: 0,0:05:48.36,0:05:52.04,Caption,,0,0,0,,ПРОСТО ПОГОВОРИТЬ, А ОРГАНИЗОВАТЬ ВЕСНОЙ СЛЕДУЮЩЕГО ГОДА ВСТРЕЧУ
Dialogue: 0,0:05:52.04,0:05:56.12,Caption,,0,0,0,,ГЕРМАНИИ, РОССИИ И СОЕДИНЁННЫХ ШТАТОВ В АБУ ДАБИ. ПРИЧЁМ
Dialogue: 0,0:05:56.20,0:06:01.28,Caption,,0,0,0,,БЕЗ УКРАИНЫ. МАРКУС ФРОНМАЙЕР ГОВОРИТ О ВОССТАНОВЛЕНИИ
Dialogue: 0,0:06:01.28,0:06:03.12,Caption,,0,0,0,,ЭКОНОМИЧЕСКИХ ОТНОШЕНИЙ С РОССИЕЙ,
Dialogue: 0,0:06:03.36,0:06:07.36,Caption,,0,0,0,,СНЯТИИ САНКЦИЙ, ЭНЕРГЕТИКЕ И ДАЖЕ ВОЗВРАЩЕНИИ К ТЕМЕ СЕВЕРНОГО
Dialogue: 0,0:06:07.36,0:06:09.76,Caption,,0,0,0,,ПОТОКА. ВОТ ЭТО УЖЕ НЕ РАЗНИЦА В ОТТЕНКАХ
Dialogue: 0,0:06:09.84,0:06:12.88,Caption,,0,0,0,,СЕРОГО. ЭТО ДВА РАЗНЫХ МАРШРУТА. ОДИН МАРШРУТ
Dialogue: 0,0:06:12.88,0:06:15.28,Caption,,0,0,0,,ГОВОРИТ ЕЩЁ ДЕНЬГИ, ЕЩЁ ОРУЖИЕ,
Dialogue: 0,0:06:15.52,0:06:19.28,Caption,,0,0,0,,ЕЩЁ ДАВЛЕНИЕ, ЕЩЁ САНКЦИИ. ДРУГОЙ ГОВОРИТ ХВАТИТ,
Dialogue: 0,0:06:19.47,0:06:21.44,Caption,,0,0,0,,НАДО ВОССТАНАВЛИВАТЬ ОТНОШЕНИЯ И САДИТЬСЯ
Dialogue: 0,0:06:21.44,0:06:24.08,Caption,,0,0,0,,РАЗГОВАРИВАТЬ. И САМОЕ НЕУДОБНОЕ ДЛЯ НЫНЕШНЕГО
Dialogue: 0,0:06:24.08,0:06:26.00,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО ЦЕНТРА ГЕРМАНИИ В ТОМ,
Dialogue: 0,0:06:26.24,0:06:28.88,Caption,,0,0,0,,ЧТО АДГ УЖЕ НЕЛЬЗЯ ИЗОБРАЖАТЬ КАК ТРЁХ ЧЕЛОВЕК
Dialogue: 0,0:06:28.96,0:06:31.28,Caption,,0,0,0,,В ПОДВАЛЕ С ФЛАГОМ И ПЛОХИМ ИНТЕРНЕТОМ. ПО
Dialogue: 0,0:06:31.28,0:06:33.04,Caption,,0,0,0,,ДАННЫМ, КОТОРЫЕ ПРИВОДИТ LE MONDE,
Dialogue: 0,0:06:33.36,0:06:36.08,Caption,,0,0,0,,ПАРТИЯ НАХОДИТСЯ НА ПЕРВОМ МЕСТЕ В ОБЩЕНАЦИОНАЛЬНЫХ
Dialogue: 0,0:06:36.08,0:06:39.04,Caption,,0,0,0,,ОПРОСАХ С РЕЗУЛЬТАТАМИ ПРИМЕРНО ОТ ДВАДЦАТИ СЕМИ ДО
Dialogue: 0,0:06:39.04,0:06:43.20,Caption,,0,0,0,,ТРИДЦАТИ ПРОЦЕНТОВ, ТОГДА КАК БЛОК ХДС И ХСС МЕРЦА ПОЛУЧАЕТ
Dialogue: 0,0:06:43.28,0:06:45.76,Caption,,0,0,0,,В ТЕХ ЖЕ ЗАМЕРАХ ПРИМЕРНО ОТ ВОСЕМНАДЦАТИ ДО
Dialogue: 0,0:06:45.76,0:06:48.40,Caption,,0,0,0,,ДВАДЦАТИ ТРЁХ. НО ПЕРВОЕ МЕСТО В ОПРОСАХ ЕЩЁ
Dialogue: 0,0:06:48.48,0:06:50.96,Caption,,0,0,0,,НЕ ДАЁТ КЛЮЧ ОТ КАНЦЕЛЯРИИ. В ГЕРМАНИИ ВСЁ
Dialogue: 0,0:06:51.04,0:06:53.04,Caption,,0,0,0,,ЕЩЁ ДЕЙСТВУЕТ ПОЛИТИЧЕСКИЙ БРАНДМАУЭР,
Dialogue: 0,0:06:53.28,0:06:55.92,Caption,,0,0,0,,ДРУГИЕ КРУПНЫЕ ПАРТИИ ОТКАЗЫВАЮТСЯ СОТРУДНИЧАТЬ С
Dialogue: 0,0:06:56.00,0:06:59.76,Caption,,0,0,0,,АДГ. И САМ ФАКТ НИКУДА НЕ ДЕНЕШЬ. ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:06:59.84,0:07:02.24,Caption,,0,0,0,,ИЗБИРАТЕЛЕЙ ПОДДЕРЖИВАЕТ ПОЛИТИЧЕСКУЮ СИЛУ,
Dialogue: 0,0:07:02.55,0:07:04.72,Caption,,0,0,0,,КОТОРАЯ ПРЕДЛАГАЕТ СОВЕРШЕННО ДРУГОЙ КУРС В
Dialogue: 0,0:07:04.72,0:07:07.76,Caption,,0,0,0,,ОТНОШЕНИИ РОССИИ И УКРАИНЫ. И ТУТ НАЧИНАЕТСЯ
Dialogue: 0,0:07:07.76,0:07:14.12,Caption,,0,0,0,,РАЗГОВОР УЖЕ НЕ ПРО КИЕВ. ТУТ НАЧИНАЕТСЯ РАЗГОВОР ПРО ВЛАСТЬ В САМОЙ ЕВРОПЕ.
Dialogue: 0,0:07:14.60,0:07:17.24,Caption,,0,0,0,,ПОТОМУ ЧТО ВЛАСТЬ ВООБЩЕ ШТУКА УДИВИТЕЛЬНАЯ. ВСЕ
Dialogue: 0,0:07:17.24,0:07:21.56,Caption,,0,0,0,,ОЧЕНЬ ЛЮБЯТ СМЕНЯЕМОСТЬ, ПОКА МЕНЯТЬ СОБИРАЮТСЯ НЕ ИХ. КОГДА ПРАВЫЕ ГДЕ
Dialogue: 0,0:07:21.64,0:07:23.64,Caption,,0,0,0,,ТО ДАЛЕКО И НАБИРАЮТ ДЕСЯТЬ ПРОЦЕНТОВ,
Dialogue: 0,0:07:23.80,0:07:26.44,Caption,,0,0,0,,МОЖНО КРАСИВО РАССУЖДАТЬ О ДЕМОКРАТИИ. КОГДА ОНИ
Dialogue: 0,0:07:26.44,0:07:29.88,Caption,,0,0,0,,ПОДХОДЯТ К ТРИДЦАТИ, ВНЕЗАПНО ПОЯВЛЯЮТСЯ БРАНДМАУЭРЫ,
Dialogue: 0,0:07:30.04,0:07:34.28,Caption,,0,0,0,,САНИТАРНЫЕ КОРДОНЫ, ЗАПРЕТЫ НА СОТРУДНИЧЕСТВО И ДЛИННЫЕ ОБЪЯСНЕНИЯ,
Dialogue: 0,0:07:34.39,0:07:36.52,Caption,,0,0,0,,ПОЧЕМУ ГОЛОС ИЗБИРАТЕЛЯ ОЧЕНЬ ВАЖЕН,
Dialogue: 0,0:07:36.76,0:07:39.24,Caption,,0,0,0,,НО ПРАВИТЕЛЬСТВО ВСЁ РАВНО ЛУЧШЕ СОБИРАТЬ БЕЗ ТЕХ,
Dialogue: 0,0:07:39.56,0:07:42.20,Caption,,0,0,0,,ЗА КОГО ОН ПРОГОЛОСОВАЛ. И ЗДЕСЬ РАБОТАЕТ ТОТ
Dialogue: 0,0:07:42.20,0:07:44.68,Caption,,0,0,0,,ЖЕ СТАРЫЙ ЧЕЛОВЕЧЕСКИЙ ЗАКОН ВЛАСТЬ ДОБРОВОЛЬНО
Dialogue: 0,0:07:44.68,0:07:47.16,Caption,,0,0,0,,ОТДАВАТЬ НИКТО НЕ ЛЮБИТ. РАССЧИТЫВАТЬ,
Dialogue: 0,0:07:47.40,0:07:49.96,Caption,,0,0,0,,ЧТО ОДНАЖДЫ ПУТИН ПРОСТО ИСЧЕЗНЕТ ИЗ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:07:50.04,0:07:52.52,Caption,,0,0,0,,КОНСТРУКЦИИ И НА СЛЕДУЮЩИЙ ДЕНЬ РОССИЯ ПРОСНЁТСЯ
Dialogue: 0,0:07:52.52,0:07:55.16,Caption,,0,0,0,,СОВЕРШЕННО ДРУГОЙ СТРАНОЙ, ЭТО ДЕТСКИЙ САД.
Dialogue: 0,0:07:55.72,0:07:58.44,Caption,,0,0,0,,ВОКРУГ РОССИЙСКОЙ ВЛАСТИ ЗА ЧЕТВЕРТЬ ВЕКА ВЫСТРОЕНА
Dialogue: 0,0:07:58.44,0:08:01.08,Caption,,0,0,0,,СИСТЕМА СИЛОВЫХ СТРУКТУР, БЮРОКРАТИИ,
Dialogue: 0,0:08:01.32,0:08:03.16,Caption,,0,0,0,,КРУПНЫХ ГОСУДАРСТВЕННЫХ КОМПАНИЙ,
Dialogue: 0,0:08:03.34,0:08:08.52,Caption,,0,0,0,,АРМИИ, СПЕЦСЛУЖБ И ЛЮДЕЙ, ЧЬИ ИНТЕРЕСЫ НАПРЯМУЮ ЗАВЯЗАНЫ НА СОХРАНЕНИЕ ЭТОЙ
Dialogue: 0,0:08:08.52,0:08:11.00,Caption,,0,0,0,,КОНСТРУКЦИИ. НЕ БУДЕТ ОДНОГО ПУТИНА,
Dialogue: 0,0:08:11.08,0:08:13.96,Caption,,0,0,0,,САМА СИСТЕМА ОТ ЭТОГО НЕ ИСПАРИТСЯ. ПОЯВИТСЯ
Dialogue: 0,0:08:13.96,0:08:16.92,Caption,,0,0,0,,СЛЕДУЮЩИЙ ЧЕЛОВЕК ИЗ ЭТОЙ СИСТЕМЫ. ХОТИТЕ НАЗЫВАЙТЕ
Dialogue: 0,0:08:17.00,0:08:19.80,Caption,,0,0,0,,ЕГО ПУТИН ДВА НОЛЬ, ХОТИТЕ ПУТИН ТРИ НОЛЬ.
Dialogue: 0,0:08:22.09,0:08:24.57,Caption,,0,0,0,,НО ЖДАТЬ НОВОГО ЕЛЬЦИНА, КОТОРЫЙ ПРИДЁТ,
Dialogue: 0,0:08:24.66,0:08:26.49,Caption,,0,0,0,,РАСПАХНЁТ ДВЕРИ И СКАЖЕТ РЕБЯТА,
Dialogue: 0,0:08:26.71,0:08:30.81,Caption,,0,0,0,,ДАВАЙТЕ ВСЁ НАЧНЁМ СНАЧАЛА, ЭТО УЖЕ ДАЖЕ НЕ СТРАТЕГИЯ. ЭТО ВЕРА В
Dialogue: 0,0:08:30.89,0:08:33.93,Caption,,0,0,0,,ДЕДА МОРОЗА С ЯДЕРНЫМ ЧЕМОДАНЧИКОМ. У РОССИИ БЫЛ
Dialogue: 0,0:08:33.93,0:08:36.73,Caption,,0,0,0,,ОПЫТ РАСПАДА СОВЕТСКОГО СОЮЗА. ДЛЯ НЫНЕШНЕЙ
Dialogue: 0,0:08:36.73,0:08:38.97,Caption,,0,0,0,,РОССИЙСКОЙ ЭЛИТЫ ЭТО НЕ УЧЕБНИК ИСТОРИИ,
Dialogue: 0,0:08:39.13,0:08:41.77,Caption,,0,0,0,,КОТОРЫЙ ПЫЛИТСЯ НА ПОЛКЕ. ЭТО ОДИН ИЗ ГЛАВНЫХ
Dialogue: 0,0:08:41.77,0:08:44.41,Caption,,0,0,0,,ПОЛИТИЧЕСКИХ СТРАХОВ И ОДИН ИЗ ГЛАВНЫХ УРОКОВ.
Dialogue: 0,0:08:44.80,0:08:47.21,Caption,,0,0,0,,ВЛАСТЬ В РОССИИ ВЗЯЛИ ВЫХОДЦЫ ИЗ КГБ И
Dialogue: 0,0:08:47.29,0:08:50.01,Caption,,0,0,0,,ДРУГИХ СИЛОВЫХ СТРУКТУР. ВЫСТРОИЛИ СИСТЕМУ,
Dialogue: 0,0:08:50.10,0:08:53.29,Caption,,0,0,0,,КОТОРАЯ ДЕРЖИТСЯ НЕ НА ОДНОМ ЧЕЛОВЕКЕ. И ДОБРОВОЛЬНО
Dialogue: 0,0:08:53.29,0:08:56.17,Caption,,0,0,0,,ЭТУ ВЛАСТЬ ОТДАВАТЬ НЕ СОБИРАЮТСЯ. АВТОРСКИЙ РАСЧЁТ
Dialogue: 0,0:08:56.25,0:08:57.85,Caption,,0,0,0,,ЗДЕСЬ ПРОСТОЙ НЕ БУДЕТ ПУТИНА,
Dialogue: 0,0:08:58.01,0:09:01.13,Caption,,0,0,0,,ПОЯВИТСЯ СЛЕДУЮЩИЙ ЧЕЛОВЕК ИЗ ТОЙ ЖЕ СИСТЕМЫ. ХОТИТЕ
Dialogue: 0,0:09:01.13,0:09:06.09,Caption,,0,0,0,,ПЛАЧЬТЕ, ХОТИТЕ СМЕЙТЕСЬ, НО ИМЕННО ТАК УСТРОЕНА ЭТА КОНСТРУКЦИЯ. ВЛАСТЬ
Dialogue: 0,0:09:06.09,0:09:08.09,Caption,,0,0,0,,ДОБРОВОЛЬНО НЕ ОТДАЮТ. НИ ТАМ,
Dialogue: 0,0:09:08.23,0:09:11.37,Caption,,0,0,0,,НИ ЗДЕСЬ. ПОЭТОМУ ЕСЛИ ЕВРОПЕЙСКАЯ СТРАТЕГИЯ ДО СИХ
Dialogue: 0,0:09:11.37,0:09:13.85,Caption,,0,0,0,,ПОР В ГЛУБИНЕ ДУШИ РАССЧИТЫВАЕТ НА ЧУДО ВНУТРИ
Dialogue: 0,0:09:13.85,0:09:16.25,Caption,,0,0,0,,РОССИИ, ХОТЕЛОСЬ БЫ ХОТЯ БЫ УСЛЫШАТЬ,
Dialogue: 0,0:09:16.41,0:09:19.45,Caption,,0,0,0,,НА КАКОЕ ИМЕННО ЧУДО. ЭКОНОМИЧЕСКИЙ ОБВАЛ НЕ
Dialogue: 0,0:09:19.45,0:09:22.73,Caption,,0,0,0,,СЛУЧИЛСЯ. БЫСТРАЯ ПОЛИТИЧЕСКАЯ ДЕСТАБИЛИЗАЦИЯ НЕ
Dialogue: 0,0:09:22.73,0:09:25.69,Caption,,0,0,0,,СЛУЧИЛАСЬ. ВОЕННОГО РЕШЕНИЯ БЕЗ ПРЯМОГО УЧАСТИЯ
Dialogue: 0,0:09:25.69,0:09:28.89,Caption,,0,0,0,,КРУПНЕЙШЕЙ СИЛЫ НАТО ТОЖЕ НЕ ВИДНО. А СОЕДИНЁННЫЕ
Dialogue: 0,0:09:28.97,0:09:31.21,Caption,,0,0,0,,ШТАТЫ ПРИ ТРАМПЕ УЖЕ САМИ ИЩУТ ПУТЬ К
Dialogue: 0,0:09:31.21,0:09:34.25,Caption,,0,0,0,,ДОГОВОРЁННОСТИ. ТАК ГДЕ ВАШ СВЕТ В КОНЦЕ ТУННЕЛЯ?
Dialogue: 0,0:09:36.46,0:09:41.50,Caption,,0,0,0,,И ПОКА ЭТОТ ОТВЕТ ИЩУТ, СЧЁТ ПРОДОЛЖАЕТ РАСТИ. СОРОК С ЛИШНИМ МИЛЛИАРДОВ
Dialogue: 0,0:09:41.50,0:09:44.70,Caption,,0,0,0,,НОВЫХ СОВМЕСТНЫХ КРЕДИТОВ. БОЛЕЕ ДВУХСОТ МИЛЛИАРДОВ
Dialogue: 0,0:09:44.70,0:09:47.58,Caption,,0,0,0,,ОБЩИХ ОБЯЗАТЕЛЬСТВ ПО ПОМОЩИ. СЕМЬ МИЛЛИАРДОВ
Dialogue: 0,0:09:47.58,0:09:50.22,Caption,,0,0,0,,НЕДОСТАЮЩЕГО ВОЕННОГО ФИНАНСИРОВАНИЯ. ПЛЮС
Dialogue: 0,0:09:50.22,0:09:53.02,Caption,,0,0,0,,НАЦИОНАЛЬНЫЕ БЮДЖЕТЫ, ОБОРОННЫЕ РАСХОДЫ,
Dialogue: 0,0:09:53.11,0:09:55.98,Caption,,0,0,0,,СУБСИДИИ ПРОМЫШЛЕННОСТИ, ДОРОГАЯ ЭНЕРГИЯ,
Dialogue: 0,0:09:56.14,0:09:59.10,Caption,,0,0,0,,СОЦИАЛЬНЫЕ ОБЯЗАТЕЛЬСТВА. А ЭКОНОМИКА ЕВРОПЫ ПРИ
Dialogue: 0,0:09:59.18,0:10:01.66,Caption,,0,0,0,,ЭТОМ НЕ ЖИВЁТ В ВАКУУМЕ. В ОКТЯБРЕ РОСТ
Dialogue: 0,0:10:01.66,0:10:04.22,Caption,,0,0,0,,ЕВРОЗОНЫ ЗАМЕДЛИЛСЯ. В ГЕРМАНИИ ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:10:04.30,0:10:08.30,Caption,,0,0,0,,ОСТАЁТСЯ НА НИЗКОМ УРОВНЕ, ДАЖЕ КОГДА ОТДЕЛЬНЫЙ МЕСЯЦ ПОКАЗЫВАЕТ НЕБОЛЬШОЙ
Dialogue: 0,0:10:08.30,0:10:11.34,Caption,,0,0,0,,ПЛЮС. АВТОПРОМ ПЕРЕЖИВАЕТ ТЯЖЁЛУЮ ПЕРЕСТРОЙКУ И
Dialogue: 0,0:10:11.42,0:10:14.14,Caption,,0,0,0,,КОНКУРЕНЦИЮ С КИТАЕМ. ЭНЕРГИЯ СНОВА ДАВИТ НА
Dialogue: 0,0:10:14.14,0:10:17.26,Caption,,0,0,0,,ИЗДЕРЖКИ. В ДРУГИХ ЕВРОПЕЙСКИХ СТРАНАХ ПРАВИТЕЛЬСТВА
Dialogue: 0,0:10:17.34,0:10:20.06,Caption,,0,0,0,,ПРЯМО ГОВОРЯТ О НЕОБХОДИМОСТИ СДЕРЖИВАТЬ РАСХОДЫ НА
Dialogue: 0,0:10:20.06,0:10:22.94,Caption,,0,0,0,,СОЦИАЛЬНЫЕ ВЫПЛАТЫ. И ВОТ ОБЫЧНЫЙ ЧЕЛОВЕК СМОТРИТ НА
Dialogue: 0,0:10:22.94,0:10:25.34,Caption,,0,0,0,,ВСЁ ЭТО И ИМЕЕТ ПОЛНОЕ ПРАВО СПРОСИТЬ А
Dialogue: 0,0:10:25.34,0:10:28.70,Caption,,0,0,0,,Я ЗДЕСЬ ЗА ЧТО ПЛАЧУ? ЕСЛИ ВЫ БЕРЁТЕ КРЕДИТ НА ДОМ,
Dialogue: 0,0:10:28.90,0:10:31.98,Caption,,0,0,0,,ВЫ ПОНИМАЕТЕ, ЧТО В КОНЦЕ У ВАС БУДЕТ ДОМ. ЕСЛИ
Dialogue: 0,0:10:32.06,0:10:35.98,Caption,,0,0,0,,БЕРЁТЕ КРЕДИТ НА МАШИНУ, В КОНЦЕ БУДЕТ МАШИНА. А ЕСЛИ ВЫ ЗАНИМАЕТЕ
Dialogue: 0,0:10:35.98,0:10:39.02,Caption,,0,0,0,,ДЕСЯТКИ МИЛЛИАРДОВ НА ВОЙНУ, ГДЕ ТОТ МОМЕНТ,
Dialogue: 0,0:10:39.26,0:10:41.42,Caption,,0,0,0,,КОГДА ВЫ СМОЖЕТЕ ПОКАЗАТЬ ЧЕЛОВЕКУ РЕЗУЛЬТАТ И
Dialogue: 0,0:10:41.50,0:10:43.66,Caption,,0,0,0,,СКАЗАТЬ ВОТ РАДИ ЭТОГО МЫ ЗАЛЕЗЛИ В ДОЛГ?
Dialogue: 0,0:10:43.83,0:10:46.06,Caption,,0,0,0,,СНАЧАЛА САНКЦИИ ДОЛЖНЫ БЫЛИ СЛОМАТЬ РОССИЮ.
Dialogue: 0,0:10:48.35,0:10:50.91,Caption,,0,0,0,,ПОТОМ ПОМОЩЬ ДОЛЖНА БЫЛА ИЗМЕНИТЬ ПОЛОЖЕНИЕ НА ПОЛЕ
Dialogue: 0,0:10:50.99,0:10:53.87,Caption,,0,0,0,,БОЯ. ПОТОМ НУЖНО БЫЛО ПРОДЕРЖАТЬСЯ ЕЩЁ НЕМНОГО.
Dialogue: 0,0:10:54.26,0:10:57.23,Caption,,0,0,0,,ПОТОМ ДОЖДАТЬСЯ НОВОГО ОРУЖИЯ. ПОТОМ ЕЩЁ ОДНОГО
Dialogue: 0,0:10:57.23,0:11:00.19,Caption,,0,0,0,,ПАКЕТА. ПОТОМ ЕЩЁ ОДНОГО ГОДА. ЭТО УЖЕ НЕ
Dialogue: 0,0:11:00.19,0:11:02.99,Caption,,0,0,0,,СВЕТ В КОНЦЕ ТУННЕЛЯ. ЭТО ЛАМПОЧКА НА ПАЛКЕ,
Dialogue: 0,0:11:03.23,0:11:05.39,Caption,,0,0,0,,КОТОРУЮ КТО ТО ВСЁ ВРЕМЯ НЕСЁТ ПЕРЕД ВАМИ
Dialogue: 0,0:11:05.47,0:11:08.19,Caption,,0,0,0,,НА ДЕСЯТЬ МЕТРОВ ДАЛЬШЕ. И САМОЕ ОПАСНОЕ ЗДЕСЬ
Dialogue: 0,0:11:08.19,0:11:10.83,Caption,,0,0,0,,ДАЖЕ НЕ ДЕНЬГИ. ЕСЛИ КУРС СОСТОИТ ТОЛЬКО ИЗ
Dialogue: 0,0:11:10.83,0:11:13.55,Caption,,0,0,0,,ПРОДОЛЖЕНИЯ ДАВЛЕНИЯ, НАДО ЧЕСТНО ОТВЕТИТЬ,
Dialogue: 0,0:11:13.76,0:11:16.91,Caption,,0,0,0,,ГДЕ ПРОХОДИТ ГРАНИЦА РИСКА. ЕВРОПА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:11:16.91,0:11:19.07,Caption,,0,0,0,,ГОТОВА ДОВЕСТИ ПРОТИВОСТОЯНИЕ ДО ПРЯМОГО
Dialogue: 0,0:11:19.07,0:11:22.03,Caption,,0,0,0,,СТОЛКНОВЕНИЯ РОССИИ И НАТО? РАДИ КАКОЙ ЦЕЛИ?
Dialogue: 0,0:11:22.43,0:11:24.99,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ОДНАЖДЫ БОЛЬШАЯ ВОЙНА ПРИХОДИТ УЖЕ
Dialogue: 0,0:11:25.07,0:11:29.39,Caption,,0,0,0,,НА ЕВРОПЕЙСКУЮ ТЕРРИТОРИЮ, БУХГАЛТЕРИЯ ЗАКАНЧИВАЕТСЯ МГНОВЕННО. ТАМ УЖЕ НЕ
Dialogue: 0,0:11:29.39,0:11:32.35,Caption,,0,0,0,,ОБСУЖДАЮТ РАЗМЕР ПОСОБИЯ И СТОИМОСТЬ ГАЗА. ТАМ
Dialogue: 0,0:11:32.35,0:11:35.79,Caption,,0,0,0,,ПРОИСХОДИТ ТО, ЧТО СЕЙЧАС ПРОИСХОДИТ НА УКРАИНЕ РАЗРУШЕННАЯ
Dialogue: 0,0:11:35.79,0:11:38.83,Caption,,0,0,0,,ИНФРАСТРУКТУРА, ЭВАКУАЦИЯ, ПОГИБШИЕ,
Dialogue: 0,0:11:39.07,0:11:42.99,Caption,,0,0,0,,МИЛЛИОНЫ ЛЮДЕЙ, У КОТОРЫХ ВСЯ ГЕОПОЛИТИКА ПОМЕЩАЕТСЯ В ОДИН ВОПРОС
Dialogue: 0,0:11:42.99,0:11:45.79,Caption,,0,0,0,,ГДЕ СЕГОДНЯ БУДЕТ БЕЗОПАСНО СПАТЬ. А ОБЫЧНОМУ
Dialogue: 0,0:11:45.79,0:11:50.11,Caption,,0,0,0,,ЧЕЛОВЕКУ КУДА? ВОТ ПОЭТОМУ ВОПРОС О КОНЕЧНОЙ ЦЕЛИ НЕ РИТОРИЧЕСКИЙ.
Dialogue: 0,0:11:50.27,0:11:53.47,Caption,,0,0,0,,ОН ГЛАВНЫЙ. ЕСЛИ ПОБЕДА ОЗНАЧАЕТ ДОЙТИ ДО МОСКВЫ,
Dialogue: 0,0:11:53.62,0:11:56.03,Caption,,0,0,0,,СКАЖИТЕ ЭТО ЛЮДЯМ. ЕСЛИ ДО УРАЛА,
Dialogue: 0,0:11:56.11,0:11:59.39,Caption,,0,0,0,,ТОЖЕ СКАЖИТЕ. ЕСЛИ ЦЕЛЬ В СМЕНЕ РОССИЙСКОГО РЕЖИМА,
Dialogue: 0,0:11:59.53,0:12:03.99,Caption,,0,0,0,,ОБЪЯСНИТЕ МЕХАНИЗМ. ЕСЛИ ЦЕЛЬ В ТОМ,
Dialogue: 0,0:12:04.20,0:12:07.03,Caption,,0,0,0,,ЧТОБЫ ЗАСТАВИТЬ МОСКВУ ПРИНЯТЬ ОПРЕДЕЛЁННЫЕ УСЛОВИЯ,
Dialogue: 0,0:12:07.27,0:12:09.43,Caption,,0,0,0,,НАЗОВИТЕ ЭТИ УСЛОВИЯ И ОБЪЯСНИТЕ,
Dialogue: 0,0:12:09.67,0:12:12.71,Caption,,0,0,0,,ПОЧЕМУ ЕЩЁ СОРОК МИЛЛИАРДОВ ПРИБЛИЗЯТ ИМЕННО ЭТОТ
Dialogue: 0,0:12:12.71,0:12:18.15,Caption,,0,0,0,,РЕЗУЛЬТАТ. А ЕСЛИ ОТВЕТА НЕТ, ТОГДА ВОЗНИКАЕТ СОВСЕМ НЕПРИЯТНАЯ МЫСЛЬ. ПРОДОЛЖЕНИЕ
Dialogue: 0,0:12:18.15,0:12:20.79,Caption,,0,0,0,,КУРСА УЖЕ СТАЛО ЦЕЛЬЮ САМО ПО СЕБЕ. И
Dialogue: 0,0:12:20.79,0:12:23.11,Caption,,0,0,0,,ВОТ ЗДЕСЬ БУДУЩАЯ БОРЬБА В ЕВРОПЕ БУДЕТ ИДТИ
Dialogue: 0,0:12:23.19,0:12:27.51,Caption,,0,0,0,,НЕ ТОЛЬКО МЕЖДУ ЛЕВЫМИ, ПРАВЫМИ И ЦЕНТРИСТАМИ. ОНА БУДЕТ ИДТИ МЕЖДУ ДВУМЯ
Dialogue: 0,0:12:27.59,0:12:30.47,Caption,,0,0,0,,ОЧЕНЬ ПРОСТЫМИ ВОПРОСАМИ. ПЕРВЫЙ СКОЛЬКО ЕЩЁ НАДО
Dialogue: 0,0:12:30.47,0:12:33.91,Caption,,0,0,0,,ВЛОЖИТЬ, ЧТОБЫ СТАРЫЙ КУРС НАКОНЕЦ ДАЛ ОБЕЩАННЫЙ РЕЗУЛЬТАТ?
Dialogue: 0,0:12:34.16,0:12:37.19,Caption,,0,0,0,,ВТОРОЙ А ЧТО, ЕСЛИ ПОРА МЕНЯТЬ САМ КУРС?
Dialogue: 0,0:12:37.43,0:12:39.91,Caption,,0,0,0,,АДГ УЖЕ ОТВЕЧАЕТ НА ЭТОТ ВОПРОС ПО СВОЕМУ.
Dialogue: 0,0:12:40.23,0:12:43.27,Caption,,0,0,0,,ТРАМП ОТВЕЧАЕТ ПО СВОЕМУ. ДАЖЕ МЕРЦ ОСТОРОЖНО
Dialogue: 0,0:12:43.27,0:12:44.95,Caption,,0,0,0,,ОТКРЫВАЕТ ДВЕРЬ ДЛЯ РАЗГОВОРА,
Dialogue: 0,0:12:45.18,0:12:48.07,Caption,,0,0,0,,КОТОРУЮ ЕЩЁ НЕДАВНО СТАРАЛИСЬ ДЕРЖАТЬ ЗАКРЫТОЙ. И
Dialogue: 0,0:12:48.07,0:12:50.87,Caption,,0,0,0,,ВОТ ЧТО ДЕЙСТВИТЕЛЬНО ИНТЕРЕСНО. ДЕНЬГИ ЕВРОПА ЕЩЁ
Dialogue: 0,0:12:50.95,0:12:53.91,Caption,,0,0,0,,ЗАНЯТЬ СПОСОБНА. ЕЩЁ ОДИН ПАКЕТ СОГЛАСОВАТЬ ТОЖЕ
Dialogue: 0,0:12:53.99,0:12:56.87,Caption,,0,0,0,,СПОСОБНА. ЕЩЁ ОДНУ КРАСИВУЮ ДЕКЛАРАЦИЮ НАПИСАТЬ
Dialogue: 0,0:12:56.87,0:12:59.59,Caption,,0,0,0,,ВООБЩЕ НЕ ПРОБЛЕМА. НО КРЕДИТ МОЖНО ПРОДЛИТЬ.
Dialogue: 0,0:12:59.85,0:13:03.27,Caption,,0,0,0,,САНКЦИИ МОЖНО ПРОДЛИТЬ. ПОМОЩЬ МОЖНО ПРОДЛИТЬ. А
Dialogue: 0,0:13:03.27,0:13:05.75,Caption,,0,0,0,,ОТСУТСТВИЕ КОНЕЧНОЙ ЦЕЛИ ПРОДЛЕВАТЬ БЕСКОНЕЧНО НЕ
Dialogue: 0,0:13:05.75,0:13:07.99,Caption,,0,0,0,,ПОЛУЧИТСЯ. РАНО ИЛИ ПОЗДНО ЧЕЛОВЕК,
Dialogue: 0,0:13:08.23,0:13:10.07,Caption,,0,0,0,,КОТОРЫЙ ОПЛАЧИВАЕТ ВЕСЬ ЭТОТ БАНКЕТ,
Dialogue: 0,0:13:10.24,0:13:12.15,Caption,,0,0,0,,ВСЁ РАВНО СПРОСИТ ОФИЦИАНТА ПРОСТИТЕ,
Dialogue: 0,0:13:12.39,0:13:13.67,Caption,,0,0,0,,А МЫ ВООБЩЕ ЧТО ЗАКАЗЫВАЛИ?
