Dialogue: 0,0:00:00.12,0:00:02.20,Caption,,0,0,0,,УКРАИНСКАЯ ВЛАСТЬ ОБЪЯВИЛА РЕДКИЙ ПРАЗДНИК
Dialogue: 0,0:00:02.20,0:00:04.84,Caption,,0,0,0,,НАСИЛЬСТВЕННОЙ МОБИЛИЗАЦИИ БОЛЬШЕ НЕТ. МОЖНО
Dialogue: 0,0:00:04.84,0:00:08.76,Caption,,0,0,0,,ВЫДОХНУТЬ, УБРАТЬ ТРЕВОЖНЫЕ НОВОСТИ ПОДАЛЬШЕ И ТОРЖЕСТВЕННО
Dialogue: 0,0:00:08.76,0:00:11.56,Caption,,0,0,0,,ВРУЧИТЬ ЧИНОВНИКАМ МЕДАЛЬ ЗА ПОБЕДУ НАД РЕАЛЬНОСТЬЮ.
Dialogue: 0,0:00:12.04,0:00:14.36,Caption,,0,0,0,,ТОЛЬКО МУЖЧИНЫ ПОЧЕМУ ТО НЕ СПЕШАТ ВЫХОДИТЬ ИЗ
Dialogue: 0,0:00:14.36,0:00:17.80,Caption,,0,0,0,,УКРЫТИЙ, СПОСОБЫ ИХ ПОИСКА СТАНОВЯТСЯ ВСЁ ИЗОБРЕТАТЕЛЬНЕЕ,
Dialogue: 0,0:00:18.19,0:00:20.28,Caption,,0,0,0,,А ЗИМОЙ СТРАНУ МОГУТ ПОКИНУТЬ ДО ДВУХ С
Dialogue: 0,0:00:20.28,0:00:22.68,Caption,,0,0,0,,ПОЛОВИНОЙ МИЛЛИОНОВ ЧЕЛОВЕК. ВИДИМО,
Dialogue: 0,0:00:22.92,0:00:25.32,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНОСТЬ ПРОСТО НЕ УСПЕЛА ПРОЧИТАТЬ БОДРЫЙ
Dialogue: 0,0:00:25.40,0:00:27.72,Caption,,0,0,0,,ОТЧЁТ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ,
Dialogue: 0,0:00:27.87,0:00:30.20,Caption,,0,0,0,,ГДЕ ЗАЯВЛЕНИЯ ПРОВЕРЯЮТ НЕ АПЛОДИСМЕНТАМИ,
Dialogue: 0,0:00:30.36,0:00:32.76,Caption,,0,0,0,,А ПОСЛЕДСТВИЯМИ, ПОДПИШИТЕСЬ НА КАНАЛ.
Dialogue: 0,0:00:33.32,0:00:35.88,Caption,,0,0,0,,ЗДЕСЬ ЧИНОВНИЧЬИ СЛОВА ОБЫЧНО ВЫГЛЯДЯТ ОСОБЕННО
Dialogue: 0,0:00:35.88,0:00:37.72,Caption,,0,0,0,,НАРЯДНО РОВНО ДО ТОГО МОМЕНТА,
Dialogue: 0,0:00:38.06,0:00:40.92,Caption,,0,0,0,,ПОКА РЯДОМ НЕ ПОЯВЛЯЮТСЯ ЦИФРЫ. ДО ДВУХ С
Dialogue: 0,0:00:40.92,0:00:43.96,Caption,,0,0,0,,ПОЛОВИНОЙ МИЛЛИОНОВ УКРАИНЦЕВ МОГУТ УЕХАТЬ ИЗ СТРАНЫ
Dialogue: 0,0:00:43.96,0:00:47.00,Caption,,0,0,0,,В ТЕЧЕНИЕ ЗИМЫ. ГЛАВНАЯ ПРИЧИНА ПРЕДЕЛЬНО ПОНЯТНА
Dialogue: 0,0:00:47.00,0:00:50.52,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО, ОТОПЛЕНИЕ И ИЗНОШЕННАЯ ЭНЕРГЕТИЧЕСКАЯ
Dialogue: 0,0:00:50.52,0:00:53.56,Caption,,0,0,0,,ИНФРАСТРУКТУРА. ПОКА СВЕТ ИСЧЕЗАЕТ НА НЕСКОЛЬКО
Dialogue: 0,0:00:53.56,0:00:56.44,Caption,,0,0,0,,ЧАСОВ, ЧЕЛОВЕК ЕЩЁ РУГАЕТСЯ И ДОСТАЁТ ФОНАРЬ.
Dialogue: 0,0:00:57.00,0:00:59.24,Caption,,0,0,0,,КОГДА ОТКЛЮЧЕНИЯ СТАНОВЯТСЯ ОБРАЗОМ ЖИЗНИ,
Dialogue: 0,0:00:59.51,0:01:02.68,Caption,,0,0,0,,ОН УЖЕ ДОСТАЁТ ЧЕМОДАН. ГОСУДАРСТВЕННЫЕ РЕЧИ МОГУТ
Dialogue: 0,0:01:02.68,0:01:06.84,Caption,,0,0,0,,БЫТЬ ОЧЕНЬ УБЕДИТЕЛЬНЫМИ, НО БАТАРЕЯ ПОЧЕМУ ТО НЕ НАГРЕВАЕТСЯ ОТ ПРАВИЛЬНОЙ
Dialogue: 0,0:01:06.84,0:01:10.04,Caption,,0,0,0,,ИНТОНАЦИИ. ТАКУЮ ОЦЕНКУ ПРИВОДИТ ПОЛЬСКАЯ ГАЗЕТА
Dialogue: 0,0:01:10.30,0:01:16.80,Caption,,0,0,0,,RZECZPOSPOLITA. НАИБОЛЕЕ УЯЗВИМЫМИ НАЗЫВАЮТ БОЛЬШИЕ ГОРОДА. В
Dialogue: 0,0:01:16.80,0:01:19.52,Caption,,0,0,0,,МАЛЕНЬКОМ НАСЕЛЁННОМ ПУНКТЕ ТЯЖЁЛЫЕ УСЛОВИЯ
Dialogue: 0,0:01:19.52,0:01:22.96,Caption,,0,0,0,,ЗАТРАГИВАЮТ ОГРАНИЧЕННОЕ ЧИСЛО ЖИТЕЛЕЙ. В МЕГАПОЛИСЕ
Dialogue: 0,0:01:23.04,0:01:25.76,Caption,,0,0,0,,ОДИН И ТОТ ЖЕ ВОПРОС ОДНОВРЕМЕННО ВСТАЁТ ПЕРЕД
Dialogue: 0,0:01:25.76,0:01:29.44,Caption,,0,0,0,,СОТНЯМИ ТЫСЯЧ СЕМЕЙ. ЕСЛИ ЭНЕРГОСИСТЕМА НЕ ВЫДЕРЖИТ,
Dialogue: 0,0:01:29.75,0:01:32.80,Caption,,0,0,0,,ОТЪЕЗД ПЕРЕСТАНЕТ БЫТЬ НАБОРОМ ОТДЕЛЬНЫХ РЕШЕНИЙ И
Dialogue: 0,0:01:32.80,0:01:35.76,Caption,,0,0,0,,ПРЕВРАТИТСЯ В МАССОВЫЙ ПОТОК. ДВА С ПОЛОВИНОЙ
Dialogue: 0,0:01:35.76,0:01:38.32,Caption,,0,0,0,,МИЛЛИОНА ЧЕЛОВЕК НЕВОЗМОЖНО СПРЯТАТЬ В ПРИМЕЧАНИИ
Dialogue: 0,0:01:38.40,0:01:41.04,Caption,,0,0,0,,МЕЛКИМ ШРИФТОМ. ВМЕСТЕ С НИМИ СТРАНА ТЕРЯЕТ
Dialogue: 0,0:01:41.04,0:01:43.52,Caption,,0,0,0,,РАБОТНИКОВ, ИНЖЕНЕРОВ, ВРАЧЕЙ,
Dialogue: 0,0:01:43.76,0:01:46.32,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКОВ, РОДИТЕЛЕЙ С ДЕТЬМИ,
Dialogue: 0,0:01:46.57,0:01:48.88,Caption,,0,0,0,,МУЖЧИН И ЖЕНЩИН ТРУДОСПОСОБНОГО ВОЗРАСТА.
Dialogue: 0,0:01:49.52,0:01:53.04,Caption,,0,0,0,,УЕЗЖАЮТ НЕ АБСТРАКТНЫЕ ЕДИНИЦЫ ИЗ ТАБЛИЦЫ. УЕЗЖАЮТ
Dialogue: 0,0:01:53.04,0:01:56.32,Caption,,0,0,0,,ИМЕННО ТЕ, КОГО ЗАТЕМ НАЧИНАЮТ ИСКАТЬ ДЛЯ АРМИИ,
Dialogue: 0,0:01:56.47,0:02:00.80,Caption,,0,0,0,,ПРЕДПРИЯТИЙ, КОММУНАЛЬНЫХ СЛУЖБ И БЮДЖЕТА. КАРТИНА ВЫХОДИТ ПОЧТИ
Dialogue: 0,0:02:00.80,0:02:04.32,Caption,,0,0,0,,ОБРАЗЦОВОЙ. ВЛАСТИ ТРЕБУЮТ, ЧТОБЫ ЛЮДИ ОСТАВАЛИСЬ,
Dialogue: 0,0:02:04.40,0:02:07.92,Caption,,0,0,0,,РАБОТАЛИ, ПЛАТИЛИ НАЛОГИ И ЗАКРЫВАЛИ НЕХВАТКУ КАДРОВ.
Dialogue: 0,0:02:08.32,0:02:11.12,Caption,,0,0,0,,ОДНОВРЕМЕННО УСЛОВИЯ ЖИЗНИ ПОДТАЛКИВАЮТ ИХ К
Dialogue: 0,0:02:11.12,0:02:13.44,Caption,,0,0,0,,ГРАНИЦЕ. ЧЕМ ТЯЖЕЛЕЕ ПРОХОДИТ ЗИМА,
Dialogue: 0,0:02:13.68,0:02:16.48,Caption,,0,0,0,,ТЕМ СТРАННЕЕ ЗВУЧИТ ПРИЗЫВ ПОТЕРПЕТЬ ЕЩЁ НЕМНОГО.
Dialogue: 0,0:02:16.86,0:02:19.76,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ СЛЕДУЮЩУЮ ПОРЦИЮ ТЕРПЕНИЯ СОБИРАЮТСЯ
Dialogue: 0,0:02:19.76,0:02:22.64,Caption,,0,0,0,,ВЫДАВАТЬ ВМЕСТЕ С ПОВЕСТКОЙ. ИМЕННО НА ЭТОМ ФОНЕ
Dialogue: 0,0:02:22.64,0:02:24.64,Caption,,0,0,0,,ДЕПУТАТ ФЁДОР ВЕНИСЛАВСКИЙ СООБЩИЛ,
Dialogue: 0,0:02:24.88,0:02:27.68,Caption,,0,0,0,,ЧТО СЛУЧАИ ПРИНУДИТЕЛЬНОЙ МОБИЛИЗАЦИИ НА УКРАИНЕ
Dialogue: 0,0:02:27.83,0:02:32.12,Caption,,0,0,0,,ПРАКТИЧЕСКИ ИСЧЕЗЛИ. НЕ УМЕНЬШИЛИСЬ,
Dialogue: 0,0:02:32.28,0:02:37.16,Caption,,0,0,0,,НЕ СТАЛИ РЕДКОСТЬЮ, А СВЕДЕНЫ К НУЛЮ. ВЕЛИКОЛЕПНЫЙ РЕЗУЛЬТАТ. ОСТАЛОСЬ
Dialogue: 0,0:02:37.16,0:02:40.68,Caption,,0,0,0,,СООБЩИТЬ ОБ ЭТОМ ЛЮДЯМ, КОТОРЫЕ ЖАЛУЮТСЯ НА ДЕЙСТВИЯ СОТРУДНИКОВ
Dialogue: 0,0:02:40.68,0:02:42.68,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫХ ЦЕНТРОВ КОМПЛЕКТОВАНИЯ,
Dialogue: 0,0:02:42.91,0:02:45.80,Caption,,0,0,0,,ОГРАНИЧЕНИЯ ПРАВ И СПОСОБЫ ДОСТАВКИ МУЖЧИН В
Dialogue: 0,0:02:45.80,0:02:48.92,Caption,,0,0,0,,ВОЕНКОМАТЫ. БЕЗ ЭТОЙ МАЛЕНЬКОЙ ФОРМАЛЬНОСТИ ПОБЕДА
Dialogue: 0,0:02:48.92,0:02:51.80,Caption,,0,0,0,,ВЫГЛЯДИТ СЛЕГКА ОДНОСТОРОННЕЙ. ОФИЦИАЛЬНЫЙ НОЛЬ
Dialogue: 0,0:02:52.03,0:02:54.60,Caption,,0,0,0,,ВООБЩЕ УДОБНАЯ ВЕЛИЧИНА. ОН АККУРАТНЫЙ,
Dialogue: 0,0:02:54.78,0:02:57.88,Caption,,0,0,0,,КРУГЛЫЙ И НЕ ЗАДАЁТ НЕПРИЯТНЫХ ВОПРОСОВ. НО
Dialogue: 0,0:02:57.96,0:03:00.68,Caption,,0,0,0,,ГРАЖДАНИН СРАВНИВАЕТ ЕГО НЕ С ПРЕДЫДУЩИМ ОТЧЁТОМ,
Dialogue: 0,0:03:01.00,0:03:04.36,Caption,,0,0,0,,А С ТЕМ, ЧТО ВИДИТ ВО ДВОРЕ, НА УЛИЦЕ И В ТЕЛЕФОНЕ.
Dialogue: 0,0:03:05.05,0:03:07.40,Caption,,0,0,0,,ЕСЛИ ТАМ ПРОДОЛЖАЮТСЯ ИСТОРИИ О НАРУШЕНИЯХ,
Dialogue: 0,0:03:07.72,0:03:10.44,Caption,,0,0,0,,АРИФМЕТИКА ДЕПУТАТА ПРОИГРЫВАЕТ ЕЩЁ ДО НАЧАЛА
Dialogue: 0,0:03:10.44,0:03:12.76,Caption,,0,0,0,,ПОДСЧЁТА. ЗАТЕМ ПОЯВИЛАСЬ ВЕРСИЯ,
Dialogue: 0,0:03:13.00,0:03:16.28,Caption,,0,0,0,,БУДТО К ПОИСКУ МУЖЧИН, УКЛОНЯЮЩИХСЯ ОТ МОБИЛИЗАЦИИ,
Dialogue: 0,0:03:16.52,0:03:19.48,Caption,,0,0,0,,СТАЛИ ПРИВЛЕКАТЬ ПОДРОСТКОВ. ЗА СВЕДЕНИЯ О МЕСТНЫХ
Dialogue: 0,0:03:19.48,0:03:22.36,Caption,,0,0,0,,ЖИТЕЛЯХ ИМ ЯКОБЫ ПРЕДЛАГАЮТ ПО ДВЕ ТЫСЯЧИ ГРИВЕН.
Dialogue: 0,0:03:22.72,0:03:24.52,Caption,,0,0,0,,ВЫЯСНИЛ, КТО ЖИВЁТ В КВАРТИРЕ,
Dialogue: 0,0:03:24.76,0:03:29.08,Caption,,0,0,0,,ЗАМЕТИЛ, КТО РЕДКО ВЫХОДИТ, ПЕРЕДАЛ ИНФОРМАЦИЮ И ПОЛУЧИЛ ВОЗНАГРАЖДЕНИЕ.
Dialogue: 0,0:03:29.32,0:03:32.12,Caption,,0,0,0,,ПРЕКРАСНАЯ ШКОЛА ГРАЖДАНСКОЙ АКТИВНОСТИ. ЕЩЁ
Dialogue: 0,0:03:32.12,0:03:35.32,Caption,,0,0,0,,НЕМНОГО, И ЗА УДАЧНО НАЙДЕННОГО СОСЕДА НАЧНУТ ВЫДАВАТЬ
Dialogue: 0,0:03:35.40,0:03:38.76,Caption,,0,0,0,,ГРАМОТУ НА ЛИНЕЙКЕ. ОПИСАННАЯ СХЕМА НЕЗАМЫСЛОВАТА.
Dialogue: 0,0:03:39.15,0:03:41.96,Caption,,0,0,0,,НЕСОВЕРШЕННОЛЕТНИЕ СОБИРАЮТ ДАННЫЕ О МУЖЧИНАХ ПО
Dialogue: 0,0:03:41.96,0:03:45.80,Caption,,0,0,0,,МЕСТУ ЖИТЕЛЬСТВА, ПОСЛЕ ЧЕГО ИНФОРМАЦИЯ ИСПОЛЬЗУЕТСЯ ДЛЯ ПРОВЕРОК.
Dialogue: 0,0:03:47.98,0:03:50.54,Caption,,0,0,0,,И ТУТ ЗАЯВЛЕНИЕ ВЕНИСЛАВСКОГО ПРИОБРЕТАЕТ ПОЧТИ
Dialogue: 0,0:03:50.54,0:03:53.98,Caption,,0,0,0,,КОМЕДИЙНОЕ ЗВУЧАНИЕ. ЕСЛИ ОФИЦИАЛЬНЫЙ ПОИСК УЖЕ
Dialogue: 0,0:03:54.06,0:03:56.06,Caption,,0,0,0,,ПРИХОДИТСЯ ДОПОЛНЯТЬ ДВОРОВОЙ РАЗВЕДКОЙ,
Dialogue: 0,0:03:56.46,0:03:59.26,Caption,,0,0,0,,ЗНАЧИТ С ДОСТУПНОСТЬЮ МОБИЛИЗАЦИОННОГО РЕСУРСА ВСЁ
Dialogue: 0,0:03:59.34,0:04:03.18,Caption,,0,0,0,,ДАЛЕКО НЕ ТАК БЕЗОБЛАЧНО, КАК ПОКАЗЫВАЮТ С ТРИБУНЫ. ПОЛУЧАЕТСЯ,
Dialogue: 0,0:04:03.46,0:04:08.22,Caption,,0,0,0,,ПРИНУЖДЕНИЕ ИСЧЕЗЛО, ЗАТО ДВОР ВНЕЗАПНО ПОЛУЧИЛ НОВУЮ СПЕЦИАЛЬНОСТЬ. НОЛЬ
Dialogue: 0,0:04:08.22,0:04:11.58,Caption,,0,0,0,,ЕСТЬ, А МЕТОДЫ ВОКРУГ НЕГО ПРОДОЛЖАЮТ РАЗМНОЖАТЬСЯ.
Dialogue: 0,0:04:11.88,0:04:14.06,Caption,,0,0,0,,ВИДИМО, ЭТО ОСОБАЯ МАТЕМАТИКА,
Dialogue: 0,0:04:14.30,0:04:18.94,Caption,,0,0,0,,ГДЕ РЕЗУЛЬТАТ УЖЕ ОБЪЯВИЛИ, А ВЫЧИСЛЕНИЯ ВСЁ НИКАК НЕ ЗАКАНЧИВАЮТСЯ. СЛЕДУЮЩИЙ
Dialogue: 0,0:04:19.02,0:04:21.34,Caption,,0,0,0,,РЕЗЕРВ ВЛАСТИ МОГУТ ИСКАТЬ СРЕДИ РАБОТНИКОВ,
Dialogue: 0,0:04:21.50,0:04:24.06,Caption,,0,0,0,,ИМЕЮЩИХ БРОНЬ. ПОЯВИЛАСЬ ИНФОРМАЦИЯ,
Dialogue: 0,0:04:24.30,0:04:26.38,Caption,,0,0,0,,ЧТО НА БАНКОВОЙ РАССМАТРИВАЮТ СОКРАЩЕНИЕ
Dialogue: 0,0:04:26.38,0:04:29.74,Caption,,0,0,0,,БРОНИРОВАНИЯ, ЧТОБЫ УВЕЛИЧИТЬ ЧИСЛО ДОСТУПНЫХ ДЛЯ МОБИЛИЗАЦИИ
Dialogue: 0,0:04:29.74,0:04:32.62,Caption,,0,0,0,,МУЖЧИН. ДО СИХ ПОР ЭТИХ СОТРУДНИКОВ ОСТАВЛЯЛИ НА
Dialogue: 0,0:04:32.62,0:04:36.14,Caption,,0,0,0,,ПРЕДПРИЯТИЯХ, ПРИЗНАННЫХ ВАЖНЫМИ ДЛЯ ГОСУДАРСТВА. ТЕПЕРЬ
Dialogue: 0,0:04:36.14,0:04:39.42,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО ВАЖНОСТЬ БЫВАЕТ РОВНО ДО ТЕХ ПОР,
Dialogue: 0,0:04:39.74,0:04:43.10,Caption,,0,0,0,,ПОКА АРМИИ НЕ ПОНАДОБИЛОСЬ ЕЩЁ БОЛЬШЕ ЛЮДЕЙ. УКРАИНЕ
Dialogue: 0,0:04:43.10,0:04:46.30,Caption,,0,0,0,,НУЖНЫ ВОЕННЫЕ, РАБОЧИЕ, ЭНЕРГЕТИКИ,
Dialogue: 0,0:04:46.46,0:04:49.50,Caption,,0,0,0,,ИНЖЕНЕРЫ И СПЕЦИАЛИСТЫ ОБОРОННЫХ ПРЕДПРИЯТИЙ. НУЖНЫ
Dialogue: 0,0:04:49.50,0:04:53.02,Caption,,0,0,0,,ГРАЖДАНЕ, КОТОРЫЕ ПРОДОЛЖАЮТ ЗАРАБАТЫВАТЬ И СОДЕРЖАТЬ БЮДЖЕТ.
Dialogue: 0,0:04:53.27,0:04:57.50,Caption,,0,0,0,,НУЖНЫ МИЛЛИОНЫ ЛЮДЕЙ, НЕ ВЫБРАВШИХ ЭМИГРАЦИЮ. ТРЕБОВАНИЙ СТАНОВИТСЯ
Dialogue: 0,0:04:57.58,0:05:00.30,Caption,,0,0,0,,БОЛЬШЕ, А НАСЕЛЕНИЕ ОТ ЭТОГО НЕ ПРИБАВЛЯЕТСЯ.
Dialogue: 0,0:05:02.59,0:05:04.83,Caption,,0,0,0,,МОЖНО СОСТАВИТЬ ХОТЬ ДЕСЯТЬ СПИСКОВ НУЖНЫХ
Dialogue: 0,0:05:04.83,0:05:08.11,Caption,,0,0,0,,ПРОФЕССИЙ, НО ФАМИЛИИ В НИХ ВСЁ РАВНО БУДУТ ПОВТОРЯТЬСЯ.
Dialogue: 0,0:05:08.41,0:05:11.23,Caption,,0,0,0,,ПОЭТОМУ СОКРАЩЕНИЕ БРОНИ ОЗНАЧАЕТ ГОРАЗДО БОЛЬШЕ,
Dialogue: 0,0:05:11.47,0:05:13.15,Caption,,0,0,0,,ЧЕМ ОЧЕРЕДНОЕ ИЗМЕНЕНИЕ ПРАВИЛ.
Dialogue: 0,0:05:13.95,0:05:16.99,Caption,,0,0,0,,КАДРОВУЮ НЕХВАТКУ АРМИИ ПРЕДЛАГАЮТ ЗАКРЫВАТЬ ЛЮДЬМИ,
Dialogue: 0,0:05:17.23,0:05:19.79,Caption,,0,0,0,,КОТОРЫЕ УЖЕ ЗАКРЫВАЮТ НЕХВАТКУ В ЭКОНОМИКЕ.
Dialogue: 0,0:05:20.30,0:05:22.99,Caption,,0,0,0,,СОТРУДНИКА ПЕРЕСТАВЛЯЮТ ИЗ ОДНОЙ КОЛОНКИ В ДРУГУЮ,
Dialogue: 0,0:05:23.26,0:05:26.11,Caption,,0,0,0,,ПОСЛЕ ЧЕГО ЧИНОВНИК С СЕРЬЁЗНЫМ ЛИЦОМ СООБЩАЕТ О
Dialogue: 0,0:05:26.11,0:05:28.59,Caption,,0,0,0,,НАЙДЕННОМ РЕЗЕРВЕ. ПРЕДПРИЯТИЕ ПРИ ЭТОМ МОЖЕТ
Dialogue: 0,0:05:28.59,0:05:30.91,Caption,,0,0,0,,ПОВЕСИТЬ НА ПУСТОЕ РАБОЧЕЕ МЕСТО ТАБЛИЧКУ С
Dialogue: 0,0:05:30.91,0:05:34.19,Caption,,0,0,0,,БЛАГОДАРНОСТЬЮ. ОДНОВРЕМЕННО ОБСУЖДАЕТСЯ ВОЗМОЖНОЕ
Dialogue: 0,0:05:34.19,0:05:37.71,Caption,,0,0,0,,СНИЖЕНИЕ МОБИЛИЗАЦИОННОГО ВОЗРАСТА. РЕСУРС ИЩУТ
Dialogue: 0,0:05:37.79,0:05:40.67,Caption,,0,0,0,,СРАЗУ В НЕСКОЛЬКИХ НАПРАВЛЕНИЯХ. ПРОВЕРЯЮТ БРОНЬ,
Dialogue: 0,0:05:41.00,0:05:43.31,Caption,,0,0,0,,ПРИСМАТРИВАЮТСЯ К БОЛЕЕ МОЛОДЫМ МУЖЧИНАМ,
Dialogue: 0,0:05:43.56,0:05:48.27,Caption,,0,0,0,,УСИЛИВАЮТ ВЫЯВЛЕНИЕ ТЕХ, КТО ИЗБЕГАЕТ ТЕРРИТОРИАЛЬНЫХ ЦЕНТРОВ. И ПРОИСХОДИТ
Dialogue: 0,0:05:48.27,0:05:51.95,Caption,,0,0,0,,ЭТО В МОМЕНТ, КОГДА ДО ДВУХ С ПОЛОВИНОЙ МИЛЛИОНОВ ЧЕЛОВЕК МОГУТ
Dialogue: 0,0:05:52.03,0:05:55.39,Caption,,0,0,0,,РЕШИТЬ, ЧТО БЕЗОПАСНЕЕ ПЕРЕЖДАТЬ ЗИМУ ЗА ПРЕДЕЛАМИ СТРАНЫ.
Dialogue: 0,0:05:55.99,0:06:00.35,Caption,,0,0,0,,ЕСЛИ ВЫ ЕЩЁ НЕ ПОДПИСАЛИСЬ, СДЕЛАЙТЕ ЭТО СЕЙЧАС. ДАЛЬШЕ РАЗГОВОР ПЕРЕХОДИТ ОТ
Dialogue: 0,0:06:00.35,0:06:03.39,Caption,,0,0,0,,ПОИСКА МУЖЧИН ВНИЗУ К БОРЬБЕ ЗА РЫЧАГИ НАВЕРХУ.
Dialogue: 0,0:06:03.76,0:06:06.27,Caption,,0,0,0,,И ТАМ ОФИЦИАЛЬНЫЙ НОЛЬ УЖЕ НЕ ПОМОЖЕТ ДАЖЕ
Dialogue: 0,0:06:06.27,0:06:12.24,Caption,,0,0,0,,ДЛЯ ДЕКОРАЦИИ. ГЕНЕРАЛ СЛУЖБЫ БЕЗОПАСНОСТИ УКРАИНЫ СЕРГЕЙ ДУКА
Dialogue: 0,0:06:12.24,0:06:16.32,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО МАТЕРИАЛЫ, ПОЗВОЛЯВШИЕ ПРЕДЪЯВИТЬ ПОДОЗРЕНИЕ ДИРЕКТОРУ
Dialogue: 0,0:06:16.32,0:06:19.04,Caption,,0,0,0,,НАЦИОНАЛЬНОГО АНТИКОРРУПЦИОННОГО БЮРО СЕМЁНУ
Dialogue: 0,0:06:19.04,0:06:22.64,Caption,,0,0,0,,КРИВОНОСУ, ПОДГОТОВИЛИ ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ ГОДУ.
Dialogue: 0,0:06:23.03,0:06:26.32,Caption,,0,0,0,,ОДНАКО ПОЧТИ ГОД ОНИ ОСТАВАЛИСЬ БЕЗ ДВИЖЕНИЯ. ПО
Dialogue: 0,0:06:26.32,0:06:30.16,Caption,,0,0,0,,СЛОВАМ ДУКИ, ДЛЯ ПРОДОЛЖЕНИЯ НЕ ХВАТАЛО ПОЛИТИЧЕСКОГО РЕШЕНИЯ.
Dialogue: 0,0:06:30.32,0:06:33.60,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЛЮБОПЫТНАЯ ПРОЦЕДУРА. МАТЕРИАЛЫ СОБРАНЫ,
Dialogue: 0,0:06:33.70,0:06:36.72,Caption,,0,0,0,,ОСНОВАНИЯ, КАК УТВЕРЖДАЕТСЯ, ИМЕЮТСЯ,
Dialogue: 0,0:06:36.96,0:06:40.08,Caption,,0,0,0,,НО ДЕЛО ЖДЁТ РАЗРЕШАЮЩЕГО СИГНАЛА. НЕ НОВОГО
Dialogue: 0,0:06:40.08,0:06:44.00,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВА, НЕ ДОПОЛНИТЕЛЬНОЙ ЭКСПЕРТИЗЫ И НЕ УТОЧНЕНИЯ
Dialogue: 0,0:06:44.00,0:06:47.28,Caption,,0,0,0,,СЛЕДСТВИЯ. НУЖЕН МОМЕНТ, КОГДА НАВЕРХУ РЕШАТ,
Dialogue: 0,0:06:47.51,0:06:50.48,Caption,,0,0,0,,ЧТО ПАПКЕ ПОРА ОЖИТЬ. ДО ЭТОГО ОНА СПОКОЙНО
Dialogue: 0,0:06:50.48,0:06:54.16,Caption,,0,0,0,,ЛЕЖИТ, СЛОВНО У УГОЛОВНОГО ПРОИЗВОДСТВА ТОЖЕ БЫВАЕТ РЕЖИМ
Dialogue: 0,0:06:54.16,0:06:56.88,Caption,,0,0,0,,ОЖИДАНИЯ. КРИВОНОС РУКОВОДИТ СТРУКТУРОЙ,
Dialogue: 0,0:06:57.04,0:06:59.52,Caption,,0,0,0,,КОТОРАЯ ДОЛЖНА РАССЛЕДОВАТЬ КОРРУПЦИЮ НА ВЫСОКОМ
Dialogue: 0,0:06:59.65,0:07:02.72,Caption,,0,0,0,,УРОВНЕ. ПОЭТОМУ ЗАДЕРЖКА С ПОДОЗРЕНИЕМ ПРОТИВ НЕГО
Dialogue: 0,0:07:02.81,0:07:04.64,Caption,,0,0,0,,САМА СТАНОВИТСЯ ЧАСТЬЮ ИСТОРИИ.
Dialogue: 0,0:07:05.35,0:07:08.16,Caption,,0,0,0,,ЕСЛИ ДЕЛО ДЕЙСТВИТЕЛЬНО ПОЧТИ ГОД ЗАВИСЕЛО ИЗ ЗА
Dialogue: 0,0:07:08.16,0:07:12.24,Caption,,0,0,0,,ОТСУТСТВИЯ РЕШЕНИЯ, ВОЗНИКАЕТ ВОПРОС НЕ ТОЛЬКО О СОДЕРЖАНИИ МАТЕРИАЛОВ.
Dialogue: 0,0:07:12.66,0:07:17.36,Caption,,0,0,0,,ГОРАЗДО ВАЖНЕЕ, КТО ОПРЕДЕЛЯЛ ВРЕМЯ ИХ ЗАПУСКА И ПОЧЕМУ ПОДХОДЯЩИЙ
Dialogue: 0,0:07:17.36,0:07:20.32,Caption,,0,0,0,,ЧАС НАСТУПАЕТ ПО КОМАНДЕ. ДУКА УПОМИНАЕТ И
Dialogue: 0,0:07:20.32,0:07:22.72,Caption,,0,0,0,,РУКОВОДСТВО ГЕНЕРАЛЬНОЙ ПРОКУРАТУРЫ. ЗНАЧИТ,
Dialogue: 0,0:07:23.03,0:07:25.12,Caption,,0,0,0,,РЕЧЬ ИДЁТ УЖЕ НЕ О ЛИЧНОМ СПОРЕ ДВУХ
Dialogue: 0,0:07:25.20,0:07:29.57,Caption,,0,0,0,,ЛЮДЕЙ. ОДИН ОРГАН СОБИРАЕТ МАТЕРИАЛЫ,
Dialogue: 0,0:07:29.73,0:07:32.45,Caption,,0,0,0,,ДРУГОЙ СПОСОБЕН ПРИДАТЬ ИМ ПРОЦЕССУАЛЬНОЕ ДВИЖЕНИЕ,
Dialogue: 0,0:07:32.69,0:07:34.85,Caption,,0,0,0,,А ГДЕ ТО МЕЖДУ НИМИ ПОЯВЛЯЕТСЯ УСЛОВИЕ,
Dialogue: 0,0:07:35.01,0:07:36.85,Caption,,0,0,0,,КОТОРОГО НЕТ В УГОЛОВНОМ КОДЕКСЕ,
Dialogue: 0,0:07:37.01,0:07:40.37,Caption,,0,0,0,,НО БЕЗ НЕГО НИЧЕГО НЕ ПРОИСХОДИТ. УСЛОВИЕ НАЗЫВАЕТСЯ
Dialogue: 0,0:07:40.44,0:07:44.69,Caption,,0,0,0,,ВОЛЕЙ СВЕРХУ, И ПЕЧАТЬ ЕМУ НЕ ТРЕБУЕТСЯ. СЕЙЧАС ДОКУМЕНТЫ ЛЕЖАТ
Dialogue: 0,0:07:44.77,0:07:47.73,Caption,,0,0,0,,БЕЗ ДВИЖЕНИЯ. В НУЖНЫЙ МОМЕНТ ПРИНИМАЕТСЯ НУЖНОЕ
Dialogue: 0,0:07:47.81,0:07:50.69,Caption,,0,0,0,,РЕШЕНИЕ. А СЛЕДОМ СТРАНА ОБСУЖДАЕТ ГРОМКОЕ
Dialogue: 0,0:07:50.69,0:07:53.49,Caption,,0,0,0,,ПОДОЗРЕНИЕ ДИРЕКТОРУ АНТИКОРРУПЦИОННОГО ВЕДОМСТВА.
Dialogue: 0,0:07:54.05,0:07:58.85,Caption,,0,0,0,,МЕХАНИЗМ ПОЧТИ БЕСШУМНЫЙ, ЗАТО ЭФФЕКТ СЛЫШНО ДАЛЕКО. ОСОБЕННО УДОБНО,
Dialogue: 0,0:07:59.01,0:08:01.41,Caption,,0,0,0,,ЧТО МОМЕНТ ВКЛЮЧЕНИЯ МОЖНО ПОДОБРАТЬ ПОД НУЖНЫЙ
Dialogue: 0,0:08:01.41,0:08:04.53,Caption,,0,0,0,,КОНФЛИКТ, ГОЛОСОВАНИЕ ИЛИ ПУБЛИЧНУЮ КАМПАНИЮ.
Dialogue: 0,0:08:05.08,0:08:07.81,Caption,,0,0,0,,ЕСЛИ ВЕРСИЯ ДУКИ СООТВЕТСТВУЕТ ПРОИСХОДИВШЕМУ,
Dialogue: 0,0:08:08.01,0:08:11.49,Caption,,0,0,0,,УГОЛОВНОЕ ДЕЛО ПРЕВРАЩАЕТСЯ В УПРАВЛЯЕМЫЙ РЫЧАГ. САМ
Dialogue: 0,0:08:11.49,0:08:13.09,Caption,,0,0,0,,МАТЕРИАЛ МОЖЕТ ОСТАВАТЬСЯ ТЕМ ЖЕ,
Dialogue: 0,0:08:13.49,0:08:16.05,Caption,,0,0,0,,НО ЕГО ПОЛИТИЧЕСКИЙ ВЕС ЗАВИСИТ ОТ ДАТЫ ЗАПУСКА.
Dialogue: 0,0:08:16.44,0:08:18.53,Caption,,0,0,0,,ЗАЖАТЬ ПАПКУ НА ГОД ИЛИ ВЫНЕСТИ ЕЁ К
Dialogue: 0,0:08:18.61,0:08:23.01,Caption,,0,0,0,,КАМЕРАМ НЕМЕДЛЕННО, ЭТО ДВА СОВЕРШЕННО РАЗНЫХ УДАРА. ЮРИДИЧЕСКАЯ ЧАСТЬ
Dialogue: 0,0:08:23.01,0:08:24.93,Caption,,0,0,0,,ЗДЕСЬ МОЖЕТ НЕ ИЗМЕНИТЬСЯ НИ НА СТРОЧКУ,
Dialogue: 0,0:08:25.16,0:08:27.73,Caption,,0,0,0,,А ПОСЛЕДСТВИЯ ИЗМЕНЯТСЯ ПОЛНОСТЬЮ. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:08:27.73,0:08:31.49,Caption,,0,0,0,,ПОЯВИЛАСЬ ВЕРСИЯ, ЧТО СЕРГЕЙ ДУКА И АЛЕКСЕЙ ГОНЧАРЕНКО ИСПОЛЬЗУЮТ
Dialogue: 0,0:08:31.49,0:08:34.45,Caption,,0,0,0,,ПАРЛАМЕНТСКУЮ КОМИССИЮ ДЛЯ ДАВЛЕНИЯ НА НАЦИОНАЛЬНОЕ
Dialogue: 0,0:08:34.45,0:08:39.57,Caption,,0,0,0,,АНТИКОРРУПЦИОННОЕ БЮРО. ДАВНИЙ КОНФЛИКТ В ТАКОМ СЛУЧАЕ ПОЛУЧАЕТ ОФИЦИАЛЬНУЮ
Dialogue: 0,0:08:39.57,0:08:44.50,Caption,,0,0,0,,СЦЕНУ. ТЕПЕРЬ ОБВИНЕНИЯ МОЖНО НЕ ПРОСТО ПУБЛИКОВАТЬ,
Dialogue: 0,0:08:44.89,0:08:49.70,Caption,,0,0,0,,А ПРОИЗНОСИТЬ НА ЗАСЕДАНИЯХ, ОФОРМЛЯТЬ ВОПРОСАМИ И ЗАСТАВЛЯТЬ ОППОНЕНТОВ ОТВЕЧАТЬ
Dialogue: 0,0:08:49.70,0:08:52.74,Caption,,0,0,0,,ПЕРЕД КАМЕРАМИ. КОМИССИЯ ДЛЯ ЭТОГО ПОДХОДИТ ПОЧТИ
Dialogue: 0,0:08:52.74,0:08:56.26,Caption,,0,0,0,,ИДЕАЛЬНО. ВЫВЕСКА СЕРЬЁЗНАЯ, МИКРОФОНЫ ВКЛЮЧЕНЫ,
Dialogue: 0,0:08:56.50,0:08:59.54,Caption,,0,0,0,,ПРОТОКОЛ ВЕДЁТСЯ. ЮРИДИЧЕСКИЙ ИТОГ МОЖЕТ ПОЯВИТЬСЯ
Dialogue: 0,0:08:59.62,0:09:02.02,Caption,,0,0,0,,КОГДА НИБУДЬ ПОТОМ ИЛИ НЕ ПОЯВИТЬСЯ ВОВСЕ,
Dialogue: 0,0:09:02.34,0:09:05.54,Caption,,0,0,0,,ЗАТО НУЖНОЕ ВПЕЧАТЛЕНИЕ СОЗДАЁТСЯ СРАЗУ. ОДИН
Dialogue: 0,0:09:05.54,0:09:09.62,Caption,,0,0,0,,УЧАСТНИК ОПРАВДЫВАЕТСЯ, ВТОРОЙ ИЗОБРАЖАЕТ БЕССТРАШНОГО РАЗОБЛАЧИТЕЛЯ,
Dialogue: 0,0:09:09.88,0:09:14.58,Caption,,0,0,0,,ТРЕТИЙ ВНИМАТЕЛЬНО СЛЕДИТ, КОМУ В ЭТОТ РАЗ РАЗРЕШИЛИ БЫТЬ ПРАВЫМ. В
Dialogue: 0,0:09:14.58,0:09:16.90,Caption,,0,0,0,,СОЧЕТАНИИ С РАССКАЗОМ О ЗАДЕРЖАННОМ ПОДОЗРЕНИИ
Dialogue: 0,0:09:16.98,0:09:19.54,Caption,,0,0,0,,КРИВОНОСУ ЭТА ВЕРСИЯ ЗВУЧИТ ЕЩЁ ЖЁСТЧЕ.
Dialogue: 0,0:09:20.01,0:09:22.98,Caption,,0,0,0,,КОНТРОЛИРОВАТЬ РАССЛЕДОВАНИЕ НЕДОСТАТОЧНО. НАМНОГО
Dialogue: 0,0:09:23.06,0:09:24.98,Caption,,0,0,0,,ЦЕННЕЕ КОНТРОЛИРОВАТЬ СЕКУНДУ,
Dialogue: 0,0:09:25.22,0:09:27.86,Caption,,0,0,0,,КОГДА ОНО ВЫХОДИТ НАРУЖУ И НАЧИНАЕТ МЕНЯТЬ
Dialogue: 0,0:09:27.86,0:09:30.90,Caption,,0,0,0,,РАССТАНОВКУ СИЛ. ОДИН И ТОТ ЖЕ МАТЕРИАЛ СПОСОБЕН
Dialogue: 0,0:09:30.90,0:09:35.70,Caption,,0,0,0,,ГОД СОБИРАТЬ ПЫЛЬ, А ЗАТЕМ ВНЕЗАПНО СТАТЬ ГЛАВНЫМ СОБЫТИЕМ ДНЯ. ПАПКА
Dialogue: 0,0:09:35.70,0:09:39.30,Caption,,0,0,0,,ТЕРПЕЛИВАЯ. ОНА ДОЖДЁТСЯ УДОБНОЙ КОМАНДЫ. ТЕПЕРЬ ВСЯ
Dialogue: 0,0:09:39.30,0:09:42.82,Caption,,0,0,0,,СИСТЕМА ВИДНА ЦЕЛИКОМ. НА НИЖНЕМ УРОВНЕ ВЛАСТИ ИЩУТ
Dialogue: 0,0:09:42.82,0:09:45.94,Caption,,0,0,0,,ЛЮДЕЙ ДЛЯ АРМИИ. СМОТРЯТ НА РАБОТНИКОВ С БРОНЬЮ,
Dialogue: 0,0:09:46.09,0:09:47.94,Caption,,0,0,0,,ОБСУЖДАЮТ БОЛЕЕ МОЛОДОЙ ВОЗРАСТ,
Dialogue: 0,0:09:48.10,0:09:53.06,Caption,,0,0,0,,ПЫТАЮТСЯ ОБНАРУЖИТЬ МУЖЧИН, ИЗБЕГАЮЩИХ МОБИЛИЗАЦИИ. ПОЯВЛЯЮТСЯ ДАЖЕ СООБЩЕНИЯ О
Dialogue: 0,0:09:53.06,0:09:56.74,Caption,,0,0,0,,ПОДРОСТКАХ, СОБИРАЮЩИХ СВЕДЕНИЯ ЗА ДВЕ ТЫСЯЧИ ГРИВЕН.
Dialogue: 0,0:09:59.00,0:10:01.72,Caption,,0,0,0,,В ЭТО ЖЕ ВРЕМЯ МИЛЛИОНЫ ГРАЖДАН ОЦЕНИВАЮТ СОСТОЯНИЕ
Dialogue: 0,0:10:01.72,0:10:05.16,Caption,,0,0,0,,ЭНЕРГЕТИКИ И РЕШАЮТ, НЕ ПОРА ЛИ ИМ ИСКАТЬ ДРУГУЮ СТРАНУ ДЛЯ
Dialogue: 0,0:10:05.16,0:10:08.04,Caption,,0,0,0,,ЗИМОВКИ. НАВЕРХУ ИДЁТ БОРЬБА ЗА СОВСЕМ ДРУГОЙ
Dialogue: 0,0:10:08.04,0:10:11.00,Caption,,0,0,0,,РЕСУРС. ТАМ ВАЖНЫ ДОСТУП К УГОЛОВНЫМ ДЕЛАМ,
Dialogue: 0,0:10:11.24,0:10:13.40,Caption,,0,0,0,,ВЛИЯНИЕ НА АНТИКОРРУПЦИОННОЕ БЮРО,
Dialogue: 0,0:10:13.64,0:10:16.12,Caption,,0,0,0,,ВОЗМОЖНОСТИ ПАРЛАМЕНТСКОЙ КОМИССИИ И ПРАВО
Dialogue: 0,0:10:16.12,0:10:18.36,Caption,,0,0,0,,ОПРЕДЕЛИТЬ ПОДХОДЯЩИЙ МОМЕНТ ДЛЯ ПОДОЗРЕНИЯ.
Dialogue: 0,0:10:18.91,0:10:21.88,Caption,,0,0,0,,ВНИЗУ СЧИТАЮТ МУЖЧИН. НАВЕРХУ СЧИТАЮТ РЫЧАГИ.
Dialogue: 0,0:10:22.17,0:10:26.12,Caption,,0,0,0,,СЧЁТЧИКИ РАЗНЫЕ, А ДЕФИЦИТ ДОВЕРИЯ У НИХ ОБЩИЙ. ПОДПИШИСЬ,
Dialogue: 0,0:10:26.28,0:10:28.04,Caption,,0,0,0,,ЕСЛИ ХОЧЕШЬ ВИДЕТЬ РАЗБОР ЦЕЛИКОМ,
Dialogue: 0,0:10:28.27,0:10:31.00,Caption,,0,0,0,,А НЕ В ПЕРЕСКАЗЕ ПРЕСС СЛУЖБЫ. ПЕРЕД ГОСУДАРСТВОМ
Dialogue: 0,0:10:31.00,0:10:33.72,Caption,,0,0,0,,ОДНОВРЕМЕННО СТОЯТ ТРИ ЗАДАЧИ. ЕМУ НУЖНЫ
Dialogue: 0,0:10:33.72,0:10:36.92,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИЕ, СОТРУДНИКИ ЭКОНОМИКИ И ГРАЖДАНЕ,
Dialogue: 0,0:10:37.08,0:10:39.16,Caption,,0,0,0,,ГОТОВЫЕ ПРОДОЛЖАТЬ ЖИЗНЬ ВНУТРИ СТРАНЫ.
Dialogue: 0,0:10:39.72,0:10:42.92,Caption,,0,0,0,,НО РЕШЕНИЕ ОДНОЙ ЗАДАЧИ ОТНИМАЕТ РЕСУРС У ДРУГОЙ.
Dialogue: 0,0:10:43.21,0:10:45.64,Caption,,0,0,0,,СНЯЛИ БРОНЬ, АРМЕЙСКИЙ СПИСОК ВЫРОС,
Dialogue: 0,0:10:45.96,0:10:48.36,Caption,,0,0,0,,ЗАТО ПРЕДПРИЯТИЕ ОСТАЛОСЬ БЕЗ СПЕЦИАЛИСТА.
Dialogue: 0,0:10:48.92,0:10:52.84,Caption,,0,0,0,,УСИЛИЛИ ПОИСК, ЧАСТЬ МУЖЧИН НАЧАЛА БЫСТРЕЕ ИСКАТЬ ВЫХОД. НЕ
Dialogue: 0,0:10:52.84,0:10:57.56,Caption,,0,0,0,,УДЕРЖАЛИ ЭНЕРГЕТИКУ, И К ГРАНИЦЕ ПОТЯНУЛИСЬ УЖЕ ЦЕЛЫЕ СЕМЬИ. ГЛАВНОЕ
Dialogue: 0,0:10:57.56,0:11:00.60,Caption,,0,0,0,,ПРОТИВОРЕЧИЕ СОСТОИТ ИМЕННО В ЭТОМ. ГОСУДАРСТВО
Dialogue: 0,0:11:00.68,0:11:02.84,Caption,,0,0,0,,ХОЧЕТ ПОЛУЧАТЬ ОТ ГРАЖДАНИНА ВСЁ БОЛЬШЕ,
Dialogue: 0,0:11:03.11,0:11:05.40,Caption,,0,0,0,,НО ДАЁТ ЕМУ ВСЁ МЕНЬШЕ ПРИЧИН ОСТАВАТЬСЯ.
Dialogue: 0,0:11:05.78,0:11:08.60,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО СТАНОВИТСЯ АРГУМЕНТОМ ДЛЯ ЭМИГРАЦИИ.
Dialogue: 0,0:11:08.79,0:11:12.04,Caption,,0,0,0,,РАБОЧЕЕ МЕСТО ЗАВИСИТ ОТ БРОНИ. ВОЗРАСТ МОЖЕТ
Dialogue: 0,0:11:12.04,0:11:14.20,Caption,,0,0,0,,ПРЕВРАТИТЬСЯ В НОВЫЙ КРИТЕРИЙ ПРИЗЫВА.
Dialogue: 0,0:11:16.48,0:11:18.96,Caption,,0,0,0,,ОБЫЧНЫЙ СОСЕД, ЕСЛИ ВЕРИТЬ СООБЩЕНИЯМ,
Dialogue: 0,0:11:19.19,0:11:21.52,Caption,,0,0,0,,ВНЕЗАПНО ОКАЗЫВАЕТСЯ ИСТОЧНИКОМ СВЕДЕНИЙ.
Dialogue: 0,0:11:22.37,0:11:24.80,Caption,,0,0,0,,ПОСЛЕ ЭТОГО СЛОВА О ФАКТИЧЕСКОМ ИСЧЕЗНОВЕНИИ
Dialogue: 0,0:11:24.80,0:11:27.52,Caption,,0,0,0,,НАСИЛЬСТВЕННОЙ МОБИЛИЗАЦИИ УЖЕ НИЧЕГО НЕ МЕНЯЮТ.
Dialogue: 0,0:11:27.92,0:11:30.64,Caption,,0,0,0,,ЛЮДИ ДОВЕРЯЮТ НЕ КРУГЛОЙ ЦИФРЕ В ВЫСТУПЛЕНИИ,
Dialogue: 0,0:11:30.86,0:11:34.08,Caption,,0,0,0,,А СОБСТВЕННОМУ ОПЫТУ. ЕСЛИ ВОЗЛЕ ДОМА ПРОДОЛЖАЮТ
Dialogue: 0,0:11:34.16,0:11:37.12,Caption,,0,0,0,,ИСКАТЬ МУЖЧИН, ПРЕДПРИЯТИЯ ЖДУТ ПЕРЕСМОТРА БРОНИ,
Dialogue: 0,0:11:37.36,0:11:39.60,Caption,,0,0,0,,А МОЛОДЁЖЬ ОБСУЖДАЕТ СНИЖЕНИЕ ВОЗРАСТА,
Dialogue: 0,0:11:39.94,0:11:42.16,Caption,,0,0,0,,ОФИЦИАЛЬНЫЙ НОЛЬ ВЫГЛЯДИТ НЕ ИТОГОМ,
Dialogue: 0,0:11:42.32,0:11:45.92,Caption,,0,0,0,,А ШУТКОЙ, КОТОРУЮ РАССКАЗЧИК ПОЧЕМУ ТО ПРОИЗНОСИТ С СЕРЬЁЗНЫМ
Dialogue: 0,0:11:45.92,0:11:49.76,Caption,,0,0,0,,ЛИЦОМ. САМАЯ ТЯЖЁЛАЯ УГРОЗА ДЛЯ КИЕВА СКРЫВАЕТСЯ НЕ В
Dialogue: 0,0:11:49.84,0:11:51.92,Caption,,0,0,0,,ОДНОМ СКАНДАЛЕ. ОНА ПОЯВЛЯЕТСЯ,
Dialogue: 0,0:11:52.18,0:11:54.64,Caption,,0,0,0,,КОГДА ГРАЖДАНИН СКЛАДЫВАЕТ ВСЕ ОБСТОЯТЕЛЬСТВА
Dialogue: 0,0:11:54.64,0:11:58.48,Caption,,0,0,0,,ВМЕСТЕ. ВПЕРЕДИ ЗИМА С ПЕРЕБОЯМИ ЭНЕРГИИ. ЗАЩИТУ ОТ
Dialogue: 0,0:11:58.48,0:12:01.36,Caption,,0,0,0,,МОБИЛИЗАЦИИ МОГУТ СОКРАТИТЬ. ВОЗРАСТНЫЕ РАМКИ
Dialogue: 0,0:12:01.44,0:12:04.64,Caption,,0,0,0,,СПОСОБНЫ ПЕРЕСМОТРЕТЬ. СИЛОВЫЕ И АНТИКОРРУПЦИОННЫЕ
Dialogue: 0,0:12:04.64,0:12:07.84,Caption,,0,0,0,,СТРУКТУРЫ ЗАНЯТЫ БОРЬБОЙ ДРУГ С ДРУГОМ. ПОСЛЕ ТАКОГО
Dialogue: 0,0:12:07.84,0:12:10.08,Caption,,0,0,0,,НАБОРА ВЫБОР СТАНОВИТСЯ КОРОТКИМ ЖДАТЬ,
Dialogue: 0,0:12:10.26,0:12:15.20,Caption,,0,0,0,,КАКОЕ РЕШЕНИЕ ПРИМУТ ЗА ТЕБЯ, ИЛИ УСПЕТЬ УЕХАТЬ САМОМУ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:12:15.44,0:12:18.16,Caption,,0,0,0,,ЧТО В ЭТОЙ СИТУАЦИИ СИЛЬНЕЕ ТОЛКАЕТ ЛЮДЕЙ К
Dialogue: 0,0:12:18.16,0:12:20.32,Caption,,0,0,0,,ОТЪЕЗДУ ЭНЕРГЕТИЧЕСКИЙ КРИЗИС,
Dialogue: 0,0:12:20.56,0:12:23.68,Caption,,0,0,0,,НОВЫЕ МОБИЛИЗАЦИОННЫЕ МЕРЫ ИЛИ ОЩУЩЕНИЕ,
Dialogue: 0,0:12:23.76,0:12:26.72,Caption,,0,0,0,,ЧТО ПРАВИЛА МОГУТ ИЗМЕНИТЬ В ЛЮБОЙ МОМЕНТ. ДЛЯ
Dialogue: 0,0:12:26.80,0:12:30.08,Caption,,0,0,0,,ВЛАСТИ ОТВЕТ ОСОБЕННО ВАЖЕН, ХОТЯ ПОНРАВИТСЯ ОН ЕЙ ВРЯД ЛИ.
Dialogue: 0,0:12:32.37,0:12:34.93,Caption,,0,0,0,,ТОГДА ПРОГНОЗ О ДВУХ С ПОЛОВИНОЙ МИЛЛИОНАХ ПЕРЕСТАЁТ
Dialogue: 0,0:12:34.93,0:12:38.05,Caption,,0,0,0,,БЫТЬ ПРОСТО БОЛЬШОЙ ЦИФРОЙ. ОН ПОКАЗЫВАЕТ ГРАНИЦУ,
Dialogue: 0,0:12:38.37,0:12:40.85,Caption,,0,0,0,,ЗА КОТОРОЙ МОБИЛИЗАЦИОННАЯ ПОЛИТИКА ВСТУПАЕТ В
Dialogue: 0,0:12:40.93,0:12:44.37,Caption,,0,0,0,,ПРЯМОЙ СПОР С ДЕМОГРАФИЕЙ. МОЖНО СНИЖАТЬ ВОЗРАСТ,
Dialogue: 0,0:12:44.53,0:12:49.09,Caption,,0,0,0,,ПЕРЕСМАТРИВАТЬ БРОНЬ, РАСШИРЯТЬ КАТЕГОРИИ И СОВЕРШЕНСТВОВАТЬ ПОИСК. НО
Dialogue: 0,0:12:49.09,0:12:51.41,Caption,,0,0,0,,ЧЕЛОВЕК, УЖЕ ПЕРЕСЁКШИЙ ГРАНИЦУ,
Dialogue: 0,0:12:51.65,0:12:53.65,Caption,,0,0,0,,НЕ ПОЯВИТСЯ В ВОЕНКОМАТЕ ОТТОГО,
Dialogue: 0,0:12:53.81,0:12:57.09,Caption,,0,0,0,,ЧТО ЧИНОВНИК ДОБАВИЛ НОВУЮ СТРОКУ В ПОСТАНОВЛЕНИЕ. В
Dialogue: 0,0:12:57.17,0:13:00.53,Caption,,0,0,0,,ЭТОМ И ЗАКЛЮЧАЕТСЯ БЕСПОЩАДНЫЙ ИТОГ. ЧЕМ НАСТОЙЧИВЕЕ
Dialogue: 0,0:13:00.61,0:13:03.41,Caption,,0,0,0,,ГОСУДАРСТВО ВЫЖИМАЕТ РЕСУРС ИЗ ОСТАВШИХСЯ ГРАЖДАН,
Dialogue: 0,0:13:03.80,0:13:06.77,Caption,,0,0,0,,ТЕМ БЫСТРЕЕ ЧАСТЬ ИЗ НИХ НАЧИНАЕТ СЧИТАТЬ РАССТОЯНИЕ
Dialogue: 0,0:13:06.77,0:13:09.97,Caption,,0,0,0,,ДО ГРАНИЦЫ. ВЛАСТИ ИЩУТ ДОПОЛНИТЕЛЬНЫЕ МИЛЛИОНЫ
Dialogue: 0,0:13:09.97,0:13:14.45,Caption,,0,0,0,,ЛЮДЕЙ ДЛЯ АРМИИ И ЭКОНОМИКИ, А МОГУТ ПОЛУЧИТЬ МИЛЛИОНЫ УЕХАВШИХ. И КОГДА
Dialogue: 0,0:13:14.53,0:13:16.53,Caption,,0,0,0,,ПОСЛЕДНИЙ СПЕЦИАЛИСТ ЗАКРОЕТ ЧЕМОДАН,
Dialogue: 0,0:13:16.85,0:13:19.33,Caption,,0,0,0,,ОФИЦИАЛЬНЫЙ ОТЧЁТ НАВЕРНЯКА СНОВА ПОКАЖЕТ НОЛЬ.
