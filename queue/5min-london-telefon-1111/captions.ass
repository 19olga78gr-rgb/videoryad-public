Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ПЯТЬ ЛЕТ КАК ТО ОБХОДИЛИСЬ БЕЗ ТЕЛЕФОНА. РАКЕТЫ
Dialogue: 0,0:00:02.84,0:00:04.92,Caption,,0,0,0,,ДАВАЛИ, КРАСНЫЕ ЛИНИИ ДВИГАЛИ,
Dialogue: 0,0:00:05.09,0:00:07.96,Caption,,0,0,0,,СТАВКИ ПОДНИМАЛИ. И НИКТО В ЛОНДОНЕ НЕ БЕГАЛ
Dialogue: 0,0:00:07.96,0:00:11.08,Caption,,0,0,0,,С КРИКОМ СРОЧНО СОЕДИНИТЕ НАС С МОСКВОЙ. А
Dialogue: 0,0:00:11.16,0:00:13.72,Caption,,0,0,0,,ТЕПЕРЬ ВДРУГ ПОНАДОБИЛАСЬ ПРЯМАЯ ВОЕННАЯ СВЯЗЬ.
Dialogue: 0,0:00:13.87,0:00:16.44,Caption,,0,0,0,,ПРИЧЁМ ПОНАДОБИЛАСЬ ОЧЕНЬ ВОВРЕМЯ. И ТУТ ХОЧЕТСЯ
Dialogue: 0,0:00:16.44,0:00:18.52,Caption,,0,0,0,,СПРОСИТЬ РЕБЯТА, А ЧТО ИЗМЕНИЛОСЬ?
Dialogue: 0,0:00:18.60,0:00:21.24,Caption,,0,0,0,,ПОЧЕМУ ИМЕННО СЕЙЧАС БЕЗ ЭТОГО ТЕЛЕФОНА СТАЛО ТАК
Dialogue: 0,0:00:21.24,0:00:25.16,Caption,,0,0,0,,НЕУЮТНО? ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ОТДЕЛЬНЫЕ НОВОСТИ,
Dialogue: 0,0:00:25.48,0:00:28.52,Caption,,0,0,0,,А ТО, ЧТО ПОЛУЧАЕТСЯ, КОГДА ИХ СТАВИШЬ РЯДОМ.
Dialogue: 0,0:00:29.13,0:00:31.96,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ ВЕЛИКОБРИТАНИИ УЭС СТРИТИНГ ГОВОРИТ,
Dialogue: 0,0:00:32.20,0:00:35.00,Caption,,0,0,0,,ЧТО ОДНОГО ПОСОЛЬСТВА В МОСКВЕ УЖЕ МАЛО. НУЖНЫ
Dialogue: 0,0:00:35.00,0:00:39.16,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ КАНАЛЫ, ОСОБЕННО МЕЖДУ ВОЕННЫМИ. ПРИЧИНА СФОРМУЛИРОВАНА
Dialogue: 0,0:00:39.16,0:00:42.52,Caption,,0,0,0,,КРАСИВО И АККУРАТНО РИСК ПРОСЧЁТА. САМОЛЁТЫ ЛЕТАЮТ,
Dialogue: 0,0:00:42.68,0:00:45.72,Caption,,0,0,0,,КОРАБЛИ ХОДЯТ, ГДЕ ТО МОГУТ НЕ ТАК ПОНЯТЬ СИГНАЛ,
Dialogue: 0,0:00:45.96,0:00:49.96,Caption,,0,0,0,,КТО ТО НЕ ТУДА ПОВЕРНЁТ, КТО ТО СЛИШКОМ БЛИЗКО ПОДОЙДЁТ. ПОЭТОМУ,
Dialogue: 0,0:00:50.19,0:00:54.44,Caption,,0,0,0,,МОЛ, ХОРОШО БЫ ИМЕТЬ НОМЕР, ПО КОТОРОМУ МОЖНО БЫСТРО ПОЗВОНИТЬ И ВСЁ ОБЪЯСНИТЬ.
Dialogue: 0,0:00:54.92,0:00:57.16,Caption,,0,0,0,,ВОТ ТОЛЬКО ТЕЛЕФОН ПОНАДОБИЛСЯ НА ПЯТОМ ГОДУ
Dialogue: 0,0:00:57.16,0:01:00.20,Caption,,0,0,0,,КОНФЛИКТА. ДО ЭТОГО КАК ТО СПРАВЛЯЛИСЬ. ВСЕ ЭТИ
Dialogue: 0,0:01:00.28,0:01:03.16,Caption,,0,0,0,,ГОДЫ ПЛАНКА ПОДНИМАЛАСЬ СТУПЕНЬ ЗА СТУПЕНЬЮ. ТО,
Dialogue: 0,0:01:03.27,0:01:05.40,Caption,,0,0,0,,ЧТО СНАЧАЛА СЧИТАЛОСЬ СЛИШКОМ ОПАСНЫМ,
Dialogue: 0,0:01:05.64,0:01:08.20,Caption,,0,0,0,,ПОТОМ СТАНОВИЛОСЬ НОРМОЙ. ПОСТАВКИ РОСЛИ,
Dialogue: 0,0:01:08.36,0:01:13.69,Caption,,0,0,0,,ОГРАНИЧЕНИЯ ДВИГАЛИСЬ. КРАСНАЯ ЛИНИЯ ОТОДВИГАЛАСЬ,
Dialogue: 0,0:01:13.85,0:01:17.13,Caption,,0,0,0,,А ПОТОМ ВЫЯСНЯЛОСЬ, ЧТО КРАСНАЯ ОНА БЫЛА ТОЛЬКО ДО СЛЕДУЮЩЕГО
Dialogue: 0,0:01:17.13,0:01:20.57,Caption,,0,0,0,,ПОНЕДЕЛЬНИКА. ЛОНДОН В ЭТОЙ ИСТОРИИ ТОЧНО НЕ СИДЕЛ НА
Dialogue: 0,0:01:20.57,0:01:23.21,Caption,,0,0,0,,ПОСЛЕДНЕМ РЯДУ. ДОСТАТОЧНО ВСПОМНИТЬ БОРИСА
Dialogue: 0,0:01:23.21,0:01:25.93,Caption,,0,0,0,,ДЖОНСОНА. В АПРЕЛЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА
Dialogue: 0,0:01:25.93,0:01:28.97,Caption,,0,0,0,,ОН ПРИЕХАЛ В КИЕВ, ОБЕЩАЛ НОВУЮ ВОЕННУЮ ПОМОЩЬ,
Dialogue: 0,0:01:29.21,0:01:32.41,Caption,,0,0,0,,БРОНЕТЕХНИКУ И ПРОТИВОКОРАБЕЛЬНЫЕ РАКЕТЫ. ПОЗЖЕ
Dialogue: 0,0:01:32.49,0:01:35.61,Caption,,0,0,0,,ДАВИД АРАХАМИЯ, КОТОРЫЙ ВОЗГЛАВЛЯЛ УКРАИНСКУЮ ПЕРЕГОВОРНУЮ
Dialogue: 0,0:01:35.61,0:01:39.37,Caption,,0,0,0,,ДЕЛЕГАЦИЮ, ПЕРЕСКАЗЫВАЛ ПОЗИЦИЮ ДЖОНСОНА ПОСЛЕ СТАМБУЛА ОЧЕНЬ
Dialogue: 0,0:01:39.37,0:01:42.33,Caption,,0,0,0,,ПРЯМЫМИ СЛОВАМИ НИЧЕГО С РОССИЕЙ НЕ ПОДПИСЫВАТЬ И
Dialogue: 0,0:01:42.33,0:01:45.45,Caption,,0,0,0,,ПРОДОЛЖАТЬ ВОЕВАТЬ. БРИТАНИЯ С САМОГО НАЧАЛА БЫЛА
Dialogue: 0,0:01:45.45,0:01:48.49,Caption,,0,0,0,,СРЕДИ ТЕХ, КТО ПОСЛЕДОВАТЕЛЬНО ПОДДЕРЖИВАЛ ПРОДОЛЖЕНИЕ
Dialogue: 0,0:01:48.49,0:01:51.05,Caption,,0,0,0,,ВООРУЖЁННОГО СОПРОТИВЛЕНИЯ И НАРАЩИВАНИЕ ВОЕННОЙ
Dialogue: 0,0:01:51.05,0:01:53.85,Caption,,0,0,0,,ПОМОЩИ. И ВОТ ТЕПЕРЬ ЭТОТ ЖЕ ЛОНДОН ГОВОРИТ
Dialogue: 0,0:01:53.93,0:01:56.49,Caption,,0,0,0,,ДАВАЙТЕ ВСЁ ТАКИ ЗАВЕДЁМ ПРЯМОЙ ТЕЛЕФОН. ОЧЕНЬ
Dialogue: 0,0:01:56.49,0:01:59.77,Caption,,0,0,0,,ПРЕДУСМОТРИТЕЛЬНО. КУРС НЕ МЕНЯЕТСЯ. РИТОРИКА ТОЖЕ.
Dialogue: 0,0:02:00.09,0:02:02.97,Caption,,0,0,0,,ВОЕННАЯ ПОДДЕРЖКА НИКУДА НЕ ДЕВАЕТСЯ. ПРОСТО ТЕПЕРЬ
Dialogue: 0,0:02:02.97,0:02:04.81,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО ИМЕТЬ СТРАХОВОЧНЫЙ НОМЕР,
Dialogue: 0,0:02:04.97,0:02:07.05,Caption,,0,0,0,,ЧТОБЫ В НУЖНЫЙ МОМЕНТ БЫСТРО ОБЪЯСНИТЬ,
Dialogue: 0,0:02:07.15,0:02:09.21,Caption,,0,0,0,,КТО ЧТО СДЕЛАЛ И КТО КУДА СТРЕЛЯЛ.
Dialogue: 0,0:02:09.76,0:02:12.81,Caption,,0,0,0,,ПЯТЬ ЛЕТ КРАСНЫЕ ЛИНИИ ДВИГАЛИ БЕЗ ТЕЛЕФОНА. ТЕПЕРЬ
Dialogue: 0,0:02:12.81,0:02:15.61,Caption,,0,0,0,,РЕШИЛИ ДВИГАТЬ ИХ ПО ТЕЛЕФОНУ. И СМЫСЛ ЭТОЙ
Dialogue: 0,0:02:15.61,0:02:20.57,Caption,,0,0,0,,ЗАТЕИ, НА МОЙ ВЗГЛЯД, ОЧЕНЬ ПРОСТОЙ. БРИТАНИЯ ПРОДОЛЖАЕТ ПОСТАВЛЯТЬ ОРУЖИЕ
Dialogue: 0,0:02:20.65,0:02:26.22,Caption,,0,0,0,,И ПОВЫШАТЬ СТАВКИ. НО ЕСЛИ ОТВЕТ ОДНАЖДЫ ПОЛЕТИТ УЖЕ В СТОРОНУ
Dialogue: 0,0:02:26.29,0:02:29.50,Caption,,0,0,0,,САМОЙ БРИТАНИИ, ТУТ ТЕЛЕФОН И ПРИГОДИТСЯ. РЕБЯТА,
Dialogue: 0,0:02:29.66,0:02:33.01,Caption,,0,0,0,,МЫ РАКЕТЫ ДАЛИ, НО ЗАПУСКАЛИ ИХ УКРАИНЦЫ. ВОТ С НИМИ И
Dialogue: 0,0:02:33.01,0:02:35.90,Caption,,0,0,0,,РАЗБИРАЙТЕСЬ. А НАС НЕ ТРОГАЙТЕ. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:02:35.98,0:02:38.14,Caption,,0,0,0,,СХЕМА. ДАЛЬШЕ ПОВЫШАТЬ СТАВКИ,
Dialogue: 0,0:02:38.38,0:02:40.94,Caption,,0,0,0,,А ПОСЛЕДСТВИЯ ПО ВОЗМОЖНОСТИ ОСТАВЛЯТЬ ДРУГИМ. И
Dialogue: 0,0:02:40.94,0:02:45.10,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ, ЧТО СЛЕДУЮЩИЕ НОВОСТИ СОВСЕМ НЕ ПОХОЖИ НА ПОДГОТОВКУ
Dialogue: 0,0:02:45.10,0:02:48.06,Caption,,0,0,0,,К СНИЖЕНИЮ СТАВОК. БРИТАНИЯ ВМЕСТЕ С СОЮЗНИКАМИ
Dialogue: 0,0:02:48.06,0:02:50.54,Caption,,0,0,0,,ГОТОВИТ НОВОЕ СОГЛАШЕНИЕ ПО ПРОТИВОДЕЙСТВИЮ
Dialogue: 0,0:02:50.54,0:02:52.70,Caption,,0,0,0,,РОССИЙСКИМ ПОДЛОДКАМ В СЕВЕРНОЙ АТЛАНТИКЕ,
Dialogue: 0,0:02:52.93,0:02:56.14,Caption,,0,0,0,,АРКТИКЕ И БАЛТИЙСКОМ МОРЕ. ДЕЛАЕТСЯ ЭТО В РАМКАХ
Dialogue: 0,0:02:56.14,0:02:58.62,Caption,,0,0,0,,ОБЪЕДИНЁННЫХ ЭКСПЕДИЦИОННЫХ СИЛ ПОД РУКОВОДСТВОМ
Dialogue: 0,0:02:58.62,0:03:01.58,Caption,,0,0,0,,ЛОНДОНА. В ОБЪЕДИНЕНИЕ ВХОДЯТ ДЕСЯТЬ ГОСУДАРСТВ.
Dialogue: 0,0:03:01.90,0:03:04.62,Caption,,0,0,0,,ЗАДАЧА ФОРМУЛИРУЕТСЯ ВПОЛНЕ КОНКРЕТНО ЗАЩИЩАТЬ
Dialogue: 0,0:03:04.62,0:03:07.66,Caption,,0,0,0,,СУДОХОДСТВО И УСИЛИВАТЬ ПРОТИВОЛОДОЧНУЮ ДЕЯТЕЛЬНОСТЬ
Dialogue: 0,0:03:07.74,0:03:10.70,Caption,,0,0,0,,НА СЛУЧАЙ БОЛЬШОГО КОНФЛИКТА. ПОДПИСЫВАТЬ СОГЛАШЕНИЕ
Dialogue: 0,0:03:10.70,0:03:13.34,Caption,,0,0,0,,СОБИРАЮТСЯ НА БОРТУ АВИАНОСЦА PRINCE OF WALES.
Dialogue: 0,0:03:13.73,0:03:16.14,Caption,,0,0,0,,ИМЕННО ЭТОТ КОРАБЛЬ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ
Dialogue: 0,0:03:16.22,0:03:18.70,Caption,,0,0,0,,ГОДУ СЛОМАЛСЯ ВСКОРЕ ПОСЛЕ ВЫХОДА В МОРЕ И
Dialogue: 0,0:03:18.70,0:03:21.74,Caption,,0,0,0,,НАДОЛГО ОТПРАВИЛСЯ НА РЕМОНТ. БРИТАНСКИЙ ЮМОР ЗДЕСЬ
Dialogue: 0,0:03:21.74,0:03:24.30,Caption,,0,0,0,,НАПИСАЛ СЕБЯ САМ. И ОДНОВРЕМЕННО НАЧАЛЬНИК
Dialogue: 0,0:03:24.30,0:03:27.18,Caption,,0,0,0,,БРИТАНСКОГО ШТАБА ОБОРОНЫ РИЧАРД НАЙТОН ПРИЗНАЁТ,
Dialogue: 0,0:03:27.38,0:03:30.54,Caption,,0,0,0,,ЧТО САМА БРИТАНИЯ ОТСТАЁТ ОТ ЕВРОПЕЙСКИХ СОЮЗНИКОВ В
Dialogue: 0,0:03:30.54,0:03:33.42,Caption,,0,0,0,,ГОТОВНОСТИ К ПРОТИВОСТОЯНИЮ С РОССИЕЙ И ДОЛЖНА
Dialogue: 0,0:03:33.42,0:03:39.94,Caption,,0,0,0,,ТРАТИТЬ НА ОБОРОНУ БОЛЬШЕ. ТО ЕСТЬ КАРТИНА ЗАМЕЧАТЕЛЬНАЯ. ВОЗГЛАВЛЯТЬ ХОТИМ.
Dialogue: 0,0:03:40.16,0:03:43.78,Caption,,0,0,0,,АЛЬЯНС СОБИРАТЬ ХОТИМ. ПОДЛОДКИ ИСКАТЬ ХОТИМ. А
Dialogue: 0,0:03:43.78,0:03:46.10,Caption,,0,0,0,,ГОТОВНОСТЬ СОБСТВЕННЫХ ВООРУЖЁННЫХ СИЛ ЕЩЁ НАДО
Dialogue: 0,0:03:46.10,0:03:49.70,Caption,,0,0,0,,ПОДТЯНУТЬ. НО И ЭТО ТОЛЬКО ПОЛОВИНА ИСТОРИИ. НАТО
Dialogue: 0,0:03:49.70,0:03:52.10,Caption,,0,0,0,,ДЕЛАЕТ ПРОТИВОЛОДОЧНЫЕ УЧЕНИЯ DYNAMIC MERLIN
Dialogue: 0,0:03:52.11,0:03:54.74,Caption,,0,0,0,,РЕГУЛЯРНЫМИ. УЖЕ НЕ РАЗОВАЯ ТРЕНИРОВКА,
Dialogue: 0,0:03:54.83,0:03:59.22,Caption,,0,0,0,,ПРИЕХАЛИ, ПОПЛАВАЛИ, СФОТОГРАФИРОВАЛИСЬ И РАЗЪЕХАЛИСЬ. ТЕПЕРЬ ТАКАЯ
Dialogue: 0,0:03:59.30,0:04:02.50,Caption,,0,0,0,,РАБОТА ДОЛЖНА ИДТИ ПОСТОЯННО. В БАЛТИКЕ ВОСЕМЬ СТРАН
Dialogue: 0,0:04:02.50,0:04:05.70,Caption,,0,0,0,,ОТРАБАТЫВАЮТ ПОИСК ПОДЛОДОК. ШВЕЦИЯ ВЫСТАВЛЯЕТ СВОЮ
Dialogue: 0,0:04:05.70,0:04:08.02,Caption,,0,0,0,,СУБМАРИНУ, ВЕРТОЛЁТЫ И КОРВЕТЫ,
Dialogue: 0,0:04:08.26,0:04:12.18,Caption,,0,0,0,,БРИТАНИЯ, ГЕРМАНИЯ И ФРАНЦИЯ ПОДКЛЮЧАЮТ КОРАБЛИ И АВИАЦИЮ.
Dialogue: 0,0:04:12.66,0:04:15.78,Caption,,0,0,0,,БАЛТИКА ДЛЯ ТАКОЙ ОХОТЫ МЕСТО СЛОЖНОЕ. МЕЛКОВОДЬЕ И
Dialogue: 0,0:04:15.78,0:04:18.98,Caption,,0,0,0,,НЕРОВНОЕ ДНО МЕШАЮТ ГИДРОАКУСТИКЕ. ТО ЕСТЬ РЕЧЬ ИДЁТ
Dialogue: 0,0:04:18.98,0:04:23.38,Caption,,0,0,0,,НЕ О ПАРАДЕ С ФЛАГАМИ, А О ПОСТОЯННОЙ ОТРАБОТКЕ КОНКРЕТНОЙ ВОЕННОЙ ЗАДАЧИ.
Dialogue: 0,0:04:23.54,0:04:26.50,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ТЕЛЕФОН ЛОНДОНА НАЧИНАЕТ ВЫГЛЯДЕТЬ ЕЩЁ
Dialogue: 0,0:04:26.50,0:04:28.98,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО С ОДНОЙ СТОРОНЫ ИДУТ
Dialogue: 0,0:04:29.06,0:04:31.70,Caption,,0,0,0,,РАЗГОВОРЫ О РИСКЕ ПРОСЧЁТА. А С ДРУГОЙ СТОРОНЫ
Dialogue: 0,0:04:31.70,0:04:36.18,Caption,,0,0,0,,ВОЕННЫЕ КОРАБЛИ, САМОЛЁТЫ И ПОДЛОДКИ СТАНОВЯТСЯ ВСЁ АКТИВНЕЕ ИМЕННО
Dialogue: 0,0:04:36.18,0:04:39.54,Caption,,0,0,0,,ТАМ, ГДЕ ЭТОТ САМЫЙ ПРОСЧЁТ ОДНАЖДЫ И МОЖЕТ СЛУЧИТЬСЯ.
Dialogue: 0,0:04:39.89,0:04:42.50,Caption,,0,0,0,,ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ. СНАЧАЛА УВЕЛИЧИВАЕМ
Dialogue: 0,0:04:42.50,0:04:44.82,Caption,,0,0,0,,КОЛИЧЕСТВО ЛЮДЕЙ С ОРУЖИЕМ В ОДНОЙ КОМНАТЕ,
Dialogue: 0,0:04:45.06,0:04:47.54,Caption,,0,0,0,,А ПОТОМ СТАВИМ НА СТЕНЕ ТЕЛЕФОН ПОЖАРНОЙ СЛУЖБЫ.
Dialogue: 0,0:04:47.70,0:04:52.86,Caption,,0,0,0,,НА ВСЯКИЙ СЛУЧАЙ. А БРИТАНИЯ ТЕМ ВРЕМЕНЕМ ГОТОВИТСЯ ЕЩЁ И К
Dialogue: 0,0:04:52.86,0:04:56.06,Caption,,0,0,0,,БОЛЬШОМУ ОТКЛЮЧЕНИЮ ЭЛЕКТРИЧЕСТВА. ПЛАН НАЗЫВАЕТСЯ
Dialogue: 0,0:04:56.06,0:04:59.10,Caption,,0,0,0,,"ЧЁРНОЕ НЕБО". БРИТАНСКИЕ ВЛАСТИ ПРЕДУСМОТРЕЛИ
Dialogue: 0,0:04:59.10,0:05:02.30,Caption,,0,0,0,,РЕЗЕРВНОЕ РАДИОВЕЩАНИЕ НА ТРОЕ СУТОК. НАСЕЛЕНИЮ
Dialogue: 0,0:05:02.30,0:05:06.54,Caption,,0,0,0,,СОВЕТУЮТ ИМЕТЬ ВОДУ, ПРОДУКТЫ И ЛЕКАРСТВА МИНИМУМ НА ТРИ ДНЯ. НА
Dialogue: 0,0:05:06.54,0:05:09.34,Caption,,0,0,0,,ЛЕТАЮЩИЕ ВЫШКИ СВЯЗИ ВЫДЕЛЯЮТ СЕМЬДЕСЯТ МИЛЛИОНОВ
Dialogue: 0,0:05:09.34,0:05:12.30,Caption,,0,0,0,,ФУНТОВ. ОНИ ДОЛЖНЫ ПОДДЕРЖИВАТЬ МОБИЛЬНУЮ СЕТЬ ДО
Dialogue: 0,0:05:12.30,0:05:15.58,Caption,,0,0,0,,НЕДЕЛИ, ЕСЛИ ОБЫЧНАЯ ИНФРАСТРУКТУРА ПЕРЕСТАНЕТ РАБОТАТЬ.
Dialogue: 0,0:05:16.06,0:05:18.46,Caption,,0,0,0,,НИЧЕГО СЕБЕ НАБОР НА СЛУЧАЙ ОБЫЧНОГО СПОКОЙНОГО
Dialogue: 0,0:05:18.46,0:05:21.18,Caption,,0,0,0,,ВТОРНИКА. НО РЯДОМ С ЗАЯВЛЕНИЯМИ НАЙТОНА,
Dialogue: 0,0:05:21.26,0:05:25.58,Caption,,0,0,0,,МОРСКИМ АЛЬЯНСОМ, ПРОТИВОЛОДОЧНЫМИ УЧЕНИЯМИ И ВНЕЗАПНОЙ ПОТРЕБНОСТЬЮ В
Dialogue: 0,0:05:25.58,0:05:28.06,Caption,,0,0,0,,ПРЯМОМ ВОЕННОМ ТЕЛЕФОНЕ ЭТО УЖЕ НЕ ВЫГЛЯДИТ КАК
Dialogue: 0,0:05:28.06,0:05:31.34,Caption,,0,0,0,,ОДИН ЗАБЫТЫЙ ФАЙЛ В ШКАФУ. ЛОНДОН ПОВЫШАЕТ ВОЕННУЮ
Dialogue: 0,0:05:31.34,0:05:33.26,Caption,,0,0,0,,АКТИВНОСТЬ И ОДНОВРЕМЕННО СЧИТАЕТ,
Dialogue: 0,0:05:33.55,0:05:35.34,Caption,,0,0,0,,СКОЛЬКО ЧАСОВ ПРОДЕРЖИТСЯ РАДИО,
Dialogue: 0,0:05:35.51,0:05:38.54,Caption,,0,0,0,,СКОЛЬКО ДНЕЙ ПРОЖИВЁТ МОБИЛЬНАЯ СВЯЗЬ И СКОЛЬКО ВОДЫ
Dialogue: 0,0:05:38.62,0:05:41.74,Caption,,0,0,0,,НАДО ИМЕТЬ ДОМА. ВОТ ТАКАЯ НЫНЧЕ УВЕРЕННОСТЬ. ЕСЛИ
Dialogue: 0,0:05:41.74,0:05:45.58,Caption,,0,0,0,,ВАМ ПОЛЕЗЕН ТАКОЙ РАЗБОР, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:05:45.82,0:05:47.90,Caption,,0,0,0,,КОГДА ОДНА НОВОСТЬ НИЧЕГО НЕ ОБЪЯСНЯЕТ,
Dialogue: 0,0:05:48.14,0:05:50.54,Caption,,0,0,0,,А ДЕСЯТЬ НАЧИНАЮТ РАЗГОВАРИВАТЬ ДРУГ С ДРУГОМ.
Dialogue: 0,0:05:50.76,0:05:52.78,Caption,,0,0,0,,ФИНЛЯНДИЯ ТОЖЕ НЕ СИДИТ И НЕ ЖДЁТ,
Dialogue: 0,0:05:52.94,0:05:55.98,Caption,,0,0,0,,ЧЕМ ВСЁ ЗАКОНЧИТСЯ. ФИНСКИЕ ВОЕННЫЕ ИЗУЧАЮТ
Dialogue: 0,0:05:55.98,0:05:58.78,Caption,,0,0,0,,УКРАИНСКИЙ ОПЫТ СТРОИТЕЛЬСТВА ПРОТИВОТАНКОВЫХ РВОВ И
Dialogue: 0,0:05:58.78,0:06:04.58,Caption,,0,0,0,,ЗАГРАЖДЕНИЙ. КОМАНДУЮЩИЙ СУХОПУТНЫМИ ВОЙСКАМИ ПАССИ ВЯЛИМЯКИ
Dialogue: 0,0:06:04.58,0:06:08.42,Caption,,0,0,0,,ПРЯМО ГОВОРИТ, ЧТО ЭТИ РЕШЕНИЯ СОБИРАЮТСЯ АДАПТИРОВАТЬ К СЕВЕРНОМУ
Dialogue: 0,0:06:08.42,0:06:11.70,Caption,,0,0,0,,КЛИМАТУ. ГРАНИЦА ФИНЛЯНДИИ С РОССИЕЙ ОГРОМНАЯ,
Dialogue: 0,0:06:11.79,0:06:15.14,Caption,,0,0,0,,ОКОЛО ОДНОЙ ТЫСЯЧИ ТРЁХСОТ СОРОКА КИЛОМЕТРОВ. ФИННЫ
Dialogue: 0,0:06:15.22,0:06:17.30,Caption,,0,0,0,,УЖЕ ПОСТРОИЛИ ПРИМЕРНО ДВЕСТИ КИЛОМЕТРОВ
Dialogue: 0,0:06:17.30,0:06:20.02,Caption,,0,0,0,,ПОГРАНИЧНОГО ЗАГРАЖДЕНИЯ СТОИМОСТЬЮ ОКОЛО ТРЁХСОТ
Dialogue: 0,0:06:20.02,0:06:22.82,Caption,,0,0,0,,ШЕСТИДЕСЯТИ ПЯТИ МИЛЛИОНОВ ЕВРО. ТЕПЕРЬ ИЗУЧАЮТ,
Dialogue: 0,0:06:23.14,0:06:25.86,Caption,,0,0,0,,КАК ДОБАВИТЬ К ЭТОМУ ИНЖЕНЕРНУЮ ОБОРОНУ УЖЕ СОВСЕМ
Dialogue: 0,0:06:25.86,0:06:28.82,Caption,,0,0,0,,ДРУГОГО УРОВНЯ. ТО ЕСТЬ ПОКА ПОЛИТИКИ РАССУЖДАЮТ О
Dialogue: 0,0:06:28.82,0:06:31.86,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ВОЕННЫЕ БЕРУТ УКРАИНСКИЙ ОПЫТ,
Dialogue: 0,0:06:32.11,0:06:34.90,Caption,,0,0,0,,СМОТРЯТ, КАК УСТРОЕНЫ РВЫ, И ДУМАЮТ,
Dialogue: 0,0:06:35.01,0:06:36.90,Caption,,0,0,0,,КАК ВСЁ ЭТО БУДЕТ РАБОТАТЬ В СНЕГУ И
Dialogue: 0,0:06:36.98,0:06:38.90,Caption,,0,0,0,,МОРОЗЕ. И ОПЯТЬ ВОПРОС НЕ В ТОМ,
Dialogue: 0,0:06:39.06,0:06:41.30,Caption,,0,0,0,,ВЕРИТ ЛИ КТО ТО В НАПАДЕНИЕ ЗАВТРА УТРОМ.
Dialogue: 0,0:06:41.62,0:06:44.66,Caption,,0,0,0,,ВОПРОС В НАПРАВЛЕНИИ ДВИЖЕНИЯ. НИКТО ЗДЕСЬ НЕ
Dialogue: 0,0:06:44.74,0:06:47.30,Caption,,0,0,0,,РАЗБИРАЕТ УКРЕПЛЕНИЯ. ИХ СТРОЯТ. НИКТО НЕ
Dialogue: 0,0:06:47.30,0:06:50.18,Caption,,0,0,0,,СВОРАЧИВАЕТ ПРОТИВОЛОДОЧНУЮ АКТИВНОСТЬ. ЕЁ ДЕЛАЮТ
Dialogue: 0,0:06:50.18,0:06:52.66,Caption,,0,0,0,,ПОСТОЯННОЙ. НИКТО В ЛОНДОНЕ НЕ ГОВОРИТ,
Dialogue: 0,0:06:52.90,0:06:55.78,Caption,,0,0,0,,ЧТО ПОРА СНИЗИТЬ СТАВКИ. ЛОНДОН ХОЧЕТ ТЕЛЕФОН.
Dialogue: 0,0:06:56.10,0:06:59.06,Caption,,0,0,0,,ДАЛЬШЕ СТАНОВИТСЯ ЕЩЁ ВЕСЕЛЕЕ. LE MONDE ПИШЕТ,
Dialogue: 0,0:06:59.23,0:07:01.94,Caption,,0,0,0,,ЧТО ЕВРОПЕЙЦЫ ВСЁ ОСТРЕЕ СТАЛКИВАЮТСЯ С ВЫБОРОМ
Dialogue: 0,0:07:01.94,0:07:04.74,Caption,,0,0,0,,МЕЖДУ МАСЛОМ И ПУШКАМИ. СТАРОЕ ВЫРАЖЕНИЕ,
Dialogue: 0,0:07:04.98,0:07:08.10,Caption,,0,0,0,,НО СЧЁТ ПРИШЁЛ ВПОЛНЕ СОВРЕМЕННЫЙ. ВОЕННЫЕ РАСХОДЫ
Dialogue: 0,0:07:08.10,0:07:10.50,Caption,,0,0,0,,РАСТУТ, ПОМОЩЬ УКРАИНЕ СТОИТ ДЕНЕГ,
Dialogue: 0,0:07:10.75,0:07:12.42,Caption,,0,0,0,,ИНФЛЯЦИЯ НИКУДА НЕ ИСПАРИЛАСЬ,
Dialogue: 0,0:07:12.66,0:07:15.22,Caption,,0,0,0,,ПОКУПАТЕЛЬНАЯ СПОСОБНОСТЬ ЛЮДЕЙ ТОЖЕ НЕ СТАЛА ВДРУГ
Dialogue: 0,0:07:15.22,0:07:19.50,Caption,,0,0,0,,ЖЕЛЕЗНОЙ. ПОВЫШАТЬ СТАВКИ УДОБНО,
Dialogue: 0,0:07:19.58,0:07:21.90,Caption,,0,0,0,,ПОКА СЧЁТ ЛЕЖИТ НА СТОЛЕ У МИНИСТРА ФИНАНСОВ.
Dialogue: 0,0:07:22.44,0:07:24.54,Caption,,0,0,0,,КОГДА ОН ПРИЕЗЖАЕТ ДОМОЙ В ВИДЕ ЦЕН,
Dialogue: 0,0:07:24.77,0:07:29.42,Caption,,0,0,0,,НАЛОГОВ И УРЕЗАННЫХ РАСХОДОВ, РАЗГОВОР СТАНОВИТСЯ МЕНЕЕ ГЕРОИЧЕСКИМ. ПУШКИ
Dialogue: 0,0:07:29.50,0:07:33.02,Caption,,0,0,0,,ВНУШАЮТ. НО МАСЛО ЧЕЛОВЕК ВИДИТ КАЖДОЕ УТРО. ПРИ
Dialogue: 0,0:07:33.02,0:07:36.14,Caption,,0,0,0,,ЭТОМ ДАВЛЕНИЕ ИДЁТ НЕ ТОЛЬКО ЧЕРЕЗ ВООРУЖЕНИЯ. ЛИТВА
Dialogue: 0,0:07:36.14,0:07:38.70,Caption,,0,0,0,,РЕШИЛА ЗАДЕРЖИВАТЬ РОССИЙСКОЕ И БЕЛОРУССКОЕ ЗЕРНО,
Dialogue: 0,0:07:38.86,0:07:43.50,Caption,,0,0,0,,КОТОРОЕ ИДЁТ ЧЕРЕЗ КЛАЙПЕДУ, ДО ЗАВЕРШЕНИЯ ПРОВЕРКИ ПРОИСХОЖДЕНИЯ. ПРОВЕРКА
Dialogue: 0,0:07:43.50,0:07:46.22,Caption,,0,0,0,,СПОСОБНА ЗАНЯТЬ ДВА МЕСЯЦА И БОЛЬШЕ. ПРИЧИНА
Dialogue: 0,0:07:46.22,0:07:48.78,Caption,,0,0,0,,ОСОБЕННО ПРЕКРАСНА СВОЕЙ БЮРОКРАТИЧЕСКОЙ ЧИСТОТОЙ
Dialogue: 0,0:07:48.78,0:07:51.26,Caption,,0,0,0,,СОБСТВЕННОЙ ЛАБОРАТОРИИ ДЛЯ ТАКИХ АНАЛИЗОВ У ЛИТВЫ
Dialogue: 0,0:07:51.26,0:07:54.62,Caption,,0,0,0,,НЕТ, ПОЭТОМУ ОБРАЗЦЫ ОТПРАВЛЯЮТ ЗА ГРАНИЦУ. ТО ЕСТЬ
Dialogue: 0,0:07:54.62,0:07:57.18,Caption,,0,0,0,,ТРАНЗИТ ФОРМАЛЬНО РАЗРЕШЁН. НИКТО НИЧЕГО НЕ
Dialogue: 0,0:07:57.18,0:08:00.46,Caption,,0,0,0,,ЗАПРЕЩАЛ. ПРОСТО ЗЕРНО ПОСТОИТ ПАРУ МЕСЯЦЕВ. ЗА
Dialogue: 0,0:08:00.46,0:08:03.66,Caption,,0,0,0,,ХРАНЕНИЕ ЗАПЛАТИТ ЭКСПОРТЁР. ЗА ТЕСТ ТОЖЕ. ЕСЛИ
Dialogue: 0,0:08:03.66,0:08:05.82,Caption,,0,0,0,,ПРОИСХОЖДЕНИЕ ПРИЗНАЮТ НЕВЕРНО УКАЗАННЫМ,
Dialogue: 0,0:08:05.99,0:08:08.86,Caption,,0,0,0,,ГРУЗ ПРИДЁТСЯ ВЕРНУТЬ ИЛИ УНИЧТОЖИТЬ. ЗАПРЕТА НЕТ.
Dialogue: 0,0:08:09.19,0:08:12.38,Caption,,0,0,0,,ЕСТЬ ОЧЕНЬ ДЛИННАЯ ОЧЕРЕДЬ К ОКОШКУ. ВОЕННЫЕ СТРОЯТ
Dialogue: 0,0:08:12.46,0:08:17.42,Caption,,0,0,0,,РВЫ, МОРЯКИ ИЩУТ ПОДЛОДКИ, ЧИНОВНИКИ ИЩУТ ЛАБОРАТОРИЮ. КАЖДЫЙ ЗАНЯТ СВОИМ
Dialogue: 0,0:08:17.42,0:08:20.30,Caption,,0,0,0,,ФРОНТОМ. А В ЭСТОНИИ ДОШЛО УЖЕ ДО ХОЛОДИЛЬНИКОВ.
Dialogue: 0,0:08:22.58,0:08:25.62,Caption,,0,0,0,,ГЛАВА МВД ИГОРЬ ТАРО ОБВИНИЛ РОССИЮ В ДИВЕРСИЯХ
Dialogue: 0,0:08:25.70,0:08:28.50,Caption,,0,0,0,,И ПРИВЁЛ СРЕДИ ПРИМЕРОВ КИБЕРАТАКИ НА СУПЕРМАРКЕТЫ,
Dialogue: 0,0:08:28.74,0:08:31.38,Caption,,0,0,0,,ПОСЛЕ КОТОРЫХ В НЕСКОЛЬКИХ ЕВРОПЕЙСКИХ СТРАНАХ ВЫШЛИ
Dialogue: 0,0:08:31.38,0:08:34.42,Caption,,0,0,0,,ИЗ НОРМАЛЬНОГО РЕЖИМА ХОЛОДИЛЬНЫЕ СИСТЕМЫ. ПРИ ЭТОМ
Dialogue: 0,0:08:34.50,0:08:36.58,Caption,,0,0,0,,В САМОМ СООБЩЕНИИ ОТДЕЛЬНО ПРИЗНАЁТСЯ,
Dialogue: 0,0:08:36.83,0:08:39.71,Caption,,0,0,0,,ЧТО ДОКАЗАТЕЛЬСТВ ПРИЧАСТНОСТИ МОСКВЫ ИМЕННО К ЭТИМ
Dialogue: 0,0:08:39.71,0:08:43.22,Caption,,0,0,0,,АТАКАМ НЕТ. НО ФОРМУЛИРОВКИ УЖЕ ТЯЖЁЛЫЕ. РОССИЯ
Dialogue: 0,0:08:43.22,0:08:44.98,Caption,,0,0,0,,НАЗВАНА ГЛАВНОЙ УГРОЗОЙ ЕВРОПЕ,
Dialogue: 0,0:08:45.30,0:08:47.54,Caption,,0,0,0,,ЗВУЧАТ СЛОВА О ГОСУДАРСТВЕННОМ ТЕРРОРИЗМЕ,
Dialogue: 0,0:08:47.73,0:08:50.74,Caption,,0,0,0,,КРИТИЧЕСКОЙ ИНФРАСТРУКТУРЕ И ПОСТОЯННЫХ АТАКАХ НИЖЕ
Dialogue: 0,0:08:50.83,0:08:53.22,Caption,,0,0,0,,ВОЕННОГО ПОРОГА. ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ
Dialogue: 0,0:08:53.30,0:08:56.42,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ АРИФМЕТИКА. ДОКАЗАТЕЛЬСТВ ПО КОНКРЕТНОМУ
Dialogue: 0,0:08:56.42,0:08:59.22,Caption,,0,0,0,,ЭПИЗОДУ НЕТ, А ПОЛИТИЧЕСКИЙ ВЫВОД УЖЕ ПРИЕХАЛ,
Dialogue: 0,0:08:59.38,0:09:02.58,Caption,,0,0,0,,ПРИПАРКОВАЛСЯ И ДАЖЕ ДВИГАТЕЛЬ ЗАГЛУШИЛ. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:09:02.58,0:09:05.22,Caption,,0,0,0,,ЕВРОСОЮЗ РАЗБИРАЕТСЯ С ИНФОРМАЦИОННЫМ ФРОНТОМ ВО
Dialogue: 0,0:09:05.30,0:09:07.54,Caption,,0,0,0,,ФРАНЦИИ. ВО ВНУТРЕННЕМ ДОКЛАДЕ ЕС,
Dialogue: 0,0:09:07.74,0:09:11.95,Caption,,0,0,0,,КОТОРЫЙ ИЗУЧИЛ REUTERS, ГОВОРИТСЯ О СЕТИ "ОПЕРАЦИЯ ПЕРЕГРУЗКА". ЕЙ
Dialogue: 0,0:09:11.95,0:09:13.95,Caption,,0,0,0,,ПРИПИСЫВАЮТ РАСПРОСТРАНЕНИЕ ПОДДЕЛЬНЫХ
Dialogue: 0,0:09:13.95,0:09:16.58,Caption,,0,0,0,,ВИДЕОРЕПОРТАЖЕЙ ЗАПАДНЫХ СМИ НА ФОНЕ ФРАНЦУЗСКИХ
Dialogue: 0,0:09:16.58,0:09:19.71,Caption,,0,0,0,,БЕСПОРЯДКОВ. В ЭТИХ МАТЕРИАЛАХ РАЗГОНЯЛИСЬ ИСТОРИИ О
Dialogue: 0,0:09:19.71,0:09:23.86,Caption,,0,0,0,,МИГРАНТАХ, НАСИЛИИ И ГОТОВЯЩИХСЯ АТАКАХ. НО ТАМ ЕСТЬ ОДНА
Dialogue: 0,0:09:23.88,0:09:27.30,Caption,,0,0,0,,ОЧЕНЬ ПОЛЕЗНАЯ ЦИФРА. ЗА НЕСКОЛЬКО ДНЕЙ ДЕСЯТЬ САМЫХ
Dialogue: 0,0:09:27.30,0:09:29.14,Caption,,0,0,0,,ПОПУЛЯРНЫХ ПУБЛИКАЦИЙ АККАУНТОВ,
Dialogue: 0,0:09:29.28,0:09:33.54,Caption,,0,0,0,,СВЯЗАННЫХ С ДВИЖЕНИЕМ MAGA, НАБРАЛИ СОРОК ДЕВЯТЬ МИЛЛИОНОВ ПРОСМОТРОВ.
Dialogue: 0,0:09:35.83,0:09:38.07,Caption,,0,0,0,,ИЗРАИЛЬСКИЕ АККАУНТЫ НАБРАЛИ ТРИДЦАТЬ ПЯТЬ
Dialogue: 0,0:09:38.07,0:09:41.35,Caption,,0,0,0,,МИЛЛИОНОВ. ПРОРОССИЙСКИЕ, ПО ДАННЫМ ТОГО ЖЕ МАТЕРИАЛА,
Dialogue: 0,0:09:41.64,0:09:44.55,Caption,,0,0,0,,ДВА ЦЕЛЫХ ВОСЕМЬ ДЕСЯТЫХ МИЛЛИОНА. И ЕЩЁ ОДНА
Dialogue: 0,0:09:44.55,0:09:49.35,Caption,,0,0,0,,ДЕТАЛЬ. ДОКАЗАТЕЛЬСТВ ТОГО, ЧТО ИНОСТРАННЫЕ СИЛЫ ОРГАНИЗОВАЛИ САМИ ФРАНЦУЗСКИЕ
Dialogue: 0,0:09:49.35,0:09:52.31,Caption,,0,0,0,,ПРОТЕСТЫ ИЛИ РАЗОГНАЛИ ИХ ДО НЫНЕШНЕГО МАСШТАБА,
Dialogue: 0,0:09:52.55,0:09:55.51,Caption,,0,0,0,,ЭКСПЕРТЫ НЕ НАШЛИ. ФРАНЦУЗСКАЯ УЛИЦА И БЕЗ ВСЯКОЙ
Dialogue: 0,0:09:55.51,0:09:57.83,Caption,,0,0,0,,МОСКВЫ УМЕЕТ УСТРАИВАТЬ ПРАВИТЕЛЬСТВУ ТЯЖЁЛЫЕ
Dialogue: 0,0:09:57.83,0:10:00.87,Caption,,0,0,0,,ВЕЧЕРА. У ЛЮДЕЙ СВОИ ЦЕНЫ, ЗАРПЛАТЫ,
Dialogue: 0,0:10:00.93,0:10:04.15,Caption,,0,0,0,,ШКОЛЫ И ПРЕТЕНЗИИ К ВЛАСТИ. ЕСЛИ СОБСТВЕННЫЙ ДОМ
Dialogue: 0,0:10:04.15,0:10:07.59,Caption,,0,0,0,,ТРЕЩИТ, СТРАННО ОБЪЯСНЯТЬ КАЖДУЮ ТРЕЩИНУ СОСЕДОМ ЧЕРЕЗ
Dialogue: 0,0:10:07.59,0:10:10.07,Caption,,0,0,0,,ДОРОГУ. А ТЕПЕРЬ ДОБАВИМ К ЭТОМУ РАКЕТНУЮ
Dialogue: 0,0:10:10.07,0:10:12.23,Caption,,0,0,0,,АРИФМЕТИКУ. BLOOMBERG СООБЩАЕТ,
Dialogue: 0,0:10:12.39,0:10:15.27,Caption,,0,0,0,,ЧТО РОССИЯ ПРОИЗВОДИТ БАЛЛИСТИЧЕСКИЕ РАКЕТЫ БЫСТРЕЕ,
Dialogue: 0,0:10:15.44,0:10:18.31,Caption,,0,0,0,,ЧЕМ ВСЕ ПРОИЗВОДИТЕЛИ ПЕРЕХВАТЧИКОВ PATRIOT УСПЕВАЮТ
Dialogue: 0,0:10:18.31,0:10:21.03,Caption,,0,0,0,,ВЫПУСКАТЬ РАКЕТЫ ДЛЯ ЭТИХ КОМПЛЕКСОВ. ОБЕЩАНИЕ
Dialogue: 0,0:10:21.11,0:10:23.35,Caption,,0,0,0,,ДОНАЛЬДА ТРАМПА ВЫДАТЬ ЛИЦЕНЗИИ НА ПРОИЗВОДСТВО
Dialogue: 0,0:10:23.35,0:10:25.99,Caption,,0,0,0,,ПЕРЕХВАТЧИКОВ НЕПОСРЕДСТВЕННО НА УКРАИНЕ ПОКА НЕ
Dialogue: 0,0:10:25.99,0:10:29.03,Caption,,0,0,0,,РЕАЛИЗОВАНО. ЕВРОПЕЙСКАЯ ПРОГРАММА ДЕШЁВЫХ СИСТЕМ
Dialogue: 0,0:10:29.03,0:10:31.67,Caption,,0,0,0,,ПВО, ОБЪЯВЛЕННАЯ ПЯТЬЮ КРУПНЫМИ СТРАНАМИ,
Dialogue: 0,0:10:31.99,0:10:33.75,Caption,,0,0,0,,ТОЖЕ ПОКА НЕ ДАЛА ТОГО РЕЗУЛЬТАТА,
Dialogue: 0,0:10:33.91,0:10:36.71,Caption,,0,0,0,,КОТОРЫЙ ЗАКРЫЛ БЫ ЭТОТ РАЗРЫВ. И ТУТ "МАСЛО
Dialogue: 0,0:10:36.71,0:10:39.67,Caption,,0,0,0,,И ПУШКИ" ПРЕВРАЩАЕТСЯ В АРИФМЕТИКУ. МАЛО РЕШИТЬ
Dialogue: 0,0:10:39.67,0:10:42.39,Caption,,0,0,0,,ТРАТИТЬ БОЛЬШЕ. НАДО ЕЩЁ ПРОИЗВЕСТИ ТО,
Dialogue: 0,0:10:42.57,0:10:45.35,Caption,,0,0,0,,ЧТО СОБИРАЕШЬСЯ ПОКУПАТЬ. ДЕНЬГИ МОЖНО ПРОГОЛОСОВАТЬ
Dialogue: 0,0:10:45.35,0:10:47.91,Caption,,0,0,0,,ЗА ВЕЧЕР. ЗАВОД ЗА ВЕЧЕР НЕ ПОЯВЛЯЕТСЯ.
Dialogue: 0,0:10:50.10,0:10:53.70,Caption,,0,0,0,,ИТАК, ВОЕННАЯ АКТИВНОСТЬ НА МОРЕ РАСТЁТ. ФИНЛЯНДИЯ СТРОИТ
Dialogue: 0,0:10:53.70,0:10:57.06,Caption,,0,0,0,,ЗАГРАЖДЕНИЯ. БРИТАНИЯ ГОТОВИТСЯ К БЛЭКАУТУ. ЛИТВА
Dialogue: 0,0:10:57.06,0:11:00.02,Caption,,0,0,0,,ТОРМОЗИТ ТРАНЗИТ. ЭСТОНИЯ ГОВОРИТ О КИБЕРУГРОЗАХ.
Dialogue: 0,0:11:00.26,0:11:04.82,Caption,,0,0,0,,ВОЕННЫЕ РАСХОДЫ РАСТУТ, А ПРОИЗВОДСТВО ПВО НЕ ПОСПЕВАЕТ. И ПОСЛЕ ВСЕГО
Dialogue: 0,0:11:04.82,0:11:07.94,Caption,,0,0,0,,ЭТОГО ВЫХОДИТ ПРЕМЬЕР НОРВЕГИИ ЙОНАС ГАР СТЁРЕ И
Dialogue: 0,0:11:07.94,0:11:11.46,Caption,,0,0,0,,ГОВОРИТ ВЕЩЬ, КОТОРАЯ ЕЩЁ ПАРУ ЛЕТ НАЗАД В ЕВРОПЕЙСКОЙ ПОЛИТИКЕ
Dialogue: 0,0:11:11.54,0:11:14.26,Caption,,0,0,0,,ЗВУЧАЛА БЫ ОЧЕНЬ НЕЛОВКО. ИЗОЛИРОВАТЬ РОССИЮ НЕ
Dialogue: 0,0:11:14.26,0:11:18.90,Caption,,0,0,0,,ПОЛУЧИЛОСЬ. БОЛЕЕ ТОГО, ОТКАЗ ЕВРОПЫ ОТ ПРЯМОГО РАЗГОВОРА С МОСКВОЙ ПРИВЁЛ
Dialogue: 0,0:11:18.98,0:11:21.94,Caption,,0,0,0,,К ТОМУ, ЧТО РОССИЙСКОЕ РУКОВОДСТВО СЛЫШИТ ПРЕЖДЕ ВСЕГО
Dialogue: 0,0:11:21.94,0:11:25.62,Caption,,0,0,0,,ВАШИНГТОН. ВОТ ЭТО УЖЕ ДЕЙСТВИТЕЛЬНО КРАСИВО. ЕВРОПА
Dialogue: 0,0:11:25.70,0:11:29.46,Caption,,0,0,0,,ПЯТЬ ЛЕТ ОБЪЯСНЯЛА, ЧТО РАЗГОВАРИВАТЬ С МОСКВОЙ ПОЧТИ НЕПРИЛИЧНО.
Dialogue: 0,0:11:29.59,0:11:32.26,Caption,,0,0,0,,КОНТАКТЫ СОКРАЩАЛИ, КАНАЛЫ ЗАКРЫВАЛИ,
Dialogue: 0,0:11:32.42,0:11:34.34,Caption,,0,0,0,,ПРЯМЫЕ РАЗГОВОРЫ ПРЕВРАЩАЛИ ЧУТЬ ЛИ НЕ В
Dialogue: 0,0:11:34.34,0:11:36.90,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ПРОСТУПОК. А ТЕПЕРЬ ОБНАРУЖИЛОСЬ,
Dialogue: 0,0:11:37.14,0:11:39.62,Caption,,0,0,0,,ЧТО ЕСЛИ ТЫ САМ ПЕРЕСТАЛ ЗВОНИТЬ ЧЕЛОВЕКУ,
Dialogue: 0,0:11:39.86,0:11:41.94,Caption,,0,0,0,,ТО ОН НАЧИНАЕТ РАЗГОВАРИВАТЬ С ТЕМ,
Dialogue: 0,0:11:42.03,0:11:44.98,Caption,,0,0,0,,КТО ЗВОНИТ. УДИВИТЕЛЬНАЯ ТЕХНОЛОГИЯ. И ТЕПЕРЬ
Dialogue: 0,0:11:44.98,0:11:47.70,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТОЛИЦЫ СМОТРЯТ НА ПЕРЕГОВОРНЫЙ ПРОЦЕСС
Dialogue: 0,0:11:47.76,0:11:50.66,Caption,,0,0,0,,И ВИДЯТ ТАМ АМЕРИКАНЦЕВ. ВАШИНГТОН РАЗГОВАРИВАЕТ С
Dialogue: 0,0:11:50.66,0:11:53.46,Caption,,0,0,0,,МОСКВОЙ. ФРАНЦИЯ ПЫТАЕТСЯ ВЛЕЗТЬ В ПЕРЕГОВОРНЫЙ
Dialogue: 0,0:11:53.46,0:11:56.26,Caption,,0,0,0,,ФОРМАТ. БРИТАНИЯ ВНЕЗАПНО ВСПОМИНАЕТ О ПРЯМОЙ
Dialogue: 0,0:11:56.26,0:11:59.94,Caption,,0,0,0,,ВОЕННОЙ СВЯЗИ. СТЁРЕ ГОВОРИТ, ЧТО ИЗОЛЯЦИЯ НЕ СРАБОТАЛА.
Dialogue: 0,0:12:02.22,0:12:04.46,Caption,,0,0,0,,И ВСЁ ЭТО ПРОИСХОДИТ НЕ НА ФОНЕ СВОРАЧИВАНИЯ
Dialogue: 0,0:12:04.46,0:12:07.42,Caption,,0,0,0,,ВОЕННОЙ ПОДГОТОВКИ. НАОБОРОТ. ПОДЛОДКИ ИЩУТ
Dialogue: 0,0:12:07.42,0:12:10.06,Caption,,0,0,0,,АКТИВНЕЕ, УКРЕПЛЕНИЯ СТРОЯТ СЕРЬЁЗНЕЕ,
Dialogue: 0,0:12:10.22,0:12:12.70,Caption,,0,0,0,,БЮДЖЕТЫ ХОТЯТ УВЕЛИЧИВАТЬ. ТО ЕСТЬ ЕВРОПА
Dialogue: 0,0:12:12.70,0:12:15.02,Caption,,0,0,0,,ОДНОВРЕМЕННО НАЖИМАЕТ НА ГАЗ И СПРАШИВАЕТ,
Dialogue: 0,0:12:15.25,0:12:18.22,Caption,,0,0,0,,ГДЕ ЗДЕСЬ ТОРМОЗ. А ЛОНДОН НАШЁЛ СВОЙ ВАРИАНТ.
Dialogue: 0,0:12:18.38,0:12:21.50,Caption,,0,0,0,,ТЕЛЕФОН. НЕ ОТКАЗ ОТ ПРЕЖНЕЙ ЛИНИИ. НЕ СМЕНА
Dialogue: 0,0:12:21.50,0:12:24.46,Caption,,0,0,0,,РИТОРИКИ. НЕ РАЗВОРОТ НА СТО ВОСЕМЬДЕСЯТ ГРАДУСОВ.
Dialogue: 0,0:12:24.61,0:12:26.78,Caption,,0,0,0,,ПРОСТО ДОПОЛНИТЕЛЬНЫЙ ИНСТРУМЕНТ НА СЛУЧАЙ,
Dialogue: 0,0:12:27.02,0:12:29.74,Caption,,0,0,0,,ЕСЛИ ОЧЕРЕДНОЙ ШАГ ОКАЖЕТСЯ УЖЕ СЛИШКОМ БЛИЗКО К
Dialogue: 0,0:12:29.74,0:12:32.54,Caption,,0,0,0,,ПРЯМОМУ СТОЛКНОВЕНИЮ. И ЗДЕСЬ ИТОГ УЖЕ НЕ ПРО
Dialogue: 0,0:12:32.54,0:12:35.74,Caption,,0,0,0,,КОЛИЧЕСТВО ДЕЙСТВИЙ. КАЖДЫЙ НОВЫЙ ШАГ УВЕЛИЧИВАЕТ
Dialogue: 0,0:12:35.82,0:12:38.54,Caption,,0,0,0,,ЦЕНУ СЛЕДУЮЩЕГО. ЧЕМ БОЛЬШЕ КОРАБЛЕЙ В МОРЕ,
Dialogue: 0,0:12:38.85,0:12:41.98,Caption,,0,0,0,,ТЕМ ВАЖНЕЕ СВЯЗЬ МЕЖДУ ШТАБАМИ. ЧЕМ БОЛЬШЕ ОРУЖИЯ,
Dialogue: 0,0:12:42.15,0:12:44.70,Caption,,0,0,0,,ТЕМ ДОРОЖЕ ОШИБКА. ЧЕМ ВЫШЕ РАСХОДЫ,
Dialogue: 0,0:12:44.86,0:12:48.62,Caption,,0,0,0,,ТЕМ ГРОМЧЕ ВОПРОС, КТО ПЛАТИТ. ЧЕМ МЕНЬШЕ ПРЯМЫХ КОНТАКТОВ,
Dialogue: 0,0:12:48.95,0:12:50.86,Caption,,0,0,0,,ТЕМ БОЛЬШЕ РЕШЕНИЙ ОБСУЖДАЮТ ТЕ,
Dialogue: 0,0:12:51.02,0:12:53.66,Caption,,0,0,0,,КТО РАЗГОВАРИВАТЬ НЕ ПЕРЕСТАЛ. ВОТ ПОЭТОМУ ОДИН
Dialogue: 0,0:12:53.74,0:12:56.30,Caption,,0,0,0,,ТЕЛЕФОН СЕГОДНЯ ГОВОРИТ О ЕВРОПЕ ГОРАЗДО БОЛЬШЕ,
Dialogue: 0,0:12:56.54,0:12:59.58,Caption,,0,0,0,,ЧЕМ ДЕСЯТЬ ОЧЕРЕДНЫХ ЗАЯВЛЕНИЙ О ЕДИНСТВЕ. ПОТОМУ
Dialogue: 0,0:12:59.66,0:13:02.38,Caption,,0,0,0,,ЧТО ЕДИНСТВО МОЖНО ОБЪЯВИТЬ НА ПРЕСС КОНФЕРЕНЦИИ. А
Dialogue: 0,0:13:02.46,0:13:04.38,Caption,,0,0,0,,НОМЕР ТЕЛЕФОНА ОБЫЧНО ИЩУТ ТОГДА,
Dialogue: 0,0:13:04.58,0:13:06.86,Caption,,0,0,0,,КОГДА ПОНИМАЮТ СЛЕДУЮЩИЙ РАЗГОВОР УЖЕ ЛУЧШЕ НЕ
Dialogue: 0,0:13:06.86,0:13:07.58,Caption,,0,0,0,,ПРОПУСТИТЬ.
