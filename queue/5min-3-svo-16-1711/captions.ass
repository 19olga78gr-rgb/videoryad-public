Dialogue: 0,0:00:00.12,0:00:02.44,Caption,,0,0,0,,В КИЕВЕ ПРИДУМАЛИ ЗАМЕЧАТЕЛЬНЫЙ СПОСОБ РЕШИТЬ
Dialogue: 0,0:00:02.44,0:00:05.88,Caption,,0,0,0,,ПРОБЛЕМУ С МОСТАМИ. ПОСТРОИТЬ НОВЫЕ. ВРЕМЕННЫЕ. А
Dialogue: 0,0:00:05.88,0:00:07.72,Caption,,0,0,0,,СОВЕТНИК ЗЕЛЕНСКОГО УЖЕ ОБЪЯСНЯЕТ,
Dialogue: 0,0:00:07.96,0:00:10.68,Caption,,0,0,0,,ЧТО И ЭТИ ДОЛГО НЕ ПРОЖИВУТ. ОТЛИЧНОЕ НАЧАЛО
Dialogue: 0,0:00:10.68,0:00:13.40,Caption,,0,0,0,,БОЛЬШОГО СТРОИТЕЛЬСТВА. ЕЩЁ НИЧЕГО НЕ ПОСТРОИЛИ,
Dialogue: 0,0:00:13.72,0:00:17.16,Caption,,0,0,0,,А УЖЕ ОБСУЖДАЮТ, ПОЧЕМУ НЕ ПОМОЖЕТ. И ВОТ МНЕ ИНТЕРЕСНО,
Dialogue: 0,0:00:17.40,0:00:19.80,Caption,,0,0,0,,ЭТО У НИХ ТАКОЙ НОВЫЙ СПОСОБ РЕШАТЬ ПРОБЛЕМЫ
Dialogue: 0,0:00:19.83,0:00:22.44,Caption,,0,0,0,,ИЛИ СТАРЫЕ СПОСОБЫ УЖЕ ОКОНЧАТЕЛЬНО ЗАКОНЧИЛИСЬ?
Dialogue: 0,0:00:22.69,0:00:26.36,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ПОСЛУШАТЬ, ЧТО ГОВОРЯТ САМИ УКРАИНСКИЕ ЧИНОВНИКИ,
Dialogue: 0,0:00:26.68,0:00:29.08,Caption,,0,0,0,,ВОПРОСОВ СТАНОВИТСЯ ТОЛЬКО БОЛЬШЕ. ЕСЛИ ВАМ
Dialogue: 0,0:00:29.08,0:00:34.04,Caption,,0,0,0,,ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ, ПОДПИШИТЕСЬ. НАЧНЁМ С ЖЕЛЕЗНОЙ ДОРОГИ. УКРАИНА С ДВЕ
Dialogue: 0,0:00:34.04,0:00:36.60,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА ПОТЕРЯЛА ШЕСТЬСОТ
Dialogue: 0,0:00:36.60,0:00:39.56,Caption,,0,0,0,,ТРИДЦАТЬ ЛОКОМОТИВОВ. НО САМОЕ ИНТЕРЕСНОЕ ДАЖЕ НЕ
Dialogue: 0,0:00:39.56,0:00:42.84,Caption,,0,0,0,,ЭТА БОЛЬШАЯ ЦИФРА. ОКОЛО ЧЕТЫРЁХСОТ ИЗ НИХ ВЫБИТЫ
Dialogue: 0,0:00:42.92,0:00:45.08,Caption,,0,0,0,,ИЗ СТРОЯ ТОЛЬКО ЗА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ
Dialogue: 0,0:00:45.08,0:00:48.04,Caption,,0,0,0,,ГОД. ТО ЕСТЬ БОЛЬШЕ ПОЛОВИНЫ ВСЕХ ЗАЯВЛЕННЫХ ПОТЕРЬ
Dialogue: 0,0:00:48.04,0:00:50.60,Caption,,0,0,0,,ПРИХОДИТСЯ НА ОДИН ГОД. И ЭТО УЖЕ СОВСЕМ
Dialogue: 0,0:00:50.68,0:00:53.64,Caption,,0,0,0,,ДРУГАЯ АРИФМЕТИКА. МИНИСТР ИНФРАСТРУКТУРЫ НИКОЛАЙ
Dialogue: 0,0:00:53.64,0:00:57.72,Caption,,0,0,0,,КАЛАШНИК ГОВОРИТ, ЧТО ТОЛЬКО ЗА НОЯБРЬ ПОВРЕЖДЕНО ЕЩЁ ОКОЛО ПЯТНАДЦАТИ
Dialogue: 0,0:00:57.72,0:01:00.68,Caption,,0,0,0,,МАШИН. ОДНОВРЕМЕННО ИДУТ УДАРЫ ПО ЖЕЛЕЗНОДОРОЖНЫМ
Dialogue: 0,0:01:00.68,0:01:03.72,Caption,,0,0,0,,СТАНЦИЯМ. В ЗАПОРОЖСКОЙ И ДНЕПРОПЕТРОВСКОЙ ОБЛАСТЯХ
Dialogue: 0,0:01:03.72,0:01:06.60,Caption,,0,0,0,,СНОВА СООБЩАЮТ О ПОРАЖЁННЫХ ЛОКОМОТИВАХ. ПЛЮС
Dialogue: 0,0:01:06.60,0:01:09.56,Caption,,0,0,0,,СКЛАДЫ, НЕФТЕБАЗЫ, ПОРТОВАЯ ИНФРАСТРУКТУРА.
Dialogue: 0,0:01:11.83,0:01:15.67,Caption,,0,0,0,,И ВОТ ТУТ НАЧИНАЕТСЯ ТО, ЧЕГО НЕ ВИДНО ЗА КРАСИВОЙ ЦИФРОЙ "ШЕСТЬСОТ
Dialogue: 0,0:01:15.67,0:01:19.03,Caption,,0,0,0,,ТРИДЦАТЬ". ЛОКОМОТИВ НЕ МАРШРУТКА. НЕЛЬЗЯ ВЕЧЕРОМ
Dialogue: 0,0:01:19.03,0:01:22.31,Caption,,0,0,0,,ПОТЕРЯТЬ ОДИН, УТРОМ КУПИТЬ ДРУГОЙ В СОСЕДНЕЙ СТРАНЕ,
Dialogue: 0,0:01:22.47,0:01:25.43,Caption,,0,0,0,,ПРИКРУТИТЬ НОМЕРА И ПОЕХАТЬ. УКРАИНСКАЯ ЖЕЛЕЗНАЯ
Dialogue: 0,0:01:25.43,0:01:28.31,Caption,,0,0,0,,ДОРОГА РАБОТАЕТ НА ШИРОКОЙ КОЛЕЕ. ПОДХОДЯЩЕЙ ТЕХНИКИ
Dialogue: 0,0:01:28.39,0:01:30.87,Caption,,0,0,0,,В ЕВРОПЕ НЕМНОГО. ПРАВИТЕЛЬСТВО УЖЕ РАЗРЕШИЛО
Dialogue: 0,0:01:30.87,0:01:33.43,Caption,,0,0,0,,ПОКУПАТЬ ПОДЕРЖАННЫЕ ЛОКОМОТИВЫ И ЗАПЧАСТИ БЕЗ
Dialogue: 0,0:01:33.43,0:01:36.31,Caption,,0,0,0,,ТЕНДЕРОВ. ТО ЕСТЬ СИТУАЦИЯ ДОШЛА ДО ПРОСТОЙ СТАДИИ
Dialogue: 0,0:01:36.31,0:01:41.27,Caption,,0,0,0,,ЧТО НАЙДЁМ, ТО И БЕРЁМ. В ПУБЛИКАЦИИ ДЕЛАЮТ ЕЩЁ БОЛЕЕ ЖЁСТКИЙ ВЫВОД РЕЗЕРВ
Dialogue: 0,0:01:41.35,0:01:44.47,Caption,,0,0,0,,ТЯГИ ПРАКТИЧЕСКИ ИСЧЕРПАН. REUTERS СООБЩАЕТ О РЕЗКОМ
Dialogue: 0,0:01:44.47,0:01:47.11,Caption,,0,0,0,,ПАДЕНИИ ГРУЗОПЕРЕВОЗОК. ВОТ ЗДЕСЬ УЖЕ НЕ НАДО
Dialogue: 0,0:01:47.11,0:01:49.91,Caption,,0,0,0,,РИСОВАТЬ АПОКАЛИПСИС. ДОСТАТОЧНО ПОСМОТРЕТЬ НА САМ
Dialogue: 0,0:01:49.91,0:01:54.55,Caption,,0,0,0,,МЕХАНИЗМ. НЕТ ТЯГИ, ХУЖЕ ДВИГАЮТСЯ ГРУЗЫ. ХУЖЕ ДВИГАЮТСЯ ГРУЗЫ,
Dialogue: 0,0:01:54.62,0:01:57.59,Caption,,0,0,0,,СЛОЖНЕЕ РАБОТАЕТ ЛОГИСТИКА. И НИКАКАЯ БОДРАЯ ПРЕСС
Dialogue: 0,0:01:57.59,0:02:00.07,Caption,,0,0,0,,КОНФЕРЕНЦИЯ НОВЫЙ ЛОКОМОТИВ ИЗ ВОЗДУХА НЕ
Dialogue: 0,0:02:00.07,0:02:03.03,Caption,,0,0,0,,МАТЕРИАЛИЗУЕТ. НО С ЖЕЛЕЗНОЙ ДОРОГОЙ ИСТОРИЯ НЕ
Dialogue: 0,0:02:03.03,0:02:05.91,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ. В ЗАПОРОЖЬЕ ПОЛНОСТЬЮ ПЕРЕКРЫЛИ
Dialogue: 0,0:02:05.91,0:02:09.11,Caption,,0,0,0,,ДВИЖЕНИЕ ПО МОСТУ ИМЕНИ ПРЕОБРАЖЕНСКОГО. РОССИЙСКИЕ
Dialogue: 0,0:02:09.11,0:02:13.75,Caption,,0,0,0,,КАНАЛЫ ПИШУТ ОБ АВИАУДАРЕ, ПОВРЕЖДЕНИИ ЖЕЛЕЗНОДОРОЖНОГО ПОЛОТНА И ДЕФОРМАЦИИ
Dialogue: 0,0:02:13.75,0:02:17.27,Caption,,0,0,0,,КОНСТРУКЦИЙ. ОБЪЕЗД ЕСТЬ. ЧЕРЕЗ ДАМБУ ДНЕПРОГЭС И
Dialogue: 0,0:02:17.27,0:02:20.15,Caption,,0,0,0,,ВАНТОВЫЙ МОСТ. ТОЛЬКО ДЛЯ ТЯЖЁЛЫХ ГРУЗОВИКОВ ТАМ УЖЕ
Dialogue: 0,0:02:20.15,0:02:25.86,Caption,,0,0,0,,ОГРАНИЧЕНИЯ. ТО ЕСТЬ СЛОВО "ОБЪЕЗД" ЗВУЧИТ КРАСИВО РОВНО ДО
Dialogue: 0,0:02:25.94,0:02:28.10,Caption,,0,0,0,,ТОГО МОМЕНТА, ПОКА НЕ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:02:28.26,0:02:30.82,Caption,,0,0,0,,ЧТО НЕ ВСЁ, ЧТО ЕХАЛО ПО СТАРОМУ МАРШРУТУ,
Dialogue: 0,0:02:31.06,0:02:32.82,Caption,,0,0,0,,МОЖЕТ СПОКОЙНО ПОЕХАТЬ ПО НОВОМУ.
Dialogue: 0,0:02:33.43,0:02:35.78,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО АКСЁНОВ ПОДТВЕРДИЛ УДАР ПО КРЫМСКОМУ
Dialogue: 0,0:02:35.78,0:02:38.82,Caption,,0,0,0,,МОСТУ. ДВИЖЕНИЕ ТАМ ОГРАНИЧИВАЛИ ОРИЕНТИРОВОЧНО ДО
Dialogue: 0,0:02:38.90,0:02:41.46,Caption,,0,0,0,,СЕРЕДИНЫ ДНЯ. И ВОТ ЗДЕСЬ ВАЖНО НЕ УСТРАИВАТЬ
Dialogue: 0,0:02:41.54,0:02:44.66,Caption,,0,0,0,,ДЕТСКИЙ КОНКУРС "ЧЕЙ МОСТ ПОСТРАДАЛ СИЛЬНЕЕ". УДАРЫ
Dialogue: 0,0:02:44.66,0:02:47.38,Caption,,0,0,0,,ИДУТ С ОБЕИХ СТОРОН. УКРАИНА БЬЁТ ПО РОССИЙСКОЙ
Dialogue: 0,0:02:47.38,0:02:50.82,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ. РОССИЯ БЬЁТ ПО УКРАИНСКОЙ. КРЫМСКИЙ
Dialogue: 0,0:02:50.82,0:02:55.86,Caption,,0,0,0,,МОСТ ОСТАЁТСЯ ЦЕЛЬЮ КИЕВА, А МОСТЫ ЧЕРЕЗ ДНЕПР УЖЕ СТАНОВЯТСЯ ОТДЕЛЬНОЙ БОЛЬШОЙ
Dialogue: 0,0:02:55.94,0:02:59.06,Caption,,0,0,0,,ТЕМОЙ ДЛЯ КИЕВА. ПРИЧЁМ УКРАИНСКИЕ ПОЛИТИКИ НАЧАЛИ
Dialogue: 0,0:02:59.06,0:03:02.26,Caption,,0,0,0,,ОБСУЖДАТЬ ЭТУ ТЕМУ СОВСЕМ НЕ ТЕОРЕТИЧЕСКИ. НАРДЕП
Dialogue: 0,0:03:02.26,0:03:06.42,Caption,,0,0,0,,ВЛАДИМИР КРЕЙДЕНКО ЗАЯВИЛ, ЧТО ЗЕЛЁНАЯ ВЕТКА КИЕВСКОГО МЕТРО МЕЖДУ БЕРЕГАМИ
Dialogue: 0,0:03:06.42,0:03:08.98,Caption,,0,0,0,,ДНЕПРА НЕ БУДЕТ НОРМАЛЬНО РАБОТАТЬ ДО НАЧАЛА
Dialogue: 0,0:03:09.06,0:03:11.86,Caption,,0,0,0,,СЛЕДУЮЩЕГО ГОДА. ОДНОВРЕМЕННО ВЛАСТИ НАЧАЛИ ГОТОВИТЬ
Dialogue: 0,0:03:11.86,0:03:15.54,Caption,,0,0,0,,ПОНТОННЫЕ МОСТЫ. СРОК НАЗЫВАЮТ ТРИ ЧЕТЫРЕ МЕСЯЦА. НУ
Dialogue: 0,0:03:15.54,0:03:18.34,Caption,,0,0,0,,ПРЕКРАСНО. ТО ЕСТЬ СНАЧАЛА НУЖНО НЕСКОЛЬКО МЕСЯЦЕВ
Dialogue: 0,0:03:18.34,0:03:21.14,Caption,,0,0,0,,ГОТОВИТЬ ВРЕМЕННУЮ ПЕРЕПРАВУ. ПОТОМ ЕЁ СОБРАТЬ.
Dialogue: 0,0:03:21.35,0:03:24.42,Caption,,0,0,0,,ПОТОМ НАДЕЯТЬСЯ, ЧТО ОНА СПОКОЙНО БУДЕТ СТОЯТЬ ТАМ,
Dialogue: 0,0:03:24.58,0:03:27.22,Caption,,0,0,0,,ГДЕ УЖЕ НАНОСЯТСЯ УДАРЫ ПО МОСТОВОЙ ИНФРАСТРУКТУРЕ.
Dialogue: 0,0:03:27.55,0:03:29.78,Caption,,0,0,0,,РЕШЕНИЕ ПРЯМО НА ПЯТЬ С ТРЕМЯ ПЛЮСАМИ.
Dialogue: 0,0:03:31.97,0:03:34.61,Caption,,0,0,0,,И ТУТ ВЫХОДИТ СОВЕТНИК ЗЕЛЕНСКОГО СЕРГЕЙ БЕСКРЕСТНОВ
Dialogue: 0,0:03:34.61,0:03:36.37,Caption,,0,0,0,,И ГОВОРИТ ПРИМЕРНО СЛЕДУЮЩЕЕ РЕБЯТА,
Dialogue: 0,0:03:36.53,0:03:40.29,Caption,,0,0,0,,А ВЫ ВООБЩЕ О ЧЁМ? ЕСЛИ ДОЙДЁТ ДО РАЗРУШЕНИЯ ОСНОВНЫХ МОСТОВ,
Dialogue: 0,0:03:40.45,0:03:43.49,Caption,,0,0,0,,ПОНТОНЫ И ПАРОМЫ ПРОБЛЕМУ НЕ РЕШАТ. ПАРОМ МОЖЕТ
Dialogue: 0,0:03:43.49,0:03:46.21,Caption,,0,0,0,,ПЕРЕВОЗИТЬ ОГРАНИЧЕННОЕ КОЛИЧЕСТВО КРИТИЧЕСКИ ВАЖНЫХ
Dialogue: 0,0:03:46.29,0:03:49.65,Caption,,0,0,0,,ГРУЗОВ. НО У ПАРОМА ЕСТЬ ПРИЧАЛ. ЕСТЬ ПОДЪЕЗД.
Dialogue: 0,0:03:49.97,0:03:52.45,Caption,,0,0,0,,ЕСТЬ МЕСТО ПОГРУЗКИ. ВСЁ ЭТО ИЗВЕСТНО,
Dialogue: 0,0:03:52.62,0:03:54.37,Caption,,0,0,0,,ВСЁ ЭТО СТОИТ НА МЕСТЕ И ВСЁ ЭТО
Dialogue: 0,0:03:54.37,0:03:57.89,Caption,,0,0,0,,ТОЖЕ УЯЗВИМО. С ПОНТОНОМ ЕЩЁ ВЕСЕЛЕЕ. ПО ОЦЕНКЕ
Dialogue: 0,0:03:57.89,0:04:00.37,Caption,,0,0,0,,БЕСКРЕСТНОВА, ОДНОЙ "ГЕРАНИ" МОЖЕТ ХВАТИТЬ,
Dialogue: 0,0:04:00.53,0:04:03.65,Caption,,0,0,0,,ЧТОБЫ ТАКУЮ ПЕРЕПРАВУ ВЫВЕСТИ ИЗ СТРОЯ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:04:03.65,0:04:06.61,Caption,,0,0,0,,ПРЕКРАСНАЯ СХЕМА. ПОСТРОИЛИ. ПОВРЕДИЛИ.
Dialogue: 0,0:04:06.77,0:04:09.81,Caption,,0,0,0,,ОТРЕМОНТИРОВАЛИ. СНОВА СОБРАЛИ. И У МЕНЯ ЗДЕСЬ
Dialogue: 0,0:04:09.81,0:04:13.09,Caption,,0,0,0,,СТАРЫЙ ВОПРОС, КОТОРЫЙ НИКУДА НЕ ДЕЛСЯ. А КТО ВСЁ ЭТО
Dialogue: 0,0:04:13.09,0:04:17.97,Caption,,0,0,0,,БУДЕТ КАЖДЫЙ РАЗ СОБИРАТЬ? МОСТ САМ СЕБЯ НОЧЬЮ НЕ РЕМОНТИРУЕТ. ПОНТОН САМ
Dialogue: 0,0:04:18.05,0:04:20.85,Caption,,0,0,0,,ПО РЕКЕ НЕ РАСКЛАДЫВАЕТСЯ. ТАМ ДОЛЖНЫ РАБОТАТЬ ЛЮДИ.
Dialogue: 0,0:04:21.01,0:04:23.81,Caption,,0,0,0,,МОНТАЖНИКИ, ИНЖЕНЕРЫ, ВОДИТЕЛИ,
Dialogue: 0,0:04:23.89,0:04:27.01,Caption,,0,0,0,,РЕМОНТНЫЕ БРИГАДЫ. И ВОТ СКОЛЬКО НАЙДЁТСЯ ЖЕЛАЮЩИХ
Dialogue: 0,0:04:27.01,0:04:29.25,Caption,,0,0,0,,ПОСТОЯННО СОБИРАТЬ ОДНУ И ТУ ЖЕ КОНСТРУКЦИЮ ПОД
Dialogue: 0,0:04:29.25,0:04:33.81,Caption,,0,0,0,,УГРОЗОЙ ОЧЕРЕДНОГО УДАРА? ЛЮДИ ТОЖЕ НЕ БЕСКОНЕЧНЫЙ РАСХОДНИК ИНЖЕНЕРНОЙ СХЕМЫ.
Dialogue: 0,0:04:34.37,0:04:37.17,Caption,,0,0,0,,БЕСКРЕСТНОВ ПРЕДЛАГАЕТ ДРУГОЙ ВАРИАНТ. ТОННЕЛЬ ПОД
Dialogue: 0,0:04:37.17,0:04:39.89,Caption,,0,0,0,,ДНЕПРОМ. НУ ДА. ЕСЛИ ПОНТОН ПЛОХО,
Dialogue: 0,0:04:39.97,0:04:42.69,Caption,,0,0,0,,ДАВАЙТЕ ПРОКОПАЕМ ТОННЕЛЬ. ТОЛЬКО САМ ЖЕ БЕСКРЕСТНОВ
Dialogue: 0,0:04:42.69,0:04:46.05,Caption,,0,0,0,,ГОВОРИТ, ЧТО ДАЖЕ С ИНОСТРАННОЙ ПОМОЩЬЮ ЭТО ЗАЙМЁТ ГОДЫ.
Dialogue: 0,0:04:48.33,0:04:50.73,Caption,,0,0,0,,И ЗДЕСЬ В ОДНОЙ ИЗ УКРАИНСКИХ ПУБЛИКАЦИЙ ЗАДАЮТ
Dialogue: 0,0:04:50.81,0:04:54.09,Caption,,0,0,0,,ЕХИДНЫЙ ВОПРОС, КОТОРЫЙ СРЕДИ ВСЕЙ ЭТОЙ ИНЖЕНЕРНОЙ КРАСОТЫ
Dialogue: 0,0:04:54.09,0:04:57.13,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПОТЕРЯЛСЯ. ПРОЕКТ "ЗАКОНЧИТЬ ВОЙНУ И
Dialogue: 0,0:04:57.13,0:04:59.13,Caption,,0,0,0,,СОХРАНИТЬ МОСТЫ" ВООБЩЕ РАССМАТРИВАЕТСЯ?
Dialogue: 0,0:04:59.46,0:05:01.69,Caption,,0,0,0,,ПОТОМУ ЧТО СЕЙЧАС КАРТИНА ВЫГЛЯДИТ ЗАНЯТНО.
Dialogue: 0,0:05:02.01,0:05:05.37,Caption,,0,0,0,,ОБСУЖДАЮТ ПОНТОНЫ. ОБСУЖДАЮТ ПАРОМЫ. ОБСУЖДАЮТ
Dialogue: 0,0:05:05.45,0:05:10.33,Caption,,0,0,0,,ТОННЕЛЬ. СКОРО, ГЛЯДИШЬ, НАЧНУТ ПРОЕКТИРОВАТЬ КАНАТНУЮ ДОРОГУ ЧЕРЕЗ ДНЕПР. А
Dialogue: 0,0:05:10.41,0:05:13.29,Caption,,0,0,0,,ВАРИАНТ, ПРИ КОТОРОМ ВСЁ ЭТО НЕ ПРИХОДИТСЯ ПОСТОЯННО
Dialogue: 0,0:05:13.29,0:05:16.73,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬ, КАК ТО НЕ ОЧЕНЬ ПОПУЛЯРЕН. ПРИЧЁМ ПРОШЛО УЖЕ
Dialogue: 0,0:05:16.73,0:05:18.89,Caption,,0,0,0,,БОЛЬШЕ СТА СОРОКА ДНЕЙ С МОМЕНТА,
Dialogue: 0,0:05:19.13,0:05:21.45,Caption,,0,0,0,,КОГДА РАССКАЗЫВАЛИ О СОРОКАДНЕВНОЙ ОПЕРАЦИИ ПО
Dialogue: 0,0:05:21.45,0:05:24.17,Caption,,0,0,0,,ПРИНУЖДЕНИЮ РОССИИ К МИРУ. СОРОК ДНЕЙ ДАВНО
Dialogue: 0,0:05:24.17,0:05:26.81,Caption,,0,0,0,,ЗАКОНЧИЛИСЬ. А МОСТЫ ПОЧЕМУ ТО ТОЛЬКО НАЧАЛИ
Dialogue: 0,0:05:26.81,0:05:31.05,Caption,,0,0,0,,СЧИТАТЬ. ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. THE TELEGRAPH ПИШЕТ,
Dialogue: 0,0:05:31.29,0:05:34.65,Caption,,0,0,0,,ЧТО РОССИЙСКИЕ "ИСКАНДЕРЫ" СТАЛИ ТОЧНЕЕ. РЕЧЬ ИДЁТ О
Dialogue: 0,0:05:34.65,0:05:37.21,Caption,,0,0,0,,НОВЫХ ОПТИЧЕСКИХ И РАДИОЛОКАЦИОННЫХ ГОЛОВКАХ
Dialogue: 0,0:05:37.21,0:05:40.33,Caption,,0,0,0,,САМОНАВЕДЕНИЯ. НА КОНЕЧНОМ УЧАСТКЕ РАКЕТА ПОЛУЧАЕТ
Dialogue: 0,0:05:40.33,0:05:42.89,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ДОПОЛНИТЕЛЬНО КОРРЕКТИРОВАТЬ ТРАЕКТОРИЮ
Dialogue: 0,0:05:42.89,0:05:46.25,Caption,,0,0,0,,И ТОЧНЕЕ ОПРЕДЕЛЯТЬ ПОЛОЖЕНИЕ ЦЕЛИ. ЕСЛИ ПЕРЕВЕСТИ С
Dialogue: 0,0:05:46.33,0:05:47.93,Caption,,0,0,0,,ВОЕННОГО ЯЗЫКА НА ЧЕЛОВЕЧЕСКИЙ,
Dialogue: 0,0:05:48.20,0:05:50.89,Caption,,0,0,0,,РАКЕТЕ ПЫТАЮТСЯ ДАТЬ ВОЗМОЖНОСТЬ НЕ ПРОСТО ПРИЛЕТЕТЬ
Dialogue: 0,0:05:50.89,0:05:52.73,Caption,,0,0,0,,ПРИМЕРНО ТУДА, КУДА ЕЁ ОТПРАВИЛИ,
Dialogue: 0,0:05:53.05,0:05:56.33,Caption,,0,0,0,,А УТОЧНИТЬ ЦЕЛЬ УЖЕ НЕПОСРЕДСТВЕННО ПЕРЕД УДАРОМ. И
Dialogue: 0,0:05:56.41,0:05:58.29,Caption,,0,0,0,,ЭТО ВАЖНО КАК РАЗ В ИСТОРИИ С МОСТАМИ.
Dialogue: 0,0:06:00.45,0:06:03.81,Caption,,0,0,0,,КРУПНЫЙ МОСТ ШТУКА ЗДОРОВАЯ И ОЧЕНЬ КРЕПКАЯ. ПОПАСТЬ
Dialogue: 0,0:06:03.89,0:06:05.89,Caption,,0,0,0,,В РАЙОН МОСТА ЕЩЁ НЕ ЗНАЧИТ ВЫВЕСТИ ЕГО
Dialogue: 0,0:06:05.89,0:06:08.77,Caption,,0,0,0,,ИЗ СТРОЯ. ЭКСПЕРТ МАУРО ДЖИЛЛИ ПРЯМО ГОВОРИТ,
Dialogue: 0,0:06:09.08,0:06:11.73,Caption,,0,0,0,,ЧТО ПОЛНОСТЬЮ РАЗРУШИТЬ КРУПНЫЕ КИЕВСКИЕ МОСТЫ
Dialogue: 0,0:06:11.73,0:06:14.85,Caption,,0,0,0,,КРАЙНЕ СЛОЖНО. НО THE TELEGRAPH ДАЛЬШЕ ДЕЛАЕТ
Dialogue: 0,0:06:14.93,0:06:17.81,Caption,,0,0,0,,ГОРАЗДО БОЛЕЕ ИНТЕРЕСНЫЙ ПОВОРОТ. ГАЗЕТА ПИШЕТ,
Dialogue: 0,0:06:18.00,0:06:20.61,Caption,,0,0,0,,ЧТО МОСТЫ МОГУТ БЫТЬ ТОЛЬКО ЧАСТЬЮ БОЛЕЕ ШИРОКОЙ
Dialogue: 0,0:06:20.61,0:06:24.21,Caption,,0,0,0,,СТРАТЕГИИ. ЕЁ НАЗЫВАЮТ "ОСТРОВИЗАЦИЕЙ" УКРАИНСКОЙ
Dialogue: 0,0:06:24.21,0:06:26.53,Caption,,0,0,0,,ЭНЕРГОСИСТЕМЫ. НАЗВАНИЕ СТРАШНОЕ,
Dialogue: 0,0:06:26.62,0:06:30.13,Caption,,0,0,0,,СМЫСЛ ПРОСТОЙ. БЕРЁМ ОДНУ БОЛЬШУЮ СЕТЬ И ПОСТЕПЕННО
Dialogue: 0,0:06:30.13,0:06:32.53,Caption,,0,0,0,,ПРЕВРАЩАЕМ ЕЁ В НЕСКОЛЬКО ОТДЕЛЬНЫХ КУСКОВ,
Dialogue: 0,0:06:32.77,0:06:35.73,Caption,,0,0,0,,МЕЖДУ КОТОРЫМИ ВСЁ ХУЖЕ ПЕРЕДАЁТСЯ ЭЛЕКТРИЧЕСТВО. И
Dialogue: 0,0:06:35.73,0:06:40.45,Caption,,0,0,0,,ТОГДА ПРОБЛЕМА УЖЕ НЕ В ТОМ, ЧТО ОДНА ПОДСТАНЦИЯ ГДЕ ТО ЗАГОРЕЛАСЬ. ОДИН РАЙОН
Dialogue: 0,0:06:40.45,0:06:43.41,Caption,,0,0,0,,ПОЛУЧАЕТ ЭЛЕКТРИЧЕСТВО. ВТОРОЙ ПОЛУЧАЕТ ДВА ЧАСА В
Dialogue: 0,0:06:43.41,0:06:46.69,Caption,,0,0,0,,СУТКИ. ТРЕТИЙ СИДИТ БЕЗ ОТОПЛЕНИЯ. ЧЕТВЁРТЫЙ ВРОДЕ
Dialogue: 0,0:06:46.69,0:06:49.89,Caption,,0,0,0,,ИМЕЕТ ГЕНЕРАЦИЮ, НО НОРМАЛЬНО ПЕРЕДАТЬ ЭНЕРГИЮ ТУДА,
Dialogue: 0,0:06:50.00,0:06:54.21,Caption,,0,0,0,,ГДЕ ОНА НУЖНА, УЖЕ СЛОЖНО. А ВМЕСТЕ СО СВЕТОМ НАЧИНАЮТ СПОТЫКАТЬСЯ
Dialogue: 0,0:06:54.21,0:06:59.33,Caption,,0,0,0,,ВОДА, ТЕПЛО, ТРАНСПОРТ, ПРОИЗВОДСТВО. ВОТ ЭТО УЖЕ СОВСЕМ ДРУГАЯ ИСТОРИЯ.
Dialogue: 0,0:06:59.65,0:07:02.21,Caption,,0,0,0,,ПРИЧЁМ РЯДОМ ПОЯВЛЯЕТСЯ УКРАИНСКАЯ СИСТЕМА LIMA
Dialogue: 0,0:07:02.21,0:07:05.57,Caption,,0,0,0,,QUANT, КОТОРОЙ NEW YORK TIMES ПОСВЯТИЛА БОЛЬШОЙ МАТЕРИАЛ.
Dialogue: 0,0:07:05.82,0:07:08.69,Caption,,0,0,0,,ТАМ ВООБЩЕ КРАСОТА. СИСТЕМУ ОПИСЫВАЮТ ТАК,
Dialogue: 0,0:07:09.01,0:07:11.57,Caption,,0,0,0,,БУДТО ОНА СПОСОБНА ЗАСТАВИТЬ РОССИЙСКИЙ БЕСПИЛОТНИК
Dialogue: 0,0:07:11.57,0:07:14.05,Caption,,0,0,0,,ДУМАТЬ, ЧТО ОН НАХОДИТСЯ ЧУТЬ ЛИ НЕ В ПЕРУ.
Dialogue: 0,0:07:16.26,0:07:18.58,Caption,,0,0,0,,ПЛЮС ЕЙ ПРИПИСЫВАЮТ ВОЗДЕЙСТВИЕ НА РОССИЙСКИЕ
Dialogue: 0,0:07:18.58,0:07:22.02,Caption,,0,0,0,,РАКЕТЫ. ЗВУЧИТ ЭФФЕКТНО. В РОССИЙСКОМ ВОЕННОМ КАНАЛЕ
Dialogue: 0,0:07:22.10,0:07:23.86,Caption,,0,0,0,,НА ЭТО ОТВЕЧАЮТ ЕХИДНО РЕБЯТА,
Dialogue: 0,0:07:24.10,0:07:28.26,Caption,,0,0,0,,ВЫ ЧЕГО ИМЕННО ИЗОБРЕЛИ? ПОТОМУ ЧТО ПОДМЕНА СПУТНИКОВЫХ КООРДИНАТ,
Dialogue: 0,0:07:28.34,0:07:32.18,Caption,,0,0,0,,СПУФИНГ, СУЩЕСТВУЕТ УЖЕ ОЧЕНЬ ДАВНО. МОСКВИЧИ ПРЕКРАСНО
Dialogue: 0,0:07:32.18,0:07:36.02,Caption,,0,0,0,,ПОМНЯТ СТАРУЮ ИСТОРИЮ, КОГДА НАВИГАТОР ВОЗЛЕ КРЕМЛЯ ВДРУГ ПОКАЗЫВАЛ
Dialogue: 0,0:07:36.02,0:07:39.94,Caption,,0,0,0,,ЧЕЛОВЕКУ, ЧТО ТОТ НАХОДИТСЯ ВОЗЛЕ АЭРОПОРТА. МАШИНА СТОИТ В
Dialogue: 0,0:07:39.94,0:07:41.86,Caption,,0,0,0,,ЦЕНТРЕ МОСКВЫ, А ТЕЛЕФОН УВЕРЕН,
Dialogue: 0,0:07:42.02,0:07:44.34,Caption,,0,0,0,,ЧТО ВЫ ПОЧТИ У САМОЛЁТА. СМЕШНО,
Dialogue: 0,0:07:44.51,0:07:47.22,Caption,,0,0,0,,ПОКА РЕЧЬ ИДЁТ О ТЕЛЕФОНЕ. ТОЛЬКО ВОЕННАЯ ТЕХНИКА
Dialogue: 0,0:07:47.30,0:07:49.22,Caption,,0,0,0,,ЗА ЭТИ ГОДЫ ТОЖЕ НЕ СТОЯЛА НА МЕСТЕ.
Dialogue: 0,0:07:49.65,0:07:52.10,Caption,,0,0,0,,НА ДАЛЬНОБОЙНЫЕ БЕСПИЛОТНИКИ СТАВЯТ ЗАЩИЩЁННЫЕ
Dialogue: 0,0:07:52.10,0:07:54.74,Caption,,0,0,0,,АНТЕННЫ С НЕСКОЛЬКИМИ ПРИЁМНИКАМИ. ИСПОЛЬЗУЮТСЯ
Dialogue: 0,0:07:54.74,0:07:57.70,Caption,,0,0,0,,ДРУГИЕ СПОСОБЫ НАВИГАЦИИ. САМ БЕСКРЕСТНОВ РАНЬШЕ
Dialogue: 0,0:07:57.70,0:08:01.30,Caption,,0,0,0,,ГОВОРИЛ, ЧТО ПРОСТАЯ ПОДМЕНА КООРДИНАТ УЖЕ ДАЛЕКО НЕ САМЫЙ
Dialogue: 0,0:08:01.30,0:08:04.18,Caption,,0,0,0,,ЭФФЕКТИВНЫЙ СПОСОБ БОРЬБЫ С ТАКИМИ АППАРАТАМИ. А С
Dialogue: 0,0:08:04.18,0:08:06.90,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИМИ РАКЕТАМИ ВОЗНИКАЕТ ОТДЕЛЬНЫЙ ВОПРОС.
Dialogue: 0,0:08:07.22,0:08:10.58,Caption,,0,0,0,,ОНИ ЛЕТАЛИ ЗАДОЛГО ДО GPS И ГЛОНАСС. ИНЕРЦИАЛЬНЫЕ
Dialogue: 0,0:08:10.58,0:08:15.30,Caption,,0,0,0,,СИСТЕМЫ СУЩЕСТВОВАЛИ ТОГДА, КОГДА НИКАКИХ СПУТНИКОВЫХ НАВИГАТОРОВ В МАШИНЕ,
Dialogue: 0,0:08:15.46,0:08:18.10,Caption,,0,0,0,,ТЕЛЕФОНЕ И ЧАСАХ НЕ БЫЛО. ИСПОЛЬЗОВАЛАСЬ
Dialogue: 0,0:08:18.10,0:08:22.10,Caption,,0,0,0,,АСТРОКОРРЕКЦИЯ, ИСПОЛЬЗОВАЛИСЬ ДРУГИЕ СПОСОБЫ УТОЧНЕНИЯ ТРАЕКТОРИИ.
Dialogue: 0,0:08:22.42,0:08:24.98,Caption,,0,0,0,,ОТСЮДА И ЕХИДНАЯ ОЦЕНКА В ВОЕННОМ КАНАЛЕ САМ
Dialogue: 0,0:08:25.06,0:08:26.98,Caption,,0,0,0,,СЕБЯ НЕ ПОХВАЛИШЬ, НИКТО НЕ ПОХВАЛИТ.
Dialogue: 0,0:08:29.25,0:08:34.13,Caption,,0,0,0,,И ТУТ РЯДОМ, КАК СПЕЦИАЛЬНО, ПОЯВЛЯЮТСЯ СООБЩЕНИЯ О НОВЫХ СИСТЕМАХ НАВЕДЕНИЯ НА
Dialogue: 0,0:08:34.13,0:08:36.93,Caption,,0,0,0,,"ИСКАНДЕРАХ". ТО ЕСТЬ ОДНА СТОРОНА РАССКАЗЫВАЕТ,
Dialogue: 0,0:08:37.08,0:08:39.73,Caption,,0,0,0,,КАК БУДЕТ ОБМАНЫВАТЬ НАВИГАЦИЮ. ДРУГАЯ
Dialogue: 0,0:08:39.73,0:08:41.73,Caption,,0,0,0,,СОВЕРШЕНСТВУЕТ СПОСОБЫ НАВЕДЕНИЯ,
Dialogue: 0,0:08:41.97,0:08:44.05,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ РАБОТАТЬ В УСЛОВИЯХ ТАКОГО
Dialogue: 0,0:08:44.05,0:08:46.93,Caption,,0,0,0,,ПРОТИВОДЕЙСТВИЯ. ВОТ ТАК И ВЫГЛЯДИТ НАСТОЯЩАЯ
Dialogue: 0,0:08:46.93,0:08:49.89,Caption,,0,0,0,,ТЕХНОЛОГИЧЕСКАЯ ГОНКА. НЕ ОДИН РАЗ ПРИДУМАЛ ЧУДО
Dialogue: 0,0:08:49.97,0:08:52.93,Caption,,0,0,0,,КНОПКУ И ПОБЕДИЛ. КАЖДЫЙ НОВЫЙ СПОСОБ ЗАЩИТЫ ЧЕРЕЗ
Dialogue: 0,0:08:52.93,0:08:56.05,Caption,,0,0,0,,КАКОЕ ТО ВРЕМЯ ПОЛУЧАЕТ НОВЫЙ СПОСОБ ОБХОДА. НО
Dialogue: 0,0:08:56.13,0:08:58.69,Caption,,0,0,0,,САМАЯ КРАСИВАЯ ИСТОРИЯ СЕЙЧАС ВООБЩЕ СО STARSHIELD.
Dialogue: 0,0:08:59.02,0:09:02.29,Caption,,0,0,0,,ТУТ НАША СТАРАЯ РОМАШКА РАСЦВЕЛА ПО НОВОЙ. РАБОТАЕТ.
Dialogue: 0,0:09:02.44,0:09:05.33,Caption,,0,0,0,,НЕ РАБОТАЕТ. ОГРАНИЧИЛИ. НЕ ОГРАНИЧИВАЛИ.
Dialogue: 0,0:09:05.57,0:09:09.01,Caption,,0,0,0,,ТЕХНИЧЕСКАЯ ПРОБЛЕМА. НИКАКИХ ИЗМЕНЕНИЙ НЕТ. AXIOS
Dialogue: 0,0:09:09.01,0:09:11.33,Caption,,0,0,0,,СО ССЫЛКОЙ НА УКРАИНСКОГО ЧИНОВНИКА ПИСАЛ,
Dialogue: 0,0:09:11.49,0:09:14.29,Caption,,0,0,0,,ЧТО ОГРАНИЧЕНИЯ УСИЛИВАЛИСЬ НЕСКОЛЬКО ДНЕЙ ПОДРЯД.
Dialogue: 0,0:09:14.60,0:09:17.33,Caption,,0,0,0,,СНАЧАЛА РЕЧЬ ШЛА О ДЕСЯТИ ПРОЦЕНТАХ. ПОТОМ О
Dialogue: 0,0:09:17.33,0:09:19.89,Caption,,0,0,0,,ПЯТИДЕСЯТИ. ЗАТЕМ ЧИНОВНИК УЖЕ УТВЕРЖДАЛ,
Dialogue: 0,0:09:20.05,0:09:23.57,Caption,,0,0,0,,ЧТО СРЫВАЮТСЯ ВСЕ МИССИИ. SPACEX ОТВЕЧАЕТ НЕПРАВДА,
Dialogue: 0,0:09:23.73,0:09:26.61,Caption,,0,0,0,,НИКАКИХ ИЗМЕНЕНИЙ НЕ БЫЛО. ПРЕКРАСНО. ТО ЕСТЬ
Dialogue: 0,0:09:26.61,0:09:30.61,Caption,,0,0,0,,УКРАИНСКИЙ ЧИНОВНИК ГОВОРИТ, ЧТО МИССИИ СРЫВАЮТСЯ. КОМПАНИЯ ГОВОРИТ,
Dialogue: 0,0:09:30.72,0:09:33.09,Caption,,0,0,0,,ЧТО НИЧЕГО НЕ МЕНЯЛА. А ПРОБЛЕМА ПРИ ЭТОМ
Dialogue: 0,0:09:33.17,0:09:36.21,Caption,,0,0,0,,НИКУДА НЕ ДЕВАЕТСЯ. ЗЕЛЕНСКИЙ ИДЁТ ЕЩЁ ДАЛЬШЕ. ОН
Dialogue: 0,0:09:36.21,0:09:38.69,Caption,,0,0,0,,СВЯЗЫВАЕТ ОГРАНИЧЕНИЯ СКОРОСТИ STARSHIELD С
Dialogue: 0,0:09:38.69,0:09:41.01,Caption,,0,0,0,,РОССИЙСКИМИ УДАРАМИ "ШАХЕДОВ" ПО ПОДСТАНЦИЯМ.
Dialogue: 0,0:09:43.20,0:09:46.48,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ИЗ ЗА ОГРАНИЧЕНИЙ УКРАИНСКИМ БЕСПИЛОТНИКАМ
Dialogue: 0,0:09:46.48,0:09:49.52,Caption,,0,0,0,,ПЕРЕХВАТЧИКАМ СЛОЖНЕЕ ДОГОНЯТЬ ЦЕЛИ. И АВТОР
Dialogue: 0,0:09:49.52,0:09:52.48,Caption,,0,0,0,,УКРАИНСКОГО КАНАЛА ТУТ ЖЕ ЗАМЕЧАЕТ ПРОЦЕНТ КОСВЕННЫХ
Dialogue: 0,0:09:52.48,0:09:54.80,Caption,,0,0,0,,ОБВИНЕНИЙ В АДРЕС ТРАМПА ВЫШЕЛ НА МАКСИМУМ.
Dialogue: 0,0:09:55.38,0:09:58.08,Caption,,0,0,0,,ВОТ ЭТО УЖЕ ИНТЕРЕСНО. ПОТОМУ ЧТО РАНЬШЕ РАЗГОВОР
Dialogue: 0,0:09:58.16,0:10:02.24,Caption,,0,0,0,,ШЁЛ О ТОМ, КТО ДАЛ УКРАИНЕ СВЯЗЬ. ТЕПЕРЬ ПОСТЕПЕННО НАЧИНАЕТСЯ
Dialogue: 0,0:10:02.24,0:10:06.16,Caption,,0,0,0,,РАЗГОВОР О ТОМ, КТО И НАСКОЛЬКО СПОСОБЕН ЭТУ СВЯЗЬ ОГРАНИЧИТЬ. А
Dialogue: 0,0:10:06.16,0:10:08.88,Caption,,0,0,0,,ЭТО УЖЕ СОВСЕМ ДРУГАЯ ЗАВИСИМОСТЬ. МОЖНО СКОЛЬКО
Dialogue: 0,0:10:08.88,0:10:11.76,Caption,,0,0,0,,УГОДНО РАССКАЗЫВАТЬ О ПОЛНОЙ САМОСТОЯТЕЛЬНОСТИ. НО
Dialogue: 0,0:10:11.84,0:10:14.80,Caption,,0,0,0,,ЕСЛИ ЧАСТЬ ВОЕННЫХ ВОЗМОЖНОСТЕЙ ЗАВЯЗАНА НА СИСТЕМУ,
Dialogue: 0,0:10:15.04,0:10:16.96,Caption,,0,0,0,,ПРАВИЛА КОТОРОЙ УСТАНАВЛИВАЕШЬ НЕ ТЫ,
Dialogue: 0,0:10:17.28,0:10:19.76,Caption,,0,0,0,,КНОПКА ВСЁ РАВНО НАХОДИТСЯ НЕ У ТЕБЯ. ПРИ
Dialogue: 0,0:10:19.84,0:10:22.80,Caption,,0,0,0,,ЭТОМ SPACEX ПОЗЖЕ ОБЪЯСНИЛА ОГРАНИЧЕНИЯ ТЕХНИЧЕСКОЙ
Dialogue: 0,0:10:22.80,0:10:26.16,Caption,,0,0,0,,ПРОБЛЕМОЙ. ХОРОШО. ТОГДА ВОЗНИКАЕТ ЕЩЁ БОЛЕЕ ПРОСТОЙ
Dialogue: 0,0:10:26.16,0:10:29.36,Caption,,0,0,0,,ВОПРОС. ПОЧЕМУ ЭТА ТЕХНИЧЕСКАЯ ПРОБЛЕМА ДЕРЖИТСЯ УЖЕ
Dialogue: 0,0:10:29.36,0:10:33.52,Caption,,0,0,0,,НЕСКОЛЬКО ДНЕЙ ИМЕННО ТАМ, ГДЕ ЕЁ ПОСЛЕДСТВИЯ ОСОБЕННО ЧУВСТВИТЕЛЬНЫ?
Dialogue: 0,0:10:34.00,0:10:36.96,Caption,,0,0,0,,КИЕВ ВЫЯСНЯЕТ ПРИЧИНЫ С КОМПАНИЕЙ. ПУБЛИЧНОГО
Dialogue: 0,0:10:36.96,0:10:40.00,Caption,,0,0,0,,ПОДРОБНОГО ОБЪЯСНЕНИЯ НЕТ. И ТУТ СТАРЫЙ ВОПРОС О
Dialogue: 0,0:10:40.00,0:10:42.96,Caption,,0,0,0,,STARSHIELD СНОВА ВОЗВРАЩАЕТСЯ. НЕ В ТОМ СМЫСЛЕ,
Dialogue: 0,0:10:43.18,0:10:45.60,Caption,,0,0,0,,ЧТО КТО ТО УЖЕ ДОКАЗАЛ НАЛИЧИЕ БОЛЬШОЙ СЕКРЕТНОЙ
Dialogue: 0,0:10:45.60,0:10:49.04,Caption,,0,0,0,,КНОПКИ. А В СОВЕРШЕННО ПРАКТИЧЕСКОМ. НАСКОЛЬКО АРМИЯ
Dialogue: 0,0:10:49.04,0:10:51.12,Caption,,0,0,0,,ВООБЩЕ МОЖЕТ СЧИТАТЬ СВОИМ ИНСТРУМЕНТ,
Dialogue: 0,0:10:51.26,0:10:53.92,Caption,,0,0,0,,УСЛОВИЯ ИСПОЛЬЗОВАНИЯ КОТОРОГО ОПРЕДЕЛЯЕТ ЧУЖАЯ
Dialogue: 0,0:10:53.92,0:11:00.37,Caption,,0,0,0,,КОМПАНИЯ И ЧУЖАЯ СТРАНА? И ПОКА КИЕВ РАЗБИРАЕТСЯ С АМЕРИКАНСКОЙ СВЯЗЬЮ,
Dialogue: 0,0:11:00.45,0:11:03.41,Caption,,0,0,0,,В ЭСТОНИИ ПРОИЗОШЛА ЕЩЁ ОДНА ЗАМЕЧАТЕЛЬНАЯ ИСТОРИЯ.
Dialogue: 0,0:11:03.96,0:11:06.05,Caption,,0,0,0,,УКРАИНСКИЕ БЕСПИЛОТНИКИ ШЛИ В НАПРАВЛЕНИИ
Dialogue: 0,0:11:06.05,0:11:09.33,Caption,,0,0,0,,РОССИЙСКОГО ПОРТА УСТЬ ЛУГА И ЗАХОДИЛИ В ВОЗДУШНОЕ
Dialogue: 0,0:11:09.33,0:11:12.53,Caption,,0,0,0,,ПРОСТРАНСТВО ЭСТОНИИ. ЭСТОНСКИЕ ВОЕННЫЕ ИХ ВИДЕЛИ.
Dialogue: 0,0:11:12.70,0:11:15.73,Caption,,0,0,0,,ИСТРЕБИТЕЛИ НАТО ПОДНЯЛИСЬ В ВОЗДУХ. ОТСЛЕЖИВАНИЕ
Dialogue: 0,0:11:15.81,0:11:18.29,Caption,,0,0,0,,БЫЛО. СБИВАТЬ НЕ СТАЛИ. ПРИЧИНОЙ,
Dialogue: 0,0:11:18.45,0:11:22.61,Caption,,0,0,0,,ПО СЛОВАМ ЭСТОНСКОЙ СТОРОНЫ, СТАЛО ОПАСЕНИЕ ЭСКАЛАЦИИ. ТАМ БОЯЛИСЬ,
Dialogue: 0,0:11:22.77,0:11:25.49,Caption,,0,0,0,,ЧТО ПОСЛЕ ПЕРЕХВАТА ОБЛОМКИ ИЛИ БОЕПРИПАС МОГУТ
Dialogue: 0,0:11:25.49,0:11:28.05,Caption,,0,0,0,,УПАСТЬ НА РОССИЙСКУЮ ТЕРРИТОРИЮ. ВОТ ЭТО МНЕ
Dialogue: 0,0:11:28.05,0:11:30.69,Caption,,0,0,0,,ОСОБЕННО НРАВИТСЯ ЧИСТО КАК ПОЛИТИЧЕСКАЯ МЕХАНИКА.
Dialogue: 0,0:11:31.01,0:11:34.53,Caption,,0,0,0,,КОГДА НУЖНО РАССКАЗЫВАТЬ, КАК ЖЁСТКО НАДО РАЗГОВАРИВАТЬ С РОССИЕЙ,
Dialogue: 0,0:11:34.77,0:11:37.57,Caption,,0,0,0,,МАЛЕНЬКАЯ ЭСТОНИЯ БЫВАЕТ ОЧЕНЬ БОЛЬШАЯ. ТАМ И
Dialogue: 0,0:11:37.57,0:11:42.05,Caption,,0,0,0,,САНКЦИИ, И ДАВЛЕНИЕ, И ПРЕКРАСНЫЕ РЕЧИ О РЕШИТЕЛЬНОСТИ. А КОГДА
Dialogue: 0,0:11:42.05,0:11:45.01,Caption,,0,0,0,,БЕСПИЛОТНИК РЕАЛЬНО ЛЕТИТ ЧЕРЕЗ ТВОЁ НЕБО К РОССИИ,
Dialogue: 0,0:11:45.33,0:11:49.49,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО ЭСКАЛАЦИЯ ВСЁ ТАКИ СУЩЕСТВУЕТ. И ПОСЛЕДСТВИЯ
Dialogue: 0,0:11:49.57,0:11:52.21,Caption,,0,0,0,,ТОЖЕ СУЩЕСТВУЮТ. СРАЗУ ОТКУДА ТО ПОЯВЛЯЕТСЯ
Dialogue: 0,0:11:52.21,0:11:54.37,Caption,,0,0,0,,ОСТОРОЖНОСТЬ. ОЧЕНЬ ПОЛЕЗНАЯ ВЕЩЬ,
Dialogue: 0,0:11:54.45,0:11:58.85,Caption,,0,0,0,,ОСТОРОЖНОСТЬ. ЖАЛКО, ЧТО ОБЫЧНО ОНА ПРИХОДИТ УЖЕ ПОСЛЕ ГРОМКИХ РЕЧЕЙ.
Dialogue: 0,0:11:59.25,0:12:01.81,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ УКРАИНА ПРОДОЛЖАЕТ НАНОСИТЬ УДАРЫ ПО
Dialogue: 0,0:12:01.81,0:12:04.53,Caption,,0,0,0,,РОССИЙСКОЙ НЕФТЕПЕРЕРАБОТКЕ. ЗА ОДНУ НЕДЕЛЮ,
Dialogue: 0,0:12:04.77,0:12:09.57,Caption,,0,0,0,,ПО ОПУБЛИКОВАННЫМ ДАННЫМ, НАРУШЕНА РАБОТА ДЕВЯТИ ИЗ ТРИДЦАТИ ПЯТИ КРУПНЕЙШИХ
Dialogue: 0,0:12:09.57,0:12:13.77,Caption,,0,0,0,,РОССИЙСКИХ НПЗ. ОБЪЁМ ПЕРЕРАБОТКИ,
Dialogue: 0,0:12:13.92,0:12:17.53,Caption,,0,0,0,,ПО ЭТИМ СООБЩЕНИЯМ, СОКРАТИЛСЯ ПРИМЕРНО НА ТРИДЦАТЬ ПРОЦЕНТОВ,
Dialogue: 0,0:12:17.61,0:12:21.05,Caption,,0,0,0,,ДО ДВУХСОТ ТЫСЯЧ ТОНН В СУТКИ. ОТДЕЛЬНЫЕ УСТАНОВКИ
Dialogue: 0,0:12:21.05,0:12:23.61,Caption,,0,0,0,,ВТОРИЧНОЙ ПЕРЕРАБОТКИ ПОСЛЕ ПОРАЖЕНИЯ МОГУТ
Dialogue: 0,0:12:23.61,0:12:26.73,Caption,,0,0,0,,РЕМОНТИРОВАТЬСЯ ОТ ШЕСТИ ДО ВОСЬМИ МЕСЯЦЕВ. И ВОТ
Dialogue: 0,0:12:26.73,0:12:29.29,Caption,,0,0,0,,ЭТО УЖЕ НЕ ИСТОРИЯ ПРО КРАСИВЫЙ ОГНЕННЫЙ СТОЛБ
Dialogue: 0,0:12:29.29,0:12:32.49,Caption,,0,0,0,,НА ВИДЕО. ПОЖАР ПОГАСИЛИ ЗА НОЧЬ. А СЛОЖНУЮ
Dialogue: 0,0:12:32.49,0:12:35.53,Caption,,0,0,0,,УСТАНОВКУ ПОТОМ СОБИРАЮТ МЕСЯЦАМИ. ПОВТОРЯТЬ ВСЕ
Dialogue: 0,0:12:35.53,0:12:38.49,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ЭТИХ УДАРОВ НЕЗАЧЕМ. НО ЕСТЬ ОДНА НОВАЯ
Dialogue: 0,0:12:38.49,0:12:41.61,Caption,,0,0,0,,ДЕТАЛЬ. ТРАМП РАНЬШЕ ПРОСИЛ КИЕВ ПРЕКРАТИТЬ ТАКИЕ
Dialogue: 0,0:12:41.61,0:12:44.49,Caption,,0,0,0,,УДАРЫ. КИЕВ ПРОДОЛЖАЕТ. ТО ЕСТЬ СНОВА ВОЗНИКАЕТ
Dialogue: 0,0:12:44.49,0:12:46.97,Caption,,0,0,0,,СТАРЫЙ ДОБРЫЙ ВОПРОС ГДЕ ЗАКАНЧИВАЕТСЯ ПРОСЬБА
Dialogue: 0,0:12:46.97,0:12:50.01,Caption,,0,0,0,,ВАШИНГТОНА И НАЧИНАЕТСЯ СОБСТВЕННОЕ РЕШЕНИЕ КИЕВА?
Dialogue: 0,0:12:50.33,0:12:53.21,Caption,,0,0,0,,ОСОБЕННО СМЕШНО ОН ВЫГЛЯДИТ РЯДОМ СО STARSHIELD. С
Dialogue: 0,0:12:53.21,0:12:54.97,Caption,,0,0,0,,ОДНОЙ СТОРОНЫ, КИЕВ ПОКАЗЫВАЕТ,
Dialogue: 0,0:12:55.16,0:12:57.37,Caption,,0,0,0,,ЧТО ПО РОССИЙСКОЙ НЕФТЯНКЕ БУДЕТ ДЕЙСТВОВАТЬ ПО
Dialogue: 0,0:12:57.37,0:13:01.77,Caption,,0,0,0,,СВОЕМУ. С ДРУГОЙ СТОРОНЫ, НЕСКОЛЬКО ТЕХНИЧЕСКИХ ОГРАНИЧЕНИЙ АМЕРИКАНСКОЙ
Dialogue: 0,0:13:01.77,0:13:05.37,Caption,,0,0,0,,СПУТНИКОВОЙ СИСТЕМЫ, И УЖЕ ЗЕЛЕНСКИЙ ПУБЛИЧНО ОБЪЯСНЯЕТ,
Dialogue: 0,0:13:05.53,0:13:08.73,Caption,,0,0,0,,НАСКОЛЬКО ЭТО БОЛЕЗНЕННО ДЛЯ УКРАИНСКОЙ АРМИИ. ВОТ
Dialogue: 0,0:13:08.73,0:13:11.37,Caption,,0,0,0,,ТАКАЯ САМОСТОЯТЕЛЬНОСТЬ С УДЛИНИТЕЛЕМ. В ОДНУ
Dialogue: 0,0:13:11.37,0:13:14.01,Caption,,0,0,0,,СТОРОНУ МОЖНО ТЯНУТЬ СКОЛЬКО УГОДНО. ГЛАВНОЕ,
Dialogue: 0,0:13:14.17,0:13:16.57,Caption,,0,0,0,,ЧТОБЫ ВИЛКУ НИКТО НЕ ВЫДЕРНУЛ. И НА ЭТОМ
Dialogue: 0,0:13:16.57,0:13:18.81,Caption,,0,0,0,,ФОНЕ ПОЯВЛЯЮТСЯ ЕЩЁ ДВЕ ПУБЛИКАЦИИ,
Dialogue: 0,0:13:18.98,0:13:21.21,Caption,,0,0,0,,КОТОРЫЕ УЖЕ НЕ ПРО ЖЕЛЕЗО. ОДНА ИЗ НИХ
Dialogue: 0,0:13:21.21,0:13:25.65,Caption,,0,0,0,,ПОМЕЧЕНА КАК СЛУХ. ТАМ УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:13:25.95,0:13:28.93,Caption,,0,0,0,,ЧТО БАНКОВАЯ ЕЩЁ В СЕРЕДИНЕ ОКТЯБРЯ ПОСТАВИЛА ЗАДАЧУ
Dialogue: 0,0:13:28.93,0:13:31.65,Caption,,0,0,0,,НЕ СНИЖАТЬ ИНТЕНСИВНОСТЬ НАСТУПАТЕЛЬНЫХ ДЕЙСТВИЙ
Dialogue: 0,0:13:31.73,0:13:34.85,Caption,,0,0,0,,ТАМ, ГДЕ ЭТО УДАЁТСЯ. ПО ВЕРСИИ ИСТОЧНИКА,
Dialogue: 0,0:13:35.09,0:13:37.17,Caption,,0,0,0,,ПЕХОТУ ПРОДОЛЖАЮТ ОТПРАВЛЯТЬ НА ШТУРМЫ,
Dialogue: 0,0:13:37.33,0:13:41.33,Caption,,0,0,0,,РЕЗУЛЬТАТ НЕБОЛЬШОЙ, РАСХОД ЛЮДЕЙ ВЫСОКИЙ. ТАМ ЖЕ УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:13:41.57,0:13:43.97,Caption,,0,0,0,,ЧТО КОМАНДОВАНИЕ ПРЕДУПРЕЖДАЛО О РИСКЕ ТЯЖЁЛОЙ
Dialogue: 0,0:13:44.05,0:13:47.17,Caption,,0,0,0,,СИТУАЦИИ С ЛИЧНЫМ СОСТАВОМ, А ОТВЕТ СВЁЛСЯ К ТОМУ,
Dialogue: 0,0:13:47.33,0:13:49.81,Caption,,0,0,0,,ЧТО ЛЮДЕЙ НАЙДУТ ЧЕРЕЗ УСИЛЕНИЕ МОБИЛИЗАЦИИ.
Dialogue: 0,0:13:50.46,0:13:53.25,Caption,,0,0,0,,ИСТОЧНИК ИСПОЛЬЗУЕТ ЕЩЁ БОЛЕЕ ЖЁСТКОЕ ВЫРАЖЕНИЕ
Dialogue: 0,0:13:53.33,0:13:56.69,Caption,,0,0,0,,НОВЫЕ СОЛДАТЫ КРЕПОСТНЫЕ. ЭТО СЛУХОВОЙ КАНАЛ. ТАК
Dialogue: 0,0:13:56.77,0:13:59.25,Caption,,0,0,0,,ЕГО И НАДО ВОСПРИНИМАТЬ. НО РЯДОМ ЛЕЖИТ ДРУГОЕ
Dialogue: 0,0:13:59.25,0:14:02.13,Caption,,0,0,0,,СООБЩЕНИЕ. В ХЕРСОНСКОЙ ОБЛАСТИ ОДНА ИЗ ЖИТЕЛЬНИЦ
Dialogue: 0,0:14:02.13,0:14:05.41,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО МЕСТНЫМ ПЛАТЯТ ЗА ИНФОРМАЦИЮ О МУЖЧИНАХ
Dialogue: 0,0:14:05.41,0:14:08.53,Caption,,0,0,0,,ПРИЗЫВНОГО ВОЗРАСТА, КОТОРЫХ РАЗЫСКИВАЮТ СОТРУДНИКИ ТЦК.
Dialogue: 0,0:14:09.33,0:14:11.89,Caption,,0,0,0,,В ЕЁ РАССКАЗЕ УЧАСТВУЮТ ДАЖЕ ПОДРОСТКИ НА МОПЕДАХ,
Dialogue: 0,0:14:11.99,0:14:14.85,Caption,,0,0,0,,КОТОРЫЕ ОТСЛЕЖИВАЮТ ПЕРЕДВИЖЕНИЯ МУЖЧИН И ПЕРЕДАЮТ
Dialogue: 0,0:14:14.85,0:14:17.97,Caption,,0,0,0,,СВЕДЕНИЯ ЗА ДЕНЬГИ. ИСТОРИЯ НЕПОДТВЕРЖДЁННАЯ. НО
Dialogue: 0,0:14:17.97,0:14:20.69,Caption,,0,0,0,,САМА ЛОГИКА, КОТОРУЮ РИСУЮТ ОБА СООБЩЕНИЯ,
Dialogue: 0,0:14:20.85,0:14:24.13,Caption,,0,0,0,,ДОВОЛЬНО МЕРЗКАЯ. СВЕРХУ ТРЕБУЕТСЯ ПРОДОЛЖАТЬ. СНИЗУ
Dialogue: 0,0:14:24.13,0:14:27.49,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ РЕСУРС. МЕЖДУ НИМИ ПОЯВЛЯЕТСЯ СИСТЕМА,
Dialogue: 0,0:14:27.65,0:14:30.37,Caption,,0,0,0,,ЗАДАЧА КОТОРОЙ НАЙТИ ЕЩЁ ЛЮДЕЙ. И ТУТ ВСЁ
Dialogue: 0,0:14:30.45,0:14:33.25,Caption,,0,0,0,,СХОДИТСЯ В ОДНОЙ ТОЧКЕ. ЖЕЛЕЗНОЙ ДОРОГЕ НУЖНЫ
Dialogue: 0,0:14:33.25,0:14:35.65,Caption,,0,0,0,,ЛОКОМОТИВЫ, МОСТАМ РЕМОНТНЫЕ БРИГАДЫ,
Dialogue: 0,0:14:35.96,0:14:38.13,Caption,,0,0,0,,БЕСПИЛОТНИКАМ СВЯЗЬ, ПЕХОТЕ ЛЮДИ.
Dialogue: 0,0:14:40.42,0:14:42.50,Caption,,0,0,0,,И ВСЁ ЭТО ОДНОВРЕМЕННО ТРЕБУЕТ ЗАМЕНЫ,
Dialogue: 0,0:14:42.62,0:14:45.70,Caption,,0,0,0,,ВОССТАНОВЛЕНИЯ И НОВЫХ РЕСУРСОВ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:14:45.70,0:14:49.14,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ОЧЕНЬ НЕПРИЯТНАЯ ДЛЯ КИЕВА ВЕЩЬ. ОДНО
Dialogue: 0,0:14:49.22,0:14:51.94,Caption,,0,0,0,,ДЕЛО НАНОСИТЬ УДАРЫ ПРОТИВНИКУ. ДРУГОЕ ДЕЛО
Dialogue: 0,0:14:51.94,0:14:54.66,Caption,,0,0,0,,СОХРАНЯТЬ СОБСТВЕННУЮ СИСТЕМУ В РАБОЧЕМ СОСТОЯНИИ.
Dialogue: 0,0:14:55.20,0:14:57.46,Caption,,0,0,0,,УКРАИНА ПРОДОЛЖАЕТ ДОСТАВАТЬ РОССИЙСКИЕ НПЗ.
Dialogue: 0,0:14:58.02,0:15:01.14,Caption,,0,0,0,,ПРОДОЛЖАЕТ ПЫТАТЬСЯ БИТЬ ПО КРЫМСКОМУ МОСТУ. РОССИЯ
Dialogue: 0,0:15:01.14,0:15:02.90,Caption,,0,0,0,,ПРОДОЛЖАЕТ ДАВИТЬ НА ТРАНСПОРТ,
Dialogue: 0,0:15:02.98,0:15:06.42,Caption,,0,0,0,,ЭНЕРГЕТИКУ И ВОЕННУЮ ЛОГИСТИКУ УКРАИНЫ. ОБЕ СТОРОНЫ
Dialogue: 0,0:15:06.42,0:15:09.22,Caption,,0,0,0,,ИЩУТ УЯЗВИМОЕ МЕСТО ДРУГОЙ СТОРОНЫ. ТОЛЬКО
Dialogue: 0,0:15:09.22,0:15:11.14,Caption,,0,0,0,,УСТОЙЧИВОСТЬ ОПРЕДЕЛЯЕТСЯ НЕ ТЕМ,
Dialogue: 0,0:15:11.38,0:15:14.02,Caption,,0,0,0,,КТО ГРОМЧЕ СООБЩИЛ ОБ ОЧЕРЕДНОМ ПОПАДАНИИ. ОНА
Dialogue: 0,0:15:14.02,0:15:18.02,Caption,,0,0,0,,ОПРЕДЕЛЯЕТСЯ ТЕМ, СКОЛЬКО РАЗ ПОСЛЕ ПОПАДАНИЯ ТЫ СПОСОБЕН ВСТАТЬ,
Dialogue: 0,0:15:18.18,0:15:22.02,Caption,,0,0,0,,ВОССТАНОВИТЬ, ЗАМЕНИТЬ И ПРОДОЛЖИТЬ РАБОТАТЬ. И ТУТ УЖЕ СЧИТАТЬ
Dialogue: 0,0:15:22.02,0:15:24.66,Caption,,0,0,0,,ПРИХОДИТСЯ НЕ ТОЛЬКО РАКЕТЫ. А КОГДА ГОСУДАРСТВО
Dialogue: 0,0:15:24.66,0:15:27.46,Caption,,0,0,0,,ОДНОВРЕМЕННО ОБСУЖДАЕТ, ЧЕМ ЗАМЕНИТЬ МОСТЫ,
Dialogue: 0,0:15:27.62,0:15:31.62,Caption,,0,0,0,,ГДЕ НАЙТИ ТЯГУ, ПОЧЕМУ ОГРАНИЧИЛИ СПУТНИКОВУЮ СВЯЗЬ И ГДЕ ВЗЯТЬ
Dialogue: 0,0:15:31.70,0:15:35.54,Caption,,0,0,0,,НОВЫХ СОЛДАТ, ВОПРОС УЖЕ НЕ В КОЛИЧЕСТВЕ ОТДЕЛЬНЫХ ПРОБЛЕМ. ВОПРОС
Dialogue: 0,0:15:35.62,0:15:38.74,Caption,,0,0,0,,В ТОМ, СКОЛЬКО ТАКИХ ПРОБЛЕМ СИСТЕМА СПОСОБНА ДЕРЖАТЬ
Dialogue: 0,0:15:38.74,0:15:39.46,Caption,,0,0,0,,ОДНОВРЕМЕННО.
