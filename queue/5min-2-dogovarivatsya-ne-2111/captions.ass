Dialogue: 0,0:00:00.11,0:00:02.84,Caption,,0,0,0,,УДИВИТЕЛЬНАЯ ВСЁ ТАКИ ШТУКА ЭТИ МИРНЫЕ ПЕРЕГОВОРЫ.
Dialogue: 0,0:00:03.18,0:00:05.16,Caption,,0,0,0,,ЧЕМ БОЛЬШЕ РАЗГОВОРОВ О СОГЛАСИИ,
Dialogue: 0,0:00:05.40,0:00:07.72,Caption,,0,0,0,,ТЕМ ЧАЩЕ КТО НИБУДЬ ПРЕДЛАГАЕТ ТО,
Dialogue: 0,0:00:07.88,0:00:10.36,Caption,,0,0,0,,НА ЧТО ДРУГАЯ СТОРОНА УЖЕ МНОГО РАЗ ОТВЕТИЛА
Dialogue: 0,0:00:10.36,0:00:12.92,Caption,,0,0,0,,ОТКАЗОМ. И ВЕДЬ НИКТО ДАЖЕ НЕ ПЫТАЕТСЯ СДЕЛАТЬ
Dialogue: 0,0:00:13.00,0:00:16.20,Caption,,0,0,0,,ВИД, ЧТО РАНЬШЕ ЭТОГО ОТВЕТА НЕ СЛЫШАЛ. ПРОСТО СНОВА
Dialogue: 0,0:00:16.20,0:00:19.16,Caption,,0,0,0,,ПОВТОРЯЮТ ПРЕДЛОЖЕНИЕ. С ТАКОЙ НАСТОЙЧИВОСТЬЮ МОЖНО
Dialogue: 0,0:00:19.24,0:00:21.64,Caption,,0,0,0,,И В ЗАКРЫТУЮ ДВЕРЬ СТУЧАТЬ ДО СЛЕДУЮЩЕГО РОЖДЕСТВА.
Dialogue: 0,0:00:21.85,0:00:24.36,Caption,,0,0,0,,ТОЛЬКО ДВЕРЬ ОТ ЭТОГО САМА НЕ ОТКРОЕТСЯ. А
Dialogue: 0,0:00:24.36,0:00:27.00,Caption,,0,0,0,,ВОТ ЗАЧЕМ СНОВА И СНОВА УСТРАИВАТЬ ЭТОТ СПЕКТАКЛЬ,
Dialogue: 0,0:00:27.32,0:00:30.28,Caption,,0,0,0,,ВОПРОС УЖЕ ГОРАЗДО ИНТЕРЕСНЕЕ. ЕСЛИ ВАМ ИНТЕРЕСНЫ
Dialogue: 0,0:00:30.28,0:00:33.72,Caption,,0,0,0,,ТАКИЕ РАЗБОРЫ, ПОДПИШИТЕСЬ. ЗДЕСЬ МЫ СМОТРИМ НЕ НА ТО,
Dialogue: 0,0:00:33.89,0:00:35.72,Caption,,0,0,0,,ЧТО ПОЛИТИКИ СКАЗАЛИ У МИКРОФОНА,
Dialogue: 0,0:00:35.97,0:00:39.48,Caption,,0,0,0,,А НА ТО, ЧТО ОНИ ПОСЛЕ ЭТОГО РЕАЛЬНО ДЕЛАЮТ. ВОТ ПУТИН
Dialogue: 0,0:00:39.48,0:00:43.00,Caption,,0,0,0,,ГОВОРИТ, ЧТО НЕПРЕОДОЛИМЫХ ПРЕПЯТСТВИЙ ДЛЯ СОГЛАШЕНИЯ ОН НЕ
Dialogue: 0,0:00:43.00,0:00:47.00,Caption,,0,0,0,,ВИДИТ. ГОВОРИТ, ЧТО УСЛОВИЯ И КОМПРОМИССЫ БЫЛИ ПРЕДЛОЖЕНЫ ЕЩЁ ДО
Dialogue: 0,0:00:47.08,0:00:50.04,Caption,,0,0,0,,АНКОРИДЖА, И ЕСЛИ КИЕВ ХОЧЕТ ЗАКОНЧИТЬ КОНФЛИКТ,
Dialogue: 0,0:00:50.28,0:00:53.48,Caption,,0,0,0,,НАДО С НИМИ РАБОТАТЬ. ЗВУЧИТ ПОЧТИ МИРОЛЮБИВО. НО
Dialogue: 0,0:00:53.56,0:00:56.52,Caption,,0,0,0,,РЯДОМ ПОЯВЛЯЕТСЯ ДРУГОЕ ЗАЯВЛЕНИЕ. ПОСЛЕ УДАРА ПО
Dialogue: 0,0:00:56.52,0:00:59.56,Caption,,0,0,0,,КРЫМСКОМУ МОСТУ ОТДЕЛЬНЫЕ ВАРИАНТЫ ПРЕКРАЩЕНИЯ ОГНЯ
Dialogue: 0,0:00:59.56,0:01:02.12,Caption,,0,0,0,,МОСКВА БОЛЬШЕ ОБСУЖДАТЬ НЕ ХОЧЕТ. И ВОТ ЭТО
Dialogue: 0,0:01:02.12,0:01:05.40,Caption,,0,0,0,,УЖЕ ИНТЕРЕСНЕЕ САМОГО МОСТА. ПОСЛЕ УДАРА ИЗМЕНИЛСЯ
Dialogue: 0,0:01:05.40,0:01:08.20,Caption,,0,0,0,,НЕ ТОЛЬКО ВОЕННЫЙ ФОН. СУЗИЛОСЬ ПОЛЕ ТОГО,
Dialogue: 0,0:01:08.44,0:01:10.84,Caption,,0,0,0,,ЧТО МОСКВА ВООБЩЕ ГОТОВА ОБСУЖДАТЬ ПО ДОРОГЕ К
Dialogue: 0,0:01:10.92,0:01:17.27,Caption,,0,0,0,,БОЛЬШОМУ СОГЛАШЕНИЮ. ТО ЕСТЬ КАРТИНА ПОЛУЧАЕТСЯ ЗАНЯТНАЯ. ОКОНЧАТЕЛЬНОЕ
Dialogue: 0,0:01:17.35,0:01:19.83,Caption,,0,0,0,,СОГЛАШЕНИЕ ПУТИН НЕ СНИМАЕТ СО СТОЛА. А
Dialogue: 0,0:01:19.83,0:01:22.95,Caption,,0,0,0,,ПРОМЕЖУТОЧНЫЕ ВАРИАНТЫ, КОТОРЫЕ ЕЩЁ НЕДАВНО ОБСУЖДАЛИСЬ,
Dialogue: 0,0:01:23.19,0:01:26.39,Caption,,0,0,0,,ПОСЛЕ УДАРА НАЧИНАЮТ ИСЧЕЗАТЬ. И ЗДЕСЬ ЕСТЬ ВАЖНАЯ
Dialogue: 0,0:01:26.47,0:01:29.59,Caption,,0,0,0,,РАЗНИЦА. ОДНО ДЕЛО ОБСУЖДАТЬ БОЛЬШОЕ СОГЛАШЕНИЕ,
Dialogue: 0,0:01:29.75,0:01:32.23,Caption,,0,0,0,,ГДЕ КАЖДАЯ СТОРОНА ПЫТАЕТСЯ ПОЛУЧИТЬ ВСЁ СРАЗУ.
Dialogue: 0,0:01:32.51,0:01:35.51,Caption,,0,0,0,,ДРУГОЕ ДЕЛО ДОГОВАРИВАТЬСЯ ПО КУСКАМ ЗДЕСЬ НЕ БЬЁМ,
Dialogue: 0,0:01:35.74,0:01:38.63,Caption,,0,0,0,,ТАМ ДЕЛАЕМ ПАУЗУ, ЗДЕСЬ ОГРАНИЧИВАЕМ УДАРЫ,
Dialogue: 0,0:01:38.95,0:01:42.15,Caption,,0,0,0,,ТАМ ОТКРЫВАЕМ ОТДЕЛЬНЫЙ КОРИДОР. ТАКИЕ ПРОМЕЖУТОЧНЫЕ
Dialogue: 0,0:01:42.15,0:01:44.07,Caption,,0,0,0,,ДОГОВОРЁННОСТИ ВСЕГДА УДОБНЫ ТОМУ,
Dialogue: 0,0:01:44.23,0:01:47.19,Caption,,0,0,0,,КТО ХОЧЕТ СНИЗИТЬ ДАВЛЕНИЕ ПРЯМО СЕЙЧАС. НО ЕСЛИ
Dialogue: 0,0:01:47.27,0:01:51.43,Caption,,0,0,0,,ОДНА СТОРОНА СЧИТАЕТ, ЧТО ВРЕМЯ И ВОЕННАЯ ДИНАМИКА РАБОТАЮТ НА НЕЁ,
Dialogue: 0,0:01:51.74,0:01:53.99,Caption,,0,0,0,,ЗАЧЕМ ЕЙ СПЕШИТЬ РАЗДАВАТЬ ТАКИЕ СКИДКИ?
Dialogue: 0,0:01:54.21,0:01:57.11,Caption,,0,0,0,,ВОТ ПОЭТОМУ ОТКАЗ ОТ ОТДЕЛЬНЫХ ВАРИАНТОВ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:01:57.19,0:01:59.99,Caption,,0,0,0,,ОГНЯ МОЖЕТ БЫТЬ ВАЖНЕЕ ДЕСЯТКА ГРОМКИХ ЗАЯВЛЕНИЙ О
Dialogue: 0,0:01:59.99,0:02:02.79,Caption,,0,0,0,,МИРЕ. ЭТО УЖЕ НЕ СЛОВА О НАМЕРЕНИЯХ. ЭТО
Dialogue: 0,0:02:02.87,0:02:05.99,Caption,,0,0,0,,ИЗМЕНЕНИЕ ЦЕНЫ ВХОДА В ПЕРЕГОВОРЫ. РАНЬШЕ МОЖНО БЫЛО
Dialogue: 0,0:02:06.07,0:02:08.47,Caption,,0,0,0,,ОБСУЖДАТЬ ЧАСТИЧНЫЙ КОМПРОМИСС. ТЕПЕРЬ,
Dialogue: 0,0:02:08.55,0:02:11.99,Caption,,0,0,0,,ПОСЛЕ НОВОГО ВИТКА, МОСКВА ПОКАЗЫВАЕТ ХОТИТЕ РАЗГОВАРИВАТЬ,
Dialogue: 0,0:02:12.14,0:02:14.95,Caption,,0,0,0,,РАЗГОВАРИВАЙТЕ УЖЕ О БОЛЕЕ КРУПНОЙ КОНСТРУКЦИИ. И
Dialogue: 0,0:02:15.03,0:02:19.83,Caption,,0,0,0,,ЭТО УЖЕ НЕ ПРО БЕТОН, ПРОЛЁТЫ И СПУТНИКОВЫЕ СНИМКИ. ЭТО ПРО ЦЕНУ КАЖДОГО
Dialogue: 0,0:02:19.91,0:02:22.95,Caption,,0,0,0,,НОВОГО ВИТКА ЭСКАЛАЦИИ. ЗЕЛЕНСКИЙ ПРИ ЭТОМ ГОВОРИТ,
Dialogue: 0,0:02:23.27,0:02:26.07,Caption,,0,0,0,,ЧТО РОССИЯ ОТВЕРГЛА ВСЕ ПРЕДЛОЖЕНИЯ О ПРЕКРАЩЕНИИ
Dialogue: 0,0:02:26.15,0:02:29.72,Caption,,0,0,0,,ОГНЯ. МОСКВА ОТВЕЧАЕТ,
Dialogue: 0,0:02:29.96,0:02:34.28,Caption,,0,0,0,,ЧТО ХОЧЕТ ЗАКОНЧИТЬ КОНФЛИКТ, НО НА СВОИХ УСЛОВИЯХ. И ЕСЛИ СЛУШАТЬ ТОЛЬКО
Dialogue: 0,0:02:34.28,0:02:37.72,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, МОЖНО БЫСТРО СОЙТИ С УМА. ОДИН ГОВОРИТ,
Dialogue: 0,0:02:37.99,0:02:40.44,Caption,,0,0,0,,ЧТО ДРУГОЙ НЕ ХОЧЕТ МИРА. ДРУГОЙ ГОВОРИТ,
Dialogue: 0,0:02:40.60,0:02:43.48,Caption,,0,0,0,,ЧТО ПЕРВЫЙ НЕ ХОЧЕТ СОГЛАШАТЬСЯ НА МИР. ОБЫЧНЫЙ
Dialogue: 0,0:02:43.48,0:02:46.44,Caption,,0,0,0,,СЕМЕЙНЫЙ СКАНДАЛ, ТОЛЬКО ВМЕСТО КУХНИ У НИХ ФРОНТ,
Dialogue: 0,0:02:46.60,0:02:49.48,Caption,,0,0,0,,РАКЕТЫ И НЕСКОЛЬКО СОТЕН МИЛЛИАРДОВ ДОЛЛАРОВ.
Dialogue: 0,0:02:49.80,0:02:51.72,Caption,,0,0,0,,ПОЭТОМУ СМОТРЕТЬ НАДО НЕ НА СЛОВА,
Dialogue: 0,0:02:51.88,0:02:54.68,Caption,,0,0,0,,А НА РЕШЕНИЯ. ПОСЛЕ ОЧЕРЕДНОЙ АТАКИ НА КРЫМСКИЙ
Dialogue: 0,0:02:54.68,0:02:58.36,Caption,,0,0,0,,МОСТ ПО КИЕВУ ПРОШЛИ УДАРЫ. УКРАИНСКИЕ СМИ СООБЩАЛИ
Dialogue: 0,0:02:58.36,0:03:00.76,Caption,,0,0,0,,О БАЛЛИСТИЧЕСКИХ РАКЕТАХ ПО НЕСКОЛЬКИМ МОСТАМ
Dialogue: 0,0:03:00.84,0:03:03.96,Caption,,0,0,0,,СТОЛИЦЫ. РОССИЙСКОЕ МИНОБОРОНЫ ЗАЯВИЛО ОБ УДАРАХ ПО
Dialogue: 0,0:03:03.96,0:03:07.48,Caption,,0,0,0,,ПРЕДПРИЯТИЯМ, СВЯЗАННЫМ С ПРОИЗВОДСТВОМ РАКЕТ И БЕСПИЛОТНИКОВ,
Dialogue: 0,0:03:07.64,0:03:11.96,Caption,,0,0,0,,ПО СКЛАДАМ, ЛОГИСТИКЕ И ПЕРЕПРАВАМ. УКРАИНСКАЯ СТОРОНА ДАЛА СВОЮ
Dialogue: 0,0:03:11.96,0:03:14.44,Caption,,0,0,0,,ОЦЕНКУ ПОСЛЕДСТВИЙ. ПОКА ВСЕ ОБСУЖДАЮТ,
Dialogue: 0,0:03:14.52,0:03:19.32,Caption,,0,0,0,,КАК ЗАКОНЧИТЬ КОНФЛИКТ, УКРАИНА УЖЕ СТРОИТ ПЛАНЫ НА СЛЕДУЮЩИЙ ГОД. МИНИСТР
Dialogue: 0,0:03:19.32,0:03:21.96,Caption,,0,0,0,,ОБОРОНЫ УКРАИНЫ ГОВОРИТ О БОЛЕЕ ЧЕМ ТРЁХКРАТНОМ
Dialogue: 0,0:03:21.96,0:03:24.60,Caption,,0,0,0,,УВЕЛИЧЕНИИ ПРОИЗВОДСТВА ДАЛЬНОБОЙНЫХ БЕСПИЛОТНИКОВ К
Dialogue: 0,0:03:24.68,0:03:26.36,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМУ ГОДУ.
Dialogue: 0,0:03:26.92,0:03:28.92,Caption,,0,0,0,,НА БЕСПИЛОТНЫЕ СИСТЕМЫ СОБИРАЮТСЯ НАПРАВИТЬ
Dialogue: 0,0:03:28.92,0:03:31.72,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ДВА ПРОЦЕНТА ИНОСТРАННОГО ФИНАНСИРОВАНИЯ.
Dialogue: 0,0:03:31.96,0:03:34.76,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ДВА ПРОЦЕНТА. ТО ЕСТЬ ГРУБО ГОВОРЯ,
Dialogue: 0,0:03:35.02,0:03:37.96,Caption,,0,0,0,,ИЗ КАЖДЫХ ДЕСЯТИ УСЛОВНЫХ ЕВРО ИНОСТРАННОЙ ПОМОЩИ
Dialogue: 0,0:03:37.96,0:03:40.84,Caption,,0,0,0,,БОЛЬШЕ ШЕСТИ ХОТЯТ НАПРАВЛЯТЬ НА ДРОНЫ РАЗНЫХ ТИПОВ.
Dialogue: 0,0:03:43.13,0:03:45.61,Caption,,0,0,0,,ВОТ ЭТО УЖЕ РАЗГОВОР НЕ О КРАСИВЫХ ЗАЯВЛЕНИЯХ.
Dialogue: 0,0:03:46.04,0:03:48.57,Caption,,0,0,0,,ПОТОМУ ЧТО ЗАВОД, ПРОИЗВОДСТВЕННАЯ ЛИНИЯ,
Dialogue: 0,0:03:48.66,0:03:51.61,Caption,,0,0,0,,КОМПОНЕНТЫ, СПЕЦИАЛИСТЫ, КОНТРАКТЫ,
Dialogue: 0,0:03:51.77,0:03:54.49,Caption,,0,0,0,,СОВМЕСТНЫЕ ПРЕДПРИЯТИЯ, ЛОГИСТИКА,
Dialogue: 0,0:03:54.57,0:03:58.25,Caption,,0,0,0,,ОБУЧЕНИЕ, ВСЁ ЭТО НЕ СОЗДАЁТСЯ НА ОДИН МЕСЯЦ. ЕСЛИ
Dialogue: 0,0:03:58.25,0:04:01.05,Caption,,0,0,0,,ГОСУДАРСТВО СТРОИТ ТАКУЮ ПРОГРАММУ НА СЛЕДУЮЩИЙ ГОД,
Dialogue: 0,0:04:01.37,0:04:03.77,Caption,,0,0,0,,ОНО ЗАКЛАДЫВАЕТ СПОСОБНОСТЬ ВОЕВАТЬ И НАНОСИТЬ
Dialogue: 0,0:04:03.85,0:04:08.49,Caption,,0,0,0,,ДАЛЬНИЕ УДАРЫ НЕ НА СЛУЧАЙ, ЕСЛИ ПЕРЕГОВОРЫ ПРОВАЛЯТСЯ КОГДА НИБУДЬ ПОТОМ. ОНО
Dialogue: 0,0:04:08.57,0:04:11.13,Caption,,0,0,0,,ГОТОВИТ ЭТУ СПОСОБНОСТЬ ЗАРАНЕЕ. И ЗДЕСЬ ВАЖЕН
Dialogue: 0,0:04:11.13,0:04:14.81,Caption,,0,0,0,,ИМЕННО ГОРИЗОНТ ПЛАНИРОВАНИЯ. НЕ НЕДЕЛЯ. НЕ МЕСЯЦ.
Dialogue: 0,0:04:14.89,0:04:18.25,Caption,,0,0,0,,СЛЕДУЮЩИЙ ГОД. ЗНАЧИТ, УЖЕ СЧИТАЮТ ОБЪЁМЫ,
Dialogue: 0,0:04:18.33,0:04:20.97,Caption,,0,0,0,,КОМПЛЕКТУЮЩИЕ, МОЩНОСТИ И ДЕНЬГИ ТАК,
Dialogue: 0,0:04:21.21,0:04:23.85,Caption,,0,0,0,,БУДТО СПРОС НА ТАКОЕ ОРУЖИЕ НИКУДА НЕ ИСЧЕЗНЕТ.
Dialogue: 0,0:04:24.09,0:04:26.17,Caption,,0,0,0,,И РОССИЙСКИЕ УДАРЫ ПО ПРЕДПРИЯТИЯМ,
Dialogue: 0,0:04:26.31,0:04:28.89,Caption,,0,0,0,,СКЛАДАМ И ЛОГИСТИКЕ ТОГДА ВЫГЛЯДЯТ УЖЕ НЕ КАК
Dialogue: 0,0:04:28.97,0:04:32.97,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ЭПИЗОДЫ, А КАК БОРЬБА С БУДУЩЕЙ ПРОИЗВОДСТВЕННОЙ МОЩНОСТЬЮ.
Dialogue: 0,0:04:33.17,0:04:37.29,Caption,,0,0,0,,НЕ ТОЛЬКО УНИЧТОЖИТЬ ТО, ЧТО УЖЕ СОБРАНО. НЕ ДАТЬ СОБРАТЬ ТО,
Dialogue: 0,0:04:37.37,0:04:40.49,Caption,,0,0,0,,ЧТО ЗАПЛАНИРОВАНО НА СЛЕДУЮЩИЙ ГОД. ПОЛУЧАЕТСЯ ОЧЕНЬ
Dialogue: 0,0:04:40.49,0:04:43.29,Caption,,0,0,0,,СТРАННЫЙ МИРНЫЙ ПРОЦЕСС. ЗА СТОЛОМ ОБСУЖДАЮТ
Dialogue: 0,0:04:43.29,0:04:46.33,Caption,,0,0,0,,ПРЕКРАЩЕНИЕ КОНФЛИКТА. А ВОКРУГ СТОЛА УЖЕ СЧИТАЮТ,
Dialogue: 0,0:04:46.57,0:04:49.29,Caption,,0,0,0,,СКОЛЬКО БЕСПИЛОТНИКОВ ПОНАДОБИТСЯ ЧЕРЕЗ ГОД И КАКИЕ
Dialogue: 0,0:04:49.37,0:04:54.01,Caption,,0,0,0,,ЗАВОДЫ НАДО ВЫВЕСТИ ИЗ СТРОЯ, ЧТОБЫ ЭТИ БЕСПИЛОТНИКИ НЕ ПОЯВИЛИСЬ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:04:54.23,0:04:56.41,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ДАЛЬШЕ РАЗБИРАТЬ ИМЕННО ТАКИЕ
Dialogue: 0,0:04:56.41,0:05:01.64,Caption,,0,0,0,,НЕСОСТЫКОВКИ. ПОТОМУ ЧТО В ОФИЦИАЛЬНЫХ ЗАЯВЛЕНИЯХ ВСЁ ОБЫЧНО
Dialogue: 0,0:05:01.64,0:05:04.36,Caption,,0,0,0,,ГЛАДКО. САМОЕ ИНТЕРЕСНОЕ НАЧИНАЕТСЯ ТАМ,
Dialogue: 0,0:05:04.60,0:05:07.80,Caption,,0,0,0,,ГДЕ ЗАЯВЛЕНИЯ СТАЛКИВАЮТСЯ С РЕАЛЬНЫМИ РЕШЕНИЯМИ. И
Dialogue: 0,0:05:07.88,0:05:10.52,Caption,,0,0,0,,ВОТ НА ЭТОМ ФОНЕ ВЫХОДИТ МАКРОН И ПРЕДЛАГАЕТ
Dialogue: 0,0:05:10.52,0:05:13.24,Caption,,0,0,0,,СНОВА ПОДНЯТЬ ВОПРОС О ВСТУПЛЕНИИ УКРАИНЫ В НАТО.
Dialogue: 0,0:05:13.45,0:05:15.96,Caption,,0,0,0,,ПРЕКРАСНО. ТО ЕСТЬ ТАК ХОТЯТ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:05:16.20,0:05:18.92,Caption,,0,0,0,,ЧТО СНОВА ТАЩАТ НА СТОЛ САМУЮ РАЗДРАЖАЮЩУЮ ДЛЯ
Dialogue: 0,0:05:19.00,0:05:22.36,Caption,,0,0,0,,МОСКВЫ ТЕМУ. ВОТ ТАК. ВОТ ТОГДА ТОЧНО ДОГОВОРИМСЯ.
Dialogue: 0,0:05:22.57,0:05:24.92,Caption,,0,0,0,,СЕЙЧАС ПОЛОЖИМ ЭТУ СТАРУЮ ПАПКУ НА СТОЛ,
Dialogue: 0,0:05:25.24,0:05:28.12,Caption,,0,0,0,,МОСКВА ПОСМОТРИТ, ВЗДОХНЁТ И СКАЖЕТ НУ ЛАДНО,
Dialogue: 0,0:05:28.42,0:05:32.52,Caption,,0,0,0,,РАЗ ВЫ ОПЯТЬ ПРИНЕСЛИ НАТО, ТОГДА СДАЁМСЯ. ТАКОЕ ВПЕЧАТЛЕНИЕ,
Dialogue: 0,0:05:32.76,0:05:35.40,Caption,,0,0,0,,ЧТО ПРОСТО НЕ ПОНИМАЕТСЯ СЛОВО "НЕТ". ВОТ КАК
Dialogue: 0,0:05:35.40,0:05:37.32,Caption,,0,0,0,,ЕЩЁ МОЖНО СКАЗАТЬ, ЧТО ЭТО НЕТ?
Dialogue: 0,0:05:37.75,0:05:40.60,Caption,,0,0,0,,САМОЕ СМЕШНОЕ, ЧТО МАКРОН ПРЕКРАСНО ЗНАЕТ,
Dialogue: 0,0:05:40.76,0:05:43.16,Caption,,0,0,0,,В ЧЁМ КОНФЛИКТ РОССИИ И НАТО. ЛЮДИ,
Dialogue: 0,0:05:43.24,0:05:47.40,Caption,,0,0,0,,КОТОРЫЕ ЕГО КОНСУЛЬТИРУЮТ, ЗНАЮТ ЕЩЁ ЛУЧШЕ. И ВСЁ РАВНО СТАРАЯ ПАПКА
Dialogue: 0,0:05:47.40,0:05:50.28,Caption,,0,0,0,,СНОВА ПОЯВЛЯЕТСЯ НА СТОЛЕ. ПОЭТОМУ ВОПРОС ЗДЕСЬ НЕ
Dialogue: 0,0:05:50.36,0:05:54.12,Caption,,0,0,0,,В ТОМ, УСЛЫШИТ ЛИ МОСКВА ПРЕДЛОЖЕНИЕ. УСЛЫШИТ. УЖЕ СЛЫШАЛА.
Dialogue: 0,0:05:54.45,0:05:57.64,Caption,,0,0,0,,ВОПРОС В ДРУГОМ. ЗАЧЕМ СНОВА ТАЩИТЬ В ПЕРЕГОВОРЫ
Dialogue: 0,0:05:57.72,0:06:00.68,Caption,,0,0,0,,ТО, ЧТО ПОЧТИ ГАРАНТИРОВАННО УВЕЛИЧИТ РАЗРЫВ МЕЖДУ
Dialogue: 0,0:06:00.68,0:06:03.48,Caption,,0,0,0,,ПОЗИЦИЯМИ? ЕСЛИ ЦЕЛЬ СОСТОИТ ТОЛЬКО В ТОМ,
Dialogue: 0,0:06:03.64,0:06:05.56,Caption,,0,0,0,,ЧТОБЫ БЫСТРЕЕ ПОЛУЧИТЬ СОГЛАШЕНИЕ,
Dialogue: 0,0:06:05.88,0:06:07.96,Caption,,0,0,0,,ТАКОЙ ХОД ВЫГЛЯДИТ КАК МИНИМУМ СТРАННО.
Dialogue: 0,0:06:10.25,0:06:14.17,Caption,,0,0,0,,ЕСЛИ ЖЕ ЦЕЛЬ ЕЩЁ И В ТОМ, ЧТОБЫ ПОДНЯТЬ ЦЕНУ БУДУЩЕГО КОМПРОМИССА,
Dialogue: 0,0:06:14.49,0:06:16.89,Caption,,0,0,0,,РАСШИРИТЬ ПОЛЕ ТОРГА ИЛИ ЗАРАНЕЕ ПОКАЗАТЬ
Dialogue: 0,0:06:16.89,0:06:20.49,Caption,,0,0,0,,СОБСТВЕННЫМ ИЗБИРАТЕЛЯМ, ЧТО ЕВРОПА НЕ СДАЁТ ПРЕЖНИЕ ПОЗИЦИИ,
Dialogue: 0,0:06:20.81,0:06:24.01,Caption,,0,0,0,,ТОГДА ЛОГИКА ПОЯВЛЯЕТСЯ. И ЗДЕСЬ МАКРОН РЕШАЕТ СРАЗУ
Dialogue: 0,0:06:24.09,0:06:26.65,Caption,,0,0,0,,НЕСКОЛЬКО ЗАДАЧ. ДЛЯ КИЕВА ПОКАЗЫВАЕТ,
Dialogue: 0,0:06:26.81,0:06:29.85,Caption,,0,0,0,,ЧТО ТЕМА НАТО НЕ ПОХОРОНЕНА. ДЛЯ МОСКВЫ ПОВЫШАЕТ
Dialogue: 0,0:06:29.85,0:06:32.65,Caption,,0,0,0,,ЦЕНУ БУДУЩЕГО ОТКАЗА ЕВРОПЫ ОТ ЭТОЙ ТЕМЫ. ДЛЯ
Dialogue: 0,0:06:32.65,0:06:34.97,Caption,,0,0,0,,САМОЙ ЕВРОПЫ ОСТАВЛЯЕТ НА СТОЛЕ ПРЕДМЕТ,
Dialogue: 0,0:06:35.29,0:06:37.85,Caption,,0,0,0,,КОТОРЫМ ПОТОМ МОЖНО ТОРГОВАТЬСЯ. ПОКА ЭТА СТАРАЯ
Dialogue: 0,0:06:37.93,0:06:41.29,Caption,,0,0,0,,ПАПКА ЛЕЖИТ НА СТОЛЕ, ЕЁ МОЖНО МЕНЯТЬ НА ЧТО ТО ДРУГОЕ НА
Dialogue: 0,0:06:41.29,0:06:44.17,Caption,,0,0,0,,ГАРАНТИИ, ОГРАНИЧЕНИЯ, СРОКИ,
Dialogue: 0,0:06:44.41,0:06:46.89,Caption,,0,0,0,,НОВЫЕ УСЛОВИЯ. ТО ЕСТЬ РЕЧЬ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:06:46.89,0:06:49.37,Caption,,0,0,0,,ОБ УПРЯМСТВЕ. ЭТО ЕЩЁ И ПОПЫТКА НЕ ПРИХОДИТЬ
Dialogue: 0,0:06:49.45,0:06:52.01,Caption,,0,0,0,,НА ПЕРЕГОВОРЫ С ПУСТЫМИ РУКАМИ. НО КОГДА КАЖДАЯ
Dialogue: 0,0:06:52.01,0:06:54.01,Caption,,0,0,0,,СТОРОНА ПРИНОСИТ ПРЕЖДЕ ВСЕГО ТО,
Dialogue: 0,0:06:54.18,0:06:56.41,Caption,,0,0,0,,ЧЕМ ХОЧЕТ ПОВЫСИТЬ ЦЕНУ БУДУЩЕЙ СДЕЛКИ,
Dialogue: 0,0:06:56.73,0:06:59.61,Caption,,0,0,0,,ПЕРЕГОВОРЫ НАЧИНАЮТ БОЛЬШЕ НАПОМИНАТЬ АУКЦИОН. КТО
Dialogue: 0,0:06:59.61,0:07:02.73,Caption,,0,0,0,,ПЕРВЫМ МОРГНЁТ. КТО СНИМЕТ СВОЁ ТРЕБОВАНИЕ. КТО
Dialogue: 0,0:07:02.81,0:07:05.77,Caption,,0,0,0,,УСТУПИТ БОЛЬШЕ. ТОЛЬКО МИРА ОТ ЭТОГО АВТОМАТИЧЕСКИ
Dialogue: 0,0:07:05.77,0:07:08.81,Caption,,0,0,0,,БОЛЬШЕ НЕ СТАНОВИТСЯ. И ЗДЕСЬ ВООБЩЕ ВОЗНИКАЕТ ОДНА
Dialogue: 0,0:07:08.89,0:07:11.37,Caption,,0,0,0,,БОЛЬШАЯ ПРОБЛЕМА НЫНЕШНИХ ПЕРЕГОВОРОВ. КАЖДЫЙ
Dialogue: 0,0:07:11.37,0:07:15.05,Caption,,0,0,0,,УЧАСТНИК ГОВОРИТ О МИРЕ, НО ПОД СЛОВОМ "МИР" У КАЖДОГО ЛЕЖИТ СВОЯ
Dialogue: 0,0:07:15.05,0:07:17.45,Caption,,0,0,0,,ПАПКА. МОСКВА ГОВОРИТ О КОМПРОМИССАХ,
Dialogue: 0,0:07:17.61,0:07:19.05,Caption,,0,0,0,,КОТОРЫЕ БЫЛИ ПРЕДЛОЖЕНЫ РАНЬШЕ,
Dialogue: 0,0:07:19.29,0:07:21.05,Caption,,0,0,0,,И НЕ СОБИРАЕТСЯ ОТ НИХ ОТКАЗЫВАТЬСЯ.
Dialogue: 0,0:07:23.34,0:07:25.18,Caption,,0,0,0,,КИЕВ ГОВОРИТ О ПРЕКРАЩЕНИИ ОГНЯ,
Dialogue: 0,0:07:25.58,0:07:28.14,Caption,,0,0,0,,НО ОДНОВРЕМЕННО ПЛАНИРУЕТ РЕЗКИЙ РОСТ ДАЛЬНОБОЙНЫХ
Dialogue: 0,0:07:28.14,0:07:31.58,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ. ПАРИЖ СНОВА ВЫТАСКИВАЕТ НАТО. А ПОТОМ
Dialogue: 0,0:07:31.66,0:07:35.58,Caption,,0,0,0,,ВСЕ УДИВЛЯЮТСЯ, ПОЧЕМУ ДОГОВОРИТЬСЯ СЛОЖНО. НУ А КАЯ КАЛЛАС НА
Dialogue: 0,0:07:35.58,0:07:38.06,Caption,,0,0,0,,ЭТОМ ФОНЕ РАССКАЗЫВАЕТ О МЕЖДУНАРОДНОЙ ИЗОЛЯЦИИ
Dialogue: 0,0:07:38.06,0:07:41.82,Caption,,0,0,0,,РОССИИ ПЕРЕД ЗАЛОМ, КОТОРЫЙ, СУДЯ ПО ОПУБЛИКОВАННЫМ КАДРАМ,
Dialogue: 0,0:07:42.14,0:07:44.94,Caption,,0,0,0,,ОСОБОГО АЖИОТАЖА НЕ ПЕРЕЖИВАЕТ. КАРТИНКА,
Dialogue: 0,0:07:45.02,0:07:48.22,Caption,,0,0,0,,КОНЕЧНО, ПРЕКРАСНАЯ. ГОВОРИШЬ О МИРОВОЙ ИЗОЛЯЦИИ,
Dialogue: 0,0:07:48.54,0:07:50.70,Caption,,0,0,0,,А СОБСТВЕННЫЙ ГОЛОС ГУЛЯЕТ ПО ЗАЛУ С ТАКИМ
Dialogue: 0,0:07:50.74,0:07:54.70,Caption,,0,0,0,,ЭХОМ, БУДТО ТОЖЕ ИЩЕТ МЕЖДУНАРОДНУЮ ПОДДЕРЖКУ. ПУСТОЙ ЗАЛ
Dialogue: 0,0:07:54.70,0:07:58.14,Caption,,0,0,0,,НЕ ОТМЕНЯЕТ НИ САНКЦИЙ, НИ ДИПЛОМАТИЧЕСКОГО ДАВЛЕНИЯ,
Dialogue: 0,0:07:58.38,0:08:01.34,Caption,,0,0,0,,НИ ПОЗИЦИИ ЕВРОСОЮЗА. ОН ПРОСТО ОЧЕНЬ УДАЧНО
Dialogue: 0,0:08:01.42,0:08:04.46,Caption,,0,0,0,,ПОКАЗЫВАЕТ РАЗНИЦУ МЕЖДУ ТОРЖЕСТВЕННОЙ РИТОРИКОЙ И
Dialogue: 0,0:08:04.46,0:08:07.42,Caption,,0,0,0,,РЕАЛЬНЫМ ВНИМАНИЕМ К НЕЙ. А ТАКАЯ РАЗНИЦА СЕЙЧАС
Dialogue: 0,0:08:07.42,0:08:10.22,Caption,,0,0,0,,ВООБЩЕ СТАНОВИТСЯ ГЛАВНЫМ СЮЖЕТОМ. ВСЕ ГОВОРЯТ О
Dialogue: 0,0:08:10.22,0:08:13.18,Caption,,0,0,0,,МИРЕ. НО МОСКВА ПОСЛЕ НОВОГО ВИТКА ЭСКАЛАЦИИ
Dialogue: 0,0:08:13.18,0:08:15.42,Caption,,0,0,0,,СОКРАЩАЕТ ПРОСТРАНСТВО ДЛЯ ПРОМЕЖУТОЧНЫХ
Dialogue: 0,0:08:15.42,0:08:18.30,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ. УКРАИНА СТРОИТ ПРОГРАММУ ДАЛЬНИХ
Dialogue: 0,0:08:18.30,0:08:21.34,Caption,,0,0,0,,УДАРОВ НА СЛЕДУЮЩИЙ ГОД. РОССИЯ БЬЁТ ПО ОБЪЕКТАМ,
Dialogue: 0,0:08:21.57,0:08:24.54,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ ЭТУ ПРОГРАММУ ОБЕСПЕЧИВАТЬ. МАКРОН
Dialogue: 0,0:08:24.54,0:08:27.66,Caption,,0,0,0,,ВОЗВРАЩАЕТ НАТО В ЦЕНТР РАЗГОВОРА. И КАЖДЫЙ ПРИ
Dialogue: 0,0:08:27.66,0:08:29.82,Caption,,0,0,0,,ЭТОМ МОЖЕТ СОВЕРШЕННО ИСКРЕННЕ ГОВОРИТЬ,
Dialogue: 0,0:08:30.06,0:08:32.94,Caption,,0,0,0,,ЧТО ИМЕННО ОН ХОЧЕТ МИРА. ПОТОМУ ЧТО ХОТЕТЬ
Dialogue: 0,0:08:32.94,0:08:35.42,Caption,,0,0,0,,МИРА И ХОТЕТЬ МИРА НА СВОИХ УСЛОВИЯХ,
Dialogue: 0,0:08:35.73,0:08:42.34,Caption,,0,0,0,,ЭТО ДВЕ ОЧЕНЬ РАЗНЫЕ ВЕЩИ. МОЯ ВЕРСИЯ ПРОСТАЯ. ЗНАЧИТЕЛЬНАЯ ЧАСТЬ НЫНЕШНЕЙ
Dialogue: 0,0:08:42.42,0:08:44.90,Caption,,0,0,0,,МИРНОЙ РИТОРИКИ РАБОТАЕТ УЖЕ НЕ КАК ПОДГОТОВКА К
Dialogue: 0,0:08:44.90,0:08:49.22,Caption,,0,0,0,,БЫСТРОМУ ФИНАЛУ, А КАК БОРЬБА ЗА СТАРТОВУЮ ПОЗИЦИЮ СЛЕДУЮЩЕГО ЭТАПА.
Dialogue: 0,0:08:49.46,0:08:51.86,Caption,,0,0,0,,КТО С ЧЕМ ПОДОЙДЁТ К СЛЕДУЮЩЕМУ РАУНДУ. У
Dialogue: 0,0:08:51.86,0:08:54.74,Caption,,0,0,0,,КОГО ОСТАНЕТСЯ БОЛЬШЕ ВОЕННЫХ ВОЗМОЖНОСТЕЙ. КАКИЕ
Dialogue: 0,0:08:54.74,0:08:57.86,Caption,,0,0,0,,ТРЕБОВАНИЯ БУДУТ ЛЕЖАТЬ НА СТОЛЕ. КАКИЕ ТЕМЫ УДАСТСЯ
Dialogue: 0,0:08:57.94,0:09:00.66,Caption,,0,0,0,,ОБЪЯВИТЬ ПРИНЦИПИАЛЬНЫМИ. И КТО ПОТОМ СМОЖЕТ СКАЗАТЬ
Dialogue: 0,0:09:00.66,0:09:02.50,Caption,,0,0,0,,ЭТО НЕ МЫ СОРВАЛИ ДОГОВОРЁННОСТЬ,
Dialogue: 0,0:09:02.58,0:09:06.34,Caption,,0,0,0,,ЭТО ОНИ ОТКАЗАЛИСЬ. ЧЕМ СИЛЬНЕЕ ТВОЯ ПОЗИЦИЯ НА ЗЕМЛЕ,
Dialogue: 0,0:09:06.50,0:09:08.74,Caption,,0,0,0,,В ВОЗДУХЕ, В ПРОИЗВОДСТВЕ И В ДЕНЬГАХ,
Dialogue: 0,0:09:09.10,0:09:12.02,Caption,,0,0,0,,ТЕМ МЕНЬШЕ ХОЧЕТСЯ СПЕШИТЬ С УСТУПКАМИ. ПОЭТОМУ
Dialogue: 0,0:09:12.02,0:09:15.06,Caption,,0,0,0,,ВОЕННЫЕ РЕШЕНИЯ И ПЕРЕГОВОРЫ ЗДЕСЬ СВЯЗАНЫ НАПРЯМУЮ.
Dialogue: 0,0:09:15.41,0:09:19.06,Caption,,0,0,0,,УДАР МЕНЯЕТ ЦЕНУ УСТУПКИ. ПРОИЗВОДСТВЕННАЯ ПРОГРАММА
Dialogue: 0,0:09:19.14,0:09:22.34,Caption,,0,0,0,,МЕНЯЕТ ОЖИДАНИЯ. А НОВАЯ ТЕМА ВРОДЕ НАТО МЕНЯЕТ
Dialogue: 0,0:09:22.34,0:09:25.22,Caption,,0,0,0,,САМ СПИСОК ТОГО, ЧЕМ ПОТОМ БУДУТ ТОРГОВАТЬСЯ.
Dialogue: 0,0:09:25.77,0:09:28.18,Caption,,0,0,0,,ВОТ ПОЭТОМУ РАЗГОВОР О МИРЕ ИДЁТ ОДНОВРЕМЕННО С
Dialogue: 0,0:09:28.26,0:09:32.10,Caption,,0,0,0,,УДАРАМИ, ПРОИЗВОДСТВЕННЫМИ ПЛАНАМИ И НОВЫМИ ТРЕБОВАНИЯМИ. НЕ
Dialogue: 0,0:09:32.18,0:09:34.34,Caption,,0,0,0,,ПОТОМУ, ЧТО ПОЛИТИКИ ОБЯЗАТЕЛЬНО ВРУТ,
Dialogue: 0,0:09:34.43,0:09:36.50,Caption,,0,0,0,,КОГДА ГОВОРЯТ О МИРЕ. А ПОТОМУ,
Dialogue: 0,0:09:36.68,0:09:39.38,Caption,,0,0,0,,ЧТО КАЖДЫЙ ХОЧЕТ СНАЧАЛА ИЗМЕНИТЬ РЕАЛЬНОСТЬ В СВОЮ
Dialogue: 0,0:09:39.38,0:09:42.74,Caption,,0,0,0,,ПОЛЬЗУ, А УЖЕ ПОТОМ ЗАФИКСИРОВАТЬ ЕЁ НА БУМАГЕ. И
Dialogue: 0,0:09:42.82,0:09:45.54,Caption,,0,0,0,,В ЭТОМ СМЫСЛЕ САМЫЕ ВАЖНЫЕ НОВОСТИ СЕЙЧАС ВООБЩЕ
Dialogue: 0,0:09:45.54,0:09:47.86,Caption,,0,0,0,,НЕ ТЕ, ГДЕ ОЧЕРЕДНОЙ ПОЛИТИК ГОВОРИТ,
Dialogue: 0,0:09:48.02,0:09:52.45,Caption,,0,0,0,,ЧТО ОН ЗА МИР. САМЫЕ ВАЖНЫЕ НОВОСТИ,
Dialogue: 0,0:09:52.61,0:09:55.41,Caption,,0,0,0,,ЭТО БЮДЖЕТЫ, ЗАВОДЫ, КОНТРАКТЫ,
Dialogue: 0,0:09:55.62,0:09:58.05,Caption,,0,0,0,,ЦЕЛИ ДЛЯ УДАРОВ И ТЕ СТАРЫЕ ПАПКИ,
Dialogue: 0,0:09:58.37,0:10:00.77,Caption,,0,0,0,,КОТОРЫЕ СНОВА КЛАДУТ НА СТОЛ. ПОТОМУ ЧТО РЕЧЬ
Dialogue: 0,0:10:00.77,0:10:03.17,Caption,,0,0,0,,МОЖНО ПЕРЕПИСАТЬ ЗА ВЕЧЕР. А ПРОИЗВОДСТВЕННУЮ
Dialogue: 0,0:10:03.25,0:10:05.65,Caption,,0,0,0,,ПРОГРАММУ НА СЛЕДУЮЩИЙ ГОД ЗА ВЕЧЕР НЕ ПЕРЕПИШЕШЬ.
