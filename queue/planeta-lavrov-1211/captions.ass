Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ПЕРЕМИРИЕ ПРИНЯТО СЧИТАТЬ ШАГОМ К МИРУ. В МОСКВЕ
Dialogue: 0,0:00:03.16,0:00:07.96,Caption,,0,0,0,,ЕГО ЧИТАЮТ ИНАЧЕ КАК ВРЕМЯ, КОТОРОЕ ОДНА СТОРОНА ПОТРАТИТ НА ПОДГОТОВКУ,
Dialogue: 0,0:00:08.20,0:00:10.92,Caption,,0,0,0,,А ВТОРАЯ НА ЭТОМ ПОТЕРЯЕТ. ПРИЧИНЫ,
Dialogue: 0,0:00:11.03,0:00:13.56,Caption,,0,0,0,,КОНЕЧНО, ПРЕКРАСНЫЕ, ОСОБЕННО ДЛЯ ТОГО,
Dialogue: 0,0:00:13.72,0:00:15.72,Caption,,0,0,0,,КТО ЭТУ ПАУЗУ И ПРОСИТ. А У ВТОРОЙ
Dialogue: 0,0:00:15.72,0:00:20.28,Caption,,0,0,0,,СТОРОНЫ, КАК ВЫЯСНЯЕТСЯ, ВОПРОСЫ СОВСЕМ НЕ МАЛЕНЬКИЕ. ПОДПИСЫВАЙТЕСЬ НА
Dialogue: 0,0:00:20.28,0:00:25.72,Caption,,0,0,0,,КАНАЛ. СЕГОДНЯ РАЗБИРАЕМСЯ, ПОЧЕМУ СПОР О НЕСКОЛЬКИХ УЧАСТКАХ ФРОНТА НЕОЖИДАННО
Dialogue: 0,0:00:25.72,0:00:28.84,Caption,,0,0,0,,УПИРАЕТСЯ В ПРАВИЛА ДЛЯ ЦЕЛОГО КОНТИНЕНТА И ПОЧЕМУ
Dialogue: 0,0:00:28.84,0:00:31.40,Caption,,0,0,0,,СТАРЫЕ БУМАГИ ОПЯТЬ ПОНАДОБИЛИСЬ ТЕМ,
Dialogue: 0,0:00:31.56,0:00:34.12,Caption,,0,0,0,,КТО КОГДА ТО СЧЁЛ ИХ НЕНУЖНЫМИ. ТО ЕСТЬ
Dialogue: 0,0:00:34.25,0:00:36.44,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ПРЕДЛАГАЮТ НАЖАТЬ НА ПАУЗУ,
Dialogue: 0,0:00:36.67,0:00:41.00,Caption,,0,0,0,,А РОССИЯ СПРАШИВАЕТ, КТО ПОСЛЕ ЭТОЙ ПАУЗЫ УБЕРЁТ СО СТОЛА ЗАРЯЖЕННЫЙ
Dialogue: 0,0:00:41.00,0:00:44.60,Caption,,0,0,0,,ПИСТОЛЕТ. ОТВЕТА ПОКА НЕТ. ЗАТО СЛОВО "ПЕРЕМИРИЕ"
Dialogue: 0,0:00:44.60,0:00:46.76,Caption,,0,0,0,,ПРОИЗНОСЯТ С ТАКИМ ВЫРАЖЕНИЕМ ЛИЦА,
Dialogue: 0,0:00:47.08,0:00:49.72,Caption,,0,0,0,,БУДТО ОНО САМО УМЕЕТ РЕМОНТИРОВАТЬ МЕЖДУНАРОДНЫЕ
Dialogue: 0,0:00:49.72,0:00:52.20,Caption,,0,0,0,,ОТНОШЕНИЯ. ДЛЯ МОСКВЫ НЫНЕШНИЙ КОНФЛИКТ НЕ
Dialogue: 0,0:00:52.20,0:00:55.56,Caption,,0,0,0,,НАЧИНАЕТСЯ И НЕ ЗАКАНЧИВАЕТСЯ УКРАИНОЙ. В РОССИЙСКОМ
Dialogue: 0,0:00:55.56,0:00:58.52,Caption,,0,0,0,,ПОНИМАНИИ ЭТО СПОР О НАТО, ЕГО РАСШИРЕНИИ,
Dialogue: 0,0:00:58.80,0:01:01.08,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЕ, РАКЕТАХ,
Dialogue: 0,0:01:01.24,0:01:05.72,Caption,,0,0,0,,БАЗАХ И РАССТОЯНИИ, НА КОТОРОЕ ОДИН ВОЕННЫЙ СОЮЗ МОЖЕТ ПОДОЙТИ К
Dialogue: 0,0:01:05.72,0:01:08.68,Caption,,0,0,0,,ГРАНИЦАМ ДРУГОГО ГОСУДАРСТВА. УКРАИНА ОКАЗАЛАСЬ В
Dialogue: 0,0:01:08.68,0:01:13.56,Caption,,0,0,0,,САМОМ ЦЕНТРЕ СТОЛКНОВЕНИЯ, НО РАЗМЕРЫ САМОГО СТОЛКНОВЕНИЯ ДАВНО ПРЕВОСХОДЯТ
Dialogue: 0,0:01:13.56,0:01:19.75,Caption,,0,0,0,,УКРАИНСКУЮ ТЕРРИТОРИЮ. ПОЭТОМУ ПРЕДЛОЖЕНИЕ ПРОСТО ПЕРЕСТАТЬ СТРЕЛЯТЬ ДЛЯ
Dialogue: 0,0:01:19.83,0:01:21.59,Caption,,0,0,0,,РОССИИ ВЫГЛЯДИТ НЕ КАК РЕШЕНИЕ,
Dialogue: 0,0:01:21.83,0:01:24.39,Caption,,0,0,0,,А КАК ПРОСЬБА ВРЕМЕННО НЕ МЕШАТЬ ДРУГОЙ СТОРОНЕ
Dialogue: 0,0:01:24.47,0:01:29.11,Caption,,0,0,0,,ГОТОВИТЬСЯ. ФРОНТ ЗАМОЛКАЕТ, А РЕМОНТНЫЕ ПРЕДПРИЯТИЯ НЕТ. ПОДРАЗДЕЛЕНИЯ
Dialogue: 0,0:01:29.11,0:01:31.83,Caption,,0,0,0,,ПОПОЛНЯЮТСЯ, ТЕХНИКА ВОЗВРАЩАЕТСЯ В СТРОЙ,
Dialogue: 0,0:01:31.99,0:01:34.71,Caption,,0,0,0,,СКЛАДЫ ЗАПОЛНЯЮТСЯ, УКРЕПЛЕНИЯ РАСТУТ,
Dialogue: 0,0:01:34.86,0:01:39.51,Caption,,0,0,0,,ЛОГИСТИКА ПЕРЕСТРАИВАЕТСЯ, ЗАПАДНОЕ ОРУЖИЕ ПРИЕЗЖАЕТ. ПЕРЕДЫШКА ПОЛУЧАЕТСЯ
Dialogue: 0,0:01:39.66,0:01:42.55,Caption,,0,0,0,,ОЧЕНЬ БОДРАЯ. ОТДЫХАЕТ ТОЛЬКО СПУСКОВОЙ КРЮЧОК,
Dialogue: 0,0:01:42.63,0:01:45.35,Caption,,0,0,0,,ДА И ТОТ НЕДОЛГО. ПОСЛЕ ЭТОГО МОСКВЕ ПРЕДЛАГАЮТ
Dialogue: 0,0:01:45.35,0:01:48.47,Caption,,0,0,0,,ПОВЕРИТЬ, ЧТО ВСЕ УСПОКОИЛИСЬ И БОЛЬШЕ НИКТО НИЧЕГО НЕ
Dialogue: 0,0:01:48.47,0:01:51.75,Caption,,0,0,0,,ЗАМЫШЛЯЕТ. ОТЛИЧНЫЙ ПЛАН. ОСОБЕННО ЕСЛИ ЗАБЫТЬ
Dialogue: 0,0:01:51.75,0:01:55.99,Caption,,0,0,0,,ПРЕДЫДУЩИЕ ГОДЫ, ЗАКРЫТЬ ГЛАЗА НА ПОСТАВКИ И ПОСТАВИТЬ ЧЕЛОВЕКА ВОЗЛЕ
Dialogue: 0,0:01:55.99,0:01:59.67,Caption,,0,0,0,,КАРТЫ, ЧТОБЫ ОН АККУРАТНО ПРИКРЫВАЛ ЕЁ ЛАДОНЬЮ. РОССИЯ
Dialogue: 0,0:01:59.75,0:02:02.63,Caption,,0,0,0,,ЗАБЫВАТЬ НЕ СОБИРАЕТСЯ. МОЖНО СПОРИТЬ С ЕЁ ЦЕЛЯМИ,
Dialogue: 0,0:02:02.79,0:02:07.51,Caption,,0,0,0,,СЧИТАТЬ ИХ ЧРЕЗМЕРНЫМИ, НЕПРИЕМЛЕМЫМИ ИЛИ НЕУДОБНЫМИ. НО ПЕРЕГОВОРЫ НЕ
Dialogue: 0,0:02:07.51,0:02:09.59,Caption,,0,0,0,,РАБОТАЮТ ПО ПРИНЦИПУ ДЕТСКОГО УТРЕННИКА,
Dialogue: 0,0:02:09.82,0:02:12.79,Caption,,0,0,0,,ГДЕ САМОМУ ГРОМКОМУ УЧАСТНИКУ ВЫДАЮТ КОСТЮМ СНЕЖИНКИ
Dialogue: 0,0:02:12.79,0:02:18.07,Caption,,0,0,0,,И ПРОСЯТ ПОСТОЯТЬ В УГЛУ. ЕСЛИ ОДНА СТОРОНА СЧИТАЕТ ПРИЧИНОЙ ВОЙНЫ ВСЮ ПРЕЖНЮЮ
Dialogue: 0,0:02:18.07,0:02:23.11,Caption,,0,0,0,,КОНСТРУКЦИЮ ОТНОШЕНИЙ С НАТО, ПРЕКРАЩЕНИЕ ОГНЯ БЕЗ РАЗГОВОРА ОБ ЭТОЙ КОНСТРУКЦИИ
Dialogue: 0,0:02:23.19,0:02:29.15,Caption,,0,0,0,,ЕЁ НЕ УСТРОИТ. СЕРГЕЙ ЛАВРОВ СНОВА ЗАГОВОРИЛ О НОВОЙ СИСТЕМЕ
Dialogue: 0,0:02:29.15,0:02:32.51,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ТОЛЬКО ТЕПЕРЬ НЕ ОБ ОТДЕЛЬНОМ СОГЛАШЕНИИ МЕЖДУ
Dialogue: 0,0:02:32.51,0:02:37.47,Caption,,0,0,0,,МОСКВОЙ И КИЕВОМ, А ОБ АРХИТЕКТУРЕ БЕЗОПАСНОСТИ ДЛЯ ВСЕЙ ЕВРАЗИИ. И
Dialogue: 0,0:02:37.55,0:02:40.59,Caption,,0,0,0,,ВОТ ЗДЕСЬ НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ ОН ПРЯМО И
Dialogue: 0,0:02:40.59,0:02:43.15,Caption,,0,0,0,,РЕЗКО ОТВЕРГ ЕВРОПЕЙСКУЮ ИДЕЮ НЕМЕДЛЕННОГО
Dialogue: 0,0:02:43.15,0:02:45.95,Caption,,0,0,0,,ПРЕКРАЩЕНИЯ ОГНЯ, А ПРИЧИНА НАЗВАНА БЕЗ КРУЖЕВ,
Dialogue: 0,0:02:46.19,0:02:48.75,Caption,,0,0,0,,ТАКАЯ ОСТАНОВКА ПРОСТО ДАСТ КИЕВУ ВРЕМЯ ПРИВЕСТИ
Dialogue: 0,0:02:48.75,0:02:52.91,Caption,,0,0,0,,АРМИЮ В ПОРЯДОК, ПОЛУЧИТЬ НОВЫЕ ПОСТАВКИ И ПОДГОТОВИТЬСЯ К СЛЕДУЮЩЕМУ
Dialogue: 0,0:02:52.91,0:02:55.47,Caption,,0,0,0,,РАУНДУ. ДЕПУТАТ ВЕРХОВНОЙ РАДЫ ЕГОР ЧЕРНЕВ
Dialogue: 0,0:02:55.47,0:02:58.83,Caption,,0,0,0,,РАССКАЗАЛ, ЧТО КИЕВ ПРЕДЛАГАЛ МОСКВЕ НЕСКОЛЬКО ВАРИАНТОВ.
Dialogue: 0,0:02:59.06,0:03:01.47,Caption,,0,0,0,,ОТДЕЛЬНОЕ ПРЕКРАЩЕНИЕ УДАРОВ ПО ЭНЕРГЕТИКЕ,
Dialogue: 0,0:03:01.73,0:03:04.83,Caption,,0,0,0,,ДОГОВОРЁННОСТИ ПО ЧЁРНОМУ МОРЮ И ПОЛНУЮ ОСТАНОВКУ
Dialogue: 0,0:03:04.91,0:03:07.63,Caption,,0,0,0,,ОГНЯ. ОДНАКО РОССИЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:03:07.93,0:03:12.27,Caption,,0,0,0,,НЕ ДАЛА ТОГО ОТВЕТА, КОТОРОГО ОЖИДАЛА УКРАИНСКАЯ СТОРОНА. ЗДЕСЬ ХОРОШО
Dialogue: 0,0:03:12.27,0:03:15.55,Caption,,0,0,0,,ВИДНА РАЗНИЦА МЕЖДУ ДВУМЯ ПОДХОДАМИ. КИЕВ ПРЕДЛАГАЕТ
Dialogue: 0,0:03:15.63,0:03:19.23,Caption,,0,0,0,,ОПРЕДЕЛИТЬ, ПО ЧЕМУ СЕЙЧАС НЕ СТРЕЛЯЮТ. МОСКВА ТРЕБУЕТ
Dialogue: 0,0:03:19.23,0:03:22.83,Caption,,0,0,0,,ОПРЕДЕЛИТЬ, ЧТО БУДЕТ С ВОЕННОЙ СИСТЕМОЙ ПОСЛЕ ЗАВЕРШЕНИЯ
Dialogue: 0,0:03:22.83,0:03:25.79,Caption,,0,0,0,,СТРЕЛЬБЫ. ОДИН УЧАСТНИК ХОЧЕТ ДОГОВОРИТЬСЯ О РЕЖИМЕ
Dialogue: 0,0:03:25.79,0:03:28.67,Caption,,0,0,0,,НА БЛИЖАЙШЕЕ ВРЕМЯ. ДРУГОЙ ТРЕБУЕТ ПЕРЕПИСАТЬ
Dialogue: 0,0:03:28.67,0:03:31.23,Caption,,0,0,0,,ПРАВИЛА, ПО КОТОРЫМ ВСЕ БУДУТ ЖИТЬ ПОТОМ.
Dialogue: 0,0:03:31.87,0:03:34.59,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЕ ПЕРЕМИРИЕ НЕ ОТВЕЧАЕТ НА ВОПРОС О
Dialogue: 0,0:03:34.59,0:03:37.71,Caption,,0,0,0,,ПОСТАВКАХ ВООРУЖЕНИЙ. ЧЕРНОМОРСКАЯ ДОГОВОРЁННОСТЬ НЕ
Dialogue: 0,0:03:37.79,0:03:40.75,Caption,,0,0,0,,ОБЪЯСНЯЕТ, ЧТО ПРОИЗОЙДЁТ С ИНФРАСТРУКТУРОЙ НАТО.
Dialogue: 0,0:03:43.02,0:03:45.90,Caption,,0,0,0,,ПОЛНОЕ ПРЕКРАЩЕНИЕ ОГНЯ НЕ УСТАНАВЛИВАЕТ ГРАНИЦ
Dialogue: 0,0:03:45.98,0:03:48.62,Caption,,0,0,0,,БУДУЩЕЙ ВОЕННОЙ АКТИВНОСТИ. КАЖДЫЙ ПРЕДЛОЖЕННЫЙ
Dialogue: 0,0:03:48.62,0:03:50.94,Caption,,0,0,0,,КИЕВОМ ВАРИАНТ ЗАКРЫВАЕТ ОТДЕЛЬНЫЙ КРАН,
Dialogue: 0,0:03:51.18,0:03:55.42,Caption,,0,0,0,,А МОСКВА ХОЧЕТ ПОСМОТРЕТЬ, КТО ПРОЛОЖИЛ ВСЮ ТРУБУ И КУДА ОНА ВЕДЁТ.
Dialogue: 0,0:03:55.79,0:04:00.14,Caption,,0,0,0,,ПОЭТОМУ И ПОЛУЧАЕТСЯ, ЧТО СТОРОНЫ СЛОВНО ВЕДУТ РАЗГОВОР ЧЕРЕЗ РАЗНЫЕ ОКНА.
Dialogue: 0,0:04:00.70,0:04:05.02,Caption,,0,0,0,,КИЕВ СПРАШИВАЕТ, ГДЕ ПОСТАВИТЬ ЗАПЯТУЮ В УКРАИНСКОМ КОНФЛИКТЕ. РОССИЯ
Dialogue: 0,0:04:05.02,0:04:08.78,Caption,,0,0,0,,ОБСУЖДАЕТ, КАКИМ ДОЛЖНО БЫТЬ СЛЕДУЮЩЕЕ ПРЕДЛОЖЕНИЕ В ОТНОШЕНИЯХ
Dialogue: 0,0:04:08.78,0:04:11.02,Caption,,0,0,0,,С ЗАПАДОМ. СЛОВА У ВСЕХ ЗНАКОМЫЕ,
Dialogue: 0,0:04:11.20,0:04:15.50,Caption,,0,0,0,,ПЕРЕВОДЧИКИ НА МЕСТЕ, А СМЫСЛОВЫЕ АДРЕСА РАЗНЫЕ. ТЕПЕРЬ СЛЕДУЮЩИЙ НОМЕР
Dialogue: 0,0:04:15.50,0:04:20.62,Caption,,0,0,0,,ПРОГРАММЫ. США, ЕВРОПЕЙСКИЙ СОЮЗ И УКРАИНА ВЫПУСТИЛИ СОВМЕСТНОЕ
Dialogue: 0,0:04:20.62,0:04:24.06,Caption,,0,0,0,,ЗАЯВЛЕНИЕ О СУВЕРЕНИТЕТЕ, ТЕРРИТОРИАЛЬНОЙ ЦЕЛОСТНОСТИ,
Dialogue: 0,0:04:24.22,0:04:27.26,Caption,,0,0,0,,СВОБОДЕ РЕШЕНИЙ И НАДЁЖНЫХ ГАРАНТИЯХ. УИТКОФФ
Dialogue: 0,0:04:27.26,0:04:31.18,Caption,,0,0,0,,СООБЩИЛ, ЧТО ОБСУЖДАЛОСЬ ИСПОЛЬЗОВАНИЕ ЕВРОПЕЙСКИХ ИНСТИТУТОВ
Dialogue: 0,0:04:31.50,0:04:34.14,Caption,,0,0,0,,И ДЕЙСТВУЮЩИХ ДОГОВОРЁННОСТЕЙ ДЛЯ БУДУЩЕЙ СИСТЕМЫ
Dialogue: 0,0:04:34.14,0:04:36.46,Caption,,0,0,0,,ЗАЩИТЫ УКРАИНЫ. ОСОБЕННО ЛЮБОПЫТНО,
Dialogue: 0,0:04:36.70,0:04:39.10,Caption,,0,0,0,,ЧТО НЕОБХОДИМОСТЬ УЧИТЫВАТЬ РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:04:39.29,0:04:42.38,Caption,,0,0,0,,ПРИЗНАЮТ УЖЕ И В СОЕДИНЁННЫХ ШТАТАХ. МАРКО РУБИО
Dialogue: 0,0:04:42.38,0:04:45.34,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО БУДУЩИЕ ГАРАНТИИ ДОЛЖНЫ ОБЕСПЕЧИВАТЬ
Dialogue: 0,0:04:45.42,0:04:49.90,Caption,,0,0,0,,БЕЗОПАСНОСТЬ УКРАИНЫ, НО ОДНОВРЕМЕННО БЫТЬ ПРИЕМЛЕМЫМИ ДЛЯ РОССИИ. ИНАЧЕ
Dialogue: 0,0:04:49.90,0:04:52.78,Caption,,0,0,0,,МЕХАНИЗМ ПОПРОСТУ НЕ ЗАРАБОТАЕТ. ОКОНЧАТЕЛЬНОГО
Dialogue: 0,0:04:52.78,0:04:57.42,Caption,,0,0,0,,ВАРИАНТА, ПО ЕГО СЛОВАМ, ПОКА НЕТ. МЫСЛЬ ПОЧТИ НЕПРИЛИЧНО ЗДРАВАЯ.
Dialogue: 0,0:04:59.69,0:05:02.09,Caption,,0,0,0,,ЕСЛИ СОГЛАШЕНИЕ ДОЛЖНО ОСТАНОВИТЬ КОНФЛИКТ С
Dialogue: 0,0:05:02.09,0:05:05.85,Caption,,0,0,0,,УЧАСТИЕМ РОССИИ, СТРАННО СОЧИНЯТЬ ЕГО В КОМПАНИИ США,
Dialogue: 0,0:05:05.97,0:05:10.49,Caption,,0,0,0,,ЕВРОСОЮЗА И УКРАИНЫ, А РОССИЮ ПОЗВАТЬ ТОЛЬКО НА ВЫДАЧУ РУЧКИ. ЭТО
Dialogue: 0,0:05:10.49,0:05:13.37,Caption,,0,0,0,,НЕ ПЕРЕГОВОРЫ. ЭТО КОГДА РОДСТВЕННИКИ УЖЕ ВЫБРАЛИ
Dialogue: 0,0:05:13.45,0:05:15.85,Caption,,0,0,0,,ВАМ КВАРТИРУ, ЦВЕТ СТЕН И СОСЕДА,
Dialogue: 0,0:05:16.09,0:05:20.81,Caption,,0,0,0,,А ПОТОМ ИСКРЕННЕ ОБИЖАЮТСЯ, ЧТО ВЫ НЕ НЕСЁТЕ ДЕНЬГИ. ГАРАНТИИ КИЕВУ
Dialogue: 0,0:05:20.89,0:05:23.69,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО НУЖНЫ. ПОСЛЕ ПЕРЕЖИТОГО УКРАИНСКАЯ
Dialogue: 0,0:05:23.77,0:05:25.45,Caption,,0,0,0,,СТОРОНА БУДЕТ ТРЕБОВАТЬ МЕХАНИЗМ,
Dialogue: 0,0:05:25.69,0:05:28.01,Caption,,0,0,0,,КОТОРЫЙ НЕ РАССЫПЛЕТСЯ ПОСЛЕ ПЕРВОЙ СМЕНЫ
Dialogue: 0,0:05:28.01,0:05:30.89,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА В ОДНОЙ ИЗ ЗАПАДНЫХ СТОЛИЦ. ПРОБЛЕМА
Dialogue: 0,0:05:30.89,0:05:35.13,Caption,,0,0,0,,НАЧИНАЕТСЯ ТАМ, ГДЕ СОДЕРЖАНИЕ ЭТИХ ГАРАНТИЙ РОССИЯ ВОСПРИНИМАЕТ КАК
Dialogue: 0,0:05:35.13,0:05:38.09,Caption,,0,0,0,,ПОДГОТОВКУ НОВОЙ УГРОЗЫ. ВКЛЮЧАТ В ДОКУМЕНТ
Dialogue: 0,0:05:38.09,0:05:41.13,Caption,,0,0,0,,РАЗМЕЩЕНИЕ СИЛ, КОТОРОЕ МОСКВА СЧИТАЕТ ОПАСНЫМ,
Dialogue: 0,0:05:41.45,0:05:44.41,Caption,,0,0,0,,РОССИЯ ТАКОЙ ДОКУМЕНТ ОТВЕРГАЕТ. НАТО ОТКАЖЕТСЯ
Dialogue: 0,0:05:44.41,0:05:47.29,Caption,,0,0,0,,ОГРАНИЧИВАТЬ ИНФРАСТРУКТУРУ ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ,
Dialogue: 0,0:05:47.57,0:05:50.97,Caption,,0,0,0,,ГЛАВНЫЙ СПОР СОХРАНЯЕТСЯ. КИЕВ ПОЛУЧИТ ОБЕЩАНИЯ,
Dialogue: 0,0:05:51.30,0:05:53.69,Caption,,0,0,0,,А СПОСОБ ИХ ИСПОЛНЕНИЯ МОСКВА ПРОЧИТАЕТ КАК
Dialogue: 0,0:05:53.69,0:05:56.25,Caption,,0,0,0,,ОЧЕРЕДНОЙ ШАГ ВОЕННОГО СОЮЗА НА ВОСТОК,
Dialogue: 0,0:05:56.57,0:05:59.29,Caption,,0,0,0,,И ПОД КРАСИВОЙ ОБЛОЖКОЙ СНОВА ЛЕЖИТ ПРЕЖНИЙ
Dialogue: 0,0:05:59.29,0:06:02.97,Caption,,0,0,0,,КОНФЛИКТ, ТОЛЬКО СТРАНИЦЫ ПАХНУТ СВЕЖЕЙ ТИПОГРАФСКОЙ КРАСКОЙ.
Dialogue: 0,0:06:03.34,0:06:06.17,Caption,,0,0,0,,БЕЗОПАСНОСТЬ НЕВОЗМОЖНО ВЫПИСАТЬ ОДНОМУ ГОСУДАРСТВУ
Dialogue: 0,0:06:06.41,0:06:09.05,Caption,,0,0,0,,КАК СПРАВКУ ИЗ ПОЛИКЛИНИКИ. ЕСЛИ ПОСЛЕ ВЫДАЧИ
Dialogue: 0,0:06:09.05,0:06:11.53,Caption,,0,0,0,,ГАРАНТИЙ УКРАИНА ЧУВСТВУЕТ СЕБЯ СПОКОЙНЕЕ,
Dialogue: 0,0:06:11.69,0:06:15.05,Caption,,0,0,0,,А РОССИЯ ОПАСНЕЕ, МОСКВА НАЧИНАЕТ УСИЛИВАТЬ АРМИЮ.
Dialogue: 0,0:06:17.33,0:06:20.05,Caption,,0,0,0,,НАТО ОТВЕЧАЕТ СОБСТВЕННЫМ УСИЛЕНИЕМ. РОССИЯ
Dialogue: 0,0:06:20.05,0:06:23.41,Caption,,0,0,0,,ДОБАВЛЯЕТ ЕЩЁ. В ИТОГЕ ВСЕ ПОТРАТИЛИ БОЛЬШЕ ДЕНЕГ,
Dialogue: 0,0:06:23.64,0:06:26.53,Caption,,0,0,0,,ПОДВЕЗЛИ БОЛЬШЕ РАКЕТ И ТОРЖЕСТВЕННО ОБЪЯВИЛИ,
Dialogue: 0,0:06:26.61,0:06:29.01,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ЗАЩИЩЕНЫ ЛУЧШЕ. ПРАВДА,
Dialogue: 0,0:06:29.22,0:06:30.93,Caption,,0,0,0,,СПАТЬ ПОЧЕМУ ТО ПЕРЕСТАЛИ ВООБЩЕ.
Dialogue: 0,0:06:31.88,0:06:34.93,Caption,,0,0,0,,РАБОЧАЯ СИСТЕМА ТРЕБУЕТ КОНКРЕТИКИ. ГДЕ РАЗРЕШЕНО
Dialogue: 0,0:06:34.93,0:06:38.45,Caption,,0,0,0,,РАЗМЕЩАТЬ ВООРУЖЕНИЯ. КАКИЕ КОМПЛЕКСЫ ЗАПРЕЩЕНЫ. НА
Dialogue: 0,0:06:38.45,0:06:41.57,Caption,,0,0,0,,КАКОМ РАССТОЯНИИ НАХОДЯТСЯ СИЛЫ. КТО ПРОВЕРЯЕТ
Dialogue: 0,0:06:41.57,0:06:44.69,Caption,,0,0,0,,СОБЛЮДЕНИЕ ПРАВИЛ. КАК СТОРОНЫ УВЕДОМЛЯЮТ ДРУГ ДРУГА
Dialogue: 0,0:06:44.77,0:06:47.73,Caption,,0,0,0,,ОБ УЧЕНИЯХ. КУДА ЗВОНЯТ ПРИ ОПАСНОМ СБЛИЖЕНИИ
Dialogue: 0,0:06:47.73,0:06:52.61,Caption,,0,0,0,,САМОЛЁТОВ. ЧТО ПРОИСХОДИТ, ЕСЛИ РАЗВЕДКА ЗАМЕТИЛА ПЕРЕДВИЖЕНИЕ ТЕХНИКИ И НЕ
Dialogue: 0,0:06:52.61,0:06:55.97,Caption,,0,0,0,,ПОНИМАЕТ, ГОТОВИТСЯ НАПАДЕНИЕ ИЛИ НАЧАЛАСЬ ПЛАНОВАЯ
Dialogue: 0,0:06:55.97,0:06:59.97,Caption,,0,0,0,,ТРЕНИРОВКА. ВОТ ТАКИЕ СКУЧНЫЕ ПУНКТЫ И УДЕРЖИВАЮТ БОЛЬШУЮ
Dialogue: 0,0:06:59.97,0:07:03.33,Caption,,0,0,0,,КРАСНУЮ КНОПКУ ОТ ЛИШНИХ ЗНАКОМСТВ С ПАЛЬЦЕМ. А
Dialogue: 0,0:07:03.33,0:07:05.89,Caption,,0,0,0,,ОБЩАЯ ФОТОГРАФИЯ РУКОВОДИТЕЛЕЙ ПОСЛЕ ПОДПИСАНИЯ
Dialogue: 0,0:07:05.89,0:07:08.37,Caption,,0,0,0,,ДОКУМЕНТА УДЕРЖИВАЕТ РАЗВЕ ЧТО РАМКУ НА СТЕНЕ.
Dialogue: 0,0:07:08.92,0:07:11.89,Caption,,0,0,0,,ЛАВРОВ ПОЭТОМУ И ПОДНИМАЕТ ВОПРОС ЕВРАЗИИ. В ЭТУ
Dialogue: 0,0:07:11.89,0:07:15.17,Caption,,0,0,0,,КОНСТРУКЦИЮ ВХОДЯТ РОССИЯ, ЕВРОПЕЙСКИЕ ГОСУДАРСТВА,
Dialogue: 0,0:07:15.34,0:07:18.13,Caption,,0,0,0,,КИТАЙ, ИНДИЯ, ВОЕННЫЕ СОЮЗЫ,
Dialogue: 0,0:07:18.21,0:07:22.13,Caption,,0,0,0,,ФЛОТЫ, ЯДЕРНЫЕ СИЛЫ И ДЕСЯТКИ СТРАН С СОБСТВЕННЫМИ
Dialogue: 0,0:07:22.13,0:07:24.37,Caption,,0,0,0,,ИНТЕРЕСАМИ. МАСШТАБ СЛИШКОМ ВЕЛИК,
Dialogue: 0,0:07:24.53,0:07:27.17,Caption,,0,0,0,,ЧТОБЫ ЗАМЕНИТЬ ЕГО ДОГОВОРЁННОСТЬЮ О ТИШИНЕ НА ОДНОМ
Dialogue: 0,0:07:27.17,0:07:30.05,Caption,,0,0,0,,ФРОНТЕ. НА ЭТОМ ФОНЕ ОСОБЕННО ЗАНЯТНО ВЫГЛЯДИТ
Dialogue: 0,0:07:30.05,0:07:36.39,Caption,,0,0,0,,СООБЩЕНИЕ FINANCIAL TIMES. ЕВРОПЕЙСКИЕ СТРАНЫ ОБСУЖДАЮТ ВОЗВРАЩЕНИЕ К
Dialogue: 0,0:07:36.47,0:07:40.47,Caption,,0,0,0,,МЕХАНИЗМАМ, ЗНАКОМЫМ ЕЩЁ ПО ХОЛОДНОЙ ВОЙНЕ. СРЕДИ НИХ КОНТРОЛЬ
Dialogue: 0,0:07:40.55,0:07:44.23,Caption,,0,0,0,,НАД ВООРУЖЕНИЯМИ, ПРЕДОТВРАЩЕНИЕ ОПАСНЫХ ВОЕННЫХ ИНЦИДЕНТОВ,
Dialogue: 0,0:07:44.55,0:07:47.75,Caption,,0,0,0,,НАБЛЮДЕНИЕ И ОТДЕЛЬНЫЕ ЭЛЕМЕНТЫ ДОГОВОРА "ОТКРЫТОЕ
Dialogue: 0,0:07:47.75,0:07:51.67,Caption,,0,0,0,,НЕБО". КАКАЯ НЕОЖИДАННАЯ ВСТРЕЧА. СТАРЫЕ ПРАВИЛА,
Dialogue: 0,0:07:51.83,0:07:53.67,Caption,,0,0,0,,КОТОРЫХ ТАК СТАРАТЕЛЬНО ИЗБАВЛЯЛИСЬ,
Dialogue: 0,0:07:53.82,0:07:56.23,Caption,,0,0,0,,СНОВА СТОЯТ У ДВЕРИ. ВИД У НИХ СЛЕГКА
Dialogue: 0,0:07:56.23,0:07:59.19,Caption,,0,0,0,,ПОМЯТЫЙ, ЗАТО ТЕПЕРЬ ХОЗЯЕВА НАКОНЕЦ ПОНЯЛИ,
Dialogue: 0,0:07:59.35,0:08:02.71,Caption,,0,0,0,,ЗАЧЕМ ОСТАВЛЯЛИ ЗАПАСНОЙ КЛЮЧ. ДОГОВОР "ОТКРЫТОЕ
Dialogue: 0,0:08:02.79,0:08:05.75,Caption,,0,0,0,,НЕБО" СОЗДАВАЛСЯ ДЛЯ ВПОЛНЕ ПРАКТИЧЕСКОЙ ЗАДАЧИ.
Dialogue: 0,0:08:05.99,0:08:08.47,Caption,,0,0,0,,СТОРОНЫ ПОЛУЧАЛИ ВОЗМОЖНОСТЬ НАБЛЮДАТЬ ЗА ВОЕННЫМИ
Dialogue: 0,0:08:08.47,0:08:11.59,Caption,,0,0,0,,ОБЪЕКТАМИ ДРУГ ДРУГА И УМЕНЬШАТЬ КОЛИЧЕСТВО ОПАСНЫХ
Dialogue: 0,0:08:11.59,0:08:15.83,Caption,,0,0,0,,ДОГАДОК. КОГДА ЗНАЕШЬ, ЧТО ИМЕННО ПРОИСХОДИТ ЗА СОСЕДСКИМ ЗАБОРОМ,
Dialogue: 0,0:08:16.07,0:08:18.71,Caption,,0,0,0,,МЕНЬШЕ СОБЛАЗНА ПРИНЯТЬ ГРУЗОВИК ЗА РАКЕТУ,
Dialogue: 0,0:08:18.87,0:08:22.63,Caption,,0,0,0,,УЧЕНИЯ ЗА НАПАДЕНИЕ, А ОТКРЫТЫЙ АНГАР ЗА НАЧАЛО КОНЦА СВЕТА.
Dialogue: 0,0:08:23.28,0:08:25.67,Caption,,0,0,0,,СНАЧАЛА ИЗ ДОГОВОРА ВЫШЛИ СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:08:25.83,0:08:28.47,Caption,,0,0,0,,ЗАТЕМ РОССИЯ. ПРЕДСКАЗУЕМОСТИ СТАЛО МЕНЬШЕ,
Dialogue: 0,0:08:28.62,0:08:31.43,Caption,,0,0,0,,ПОДОЗРЕНИЙ БОЛЬШЕ. И ВОТ ТЕПЕРЬ В ЕВРОПЕ СНОВА
Dialogue: 0,0:08:31.43,0:08:34.55,Caption,,0,0,0,,ОБСУЖДАЮТ ПОХОЖИЕ ИНСТРУМЕНТЫ. НОВЕЙШАЯ ТЕХНОЛОГИЯ
Dialogue: 0,0:08:34.63,0:08:37.27,Caption,,0,0,0,,ОКАЗАЛАСЬ УДИВИТЕЛЬНОЙ ВЗЯТЬ ВЫБРОШЕННУЮ ВЕЩЬ,
Dialogue: 0,0:08:37.52,0:08:40.31,Caption,,0,0,0,,ПРОТЕРЕТЬ ЕЁ РУКАВОМ И ОБЪЯВИТЬ ПЕРСПЕКТИВНОЙ
Dialogue: 0,0:08:40.31,0:08:43.51,Caption,,0,0,0,,РАЗРАБОТКОЙ. САМОЕ НЕУДОБНОЕ ДЛЯ ЗАПАДА ЗАКЛЮЧАЕТСЯ
Dialogue: 0,0:08:43.59,0:08:47.11,Caption,,0,0,0,,В ДАТЕ, КОГДА РОССИЯ УЖЕ ПРЕДЛАГАЛА БОЛЬШОЙ РАЗГОВОР НА ЭТУ
Dialogue: 0,0:08:47.11,0:08:52.34,Caption,,0,0,0,,ТЕМУ. В ДЕКАБРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА МОСКВА
Dialogue: 0,0:08:52.34,0:08:55.14,Caption,,0,0,0,,ПЕРЕДАЛА ВАШИНГТОНУ ПРОЕКТЫ СОГЛАШЕНИЙ О ГАРАНТИЯХ
Dialogue: 0,0:08:55.14,0:08:57.54,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ДОКУМЕНТЫ ОПУБЛИКОВАЛИ,
Dialogue: 0,0:08:57.79,0:09:00.18,Caption,,0,0,0,,ПОЭТОМУ СОДЕРЖАНИЕ НЕ ПРЯТАЛОСЬ НИ В СЕКРЕТНОМ
Dialogue: 0,0:09:00.26,0:09:02.74,Caption,,0,0,0,,СЕЙФЕ, НИ ПОД КОВРОМ ПЕРЕГОВОРНОЙ КОМНАТЫ.
Dialogue: 0,0:09:03.43,0:09:06.10,Caption,,0,0,0,,РОССИЯ ПРЕДЛАГАЛА ОБСУЖДАТЬ ДАЛЬНЕЙШЕЕ РАСШИРЕНИЕ
Dialogue: 0,0:09:06.10,0:09:09.94,Caption,,0,0,0,,НАТО, РАЗМЕЩЕНИЕ ВООРУЖЕНИЙ, ВОЕННУЮ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:09:10.10,0:09:13.46,Caption,,0,0,0,,АКТИВНОСТЬ СОЮЗОВ И ВЗАИМНЫЕ ОГРАНИЧЕНИЯ. КЛЮЧЕВЫЕ
Dialogue: 0,0:09:13.46,0:09:16.34,Caption,,0,0,0,,ТРЕБОВАНИЯ ЗАПАД ОТВЕРГ. ПРЕДЛОЖЕНИЯ ЛЕЖАЛИ ПЕРЕД
Dialogue: 0,0:09:16.34,0:09:21.30,Caption,,0,0,0,,ВСЕМИ, ОТВЕТ БЫЛ ПОЛУЧЕН, И НИКАКОЙ ЗАГАДКИ ЗДЕСЬ НЕТ. ТЕПЕРЬ ПРОШЛО ПОЧТИ
Dialogue: 0,0:09:21.30,0:09:24.82,Caption,,0,0,0,,ПЯТЬ ЛЕТ, И ЕВРОПЕЙСКИЕ СТОЛИЦЫ ВНОВЬ ПРОИЗНОСЯТ СЛОВА О
Dialogue: 0,0:09:24.82,0:09:28.10,Caption,,0,0,0,,КОНТРОЛЕ НАД ВООРУЖЕНИЯМИ, ПРЕДОТВРАЩЕНИИ ИНЦИДЕНТОВ,
Dialogue: 0,0:09:28.41,0:09:31.62,Caption,,0,0,0,,ПРАВИЛАХ ПОВЕДЕНИЯ И ВОССТАНОВЛЕНИИ ДОВЕРИЯ. ОНИ НЕ
Dialogue: 0,0:09:31.62,0:09:34.50,Caption,,0,0,0,,ПРИНЯЛИ РОССИЙСКИЙ ПРОЕКТ ЗАДНИМ ЧИСЛОМ. НАТО НЕ
Dialogue: 0,0:09:34.50,0:09:37.14,Caption,,0,0,0,,ОБЪЯВИЛО О ВОЗВРАЩЕНИИ К ГРАНИЦАМ ДЕВЯНОСТО СЕДЬМОГО
Dialogue: 0,0:09:37.14,0:09:40.58,Caption,,0,0,0,,ГОДА, А ЕВРОПЕЙСКИЕ ВОЕННЫЕ НЕ ПОБЕЖАЛИ ПАКОВАТЬ ЧЕМОДАНЫ.
Dialogue: 0,0:09:40.98,0:09:43.86,Caption,,0,0,0,,НО ПРЕДМЕТ РАЗГОВОРА ВЕРНУЛСЯ. ВОТ ЧТО МЕНЯЕТ
Dialogue: 0,0:09:43.86,0:09:47.78,Caption,,0,0,0,,КАРТИНУ. ДО ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА МОСКВА
Dialogue: 0,0:09:47.78,0:09:50.50,Caption,,0,0,0,,ТРЕБОВАЛА ОБСУЖДАТЬ УСТРОЙСТВО БЕЗОПАСНОСТИ МЕЖДУ
Dialogue: 0,0:09:50.50,0:09:53.78,Caption,,0,0,0,,РОССИЕЙ И НАТО. СЕЙЧАС ЕВРОПЕЙЦЫ САМИ НАЧИНАЮТ
Dialogue: 0,0:09:53.78,0:09:58.50,Caption,,0,0,0,,ИСКАТЬ ОГРАНИЧЕНИЯ, ПРОЦЕДУРЫ ПРОВЕРКИ И СПОСОБЫ ИЗБЕЖАТЬ СЛУЧАЙНОГО
Dialogue: 0,0:09:58.50,0:10:03.46,Caption,,0,0,0,,СТОЛКНОВЕНИЯ. ПОЛУЧАЕТСЯ, СТАРЫЙ УЧЕБНИК ВСЁ ЭТО ВРЕМЯ ЛЕЖАЛ РЯДОМ.
Dialogue: 0,0:10:05.74,0:10:07.34,Caption,,0,0,0,,ЕГО РЕШИЛИ ОТКРЫТЬ ПОСЛЕ ТОГО,
Dialogue: 0,0:10:07.58,0:10:10.46,Caption,,0,0,0,,КАК ЭКЗАМЕН ПРОВАЛИЛИ, КАФЕДРУ РАЗГРОМИЛИ,
Dialogue: 0,0:10:10.62,0:10:15.50,Caption,,0,0,0,,А ПРЕПОДАВАТЕЛЮ СООБЩИЛИ, ЧТО ЕГО ПРЕДМЕТ ВООБЩЕ НИКОМУ НЕ НУЖЕН. УСЛОВИЯ
Dialogue: 0,0:10:15.50,0:10:19.42,Caption,,0,0,0,,ТЕПЕРЬ НАМНОГО ТЯЖЕЛЕЕ. НЕДОВЕРИЯ БОЛЬШЕ. ПОГИБШИХ
Dialogue: 0,0:10:19.46,0:10:23.58,Caption,,0,0,0,,БОЛЬШЕ. РАЗРУШЕНИЙ БОЛЬШЕ. УЧАСТНИКОВ И ВЗАИМНЫХ
Dialogue: 0,0:10:23.58,0:10:27.10,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ ТОЖЕ БОЛЬШЕ. РАНЬШЕ СПОР ШЁЛ О ТОМ,
Dialogue: 0,0:10:27.41,0:10:30.06,Caption,,0,0,0,,КАК НЕ ДОПУСТИТЬ КАТАСТРОФУ. ТЕПЕРЬ ПРИХОДИТСЯ
Dialogue: 0,0:10:30.06,0:10:32.86,Caption,,0,0,0,,ОБСУЖДАТЬ ТЕ ЖЕ ВОПРОСЫ ПОВЕРХ УЖЕ СЛУЧИВШЕЙСЯ
Dialogue: 0,0:10:32.86,0:10:35.82,Caption,,0,0,0,,КАТАСТРОФЫ. ЦЕНА ОПОЗДАНИЯ ПОЛУЧИЛАСЬ ТАКОЙ,
Dialogue: 0,0:10:36.14,0:10:38.86,Caption,,0,0,0,,ЧТО ЕЁ НЕ СПРЯЧЕШЬ МЕЛКИМ ШРИФТОМ ВНИЗУ СЧЁТА.
Dialogue: 0,0:10:39.50,0:10:42.22,Caption,,0,0,0,,НА ЭТОТ СТОЛ ПРИЕЗЖАЕТ ДЖАРЕД КУШНЕР И ПОСЛЕ
Dialogue: 0,0:10:42.22,0:10:45.02,Caption,,0,0,0,,КОНТАКТОВ С ПУТИНЫМ СООБЩАЕТ АМЕРИКАНСКАЯ СТОРОНА
Dialogue: 0,0:10:45.02,0:10:47.90,Caption,,0,0,0,,СЧИТАЕТ РОССИЮ ГОТОВОЙ К МИРНОМУ СОГЛАШЕНИЮ,
Dialogue: 0,0:10:48.22,0:10:51.42,Caption,,0,0,0,,ЕСЛИ БУДУТ СОБЛЮДЕНЫ ОПРЕДЕЛЁННЫЕ УСЛОВИЯ. ОТКРЫТИЕ,
Dialogue: 0,0:10:51.51,0:10:55.42,Caption,,0,0,0,,КОНЕЧНО, ДОСТОЙНО ОТДЕЛЬНОЙ МЕДАЛИ. РОССИЯ ЕЩЁ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:10:55.50,0:10:57.34,Caption,,0,0,0,,ДВАДЦАТЬ ПЕРВОМ ГОДУ ПРИНЕСЛА ПРОЕКТЫ,
Dialogue: 0,0:10:57.63,0:11:00.30,Caption,,0,0,0,,ПЕРЕЧИСЛИЛА ТРЕБОВАНИЯ И ПРЕДЛОЖИЛА ОБСУЖДЕНИЕ.
Dialogue: 0,0:11:00.60,0:11:03.42,Caption,,0,0,0,,ТОГДА ЕЙ ОТВЕТИЛИ ОТКАЗОМ. ТЕПЕРЬ АМЕРИКАНСКИЙ
Dialogue: 0,0:11:03.42,0:11:05.98,Caption,,0,0,0,,ПЕРЕГОВОРЩИК ПОГОВОРИЛ С ПУТИНЫМ И ВЫЯСНИЛ,
Dialogue: 0,0:11:06.22,0:11:08.70,Caption,,0,0,0,,ЧТО ПРИ ПОДХОДЯЩИХ УСЛОВИЯХ МОСКВА ГОТОВА
Dialogue: 0,0:11:08.70,0:11:12.22,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ. СПАСИБО, ДЖАРЕД. ЕЩЁ ПАРА ВСТРЕЧ,
Dialogue: 0,0:11:12.46,0:11:16.62,Caption,,0,0,0,,И ОБНАРУЖИТСЯ, ЧТО СОГЛАШЕНИЯ ОБЫЧНО СОСТОЯТ ИЗ УСЛОВИЙ. РОССИЙСКАЯ
Dialogue: 0,0:11:16.62,0:11:19.02,Caption,,0,0,0,,ГОТОВНОСТЬ ГОВОРИТЬ НЕ ЯВЛЯЕТСЯ НОВОСТЬЮ.
Dialogue: 0,0:11:21.29,0:11:23.53,Caption,,0,0,0,,НОВОСТЬ ЗАКЛЮЧАЕТСЯ В ВОЗМОЖНОЙ ГОТОВНОСТИ
Dialogue: 0,0:11:23.61,0:11:28.89,Caption,,0,0,0,,ВАШИНГТОНА ОБСУЖДАТЬ ТО, ЧТО РАНЬШЕ БЫЛО ОБЪЯВЛЕНО НЕПРИЕМЛЕМЫМ. КАКИЕ ИМЕННО
Dialogue: 0,0:11:28.97,0:11:31.21,Caption,,0,0,0,,ВОПРОСЫ АМЕРИКАНЦЫ ГОТОВЫ ПОЛОЖИТЬ НА СТОЛ?
Dialogue: 0,0:11:31.66,0:11:35.37,Caption,,0,0,0,,ДАЛЬНЕЙШЕЕ РАСШИРЕНИЕ НАТО? РАЗМЕЩЕНИЕ РАКЕТНЫХ СИСТЕМ?
Dialogue: 0,0:11:35.68,0:11:38.81,Caption,,0,0,0,,ВОЕННУЮ ИНФРАСТРУКТУРУ? ОГРАНИЧЕНИЯ АКТИВНОСТИ?
Dialogue: 0,0:11:39.20,0:11:40.97,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ МЕХАНИЗМОВ КОНТРОЛЯ?
Dialogue: 0,0:11:41.61,0:11:46.49,Caption,,0,0,0,,ЕСЛИ ЗДЕСЬ ПРОИЗОШЁЛ СДВИГ, ТОГДА ЭТО ДЕЙСТВИТЕЛЬНО МЕНЯЕТ ПЕРЕГОВОРЫ. СООБЩЕНИЕ
Dialogue: 0,0:11:46.49,0:11:48.89,Caption,,0,0,0,,О ТОМ, ЧТО ПУТИН ГОТОВ К СОГЛАШЕНИЮ,
Dialogue: 0,0:11:49.11,0:11:51.45,Caption,,0,0,0,,САМО ПО СЕБЕ МАЛО ЧТО ОБЪЯСНЯЕТ. ОН БЫЛ
Dialogue: 0,0:11:51.45,0:11:53.61,Caption,,0,0,0,,ГОТОВ РАЗГОВАРИВАТЬ И РАНЬШЕ. СТОРОНЫ НЕ
Dialogue: 0,0:11:53.61,0:11:57.21,Caption,,0,0,0,,ДОГОВОРИЛИСЬ, ПОСЛЕ ЧЕГО ПОСЛЕДСТВИЯ ЭТОГО ПРОВАЛА УВИДЕЛ ВЕСЬ
Dialogue: 0,0:11:57.21,0:11:59.45,Caption,,0,0,0,,МИР. ПОЭТОМУ СЛЕДИТЬ НУЖНО НЕ ЗА ТЕМ,
Dialogue: 0,0:11:59.73,0:12:02.33,Caption,,0,0,0,,СОГЛАСНА ЛИ МОСКВА ПРИЙТИ В ПЕРЕГОВОРНУЮ КОМНАТУ,
Dialogue: 0,0:12:02.57,0:12:07.13,Caption,,0,0,0,,А ЗА ТЕМ, ЧТО ВАШИНГТОН РАЗРЕШИТ ОБСУЖДАТЬ ВНУТРИ. АМЕРИКАНЦАМ
Dialogue: 0,0:12:07.21,0:12:09.61,Caption,,0,0,0,,ПРИ ЭТОМ ПРИХОДИТСЯ УЧИТЫВАТЬ ЕВРОПУ. ЧАСТЬ
Dialogue: 0,0:12:09.69,0:12:12.41,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТРАН СМОТРИТ НА БУДУЩУЮ СДЕЛКУ ПРЕЖДЕ
Dialogue: 0,0:12:12.41,0:12:15.37,Caption,,0,0,0,,ВСЕГО ЧЕРЕЗ ИНТЕРЕСЫ УКРАИНЫ И ОПАСАЕТСЯ ЛЮБОГО
Dialogue: 0,0:12:15.37,0:12:18.73,Caption,,0,0,0,,РЕЗУЛЬТАТА, КОТОРЫЙ МОЖНО БУДЕТ ПРЕДСТАВИТЬ КАК ВОЗНАГРАЖДЕНИЕ
Dialogue: 0,0:12:18.73,0:12:21.69,Caption,,0,0,0,,РОССИИ ЗА ПРИМЕНЕНИЕ СИЛЫ. ДЛЯ МОСКВЫ ОТПРАВНОЙ
Dialogue: 0,0:12:21.69,0:12:24.73,Caption,,0,0,0,,ТОЧКОЙ ОСТАЮТСЯ ПРИЧИНЫ КОНФЛИКТА И ПРЕЖНЯЯ МОДЕЛЬ
Dialogue: 0,0:12:24.73,0:12:27.85,Caption,,0,0,0,,ОТНОШЕНИЙ С НАТО. СОЕДИНЁННЫЕ ШТАТЫ ОКАЗЫВАЮТСЯ
Dialogue: 0,0:12:27.93,0:12:30.49,Caption,,0,0,0,,МЕЖДУ СОЮЗНИКАМИ И РЕАЛЬНОСТЬЮ ПЕРЕГОВОРОВ.
Dialogue: 0,0:12:32.76,0:12:34.60,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ ПАРТНЁРОВ НЕОБХОДИМО,
Dialogue: 0,0:12:34.81,0:12:36.84,Caption,,0,0,0,,НО ДОГОВОРИТЬСЯ С МОСКВОЙ НЕВОЗМОЖНО,
Dialogue: 0,0:12:37.16,0:12:40.04,Caption,,0,0,0,,ЕСЛИ ЗАРАНЕЕ ВЫЧЕРКНУТЬ ВСЕ ЕЁ ОСНОВНЫЕ ТРЕБОВАНИЯ.
Dialogue: 0,0:12:40.68,0:12:43.16,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО УСТРАИВАТЬ СОВЕЩАНИЯ БЕЗ
Dialogue: 0,0:12:43.16,0:12:46.04,Caption,,0,0,0,,НЕУДОБНОГО УЧАСТНИКА. СТУЛ ОТ ЭТОГО СВОБОДНЫМ НЕ
Dialogue: 0,0:12:46.12,0:12:49.48,Caption,,0,0,0,,СТАНЕТ. НА НЁМ ПРОСТО БУДЕТ СИДЕТЬ ПРОБЛЕМА. РОССИЯ
Dialogue: 0,0:12:49.56,0:12:52.12,Caption,,0,0,0,,В ЭТОМ СПОРЕ ПОЧТИ НЕ МЕНЯЕТ ИСХОДНУЮ ПОЗИЦИЮ.
Dialogue: 0,0:12:52.43,0:12:56.36,Caption,,0,0,0,,ОНА ТРЕБУЕТ, ЧТОБЫ БУДУЩЕЕ УСТРОЙСТВО УЧИТЫВАЛО ЕЁ ПРЕДСТАВЛЕНИЕ
Dialogue: 0,0:12:56.36,0:12:59.48,Caption,,0,0,0,,О СОБСТВЕННОЙ БЕЗОПАСНОСТИ. ВОКРУГ ЭТОГО ТРЕБОВАНИЯ
Dialogue: 0,0:12:59.56,0:13:02.52,Caption,,0,0,0,,МОЖНО СОБИРАТЬ КОАЛИЦИИ, ПУБЛИКОВАТЬ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:13:02.71,0:13:05.00,Caption,,0,0,0,,ПРИНИМАТЬ ПАКЕТЫ И ПРИДУМЫВАТЬ ГАРАНТИИ.
Dialogue: 0,0:13:05.62,0:13:08.04,Caption,,0,0,0,,ОДНАКО ЕСЛИ ФУНДАМЕНТАЛЬНЫЙ ВОПРОС ОСТАЁТСЯ БЕЗ
Dialogue: 0,0:13:08.04,0:13:10.84,Caption,,0,0,0,,ОТВЕТА, ОН ВСЁ РАВНО ПОЯВИТСЯ В СЛЕДУЮЩЕМ ПРОЕКТЕ
Dialogue: 0,0:13:10.84,0:13:13.32,Caption,,0,0,0,,СОГЛАШЕНИЯ. ОБЫЧНО НА ТОЙ СТРАНИЦЕ,
Dialogue: 0,0:13:13.56,0:13:16.76,Caption,,0,0,0,,КОТОРУЮ ОЧЕНЬ ХОТЕЛОСЬ БЫ ПОТЕРЯТЬ. ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:13:16.92,0:13:19.72,Caption,,0,0,0,,ЧТО ЗАПАД ДОЛЖЕН ПРИНЯТЬ КАЖДЫЙ РОССИЙСКИЙ ПУНКТ.
Dialogue: 0,0:13:20.04,0:13:22.28,Caption,,0,0,0,,ТОГДА ПЕРЕГОВОРЫ ДЕЙСТВИТЕЛЬНО НЕ ПОНАДОБИЛИСЬ БЫ.
Dialogue: 0,0:13:22.68,0:13:24.84,Caption,,0,0,0,,СТОРОНЫ ТОРГУЮТСЯ ИМЕННО ПОТОМУ,
Dialogue: 0,0:13:25.00,0:13:27.80,Caption,,0,0,0,,ЧТО ИХ ТРЕБОВАНИЯ СТАЛКИВАЮТСЯ. ОДНИ ПОЛОЖЕНИЯ
Dialogue: 0,0:13:27.80,0:13:33.00,Caption,,0,0,0,,МЕНЯЮТ, ДРУГИЕ ОГРАНИЧИВАЮТ, ТРЕТЬИ ОБМЕНИВАЮТ НА ВСТРЕЧНЫЕ ОБЯЗАТЕЛЬСТВА. НО
Dialogue: 0,0:13:33.00,0:13:35.56,Caption,,0,0,0,,ТОРГ НАЧИНАЕТСЯ ТОЛЬКО ПОСЛЕ ПРИЗНАНИЯ,
Dialogue: 0,0:13:35.72,0:13:38.60,Caption,,0,0,0,,ЧТО У ВТОРОГО УЧАСТНИКА ТОЖЕ ЕСТЬ УСЛОВИЯ,
Dialogue: 0,0:13:38.84,0:13:41.16,Caption,,0,0,0,,А НЕ ДЕКОРАТИВНАЯ ПАПКА ДЛЯ ОБЩЕЙ ФОТОГРАФИИ.
Dialogue: 0,0:13:41.60,0:13:43.80,Caption,,0,0,0,,ПОЛОЖЕНИЕ УКРАИНЫ ОТ ЭТОГО НЕ СТАНОВИТСЯ
Dialogue: 0,0:13:43.80,0:13:48.79,Caption,,0,0,0,,ВТОРОСТЕПЕННЫМ. ОНА ОСТАЁТСЯ ЦЕНТРОМ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:13:48.95,0:13:51.83,Caption,,0,0,0,,НЕСЁТ ОГРОМНЫЕ ПОТЕРИ И ТРЕБУЕТ ЗАЩИТЫ ПОСЛЕ
Dialogue: 0,0:13:51.83,0:13:55.99,Caption,,0,0,0,,ОКОНЧАНИЯ КОНФЛИКТА. НО СТОЛ, ЗА КОТОРЫМ ОПРЕДЕЛЯЮТ БУДУЩЕЕ,
Dialogue: 0,0:13:56.23,0:13:59.51,Caption,,0,0,0,,СТАНОВИТСЯ ШИРЕ УКРАИНЫ. НА НЁМ УЖЕ ЛЕЖАТ ОТНОШЕНИЯ
Dialogue: 0,0:13:59.51,0:14:03.03,Caption,,0,0,0,,РОССИИ И НАТО, ЕВРОПЕЙСКАЯ ВОЕННАЯ ИНФРАСТРУКТУРА,
Dialogue: 0,0:14:03.26,0:14:07.91,Caption,,0,0,0,,АМЕРИКАНСКИЕ ГАРАНТИИ, КОНТРОЛЬ НАД ВООРУЖЕНИЯМИ И ПРАВИЛА ДЛЯ ЯДЕРНЫХ
Dialogue: 0,0:14:07.99,0:14:11.03,Caption,,0,0,0,,ДЕРЖАВ. ИМЕННО ПОЭТОМУ ПРОСТАЯ ФОРМУЛА ПРЕКРАЩЕНИЯ
Dialogue: 0,0:14:11.03,0:14:14.31,Caption,,0,0,0,,ОГНЯ НЕ ЗАКРЫВАЕТ РОССИЙСКИЙ СПИСОК ВОПРОСОВ. ДЛЯ
Dialogue: 0,0:14:14.31,0:14:17.19,Caption,,0,0,0,,КИЕВА ОСТАНОВКА БОЕВЫХ ДЕЙСТВИЙ МОЖЕТ БЫТЬ ПЕРВЫМ
Dialogue: 0,0:14:17.27,0:14:20.31,Caption,,0,0,0,,ШАГОМ К БЕЗОПАСНОСТИ. ДЛЯ МОСКВЫ ОНА МОЖЕТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:14:20.54,0:14:23.43,Caption,,0,0,0,,ПЕРВЫМ ШАГОМ К ВОССТАНОВЛЕНИЮ УКРАИНСКОЙ АРМИИ БЕЗ
Dialogue: 0,0:14:23.43,0:14:27.27,Caption,,0,0,0,,ИЗМЕНЕНИЯ ПРИЧИН, КОТОРЫЕ РОССИЙСКОЕ РУКОВОДСТВО СЧИТАЕТ ИСТОЧНИКОМ
Dialogue: 0,0:14:27.35,0:14:30.23,Caption,,0,0,0,,ВОЙНЫ. ЧЕРЕЗ НЕСКОЛЬКО МЕСЯЦЕВ ИЛИ ЛЕТ СПОР
Dialogue: 0,0:14:30.23,0:14:33.03,Caption,,0,0,0,,ВОЗВРАЩАЕТСЯ. ТОЛЬКО У УЧАСТНИКОВ УЖЕ НОВЫЕ
Dialogue: 0,0:14:33.03,0:14:38.87,Caption,,0,0,0,,УКРЕПЛЕНИЯ, СВЕЖИЕ ПОСТАВКИ, ПЕРЕСМОТРЕННЫЕ ПЛАНЫ И ЕЩЁ БОЛЕЕ ДЛИННЫЙ ПЕРЕЧЕНЬ
Dialogue: 0,0:14:38.87,0:14:41.83,Caption,,0,0,0,,ПРЕТЕНЗИЙ. ПОЛУЧАЕТСЯ НЕ МИР, А АНТРАКТ,
Dialogue: 0,0:14:41.99,0:14:44.23,Caption,,0,0,0,,ВО ВРЕМЯ КОТОРОГО ОРКЕСТР НЕ ОТДЫХАЕТ,
Dialogue: 0,0:14:44.47,0:14:47.67,Caption,,0,0,0,,А ЗАРЯЖАЕТ ИНСТРУМЕНТЫ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ И
Dialogue: 0,0:14:47.67,0:14:51.99,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, СМОГУТ ЛИ США И ЕВРОПА ДОГОВОРИТЬСЯ С РОССИЕЙ
Dialogue: 0,0:14:52.07,0:14:55.19,Caption,,0,0,0,,О ВЗАИМНЫХ ОГРАНИЧЕНИЯХ ИЛИ СНОВА ПОПЫТАЮТСЯ ВРУЧИТЬ
Dialogue: 0,0:14:55.27,0:14:58.07,Caption,,0,0,0,,ЕЙ ГОТОВЫЙ ДОКУМЕНТ БЕЗ ПРАВА ИСПРАВЛЕНИЙ.
Dialogue: 0,0:15:00.27,0:15:02.75,Caption,,0,0,0,,НАСТОЯЩИЙ МИР НАЧИНАЕТСЯ НЕ В ТУ СЕКУНДУ,
Dialogue: 0,0:15:02.99,0:15:07.15,Caption,,0,0,0,,КОГДА ЗАМОЛЧАЛО ОРУЖИЕ, А КОГДА СТОРОНАМ НЕЗАЧЕМ СНОВА ЕГО ДОСТАВАТЬ.
Dialogue: 0,0:15:07.78,0:15:10.11,Caption,,0,0,0,,КИЕВУ ДЛЯ ЭТОГО НУЖНЫ НАДЁЖНЫЕ ГАРАНТИИ,
Dialogue: 0,0:15:10.33,0:15:13.47,Caption,,0,0,0,,МОСКВЕ, ПРАВИЛА, КОТОРЫЕ ОНА НЕ СЧИТАЕТ УГРОЗОЙ,
Dialogue: 0,0:15:13.79,0:15:16.75,Caption,,0,0,0,,ЕВРОПЕ, ПОНИМАНИЕ ЦЕНЫ СВОИХ ОБЕЩАНИЙ,
Dialogue: 0,0:15:16.99,0:15:21.15,Caption,,0,0,0,,А США, ЯСНОСТЬ, КАКИЕ ОБЯЗАТЕЛЬСТВА ОНИ ГОТОВЫ ДЕРЖАТЬ НЕ ДО
Dialogue: 0,0:15:21.15,0:15:23.15,Caption,,0,0,0,,СЛЕДУЮЩИХ ВЫБОРОВ, А ЧЕРЕЗ ПЯТЬ,
Dialogue: 0,0:15:23.32,0:15:26.27,Caption,,0,0,0,,ДЕСЯТЬ И ПЯТНАДЦАТЬ ЛЕТ. ПОТРЕБУЕТСЯ ОПРЕДЕЛИТЬ
Dialogue: 0,0:15:26.27,0:15:28.43,Caption,,0,0,0,,МЕСТА РАЗМЕЩЕНИЯ ВОЙСК И РАКЕТ,
Dialogue: 0,0:15:28.68,0:15:33.15,Caption,,0,0,0,,ДОПУСТИМЫЕ ВИДЫ АКТИВНОСТИ, СПОСОБЫ КОНТРОЛЯ И ПОСЛЕДСТВИЯ НАРУШЕНИЙ.
Dialogue: 0,0:15:33.47,0:15:35.47,Caption,,0,0,0,,ПОТРЕБУЮТСЯ КАНАЛЫ СРОЧНОЙ СВЯЗИ,
Dialogue: 0,0:15:35.64,0:15:40.99,Caption,,0,0,0,,УВЕДОМЛЕНИЯ ОБ УЧЕНИЯХ, ИНСПЕКЦИИ И ПОНЯТНЫЕ ПРОЦЕДУРЫ ПРИ ИНЦИДЕНТАХ. ВСЁ
Dialogue: 0,0:15:40.99,0:15:44.11,Caption,,0,0,0,,ТО, ЧТО НА ТОРЖЕСТВЕННОЙ ЦЕРЕМОНИИ ЗВУЧИТ СКУЧНО,
Dialogue: 0,0:15:44.43,0:15:46.99,Caption,,0,0,0,,А В КРИТИЧЕСКИЙ МОМЕНТ СПАСАЕТ ГОРОДА ОТ ОЧЕНЬ
Dialogue: 0,0:15:46.99,0:15:50.35,Caption,,0,0,0,,НЕСКУЧНОЙ УЧАСТИ. ПАУЗА БЕЗ ЭТИХ РЕШЕНИЙ ОСТАВЛЯЕТ
Dialogue: 0,0:15:50.35,0:15:53.55,Caption,,0,0,0,,МЕХАНИЗМ КОНФЛИКТА СОБРАННЫМ. ЕГО МОЖНО НАКРЫТЬ
Dialogue: 0,0:15:53.55,0:15:57.47,Caption,,0,0,0,,ТКАНЬЮ, ВЫКЛЮЧИТЬ СВЕТ И ПОПРОСИТЬ ВСЕХ ХОДИТЬ ТИШЕ. НО
Dialogue: 0,0:15:57.47,0:16:00.51,Caption,,0,0,0,,ДЕТАЛИ НИКУДА НЕ ИСЧЕЗНУТ. КОГДА ТКАНЬ СНИМУТ,
Dialogue: 0,0:16:00.68,0:16:03.71,Caption,,0,0,0,,МЕХАНИЗМ СНОВА ОКАЖЕТСЯ ГОТОВ К РАБОТЕ. ПОЭТОМУ
Dialogue: 0,0:16:03.71,0:16:06.51,Caption,,0,0,0,,РЕЗКИЙ ОТКАЗ ЛАВРОВА КАСАЕТСЯ НЕ ТОЛЬКО ПРЕДЛОЖЕНИЯ
Dialogue: 0,0:16:06.51,0:16:09.23,Caption,,0,0,0,,ОСТАНОВИТЬ ОГОНЬ. МОСКВА ОТКАЗЫВАЕТСЯ ПРИНИМАТЬ
Dialogue: 0,0:16:09.31,0:16:11.95,Caption,,0,0,0,,УКРАИНСКИЙ КОНФЛИКТ КАК ОТДЕЛЬНУЮ ПОЛОМКУ,
Dialogue: 0,0:16:12.11,0:16:15.23,Caption,,0,0,0,,КОТОРУЮ МОЖНО БЫСТРО ЗАКЛЕИТЬ. ОНА ТРЕБУЕТ РАЗБИРАТЬ
Dialogue: 0,0:16:15.31,0:16:21.83,Caption,,0,0,0,,ВСЮ СИСТЕМУ ОТНОШЕНИЙ С НАТО. ИМЕННО ЗДЕСЬ ПРОХОДИТ ГЛАВНАЯ ЛИНИЯ БУДУЩЕГО
Dialogue: 0,0:16:21.83,0:16:24.55,Caption,,0,0,0,,СОГЛАШЕНИЯ. ЕВРОПЕЙСКИЕ РАЗГОВОРЫ О СТАРЫХ
Dialogue: 0,0:16:24.55,0:16:28.87,Caption,,0,0,0,,МЕХАНИЗМАХ, СЛОВА РУБИО О ПРИЕМЛЕМЫХ ДЛЯ РОССИИ ГАРАНТИЯХ И
Dialogue: 0,0:16:28.95,0:16:31.35,Caption,,0,0,0,,ЗАЯВЛЕНИЕ КУШНЕРА ОБ УСЛОВИЯХ ПОКАЗЫВАЮТ,
Dialogue: 0,0:16:31.58,0:16:34.39,Caption,,0,0,0,,ЧТО ОСТАЛЬНЫЕ УЧАСТНИКИ ТОЖЕ ПРИБЛИЖАЮТСЯ К ЭТОЙ
Dialogue: 0,0:16:34.47,0:16:38.63,Caption,,0,0,0,,ЛИНИИ. ПОКА ОСТОРОЖНО, КАЖДЫЙ СО СВОЕЙ СТОРОНЫ И С ТАКИМ ВИДОМ,
Dialogue: 0,0:16:38.80,0:16:41.75,Caption,,0,0,0,,БУДТО МАРШРУТ ТОЛЬКО ЧТО ПРИДУМАЛИ. ХОТЯ УКАЗАТЕЛЬ
Dialogue: 0,0:16:41.83,0:16:43.91,Caption,,0,0,0,,СТОЯЛ ТАМ ЕЩЁ В ДЕКАБРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:16:43.91,0:16:46.79,Caption,,0,0,0,,ПЕРВОГО ГОДА. ТОГДА РОССИЙСКИЕ ПРЕДЛОЖЕНИЯ ОТВЕРГЛИ.
Dialogue: 0,0:16:47.46,0:16:50.23,Caption,,0,0,0,,СЕГОДНЯ СПОР ВОЗВРАЩАЕТСЯ К ТЕМ ЖЕ ВОПРОСАМ,
Dialogue: 0,0:16:50.47,0:16:53.75,Caption,,0,0,0,,НО УЖЕ ПОСЛЕ НЕСКОЛЬКИХ ЛЕТ ВОЙНЫ. ОДНОГО ПРЕЖНЕГО
Dialogue: 0,0:16:53.83,0:16:58.07,Caption,,0,0,0,,ОТВЕТА ТЕПЕРЬ НЕДОСТАТОЧНО, ПОТОМУ ЧТО ИЗМЕНИЛАСЬ ЦЕНА КАЖДОГО СЛЕДУЮЩЕГО
Dialogue: 0,0:16:58.07,0:17:01.35,Caption,,0,0,0,,ОТКАЗА. ИРОНИЯ ПОЛУЧИЛАСЬ ТЯЖЁЛАЯ. ЧТОБЫ СНОВА
Dialogue: 0,0:17:01.35,0:17:03.91,Caption,,0,0,0,,ЗАГОВОРИТЬ О КОНТРОЛЕ НАД ВООРУЖЕНИЯМИ И ОБЩЕЙ
Dialogue: 0,0:17:03.91,0:17:07.51,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ПРИШЛОСЬ СНАЧАЛА РАЗРУШИТЬ СТАРЫЕ МЕХАНИЗМЫ,
Dialogue: 0,0:17:07.78,0:17:10.15,Caption,,0,0,0,,ПРОЙТИ ЧЕРЕЗ ОГРОМНЫЙ КОНФЛИКТ И ОБНАРУЖИТЬ,
Dialogue: 0,0:17:10.31,0:17:13.43,Caption,,0,0,0,,ЧТО ГЕОГРАФИЯ НИКУДА НЕ ДЕЛАСЬ. РОССИЯ И НАТО
Dialogue: 0,0:17:13.71,0:17:16.87,Caption,,0,0,0,,ПО ПРЕЖНЕМУ ОСТАЮТСЯ РЯДОМ. РАКЕТЫ НЕ СТАЛИ КОРОЧЕ.
Dialogue: 0,0:17:17.11,0:17:20.79,Caption,,0,0,0,,БАЗЫ НЕ РАСТВОРИЛИСЬ. НЕДОВЕРИЕ НЕ УСТАЛО И ДОМОЙ
Dialogue: 0,0:17:20.87,0:17:23.99,Caption,,0,0,0,,НЕ УШЛО. ТЕПЕРЬ ПЕРЕГОВОРЩИКАМ ПРИДЁТСЯ ДЕЛАТЬ ТО,
Dialogue: 0,0:17:24.23,0:17:26.87,Caption,,0,0,0,,ОТ ЧЕГО ОНИ КОГДА ТО ОТКАЗАЛИСЬ ОБСУЖДАТЬ НЕ
Dialogue: 0,0:17:26.95,0:17:29.51,Caption,,0,0,0,,ТОЛЬКО ПРЕКРАЩЕНИЕ СТРЕЛЬБЫ, НО И ПРИЧИНЫ,
Dialogue: 0,0:17:29.75,0:17:31.59,Caption,,0,0,0,,ПО КОТОРЫМ ОНА МОЖЕТ НАЧАТЬСЯ СНОВА.
Dialogue: 0,0:17:33.87,0:17:36.51,Caption,,0,0,0,,И ЧЕМ ДОЛЬШЕ ОНИ БУДУТ ИЗОБРАЖАТЬ УДИВЛЕНИЕ,
Dialogue: 0,0:17:36.91,0:17:40.11,Caption,,0,0,0,,ТЕМ ДОРОЖЕ ОБОЙДЁТСЯ СЛЕДУЮЩАЯ ПОПЫТКА ОТКРЫТЬ ТУ ЖЕ
Dialogue: 0,0:17:40.19,0:17:41.07,Caption,,0,0,0,,САМУЮ ПАПКУ.
