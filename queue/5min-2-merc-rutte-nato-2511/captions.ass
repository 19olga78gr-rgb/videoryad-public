Dialogue: 0,0:00:00.12,0:00:02.58,Caption,,0,0,0,,СЛУШАЙТЕ, А У ЕВРОПЕЙСКИХ ПОЛИТИКОВ ВООБЩЕ
Dialogue: 0,0:00:02.58,0:00:04.36,Caption,,0,0,0,,ДРУГИЕ ТЕМЫ ДЛЯ РАЗГОВОРОВ ОСТАЛИСЬ?
Dialogue: 0,0:00:04.59,0:00:07.48,Caption,,0,0,0,,НУ ТАМ ЭКОНОМИКУ ПОДНЯТЬ, ТОРГОВЛЮ НАЛАДИТЬ,
Dialogue: 0,0:00:07.72,0:00:09.80,Caption,,0,0,0,,ЛЮДЯМ ЖИЗНЬ ОБЛЕГЧИТЬ. ИЛИ ЭТО УЖЕ
Dialogue: 0,0:00:09.80,0:00:12.68,Caption,,0,0,0,,СЧИТАЕТСЯ ЧЕМ ТО НЕПРИЛИЧНЫМ? КОГО НИ ПОСЛУШАЕШЬ,
Dialogue: 0,0:00:12.84,0:00:14.59,Caption,,0,0,0,,ПРЯМО НАПОЛЕОН КАКОЙ ТО. ПРИЧЁМ
Dialogue: 0,0:00:14.59,0:00:16.83,Caption,,0,0,0,,НАПОЛЕОНОВ СТАНОВИТСЯ ВСЁ БОЛЬШЕ. А ВОТ С
Dialogue: 0,0:00:16.83,0:00:19.55,Caption,,0,0,0,,ОСТАЛЬНЫМ КАК ТО НЕ ЗАЛАДИЛОСЬ. ЕСЛИ ВАМ НРАВИТСЯ
Dialogue: 0,0:00:19.55,0:00:22.20,Caption,,0,0,0,,ТАКОЙ РАЗБОР БЕЗ ЗАНУДСТВА И ДЛИННЫХ ПОКЛОНОВ ПЕРЕД
Dialogue: 0,0:00:22.20,0:00:25.00,Caption,,0,0,0,,МИКРОФОНОМ, ПОДПИШИТЕСЬ. ДАЛЬШЕ БУДЕТ ТОЛЬКО
Dialogue: 0,0:00:25.00,0:00:27.16,Caption,,0,0,0,,ВЕСЕЛЕЕ. ХОТЯ СЛОВО "ВЕСЕЛЕЕ" ТУТ,
Dialogue: 0,0:00:27.24,0:00:30.21,Caption,,0,0,0,,КОНЕЧНО, УЖЕ НАЧИНАЕТ ЗВУЧАТЬ ПОДОЗРИТЕЛЬНО.
Dialogue: 0,0:00:30.21,0:00:32.95,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ КОМИССИЯ ПОЛУЧИЛА ПРЕДЛОЖЕНИЕ ПРИЕХАТЬ
Dialogue: 0,0:00:32.95,0:00:35.28,Caption,,0,0,0,,В МОСКВУ И ОТДЕЛЬНО ПОГОВОРИТЬ О ЕВРОПЕЙСКОЙ
Dialogue: 0,0:00:35.28,0:00:37.40,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ОТВЕТ ПРОСТОЙ НЕТ,
Dialogue: 0,0:00:37.51,0:00:41.13,Caption,,0,0,0,,ОТДЕЛЬНО НЕ ХОТИМ, ХОТИМ МНОГОСТОРОННИЙ ФОРМАТ. ПРИ ЭТОМ
Dialogue: 0,0:00:41.13,0:00:44.44,Caption,,0,0,0,,МЕРЦ ГОВОРИТ, ЧТО ЕВРОПА К ПЕРЕГОВОРАМ ГОТОВА.
Dialogue: 0,0:00:44.44,0:00:47.08,Caption,,0,0,0,,ХОРОШО. УЖЕ КРАСИВО. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:00:47.16,0:00:49.05,Caption,,0,0,0,,ГОТОВЫ РАЗГОВАРИВАТЬ. С ДРУГОЙ
Dialogue: 0,0:00:49.05,0:00:51.71,Caption,,0,0,0,,СТОРОНЫ, ОТДЕЛЬНО РАЗГОВАРИВАТЬ НЕ ГОТОВЫ. А
Dialogue: 0,0:00:51.71,0:00:54.55,Caption,,0,0,0,,ЕЩЁ СНАЧАЛА НУЖНО ПРЕКРАЩЕНИЕ ОГНЯ НА УКРАИНЕ. ТО
Dialogue: 0,0:00:54.55,0:00:57.08,Caption,,0,0,0,,ЕСТЬ РАЗГОВОР НАЧИНАЕТСЯ ПРИМЕРНО ТАК МЫ ГОТОВЫ
Dialogue: 0,0:00:57.08,0:00:59.96,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ, КОГДА ВЫ СНАЧАЛА СДЕЛАЕТЕ ТО,
Dialogue: 0,0:01:00.12,0:01:02.36,Caption,,0,0,0,,ЧТО МЫ ОТ ВАС ТРЕБУЕМ. РЮТТЕ В ЭТО
Dialogue: 0,0:01:02.36,0:01:04.31,Caption,,0,0,0,,ЖЕ ВРЕМЯ ГОВОРИТ ЕЩЁ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:01:04.31,0:01:07.68,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ НАТО К ПОЗИЦИЯМ МАЯ ДЕВЯНОСТО СЕДЬМОГО ГОДА
Dialogue: 0,0:01:07.68,0:01:12.17,Caption,,0,0,0,,НЕПРИЕМЛЕМО. ГДЕ РАЗМЕЩАТЬ ВОЙСКА,
Dialogue: 0,0:01:12.31,0:01:14.01,Caption,,0,0,0,,КОГО ПРИНИМАТЬ В АЛЬЯНС И КУДА
Dialogue: 0,0:01:14.01,0:01:17.83,Caption,,0,0,0,,ДВИГАТЬСЯ ДАЛЬШЕ, НАТО БУДЕТ РЕШАТЬ САМО. РОССИЯ НА ЭТО
Dialogue: 0,0:01:17.83,0:01:20.97,Caption,,0,0,0,,ВЛИЯТЬ НЕ ДОЛЖНА. МОСКВА, В СВОЮ ОЧЕРЕДЬ,
Dialogue: 0,0:01:21.18,0:01:22.95,Caption,,0,0,0,,СНОВА ПОДНИМАЕТ СВОИ ТРЕБОВАНИЯ
Dialogue: 0,0:01:22.95,0:01:25.29,Caption,,0,0,0,,НИКАКОГО ДАЛЬНЕЙШЕГО РАСШИРЕНИЯ НА ВОСТОК,
Dialogue: 0,0:01:25.57,0:01:27.72,Caption,,0,0,0,,ОТВОД СИЛ К РУБЕЖАМ ДЕВЯНОСТО СЕДЬМОГО
Dialogue: 0,0:01:27.72,0:01:30.07,Caption,,0,0,0,,ГОДА, СВОРАЧИВАНИЕ ВОЕННОЙ АКТИВНОСТИ В
Dialogue: 0,0:01:30.07,0:01:33.82,Caption,,0,0,0,,ВОСТОЧНОЙ ЕВРОПЕ, ЗАКАВКАЗЬЕ И ЦЕНТРАЛЬНОЙ АЗИИ. ЮРИЙ
Dialogue: 0,0:01:33.82,0:01:37.11,Caption,,0,0,0,,УШАКОВ ПОДТВЕРДИЛ, ЧТО ЭТИ ТРЕБОВАНИЯ СНОВА ЗВУЧАЛИ НА
Dialogue: 0,0:01:37.11,0:01:40.01,Caption,,0,0,0,,ПЕРЕГОВОРАХ В АБУ ДАБИ. В ПОЛЬШЕ УЖЕ ГОВОРЯТ,
Dialogue: 0,0:01:40.32,0:01:42.97,Caption,,0,0,0,,ЧТО ТАКОЙ ПОДХОД УГРОЖАЕТ ИХ БЕЗОПАСНОСТИ. В
Dialogue: 0,0:01:42.97,0:01:46.09,Caption,,0,0,0,,БОЛГАРИИ ЗАЯВЛЯЮТ, ЧТО ОБСУЖДАТЬ ЭТО ВООБЩЕ НЕ
Dialogue: 0,0:01:46.09,0:01:49.31,Caption,,0,0,0,,СОБИРАЮТСЯ. И ВОТ ТУТ У МЕНЯ ОДИН ОЧЕНЬ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:01:49.31,0:01:51.07,Caption,,0,0,0,,А КАКОЙ ВЫБОР ВЫ ТОГДА ОСТАВЛЯЕТЕ
Dialogue: 0,0:01:51.07,0:01:53.05,Caption,,0,0,0,,РОССИИ? ЧТО ОНА ДОЛЖНА СДЕЛАТЬ?
Dialogue: 0,0:01:53.25,0:01:55.05,Caption,,0,0,0,,ПОДНЯТЬ РУЧКИ И СКАЗАТЬ НУ ЛАДНО,
Dialogue: 0,0:01:55.25,0:01:57.45,Caption,,0,0,0,,ПОНЯЛИ, ВЫ БУДЕТЕ ПОДХОДИТЬ ВСЁ БЛИЖЕ,
Dialogue: 0,0:01:57.69,0:01:59.13,Caption,,0,0,0,,А МЫ БУДЕМ ОТХОДИТЬ ВСЁ ДАЛЬШЕ?
Dialogue: 0,0:01:59.42,0:02:02.75,Caption,,0,0,0,,ТАК ЭТО РАБОТАЕТ? БЕЗОПАСНОСТЬ ПОЛЬШИ ОБСУЖДАТЬ МОЖНО.
Dialogue: 0,0:02:02.75,0:02:05.83,Caption,,0,0,0,,БЕЗОПАСНОСТЬ РОССИИ ОБСУЖДАТЬ НЕЛЬЗЯ. НАТО САМО
Dialogue: 0,0:02:05.83,0:02:09.88,Caption,,0,0,0,,РЕШИТ, ГДЕ БУДУТ ЕГО ВОЙСКА, НО РОССИЯ ДОЛЖНА СПОКОЙНО СМОТРЕТЬ НА
Dialogue: 0,0:02:09.88,0:02:12.55,Caption,,0,0,0,,ЭТО И РАДОВАТЬСЯ ЖИЗНИ. И ЕСЛИ ТАК ШАГ ЗА
Dialogue: 0,0:02:12.55,0:02:14.49,Caption,,0,0,0,,ШАГОМ ЗАГОНЯТЬ СИТУАЦИЮ ВСЁ ДАЛЬШЕ,
Dialogue: 0,0:02:14.73,0:02:18.38,Caption,,0,0,0,,ТО ЧЕМ ЭТО ЗАКОНЧИТСЯ? ВЫ ПРОСТО ОБРЕКАЕТЕ ЕВРОПУ НА ЯДЕРНУЮ
Dialogue: 0,0:02:18.38,0:02:20.81,Caption,,0,0,0,,ЗИМУ. ПРИЧЁМ ВСЁ ЭТО ИДЁТ НЕ НА ФОНЕ КАКОГО ТО
Dialogue: 0,0:02:20.81,0:02:22.65,Caption,,0,0,0,,БОЛЬШОГО РАЗОРУЖЕНИЯ. НАОБОРОТ.
Dialogue: 0,0:02:24.92,0:02:27.24,Caption,,0,0,0,,ГОВОРЯТ О РОСТЕ ПРОИЗВОДСТВА БОЕПРИПАСОВ,
Dialogue: 0,0:02:27.50,0:02:31.31,Caption,,0,0,0,,О НОВЫХ ВОЕННЫХ ВОЗМОЖНОСТЯХ, А РЯДОМ УЖЕ ПОЯВЛЯЮТСЯ СООБЩЕНИЯ О
Dialogue: 0,0:02:31.31,0:02:34.46,Caption,,0,0,0,,БОЕВЫХ ПОЛЁТАХ АВИАЦИИ АЛЬЯНСА У РОССИЙСКИХ ГРАНИЦ.
Dialogue: 0,0:02:34.46,0:02:36.77,Caption,,0,0,0,,НУ ЗАМЕЧАТЕЛЬНО. ОЧЕНЬ РАСПОЛАГАЕТ К
Dialogue: 0,0:02:36.77,0:02:39.80,Caption,,0,0,0,,СПОКОЙСТВИЮ. И ВОТ ПОСЛЕ ЭТОГО КТО ТО ЕЩЁ УДИВЛЯЕТСЯ,
Dialogue: 0,0:02:40.03,0:02:41.64,Caption,,0,0,0,,ПОЧЕМУ РАЗГОВОР О МИРЕ ВСЁ ВРЕМЯ
Dialogue: 0,0:02:41.64,0:02:44.35,Caption,,0,0,0,,УПИРАЕТСЯ В СТЕНУ. ДА ПОТОМУ ЧТО НИКТО НЕ ГОВОРИТ
Dialogue: 0,0:02:44.35,0:02:46.77,Caption,,0,0,0,,ДАВАЙТЕ ОБА СДЕЛАЕМ ШАГ НАЗАД. НИКТО НЕ
Dialogue: 0,0:02:46.77,0:02:51.19,Caption,,0,0,0,,ГОВОРИТ ВОТ ТУТ УСТУПИМ МЫ, ВОТ ТУТ УСТУПИТЕ ВЫ. НЕТ. ОДИН СПИСОК
Dialogue: 0,0:02:51.19,0:02:53.48,Caption,,0,0,0,,ТРЕБОВАНИЙ, ВТОРОЙ СПИСОК ТРЕБОВАНИЙ,
Dialogue: 0,0:02:53.76,0:02:56.44,Caption,,0,0,0,,И КАЖДЫЙ ЖДЁТ, КОГДА ДРУГОЙ ПЕРВЫМ МОРГНЁТ.
Dialogue: 0,0:02:56.44,0:02:59.04,Caption,,0,0,0,,ПОЛУЧАЕТСЯ, ДОГОВАРИВАТЬСЯ ОНИ ПОКА СОБИРАЮТСЯ В
Dialogue: 0,0:02:59.04,0:03:02.96,Caption,,0,0,0,,ОСНОВНОМ САМИ С СОБОЙ. А ДАЛЬШЕ НА СЦЕНУ ВЫХОДИТ МАРК РЮТТЕ.
Dialogue: 0,0:03:02.96,0:03:05.64,Caption,,0,0,0,,ПРИЧЁМ ВЫХОДИТ ОН В БЕРЛИНЕ. И ТУТ САМО МЕСТО
Dialogue: 0,0:03:05.64,0:03:07.35,Caption,,0,0,0,,ВЫСТУПЛЕНИЯ НАВЕВАЕТ НЕХОРОШИЕ
Dialogue: 0,0:03:07.35,0:03:10.00,Caption,,0,0,0,,ИСТОРИЧЕСКИЕ АССОЦИАЦИИ. НУ ЧТОБЫ ДВАЖДЫ НЕ
Dialogue: 0,0:03:10.00,0:03:13.00,Caption,,0,0,0,,ВСТАВАТЬ. РУКИ ПОМНЯТ. И ЧТО РАССКАЗЫВАЕТ РЮТТЕ?
Dialogue: 0,0:03:13.48,0:03:15.58,Caption,,0,0,0,,НУЖНО ГОТОВИТЬ НЕ ТОЛЬКО АРМИИ. НУЖНО
Dialogue: 0,0:03:15.58,0:03:19.08,Caption,,0,0,0,,ГОТОВИТЬ ГРАЖДАН, БИЗНЕС, ГОСУДАРСТВЕННЫЕ СТРУКТУРЫ,
Dialogue: 0,0:03:19.24,0:03:21.48,Caption,,0,0,0,,МЕСТНЫЕ СООБЩЕСТВА. НУЖНО ОБЪЯСНЯТЬ
Dialogue: 0,0:03:21.48,0:03:23.72,Caption,,0,0,0,,НАСЕЛЕНИЮ, ЧТО ДЕЛАТЬ В СЛУЧАЕ ВОЙНЫ,
Dialogue: 0,0:03:23.96,0:03:25.68,Caption,,0,0,0,,КАК НЕ МЕШАТЬ ВОЕННЫМ И КАК ИМ
Dialogue: 0,0:03:25.68,0:03:28.12,Caption,,0,0,0,,ПОМОГАТЬ. НУЖНО ЗАНИМАТЬСЯ ЭНЕРГЕТИКОЙ,
Dialogue: 0,0:03:28.22,0:03:31.81,Caption,,0,0,0,,ТЕПЛОСНАБЖЕНИЕМ, КИБЕРБЕЗОПАСНОСТЬЮ. В ПРИМЕР СТАВЯТ
Dialogue: 0,0:03:31.81,0:03:35.09,Caption,,0,0,0,,НОРВЕГИЮ, ШВЕЦИЮ, ДАНИЮ И ФИНЛЯНДИЮ. ТО ЕСТЬ ПО
Dialogue: 0,0:03:35.09,0:03:37.96,Caption,,0,0,0,,ПОДГОТОВКЕ К БОЛЬШОЙ ДРАКЕ РАБОТА ИДЁТ СЕРЬЁЗНАЯ.
Dialogue: 0,0:03:40.23,0:03:42.63,Caption,,0,0,0,,ТУТ И ПАМЯТКИ, И ИНФРАСТРУКТУРА,
Dialogue: 0,0:03:42.79,0:03:45.98,Caption,,0,0,0,,И БИЗНЕС, И НАСЕЛЕНИЕ. ВСЁ РАСПИСАНО. А ВОТ
Dialogue: 0,0:03:45.98,0:03:47.99,Caption,,0,0,0,,КОГДА ДЕЛО ДОХОДИТ ДО КОМПРОМИССА,
Dialogue: 0,0:03:48.15,0:03:50.27,Caption,,0,0,0,,ТАМ ПОЧЕМУ ТО ЛИСТОЧЕК ПУСТОЙ. ВОТ
Dialogue: 0,0:03:50.27,0:03:52.59,Caption,,0,0,0,,ЭТОГО Я И НЕ ПОНИМАЮ. НА СЛУЧАЙ ВОЙНЫ
Dialogue: 0,0:03:52.59,0:03:55.51,Caption,,0,0,0,,ИНСТРУКЦИИ ЕСТЬ. НА СЛУЧАЙ МИРА ИНСТРУКЦИИ,
Dialogue: 0,0:03:55.63,0:03:58.28,Caption,,0,0,0,,ПОХОЖЕ, ПОТЕРЯЛИСЬ. РЮТТЕ ЕЩЁ И ПРОТИВ
Dialogue: 0,0:03:58.28,0:04:01.79,Caption,,0,0,0,,ОТДЕЛЬНОЙ АРМИИ ЕВРОСОЮЗА. ЛОГИКА У НЕГО ПРОСТАЯ ЕСЛИ
Dialogue: 0,0:04:01.79,0:04:05.45,Caption,,0,0,0,,ПОЯВИТСЯ ЕЩЁ ОДНА СТРУКТУРА, ПОТОМ ДВЕ ИЛИ ТРИ НЕДЕЛИ БУДУТ
Dialogue: 0,0:04:05.45,0:04:08.55,Caption,,0,0,0,,РАЗБИРАТЬСЯ, КТО ЗА ЧТО ОТВЕЧАЕТ. А ЗА ЭТО ВРЕМЯ,
Dialogue: 0,0:04:08.63,0:04:11.52,Caption,,0,0,0,,ГОВОРИТ ОН, РОССИЙСКИЕ ВОЙСКА УЖЕ МОГУТ ОКАЗАТЬСЯ
Dialogue: 0,0:04:11.52,0:04:15.87,Caption,,0,0,0,,В РОТТЕРДАМЕ. В РОТТЕРДАМЕ? АМБИЦИОЗНО. Я ВОТ ТОЛЬКО ОДНОГО ПОНЯТЬ
Dialogue: 0,0:04:15.87,0:04:17.99,Caption,,0,0,0,,НЕ МОГУ. ГДЕ ИХ ВСЕХ ВЫРАЩИВАЮТ,
Dialogue: 0,0:04:18.20,0:04:20.15,Caption,,0,0,0,,ЭТИХ ПОЛИТИКОВ? ТАКОЕ ОЩУЩЕНИЕ,
Dialogue: 0,0:04:20.39,0:04:22.33,Caption,,0,0,0,,ЧТО ГДЕ ТО ЕСТЬ СПЕЦИАЛЬНЫЙ ДЕТСКИЙ
Dialogue: 0,0:04:22.33,0:04:24.80,Caption,,0,0,0,,ДОМ, ГДЕ С МАЛЫХ ЛЕТ УЧАТ ТОЛЬКО ОДНОМУ
Dialogue: 0,0:04:24.80,0:04:26.71,Caption,,0,0,0,,ПРЕДМЕТУ КАК ПРАВИЛЬНО ПОДГОТОВИТЬСЯ К
Dialogue: 0,0:04:26.71,0:04:29.35,Caption,,0,0,0,,ОЧЕРЕДНОЙ ВОЙНЕ. ЭКОНОМИКА? НЕ,
Dialogue: 0,0:04:29.51,0:04:33.75,Caption,,0,0,0,,ЭТО ФАКУЛЬТАТИВ. ТОРГОВЛЯ? ПОТОМ. ЧТОБЫ ЛЮДИ НОРМАЛЬНО ЖИЛИ,
Dialogue: 0,0:04:33.83,0:04:38.53,Caption,,0,0,0,,РАБОТАЛИ, ДЕТЕЙ РАСТИЛИ? СКУКОТА. А ВОТ КАК ВОВЛЕЧЬ НАСЕЛЕНИЕ В
Dialogue: 0,0:04:38.53,0:04:41.83,Caption,,0,0,0,,ВОЕННУЮ ПОДГОТОВКУ, КАК ПОСТРОИТЬ НОВЫЕ СТРУКТУРЫ,
Dialogue: 0,0:04:42.07,0:04:44.23,Caption,,0,0,0,,КАК УВЕЛИЧИТЬ ПРОИЗВОДСТВО БОЕПРИПАСОВ,
Dialogue: 0,0:04:44.55,0:04:46.94,Caption,,0,0,0,,ВОТ ТУТ ГЛАЗА СРАЗУ ЗАГОРАЮТСЯ. И ВЕДЬ
Dialogue: 0,0:04:46.94,0:04:50.25,Caption,,0,0,0,,КОГО НИ ВЫБЕРИ, ВСЁ РАВНО ПРИМЕРНО ТУДА ЖЕ. ЛИЦА
Dialogue: 0,0:04:50.25,0:04:53.75,Caption,,0,0,0,,МЕНЯЮТСЯ, ПАРТИИ МЕНЯЮТСЯ, ФАМИЛИИ МЕНЯЮТСЯ,
Dialogue: 0,0:04:53.99,0:04:56.15,Caption,,0,0,0,,А ВЗГЛЯД ВСЁ ВРЕМЯ В ОДНУ СТОРОНУ. НА
Dialogue: 0,0:04:56.15,0:05:02.38,Caption,,0,0,0,,ВОЙНУ. ЧТО ЗА ПАРАДОКС ТАКОЙ? У ЧЕЛОВЕКА ВРОДЕ ЕСТЬ ВЫБОР НА
Dialogue: 0,0:05:02.38,0:05:06.18,Caption,,0,0,0,,ВЫБОРАХ. А ПОТОМ ОКАЗЫВАЕТСЯ, ЧТО НАПРАВЛЕНИЕ ДВИЖЕНИЯ УЖЕ ВЫБРАЛИ
Dialogue: 0,0:05:06.18,0:05:09.56,Caption,,0,0,0,,БЕЗ НЕГО. МЕРЦ ТОЖЕ РЕШИЛ ДОБАВИТЬ ОГОНЬКУ. ОН
Dialogue: 0,0:05:09.56,0:05:12.43,Caption,,0,0,0,,ВСПОМНИЛ САММИТ НАТО В БУХАРЕСТЕ ДВЕ ТЫСЯЧИ ВОСЬМОГО
Dialogue: 0,0:05:12.43,0:05:15.28,Caption,,0,0,0,,ГОДА И ЗАЯВИЛ, ЧТО ОШИБКОЙ БЫЛО НЕ ПРИНЯТЬ ТОГДА
Dialogue: 0,0:05:15.28,0:05:18.08,Caption,,0,0,0,,АМЕРИКАНСКОЕ ПРЕДЛОЖЕНИЕ ПО ВСТУПЛЕНИЮ УКРАИНЫ В
Dialogue: 0,0:05:18.08,0:05:21.62,Caption,,0,0,0,,НАТО. ПО ЕГО ВЕРСИИ, ЕСЛИ БЫ УКРАИНА УЖЕ БЫЛА В АЛЬЯНСЕ,
Dialogue: 0,0:05:21.86,0:05:23.75,Caption,,0,0,0,,НЫНЕШНЕЙ ВОЙНЫ ВООБЩЕ УДАЛОСЬ БЫ
Dialogue: 0,0:05:23.75,0:05:26.82,Caption,,0,0,0,,ИЗБЕЖАТЬ. ФРИДРИХ, А ВТОРОЙ ВАРИАНТ ТЫ РАССМАТРИВАЛ?
Dialogue: 0,0:05:27.11,0:05:28.97,Caption,,0,0,0,,ЧТО ЕСЛИ БЫ ПРИШЛОСЬ НЕ РАССУЖДАТЬ НА
Dialogue: 0,0:05:28.97,0:05:32.26,Caption,,0,0,0,,ПРЕСС КОНФЕРЕНЦИИ, А РЕАЛЬНО ВСТУПАТЬ В ПРЯМОЙ КОНФЛИКТ
Dialogue: 0,0:05:32.26,0:05:35.01,Caption,,0,0,0,,ВСЕЙ ЕВРОПОЙ? ЧТО ЕСЛИ БЫ ТЕБЕ ПРИШЛОСЬ УПРАВЛЯТЬ
Dialogue: 0,0:05:35.01,0:05:37.62,Caption,,0,0,0,,УЖЕ НЕ ИЗ КРАСИВОГО КАБИНЕТА, А ИЗ БУНКЕРА?
Dialogue: 0,0:05:37.98,0:05:39.86,Caption,,0,0,0,,ОПЫТ У НЕМЕЦКОЙ ИСТОРИИ ТАКОЙ,
Dialogue: 0,0:05:39.96,0:05:42.85,Caption,,0,0,0,,МЯГКО ГОВОРЯ, ИМЕЕТСЯ. ВОТ ПОЧЕМУ У НИХ ВСЕГДА
Dialogue: 0,0:05:42.85,0:05:44.98,Caption,,0,0,0,,РАССМАТРИВАЕТСЯ ТОЛЬКО ТОТ СЦЕНАРИЙ,
Dialogue: 0,0:05:45.15,0:05:46.82,Caption,,0,0,0,,ГДЕ ОНИ ВСЁ СДЕЛАЛИ ПРАВИЛЬНО,
Dialogue: 0,0:05:46.98,0:05:49.14,Caption,,0,0,0,,ВСЁ РАССЧИТАЛИ И ОБЯЗАТЕЛЬНО ПОБЕДИЛИ?
Dialogue: 0,0:05:49.43,0:05:52.02,Caption,,0,0,0,,А СЦЕНАРИЙ, ГДЕ РАСЧЁТ ОКАЗАЛСЯ НЕПРАВИЛЬНЫМ,
Dialogue: 0,0:05:52.18,0:05:55.32,Caption,,0,0,0,,ЗАПРЕЩЁН К ПРОСМОТРУ? ПРИ ЭТОМ ТОТ ЖЕ МЕРЦ ГОВОРИТ О
Dialogue: 0,0:05:55.32,0:05:57.06,Caption,,0,0,0,,ПЕРЕГОВОРАХ В ФОРМАТЕ УКРАИНА,
Dialogue: 0,0:05:57.22,0:06:01.43,Caption,,0,0,0,,РОССИЯ, ЕВРОПА, США. ДАЖЕ АБУ ДАБИ ОПЯТЬ ПОЯВЛЯЕТСЯ В
Dialogue: 0,0:06:01.43,0:06:04.71,Caption,,0,0,0,,РАЗГОВОРАХ. ВСЁ ВРОДЕ КРАСИВО. ТОЛЬКО РЯДОМ РЮТТЕ
Dialogue: 0,0:06:04.71,0:06:07.38,Caption,,0,0,0,,ДОБАВЛЯЕТ НА КАЖДЫЙ ИНЦИДЕНТ В ЕВРОПЕ НУЖНО
Dialogue: 0,0:06:07.38,0:06:09.86,Caption,,0,0,0,,ОТВЕЧАТЬ ЕЩЁ БОЛЬШЕЙ ПОДДЕРЖКОЙ УКРАИНЫ.
Dialogue: 0,0:06:12.05,0:06:13.86,Caption,,0,0,0,,ТО ЕСТЬ ЛЮБОЙ НОВЫЙ ЭПИЗОД СРАЗУ
Dialogue: 0,0:06:13.86,0:06:16.87,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ ЕЩЁ В ОДНУ СТУПЕНЬКУ ВВЕРХ. А В ГЕРМАНИИ
Dialogue: 0,0:06:16.87,0:06:19.74,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ЗВУЧИТ УЖЕ СОВСЕМ ИНТЕРЕСНАЯ МУЗЫКА.
Dialogue: 0,0:06:19.74,0:06:21.86,Caption,,0,0,0,,ГЛАВА МИНИСТЕРСТВА ИНОСТРАННЫХ ДЕЛ ЙОХАНН
Dialogue: 0,0:06:21.86,0:06:24.29,Caption,,0,0,0,,ВАДЕФУЛЬ ГОВОРИТ МЫ УЖЕ НЕ В СОСТОЯНИИ МИРА,
Dialogue: 0,0:06:24.53,0:06:26.49,Caption,,0,0,0,,НО ЕЩЁ НЕ В СОСТОЯНИИ ВОЙНЫ. И
Dialogue: 0,0:06:26.49,0:06:28.85,Caption,,0,0,0,,ОТДЕЛЬНО ПОДЧЁРКИВАЕТ, ЧТО УГРОЗЫ,
Dialogue: 0,0:06:28.93,0:06:32.35,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, НЕ ОГРАНИЧИВАЮТСЯ ОДНОЙ РОССИЕЙ. ПРЯМО
Dialogue: 0,0:06:32.35,0:06:34.61,Caption,,0,0,0,,ЧУДЕСНАЯ ФОРМУЛИРОВКА. ГЛАВНОЕ,
Dialogue: 0,0:06:34.69,0:06:37.35,Caption,,0,0,0,,ВСЕМ СРАЗУ СПОКОЙНЕЕ СТАЛО. ДАЛЬШЕ ЕЩЁ
Dialogue: 0,0:06:37.35,0:06:39.41,Caption,,0,0,0,,ЛУЧШЕ. МИР И СТАБИЛЬНОСТЬ В ЕВРОПЕ,
Dialogue: 0,0:06:39.57,0:06:42.65,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ВОЗМОЖНЫ ТОЛЬКО В ПРОТИВОСТОЯНИИ С
Dialogue: 0,0:06:42.65,0:06:47.18,Caption,,0,0,0,,РОССИЕЙ. НЕ ВМЕСТЕ С РОССИЕЙ, А ПРОТИВ НЕЁ. ЭТО НАЗЫВАЕТСЯ ТРЕЗВЫМ
Dialogue: 0,0:06:47.18,0:06:49.09,Caption,,0,0,0,,АНАЛИЗОМ. ПОТОМ ОН НАПОМИНАЕТ,
Dialogue: 0,0:06:49.34,0:06:51.50,Caption,,0,0,0,,ЧТО НАТО БУДЕТ ЗАЩИЩАТЬ КАЖДЫЙ ДЮЙМ
Dialogue: 0,0:06:51.50,0:06:54.98,Caption,,0,0,0,,СВОЕЙ ТЕРРИТОРИИ, НАЗЫВАЕТ ВСТУПЛЕНИЕ ФИНЛЯНДИИ И ШВЕЦИИ
Dialogue: 0,0:06:54.98,0:06:57.60,Caption,,0,0,0,,ЧУДОМ, ОБЕЩАЕТ ПРОДОЛЖАТЬ ПОДДЕРЖКУ КИЕВА
Dialogue: 0,0:06:57.60,0:06:59.81,Caption,,0,0,0,,ЗИМОЙ И В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ,
Dialogue: 0,0:07:00.13,0:07:02.00,Caption,,0,0,0,,А ПОСЛЕ ЭТОГО ПРИГЛАШАЕТ ПУТИНА ЗА
Dialogue: 0,0:07:02.00,0:07:04.93,Caption,,0,0,0,,СТОЛ ПЕРЕГОВОРОВ. И ВСЁ ЭТО НА ФОНЕ СЛОВ ПЕСКОВА О
Dialogue: 0,0:07:04.93,0:07:07.53,Caption,,0,0,0,,ТОМ, ЧТО МОСКВА САМА СОБИРАЕТСЯ ВЫЙТИ НА
Dialogue: 0,0:07:07.53,0:07:09.57,Caption,,0,0,0,,КОНТАКТ С ЕВРОПЕЙЦАМИ И ВЫЯСНИТЬ,
Dialogue: 0,0:07:09.81,0:07:11.97,Caption,,0,0,0,,ГОТОВЫ ЛИ ОНИ ВООБЩЕ ПОМОГАТЬ МИРНОМУ
Dialogue: 0,0:07:11.97,0:07:15.55,Caption,,0,0,0,,УРЕГУЛИРОВАНИЮ. ВОТ ЭТО Я ПОНИМАЮ ПОСЛЕДОВАТЕЛЬНОСТЬ.
Dialogue: 0,0:07:15.55,0:07:19.56,Caption,,0,0,0,,СНАЧАЛА ОБЪЯСНИТЬ ЧЕЛОВЕКУ, ЧТО МИР ВОЗМОЖЕН ТОЛЬКО ПРОТИВ НЕГО.
Dialogue: 0,0:07:19.56,0:07:21.33,Caption,,0,0,0,,ПОТОМ ПОЗВАТЬ ЕГО ДОГОВАРИВАТЬСЯ.
Dialogue: 0,0:07:23.60,0:07:26.36,Caption,,0,0,0,,И МЕРЦ, И ВАДЕФУЛЬ ТАК СМАКУЮТ РАЗГОВОРЫ О
Dialogue: 0,0:07:26.36,0:07:30.11,Caption,,0,0,0,,ВОЗМОЖНОМ КОНФЛИКТЕ, СЛОВНО УЖЕ ЗАРАНЕЕ УВЕРЕНЫ В ПОБЕДЕ.
Dialogue: 0,0:07:30.11,0:07:32.08,Caption,,0,0,0,,РЕБЯТА, А ВЫ ВООБЩЕ ДОПУСКАЕТЕ,
Dialogue: 0,0:07:32.27,0:07:35.17,Caption,,0,0,0,,ЧТО МОЖЕТЕ ПРОИГРАТЬ? ИЛИ ЭТОТ ВАРИАНТ ТОЖЕ УДАЛИЛИ ИЗ
Dialogue: 0,0:07:35.17,0:07:37.84,Caption,,0,0,0,,ПРОГРАММЫ? ГЕРМАНИЯ УЖЕ ПРОХОДИЛА ПЕРИОД,
Dialogue: 0,0:07:38.08,0:07:39.84,Caption,,0,0,0,,КОГДА ЕЁ РУКОВОДСТВО БЫЛО УВЕРЕНО,
Dialogue: 0,0:07:39.93,0:07:42.14,Caption,,0,0,0,,ЧТО ОБЯЗАТЕЛЬНО ПОБЕДИТ. ВСПОМНИТЕ
Dialogue: 0,0:07:42.14,0:07:44.51,Caption,,0,0,0,,ГИТЛЕРА И РИББЕНТРОПА. ЧЕМ ДЛЯ НИХ ВСЁ
Dialogue: 0,0:07:44.51,0:07:47.84,Caption,,0,0,0,,ЗАКОНЧИЛОСЬ? ФРИДРИХ, ТЕБЕ ХОЧЕТСЯ ПОВТОРИТЬ ЭТОТ ОПЫТ?
Dialogue: 0,0:07:48.12,0:07:49.94,Caption,,0,0,0,,ИЛИ ТАМ ИСТОРИЧЕСКИЕ УРОКИ ХРАНЯТ
Dialogue: 0,0:07:49.94,0:07:52.40,Caption,,0,0,0,,ИСКЛЮЧИТЕЛЬНО ДЛЯ ЭКСКУРСИЙ? ПОДПИШИТЕСЬ,
Dialogue: 0,0:07:52.48,0:07:54.46,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО
Dialogue: 0,0:07:54.46,0:07:57.09,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ САМАЯ НЕПРИЯТНАЯ ЧАСТЬ.
Dialogue: 0,0:07:57.09,0:08:01.59,Caption,,0,0,0,,КОГДА ПОЛИТИКИ ГОВОРЯТ МНОГО, ЭТО ОДНО. КОГДА ЛЮДИ РЯДОМ С ПОЛИТИКОЙ
Dialogue: 0,0:08:01.59,0:08:04.80,Caption,,0,0,0,,НАЧИНАЮТ ПРОГОВАРИВАТЬ ТО, ЧТО ОБЫЧНО ОБСУЖДАЮТ ТИШЕ,
Dialogue: 0,0:08:05.20,0:08:07.23,Caption,,0,0,0,,ЭТО УЖЕ СОВСЕМ ДРУГАЯ ИСТОРИЯ. ЭНН
Dialogue: 0,0:08:07.23,0:08:09.12,Caption,,0,0,0,,ЭППЛБАУМ ОТВЕЧАЕТ НА ВОПРОС О ТОМ,
Dialogue: 0,0:08:09.28,0:08:11.13,Caption,,0,0,0,,ОБСУЖДАЕТСЯ ЛИ В ЕВРОПЕ ДАЛЬНЕЙШАЯ
Dialogue: 0,0:08:11.13,0:08:14.00,Caption,,0,0,0,,ЭСКАЛАЦИЯ ПРОТИВ РОССИИ. В САМОМ ВОПРОСЕ РОССИЯ
Dialogue: 0,0:08:14.00,0:08:16.32,Caption,,0,0,0,,НАЗЫВАЕТСЯ ВОЕННОЙ УЯЗВИМОЙ СТОРОНОЙ,
Dialogue: 0,0:08:16.64,0:08:19.20,Caption,,0,0,0,,А ДАЛЬШЕ ПЕРЕЧИСЛЯЮТСЯ ВПОЛНЕ КОНКРЕТНЫЕ СЦЕНАРИИ
Dialogue: 0,0:08:19.20,0:08:21.60,Caption,,0,0,0,,РАКЕТЫ ПО ПОЛЬШЕ, БЕСПИЛОТНИКИ,
Dialogue: 0,0:08:21.76,0:08:24.26,Caption,,0,0,0,,АТАКИ НА АЭРОПОРТЫ В ГЕРМАНИИ. И ОТВЕТ
Dialogue: 0,0:08:24.26,0:08:28.32,Caption,,0,0,0,,У НЕЁ ОЧЕНЬ ЛЮБОПЫТНЫЙ. ДА, ОБСУЖДАЕТСЯ. В ОСНОВНОМ В ЧАСТНОМ
Dialogue: 0,0:08:28.32,0:08:31.40,Caption,,0,0,0,,ПОРЯДКЕ. ЕСТЬ СЦЕНАРНОЕ ПЛАНИРОВАНИЕ. ОБСУЖДАЮТСЯ
Dialogue: 0,0:08:31.40,0:08:34.72,Caption,,0,0,0,,РАКЕТНЫЕ УДАРЫ ПО ГОРОДАМ, ТРАНСГРАНИЧНЫЕ НАПАДЕНИЯ.
Dialogue: 0,0:08:37.00,0:08:38.92,Caption,,0,0,0,,В ПРИМЕР ОНА ПРИВОДИТ И ЗАКРЫТИЕ
Dialogue: 0,0:08:38.92,0:08:41.72,Caption,,0,0,0,,ЭСТОНИЕЙ ГРАНИЦЫ С РОССИЕЙ. ОНА ПРЯМО ГОВОРИТ,
Dialogue: 0,0:08:41.96,0:08:43.61,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКАЯ ОБЩЕСТВЕННОСТЬ К
Dialogue: 0,0:08:43.61,0:08:45.74,Caption,,0,0,0,,ПРЯМОМУ СТОЛКНОВЕНИЮ НЕ ГОТОВА И ИДЕЯ
Dialogue: 0,0:08:45.74,0:08:49.19,Caption,,0,0,0,,ВСТУПЛЕНИЯ В ВОЙНУ КРАЙНЕ НЕПОПУЛЯРНА. А ПОТОМ ЗВУЧИТ
Dialogue: 0,0:08:49.19,0:08:52.52,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ. ЭППЛБАУМ ГОВОРИТ "К СОЖАЛЕНИЮ",
Dialogue: 0,0:08:52.76,0:08:55.49,Caption,,0,0,0,,КОГДА ОБЪЯСНЯЕТ, ЧТО ДЛЯ ИЗМЕНЕНИЯ ОБЩЕСТВЕННОГО
Dialogue: 0,0:08:55.49,0:08:57.80,Caption,,0,0,0,,НАСТРОЕНИЯ ДОЛЖНО ПРОИЗОЙТИ НЕЧТО ТАКОЕ,
Dialogue: 0,0:08:58.04,0:08:59.75,Caption,,0,0,0,,ЧТО УБЕДИТ ЛЮДЕЙ В НЕОБХОДИМОСТИ
Dialogue: 0,0:08:59.75,0:09:02.45,Caption,,0,0,0,,ДРУГИХ ДЕЙСТВИЙ. ОНА РАССУЖДАЕТ О РАКЕТЕ,
Dialogue: 0,0:09:02.60,0:09:05.33,Caption,,0,0,0,,ПОПАВШЕЙ В ЦЕНТР ГОРОДА, О МАССОВЫХ ЖЕРТВАХ,
Dialogue: 0,0:09:05.48,0:09:07.39,Caption,,0,0,0,,О КРУПНОМ ИНЦИДЕНТЕ. И ОТДЕЛЬНО
Dialogue: 0,0:09:07.39,0:09:09.96,Caption,,0,0,0,,ГОВОРИТ, ЧТО РУССКИЕ, ПО ЕЁ ОЦЕНКЕ,
Dialogue: 0,0:09:10.12,0:09:12.15,Caption,,0,0,0,,СТАРАЮТСЯ НЕ ДОВОДИТЬ СИТУАЦИЮ ДО
Dialogue: 0,0:09:12.15,0:09:15.72,Caption,,0,0,0,,ТАКОГО УРОВНЯ. ШЕРШЕ ЛЯ ФАМ. ИЩИТЕ ЖЕНЩИНУ. НЕТ,
Dialogue: 0,0:09:15.96,0:09:18.12,Caption,,0,0,0,,НУ ПРАВДА. ЖЕНЩИНА ЧТО ТО УСЛЫШАЛА,
Dialogue: 0,0:09:18.26,0:09:21.96,Caption,,0,0,0,,ЧТО ТО ЗНАЕТ, ЧТО ТО ОБСУЖДАЕТСЯ РЯДОМ. МУЖ У НЕЁ,
Dialogue: 0,0:09:22.12,0:09:24.62,Caption,,0,0,0,,НА СЕКУНДОЧКУ, ГЛАВА ПОЛЬСКОГО МИНИСТЕРСТВА
Dialogue: 0,0:09:24.62,0:09:27.41,Caption,,0,0,0,,ИНОСТРАННЫХ ДЕЛ РАДОСЛАВ СИКОРСКИЙ. И ТУТ ВДРУГ
Dialogue: 0,0:09:27.41,0:09:30.21,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО В ЧАСТНОМ ПОРЯДКЕ РАЗГОВОРЫ ИДУТ
Dialogue: 0,0:09:30.21,0:09:33.08,Caption,,0,0,0,,НАМНОГО ДАЛЬШЕ, ЧЕМ ОФИЦИАЛЬНЫЕ УЛЫБКИ ПЕРЕД КАМЕРАМИ.
Dialogue: 0,0:09:33.64,0:09:35.68,Caption,,0,0,0,,ВОТ ПОЭТОМУ ФРАЗА "ОНА ПРОБОЛТАЛАСЬ"
Dialogue: 0,0:09:35.68,0:09:38.51,Caption,,0,0,0,,ТУТ ВЫГЛЯДИТ СОВСЕМ НЕ ЛИШНЕЙ. ПОТОМУ ЧТО ВСЁ ЭТО
Dialogue: 0,0:09:38.51,0:09:40.45,Caption,,0,0,0,,УЖЕ НАСТОЛЬКО РАСПИРАЕТ ИЗНУТРИ,
Dialogue: 0,0:09:40.71,0:09:43.07,Caption,,0,0,0,,ЧТО НАЧИНАЕТ ВЫЛЕЗАТЬ НАРУЖУ. РАНЬШЕ
Dialogue: 0,0:09:43.07,0:09:45.64,Caption,,0,0,0,,ТАКИЕ ВЕЩИ СТАРАЛИСЬ БЫ ЗАВЕРНУТЬ В ДЕСЯТЬ СЛОЁВ
Dialogue: 0,0:09:45.64,0:09:50.31,Caption,,0,0,0,,КРАСИВЫХ СЛОВ. А ТЕПЕРЬ УЖЕ СПОКОЙНО ОБСУЖДАЮТ,
Dialogue: 0,0:09:50.55,0:09:52.53,Caption,,0,0,0,,ЧТО ОБЩЕСТВО НЕ ГОТОВО И ЧТО ДОЛЖНО
Dialogue: 0,0:09:52.53,0:09:55.75,Caption,,0,0,0,,ПРОИЗОЙТИ НЕЧТО, СПОСОБНОЕ ЭТО ОБЩЕСТВО ПЕРЕУБЕДИТЬ.
Dialogue: 0,0:09:56.32,0:09:58.09,Caption,,0,0,0,,ЗДЕСЬ ПРЯМО НАПРАШИВАЕТСЯ ЖЁСТКАЯ
Dialogue: 0,0:09:58.09,0:10:01.05,Caption,,0,0,0,,АНАЛОГИЯ С ГЛАЙВИЦКИМ ИНЦИДЕНТОМ. ГЛАЙВИЦ ДВА
Dialogue: 0,0:10:01.05,0:10:03.87,Caption,,0,0,0,,НОЛЬ. СМЫСЛ ПРОСТОЙ КРУПНОЕ СОБЫТИЕ С ЖЕРТВАМИ
Dialogue: 0,0:10:03.87,0:10:06.84,Caption,,0,0,0,,СПОСОБНО РЕЗКО ИЗМЕНИТЬ ОТНОШЕНИЕ НАСЕЛЕНИЯ К ВОЙНЕ.
Dialogue: 0,0:10:06.84,0:10:09.25,Caption,,0,0,0,,И ВОТ ТУТ ОСОБЕННО ИНТЕРЕСНО СОПОСТАВИТЬ ЭТО СО
Dialogue: 0,0:10:09.25,0:10:12.47,Caption,,0,0,0,,СЛОВАМИ РЮТТЕ КАЖДЫЙ НОВЫЙ ИНЦИДЕНТ В ЕВРОПЕ ДОЛЖЕН
Dialogue: 0,0:10:12.47,0:10:14.79,Caption,,0,0,0,,ВЕСТИ К ЕЩЁ БОЛЬШЕЙ ПОДДЕРЖКЕ УКРАИНЫ.
Dialogue: 0,0:10:15.43,0:10:17.62,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ НЕПРИЯТНАЯ СВЯЗКА.
Dialogue: 0,0:10:17.62,0:10:19.99,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ НАСЕЛЕНИЕ ВОЕВАТЬ НЕ РВЁТСЯ.
Dialogue: 0,0:10:19.99,0:10:22.53,Caption,,0,0,0,,ПОЛИТИЧЕСКОЕ РУКОВОДСТВО ГОТОВИТСЯ К ВОЗМОЖНОМУ
Dialogue: 0,0:10:22.53,0:10:25.19,Caption,,0,0,0,,БОЛЬШОМУ КОНФЛИКТУ. ИНЦИДЕНТЫ РАССМАТРИВАЮТСЯ
Dialogue: 0,0:10:25.19,0:10:27.93,Caption,,0,0,0,,КАК ПОВОД ДЛЯ ДАЛЬНЕЙШЕГО ПОВЫШЕНИЯ СТАВОК. А
Dialogue: 0,0:10:27.93,0:10:30.47,Caption,,0,0,0,,ОБЩЕСТВЕННОЕ МНЕНИЕ ОСТАЁТСЯ ТЕМ ТОРМОЗОМ,
Dialogue: 0,0:10:30.77,0:10:33.03,Caption,,0,0,0,,КОТОРЫЙ ПОКА МЕШАЕТ ЕХАТЬ ЕЩЁ БЫСТРЕЕ.
Dialogue: 0,0:10:33.66,0:10:35.63,Caption,,0,0,0,,ЕСТЬ И ЕЩЁ ОДНА ЖЁСТКАЯ ВЕРСИЯ.
Dialogue: 0,0:10:35.63,0:10:38.25,Caption,,0,0,0,,СТОРОННИКИ ТАКОГО КУРСА РАССЧИТЫВАЮТ ПОДГОТОВИТЬ
Dialogue: 0,0:10:38.25,0:10:41.10,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ОБЩЕСТВА К БОЛЬШОМУ КОНФЛИКТУ К ДВЕ ТЫСЯЧИ
Dialogue: 0,0:10:41.10,0:10:44.55,Caption,,0,0,0,,ТРИДЦАТОМУ ГОДУ. СТОРОННИКИ ТАКОГО КУРСА ТОРОПЯТСЯ. А
Dialogue: 0,0:10:44.55,0:10:46.39,Caption,,0,0,0,,ЧЕМ БЛИЖЕ ДВЕ ТЫСЯЧИ ТРИДЦАТЫЙ,
Dialogue: 0,0:10:46.63,0:10:48.79,Caption,,0,0,0,,ТЕМ ВЫШЕ, СОГЛАСНО ЭТОЙ ВЕРСИИ,
Dialogue: 0,0:10:48.95,0:10:51.03,Caption,,0,0,0,,РИСК КРУПНОГО СОБЫТИЯ С МАССОВЫМИ
Dialogue: 0,0:10:51.03,0:10:55.72,Caption,,0,0,0,,ЖЕРТВАМИ. ПРИ ЭТОМ РОССИЯ СТАРАЕТСЯ ИЗБЕЖАТЬ
Dialogue: 0,0:10:55.72,0:10:57.38,Caption,,0,0,0,,ПРЯМОГО СТОЛКНОВЕНИЯ С ЕВРОПОЙ,
Dialogue: 0,0:10:57.62,0:10:59.78,Caption,,0,0,0,,НЕСМОТРЯ НА ПОСТАВКИ ОРУЖИЯ УКРАИНЕ,
Dialogue: 0,0:10:59.98,0:11:02.05,Caption,,0,0,0,,ПЕРЕДАЧУ РАЗВЕДДАННЫХ И ПОСТОЯННЫЕ
Dialogue: 0,0:11:02.05,0:11:03.94,Caption,,0,0,0,,ЭПИЗОДЫ ОТ БАЛТИКИ ДО ЧЁРНОГО МОРЯ.
Dialogue: 0,0:11:04.53,0:11:06.46,Caption,,0,0,0,,И ВОТ ЧТО ОСОБЕННО МЕШАЕТ СТОРОННИКАМ
Dialogue: 0,0:11:06.46,0:11:10.18,Caption,,0,0,0,,ДАЛЬНЕЙШЕЙ ЭСКАЛАЦИИ. ЛЮДИ ВОЕВАТЬ НЕ ХОТЯТ. И
Dialogue: 0,0:11:10.18,0:11:14.52,Caption,,0,0,0,,ЗНАЕТЕ, ЭТО, ПОЖАЛУЙ, ЕДИНСТВЕННАЯ НОРМАЛЬНАЯ ВЕЩЬ ВО ВСЕЙ
Dialogue: 0,0:11:14.52,0:11:18.38,Caption,,0,0,0,,ЭТОЙ ИСТОРИИ. ЛЮДИ ХОТЯТ ЖИТЬ. РАБОТАТЬ. ТОРГОВАТЬ.
Dialogue: 0,0:11:18.38,0:11:22.39,Caption,,0,0,0,,РАСТИТЬ ДЕТЕЙ. ПОКУПАТЬ ДОМА. ЕЗДИТЬ В ОТПУСК. ДЕЛАТЬ
Dialogue: 0,0:11:22.39,0:11:25.02,Caption,,0,0,0,,ОБЫЧНЫЕ ЧЕЛОВЕЧЕСКИЕ ВЕЩИ. А НЕ СИДЕТЬ С
Dialogue: 0,0:11:25.02,0:11:27.46,Caption,,0,0,0,,ПАМЯТКОЙ, ГДЕ НАПИСАНО, ЧТО ДЕЛАТЬ,
Dialogue: 0,0:11:27.62,0:11:29.30,Caption,,0,0,0,,КОГДА НАД ГОРОДОМ ПОЛЕТЯТ РАКЕТЫ.
Dialogue: 0,0:11:30.02,0:11:31.78,Caption,,0,0,0,,НО ПОЛИТИКА ПОЧЕМУ ТО ВСЁ БОЛЬШЕ
Dialogue: 0,0:11:31.78,0:11:34.76,Caption,,0,0,0,,СТРОИТСЯ ТАК, БУДТО НОРМАЛЬНАЯ ЖИЗНЬ ЭТО ВРЕМЕННАЯ
Dialogue: 0,0:11:34.76,0:11:37.83,Caption,,0,0,0,,ПАУЗА МЕЖДУ ДВУМЯ МОБИЛИЗАЦИЯМИ. И ТУТ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:11:37.83,0:11:41.14,Caption,,0,0,0,,МОЛДОВА. ПАРЛАМЕНТ РАТИФИЦИРОВАЛ СОГЛАШЕНИЕ О
Dialogue: 0,0:11:41.14,0:11:44.01,Caption,,0,0,0,,ВОЕННОМ И ТЕХНИЧЕСКОМ СОТРУДНИЧЕСТВЕ С УКРАИНОЙ.
Dialogue: 0,0:11:44.01,0:11:45.94,Caption,,0,0,0,,РЕМОНТ И МОДЕРНИЗАЦИЯ ТЕХНИКИ,
Dialogue: 0,0:11:46.15,0:11:48.26,Caption,,0,0,0,,СОВМЕСТНОЕ ПРОИЗВОДСТВО БЕСПИЛОТНИКОВ,
Dialogue: 0,0:11:48.50,0:11:51.14,Caption,,0,0,0,,ОБМЕН ТЕХНОЛОГИЯМИ, ПОДГОТОВКА ВОЕННЫХ.
Dialogue: 0,0:11:51.70,0:11:55.33,Caption,,0,0,0,,ПРЕМЬЕР ПРИ ЭТОМ ОБЪЯСНЯЕТ, ЧТО НЕЙТРАЛИТЕТ МОЛДОВЫ ВСЕМУ ЭТОМУ
Dialogue: 0,0:11:55.33,0:11:58.84,Caption,,0,0,0,,НИКАК НЕ МЕШАЕТ. НУ КОНЕЧНО. ТАКОЙ НЕЙТРАЛИТЕТ НОВОГО
Dialogue: 0,0:11:58.84,0:12:02.05,Caption,,0,0,0,,ПОКОЛЕНИЯ. ГЛАВНОЕ ПРАВИЛЬНО НАЗВАТЬ. ТАК ЧТО К
Dialogue: 0,0:12:02.05,0:12:04.18,Caption,,0,0,0,,ГРОЗНОМУ СОЮЗУ ПРИБАЛТИЙСКИХ ТИГРОВ,
Dialogue: 0,0:12:04.26,0:12:08.76,Caption,,0,0,0,,ЛИТВЫ, ЛАТВИИ И ЭСТОНИИ, ТЕПЕРЬ ПРИСОЕДИНИЛАСЬ ЕЩЁ И МОЛДОВА.
Dialogue: 0,0:12:08.76,0:12:10.74,Caption,,0,0,0,,НУ ТЕПЕРЬ ТО РОССИИ ТОЧНО КОНЕЦ.
Dialogue: 0,0:12:12.93,0:12:16.41,Caption,,0,0,0,,А ЕСЛИ БЕЗ ШУТОК, КАРТИНА ПОЛУЧАЕТСЯ СОВСЕМ НЕВЕСЁЛАЯ.
Dialogue: 0,0:12:16.41,0:12:19.20,Caption,,0,0,0,,ОДНИ НЕ ХОТЯТ ОБСУЖДАТЬ РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:12:19.20,0:12:21.57,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ДРУГИЕ ОБЪЯСНЯЮТ ГРАЖДАНАМ,
Dialogue: 0,0:12:21.89,0:12:24.01,Caption,,0,0,0,,КАК ГОТОВИТЬСЯ К ВОЙНЕ. ТРЕТЬИ УЖЕ
Dialogue: 0,0:12:24.01,0:12:26.73,Caption,,0,0,0,,РАССУЖДАЮТ, КАКОЕ СОБЫТИЕ СПОСОБНО ИЗМЕНИТЬ
Dialogue: 0,0:12:26.73,0:12:30.12,Caption,,0,0,0,,НАСТРОЕНИЕ ОБЩЕСТВА. И ПРИ ЭТОМ ВСЕ ПРОДОЛЖАЮТ ГОВОРИТЬ О
Dialogue: 0,0:12:30.12,0:12:34.29,Caption,,0,0,0,,МИРЕ. НУ И, КАК ВИДИМ, ПЕРСПЕКТИВ НА МИР НЕ ТО ЧТО МАЛО. ИХ
Dialogue: 0,0:12:34.37,0:12:35.57,Caption,,0,0,0,,НЕТ. ПРОСТО НЕТ.
