Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ДО ПЕРЕГОВОРОВ ОСТАЛОСЬ НЕСКОЛЬКО ДНЕЙ. КАЗАЛОСЬ БЫ,
Dialogue: 0,0:00:03.16,0:00:06.52,Caption,,0,0,0,,САМОЕ ВРЕМЯ ВСЕМ НЕМНОГО УСПОКОИТЬСЯ. НО НЕТ. ТУТ
Dialogue: 0,0:00:06.52,0:00:09.00,Caption,,0,0,0,,КАК РАЗ НАЧИНАЕТСЯ ДВИЖУХА. И ЧЕМ ВНИМАТЕЛЬНЕЕ
Dialogue: 0,0:00:09.08,0:00:11.80,Caption,,0,0,0,,СМОТРИШЬ, ТЕМ СИЛЬНЕЕ ХОЧЕТСЯ СПРОСИТЬ РЕБЯТА,
Dialogue: 0,0:00:12.15,0:00:13.56,Caption,,0,0,0,,А ВЫ ВООБЩЕ К ОДНОМУ И ТОМУ ЖЕ
Dialogue: 0,0:00:13.64,0:00:17.80,Caption,,0,0,0,,МИРУ ГОТОВИТЕСЬ? ПОТОМУ ЧТО ДЕСЯТОГО И ОДИННАДЦАТОГО НОЯБРЯ РОССИЯ,
Dialogue: 0,0:00:17.88,0:00:20.84,Caption,,0,0,0,,УКРАИНА И СОЕДИНЁННЫЕ ШТАТЫ ДОЛЖНЫ ВСТРЕТИТЬСЯ В АБУ
Dialogue: 0,0:00:20.92,0:00:23.80,Caption,,0,0,0,,ДАБИ. ВРОДЕ ВСЁ ПРАВИЛЬНО. ВОЙНА ИДЁТ ПОЧТИ ПЯТЬ
Dialogue: 0,0:00:23.80,0:00:26.76,Caption,,0,0,0,,ЛЕТ. ЛЮДИ УСТАЛИ. ДЕНЬГИ ЛЕТЯТ В ТОПКУ. ВСЕ
Dialogue: 0,0:00:26.76,0:00:29.88,Caption,,0,0,0,,ГОВОРЯТ, ЧТО НАДО ДОГОВАРИВАТЬСЯ. НУ ТАК САДИТЕСЬ И
Dialogue: 0,0:00:29.88,0:00:32.44,Caption,,0,0,0,,ДОГОВАРИВАЙТЕСЬ. ТОЛЬКО ПОКА В АБУ ДАБИ ГОТОВЯТ
Dialogue: 0,0:00:32.44,0:00:37.64,Caption,,0,0,0,,СТОЛ, В ЕВРОПЕ УЖЕ РЕШАЮТ, ЧТО НА ЭТОМ СТОЛЕ ДОЛЖНО ЛЕЖАТЬ. ЧЕТВЁРТОГО НОЯБРЯ
Dialogue: 0,0:00:37.72,0:00:40.36,Caption,,0,0,0,,ЕВРОКОМИССИЯ СОБИРАЕТ ПРЕДСТАВИТЕЛЕЙ УКРАИНЫ,
Dialogue: 0,0:00:40.51,0:00:43.96,Caption,,0,0,0,,США, ФРАНЦИИ, ГЕРМАНИИ, БРИТАНИИ,
Dialogue: 0,0:00:44.05,0:00:47.16,Caption,,0,0,0,,НАТО И ВСЕМИРНОГО БАНКА. ОБСУЖДАЮТ ГАРАНТИИ
Dialogue: 0,0:00:47.16,0:00:50.12,Caption,,0,0,0,,БЕЗОПАСНОСТИ И БУДУЩУЮ КОНСТРУКЦИЮ ПОСЛЕ ВОЙНЫ.
Dialogue: 0,0:00:50.76,0:00:53.40,Caption,,0,0,0,,ПЯТОГО НОЯБРЯ РАЗГОВОР ПРОДОЛЖИТСЯ УЖЕ В НАТО.
Dialogue: 0,0:00:53.58,0:00:58.92,Caption,,0,0,0,,ФРАНЦИЯ, ГЕРМАНИЯ, БРИТАНИЯ И СОЕДИНЁННЫЕ ШТАТЫ СНОВА БУДУТ РЕШАТЬ,
Dialogue: 0,0:00:59.17,0:01:02.44,Caption,,0,0,0,,КАК ДОЛЖЕН ВЫГЛЯДЕТЬ УСТОЙЧИВЫЙ МИР. ОЧЕНЬ УДОБНО.
Dialogue: 0,0:01:02.68,0:01:05.56,Caption,,0,0,0,,САМ МИР ЕЩЁ НЕ ПОДПИСАЛИ. РОССИЯ С УКРАИНОЙ
Dialogue: 0,0:01:05.64,0:01:08.04,Caption,,0,0,0,,ЕЩЁ ДАЖЕ НЕ СЕЛИ ЗА СТОЛ. ЗАТО МЕБЕЛЬ
Dialogue: 0,0:01:08.20,0:01:11.08,Caption,,0,0,0,,УЖЕ РАССТАВЛЯЮТ. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ
Dialogue: 0,0:01:11.08,0:01:13.64,Caption,,0,0,0,,БЕЗ ДИПЛОМАТИЧЕСКОГО ТУМАНА, ПОДПИШИТЕСЬ.
Dialogue: 0,0:01:15.93,0:01:20.33,Caption,,0,0,0,,ОСОБЕННО ИНТЕРЕСНО, ЧТО ИМЕННО СЕЙЧАС НАЗЫВАЕТСЯ ГАРАНТИЕЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:01:20.65,0:01:23.61,Caption,,0,0,0,,ТУТ БРИТАНЦЫ ВООБЩЕ МОЛОДЦЫ. ВСЁ ВЫЛОЖИЛИ НА СТОЛ
Dialogue: 0,0:01:23.61,0:01:26.49,Caption,,0,0,0,,САМИ. БРИТАНСКОЕ МИНИСТЕРСТВО ОБОРОНЫ ТРЕТЬЕГО
Dialogue: 0,0:01:26.57,0:01:28.73,Caption,,0,0,0,,НОЯБРЯ ОПУБЛИКОВАЛО ОТДЕЛЬНОЕ ОПИСАНИЕ
Dialogue: 0,0:01:28.73,0:01:31.61,Caption,,0,0,0,,МНОГОНАЦИОНАЛЬНЫХ СИЛ ДЛЯ УКРАИНЫ. НАЗЫВАЕТСЯ ВСЁ
Dialogue: 0,0:01:31.61,0:01:34.01,Caption,,0,0,0,,СОЛИДНО. MULTINATIONAL FORCE UKRAINE.
Dialogue: 0,0:01:34.30,0:01:37.21,Caption,,0,0,0,,МНОГОНАЦИОНАЛЬНЫЕ СИЛЫ ДЛЯ УКРАИНЫ. ЭТО ВОЕННЫЙ
Dialogue: 0,0:01:37.29,0:01:40.09,Caption,,0,0,0,,КОМПОНЕНТ КОАЛИЦИИ ЖЕЛАЮЩИХ. В САМОЙ КОАЛИЦИИ
Dialogue: 0,0:01:40.17,0:01:43.13,Caption,,0,0,0,,ТРИДЦАТЬ ПЯТЬ ГОСУДАРСТВ. ДВАДЦАТЬ ЧЕТЫРЕ СТРАНЫ УЖЕ
Dialogue: 0,0:01:43.21,0:01:45.45,Caption,,0,0,0,,ДАЛИ ВОЕННЫЕ ОБЯЗАТЕЛЬСТВА ДЛЯ БУДУЩЕЙ СИЛЫ.
Dialogue: 0,0:01:45.77,0:01:48.49,Caption,,0,0,0,,КОМАНДУЮТ БРИТАНЦЫ И ФРАНЦУЗЫ. ШТАБ ЕСТЬ.
Dialogue: 0,0:01:48.73,0:01:52.01,Caption,,0,0,0,,КОМАНДУЮЩИЙ ЕСТЬ. ПЛАНИРОВАНИЕ ИДЁТ ПОСТОЯННО. ТО
Dialogue: 0,0:01:52.09,0:01:56.09,Caption,,0,0,0,,ЕСТЬ ЭТО УЖЕ НЕ КЛУБ ЛЮДЕЙ, КОТОРЫЕ РАЗ В МЕСЯЦ ПРИЕЗЖАЮТ В КРАСИВЫЙ ЗАЛ,
Dialogue: 0,0:01:56.19,0:01:59.05,Caption,,0,0,0,,ФОТОГРАФИРУЮТСЯ И ОБЕЩАЮТ ПОДУМАТЬ. БРИТАНСКИЙ
Dialogue: 0,0:01:59.05,0:02:01.85,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ ТАК И СКАЗАЛ ЭТО НЕ ГИПОТЕТИЧЕСКИЙ
Dialogue: 0,0:02:01.85,0:02:04.73,Caption,,0,0,0,,ПЛАН. ЭТО РЕАЛЬНАЯ СИЛА. ВОТ ТЕПЕРЬ СТАНОВИТСЯ
Dialogue: 0,0:02:04.73,0:02:07.45,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО ЗАДАЧА ЭТОЙ СИЛЫ НЕ ХОДИТЬ
Dialogue: 0,0:02:07.53,0:02:10.17,Caption,,0,0,0,,МЕЖДУ ДВУМЯ АРМИЯМИ С БЕЛОЙ ТРЯПОЧКОЙ И СВИСТКОМ.
Dialogue: 0,0:02:10.51,0:02:13.13,Caption,,0,0,0,,БРИТАНСКОЕ МИНОБОРОНЫ ОТДЕЛЬНО ПОДЧЁРКИВАЕТ ЭТО НЕ
Dialogue: 0,0:02:13.13,0:02:16.17,Caption,,0,0,0,,МИРОТВОРЦЫ. И НЕ НАБЛЮДАТЕЛИ ЗА ПРЕКРАЩЕНИЕМ ОГНЯ.
Dialogue: 0,0:02:16.32,0:02:18.73,Caption,,0,0,0,,ВОТ ТАК. КОГДА КТО ТО НАРУШИТ ДОГОВОР,
Dialogue: 0,0:02:19.05,0:02:20.97,Caption,,0,0,0,,ЭТИ РЕБЯТА НЕ ДОЛЖНЫ СИДЕТЬ С БЛОКНОТОМ И
Dialogue: 0,0:02:20.97,0:02:23.13,Caption,,0,0,0,,ПИСАТЬ НАРУШЕНИЕ НОМЕР СТО ДВАДЦАТЬ СЕМЬ,
Dialogue: 0,0:02:23.37,0:02:26.25,Caption,,0,0,0,,ВРЕМЯ ОДИННАДЦАТЬ СОРОК ПЯТЬ. У НИХ ДРУГАЯ РАБОТА.
Dialogue: 0,0:02:28.52,0:02:31.24,Caption,,0,0,0,,ОНИ ДОЛЖНЫ ВОССТАНАВЛИВАТЬ И УСИЛИВАТЬ УКРАИНСКИЕ
Dialogue: 0,0:02:31.24,0:02:33.80,Caption,,0,0,0,,ВООРУЖЁННЫЕ СИЛЫ. ПОМОГАТЬ С БЕЗОПАСНОСТЬЮ
Dialogue: 0,0:02:33.80,0:02:36.76,Caption,,0,0,0,,УКРАИНСКОГО НЕБА И МОРЯ. ПОДДЕРЖИВАТЬ УКРАИНУ В
Dialogue: 0,0:02:36.84,0:02:40.92,Caption,,0,0,0,,ТАКОМ СОСТОЯНИИ, ЧТОБЫ ОНА МОГЛА СДЕРЖИВАТЬ НОВОЕ НАПАДЕНИЕ. ЭТО
Dialogue: 0,0:02:40.92,0:02:44.04,Caption,,0,0,0,,НАЗЫВАЕТСЯ ГАРАНТИЯ БЕЗОПАСНОСТИ УКРАИНЫ. И ЗДЕСЬ
Dialogue: 0,0:02:44.12,0:02:48.84,Caption,,0,0,0,,ВСЁ ПОНЯТНО. УКРАИНА ХОЧЕТ, ЧТОБЫ ПОСЛЕ ОКОНЧАНИЯ ВОЙНЫ РЯДОМ СТОЯЛИ СИЛЬНЫЕ
Dialogue: 0,0:02:48.92,0:02:51.48,Caption,,0,0,0,,ЗАПАДНЫЕ ГОСУДАРСТВА И ЧТОБЫ РОССИЯ ПОНИМАЛА ВТОРОЙ
Dialogue: 0,0:02:51.56,0:02:54.76,Caption,,0,0,0,,РАЗ ПРОСТО ТАК ЗАЙТИ НЕ ПОЛУЧИТСЯ. ЛОГИКА ЕСТЬ.
Dialogue: 0,0:02:55.12,0:02:57.32,Caption,,0,0,0,,ТОЛЬКО У ЭТОЙ ЛОГИКИ ЕСТЬ МАЛЕНЬКАЯ ПРОБЛЕМА
Dialogue: 0,0:02:57.32,0:03:00.44,Caption,,0,0,0,,РАЗМЕРОМ ПРИМЕРНО СО ВСЮ ПРЕДЫДУЩУЮ ВОЙНУ. МОСКВА
Dialogue: 0,0:03:00.44,0:03:04.52,Caption,,0,0,0,,ГОДАМИ ГОВОРИЛА, ЧТО ЗАПАДНОЕ ВОЕННОЕ ПРИСУТСТВИЕ НА УКРАИНЕ ДЛЯ НЕЁ
Dialogue: 0,0:03:04.60,0:03:07.72,Caption,,0,0,0,,И ЕСТЬ УГРОЗА БЕЗОПАСНОСТИ. НЕ ВЧЕРА ПРИДУМАЛА. НЕ
Dialogue: 0,0:03:07.72,0:03:10.60,Caption,,0,0,0,,ПОСЛЕ ОБЕДА ТРЕТЬЕГО НОЯБРЯ. ОБ ЭТОМ СПОРИЛИ ЕЩЁ
Dialogue: 0,0:03:10.60,0:03:13.24,Caption,,0,0,0,,ДО ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА. В
Dialogue: 0,0:03:13.32,0:03:15.80,Caption,,0,0,0,,ДЕКАБРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО РОССИЯ ПЕРЕДАЛА
Dialogue: 0,0:03:15.80,0:03:18.44,Caption,,0,0,0,,СОЕДИНЁННЫМ ШТАТАМ И НАТО ПРОЕКТЫ СОГЛАШЕНИЙ ПО
Dialogue: 0,0:03:18.44,0:03:22.20,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТАМ БЫЛИ НАТО, ВОЕННАЯ ИНФРАСТРУКТУРА,
Dialogue: 0,0:03:22.36,0:03:28.60,Caption,,0,0,0,,РАЗМЕЩЕНИЕ СИЛ, ВООРУЖЕНИЕ, ОГРАНИЧЕНИЯ. ПОТОМ НАЧАЛАСЬ ВОЙНА. ПРОШЛО ПОЧТИ ПЯТЬ
Dialogue: 0,0:03:28.68,0:03:31.32,Caption,,0,0,0,,ЛЕТ. И ТЕПЕРЬ У НАС ВЕЛИКОЛЕПНАЯ ИДЕЯ ДЛЯ
Dialogue: 0,0:03:31.32,0:03:34.20,Caption,,0,0,0,,ОКОНЧАНИЯ ЭТОЙ ВОЙНЫ. БЕРЁМ ОДИН ИЗ ГЛАВНЫХ СТАРЫХ
Dialogue: 0,0:03:34.20,0:03:37.24,Caption,,0,0,0,,ПРЕДМЕТОВ СПОРА И ОБЪЯВЛЯЕМ ЕГО ЧАСТЬЮ БУДУЩЕГО
Dialogue: 0,0:03:37.24,0:03:39.32,Caption,,0,0,0,,МИРНОГО УСТРОЙСТВА. ПОДПИШИТЕСЬ,
Dialogue: 0,0:03:39.45,0:03:44.01,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ДАЛЬШЕ РАЗБЕРЁМСЯ,
Dialogue: 0,0:03:44.18,0:03:46.41,Caption,,0,0,0,,ПОЧЕМУ ВОКРУГ ЗАПАДНОГО КОНТИНГЕНТА СТОЛЬКО
Dialogue: 0,0:03:46.41,0:03:50.25,Caption,,0,0,0,,ПРОТИВОРЕЧИЙ. РЕБЯТА, ВЫ ВООБЩЕ ГДЕ БЫЛИ ВСЁ ЭТО ВРЕМЯ?
Dialogue: 0,0:03:50.48,0:03:52.89,Caption,,0,0,0,,ВОТ СЕРЬЁЗНО. ВЫ ПЯТЬ ЛЕТ ОБСУЖДАЛИ,
Dialogue: 0,0:03:53.07,0:03:55.77,Caption,,0,0,0,,ПОЧЕМУ МОСКВА НЕ ХОЧЕТ ЗАПАДНЫЕ ВОЙСКА НА УКРАИНЕ.
Dialogue: 0,0:03:56.09,0:03:58.73,Caption,,0,0,0,,ТЕПЕРЬ РЕШИЛИ ЗАКОНЧИТЬ ВОЙНУ ЗАПАДНЫМИ ВОЙСКАМИ НА
Dialogue: 0,0:03:58.73,0:04:02.09,Caption,,0,0,0,,УКРАИНЕ. СИЛЬНЫЙ ХОД. ЭТО ПРИМЕРНО КАК ТУШИТЬ ПОЖАР
Dialogue: 0,0:04:02.09,0:04:05.05,Caption,,0,0,0,,БЕНЗИНОМ, ТОЛЬКО НА КАНИСТРЕ КРУПНО НАПИСАТЬ СРЕДСТВО
Dialogue: 0,0:04:05.05,0:04:07.77,Caption,,0,0,0,,ПРОТИВОПОЖАРНОЙ БЕЗОПАСНОСТИ. ПРИЧЁМ ЗДЕСЬ СЕЙЧАС
Dialogue: 0,0:04:07.77,0:04:10.49,Caption,,0,0,0,,НАЧНЁТСЯ ЛЮБИМАЯ ДИПЛОМАТИЧЕСКАЯ ИГРА СО СЛОВАМИ.
Dialogue: 0,0:04:10.80,0:04:14.01,Caption,,0,0,0,,НАМ СКАЖУТ ЭТО НЕ НАТО. ПРАВИЛЬНО. БРИТАНСКОЕ
Dialogue: 0,0:04:14.09,0:04:18.25,Caption,,0,0,0,,МИНОБОРОНЫ ПРЯМО ПИШЕТ, ЧТО MNF U НЕ СВЯЗАНА С НАТО. НА
Dialogue: 0,0:04:18.25,0:04:20.89,Caption,,0,0,0,,БУМАГЕ ВСЁ АККУРАТНО. ТОЛЬКО ДЕВЯТОГО НОЯБРЯ В
Dialogue: 0,0:04:20.97,0:04:23.69,Caption,,0,0,0,,ПОЛЬШЕ НАЧИНАЮТСЯ ПЕРВЫЕ КРУПНЫЕ УЧЕНИЯ ЭТОЙ СИЛЫ.
Dialogue: 0,0:04:24.02,0:04:26.97,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ВОСЕМЬСОТ ВОЕННОСЛУЖАЩИХ. БРИТАНИЯ И
Dialogue: 0,0:04:26.97,0:04:29.85,Caption,,0,0,0,,ФРАНЦИЯ КОМАНДУЮТ. БЕЛЬГИЯ, ЭСТОНИЯ,
Dialogue: 0,0:04:29.93,0:04:32.57,Caption,,0,0,0,,ГЕРМАНИЯ, ЛИТВА, НИДЕРЛАНДЫ,
Dialogue: 0,0:04:32.65,0:04:38.49,Caption,,0,0,0,,ПОЛЬША, ИСПАНИЯ, ШВЕЦИЯ, ТУРЦИЯ И БРИТАНИЯ. ВСЕ ПЕРЕЧИСЛЕННЫЕ СТРАНЫ,
Dialogue: 0,0:04:38.58,0:04:42.97,Caption,,0,0,0,,УЧАСТВУЮЩИЕ В УЧЕНИЯХ, ВХОДЯТ В НАТО. НО ОПЕРАЦИЯ НЕ НАТО. НУ
Dialogue: 0,0:04:42.97,0:04:46.33,Caption,,0,0,0,,ХОРОШО. СНЯЛИ ШИЛЬДИК С МАШИНЫ. ДВИГАТЕЛЬ ОТ ЭТОГО
Dialogue: 0,0:04:46.41,0:04:49.53,Caption,,0,0,0,,ДРУГИМ СТАЛ? БРИТАНСКИЙ СОЛДАТ ПЕРЕСТАЛ БЫТЬ ВОЕННОСЛУЖАЩИМ
Dialogue: 0,0:04:49.53,0:04:52.09,Caption,,0,0,0,,БРИТАНИИ? ФРАНЦУЗСКИЙ ПЕРЕСТАЛ БЫТЬ ФРАНЦУЗСКИМ?
Dialogue: 0,0:04:52.30,0:04:54.41,Caption,,0,0,0,,ПОЛЬСКИЙ ВОЕННЫЙ ПОСЛЕ ПЕРЕСЕЧЕНИЯ УКРАИНСКОЙ
Dialogue: 0,0:04:54.41,0:04:56.81,Caption,,0,0,0,,ГРАНИЦЫ ВНЕЗАПНО УВОЛЬНЯЕТСЯ ИЗ ПОЛЬСКОЙ АРМИИ?
Dialogue: 0,0:04:56.94,0:05:02.28,Caption,,0,0,0,,НЕТ. ЭТО РЕГУЛЯРНЫЕ ВООРУЖЁННЫЕ СИЛЫ ГОСУДАРСТВ НАТО,
Dialogue: 0,0:05:02.52,0:05:04.84,Caption,,0,0,0,,ПРОСТО ДЕЙСТВУЮЩИЕ НЕ ПОД КОМАНДОВАНИЕМ САМОГО
Dialogue: 0,0:05:04.84,0:05:08.52,Caption,,0,0,0,,АЛЬЯНСА. ДЛЯ ЮРИСТА РАЗНИЦА ВАЖНАЯ. ДЛЯ РАКЕТЫ,
Dialogue: 0,0:05:08.62,0:05:10.28,Caption,,0,0,0,,КОТОРАЯ ЛЕТИТ В ПОДРАЗДЕЛЕНИЕ,
Dialogue: 0,0:05:10.36,0:05:13.96,Caption,,0,0,0,,БОЮСЬ, ЧУТЬ МЕНЬШЕ. ТЕМ БОЛЕЕ БУДУЩАЯ СИЛА ВОВСЕ НЕ
Dialogue: 0,0:05:13.96,0:05:16.84,Caption,,0,0,0,,ДЕКОРАТИВНАЯ. УЧЕНИЯ С ДЕВЯТОГО ПО ДВАДЦАТЬ ВТОРОЕ
Dialogue: 0,0:05:16.92,0:05:18.92,Caption,,0,0,0,,НОЯБРЯ БУДУТ ПРОВЕРЯТЬ КОМАНДОВАНИЕ,
Dialogue: 0,0:05:19.00,0:05:21.56,Caption,,0,0,0,,СВЯЗЬ, ПЕРЕБРОСКУ ЛЮДЕЙ, ТЕХНИКИ,
Dialogue: 0,0:05:21.64,0:05:24.12,Caption,,0,0,0,,СНАБЖЕНИЕ, РАБОТУ СУХОПУТНОГО,
Dialogue: 0,0:05:24.20,0:05:27.40,Caption,,0,0,0,,ВОЗДУШНОГО И МОРСКОГО КОМПОНЕНТОВ. ТРИСТА БРИТАНСКИХ
Dialogue: 0,0:05:27.40,0:05:30.36,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. ИСТРЕБИТЕЛИ TYPHOON. САМОЛЁТ
Dialogue: 0,0:05:30.36,0:05:33.32,Caption,,0,0,0,,ЗАПРАВЩИК VOYAGER. ТУРЕЦКИЕ СИЛЫ РАЗВОРАЧИВАЮТ
Dialogue: 0,0:05:33.32,0:05:36.20,Caption,,0,0,0,,МОРСКУЮ ЧАСТЬ. ТО ЕСТЬ ЛЮДИ ВСЕРЬЁЗ ТРЕНИРУЮТСЯ,
Dialogue: 0,0:05:36.35,0:05:39.32,Caption,,0,0,0,,КАК ЭТУ СИСТЕМУ СОБРАТЬ И ЗАСТАВИТЬ РАБОТАТЬ. И
Dialogue: 0,0:05:39.40,0:05:41.56,Caption,,0,0,0,,ЭТО ПРОИСХОДИТ БУКВАЛЬНО ЗА ДЕНЬ ДО НАЧАЛА
Dialogue: 0,0:05:41.56,0:05:46.28,Caption,,0,0,0,,ПЕРЕГОВОРОВ В АБУ ДАБИ. ДЕВЯТОГО НАЧИНАЕТСЯ ТРЕНИРОВКА. ДЕСЯТОГО НАЧИНАЮТСЯ
Dialogue: 0,0:05:46.28,0:05:49.00,Caption,,0,0,0,,ПЕРЕГОВОРЫ. КАЛЕНДАРЬ ПОЛУЧИЛСЯ КРАСИВЫЙ. В
Dialogue: 0,0:05:49.00,0:05:51.72,Caption,,0,0,0,,ПОНЕДЕЛЬНИК РЕПЕТИРУЕМ ПЕРЕБРОСКУ ВОЕННОЙ СИЛЫ. ВО
Dialogue: 0,0:05:51.72,0:05:54.92,Caption,,0,0,0,,ВТОРНИК ОБСУЖДАЕМ МИР. ГЛАВНОЕ УТРОМ ПАПКИ НЕ
Dialogue: 0,0:05:54.92,0:05:57.88,Caption,,0,0,0,,ПЕРЕПУТАТЬ. НО САМОЕ ИНТЕРЕСНОЕ ДАЖЕ НЕ ЭТО. В
Dialogue: 0,0:05:57.96,0:06:02.44,Caption,,0,0,0,,ЯНВАРЕ БРИТАНИЯ, ФРАНЦИЯ И УКРАИНА ПОДПИСАЛИ ДОКУМЕНТ О БУДУЩЕМ
Dialogue: 0,0:06:02.44,0:06:05.56,Caption,,0,0,0,,РАЗМЕЩЕНИИ ЭТИХ СИЛ. И ТАМ НАПИСАНО КУДА ПРЯМЕЕ.
Dialogue: 0,0:06:05.72,0:06:07.96,Caption,,0,0,0,,ВООРУЖЁННЫЕ ПОДРАЗДЕЛЕНИЯ БРИТАНИИ,
Dialogue: 0,0:06:08.04,0:06:11.00,Caption,,0,0,0,,ФРАНЦИИ И ДРУГИХ ГОСУДАРСТВ ДОЛЖНЫ ПОЛУЧИТЬ
Dialogue: 0,0:06:11.00,0:06:13.40,Caption,,0,0,0,,ВОЗМОЖНОСТЬ РАЗМЕЩАТЬСЯ НА ТЕРРИТОРИИ УКРАИНЫ.
Dialogue: 0,0:06:15.68,0:06:20.24,Caption,,0,0,0,,РАБОТАТЬ НА ЗЕМЛЕ, В ВОЗДУХЕ И НА МОРЕ. СОЗДАВАТЬ ВОЕННЫЕ УЗЛЫ.
Dialogue: 0,0:06:20.56,0:06:24.88,Caption,,0,0,0,,ХРАНИТЬ ТЕХНИКУ, ОРУЖИЕ И РЕЗЕРВЫ. ВОССТАНАВЛИВАТЬ УКРАИНСКИЕ
Dialogue: 0,0:06:24.88,0:06:27.76,Caption,,0,0,0,,ВООРУЖЁННЫЕ СИЛЫ. И ПРИМЕНЯТЬ СИЛУ ДЛЯ ВЫПОЛНЕНИЯ
Dialogue: 0,0:06:27.76,0:06:31.20,Caption,,0,0,0,,СВОЕЙ МИССИИ И ЗАЩИТЫ СЕБЯ, СВОЕЙ ТЕХНИКИ,
Dialogue: 0,0:06:31.43,0:06:34.96,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ И УКРАИНЫ. ВОТ ЗДЕСЬ ЗАКАНЧИВАЕТСЯ
Dialogue: 0,0:06:35.04,0:06:38.40,Caption,,0,0,0,,КРАСИВОЕ СЛОВО ПРИСУТСТВИЕ. НАЧИНАЕТСЯ АРМИЯ. ПОТОМУ
Dialogue: 0,0:06:38.40,0:06:41.04,Caption,,0,0,0,,ЧТО Я ВСЁ ВРЕМЯ СЛЫШУ ВЫРАЖЕНИЕ ВОЕННАЯ ЦЕЛЬ.
Dialogue: 0,0:06:41.35,0:06:45.84,Caption,,0,0,0,,РОССИЯ ЗАЯВЛЯЕТ, ЧТО ТАКОЙ КОНТИНГЕНТ СТАНЕТ ЗАКОННОЙ ВОЕННОЙ ЦЕЛЬЮ.
Dialogue: 0,0:06:46.14,0:06:49.36,Caption,,0,0,0,,ЗВУЧИТ ПОЧТИ СТЕРИЛЬНО. ВОЕННАЯ ЦЕЛЬ. КАК БУДТО
Dialogue: 0,0:06:49.44,0:06:52.80,Caption,,0,0,0,,СТОИТ АНГАР. ПРИЛЕТЕЛО. АНГАРА НЕТ. ВСЕ РАЗОШЛИСЬ.
Dialogue: 0,0:06:53.12,0:06:55.28,Caption,,0,0,0,,ТОЛЬКО ЗДЕСЬ НЕ АНГАР. ЗДЕСЬ ВООРУЖЁННЫЕ
Dialogue: 0,0:06:55.28,0:06:58.08,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЯ. У НИХ ЕСТЬ КОМАНДОВАНИЕ. СВЯЗЬ.
Dialogue: 0,0:06:58.34,0:07:02.72,Caption,,0,0,0,,БОЕПРИПАСЫ. ПВО. АВИАЦИОННАЯ ПОДДЕРЖКА. СНАБЖЕНИЕ. И
Dialogue: 0,0:07:02.72,0:07:06.24,Caption,,0,0,0,,ГЛАВНОЕ, ОРУЖИЕ. ТЕПЕРЬ БЕРЁМ САМЫЙ ПРОСТОЙ СЦЕНАРИЙ.
Dialogue: 0,0:07:06.38,0:07:08.56,Caption,,0,0,0,,РОССИЙСКИЕ СИЛЫ НАНОСЯТ УДАР ПО ТАКОМУ
Dialogue: 0,0:07:08.56,0:07:11.92,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЮ. ТЕ ОТВЕЧАЮТ. РОССИЙСКИЕ ПОДРАЗДЕЛЕНИЯ
Dialogue: 0,0:07:12.00,0:07:15.44,Caption,,0,0,0,,ОТВЕЧАЮТ НА ИХ ОТВЕТ. ПОДКЛЮЧАЕТСЯ АРТИЛЛЕРИЯ. ПВО.
Dialogue: 0,0:07:15.64,0:07:19.52,Caption,,0,0,0,,АВИАЦИЯ. НУЖНЫ ПОДКРЕПЛЕНИЯ. НУЖНЫ НОВЫЕ БОЕПРИПАСЫ.
Dialogue: 0,0:07:19.61,0:07:22.72,Caption,,0,0,0,,НУЖНА РАЗВЕДКА. И ПОЗДРАВЛЯЮ. У НАС УЖЕ РОССИЙСКАЯ
Dialogue: 0,0:07:22.80,0:07:25.44,Caption,,0,0,0,,АРМИЯ ВОЮЕТ НЕ ТОЛЬКО С УКРАИНСКОЙ. ОНА ВЕДЁТ
Dialogue: 0,0:07:25.52,0:07:27.52,Caption,,0,0,0,,БОЙ С БРИТАНСКИМИ, ФРАНЦУЗСКИМИ,
Dialogue: 0,0:07:27.60,0:07:30.56,Caption,,0,0,0,,ПОЛЬСКИМИ ИЛИ ДРУГИМИ ЕВРОПЕЙСКИМИ ПОДРАЗДЕЛЕНИЯМИ.
Dialogue: 0,0:07:30.96,0:07:34.48,Caption,,0,0,0,,ВОТ ЭТО РЕАЛЬНОЕ СОДЕРЖАНИЕ ФРАЗЫ ВОЕННАЯ ЦЕЛЬ. НЕ
Dialogue: 0,0:07:34.48,0:07:40.85,Caption,,0,0,0,,КОРОБКА НА СКЛАДЕ. АРМИЯ СТРЕЛЯЕТ ПО АРМИИ. ИМЕННО ПОЭТОМУ РАЗГОВОРЫ О
Dialogue: 0,0:07:40.93,0:07:43.33,Caption,,0,0,0,,ТАКОМ КОНТИНГЕНТЕ ДЛЯ МОСКВЫ НЕ ВЫГЛЯДЯТ КАКОЙ ТО
Dialogue: 0,0:07:43.33,0:07:46.29,Caption,,0,0,0,,НЕПРИЯТНОЙ МЕЛОЧЬЮ В КОНЦЕ ДОГОВОРА. ЭТО ОДИН ИЗ
Dialogue: 0,0:07:46.29,0:07:49.17,Caption,,0,0,0,,ЦЕНТРАЛЬНЫХ ВОПРОСОВ ВСЕЙ КОНСТРУКЦИИ. ЕВРОПА
Dialogue: 0,0:07:49.25,0:07:51.09,Caption,,0,0,0,,ГОВОРИТ УКРАИНЕ НУЖНА ГАРАНТИЯ,
Dialogue: 0,0:07:51.33,0:07:54.13,Caption,,0,0,0,,ЧТО РОССИЯ БОЛЬШЕ НЕ НАПАДЁТ. МОСКВА ОТВЕЧАЕТ
Dialogue: 0,0:07:54.22,0:07:57.01,Caption,,0,0,0,,ПРИСУТСТВИЕ ЗАПАДНЫХ ВОЕННЫХ НА УКРАИНЕ САМО ПО СЕБЕ
Dialogue: 0,0:07:57.01,0:08:00.21,Caption,,0,0,0,,ЯВЛЯЕТСЯ УГРОЗОЙ РОССИИ. ОБЕ СТОРОНЫ НАЗЫВАЮТ ЭТО
Dialogue: 0,0:08:00.21,0:08:02.93,Caption,,0,0,0,,БЕЗОПАСНОСТЬЮ. ТОЛЬКО БЕЗОПАСНОСТЬ ПОЛУЧАЕТСЯ
Dialogue: 0,0:08:03.01,0:08:06.05,Caption,,0,0,0,,РАЗНАЯ. ДЛЯ КИЕВА БРИТАНСКИЙ СОЛДАТ НА УКРАИНЕ ЭТО
Dialogue: 0,0:08:06.05,0:08:09.09,Caption,,0,0,0,,ГАРАНТИЯ. ДЛЯ МОСКВЫ ТОТ ЖЕ БРИТАНСКИЙ СОЛДАТ НА
Dialogue: 0,0:08:09.09,0:08:12.69,Caption,,0,0,0,,УКРАИНЕ ЭТО УГРОЗА. ОЧЕНЬ УДОБНАЯ СИСТЕМА. ОДИН
Dialogue: 0,0:08:12.69,0:08:15.49,Caption,,0,0,0,,СМОТРИТ НА ДВЕРЬ И ВИДИТ ХОРОШИЙ ЗАМОК. ВТОРОЙ
Dialogue: 0,0:08:15.49,0:08:17.57,Caption,,0,0,0,,СМОТРИТ НА ТУ ЖЕ ДВЕРЬ И ВИДИТ ЗАРЯЖЕННЫЙ
Dialogue: 0,0:08:17.57,0:08:20.93,Caption,,0,0,0,,ПИСТОЛЕТ. А ПОТОМ ОБОИМ ПРЕДЛАГАЮТ ПОДПИСАТЬ БУМАГУ,
Dialogue: 0,0:08:21.13,0:08:23.33,Caption,,0,0,0,,ЧТО ТЕПЕРЬ В ДОМЕ СПОКОЙНО. ВОТ ЭТО И
Dialogue: 0,0:08:23.41,0:08:25.81,Caption,,0,0,0,,ПРЕДСТОИТ КАКИМ ТО ОБРАЗОМ СОБРАТЬ В АБУ ДАБИ.
Dialogue: 0,0:08:26.27,0:08:28.85,Caption,,0,0,0,,И ЗДЕСЬ ВОЗНИКАЕТ СОВСЕМ ПРОСТОЙ ВОПРОС. КТО
Dialogue: 0,0:08:28.85,0:08:31.73,Caption,,0,0,0,,УСТУПИЛ? ПОТОМУ ЧТО ВСЕ ПОСЛЕДНИЕ ДНИ ГОВОРЯТ,
Dialogue: 0,0:08:31.98,0:08:35.17,Caption,,0,0,0,,ЧТО ПЕРЕГОВОРЫ СЕРЬЁЗНЫЕ. МЕРЦ УЖЕ ТРЕБУЕТ ОТ РОССИИ
Dialogue: 0,0:08:35.17,0:08:39.01,Caption,,0,0,0,,ПОКАЗАТЬ В АБУ ДАБИ, ЧТО ОНА ДЕЙСТВИТЕЛЬНО ГОТОВА К ПРЕКРАЩЕНИЮ ОГНЯ.
Dialogue: 0,0:08:39.49,0:08:42.21,Caption,,0,0,0,,ЕВРОПА ТРЕБУЕТ СЕБЕ МЕСТО В БУДУЩЕМ СОГЛАШЕНИИ.
Dialogue: 0,0:08:42.44,0:08:45.49,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ГОВОРИТ, ЧТО УКРАИНА ГОТОВА К ДИПЛОМАТИИ,
Dialogue: 0,0:08:45.79,0:08:48.77,Caption,,0,0,0,,НО ЕЙ НУЖНЫ ГАРАНТИИ БЕЗОПАСНОСТИ. ВАШИНГТОН
Dialogue: 0,0:08:48.85,0:08:50.93,Caption,,0,0,0,,СОБИРАЕТ ВСЕХ ВОКРУГ ЭТОЙ КОНСТРУКЦИИ.
Dialogue: 0,0:08:53.11,0:08:57.60,Caption,,0,0,0,,ХОРОШО. А МОСКВА ЧТО? ТРИДЦАТОГО ОКТЯБРЯ ЛАВРОВ СКАЗАЛ ПРЯМО РОССИЙСКАЯ
Dialogue: 0,0:08:57.60,0:09:00.56,Caption,,0,0,0,,ПОЗИЦИЯ НЕ ИЗМЕНИЛАСЬ. ВЛАДИМИР МЕДИНСКИЙ СНОВА
Dialogue: 0,0:09:00.56,0:09:03.84,Caption,,0,0,0,,ВОЗГЛАВЛЯЕТ РОССИЙСКУЮ ДЕЛЕГАЦИЮ. ТОТ ЖЕ ЧЕЛОВЕК. ТА
Dialogue: 0,0:09:03.92,0:09:06.88,Caption,,0,0,0,,ЖЕ ПЕРЕГОВОРНАЯ ЛИНИЯ. НИКАКОГО ОБЪЯВЛЕНИЯ О ТОМ,
Dialogue: 0,0:09:07.04,0:09:09.76,Caption,,0,0,0,,ЧТО РОССИЯ ВДРУГ СОГЛАСИЛАСЬ НА ЗАПАДНЫЙ КОНТИНГЕНТ,
Dialogue: 0,0:09:09.84,0:09:12.80,Caption,,0,0,0,,НЕТ. НИКАКОГО ОБЪЯВЛЕНИЯ ОБ ОТКАЗЕ ОТ НЕЙТРАЛЬНОГО
Dialogue: 0,0:09:12.80,0:09:15.76,Caption,,0,0,0,,СТАТУСА УКРАИНЫ НЕТ. НИКАКОГО ЗАЯВЛЕНИЯ,
Dialogue: 0,0:09:15.99,0:09:18.08,Caption,,0,0,0,,ЧТО ВОПРОС НАТО БОЛЬШЕ МОСКВУ НЕ ВОЛНУЕТ,
Dialogue: 0,0:09:18.24,0:09:21.52,Caption,,0,0,0,,НЕТ. КИЕВ, СО СВОЕЙ СТОРОНЫ, ТОЖЕ НЕ ОБЪЯВИЛ,
Dialogue: 0,0:09:21.68,0:09:24.32,Caption,,0,0,0,,ЧТО ПРИНИМАЕТ РОССИЙСКИЕ УСЛОВИЯ. ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:09:24.40,0:09:27.68,Caption,,0,0,0,,ВОПРОС НИКУДА НЕ ДЕЛСЯ. НАТО НИКУДА НЕ ДЕЛОСЬ.
Dialogue: 0,0:09:27.84,0:09:31.44,Caption,,0,0,0,,УКРАИНСКАЯ АРМИЯ НИКУДА НЕ ДЕЛАСЬ. ЗАПАДНЫЕ ГАРАНТИИ
Dialogue: 0,0:09:31.51,0:09:34.40,Caption,,0,0,0,,НИКУДА НЕ ДЕЛИСЬ. ВОТ И ВЕСЬ ФОКУС. ВСЕ
Dialogue: 0,0:09:34.40,0:09:37.52,Caption,,0,0,0,,СОБИРАЮТСЯ НА ПЕРЕГОВОРЫ. ВСЕ ХОТЯТ МИРА. ТОЛЬКО
Dialogue: 0,0:09:37.52,0:09:40.16,Caption,,0,0,0,,КАЖДЫЙ НЕСЁТ ТУДА СВОЙ МИР. РОССИЯ НЕСЁТ
Dialogue: 0,0:09:40.16,0:09:43.36,Caption,,0,0,0,,КОНСТРУКЦИЮ, ГДЕ УКРАИНА НЕ СТАНОВИТСЯ ЗАПАДНЫМ ВОЕННЫМ
Dialogue: 0,0:09:43.36,0:09:45.84,Caption,,0,0,0,,ПЛАЦДАРМОМ. УКРАИНА НЕСЁТ КОНСТРУКЦИЮ,
Dialogue: 0,0:09:46.08,0:09:48.80,Caption,,0,0,0,,ГДЕ ПОСЛЕ СОГЛАШЕНИЯ ОНА ПОЛУЧАЕТ ТАКУЮ ЗАПАДНУЮ
Dialogue: 0,0:09:48.80,0:09:52.80,Caption,,0,0,0,,ВОЕННУЮ ПОДДЕРЖКУ, ЧТОБЫ РОССИЯ БОЛЬШЕ НЕ РИСКНУЛА НАЧАТЬ НОВУЮ ВОЙНУ.
Dialogue: 0,0:09:53.12,0:09:57.28,Caption,,0,0,0,,ЕВРОПА НЕСЁТ КОНСТРУКЦИЮ, ГДЕ ЕВРОПЕЙСКИЕ ВООРУЖЁННЫЕ СИЛЫ УЧАСТВУЮТ В
Dialogue: 0,0:09:57.28,0:10:00.16,Caption,,0,0,0,,ОБЕСПЕЧЕНИИ УКРАИНСКОЙ БЕЗОПАСНОСТИ. И ВСЁ ЭТО НАДО
Dialogue: 0,0:10:00.16,0:10:02.80,Caption,,0,0,0,,ПРЕВРАТИТЬ В ОДИН ДОКУМЕНТ. ТУТ УЖЕ НЕ ПЕРЕВОДЧИК
Dialogue: 0,0:10:02.80,0:10:09.48,Caption,,0,0,0,,НУЖЕН. ТУТ ФОКУСНИК НУЖЕН. ПРИЧЁМ ЕВРОПЕЙЦЫ ЕЩЁ И ТРЕБУЮТ УЧАСТВОВАТЬ В САМОМ
Dialogue: 0,0:10:09.48,0:10:11.72,Caption,,0,0,0,,ПРОЦЕССЕ. ФРИДРИХ МЕРЦ ГОВОРИТ,
Dialogue: 0,0:10:11.96,0:10:14.76,Caption,,0,0,0,,ЧТО ЕВРОПА ДОЛЖНА БЫТЬ ВНУТРИ ЛЮБОГО ДОЛГОСРОЧНОГО
Dialogue: 0,0:10:14.76,0:10:18.04,Caption,,0,0,0,,УРЕГУЛИРОВАНИЯ. В ПРИНЦИПЕ ЛОГИЧНО. ЕСЛИ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:10:18.12,0:10:20.44,Caption,,0,0,0,,ГОСУДАРСТВА СОБИРАЮТСЯ ПОТОМ ОТПРАВЛЯТЬ ТУДА СВОИ
Dialogue: 0,0:10:20.44,0:10:23.40,Caption,,0,0,0,,ВОЙСКА, САМОЛЁТЫ, ТЕХНИКУ И ДЕНЬГИ,
Dialogue: 0,0:10:23.72,0:10:26.36,Caption,,0,0,0,,СТРАННО БЫЛО БЫ УЗНАТЬ УСЛОВИЯ ИЗ ВЕЧЕРНИХ НОВОСТЕЙ.
Dialogue: 0,0:10:26.77,0:10:30.04,Caption,,0,0,0,,ТОЛЬКО ПОЯВЛЯЕТСЯ ЗАБАВНАЯ СИТУАЦИЯ. ЕВРОПА ТРЕБУЕТ
Dialogue: 0,0:10:30.04,0:10:33.88,Caption,,0,0,0,,МЕСТО ЗА СТОЛОМ, ПОТОМУ ЧТО ЕЁ БЕЗОПАСНОСТЬ ТОЖЕ РЕШАЕТСЯ. И
Dialogue: 0,0:10:33.88,0:10:36.52,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРИНОСИТ К ЭТОМУ СТОЛУ КОНСТРУКЦИЮ,
Dialogue: 0,0:10:36.76,0:10:38.92,Caption,,0,0,0,,КОТОРУЮ МОСКВА СЧИТАЕТ УГРОЗОЙ СОБСТВЕННОЙ
Dialogue: 0,0:10:38.92,0:10:42.04,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ВОТ ПОПРОБУЙТЕ ТЕПЕРЬ РАССАДИТЬ ГОСТЕЙ
Dialogue: 0,0:10:42.12,0:10:44.28,Caption,,0,0,0,,ТАК, ЧТОБЫ НИКТО НЕ ПЕРЕВЕРНУЛ СТОЛ.
Dialogue: 0,0:10:44.90,0:10:47.72,Caption,,0,0,0,,ОСОБЕННО ХОРОШО ВСЁ ЭТО СМОТРИТСЯ НА ФОНЕ ЛУКАШЕНКО.
Dialogue: 0,0:10:48.12,0:10:52.44,Caption,,0,0,0,,ТРЕТЬЕГО НОЯБРЯ ОН СКАЗАЛ, ЧТО ВОЙНА МОЖЕТ ЗАКОНЧИТЬСЯ УЖЕ В БЛИЖАЙШИЕ МЕСЯЦЫ.
Dialogue: 0,0:10:52.74,0:10:55.56,Caption,,0,0,0,,ЛОГИКА У НЕГО ПОНЯТНАЯ. ВСЕ УСТАЛИ. СИЛЫ
Dialogue: 0,0:10:55.56,0:10:58.84,Caption,,0,0,0,,ЗАКАНЧИВАЮТСЯ. РЕСУРСЫ ЗАКАНЧИВАЮТСЯ. ДОЛГО
Dialogue: 0,0:10:58.84,0:11:01.24,Caption,,0,0,0,,ПРОДОЛЖАТЬ НЕЛЬЗЯ. А ЕСЛИ НЕ ОСТАНОВИТЬСЯ,
Dialogue: 0,0:11:01.51,0:11:03.08,Caption,,0,0,0,,ДАЛЬШЕ УГРОЗА ТРЕТЬЕЙ МИРОВОЙ.
Dialogue: 0,0:11:03.87,0:11:07.48,Caption,,0,0,0,,ПОСЛЕ ТОГО, ЧТО МЫ СЕЙЧАС ВИДИМ ВОКРУГ ЕВРОПЕЙСКОГО КОНТИНГЕНТА,
Dialogue: 0,0:11:07.72,0:11:10.20,Caption,,0,0,0,,ВТОРАЯ ЧАСТЬ ЕГО ЗАЯВЛЕНИЯ ЗВУЧИТ УЖЕ СОВСЕМ НЕ
Dialogue: 0,0:11:10.20,0:11:13.16,Caption,,0,0,0,,КАК ДАЛЁКАЯ СТРАШИЛКА. БЕРЁМ РОССИЙСКИЕ ВОЙСКА.
Dialogue: 0,0:11:13.48,0:11:16.12,Caption,,0,0,0,,СТАВИМ РЯДОМ ВООРУЖЁННЫЕ ПОДРАЗДЕЛЕНИЯ НЕСКОЛЬКИХ
Dialogue: 0,0:11:16.12,0:11:19.24,Caption,,0,0,0,,ГОСУДАРСТВ НАТО. ОДНИМ ЗАРАНЕЕ РАЗРЕШЕНО ПРИМЕНЯТЬ
Dialogue: 0,0:11:19.24,0:11:23.35,Caption,,0,0,0,,СИЛУ. ДРУГИЕ ЗАРАНЕЕ ГОВОРЯТ,
Dialogue: 0,0:11:23.59,0:11:26.63,Caption,,0,0,0,,ЧТО СЧИТАЮТ ИХ ПРИСУТСТВИЕ УГРОЗОЙ. И НАДЕЕМСЯ,
Dialogue: 0,0:11:26.79,0:11:28.47,Caption,,0,0,0,,ЧТО НИКТО НИКОГДА НЕ ОШИБЁТСЯ,
Dialogue: 0,0:11:28.71,0:11:32.95,Caption,,0,0,0,,НЕ УДАРИТ ПЕРВЫМ, НЕ ПРИМЕТ ДВИЖЕНИЕ ТЕХНИКИ ЗА НАЧАЛО НАПАДЕНИЯ И
Dialogue: 0,0:11:33.03,0:11:36.39,Caption,,0,0,0,,НЕ РЕШИТ ОТВЕТИТЬ. ПЛАН НАДЁЖНЫЙ. ОСОБЕННО УЧИТЫВАЯ,
Dialogue: 0,0:11:36.55,0:11:39.35,Caption,,0,0,0,,КАК ПРЕКРАСНО ЛЮДИ ОБЫЧНО КОНТРОЛИРУЮТ СИТУАЦИЮ ВО
Dialogue: 0,0:11:39.43,0:11:42.47,Caption,,0,0,0,,ВРЕМЯ ВОЙНЫ. НО С ПЕРВОЙ ЧАСТЬЮ ЗАЯВЛЕНИЯ ЛУКАШЕНКО
Dialogue: 0,0:11:42.55,0:11:45.75,Caption,,0,0,0,,ПОКА СЛОЖНЕЕ. ВОЙНА ЗАКОНЧИТСЯ В БЛИЖАЙШИЕ МЕСЯЦЫ.
Dialogue: 0,0:11:46.04,0:11:48.79,Caption,,0,0,0,,ХОРОШО. ЗА СЧЁТ ЧЕГО? ВОТ СЕЙЧАС,
Dialogue: 0,0:11:49.00,0:11:50.63,Caption,,0,0,0,,ЗА НЕСКОЛЬКО ДНЕЙ ДО АБУ ДАБИ,
Dialogue: 0,0:11:50.78,0:11:54.63,Caption,,0,0,0,,УЖЕ ВИДНО, ЧТО СТОРОНЫ ОБСУЖДАЮТ НЕ КОСМЕТИКУ. НЕ НАЗВАНИЕ
Dialogue: 0,0:11:54.63,0:11:58.15,Caption,,0,0,0,,ДОКУМЕНТА. НЕ ЦВЕТ ПАПКИ. ОНИ СПОРЯТ О ТОМ,
Dialogue: 0,0:11:58.39,0:12:01.59,Caption,,0,0,0,,КАК БУДЕТ УСТРОЕНА УКРАИНА ПОСЛЕ ВОЙНЫ. КАКАЯ У
Dialogue: 0,0:12:01.67,0:12:04.15,Caption,,0,0,0,,НЕЁ БУДЕТ АРМИЯ. КТО БУДЕТ ГАРАНТИРОВАТЬ ЕЁ
Dialogue: 0,0:12:04.15,0:12:06.95,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. КАКИЕ ИНОСТРАННЫЕ СИЛЫ СМОГУТ
Dialogue: 0,0:12:07.03,0:12:09.99,Caption,,0,0,0,,НАХОДИТЬСЯ НА ЕЁ ТЕРРИТОРИИ. ЧТО ПОЛУЧАЕТ УКРАИНА.
Dialogue: 0,0:12:10.14,0:12:13.51,Caption,,0,0,0,,ЧТО ПОЛУЧАЕТ РОССИЯ. ЧТО ПОЛУЧАЕТ ЕВРОПА. И ЗДЕСЬ
Dialogue: 0,0:12:13.51,0:12:16.39,Caption,,0,0,0,,ПОКА НЕ ВИДНО ЧЕЛОВЕКА, КОТОРЫЙ СКАЗАЛ ЛАДНО,
Dialogue: 0,0:12:16.57,0:12:19.11,Caption,,0,0,0,,ВОТ ОТ ЭТОГО ПРИНЦИПИАЛЬНОГО УСЛОВИЯ Я ОТКАЗЫВАЮСЬ.
Dialogue: 0,0:12:19.28,0:12:22.23,Caption,,0,0,0,,НАОБОРОТ. ЕВРОПА ПРЯМО СЕЙЧАС ДОДЕЛЫВАЕТ СВОЮ
Dialogue: 0,0:12:22.31,0:12:25.03,Caption,,0,0,0,,КОНСТРУКЦИЮ ГАРАНТИЙ. БРИТАНИЯ ПРЯМО СЕЙЧАС
Dialogue: 0,0:12:25.11,0:12:28.55,Caption,,0,0,0,,ТРЕНИРУЕТ БУДУЩУЮ ВОЕННУЮ СИЛУ. УКРАИНА ПРЯМО СЕЙЧАС
Dialogue: 0,0:12:28.55,0:12:31.51,Caption,,0,0,0,,ТРЕБУЕТ СЕРЬЁЗНЫХ ГАРАНТИЙ. РОССИЯ ПРЯМО СЕЙЧАС
Dialogue: 0,0:12:31.59,0:12:34.87,Caption,,0,0,0,,ГОВОРИТ, ЧТО ЕЁ ПОЗИЦИЯ НЕ ИЗМЕНИЛАСЬ. А ПЕРЕГОВОРЫ УЖЕ
Dialogue: 0,0:12:34.95,0:12:40.67,Caption,,0,0,0,,ЧЕРЕЗ НЕСКОЛЬКО ДНЕЙ. ВОТ ПОЭТОМУ Я БЫ ОЧЕНЬ ВНИМАТЕЛЬНО СМОТРЕЛ НЕ
Dialogue: 0,0:12:40.75,0:12:45.15,Caption,,0,0,0,,НА ОЧЕРЕДНОЕ ЗАЯВЛЕНИЕ, ЧТО МИР БЛИЗКО. СЛОВО БЛИЗКО У ПОЛИТИКОВ ВООБЩЕ
Dialogue: 0,0:12:45.15,0:12:48.03,Caption,,0,0,0,,УДИВИТЕЛЬНОЕ. ОНО ГОДАМИ МОЖЕТ НАХОДИТЬСЯ НА ОДНОМ И
Dialogue: 0,0:12:48.11,0:12:50.51,Caption,,0,0,0,,ТОМ ЖЕ РАССТОЯНИИ. Я БЫ СМОТРЕЛ НА ДРУГОЕ.
Dialogue: 0,0:12:50.75,0:12:52.99,Caption,,0,0,0,,ЧТО КОНКРЕТНО ИЗМЕНИТСЯ ПОСЛЕ АБУ ДАБИ?
Dialogue: 0,0:12:53.43,0:12:56.03,Caption,,0,0,0,,НЕ КТО КОМУ УЛЫБНУЛСЯ. НЕ СКОЛЬКО ЧАСОВ ОНИ
Dialogue: 0,0:12:56.03,0:12:58.59,Caption,,0,0,0,,ПРОСИДЕЛИ ЗА СТОЛОМ. НЕ КТО НАЗВАЛ РАЗГОВОР
Dialogue: 0,0:12:58.59,0:13:01.39,Caption,,0,0,0,,КОНСТРУКТИВНЫМ. ЭТО ВСЁ ПРЕКРАСНЫЕ СЛОВА ДЛЯ ПРЕСС
Dialogue: 0,0:13:01.47,0:13:04.59,Caption,,0,0,0,,СЛУЖБЫ. ВОПРОС ОДИН. КТО ОТ КАКОГО ПРИНЦИПИАЛЬНОГО
Dialogue: 0,0:13:04.59,0:13:08.75,Caption,,0,0,0,,ТРЕБОВАНИЯ ОТСТУПИЛ? ЕСЛИ РОССИЯ СОГЛАСИТСЯ НА ТАКУЮ МОДЕЛЬ ЗАПАДНОГО
Dialogue: 0,0:13:08.75,0:13:13.15,Caption,,0,0,0,,ВОЕННОГО ПРИСУТСТВИЯ, ЭТО БУДЕТ ОГРОМНАЯ ПЕРЕМЕНА. ЕСЛИ ЕВРОПА ОТКАЖЕТСЯ
Dialogue: 0,0:13:13.23,0:13:16.99,Caption,,0,0,0,,ОТ НЕЁ, ЭТО БУДЕТ ОГРОМНАЯ ПЕРЕМЕНА. ЕСЛИ КИЕВ СОГЛАСИТСЯ НА
Dialogue: 0,0:13:16.99,0:13:19.39,Caption,,0,0,0,,ОГРАНИЧЕНИЯ, КОТОРЫЕ ДО ЭТОГО ОТВЕРГАЛ,
Dialogue: 0,0:13:19.57,0:13:22.27,Caption,,0,0,0,,ЭТО БУДЕТ ОГРОМНАЯ ПЕРЕМЕНА. ВОТ ЭТО УЖЕ СОБЫТИЕ.
Dialogue: 0,0:13:22.59,0:13:25.31,Caption,,0,0,0,,А ПОКА КАРТИНА ВЫГЛЯДИТ КУДА ВЕСЕЛЕЕ. ДО ПЕРЕГОВОРОВ
Dialogue: 0,0:13:25.31,0:13:28.19,Caption,,0,0,0,,ОСТАЛОСЬ НЕСКОЛЬКО ДНЕЙ. ВСЕ ГОТОВЯТСЯ. ТОЛЬКО
Dialogue: 0,0:13:28.19,0:13:30.75,Caption,,0,0,0,,КАЖДЫЙ ГОТОВИТСЯ ПО СВОЕМУ. ОДНИ ГОТОВЯТ
Dialogue: 0,0:13:30.75,0:13:33.63,Caption,,0,0,0,,ПЕРЕГОВОРНУЮ КОМНАТУ. ДРУГИЕ ГОТОВЯТ ГАРАНТИИ.
Dialogue: 0,0:13:33.87,0:13:36.75,Caption,,0,0,0,,ТРЕТЬИ ГОТОВЯТ ВОЕННЫЕ ПОДРАЗДЕЛЕНИЯ. ЧЕТВЁРТЫЕ
Dialogue: 0,0:13:36.83,0:13:39.31,Caption,,0,0,0,,ПОВТОРЯЮТ СТАРЫЕ УСЛОВИЯ. И ВСЕ ГОВОРЯТ,
Dialogue: 0,0:13:39.47,0:13:42.11,Caption,,0,0,0,,ЧТО ГОТОВЯТСЯ К МИРУ. ПОЭТОМУ ВОЗВРАЩАЕМСЯ К
Dialogue: 0,0:13:42.11,0:13:44.43,Caption,,0,0,0,,ВОПРОСУ, С КОТОРОГО НАЧАЛИ. РЕБЯТА,
Dialogue: 0,0:13:44.75,0:13:46.11,Caption,,0,0,0,,А ВЫ ВООБЩЕ К ОДНОМУ И ТОМУ ЖЕ
Dialogue: 0,0:13:46.19,0:13:51.19,Caption,,0,0,0,,МИРУ ГОТОВИТЕСЬ? ПОТОМУ ЧТО ПОКА ОДИН РИСУЕТ ДВЕРЬ,
Dialogue: 0,0:13:51.43,0:13:55.11,Caption,,0,0,0,,ВТОРОЙ СТАВИТ НА НЕЁ ЗАМОК, ТРЕТИЙ УЖЕ ПРИНЁС ОРУЖЕЙНЫЙ ШКАФ,
Dialogue: 0,0:13:55.43,0:13:58.79,Caption,,0,0,0,,А ЧЕТВЁРТЫЙ ГОВОРИТ, ЧТО ИМЕННО ЭТОГО ШКАФА В ДОМЕ БЫТЬ НЕ
Dialogue: 0,0:13:58.79,0:14:01.59,Caption,,0,0,0,,ДОЛЖНО. А ХОЗЯЕВА УЖЕ ЗОВУТ ВСЕХ ПОДПИСЫВАТЬ
Dialogue: 0,0:14:01.59,0:14:04.95,Caption,,0,0,0,,ДОГОВОР. АБУ ДАБИ ЧЕРЕЗ НЕСКОЛЬКО ДНЕЙ. ВОТ ТАМ
Dialogue: 0,0:14:05.03,0:14:09.11,Caption,,0,0,0,,И УВИДИМ НЕ ТО, КТО ГРОМЧЕ ХОЧЕТ МИРА. А КТО ДЕЙСТВИТЕЛЬНО ГОТОВ
Dialogue: 0,0:14:09.11,0:14:10.55,Caption,,0,0,0,,РАДИ НЕГО ЧТО ТО ПОМЕНЯТЬ.
