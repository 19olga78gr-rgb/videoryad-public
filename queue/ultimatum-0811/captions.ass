Dialogue: 0,0:00:00.12,0:00:02.52,Caption,,0,0,0,,ЕСЛИ FINANCIAL TIMES НИЧЕГО НЕ ПЕРЕПУТАЛА,
Dialogue: 0,0:00:02.60,0:00:05.00,Caption,,0,0,0,,РАЗГОВОР ТАМ БЫЛ ОЧЕНЬ КОРОТКИЙ. ПУТИН,
Dialogue: 0,0:00:05.14,0:00:09.16,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, ПЕРЕСТАЛ УГОВАРИВАТЬ И ПРОСТО НАЗВАЛ УСЛОВИЯ. ПРИЧЁМ
Dialogue: 0,0:00:09.24,0:00:12.52,Caption,,0,0,0,,ТАКИМ ТОНОМ, ПОСЛЕ КОТОРОГО ОБЫЧНО УЖЕ НЕ СПРАШИВАЮТ "А МОЖНО
Dialogue: 0,0:00:12.52,0:00:15.40,Caption,,0,0,0,,ЕЩЁ ПОДУМАТЬ?" И ВОТ ТУТ ВОЗНИКАЕТ НЕПРИЯТНЫЙ
Dialogue: 0,0:00:15.40,0:00:17.96,Caption,,0,0,0,,ВОПРОС. ЧТО ДОЛЖНО БЫЛО ПРОИЗОЙТИ,
Dialogue: 0,0:00:18.12,0:00:20.12,Caption,,0,0,0,,ЧТОБЫ РАЗГОВОР ДОШЁЛ ДО ТАКОЙ ТОЧКИ?
Dialogue: 0,0:00:20.31,0:00:23.00,Caption,,0,0,0,,ПОТОМУ ЧТО FINANCIAL TIMES ПЕРЕДАЁТ ПОЗИЦИЮ МОСКВЫ
Dialogue: 0,0:00:23.00,0:00:26.04,Caption,,0,0,0,,УЖЕ НЕ КАК ОЧЕРЕДНОЙ ОБМЕН ПОЖЕЛАНИЯМИ. ИЗДАНИЕ
Dialogue: 0,0:00:26.04,0:00:30.12,Caption,,0,0,0,,ПИШЕТ СО ССЫЛКОЙ НА ЧЕЛОВЕКА, ЗНАКОМОГО С ПЕРЕГОВОРНЫМ ПРОЦЕССОМ ПУТИН
Dialogue: 0,0:00:30.12,0:00:32.68,Caption,,0,0,0,,РАССМАТРИВАЕТ УДАРЫ ПО УКРАИНСКОЙ ИНФРАСТРУКТУРЕ КАК
Dialogue: 0,0:00:32.76,0:00:35.48,Caption,,0,0,0,,ОТВЕТ НА АТАКИ ПО РОССИЙСКИМ НЕФТЕПЕРЕРАБАТЫВАЮЩИМ
Dialogue: 0,0:00:35.48,0:00:38.52,Caption,,0,0,0,,ЗАВОДАМ И КОММЕРЧЕСКИМ ОБЪЕКТАМ. И ОТДЕЛЬНО ОБВИНЯЕТ
Dialogue: 0,0:00:38.52,0:00:42.04,Caption,,0,0,0,,КИЕВ В ТОМ, ЧТО ПРЕДЫДУЩИЕ ПОПЫТКИ ДОГОВОРИТЬСЯ О ПРЕКРАЩЕНИИ
Dialogue: 0,0:00:42.12,0:00:45.08,Caption,,0,0,0,,ОГНЯ БЫЛИ СОРВАНЫ. А ДАЛЬШЕ ФОРМУЛИРОВКА ВООБЩЕ БЕЗ
Dialogue: 0,0:00:45.08,0:00:47.96,Caption,,0,0,0,,КРУЖЕВ. СМЫСЛ ТАКОЙ СОГЛАШАЙТЕСЬ НА УСЛОВИЯ,
Dialogue: 0,0:00:48.28,0:00:51.32,Caption,,0,0,0,,ИНАЧЕ ИНФРАСТРУКТУРЫ У ВАС НЕ ОСТАНЕТСЯ. МОСТЫ,
Dialogue: 0,0:00:51.45,0:00:54.20,Caption,,0,0,0,,ПОРТЫ, ЖЕЛЕЗНЫЕ ДОРОГИ, ЭНЕРГЕТИКА,
Dialogue: 0,0:00:54.28,0:00:56.92,Caption,,0,0,0,,ЭЛЕКТРОСТАНЦИИ. ЭТО УЖЕ ДАЖЕ НЕ "ДАВАЙТЕ ЕЩЁ
Dialogue: 0,0:00:56.92,0:00:59.56,Caption,,0,0,0,,СОЗВОНИМСЯ". ТУТ КАК ТО СОЗВАНИВАТЬСЯ ОСОБО НЕ О
Dialogue: 0,0:00:59.56,0:01:02.52,Caption,,0,0,0,,ЧЕМ. ЕСЛИ ТАКИЕ СЛОВА ДЕЙСТВИТЕЛЬНО ПЕРЕДАЮТ ПОЗИЦИЮ
Dialogue: 0,0:01:02.52,0:01:07.64,Caption,,0,0,0,,ПУТИНА, ТО, ГОСПОДА, ДОПРОИГРАЛИСЬ. ПОТОМУ ЧТО ПЕРЕГОВОРНЫЙ ЯЗЫК РЕЗКО
Dialogue: 0,0:01:07.64,0:01:11.43,Caption,,0,0,0,,ПОМЕНЯЛСЯ. РАНЬШЕ СПОРИЛИ,
Dialogue: 0,0:01:11.75,0:01:14.23,Caption,,0,0,0,,ГДЕ ОСТАНОВИТЬСЯ, КОГДА ПРЕКРАТИТЬ ОГОНЬ,
Dialogue: 0,0:01:14.47,0:01:18.15,Caption,,0,0,0,,КТО ЧТО ПОДПИШЕТ, КАКИЕ ГАРАНТИИ КОМУ ДАДУТ. А ТУТ ВАМ УЖЕ
Dialogue: 0,0:01:18.15,0:01:22.39,Caption,,0,0,0,,НАЗЫВАЮТ НЕ ТОЛЬКО УСЛОВИЯ, НО И ЦЕНУ ОТКАЗА. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ
Dialogue: 0,0:01:22.39,0:01:26.23,Caption,,0,0,0,,РАЗБОРЫ, ПОДПИШИТЕСЬ. И ВОТ ТУТ У КИЕВА ПРОБЛЕМА. УКРАИНА
Dialogue: 0,0:01:26.23,0:01:29.03,Caption,,0,0,0,,ОТВЕЧАЕТ РОВНО ПРОТИВОПОЛОЖНЫМ ОБРАЗОМ. ГЛАВА
Dialogue: 0,0:01:29.03,0:01:31.99,Caption,,0,0,0,,УКРАИНСКОГО МИДА СИБИГА ГОВОРИТ ДАЛЬНОБОЙНЫЕ УДАРЫ
Dialogue: 0,0:01:32.07,0:01:35.03,Caption,,0,0,0,,ПО РОССИИ ПРОДОЛЖАТСЯ. ПРИЧЁМ ФОРМУЛА ТОЖЕ КРАСИВАЯ
Dialogue: 0,0:01:35.03,0:01:36.95,Caption,,0,0,0,,ЧЕМ ДАЛЬШЕ УКРАИНА СПОСОБНА БИТЬ,
Dialogue: 0,0:01:37.27,0:01:40.55,Caption,,0,0,0,,ТЕМ БЛИЖЕ КОНЕЦ КОНФЛИКТА. ЛОГИКА ПОНЯТНАЯ. БУДЕМ
Dialogue: 0,0:01:40.55,0:01:44.79,Caption,,0,0,0,,ДОСТАВАТЬ ДАЛЬШЕ, ЗНАЧИТ МОСКВА БЫСТРЕЕ УСТУПИТ. ТОЛЬКО МОСКВА,
Dialogue: 0,0:01:44.95,0:01:49.59,Caption,,0,0,0,,ЕСЛИ ВЕРИТЬ FINANCIAL TIMES, ПРОЧИТАЛА ЭТУ ЖЕ СИТУАЦИЮ СОВЕРШЕННО ИНАЧЕ. ВЫ
Dialogue: 0,0:01:49.59,0:01:52.23,Caption,,0,0,0,,ПРОДОЛЖАЕТЕ БИТЬ ПО РОССИЙСКИМ НПЗ И СКЛАДАМ,
Dialogue: 0,0:01:52.46,0:01:55.11,Caption,,0,0,0,,ЗНАЧИТ ЦЕНА ДЛЯ ВАС БУДЕТ РАСТИ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:01:55.11,0:01:57.75,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ. КИЕВ СЧИТАЕТ,
Dialogue: 0,0:01:57.91,0:02:01.03,Caption,,0,0,0,,ЧТО КАЖДЫЙ ДАЛЬНИЙ УДАР ПРИБЛИЖАЕТ КОНЕЦ. МОСКВА
Dialogue: 0,0:02:01.11,0:02:04.95,Caption,,0,0,0,,ОТВЕЧАЕТ ТАК, БУДТО КАЖДЫЙ ТАКОЙ УДАР ПРИБЛИЖАЕТ СЛЕДУЮЩУЮ ОЧЕРЕДЬ
Dialogue: 0,0:02:04.95,0:02:08.07,Caption,,0,0,0,,ЦЕЛЕЙ НА ТЕРРИТОРИИ УКРАИНЫ. ОБЕ СТОРОНЫ УВЕРЕНЫ,
Dialogue: 0,0:02:08.39,0:02:11.51,Caption,,0,0,0,,ЧТО ДАВЛЕНИЕ ЗАСТАВИТ ПРОТИВНИКА ИЗМЕНИТЬ РАСЧЁТ. НУ
Dialogue: 0,0:02:11.59,0:02:15.11,Caption,,0,0,0,,И КТО ПЕРВЫЙ ПЕРЕДУМАЕТ? ПОТОМУ ЧТО ПРОБЛЕМА ДЛЯ КИЕВА СЕЙЧАС НЕ В
Dialogue: 0,0:02:15.11,0:02:18.79,Caption,,0,0,0,,ТОМ, ЧТО ПУТИН ПРОИЗНЁС СТРАШНУЮ ФРАЗУ. ПОЛИТИКИ СТРАШНЫХ
Dialogue: 0,0:02:18.79,0:02:21.03,Caption,,0,0,0,,ФРАЗ ЗА ЭТИ ГОДЫ НАГОВОРИЛИ УЖЕ НА НЕСКОЛЬКО
Dialogue: 0,0:02:21.03,0:02:27.21,Caption,,0,0,0,,ТОМОВ. ПРОБЛЕМА В ДРУГОМ. ДЛЯ ВЫПОЛНЕНИЯ ЭТОЙ УГРОЗЫ РОССИИ НЕ ТРЕБУЕТСЯ
Dialogue: 0,0:02:27.29,0:02:29.93,Caption,,0,0,0,,СНАЧАЛА ИЗОБРЕСТИ КАКОЕ ТО НОВОЕ ЧУДО ОРУЖИЕ,
Dialogue: 0,0:02:30.17,0:02:32.73,Caption,,0,0,0,,ПОСТРОИТЬ ДЕСЯТЬ НОВЫХ ЗАВОДОВ И ЧЕРЕЗ ПЯТЬ ЛЕТ
Dialogue: 0,0:02:32.73,0:02:34.81,Caption,,0,0,0,,ВЕРНУТЬСЯ К РАЗГОВОРУ. ПОСМОТРИТЕ,
Dialogue: 0,0:02:34.94,0:02:37.93,Caption,,0,0,0,,ЧТО УЖЕ ПРОИСХОДИТ. В ПОСЛЕДНЕМ КРУПНОМ УДАРЕ
Dialogue: 0,0:02:37.93,0:02:40.25,Caption,,0,0,0,,ОСНОВНОЙ УДАР ПРИШЁЛСЯ ПО ЭНЕРГЕТИЧЕСКОЙ И
Dialogue: 0,0:02:40.25,0:02:43.05,Caption,,0,0,0,,ПРОМЫШЛЕННОЙ ИНФРАСТРУКТУРЕ. ПОД УДАРОМ ОКАЗАЛИСЬ
Dialogue: 0,0:02:43.05,0:02:45.85,Caption,,0,0,0,,ОБЪЕКТЫ КИЕВСКОГО РЕГИОНА, ТРИПОЛЬСКАЯ ТЭС,
Dialogue: 0,0:02:46.01,0:02:50.09,Caption,,0,0,0,,СТОЛИЧНЫЕ ТЭЦ, КРУПНЫЕ ПОДСТАНЦИИ. СООБЩАЛОСЬ О ПОВРЕЖДЕНИИ
Dialogue: 0,0:02:50.09,0:02:52.97,Caption,,0,0,0,,СЕВЕРНОГО МОСТА, ПЕРЕБОЯХ С ЭЛЕКТРИЧЕСТВОМ,
Dialogue: 0,0:02:53.05,0:02:57.13,Caption,,0,0,0,,ВОДОЙ, РАБОТОЙ ТРАНСПОРТА. ДЛЯ ОБЫЧНОГО ЧЕЛОВЕКА ВАЖНЕЕ НЕ
Dialogue: 0,0:02:57.21,0:03:01.21,Caption,,0,0,0,,ТИП РАКЕТЫ, А ПОСЛЕДСТВИЯ УДАРА. НАЖАЛИ В НЕСКОЛЬКИХ МЕСТАХ,
Dialogue: 0,0:03:01.45,0:03:03.37,Caption,,0,0,0,,И БОЛЬШОЙ ГОРОД НАЧИНАЕТ ОБНАРУЖИВАТЬ,
Dialogue: 0,0:03:03.61,0:03:06.09,Caption,,0,0,0,,НАСКОЛЬКО МНОГО В НЁМ ВЕЩЕЙ РАБОТАЕТ ТОЛЬКО ДО
Dialogue: 0,0:03:06.17,0:03:09.77,Caption,,0,0,0,,ТЕХ ПОР, ПОКА ИЗ РОЗЕТКИ ИДЁТ ЭЛЕКТРИЧЕСТВО. КИЕВ ЭТО УЖЕ
Dialogue: 0,0:03:09.77,0:03:14.09,Caption,,0,0,0,,ПРИЗНАЁТ САМ. КЛИЧКО ГОВОРИТ, ЧТО ПОЛНОСТЬЮ ОБЕСПЕЧИТЬ СТОЛИЦУ ГЕНЕРАТОРАМИ
Dialogue: 0,0:03:14.09,0:03:16.89,Caption,,0,0,0,,НЕВОЗМОЖНО. ГОРОДУ ТРЕБУЕТСЯ ОКОЛО ДВУХ ГИГАВАТТ
Dialogue: 0,0:03:16.89,0:03:20.57,Caption,,0,0,0,,МОЩНОСТИ. ДВА ГИГАВАТТА. И ЭТУ МОЩНОСТЬ ПРЕДЛАГАЕТСЯ
Dialogue: 0,0:03:20.65,0:03:23.61,Caption,,0,0,0,,ЗАКРЫТЬ ГЕНЕРАТОРАМИ. ЭТО УЖЕ НЕ ИСТОРИЯ "КУПИМ ЕЩЁ
Dialogue: 0,0:03:23.61,0:03:26.57,Caption,,0,0,0,,СОТНЮ ДИЗЕЛЕЙ И ПОСТАВИМ ВОЗЛЕ БОЛЬНИЦ". ТУТ ХОТЬ
Dialogue: 0,0:03:26.57,0:03:28.41,Caption,,0,0,0,,ВЕСЬ ГОРОД ЗАСТАВЬ ГЕНЕРАТОРАМИ,
Dialogue: 0,0:03:28.49,0:03:31.93,Caption,,0,0,0,,ПОЛУЧИШЬ НЕ ЭНЕРГОСИСТЕМУ, А ФЕСТИВАЛЬ ДИЗЕЛЬНОГО ДВИГАТЕЛЯ.
Dialogue: 0,0:03:34.22,0:03:36.30,Caption,,0,0,0,,А ЗЕЛЕНСКИЙ ГОВОРИТ ЕЩЁ ЖЁСТЧЕ В СТРАНЕ НЕ
Dialogue: 0,0:03:36.30,0:03:38.30,Caption,,0,0,0,,ОСТАЛОСЬ НИ ОДНОЙ ЭЛЕКТРОСТАНЦИИ,
Dialogue: 0,0:03:38.54,0:03:40.70,Caption,,0,0,0,,КОТОРАЯ ВООБЩЕ НЕ ПОЛУЧИЛА ПОВРЕЖДЕНИЙ.
Dialogue: 0,0:03:41.79,0:03:44.46,Caption,,0,0,0,,ВОТ ПОСЛЕ ЭТОГО ФРАЗА ПРО УНИЧТОЖЕНИЕ ИНФРАСТРУКТУРЫ
Dialogue: 0,0:03:44.54,0:03:47.50,Caption,,0,0,0,,НАЧИНАЕТ ЗВУЧАТЬ УЖЕ НЕМНОГО ИНАЧЕ. ПОТОМУ ЧТО ОДНО
Dialogue: 0,0:03:47.50,0:03:49.66,Caption,,0,0,0,,ДЕЛО УГРОЖАТЬ ЧЕЛОВЕКУ СЛОМАТЬ ЗАБОР,
Dialogue: 0,0:03:49.90,0:03:52.54,Caption,,0,0,0,,КОГДА У НЕГО ВОКРУГ БЕТОННАЯ КРЕПОСТЬ. И СОВСЕМ
Dialogue: 0,0:03:52.62,0:03:55.50,Caption,,0,0,0,,ДРУГОЕ, КОГДА ЗАБОР УЖЕ ДЕРЖИТСЯ НА ДВУХ СТОЛБАХ И
Dialogue: 0,0:03:55.58,0:03:58.06,Caption,,0,0,0,,ЧЕСТНОМ СЛОВЕ. ПРИЧЁМ ПРОБЛЕМА ДАВНО ВЫШЛА ЗА
Dialogue: 0,0:03:58.14,0:04:01.26,Caption,,0,0,0,,ПРЕДЕЛЫ САМОГО ЭЛЕКТРИЧЕСТВА. В КИЕВЕ УЖЕ ОБСУЖДАЮТ
Dialogue: 0,0:04:01.26,0:04:05.26,Caption,,0,0,0,,ВЕЩИ, КОТОРЫЕ ЕЩЁ НЕДАВНО ЗВУЧАЛИ КАК ДУРНАЯ ШУТКА. ГЛАВА
Dialogue: 0,0:04:05.26,0:04:07.82,Caption,,0,0,0,,ДЕСНЯНСКОЙ РАЙОННОЙ АДМИНИСТРАЦИИ БАХМАТОВ РАНЬШЕ
Dialogue: 0,0:04:07.90,0:04:11.42,Caption,,0,0,0,,ГОВОРИЛ О ТОМ, ЧТО ПРИ ДЛИТЕЛЬНОМ БЛЭКАУТЕ НА ТРОЕЩИНЕ ПРИДЁТСЯ
Dialogue: 0,0:04:11.42,0:04:14.62,Caption,,0,0,0,,ГОТОВИТЬ УЛИЧНЫЕ ТУАЛЕТЫ. ТОГДА НАД ЭТИМ ПОСМЕЯЛИСЬ.
Dialogue: 0,0:04:15.02,0:04:18.46,Caption,,0,0,0,,ТЕПЕРЬ ОН ГОВОРИТ, ЧТО ИДЕЯ УЖЕ ПОЛУЧИЛА ПОДДЕРЖКУ ДЛЯ ГОРОДА В
Dialogue: 0,0:04:18.46,0:04:21.18,Caption,,0,0,0,,ЦЕЛОМ. ТО ЕСТЬ ПОЛИТИЧЕСКАЯ ДИСКУССИЯ ПРОШЛА
Dialogue: 0,0:04:21.18,0:04:23.90,Caption,,0,0,0,,ПРЕКРАСНЫЙ ПУТЬ. СНАЧАЛА СМЕЁМСЯ НАД УЛИЧНЫМИ
Dialogue: 0,0:04:23.90,0:04:26.30,Caption,,0,0,0,,ТУАЛЕТАМИ. ПОТОМ НАЧИНАЕМ ОБСУЖДАТЬ,
Dialogue: 0,0:04:26.46,0:04:29.90,Caption,,0,0,0,,ГДЕ ИМЕННО ИХ СТАВИТЬ. ВОТ ЭТО НАЗЫВАЕТСЯ БЫСТРОЕ
Dialogue: 0,0:04:29.98,0:04:31.98,Caption,,0,0,0,,ВЗРОСЛЕНИЕ ИНФРАСТРУКТУРНОЙ ПОЛИТИКИ.
Dialogue: 0,0:04:32.62,0:04:35.10,Caption,,0,0,0,,БАХМАТОВ ПРИ ЭТОМ ЗАДАЁТ ЕЩЁ БОЛЕЕ НЕПРИЯТНЫЙ
Dialogue: 0,0:04:35.10,0:04:38.62,Caption,,0,0,0,,ВОПРОС. ОН ГОВОРИТ, ЧТО РЕЗЕРВНЫЕ СИСТЕМЫ ВОДЫ,
Dialogue: 0,0:04:38.78,0:04:41.66,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА И ОТОПЛЕНИЯ ТОЛКОМ НЕ ПОДГОТОВЛЕНЫ,
Dialogue: 0,0:04:42.06,0:04:44.70,Caption,,0,0,0,,А ОГРОМНЫЕ СУММЫ, ВЫДЕЛЯВШИЕСЯ НА ГОРОД,
Dialogue: 0,0:04:44.90,0:04:46.86,Caption,,0,0,0,,РАСТВОРИЛИСЬ ГДЕ ТО ВНУТРИ СИСТЕМЫ.
Dialogue: 0,0:04:49.14,0:04:51.78,Caption,,0,0,0,,НО САМА КАРТИНКА ЗАМЕЧАТЕЛЬНАЯ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:04:52.10,0:04:54.74,Caption,,0,0,0,,ВАМ РАССКАЗЫВАЮТ О ПРОДОЛЖЕНИИ ДАЛЬНОБОЙНОЙ КАМПАНИИ
Dialogue: 0,0:04:54.74,0:04:58.26,Caption,,0,0,0,,ПРОТИВ РОССИИ. С ДРУГОЙ, СТОЛИЦА УЖЕ ОБСУЖДАЕТ,
Dialogue: 0,0:04:58.35,0:05:03.38,Caption,,0,0,0,,КУДА ЧЕЛОВЕК ПОЙДЁТ В ТУАЛЕТ, ЕСЛИ НАСОСЫ ПЕРЕСТАНУТ КАЧАТЬ ВОДУ. МАСШТАБ
Dialogue: 0,0:05:03.38,0:05:06.42,Caption,,0,0,0,,ГЕОПОЛИТИЧЕСКИХ АМБИЦИЙ И МАСШТАБ БЫТОВОЙ ПОДГОТОВКИ
Dialogue: 0,0:05:06.42,0:05:07.94,Caption,,0,0,0,,ВСТРЕТИЛИСЬ ГДЕ ТО ПОСЕРЕДИНЕ.
Dialogue: 0,0:05:08.66,0:05:10.50,Caption,,0,0,0,,И ЗДЕСЬ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ВЕЩЬ,
Dialogue: 0,0:05:10.78,0:05:13.46,Caption,,0,0,0,,КОТОРАЯ СНАЧАЛА ВООБЩЕ ВЫГЛЯДИТ ОТДЕЛЬНОЙ НОВОСТЬЮ.
Dialogue: 0,0:05:13.69,0:05:16.42,Caption,,0,0,0,,РОССИЯ ВЫВЕЛА НА ОРБИТУ УЖЕ ТРИДЦАТЬ ДВА АППАРАТА
Dialogue: 0,0:05:16.50,0:05:19.30,Caption,,0,0,0,,СИСТЕМЫ "РАССВЕТ" И СОБИРАЕТСЯ ПРОДОЛЖАТЬ ЗАПУСКИ.
Dialogue: 0,0:05:19.65,0:05:21.94,Caption,,0,0,0,,УКРАИНСКАЯ ВОЕННАЯ РАЗВЕДКА ПРЯМО ГОВОРИТ,
Dialogue: 0,0:05:22.25,0:05:24.74,Caption,,0,0,0,,ЧТО ЭТА ГРУППИРОВКА УЖЕ ИСПОЛЬЗУЕТСЯ НАД ТЕРРИТОРИЕЙ
Dialogue: 0,0:05:24.74,0:05:28.02,Caption,,0,0,0,,УКРАИНЫ ДЛЯ ВОЕННЫХ ЗАДАЧ. И ТУТ НАЧИНАЕТСЯ ЛЮБИМЫЙ
Dialogue: 0,0:05:28.10,0:05:31.14,Caption,,0,0,0,,СПОРТ ИНТЕРНЕТА. СРАВНИВАЮТ "РАССВЕТ" СО STARLINK И
Dialogue: 0,0:05:31.14,0:05:33.38,Caption,,0,0,0,,СМЕЮТСЯ НУ КАКОЙ ЖЕ ЭТО КОНКУРЕНТ?
Dialogue: 0,0:05:33.46,0:05:37.06,Caption,,0,0,0,,СПУТНИКОВ МАЛО. ПОКРЫТИЯ ВСЕГО МИРА НЕТ. ТЕРМИНАЛОВ
Dialogue: 0,0:05:37.06,0:05:39.70,Caption,,0,0,0,,МИЛЛИОНЫ НЕ СТОЯТ. В КАЖДОЙ ДЕРЕВНЕ ИНТЕРНЕТ НЕ
Dialogue: 0,0:05:39.70,0:05:42.34,Caption,,0,0,0,,РАЗДАЮТ. ТАК А ЗАЧЕМ РОССИИ СЕЙЧАС РАЗДАВАТЬ
Dialogue: 0,0:05:42.34,0:05:45.46,Caption,,0,0,0,,ИНТЕРНЕТ В КАЖДОМ КУРЯТНИКЕ? ЕЙ ДЛЯ ВОЙНЫ НЕ НУЖНО,
Dialogue: 0,0:05:45.62,0:05:48.18,Caption,,0,0,0,,ЧТОБЫ ДЕДУШКА ГДЕ НИБУДЬ ПОСРЕДИ ОКЕАНА СМОТРЕЛ
Dialogue: 0,0:05:48.26,0:05:50.66,Caption,,0,0,0,,ЧЕРЕЗ "РАССВЕТ" РОЛИКИ ПРО ВЫРАЩИВАНИЕ ПОМИДОРОВ.
Dialogue: 0,0:05:51.04,0:05:54.50,Caption,,0,0,0,,ЗАДАЧА СОВЕРШЕННО ДРУГАЯ. СВЯЗЬ. ПЕРЕДАЧА ДАННЫХ.
Dialogue: 0,0:05:54.66,0:05:58.26,Caption,,0,0,0,,УПРАВЛЕНИЕ. РАБОТА БЕСПИЛОТНЫХ СИСТЕМ. ВОЗМОЖНОСТЬ
Dialogue: 0,0:05:58.34,0:06:00.26,Caption,,0,0,0,,ПЕРЕДАТЬ ИНФОРМАЦИЮ ТАМ И ТОГДА,
Dialogue: 0,0:06:00.49,0:06:06.54,Caption,,0,0,0,,ГДЕ ОНА НУЖНА ВОЕННЫМ. ВОТ ПО ЭТОЙ ЗАДАЧЕ СИСТЕМУ И НАДО ОЦЕНИВАТЬ.
Dialogue: 0,0:06:06.95,0:06:09.58,Caption,,0,0,0,,REUTERS СО ССЫЛКОЙ НА УКРАИНСКУЮ РАЗВЕДКУ ПИШЕТ,
Dialogue: 0,0:06:09.80,0:06:12.46,Caption,,0,0,0,,ЧТО СЕТЬ УЖЕ ИСПОЛЬЗУЕТСЯ ДЛЯ СВЯЗИ НАД УКРАИНОЙ.
Dialogue: 0,0:06:12.86,0:06:16.38,Caption,,0,0,0,,ДА, ГРУППИРОВКА ПОКА НАМНОГО МЕНЬШЕ STARLINK. ДА,
Dialogue: 0,0:06:16.58,0:06:19.74,Caption,,0,0,0,,НЕПРЕРЫВНОГО ГЛОБАЛЬНОГО ПОКРЫТИЯ НЕТ. НУ И ЧТО?
Dialogue: 0,0:06:19.82,0:06:22.70,Caption,,0,0,0,,БОЕВОЙ МОЛОТОК ТОЖЕ ПЛОХО УМЕЕТ ВАРИТЬ КОФЕ. ЭТО
Dialogue: 0,0:06:22.78,0:06:26.46,Caption,,0,0,0,,НЕ ЗНАЧИТ, ЧТО МОЛОТОК ПЛОХОЙ. ЕСЛИ ВОЕННЫМ НУЖЕН КАНАЛ В
Dialogue: 0,0:06:26.46,0:06:28.78,Caption,,0,0,0,,ОПРЕДЕЛЁННОМ РАЙОНЕ И В ОПРЕДЕЛЁННОЕ ВРЕМЯ,
Dialogue: 0,0:06:29.02,0:06:31.34,Caption,,0,0,0,,ИМ НЕ ТРЕБУЕТСЯ СНАЧАЛА НАКРЫТЬ СПУТНИКАМИ ВСЮ
Dialogue: 0,0:06:31.42,0:06:34.70,Caption,,0,0,0,,ПЛАНЕТУ. ТРИДЦАТЬ ДВА АППАРАТА УЖЕ ДАЮТ РАБОТАЮЩУЮ
Dialogue: 0,0:06:34.78,0:06:37.98,Caption,,0,0,0,,СИСТЕМУ. ДАЛЬШЕ ДОБАВЛЯЮТСЯ НОВЫЕ ЗАПУСКИ. ЗНАЧИТ
Dialogue: 0,0:06:37.98,0:06:40.22,Caption,,0,0,0,,КОЛИЧЕСТВО ДОСТУПНЫХ ОКОН СВЯЗИ РАСТЁТ,
Dialogue: 0,0:06:40.44,0:06:45.10,Caption,,0,0,0,,УСТОЙЧИВОСТЬ РАСТЁТ, ГЕОГРАФИЯ ПРИМЕНЕНИЯ РАСШИРЯЕТСЯ. И ВОТ ЭТО УЖЕ
Dialogue: 0,0:06:45.10,0:06:48.14,Caption,,0,0,0,,ИМЕЕТ ПРЯМОЕ ОТНОШЕНИЕ К НАШЕЙ ИСТОРИИ. ПОТОМУ ЧТО
Dialogue: 0,0:06:48.14,0:06:50.54,Caption,,0,0,0,,КОГДА МОСКВА ГОВОРИТ О ДАЛЬНЕЙШЕМ ДАВЛЕНИИ НА
Dialogue: 0,0:06:50.54,0:06:53.98,Caption,,0,0,0,,ИНФРАСТРУКТУРУ, НУЖНО СМОТРЕТЬ НЕ ТОЛЬКО НА КОЛИЧЕСТВО РАКЕТ И
Dialogue: 0,0:06:53.98,0:06:56.86,Caption,,0,0,0,,БЕСПИЛОТНИКОВ. НУЖНО СМОТРЕТЬ НА ВСЮ СИСТЕМУ,
Dialogue: 0,0:06:57.01,0:06:59.98,Caption,,0,0,0,,КОТОРАЯ ПОМОГАЕТ ЭТИМ СРЕДСТВАМ РАБОТАТЬ. РАЗВЕДКА.
Dialogue: 0,0:07:00.20,0:07:03.98,Caption,,0,0,0,,НАВИГАЦИЯ. СВЯЗЬ. ПЕРЕДАЧА КОМАНД. КОРРЕКТИРОВКА.
Dialogue: 0,0:07:04.20,0:07:07.02,Caption,,0,0,0,,ПОЛУЧЕНИЕ ДАННЫХ. "РАССВЕТ" ЗДЕСЬ НЕ ОТДЕЛЬНАЯ
Dialogue: 0,0:07:07.10,0:07:09.90,Caption,,0,0,0,,КОСМИЧЕСКАЯ ИГРУШКА. ЭТО ЕЩЁ ОДИН КУСОК БОЛЬШОЙ
Dialogue: 0,0:07:09.90,0:07:12.94,Caption,,0,0,0,,МАШИНЫ. И МАШИНА ПРОДОЛЖАЕТ ДОСТРАИВАТЬСЯ ПРЯМО ВО
Dialogue: 0,0:07:12.94,0:07:17.66,Caption,,0,0,0,,ВРЕМЯ КОНФЛИКТА. ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ТЕПЕРЬ К МАРКУ РЮТТЕ.
Dialogue: 0,0:07:19.94,0:07:22.50,Caption,,0,0,0,,ГЕНЕРАЛЬНЫЙ СЕКРЕТАРЬ НАТО ВДРУГ РЕШИЛ ПОМОЧЬ НАМ С
Dialogue: 0,0:07:22.50,0:07:25.22,Caption,,0,0,0,,РОССИЙСКОЙ ВОЕННОЙ ЭКОНОМИКОЙ. РЮТТЕ ПРИЗНАЁТ
Dialogue: 0,0:07:25.22,0:07:28.26,Caption,,0,0,0,,ПРОСТУЮ ВЕЩЬ НА ОДИНАКОВУЮ СУММУ РОССИЯ СПОСОБНА
Dialogue: 0,0:07:28.26,0:07:33.14,Caption,,0,0,0,,КУПИТЬ БОЛЬШЕ ВООРУЖЕНИЙ, ЧЕМ ЕВРОПЕЙСКИЕ СТРАНЫ НАТО. ВОТ ВЕДЬ НЕПРИЯТНОСТЬ.
Dialogue: 0,0:07:33.47,0:07:36.26,Caption,,0,0,0,,МНОГО ЛЕТ ЕВРОПЕЙСКАЯ ЛОГИКА ВЫГЛЯДЕЛА ПРИМЕРНО ТАК
Dialogue: 0,0:07:36.34,0:07:37.94,Caption,,0,0,0,,У НАС ЭКОНОМИКА НАМНОГО БОЛЬШЕ,
Dialogue: 0,0:07:38.18,0:07:42.82,Caption,,0,0,0,,ДЕНЕГ НАМНОГО БОЛЬШЕ, ЗНАЧИТ И ВОЗМОЖНОСТИ АВТОМАТИЧЕСКИ БОЛЬШЕ. А ПОТОМ
Dialogue: 0,0:07:42.82,0:07:45.94,Caption,,0,0,0,,ВЫЯСНИЛАСЬ МЕРЗКАЯ БЫТОВАЯ ДЕТАЛЬ. ВАЖНО НЕ ТОЛЬКО
Dialogue: 0,0:07:45.94,0:07:48.58,Caption,,0,0,0,,СКОЛЬКО ДЕНЕГ ЛЕЖИТ У ВАС В КОШЕЛЬКЕ. ВАЖНО
Dialogue: 0,0:07:48.58,0:07:52.10,Caption,,0,0,0,,ЕЩЁ, СКОЛЬКО ВЫ МОЖЕТЕ КУПИТЬ ЗА ЭТИ ДЕНЬГИ. МОЖНО
Dialogue: 0,0:07:52.10,0:07:54.26,Caption,,0,0,0,,ПРИЙТИ В МАГАЗИН С ТЫСЯЧЕЙ ЕВРО И КУПИТЬ
Dialogue: 0,0:07:54.34,0:07:56.50,Caption,,0,0,0,,ОДИН СТУЛ РУЧНОЙ РАБОТЫ ИЗ ЭКОЛОГИЧЕСКИ
Dialogue: 0,0:07:56.58,0:07:59.38,Caption,,0,0,0,,ОТВЕТСТВЕННОЙ ДРЕВЕСИНЫ С СЕРТИФИКАТОМ УСТОЙЧИВОГО
Dialogue: 0,0:07:59.38,0:08:01.94,Caption,,0,0,0,,РАЗВИТИЯ. А СОСЕД НА ТЕ ЖЕ ДЕНЬГИ КУПИТ
Dialogue: 0,0:08:01.94,0:08:04.82,Caption,,0,0,0,,ДВАДЦАТЬ ОБЫЧНЫХ СТУЛЬЕВ. КОГДА НАЧИНАЕТСЯ ДРАКА
Dialogue: 0,0:08:04.82,0:08:09.06,Caption,,0,0,0,,СТУЛЬЯМИ, СЕРТИФИКАТ ПОМОГАЕТ УЖЕ СЛАБОВАТО. РЮТТЕ ИМЕННО ОБ
Dialogue: 0,0:08:09.06,0:08:11.70,Caption,,0,0,0,,ЭТОМ И ГОВОРИТ. РОССИЙСКАЯ ЭКОНОМИКА В ВОЕННОМ
Dialogue: 0,0:08:11.70,0:08:14.58,Caption,,0,0,0,,ПРОИЗВОДСТВЕ ПОЛУЧАЕТ БОЛЬШЕ РЕЗУЛЬТАТА НА КАЖДЫЙ
Dialogue: 0,0:08:14.58,0:08:17.54,Caption,,0,0,0,,ВЛОЖЕННЫЙ РУБЛЬ В ПЕРЕСЧЁТЕ НА ЗАПАДНЫЕ РАСХОДЫ. И
Dialogue: 0,0:08:17.62,0:08:19.54,Caption,,0,0,0,,ПОЭТОМУ ОН УЖЕ ПРЕДЛАГАЕТ ЕВРОПЕЙСКИМ
Dialogue: 0,0:08:19.54,0:08:23.86,Caption,,0,0,0,,АВТОПРОИЗВОДИТЕЛЯМ ПОДУМАТЬ, ЧТО ВОЕННОГО ОНИ СПОСОБНЫ ВЫПУСКАТЬ НА СВОИХ
Dialogue: 0,0:08:23.86,0:08:27.46,Caption,,0,0,0,,ПРЕДПРИЯТИЯХ. ПРЕКРАСНАЯ ЭВОЛЮЦИЯ. ЕВРОПА МНОГО ЛЕТ
Dialogue: 0,0:08:27.54,0:08:30.98,Caption,,0,0,0,,ОБЪЯСНЯЛА РОССИИ, КАК НЕПРАВИЛЬНО ЖИТЬ С ВОЕННОЙ ЭКОНОМИКОЙ.
Dialogue: 0,0:08:33.27,0:08:35.59,Caption,,0,0,0,,ТЕПЕРЬ ЕВРОПЕЙСКОМУ АВТОПРОМУ ОБЪЯСНЯЮТ,
Dialogue: 0,0:08:35.89,0:08:37.91,Caption,,0,0,0,,КАК ПРАВИЛЬНО ДЕЛАТЬ ВОЕННУЮ ПРОДУКЦИЮ.
Dialogue: 0,0:08:38.47,0:08:41.43,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ВЕРНЁМСЯ К УЛЬТИМАТУМУ. ПРЕДСТАВЛЕНИЕ,
Dialogue: 0,0:08:41.52,0:08:43.83,Caption,,0,0,0,,ЧТО ЭТО ПРОСТО ЭМОЦИОНАЛЬНАЯ ФРАЗА ПУТИНА,
Dialogue: 0,0:08:44.08,0:08:47.27,Caption,,0,0,0,,ЗДЕСЬ НАЧИНАЕТ ПЛОХО РАБОТАТЬ. ЕСЛИ FINANCIAL TIMES
Dialogue: 0,0:08:47.33,0:08:49.51,Caption,,0,0,0,,ПРАВИЛЬНО ПЕРЕДАЛА ПЕРЕГОВОРНУЮ ПОЗИЦИЮ,
Dialogue: 0,0:08:49.75,0:08:52.55,Caption,,0,0,0,,МОСКВА ГОВОРИТ ПРИМЕРНО СЛЕДУЮЩЕЕ КИЕВ ПРОДОЛЖАЕТ
Dialogue: 0,0:08:52.63,0:08:56.71,Caption,,0,0,0,,ДАЛЬНИЕ УДАРЫ, РОССИЯ БУДЕТ ПОВЫШАТЬ ЦЕНУ. ПРИЧЁМ ПОВЫШАТЬ ЕЁ ЧЕРЕЗ
Dialogue: 0,0:08:56.71,0:09:01.11,Caption,,0,0,0,,ТУ ЧАСТЬ УКРАИНСКОЙ СИСТЕМЫ, КОТОРАЯ УЖЕ НАХОДИТСЯ ПОД ОГРОМНОЙ НАГРУЗКОЙ.
Dialogue: 0,0:09:01.33,0:09:04.07,Caption,,0,0,0,,ЭНЕРГЕТИКА ПОВРЕЖДЕНА. СТОЛИЦУ ГЕНЕРАТОРАМИ НЕ
Dialogue: 0,0:09:04.15,0:09:07.03,Caption,,0,0,0,,ЗАКРЫТЬ. ГОРОДСКИЕ ВЛАСТИ ГОТОВЯТСЯ К СЦЕНАРИЯМ,
Dialogue: 0,0:09:07.19,0:09:09.67,Caption,,0,0,0,,КОТОРЫЕ ЕЩЁ НЕДАВНО САМИ ВЫГЛЯДЕЛИ АНЕКДОТОМ.
Dialogue: 0,0:09:10.07,0:09:12.79,Caption,,0,0,0,,РОССИЙСКАЯ СПУТНИКОВАЯ ГРУППИРОВКА ДЛЯ ВОЕННЫХ ЗАДАЧ
Dialogue: 0,0:09:12.79,0:09:15.27,Caption,,0,0,0,,РАСТЁТ. РОССИЙСКАЯ ВОЕННАЯ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:09:15.51,0:09:17.59,Caption,,0,0,0,,ПО ПРИЗНАНИЮ САМОГО РУКОВОДИТЕЛЯ НАТО,
Dialogue: 0,0:09:17.85,0:09:21.11,Caption,,0,0,0,,ПОЛУЧАЕТ БОЛЬШЕ ПРОДУКЦИИ НА СОПОСТАВИМЫЕ ДЕНЬГИ. А
Dialogue: 0,0:09:21.11,0:09:23.19,Caption,,0,0,0,,КИЕВ В ЭТОТ МОМЕНТ ГОВОРИТ БУДЕМ БИТЬ ЕЩЁ
Dialogue: 0,0:09:23.27,0:09:25.67,Caption,,0,0,0,,ДАЛЬШЕ. ВОТ ЭТО И НАЗЫВАЕТСЯ ДВА ЧЕЛОВЕКА ИДУТ
Dialogue: 0,0:09:25.67,0:09:30.15,Caption,,0,0,0,,НАВСТРЕЧУ ДРУГ ДРУГУ, НО ПОЧЕМУ ТО КАЖДЫЙ ДЕРЖИТ КИРПИЧ. САМОЕ ГЛАВНОЕ
Dialogue: 0,0:09:30.23,0:09:34.31,Caption,,0,0,0,,ЗДЕСЬ ДАЖЕ НЕ ВОПРОС, КТО ПРАВ. ГЛАВНЫЙ ВОПРОС ГОРАЗДО ПРАКТИЧНЕЕ ЧЕЙ
Dialogue: 0,0:09:34.31,0:09:37.19,Caption,,0,0,0,,РАСЧЁТ ВЫДЕРЖИТ ДОЛЬШЕ? КИЕВ ИСХОДИТ ИЗ ТОГО,
Dialogue: 0,0:09:37.38,0:09:42.63,Caption,,0,0,0,,ЧТО УДАРЫ ПО РОССИЙСКИМ НПЗ, СКЛАДАМ И ДРУГИМ ОБЪЕКТАМ СОЗДАДУТ ДЛЯ МОСКВЫ ТАКУЮ
Dialogue: 0,0:09:42.63,0:09:45.35,Caption,,0,0,0,,ЦЕНУ, ЧТО ОНА СОГЛАСИТСЯ ИЗМЕНИТЬ УСЛОВИЯ.
Dialogue: 0,0:09:47.64,0:09:50.92,Caption,,0,0,0,,МОСКВА, СУДЯ ПО ОПИСАННОЙ FINANCIAL TIMES ПОЗИЦИИ,
Dialogue: 0,0:09:51.24,0:09:54.04,Caption,,0,0,0,,РЕШИЛА ЗЕРКАЛЬНО ПЕРЕВЕРНУТЬ ФОРМУЛУ. ХОТИТЕ
Dialogue: 0,0:09:54.04,0:09:58.68,Caption,,0,0,0,,ПРОВЕРЯТЬ НАШУ УСТОЙЧИВОСТЬ? ХОРОШО. ТОГДА МЫ БУДЕМ ПРОВЕРЯТЬ ВАШУ. ТОЛЬКО
Dialogue: 0,0:09:58.68,0:10:01.64,Caption,,0,0,0,,УСТОЙЧИВОСТЬ У СТОРОН РАЗНАЯ. У РОССИИ ОГРОМНАЯ
Dialogue: 0,0:10:01.64,0:10:04.04,Caption,,0,0,0,,ТЕРРИТОРИЯ, РАСПРЕДЕЛЁННАЯ ЭНЕРГЕТИКА,
Dialogue: 0,0:10:04.20,0:10:08.60,Caption,,0,0,0,,СОБСТВЕННОЕ ТОПЛИВО, БОЛЬШАЯ ПРОМЫШЛЕННАЯ БАЗА И ВОЗМОЖНОСТЬ ПЕРЕНОСИТЬ
Dialogue: 0,0:10:08.60,0:10:11.56,Caption,,0,0,0,,ЧАСТЬ НАГРУЗКИ ИЗ ОДНОГО РЕГИОНА В ДРУГОЙ. УКРАИНА
Dialogue: 0,0:10:11.56,0:10:14.68,Caption,,0,0,0,,МЕНЬШЕ. ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ГЕНЕРАЦИИ УЖЕ ПОВРЕЖДЕНА.
Dialogue: 0,0:10:14.84,0:10:17.88,Caption,,0,0,0,,СИСТЕМА РАБОТАЕТ ПОД ПОСТОЯННОЙ НАГРУЗКОЙ. РЕМОНТ
Dialogue: 0,0:10:17.96,0:10:20.68,Caption,,0,0,0,,ИДЁТ ОДНОВРЕМЕННО С НОВЫМИ ПОВРЕЖДЕНИЯМИ. ЭТО НЕ
Dialogue: 0,0:10:20.68,0:10:24.12,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ОДНИМ НАЖАТИЕМ КНОПКИ ВСЁ ВЫКЛЮЧАЕТСЯ НАВСЕГДА.
Dialogue: 0,0:10:24.45,0:10:27.08,Caption,,0,0,0,,НО ДЛЯ ДАВЛЕНИЯ ВОВСЕ НЕ ОБЯЗАТЕЛЬНО ВЫКЛЮЧАТЬ ВСЁ
Dialogue: 0,0:10:27.08,0:10:29.24,Caption,,0,0,0,,НАВСЕГДА. ДОСТАТОЧНО СДЕЛАТЬ ТАК,
Dialogue: 0,0:10:29.40,0:10:32.12,Caption,,0,0,0,,ЧТОБЫ КАЖДЫЙ СЛЕДУЮЩИЙ МЕСЯЦ ТРЕБОВАЛ ВСЁ БОЛЬШЕ
Dialogue: 0,0:10:32.12,0:10:37.32,Caption,,0,0,0,,ОБОРУДОВАНИЯ, ДЕНЕГ, ЛЮДЕЙ, РЕМОНТОВ И РЕЗЕРВОВ. РАЗРУШИЛИ ОБЪЕКТ. ЕГО
Dialogue: 0,0:10:37.32,0:10:40.44,Caption,,0,0,0,,ВОССТАНОВИЛИ. ПОВРЕДИЛИ ДРУГОЙ. ПЕРЕКЛЮЧИЛИ СЕТЬ.
Dialogue: 0,0:10:40.71,0:10:43.72,Caption,,0,0,0,,УДАРИЛИ ПО СЛЕДУЮЩЕМУ УЗЛУ. И ВСЯ СИСТЕМА НАЧИНАЕТ
Dialogue: 0,0:10:43.72,0:10:48.44,Caption,,0,0,0,,ЖИТЬ НЕ НОРМАЛЬНОЙ ЖИЗНЬЮ, А ПОСТОЯННЫМ РЕМОНТОМ САМОЙ СЕБЯ. ВОТ ЭТО ГОРАЗДО
Dialogue: 0,0:10:48.44,0:10:51.32,Caption,,0,0,0,,НЕПРИЯТНЕЕ КРАСИВЫХ СТРЕЛОЧЕК НА КАРТЕ. ПОТОМУ ЧТО
Dialogue: 0,0:10:51.32,0:10:54.36,Caption,,0,0,0,,СТРЕЛОЧКИ МОЖНО РИСОВАТЬ ГОДАМИ. А ВОДУ ЧЕЛОВЕКУ
Dialogue: 0,0:10:54.36,0:10:57.40,Caption,,0,0,0,,НУЖНО УТРОМ. ЭЛЕКТРИЧЕСТВО НУЖНО ВЕЧЕРОМ. МЕТРО
Dialogue: 0,0:10:57.40,0:11:00.68,Caption,,0,0,0,,ДОЛЖНО ЕХАТЬ. НАСОС ДОЛЖЕН КАЧАТЬ. ТЕПЛО ДОЛЖНО
Dialogue: 0,0:11:00.68,0:11:06.25,Caption,,0,0,0,,ИДТИ. И ЕСЛИ ВСЁ ЭТО ПРЕВРАЩАЕТСЯ В ЕЖЕДНЕВНУЮ ИНЖЕНЕРНУЮ
Dialogue: 0,0:11:06.25,0:11:09.77,Caption,,0,0,0,,ЛОТЕРЕЮ, ПОЛИТИЧЕСКАЯ ЦЕНА КОНФЛИКТА НАЧИНАЕТ СЧИТАТЬСЯ УЖЕ
Dialogue: 0,0:11:09.85,0:11:12.09,Caption,,0,0,0,,НЕ ТОЛЬКО КИЛОМЕТРАМИ ТЕРРИТОРИИ. И ЗДЕСЬ
Dialogue: 0,0:11:12.09,0:11:14.65,Caption,,0,0,0,,ВОЗВРАЩАЕМСЯ К СЛОВАМ СИБИГИ ЧЕМ ДАЛЬШЕ УКРАИНА
Dialogue: 0,0:11:14.65,0:11:18.49,Caption,,0,0,0,,СПОСОБНА БИТЬ, ТЕМ БЛИЖЕ КОНЕЦ. ХОРОШО. НО У ЭТОЙ ФОРМУЛЫ
Dialogue: 0,0:11:18.57,0:11:21.37,Caption,,0,0,0,,ТЕПЕРЬ ПОЯВИЛАСЬ ВТОРАЯ ПОЛОВИНА. ЧЕМ ДАЛЬШЕ УКРАИНА
Dialogue: 0,0:11:21.45,0:11:24.25,Caption,,0,0,0,,БЬЁТ ПО РОССИИ, ТЕМ ЖЁСТЧЕ МОСКВА ОБЪЯСНЯЕТ,
Dialogue: 0,0:11:24.41,0:11:27.29,Caption,,0,0,0,,ЧТО БУДЕТ ДЕЛАТЬ С УКРАИНСКОЙ ИНФРАСТРУКТУРОЙ. А
Dialogue: 0,0:11:27.37,0:11:30.25,Caption,,0,0,0,,ДАЛЬШЕ ВОПРОС УЖЕ АРИФМЕТИЧЕСКИЙ. КТО БЫСТРЕЕ
Dialogue: 0,0:11:30.33,0:11:32.01,Caption,,0,0,0,,ПРИБЛИЗИТ КОНЕЦ К ТОМУ ВАРИАНТУ,
Dialogue: 0,0:11:32.25,0:11:36.49,Caption,,0,0,0,,КОТОРЫЙ СЧИТАЕТ ПОБЕДОЙ? ИМЕННО ПОЭТОМУ ИСТОРИЯ С УСЛОВИЯМИ АНКОРИДЖА
Dialogue: 0,0:11:36.49,0:11:39.93,Caption,,0,0,0,,СТАНОВИТСЯ ВАЖНЕЕ ОДНОЙ ГРОМКОЙ ЦИТАТЫ. ЕСЛИ МОСКВА
Dialogue: 0,0:11:39.93,0:11:42.33,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО УВЯЗАЛА ПРЕКРАЩЕНИЕ ДАВЛЕНИЯ С
Dialogue: 0,0:11:42.41,0:11:44.33,Caption,,0,0,0,,ПРИНЯТИЕМ ОПРЕДЕЛЁННОГО НАБОРА УСЛОВИЙ,
Dialogue: 0,0:11:44.73,0:11:47.21,Caption,,0,0,0,,ТОГДА ИНФРАСТРУКТУРНАЯ КАМПАНИЯ ПРЕВРАЩАЕТСЯ ИЗ
Dialogue: 0,0:11:47.29,0:11:49.93,Caption,,0,0,0,,НАБОРА ОТДЕЛЬНЫХ УДАРОВ В ИНСТРУМЕНТ ПЕРЕГОВОРНОГО
Dialogue: 0,0:11:49.93,0:11:52.73,Caption,,0,0,0,,ДАВЛЕНИЯ. НЕ ОБЯЗАТЕЛЬНО КАЖДЫЙ ОБЪЕКТ ВЫБИРАТЬ
Dialogue: 0,0:11:52.81,0:11:54.73,Caption,,0,0,0,,ЛИЧНО ЗА БОЛЬШИМ КРЕМЛЁВСКИМ СТОЛОМ,
Dialogue: 0,0:11:54.89,0:11:58.17,Caption,,0,0,0,,ТКНУВ ПАЛЬЦЕМ В КАРТУ. СМЫСЛ НАМНОГО ПРОЩЕ. У
Dialogue: 0,0:11:58.17,0:12:00.89,Caption,,0,0,0,,КИЕВА ДОЛЖНА ПОСТОЯННО РАСТИ ЦЕНА ПРОДОЛЖЕНИЯ
Dialogue: 0,0:12:00.89,0:12:03.85,Caption,,0,0,0,,ПРЕЖНЕГО КУРСА. И ЗДЕСЬ ЕСТЬ НЕПРИЯТНАЯ ВЕЩЬ,
Dialogue: 0,0:12:03.94,0:12:06.89,Caption,,0,0,0,,КОТОРУЮ ЧАСТО ЗАБЫВАЮТ. УЛЬТИМАТУМ РАБОТАЕТ НЕ
Dialogue: 0,0:12:06.97,0:12:09.53,Caption,,0,0,0,,ТОГДА, КОГДА ЧЕЛОВЕК ГРОМКО СТУКНУЛ КУЛАКОМ.
Dialogue: 0,0:12:11.81,0:12:15.81,Caption,,0,0,0,,ОН РАБОТАЕТ ТОГДА, КОГДА ВТОРАЯ СТОРОНА ПОНИМАЕТ ЧЕЛОВЕК ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:12:15.81,0:12:19.01,Caption,,0,0,0,,СПОСОБЕН ВЫПОЛНИТЬ СЛЕДУЮЩУЮ ЧАСТЬ ПРЕДЛОЖЕНИЯ. ВОТ
Dialogue: 0,0:12:19.01,0:12:21.49,Caption,,0,0,0,,ПОЭТОМУ РАЗГОВОР О СПУТНИКАХ, ГЕНЕРАТОРАХ,
Dialogue: 0,0:12:21.73,0:12:23.81,Caption,,0,0,0,,ПОВРЕЖДЁННЫХ ЭЛЕКТРОСТАНЦИЯХ И ВОЕННОЙ
Dialogue: 0,0:12:23.81,0:12:26.77,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ ЗДЕСЬ ВООБЩЕ НЕ ВТОРОСТЕПЕННЫЙ. ЭТО И
Dialogue: 0,0:12:26.77,0:12:31.33,Caption,,0,0,0,,ЕСТЬ ОТВЕТ НА ВОПРОС, ПОЧЕМУ ТОН МОГ СТАТЬ ТАКИМ РЕЗКИМ. МОСКВА СМОТРИТ
Dialogue: 0,0:12:31.41,0:12:34.29,Caption,,0,0,0,,НА СВОИ ВОЗМОЖНОСТИ. КИЕВ СМОТРИТ НА СВОИ. И
Dialogue: 0,0:12:34.29,0:12:37.25,Caption,,0,0,0,,КАЖДЫЙ СЧИТАЕТ, ЧТО ДРУГОЙ ПЕРВЫМ СКАЖЕТ ВСЁ,
Dialogue: 0,0:12:37.41,0:12:41.17,Caption,,0,0,0,,ДОСТАТОЧНО. ТОЛЬКО ПОКА ПРОИСХОДИТ ОБРАТНОЕ. СИБИГА
Dialogue: 0,0:12:41.17,0:12:45.01,Caption,,0,0,0,,ГОВОРИТ, ЧТО УДАРЫ ПРОДОЛЖАТСЯ. РОССИЯ ПРОДОЛЖАЕТ УВЕЛИЧИВАТЬ
Dialogue: 0,0:12:45.01,0:12:49.73,Caption,,0,0,0,,ДАВЛЕНИЕ. ЕВРОПА ОБСУЖДАЕТ, КАК НАРАЩИВАТЬ СОБСТВЕННОЕ ВОЕННОЕ ПРОИЗВОДСТВО.
Dialogue: 0,0:12:50.04,0:12:52.21,Caption,,0,0,0,,РОССИЙСКАЯ СПУТНИКОВАЯ ГРУППИРОВКА РАСТЁТ.
Dialogue: 0,0:12:52.45,0:12:55.25,Caption,,0,0,0,,УКРАИНСКИЕ ГОРОДА ИЩУТ ВСЁ БОЛЕЕ ТЯЖЁЛЫЕ ВАРИАНТЫ
Dialogue: 0,0:12:55.25,0:12:57.97,Caption,,0,0,0,,РЕЗЕРВНОЙ ЖИЗНИ. И ВОТ ЗДЕСЬ ВОЗНИКАЕТ МЫСЛЬ,
Dialogue: 0,0:12:58.20,0:13:00.29,Caption,,0,0,0,,КОТОРАЯ МНЕ КАЖЕТСЯ ГОРАЗДО ВАЖНЕЕ САМОГО
Dialogue: 0,0:13:00.29,0:13:03.33,Caption,,0,0,0,,УЛЬТИМАТУМА. КОГДА СТОРОНЫ НАЧИНАЮТ СТРОИТЬ ВСЁ
Dialogue: 0,0:13:03.33,0:13:06.93,Caption,,0,0,0,,БОЛЬШЕ ИНСТРУМЕНТОВ ДЛЯ ТОГО, ЧТОБЫ ЗАСТАВИТЬ ДРУГ ДРУГА УСТУПИТЬ,
Dialogue: 0,0:13:07.25,0:13:09.73,Caption,,0,0,0,,САМИ ПЕРЕГОВОРЫ ПОСТЕПЕННО ПРЕВРАЩАЮТСЯ В
Dialogue: 0,0:13:09.73,0:13:12.77,Caption,,0,0,0,,СОРЕВНОВАНИЕ ЭТИХ ИНСТРУМЕНТОВ. У КОГО РАНЬШЕ
Dialogue: 0,0:13:12.77,0:13:16.13,Caption,,0,0,0,,СЛОМАЕТСЯ РАСЧЁТ. У КОГО ЗАКОНЧИТСЯ ЗАПАС ПРОЧНОСТИ.
Dialogue: 0,0:13:16.53,0:13:19.65,Caption,,0,0,0,,КТО ПЕРВЫМ РЕШИТ, ЧТО СЛЕДУЮЩИЙ ШАГ СТОИТ ДОРОЖЕ,
Dialogue: 0,0:13:19.88,0:13:24.09,Caption,,0,0,0,,ЧЕМ СОГЛАШЕНИЕ. И ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:13:24.25,0:13:27.21,Caption,,0,0,0,,ЧТО КАЖДЫЙ НОВЫЙ ИНСТРУМЕНТ ДАВЛЕНИЯ ПОСЛЕ ПОЯВЛЕНИЯ
Dialogue: 0,0:13:27.29,0:13:29.93,Caption,,0,0,0,,УЖЕ НЕ ЛЕЖИТ СПОКОЙНО НА ПОЛКЕ. ЕГО НАЧИНАЮТ
Dialogue: 0,0:13:29.93,0:13:33.13,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ. НОВЫЕ ДАЛЬНОБОЙНЫЕ СРЕДСТВА ПОЛУЧАЮТ
Dialogue: 0,0:13:33.21,0:13:36.41,Caption,,0,0,0,,НОВЫЕ ЦЕЛИ. НОВАЯ СПУТНИКОВАЯ СВЯЗЬ ПОМОГАЕТ НОВЫМ
Dialogue: 0,0:13:36.41,0:13:39.29,Caption,,0,0,0,,СРЕДСТВАМ РАБОТАТЬ. НОВАЯ ВОЕННАЯ ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:13:39.29,0:13:42.57,Caption,,0,0,0,,ВЫПУСКАЕТ НОВЫЕ ПАРТИИ. НОВЫЕ ПОВРЕЖДЕНИЯ ТРЕБУЮТ
Dialogue: 0,0:13:42.65,0:13:45.53,Caption,,0,0,0,,НОВЫХ РЕМОНТОВ. А ПОЛИТИКИ ПРОДОЛЖАЮТ ГОВОРИТЬ,
Dialogue: 0,0:13:45.76,0:13:48.81,Caption,,0,0,0,,ЧТО ИМЕННО СЛЕДУЮЩИЙ ШАГ НАКОНЕЦ ЗАСТАВИТ ДРУГУЮ
Dialogue: 0,0:13:48.81,0:13:52.97,Caption,,0,0,0,,СТОРОНУ УСТУПИТЬ. ВОТ ТОЛЬКО КОГДА ОБЕ СТОРОНЫ ОДНОВРЕМЕННО РЕШИЛИ
Dialogue: 0,0:13:52.97,0:13:56.89,Caption,,0,0,0,,ПОДНЯТЬ СТАВКИ, ФРАЗА "ЕЩЁ НЕМНОГО НАДАВИМ" СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:13:56.89,0:13:59.53,Caption,,0,0,0,,ОПАСНОЙ. ПОТОМУ ЧТО ОДНАЖДЫ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:13:59.69,0:14:02.65,Caption,,0,0,0,,ЧТО ТОРГ ДАВНО ЗАКОНЧИЛСЯ. А СТАВКИ ПРОДОЛЖАЛИ
Dialogue: 0,0:14:02.65,0:14:03.85,Caption,,0,0,0,,ПОДНИМАТЬ ПО ПРИВЫЧКЕ.
