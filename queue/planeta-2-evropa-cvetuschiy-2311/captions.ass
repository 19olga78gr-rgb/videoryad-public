Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,В ЕВРОПЕ ИЗОБРЕЛИ УНИВЕРСАЛЬНЫЙ ОТВЕТ ДЛЯ ТЕХ,
Dialogue: 0,0:00:02.93,0:00:05.56,Caption,,0,0,0,,КТО СЛИШКОМ ВНИМАТЕЛЬНО СМОТРИТ НА СЧЁТ. ДЕНЬГИ
Dialogue: 0,0:00:05.56,0:00:08.28,Caption,,0,0,0,,НИКУДА НЕ ПРОПАЛИ. ОНИ ПРОСТО ОТПРАВИЛИСЬ В БУДУЩЕЕ
Dialogue: 0,0:00:08.36,0:00:09.88,Caption,,0,0,0,,И ОДНАЖДЫ ВЕРНУТСЯ С ПРИБЫЛЬЮ.
Dialogue: 0,0:00:10.47,0:00:13.16,Caption,,0,0,0,,ИМЕННО ТАК ФРИДРИХ МЕРЦ ТЕПЕРЬ ОБЪЯСНЯЕТ НЕМЦАМ
Dialogue: 0,0:00:13.16,0:00:15.80,Caption,,0,0,0,,РАСХОДЫ НА УКРАИНУ. ПО СЛОВАМ КАНЦЛЕРА,
Dialogue: 0,0:00:16.04,0:00:18.84,Caption,,0,0,0,,НЫНЕШНИЕ ВЛОЖЕНИЯ ОКУПЯТСЯ ДЛЯ ГЕРМАНИИ МНОГОКРАТНО.
Dialogue: 0,0:00:19.16,0:00:21.88,Caption,,0,0,0,,СХЕМА ВЫГЛЯДИТ БЕЗУПРЕЧНО БЕРЛИН ПЛАТИТ СЕЙЧАС,
Dialogue: 0,0:00:22.11,0:00:24.44,Caption,,0,0,0,,А НАГРАДУ ЗАБИРАЕТ ПОЗЖЕ. ПРАВДА,
Dialogue: 0,0:00:24.64,0:00:27.16,Caption,,0,0,0,,КОММУНАЛЬНЫЕ СЧЕТА ПРИХОДЯТ ПОЧЕМУ ТО СЕЙЧАС И
Dialogue: 0,0:00:27.16,0:00:29.56,Caption,,0,0,0,,КАТЕГОРИЧЕСКИ ОТКАЗЫВАЮТСЯ ЖДАТЬ ОБЕЩАННОГО
Dialogue: 0,0:00:29.56,0:00:32.76,Caption,,0,0,0,,ПРОЦВЕТАНИЯ. ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНЫ РАЗБОРЫ,
Dialogue: 0,0:00:32.92,0:00:35.56,Caption,,0,0,0,,В КОТОРЫХ СУММЫ ГОВОРЯТ ГРОМЧЕ ТОРЖЕСТВЕННЫХ РЕЧЕЙ.
Dialogue: 0,0:00:36.24,0:00:39.08,Caption,,0,0,0,,МЕРЦ УВЕРЯЕТ, ЧТО РОССИЯ НЕ СМОЖЕТ ПОБЕДИТЬ,
Dialogue: 0,0:00:39.44,0:00:42.04,Caption,,0,0,0,,А ГЕРМАНИЯ УЖЕ ПРЕВРАТИЛАСЬ В ГЛАВНОГО ЗАЩИТНИКА
Dialogue: 0,0:00:42.04,0:00:45.48,Caption,,0,0,0,,УКРАИНЫ, ОСОБЕННО В ВОЕННОЙ СФЕРЕ. БЕРЛИН ПРОДОЛЖАЕТ
Dialogue: 0,0:00:45.48,0:00:47.64,Caption,,0,0,0,,ПОСТАВЛЯТЬ ДАЛЬНОБОЙНЫЕ БЕСПИЛОТНИКИ,
Dialogue: 0,0:00:47.73,0:00:50.92,Caption,,0,0,0,,АРТИЛЛЕРИЮ И БОЕПРИПАСЫ. ПОСЛЕ НАЧАЛА КОНФЛИКТА
Dialogue: 0,0:00:51.00,0:00:53.56,Caption,,0,0,0,,НЕМЕЦКИЕ КОМПАНИИ ЯКОБЫ НЕ ПОКИНУЛИ УКРАИНСКИЙ
Dialogue: 0,0:00:53.64,0:00:56.92,Caption,,0,0,0,,РЫНОК, А ИХ КОЛИЧЕСТВО ТАМ ВЫРОСЛО ПОЧТИ ВТРОЕ. ТАКИМ
Dialogue: 0,0:00:56.92,0:01:00.52,Caption,,0,0,0,,ОБРАЗОМ, ПОДДЕРЖКА КИЕВА ПРОДАЁТСЯ НЕМЕЦКОМУ ОБЩЕСТВУ СРАЗУ В
Dialogue: 0,0:01:00.52,0:01:03.32,Caption,,0,0,0,,ДВУХ УПАКОВКАХ. СНАЧАЛА КАК ЗАЩИТА ЕВРОПЫ,
Dialogue: 0,0:01:03.56,0:01:10.79,Caption,,0,0,0,,ЗАТЕМ КАК ВЫГОДНОЕ ВЛОЖЕНИЕ. МАРКУС ФРОНМАЙЕР ИЗ АДГ ОТКРЫВАЕТ ДРУГУЮ ВЕДОМОСТЬ И
Dialogue: 0,0:01:10.79,0:01:14.63,Caption,,0,0,0,,СПРАШИВАЕТ, ПОЧЕМУ МИЛЛИАРДЫ ДЛЯ УКРАИНЫ ОБНАРУЖИВАЮТСЯ БЕЗ
Dialogue: 0,0:01:14.63,0:01:18.15,Caption,,0,0,0,,ДОЛГИХ ПОИСКОВ, А ОБЛЕГЧИТЬ РАСХОДЫ СОБСТВЕННЫХ ГРАЖДАН
Dialogue: 0,0:01:18.23,0:01:19.75,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО НИКАК НЕ СОБЕРЁТСЯ.
Dialogue: 0,0:01:20.62,0:01:22.47,Caption,,0,0,0,,С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА ГЕРМАНИЯ
Dialogue: 0,0:01:22.47,0:01:25.99,Caption,,0,0,0,,ПРЕДОСТАВИЛА ЛИБО ЗАРЕЗЕРВИРОВАЛА СВЫШЕ СОРОКА ПЯТИ
Dialogue: 0,0:01:25.99,0:01:28.79,Caption,,0,0,0,,ЦЕЛЫХ СЕМИ ДЕСЯТЫХ МИЛЛИАРДА ЕВРО ГРАЖДАНСКОЙ
Dialogue: 0,0:01:28.79,0:01:32.23,Caption,,0,0,0,,ПОМОЩИ. ВОЕННАЯ ЧАСТЬ ДОСТИГЛА ПРИМЕРНО ПЯТИДЕСЯТИ
Dialogue: 0,0:01:32.31,0:01:35.43,Caption,,0,0,0,,СЕМИ ЦЕЛЫХ ВОСЬМИ ДЕСЯТЫХ МИЛЛИАРДА. ВМЕСТЕ ВЫХОДИТ
Dialogue: 0,0:01:35.43,0:01:38.31,Caption,,0,0,0,,БОЛЬШЕ СТА МИЛЛИАРДОВ ЕВРО. ПРИ ТАКОЙ СУММЕ
Dialogue: 0,0:01:38.31,0:01:41.03,Caption,,0,0,0,,РЕКЛАМНОЙ ФРАЗЫ О БУДУЩЕЙ ВЫГОДЕ УЖЕ НЕДОСТАТОЧНО.
Dialogue: 0,0:01:41.28,0:01:45.19,Caption,,0,0,0,,НЕМЦАМ ХОЧЕТСЯ ЗНАТЬ, ИЗ ЧЬЕГО КАРМАНА ДЕНЬГИ ДОСТАЮТ СЕЙЧАС И В
Dialogue: 0,0:01:45.27,0:01:47.91,Caption,,0,0,0,,ЧЕЙ КАРМАН КОГДА НИБУДЬ ПОЛОЖАТ ПРИБЫЛЬ. ГЛАВА
Dialogue: 0,0:01:47.91,0:01:50.39,Caption,,0,0,0,,НЕМЕЦКОГО МИД ЙОХАНН ВАДЕФУЛЬ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:01:50.39,0:01:53.19,Caption,,0,0,0,,ПРЕДЛАГАЕТ ГОСУДАРСТВАМ ЕВРОСОЮЗА СПРАВЕДЛИВЕЕ
Dialogue: 0,0:01:53.19,0:01:56.07,Caption,,0,0,0,,РАЗДЕЛИТЬ ЗАТРАТЫ НА ПОМОЩЬ УКРАИНЕ ПРЕДСТОЯЩЕЙ
Dialogue: 0,0:01:56.07,0:01:59.27,Caption,,0,0,0,,ЗИМОЙ. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ ИНВЕСТИЦИЯ. ГРАЖДАНЕ
Dialogue: 0,0:01:59.35,0:02:02.63,Caption,,0,0,0,,ГЕРМАНИИ ТОЖЕ ВКЛЮЧИЛИСЬ В ПОДСЧЁТЫ. ОПРОС ИНСА ДЛЯ
Dialogue: 0,0:02:02.63,0:02:06.63,Caption,,0,0,0,,БИЛЬД ПОКАЗАЛ, ЧТО ПЯТЬДЕСЯТ ВОСЕМЬ ПРОЦЕНТОВ НЕМЦЕВ ВЫСТУПАЮТ ЗА
Dialogue: 0,0:02:06.63,0:02:09.75,Caption,,0,0,0,,ДОСРОЧНЫЕ ВЫБОРЫ В БУНДЕСТАГ. ЛИШЬ ДВАДЦАТЬ ШЕСТЬ
Dialogue: 0,0:02:09.75,0:02:12.63,Caption,,0,0,0,,ПРОЦЕНТОВ ХОТЯТ, ЧТОБЫ КОАЛИЦИЯ ХДС,
Dialogue: 0,0:02:12.64,0:02:15.67,Caption,,0,0,0,,ХСС И СДПГ ОСТАВАЛАСЬ У ВЛАСТИ ДО ДВЕ
Dialogue: 0,0:02:15.75,0:02:17.19,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ДЕВЯТОГО ГОДА.
Dialogue: 0,0:02:19.48,0:02:21.80,Caption,,0,0,0,,У АДГ ТАКИХ ВОСЕМЬДЕСЯТ ПЯТЬ ПРОЦЕНТОВ,
Dialogue: 0,0:02:21.97,0:02:23.56,Caption,,0,0,0,,У ЛЕВОЙ ПАРТИИ СЕМЬДЕСЯТ ПЯТЬ,
Dialogue: 0,0:02:23.88,0:02:28.68,Caption,,0,0,0,,У СВДП ШЕСТЬДЕСЯТ ЧЕТЫРЕ. ДАЖЕ ЭЛЕКТОРАТ ЗЕЛЁНЫХ РАСКОЛОЛСЯ НЕ В ПОЛЬЗУ
Dialogue: 0,0:02:28.68,0:02:31.64,Caption,,0,0,0,,СПОКОЙСТВИЯ. СОРОК СЕМЬ ПРОЦЕНТОВ ПОДДЕРЖИВАЮТ
Dialogue: 0,0:02:31.64,0:02:36.04,Caption,,0,0,0,,РАННИЕ ВЫБОРЫ, СОРОК ОДИН ПРОЦЕНТ ВОЗРАЖАЕТ. СПИСАТЬ ВСЁ НА ВЕЧНОЕ
Dialogue: 0,0:02:36.04,0:02:38.52,Caption,,0,0,0,,НЕДОВОЛЬСТВО ПРАВОГО ФЛАНГА УЖЕ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:02:38.93,0:02:40.84,Caption,,0,0,0,,КОАЛИЦИИ ОСТАЁТСЯ ТОЛЬКО ДЕЛАТЬ ВИД,
Dialogue: 0,0:02:41.10,0:02:43.48,Caption,,0,0,0,,БУДТО ЛЮДИ СОБРАЛИСЬ ТАМ ИСКЛЮЧИТЕЛЬНО РАДИ
Dialogue: 0,0:02:43.48,0:02:46.60,Caption,,0,0,0,,ОТОПЛЕНИЯ. ИССЛЕДОВАНИЕ ЮГОВ ДЛЯ ВЕЛЬТ АМ ЗОНТАГ
Dialogue: 0,0:02:46.60,0:02:48.92,Caption,,0,0,0,,ДОБАВЛЯЕТ К ЭТОЙ КАРТИНЕ УКРАИНСКИЙ ВОПРОС.
Dialogue: 0,0:02:49.12,0:02:51.40,Caption,,0,0,0,,ПОЛНОСТЬЮ ПРЕКРАТИТЬ ПОМОЩЬ ХОТЯТ ДВАДЦАТЬ ПЯТЬ
Dialogue: 0,0:02:51.40,0:02:54.52,Caption,,0,0,0,,ПРОЦЕНТОВ ОПРОШЕННЫХ. СОКРАТИТЬ ЕЁ ПРЕДЛАГАЮТ ЕЩЁ
Dialogue: 0,0:02:54.52,0:02:57.32,Caption,,0,0,0,,ДВАДЦАТЬ ЧЕТЫРЕ ПРОЦЕНТА. СОХРАНЕНИЕ НЫНЕШНЕГО
Dialogue: 0,0:02:57.40,0:02:59.40,Caption,,0,0,0,,ОБЪЁМА ПОДДЕРЖИВАЮТ ТРИДЦАТЬ ПРОЦЕНТОВ,
Dialogue: 0,0:02:59.60,0:03:02.36,Caption,,0,0,0,,УВЕЛИЧЕНИЕ ВСЕГО ДЕВЯТЬ. ИТОГ НЕПРИЯТЕН ДЛЯ
Dialogue: 0,0:03:02.44,0:03:04.84,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА. СОРОК ДЕВЯТЬ ПРОЦЕНТОВ ТРЕБУЮТ
Dialogue: 0,0:03:04.84,0:03:07.16,Caption,,0,0,0,,УМЕНЬШИТЬ РАСХОДЫ ЛИБО ЗАКРЫТЬ ПРОГРАММУ,
Dialogue: 0,0:03:07.40,0:03:09.88,Caption,,0,0,0,,ТОГДА КАК ТРИДЦАТЬ ДЕВЯТЬ ПРОЦЕНТОВ ГОТОВЫ ОСТАВИТЬ
Dialogue: 0,0:03:09.88,0:03:13.16,Caption,,0,0,0,,ВСЁ КАК ЕСТЬ ИЛИ ДАТЬ БОЛЬШЕ. ОДИННАДЦАТЬ ПРОЦЕНТОВ
Dialogue: 0,0:03:13.24,0:03:16.28,Caption,,0,0,0,,ПОКА НЕ ВЫБРАЛИ СТОРОНУ. ЕЩЁ СОРОК ДЕВЯТЬ ПРОЦЕНТОВ
Dialogue: 0,0:03:16.28,0:03:19.08,Caption,,0,0,0,,НЕМЦЕВ ПОДДЕРЖАЛИ СКОРЫЙ РАЗГОВОР МЕРЦА С ПУТИНЫМ
Dialogue: 0,0:03:19.30,0:03:21.64,Caption,,0,0,0,,БЕЗ ПРЕДВАРИТЕЛЬНЫХ УСТУПОК СО СТОРОНЫ МОСКВЫ.
Dialogue: 0,0:03:22.20,0:03:24.92,Caption,,0,0,0,,ЗА ПЕРЕГОВОРЫ ВЫСТУПАЕТ И БОЛЬШИНСТВО СТОРОННИКОВ
Dialogue: 0,0:03:24.92,0:03:30.57,Caption,,0,0,0,,ХДС И ХСС. КАНЦЛЕР ОБЕЩАЕТ ПРИБЫЛЬ ОТ ПРОДОЛЖЕНИЯ ПРЕЖНЕГО
Dialogue: 0,0:03:30.57,0:03:33.61,Caption,,0,0,0,,КУРСА, А ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ЕГО СОБСТВЕННОЙ АУДИТОРИИ
Dialogue: 0,0:03:33.61,0:03:35.93,Caption,,0,0,0,,ПРОСИТ ХОТЯ БЫ ОТКРЫТЬ ДРУГОЙ КАНАЛ СВЯЗИ.
Dialogue: 0,0:03:36.48,0:03:39.69,Caption,,0,0,0,,ТЕПЕРЬ ВМЕСТО ПРЕДПОЛОЖЕНИЯ ЕСТЬ ПРОЦЕНТЫ. ОППОЗИЦИИ
Dialogue: 0,0:03:39.69,0:03:44.25,Caption,,0,0,0,,ДОСТАТОЧНО СПРОСИТЬ, ПОЧЕМУ НОВЫЙ ПАКЕТ КИЕВУ СОГЛАСОВЫВАЮТ ПРОВОРНЕЕ,
Dialogue: 0,0:03:44.41,0:03:47.05,Caption,,0,0,0,,ЧЕМ ПОМОЩЬ ПРОМЫШЛЕННОСТИ ВНУТРИ ГЕРМАНИИ. У
Dialogue: 0,0:03:47.05,0:03:49.77,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА ВСТРЕЧНЫЙ ХОД ТОЖЕ ГОТОВ. БЕРЛИН
Dialogue: 0,0:03:49.77,0:03:53.77,Caption,,0,0,0,,ТРЕБУЕТ, ЧТОБЫ ОСТАЛЬНЫЕ УЧАСТНИКИ ЕВРОСОЮЗА ВЗЯЛИ НА СЕБЯ
Dialogue: 0,0:03:53.77,0:03:56.17,Caption,,0,0,0,,БОЛЬШУЮ ЧАСТЬ НАГРУЗКИ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:03:56.41,0:04:00.09,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ВИДЕТЬ, КАК ГРОМКИЕ РЕШЕНИЯ ВЫГЛЯДЯТ ПОСЛЕ ВСТРЕЧИ С
Dialogue: 0,0:04:00.09,0:04:02.41,Caption,,0,0,0,,КАЛЬКУЛЯТОРОМ. А ТЕПЕРЬ ПЕРЕЙДЁМ К ТОМУ,
Dialogue: 0,0:04:02.71,0:04:05.93,Caption,,0,0,0,,КАК ЭТИ СПОРЫ ОТРАЖАЮТСЯ НА САМИХ ПЛАТЕЖАХ. ДЛЯ
Dialogue: 0,0:04:05.93,0:04:09.21,Caption,,0,0,0,,КИЕВА ЗАДЕРЖКА ИМЕЕТ ВПОЛНЕ МАТЕРИАЛЬНОЕ ЗНАЧЕНИЕ.
Dialogue: 0,0:04:09.60,0:04:12.73,Caption,,0,0,0,,ПОКА ЕВРОПЕЙСКИЕ СТОЛИЦЫ ВЫЯСНЯЮТ ДОЛИ И ГАРАНТИИ,
Dialogue: 0,0:04:12.89,0:04:15.53,Caption,,0,0,0,,СЛЕДУЮЩИЙ ТРАНШ ОСТАЁТСЯ В ПЕРЕГОВОРНЫХ КОМНАТАХ.
Dialogue: 0,0:04:16.00,0:04:18.73,Caption,,0,0,0,,ОБЕЩАННОЙ СУММОЙ НЕЛЬЗЯ ЗАКРЫТЬ БЮДЖЕТНУЮ ДЫРУ,
Dialogue: 0,0:04:18.97,0:04:20.81,Caption,,0,0,0,,ПОКА У НЕЁ НЕТ СРОКА ПЕРЕЧИСЛЕНИЯ.
Dialogue: 0,0:04:21.76,0:04:24.65,Caption,,0,0,0,,В НЕМЕЦКИХ МУНИЦИПАЛИТЕТАХ НЕХВАТКА СРЕДСТВ УЖЕ
Dialogue: 0,0:04:24.65,0:04:27.77,Caption,,0,0,0,,ДОБРАЛАСЬ ДО РОЖДЕСТВЕНСКИХ ПРОГРАММ. В РЯДЕ ГОРОДОВ
Dialogue: 0,0:04:27.77,0:04:30.89,Caption,,0,0,0,,ОТКАЗАЛИСЬ ОТ ЯРМАРОК. БЕРЛИН ОТМЕНИЛ ФЕСТИВАЛЬ
Dialogue: 0,0:04:30.97,0:04:35.69,Caption,,0,0,0,,БЕРЛИН ВИНТЕР ДРИМ, А ГАМБУРГ СОКРАТИЛ ПРАЗДНИЧНУЮ ПРОГРАММУ. КОНЕЧНО,
Dialogue: 0,0:04:35.93,0:04:38.49,Caption,,0,0,0,,ДЕНЬГИ НА ГОРОДСКИЕ ГУЛЯНИЯ И ПОМОЩЬ УКРАИНЕ
Dialogue: 0,0:04:38.49,0:04:41.29,Caption,,0,0,0,,ПРОХОДЯТ ПО РАЗНЫМ СТРОКАМ. НО ИЗБИРАТЕЛЬ ВИДИТ
Dialogue: 0,0:04:41.29,0:04:44.01,Caption,,0,0,0,,РЕЗУЛЬТАТ БЕЗ БУХГАЛТЕРСКОГО ОБРАЗОВАНИЯ.
Dialogue: 0,0:04:46.29,0:04:48.69,Caption,,0,0,0,,ФЕДЕРАЛЬНАЯ ВЛАСТЬ РАССКАЗЫВАЕТ О ГРЯДУЩЕЙ
Dialogue: 0,0:04:48.69,0:04:51.97,Caption,,0,0,0,,МНОГОКРАТНОЙ ОТДАЧЕ, А МЕСТНАЯ АДМИНИСТРАЦИЯ СООБЩАЕТ,
Dialogue: 0,0:04:52.29,0:04:55.25,Caption,,0,0,0,,ЧТО СЕЙЧАС ДАЖЕ ГИРЛЯНДЫ НЕ ПО КАРМАНУ. БУДУЩАЯ
Dialogue: 0,0:04:55.25,0:05:00.21,Caption,,0,0,0,,СТАБИЛЬНОСТЬ СИЯЕТ ЯРКО, ПРОСТО ЁЛКА ПОД НЕЙ ВЫКЛЮЧЕНА. ОДНОВРЕМЕННО ГЕРМАНИЯ
Dialogue: 0,0:05:00.21,0:05:03.25,Caption,,0,0,0,,ГОТОВИТ БОЛЕЕ СТРОГИЕ УСЛОВИЯ ДЛЯ УКРАИНЦЕВ И ДРУГИХ
Dialogue: 0,0:05:03.25,0:05:05.73,Caption,,0,0,0,,ИНОСТРАНЦЕВ. ХРИСТИАНСКИЕ ДЕМОКРАТЫ ПРЕДЛАГАЮТ
Dialogue: 0,0:05:05.73,0:05:07.89,Caption,,0,0,0,,УВЕЛИЧИТЬ НЕОБХОДИМЫЙ СРОК ПРОЖИВАНИЯ ПЕРЕД
Dialogue: 0,0:05:07.89,0:05:10.93,Caption,,0,0,0,,ПОЛУЧЕНИЕМ ГРАЖДАНСТВА С ПЯТИ ДО ВОСЬМИ ЛЕТ. ЗНАНИЕ
Dialogue: 0,0:05:10.93,0:05:13.33,Caption,,0,0,0,,НЕМЕЦКОГО ХОТЯТ ПОДНЯТЬ С УРОВНЯ БИ ОДИН ДО
Dialogue: 0,0:05:13.33,0:05:16.85,Caption,,0,0,0,,БИ ДВА, А ДВА ГРАЖДАНСТВА РАЗРЕШАТЬ ЛИШЬ В ОСОБЫХ СЛУЧАЯХ.
Dialogue: 0,0:05:17.34,0:05:20.05,Caption,,0,0,0,,ЕСТЬ И ТРЕБОВАНИЕ НЕ ПОЛЬЗОВАТЬСЯ СОЦИАЛЬНОЙ ПОМОЩЬЮ
Dialogue: 0,0:05:20.13,0:05:23.01,Caption,,0,0,0,,В ТЕЧЕНИЕ ВСЕГО СРОКА ОЖИДАНИЯ ГРАЖДАНСТВА. ДЛЯ
Dialogue: 0,0:05:23.01,0:05:26.13,Caption,,0,0,0,,РАБОТАЮЩИХ ИНОСТРАНЦЕВ И ТЕХ, КТО ПОЛУЧАЕТ ПРОФЕССИЮ,
Dialogue: 0,0:05:26.35,0:05:30.13,Caption,,0,0,0,,НАПРОТИВ, СОБИРАЮТСЯ РАСШИРИТЬ ВОЗМОЖНОСТИ ОФОРМЛЕНИЯ ВИДА НА
Dialogue: 0,0:05:30.13,0:05:33.57,Caption,,0,0,0,,ЖИТЕЛЬСТВО. ПОСЛАНИЕ ЧИТАЕТСЯ БЕЗ ПЕРЕВОДЧИКА ЯЗЫК,
Dialogue: 0,0:05:33.81,0:05:36.69,Caption,,0,0,0,,РАБОТА И САМОСТОЯТЕЛЬНЫЙ ДОХОД СТАНОВЯТСЯ ПРОПУСКОМ,
Dialogue: 0,0:05:36.93,0:05:40.45,Caption,,0,0,0,,СОЦИАЛЬНЫЕ ВЫПЛАТЫ ПРЕВРАЩАЮТСЯ В ШЛАГБАУМ. МНОГИЕ
Dialogue: 0,0:05:40.45,0:05:43.89,Caption,,0,0,0,,УКРАИНЦЫ, ПРИЕХАВШИЕ ПОСЛЕ НАЧАЛА ПОЛНОМАСШТАБНЫХ БОЕВЫХ
Dialogue: 0,0:05:43.89,0:05:47.49,Caption,,0,0,0,,ДЕЙСТВИЙ, УЖЕ ПРИБЛИЖАЛИСЬ К МОМЕНТУ ВОЗМОЖНОЙ НАТУРАЛИЗАЦИИ.
Dialogue: 0,0:05:47.65,0:05:50.21,Caption,,0,0,0,,ТЕПЕРЬ ДИСТАНЦИЮ ПРЕДЛАГАЮТ УВЕЛИЧИТЬ ЕЩЁ НА ТРИ
Dialogue: 0,0:05:50.29,0:05:52.77,Caption,,0,0,0,,ГОДА. ЧЕЛОВЕК ПОЧТИ ДОШЁЛ ДО СТОЙКИ,
Dialogue: 0,0:05:53.09,0:05:55.89,Caption,,0,0,0,,А ЕЁ ВМЕСТЕ С СОТРУДНИКОМ АККУРАТНО ПЕРЕДВИНУЛИ В
Dialogue: 0,0:05:55.89,0:06:02.42,Caption,,0,0,0,,ДРУГОЙ КОНЕЦ КОРИДОРА. ПОЛЬША ПОСЛЕ ЗАВЕРШЕНИЯ ЛЬГОТ ДЛЯ БЕЖЕНЦЕВ ДЕЙСТВУЕТ
Dialogue: 0,0:06:02.42,0:06:05.94,Caption,,0,0,0,,ЕЩЁ СУРОВЕЕ. ЗА ОДНУ НОЧЬ РЕШЕНИЕ О НЕМЕДЛЕННОМ
Dialogue: 0,0:06:06.02,0:06:08.74,Caption,,0,0,0,,ВЫДВОРЕНИИ ПОЛУЧИЛ ДЕВЯНОСТО ОДИН ГРАЖДАНИН УКРАИНЫ.
Dialogue: 0,0:06:09.03,0:06:11.38,Caption,,0,0,0,,ПОД УГРОЗОЙ ОКАЗЫВАЮТСЯ ДАЖЕ ЛЮДИ С ОФИЦИАЛЬНОЙ
Dialogue: 0,0:06:11.38,0:06:15.22,Caption,,0,0,0,,ЗАНЯТОСТЬЮ. НЕСОВПАДЕНИЕ РЕАЛЬНОЙ РАБОТЫ С ДОКУМЕНТАМИ ЛИБО
Dialogue: 0,0:06:15.22,0:06:18.50,Caption,,0,0,0,,ОШИБКА РАБОТОДАТЕЛЯ ПРИ УВЕДОМЛЕНИИ МВД СПОСОБНА
Dialogue: 0,0:06:18.50,0:06:21.78,Caption,,0,0,0,,ЛИШИТЬ ЧЕЛОВЕКА ЗАКОННОГО СТАТУСА. ЧИСЛО ДЕПОРТАЦИЙ
Dialogue: 0,0:06:21.78,0:06:24.58,Caption,,0,0,0,,ИНОСТРАНЦЕВ ВЫРОСЛО ПРИМЕРНО С ТРЁХ ТЫСЯЧ В ДВЕ
Dialogue: 0,0:06:24.58,0:06:27.62,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ТРЕТЬЕМ ГОДУ ДО ДЕСЯТИ ТЫСЯЧ В
Dialogue: 0,0:06:27.70,0:06:30.98,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ. РОСТ ПРЕВЫШАЕТ ТРИ РАЗА.
Dialogue: 0,0:06:31.84,0:06:34.42,Caption,,0,0,0,,САМУЮ КРУПНУЮ ГРУППУ СРЕДИ ВЫСЛАННЫХ СОСТАВЛЯЮТ
Dialogue: 0,0:06:34.42,0:06:37.38,Caption,,0,0,0,,УКРАИНСКИЕ ГРАЖДАНЕ. ПОЛЬСКИЙ РЫНОК ТРУДА ДОЛГО
Dialogue: 0,0:06:37.38,0:06:40.66,Caption,,0,0,0,,ПРИГЛАШАЛ ИХ ВНУТРЬ, А ТЕПЕРЬ ВСЁ ВНИМАТЕЛЬНЕЕ ПРОВЕРЯЕТ,
Dialogue: 0,0:06:40.94,0:06:43.94,Caption,,0,0,0,,ПРАВИЛЬНО ЛИ ОНИ ВОШЛИ. ЛИТОВСКИЕ КОНСЕРВАТОРЫ
Dialogue: 0,0:06:43.94,0:06:46.66,Caption,,0,0,0,,ВЫБРАЛИ ДРУГОЙ УЧАСТОК. ОНИ ВНЕСЛИ В СЕЙМ
Dialogue: 0,0:06:46.66,0:06:50.66,Caption,,0,0,0,,ИНИЦИАТИВЫ, ЗАТРАГИВАВШИЕ ИМУЩЕСТВО И ПОЛОЖЕНИЕ КРУПНЕЙШЕЙ
Dialogue: 0,0:06:50.66,0:06:54.58,Caption,,0,0,0,,ПРАВОСЛАВНОЙ ОБЩИНЫ. ОДИН ЗАКОНОПРОЕКТ ПОЗВОЛЯЛ ВМЕШАТЬСЯ В СУДЬБУ
Dialogue: 0,0:06:54.58,0:06:58.66,Caption,,0,0,0,,ЦЕРКОВНОЙ СОБСТВЕННОСТИ, ВТОРОЙ МЕНЯЛ СТАТУС САМОЙ ОРГАНИЗАЦИИ.
Dialogue: 0,0:06:59.38,0:07:02.02,Caption,,0,0,0,,В ВИЛЬНЮСЕ ВСТРЕТИЛИСЬ СТО СОРОК ВОСЕМЬ ДЕЛЕГАТОВ.
Dialogue: 0,0:07:02.41,0:07:04.66,Caption,,0,0,0,,ОНИ ОТКАЗАЛИСЬ МЕНЯТЬ ЦЕРКОВНОЕ ПОДЧИНЕНИЕ ПО
Dialogue: 0,0:07:04.66,0:07:07.54,Caption,,0,0,0,,КОМАНДЕ ДЕПУТАТОВ. ЗАТЕМ ПАРЛАМЕНТСКИЕ ЮРИСТЫ
Dialogue: 0,0:07:07.54,0:07:11.94,Caption,,0,0,0,,НАПОМНИЛИ ИНИЦИАТОРАМ, ЧТО ЧАСТНУЮ СОБСТВЕННОСТЬ ЗАЩИЩАЕТ КОНСТИТУЦИЯ.
Dialogue: 0,0:07:14.22,0:07:16.54,Caption,,0,0,0,,ДЛЯ ИМУЩЕСТВЕННОЙ ЧАСТИ ПРОЕКТА ЭТО НАПОМИНАНИЕ
Dialogue: 0,0:07:16.62,0:07:19.42,Caption,,0,0,0,,ОКАЗАЛОСЬ СМЕРТЕЛЬНЫМ, И КОМИТЕТ ЕЁ ОСТАНОВИЛ.
Dialogue: 0,0:07:20.22,0:07:23.26,Caption,,0,0,0,,В ЛАТВИИ ЗАМАХНУЛИСЬ ШИРЕ. ПРЕМЬЕР АНДРИС КУЛБЕРГС
Dialogue: 0,0:07:23.26,0:07:26.22,Caption,,0,0,0,,ПРИЗВАЛ ЗАКРЫТЬ ВЪЕЗД В ЕВРОСОЮЗ ВСЕМ РОССИЙСКИМ
Dialogue: 0,0:07:26.30,0:07:30.78,Caption,,0,0,0,,ГРАЖДАНАМ. ПО ЕГО ЛОГИКЕ, СОТНИ ТЫСЯЧ ПУТЕШЕСТВЕННИКОВ НЕВОЗМОЖНО ПРОВЕРИТЬ,
Dialogue: 0,0:07:30.94,0:07:33.82,Caption,,0,0,0,,СЛЕДОВАТЕЛЬНО, БЕЗОПАСНЕЕ НЕ ПРОПУСКАТЬ НИКОГО.
Dialogue: 0,0:07:34.54,0:07:37.42,Caption,,0,0,0,,В ИЮНЕ ЛАТВИЯ ПОДДЕРЖАЛА ПРЕДЛОЖЕНИЕ ОГРАНИЧИТЬ
Dialogue: 0,0:07:37.42,0:07:40.46,Caption,,0,0,0,,ВЫДАЧУ ВИЗ РОССИЯНАМ. КУЛБЕРГС ТАКЖЕ СООБЩИЛ,
Dialogue: 0,0:07:40.76,0:07:44.38,Caption,,0,0,0,,ЧТО СПЕЦПОДРАЗДЕЛЕНИЯ ЛАТВИИ И ЭСТОНИИ ЗАДЕРЖАЛИ НА
Dialogue: 0,0:07:44.46,0:07:47.58,Caption,,0,0,0,,ЭСТОНСКОЙ ТЕРРИТОРИИ ВОСЕМЬ ЧЕЛОВЕК. ПО ЕГО ВЕРСИИ,
Dialogue: 0,0:07:47.72,0:07:50.38,Caption,,0,0,0,,ОНИ ПОЛУЧИЛИ ЗАДАНИЕ НАПАСТЬ НА ПРЕДПРИЯТИЕ,
Dialogue: 0,0:07:50.60,0:07:53.90,Caption,,0,0,0,,ПОМОГАЮЩЕЕ УКРАИНЕ. ВИНУ ПРЕМЬЕР ВОЗЛОЖИЛ НА РОССИЮ,
Dialogue: 0,0:07:54.20,0:07:56.86,Caption,,0,0,0,,ОДНАКО ОСНОВАНИЕ ОБВИНЕНИЯ ПУБЛИКЕ НЕ ОБЪЯСНИЛ.
Dialogue: 0,0:07:57.14,0:07:59.74,Caption,,0,0,0,,КУЛБЕРГС ОБВИНЯЕТ МОСКВУ В АТАКАХ НА УКРАИНСКОЕ
Dialogue: 0,0:07:59.74,0:08:02.86,Caption,,0,0,0,,ВОДОСНАБЖЕНИЕ, ОТОПЛЕНИЕ И ЭЛЕКТРИЧЕСКИЕ СЕТИ,
Dialogue: 0,0:08:03.10,0:08:05.74,Caption,,0,0,0,,А ТАКЖЕ В НАМЕРЕНИИ ЧЕРЕЗ ЭТИ УДАРЫ ПОВЛИЯТЬ
Dialogue: 0,0:08:05.82,0:08:08.78,Caption,,0,0,0,,НА ОБЩЕСТВЕННОЕ МНЕНИЕ ГЕРМАНИИ. ПРИ ЭТОМ ЛАТВИЙСКИЙ
Dialogue: 0,0:08:08.86,0:08:12.86,Caption,,0,0,0,,ПРЕМЬЕР ТРЕБУЕТ, ЧТОБЫ КРУПНЫЕ ЕВРОПЕЙСКИЕ ГОСУДАРСТВА НЕ УСТАВАЛИ ОТ
Dialogue: 0,0:08:12.94,0:08:17.90,Caption,,0,0,0,,КОНФЛИКТА. ОН ДАЖЕ УВЕРЯЕТ, ЧТО ПОМОЩЬ КИЕВУ НЕ МЕШАЕТ ВЫИГРЫВАТЬ ВЫБОРЫ.
Dialogue: 0,0:08:18.20,0:08:20.70,Caption,,0,0,0,,НЕМЕЦКИЕ ОПРОСЫ В ЭТОТ МОМЕНТ СКРОМНО КАШЛЯЮТ В
Dialogue: 0,0:08:20.70,0:08:22.62,Caption,,0,0,0,,УГЛУ, НО КУЛБЕРГС ИХ НЕ СЛЫШИТ.
Dialogue: 0,0:08:23.32,0:08:26.06,Caption,,0,0,0,,ВОЗВРАЩАТЬСЯ К НОРМАЛЬНЫМ ОТНОШЕНИЯМ С РОССИЕЙ ПОСЛЕ
Dialogue: 0,0:08:26.06,0:08:29.02,Caption,,0,0,0,,ЗАВЕРШЕНИЯ БОЕВЫХ ДЕЙСТВИЙ ОН ТОЖЕ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:08:31.31,0:08:34.11,Caption,,0,0,0,,ПРЕМЬЕР ОБЪЯВЛЯЕТ НАЧАЛО НОВОЙ ЭПОХИ. ПРИ ТАКОЙ
Dialogue: 0,0:08:34.11,0:08:36.43,Caption,,0,0,0,,КОНСТРУКЦИИ ПРЕКРАЩЕНИЕ ОГНЯ НИЧЕГО НЕ
Dialogue: 0,0:08:36.43,0:08:39.31,Caption,,0,0,0,,ПЕРЕЗАПУСКАЕТ. ДВЕРЬ В ПРОШЛОЕ ПРЕДЛАГАЕТСЯ НЕ
Dialogue: 0,0:08:39.31,0:08:42.99,Caption,,0,0,0,,ЗАКРЫТЬ, А СРАЗУ ЗАЛОЖИТЬ КИРПИЧОМ. ВСТРЕЧУ ТРАМПА,
Dialogue: 0,0:08:43.16,0:08:45.95,Caption,,0,0,0,,СИ ЦЗИНЬПИНА И ПУТИНА В ШЭНЬЧЖЭНЕ КУЛБЕРГС НАЗВАЛ
Dialogue: 0,0:08:45.96,0:08:49.07,Caption,,0,0,0,,УНИЖЕНИЕМ ПУТИНА. ЗАТЕМ ПОЯВЛЯЕТСЯ ПРЕКРАСНАЯ
Dialogue: 0,0:08:49.07,0:08:52.03,Caption,,0,0,0,,ПРОВЕРКА ПРИНЦИПОВ БЫТОВЫМИ НЕУДОБСТВАМИ. ЭСТОНИЯ
Dialogue: 0,0:08:52.03,0:08:55.23,Caption,,0,0,0,,СООБЩИЛА О ЗАКРЫТИИ ГРАНИЦЫ С РОССИЕЙ. ЛАТВИЙСКОЕ
Dialogue: 0,0:08:55.23,0:08:57.95,Caption,,0,0,0,,РУКОВОДСТВО ПОВТОРЯТЬ ТАКОЙ ШАГ У СЕБЯ ОТКАЗАЛОСЬ.
Dialogue: 0,0:08:58.27,0:09:01.39,Caption,,0,0,0,,ВСЕМУ ЕВРОСОЮЗУ ПРЕДЛАГАЕТСЯ ЗАХЛОПНУТЬ ОБЩУЮ ДВЕРЬ,
Dialogue: 0,0:09:01.71,0:09:04.19,Caption,,0,0,0,,НО СОБСТВЕННУЮ ПОКА ХОЧЕТСЯ ОСТАВИТЬ НА ПЕТЛЯХ.
Dialogue: 0,0:09:04.50,0:09:08.75,Caption,,0,0,0,,СМЕЛОСТЬ КОЛЛЕКТИВНАЯ, СКВОЗНЯК ТОЖЕ ЖЕЛАТЕЛЬНО РАСПРЕДЕЛИТЬ МЕЖДУ ВСЕМИ.
Dialogue: 0,0:09:09.47,0:09:12.11,Caption,,0,0,0,,ВО ФРАНЦИИ ЖАН ЛЮК МЕЛАНШОН ПРЕДЛАГАЕТ ИЗБИРАТЕЛЯМ
Dialogue: 0,0:09:12.11,0:09:14.51,Caption,,0,0,0,,СОВСЕМ ИНОЙ ДОГОВОР. ОН ОБЕЩАЕТ,
Dialogue: 0,0:09:14.69,0:09:16.83,Caption,,0,0,0,,ЧТО ПРИ НЁМ СТРАНА НЕ СТАНЕТ ВОЕВАТЬ С
Dialogue: 0,0:09:16.83,0:09:20.51,Caption,,0,0,0,,РОССИЕЙ. СЛЕДОМ ПОЛИТИК ДОБАВЛЯЕТ КИТАЙ И ЗАЯВЛЯЕТ,
Dialogue: 0,0:09:20.70,0:09:22.83,Caption,,0,0,0,,ЧТО НЕ ПОВЕДЁТ ФРАНЦИЮ НА ВОЙНУ ИЗ ЗА
Dialogue: 0,0:09:22.83,0:09:27.39,Caption,,0,0,0,,ТАЙВАНЯ. ТАКИМ ОБРАЗОМ, РЕЧЬ ИДЁТ УЖЕ НЕ ОБ ОДНОМ НАПРАВЛЕНИИ. ОТКАЗ
Dialogue: 0,0:09:27.47,0:09:29.95,Caption,,0,0,0,,ОТ УЧАСТИЯ СРАЗУ В ДВУХ КРУПНЫХ КОНФЛИКТАХ
Dialogue: 0,0:09:30.19,0:09:32.75,Caption,,0,0,0,,СТАНОВИТСЯ ЧАСТЬЮ ЕГО ПРЕЗИДЕНТСКОЙ КАМПАНИИ ДВЕ
Dialogue: 0,0:09:32.83,0:09:35.47,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА. ЕГО ОБРАЩЕНИЕ К
Dialogue: 0,0:09:35.47,0:09:38.19,Caption,,0,0,0,,ФРАНЦУЗАМ ПРЕДЕЛЬНО ПРЯМОЕ. ЕСЛИ ИМ НУЖНЫ
Dialogue: 0,0:09:38.19,0:09:40.75,Caption,,0,0,0,,РУКОВОДИТЕЛИ, ГОТОВЫЕ ОТПРАВЛЯТЬСЯ НА ВОЙНУ,
Dialogue: 0,0:09:40.94,0:09:42.83,Caption,,0,0,0,,ПУСТЬ ГОЛОСУЮТ ЗА ТАКИХ КАНДИДАТОВ.
Dialogue: 0,0:09:45.11,0:09:48.95,Caption,,0,0,0,,САМ МЕЛАНШОН СЧИТАЕТ, ЧТО ПАРИЖ ВТЯГИВАЮТ В ПРОТИВОСТОЯНИЯ,
Dialogue: 0,0:09:49.16,0:09:52.15,Caption,,0,0,0,,НЕ ОТВЕЧАЮЩИЕ ИНТЕРЕСАМ ФРАНЦИИ. НИКАКИХ СЛОЖНЫХ
Dialogue: 0,0:09:52.15,0:09:55.19,Caption,,0,0,0,,ДЕКОРАЦИЙ, ТОЛЬКО ПРЕДЛОЖЕНИЕ ЗАРАНЕЕ РЕШИТЬ,
Dialogue: 0,0:09:55.43,0:09:57.59,Caption,,0,0,0,,КТО ИМЕННО ПОТОМ БУДЕТ ПОЛУЧАТЬ ПОВЕСТКИ.
Dialogue: 0,0:09:58.18,0:09:59.99,Caption,,0,0,0,,ИСПАНИЯ ТЕМ ВРЕМЕНЕМ ПОКАЗАЛА,
Dialogue: 0,0:10:00.25,0:10:03.27,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО МОЖНО ЗАЙТИ ВО ВЗАИМНЫХ ОБВИНЕНИЯХ.
Dialogue: 0,0:10:03.66,0:10:06.31,Caption,,0,0,0,,ЕСЛИ СЛОЖИТЬ ЗАЯВЛЕНИЯ ПАРТИЙ О СВЯЗЯХ СОПЕРНИКОВ С
Dialogue: 0,0:10:06.31,0:10:08.95,Caption,,0,0,0,,МОСКВОЙ, ПОД ПОДОЗРЕНИЕ ПОПАДУТ СИЛЫ,
Dialogue: 0,0:10:09.19,0:10:12.31,Caption,,0,0,0,,РАСПОЛАГАЮЩИЕ ТРЕМЯСТАМИ СОРОКА ТРЕМЯ МАНДАТАМИ ИЗ
Dialogue: 0,0:10:12.31,0:10:14.87,Caption,,0,0,0,,ТРЁХСОТ ПЯТИДЕСЯТИ. ЭТО ОКОЛО ДЕВЯНОСТА ВОСЬМИ
Dialogue: 0,0:10:14.95,0:10:17.91,Caption,,0,0,0,,ПРОЦЕНТОВ ПАРЛАМЕНТА. ЕСЛИ ВЕРИТЬ ВСЕМ УЧАСТНИКАМ
Dialogue: 0,0:10:17.91,0:10:21.35,Caption,,0,0,0,,ОДНОВРЕМЕННО, РОССИЯ РУКОВОДИТ ИСПАНСКИМИ ПРАВЫМИ,
Dialogue: 0,0:10:21.42,0:10:24.71,Caption,,0,0,0,,ЛЕВЫМИ И РЕГИОНАЛЬНЫМИ СЕПАРАТИСТАМИ. ПРИЧЁМ
Dialogue: 0,0:10:24.79,0:10:27.35,Caption,,0,0,0,,ПОДОПЕЧНЫЕ МОСКВЫ ПОЧЕМУ ТО ПОСТОЯННО РУГАЮТСЯ И
Dialogue: 0,0:10:27.35,0:10:29.67,Caption,,0,0,0,,МЕШАЮТ ДРУГ ДРУГУ. НЕ УПРАВЛЕНИЕ,
Dialogue: 0,0:10:29.83,0:10:32.87,Caption,,0,0,0,,А НАСТОЯЩИЙ КАДРОВЫЙ ПОДВИГ. НЕПОНЯТНО ТОЛЬКО,
Dialogue: 0,0:10:33.03,0:10:35.67,Caption,,0,0,0,,ЧЕМ ПРОВИНИЛИСЬ ОСТАВШИЕСЯ СЕМЬ ДЕПУТАТОВ,
Dialogue: 0,0:10:35.99,0:10:38.47,Caption,,0,0,0,,КОТОРЫХ НЕ ПРИНЯЛИ В ЭТУ УДИВИТЕЛЬНУЮ СТРУКТУРУ.
Dialogue: 0,0:10:39.03,0:10:41.43,Caption,,0,0,0,,КОГДА МОСКОВСКУЮ СВЯЗЬ НАХОДЯТ ПОЧТИ У КАЖДОГО
Dialogue: 0,0:10:41.43,0:10:43.99,Caption,,0,0,0,,ПРОТИВНИКА, ПУБЛИКА ПЕРЕСТАЁТ СПРАШИВАТЬ,
Dialogue: 0,0:10:44.26,0:10:47.03,Caption,,0,0,0,,КТО ДЕЙСТВИТЕЛЬНО СВЯЗАН С РОССИЕЙ. ИНТЕРЕСНЕЕ
Dialogue: 0,0:10:47.11,0:10:50.07,Caption,,0,0,0,,СТАНОВИТСЯ ДРУГОЕ КАКАЯ ПАРТИЯ СЛЕДУЮЩЕЙ ВЫТАЩИТ
Dialogue: 0,0:10:50.07,0:10:53.35,Caption,,0,0,0,,МОСКВУ ИЗ ЯЩИКА И ПОПРОБУЕТ СТУКНУТЬ ЕЮ КОНКУРЕНТА.
Dialogue: 0,0:10:53.65,0:10:56.71,Caption,,0,0,0,,НА ЭТОМ ЕВРОПЕЙСКОМ ФОНЕ ГОТОВИТСЯ НОВЫЙ КРЕДИТ
Dialogue: 0,0:10:56.71,0:11:02.12,Caption,,0,0,0,,УКРАИНЕ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ ЕВРОКОМИССИЯ
Dialogue: 0,0:11:02.12,0:11:05.48,Caption,,0,0,0,,НАМЕРЕНА ПРЕДОСТАВИТЬ СОРОК ПЯТЬ МИЛЛИАРДОВ ЕВРО. ИЗ
Dialogue: 0,0:11:05.56,0:11:07.88,Caption,,0,0,0,,НИХ ДВАДЦАТЬ ПЯТЬ МИЛЛИАРДОВ ПРЕДНАЗНАЧЕНЫ ДЛЯ
Dialogue: 0,0:11:07.88,0:11:12.12,Caption,,0,0,0,,ВОЕННЫХ РАСХОДОВ, ЕЩЁ ДВАДЦАТЬ МИЛЛИАРДОВ ДЛЯ ПОДДЕРЖАНИЯ УКРАИНСКОГО
Dialogue: 0,0:11:12.12,0:11:15.00,Caption,,0,0,0,,БЮДЖЕТА. УРСУЛА ФОН ДЕР ЛЯЙЕН ЗАЯВЛЯЕТ,
Dialogue: 0,0:11:15.24,0:11:18.04,Caption,,0,0,0,,ЧТО ВОЗВРАЩАТЬ ЗАЁМ УКРАИНА НАЧНЁТ ЛИШЬ ПОСЛЕ
Dialogue: 0,0:11:18.04,0:11:20.84,Caption,,0,0,0,,ВЫПЛАТЫ РОССИЕЙ РЕПАРАЦИЙ. СРЕДСТВА ТРЕБУЮТСЯ
Dialogue: 0,0:11:20.84,0:11:23.88,Caption,,0,0,0,,НЕМЕДЛЕННО, ПОГАШЕНИЕ ЗАВИСИТ ОТ БУДУЩЕГО СОБЫТИЯ,
Dialogue: 0,0:11:24.08,0:11:26.92,Caption,,0,0,0,,А ГАРАНТИРОВАТЬ ВСЮ КОНСТРУКЦИЮ ДОЛЖЕН ОБЩИЙ БЮДЖЕТ
Dialogue: 0,0:11:26.92,0:11:29.64,Caption,,0,0,0,,ЕВРОСОЮЗА. ЗАЁМЩИК ПОЛУЧАЕТ ДЕНЬГИ,
Dialogue: 0,0:11:29.88,0:11:31.80,Caption,,0,0,0,,ПЛАТЕЛЬЩИК НАЗНАЧЕН НА БУДУЩЕЕ,
Dialogue: 0,0:11:31.98,0:11:34.92,Caption,,0,0,0,,ПОРУЧИТЕЛЕЙ ИЩУТ ПРЯМО СЕЙЧАС. РАНЕЕ УЖЕ БЫЛ
Dialogue: 0,0:11:34.92,0:11:38.12,Caption,,0,0,0,,ОФОРМЛЕН КРЕДИТ НА ДЕВЯНОСТО МИЛЛИАРДОВ ЕВРО. НОВУЮ
Dialogue: 0,0:11:38.12,0:11:41.40,Caption,,0,0,0,,СУММУ ПРЕДЛАГАЮТ ОБЕСПЕЧИТЬ ПОХОЖИМ СПОСОБОМ. ВАЛДИС
Dialogue: 0,0:11:41.40,0:11:44.20,Caption,,0,0,0,,ДОМБРОВСКИС ОБЪЯСНЯЕТ ПОТРЕБНОСТЬ УСИЛЕНИЕМ
Dialogue: 0,0:11:44.20,0:11:46.92,Caption,,0,0,0,,РОССИЙСКИХ УДАРОВ ПО ВАЖНОЙ ИНФРАСТРУКТУРЕ И
Dialogue: 0,0:11:46.92,0:11:51.32,Caption,,0,0,0,,УХУДШЕНИЕМ ТОРГОВЛИ, ПРЕЖДЕ ВСЕГО ЭКСПОРТА ЧЕРЕЗ ЧЁРНОЕ МОРЕ. НО КАК
Dialogue: 0,0:11:51.32,0:11:53.72,Caption,,0,0,0,,ТОЛЬКО ОБЩАЯ ИДЕЯ ДОХОДИТ ДО КОНКРЕТНЫХ
Dialogue: 0,0:11:53.72,0:11:57.40,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ, ЕВРОПЕЙСКОЕ ЕДИНСТВО НАЧИНАЕТ ВНИМАТЕЛЬНО ИЗУЧАТЬ
Dialogue: 0,0:11:57.40,0:12:00.52,Caption,,0,0,0,,ЗАПАСНЫЕ ВЫХОДЫ. ЧЕХИЯ, СЛОВАКИЯ,
Dialogue: 0,0:12:00.68,0:12:03.72,Caption,,0,0,0,,ВЕНГРИЯ И БОЛГАРИЯ ОТКАЗАЛИСЬ УЧАСТВОВАТЬ В
Dialogue: 0,0:12:03.72,0:12:05.56,Caption,,0,0,0,,ДАЛЬНЕЙШЕМ ФИНАНСИРОВАНИИ КИЕВА.
Dialogue: 0,0:12:07.84,0:12:12.00,Caption,,0,0,0,,ГЕРМАНИЯ, НАПРОТИВ, ТРЕБУЕТ ГАРАНТИЙ ОТ ПАРТНЁРОВ И УГРОЖАЕТ
Dialogue: 0,0:12:12.00,0:12:14.64,Caption,,0,0,0,,ЗАБЛОКИРОВАТЬ БЮДЖЕТ ЕВРОСОЮЗА НА ПЕРИОД С ДВЕ
Dialogue: 0,0:12:14.72,0:12:17.04,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ ТЫСЯЧИ ТРИДЦАТЬ
Dialogue: 0,0:12:17.04,0:12:20.48,Caption,,0,0,0,,ЧЕТВЁРТЫЙ ГОД. ТАК ЕВРОПЕЙСКАЯ СОЛИДАРНОСТЬ ПРОХОДИТ
Dialogue: 0,0:12:20.48,0:12:23.44,Caption,,0,0,0,,ПРОВЕРКУ ПОДПИСЬЮ. ПОКА РЕЧЬ ЗВУЧИТ СО СЦЕНЫ,
Dialogue: 0,0:12:23.59,0:12:26.48,Caption,,0,0,0,,СОГЛАСНЫ ПОЧТИ ВСЕ. КОГДА ПРИНОСЯТ ДОГОВОР,
Dialogue: 0,0:12:26.72,0:12:29.76,Caption,,0,0,0,,ЧАСТЬ УЧАСТНИКОВ ВНЕЗАПНО ВСПОМИНАЕТ О СРОЧНЫХ ДЕЛАХ
Dialogue: 0,0:12:30.08,0:12:33.28,Caption,,0,0,0,,И МЕДЛЕННО ОТОДВИГАЕТ РУЧКУ К СОСЕДУ. ДЛЯ УКРАИНЫ
Dialogue: 0,0:12:33.36,0:12:35.60,Caption,,0,0,0,,ЭТО ОЗНАЧАЕТ НЕ СПОР О КРАСИВЫХ ПРИНЦИПАХ,
Dialogue: 0,0:12:35.84,0:12:39.12,Caption,,0,0,0,,А РИСК ЗАДЕРЖКИ СРЕДСТВ. НЕТ СОГЛАСИЯ ПО ГАРАНТИЯМ,
Dialogue: 0,0:12:39.41,0:12:42.56,Caption,,0,0,0,,НЕТ БЫСТРОГО РЕШЕНИЯ ПО КРЕДИТУ. МОЖНО ПРОВЕСТИ ЕЩЁ
Dialogue: 0,0:12:42.56,0:12:45.92,Caption,,0,0,0,,ДЕСЯТОК ВСТРЕЧ И ПРОИЗНЕСТИ СЛОВО ПОДДЕРЖКА СОТНЮ
Dialogue: 0,0:12:45.92,0:12:48.64,Caption,,0,0,0,,РАЗ. УКРАИНСКОМУ МИНФИНУ ОТ ЭТОГО НЕ ПОЯВИТСЯ НИ
Dialogue: 0,0:12:48.64,0:12:52.64,Caption,,0,0,0,,ДАТА ПЕРЕВОДА, НИ ДЕНЬГИ НА СЧЁТЕ. ПАРАЛЛЕЛЬНО ЕВРОСОЮЗ
Dialogue: 0,0:12:52.64,0:12:55.68,Caption,,0,0,0,,ПЕРЕКРАИВАЕТ СОБСТВЕННЫЙ ДОЛГОСРОЧНЫЙ БЮДЖЕТ. ПРОЕКТ
Dialogue: 0,0:12:55.68,0:12:58.16,Caption,,0,0,0,,АНТОНИУ КОШТЫ НА ПЕРИОД С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:12:58.16,0:13:00.32,Caption,,0,0,0,,ВОСЬМОГО ПО ДВЕ ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ ГОД
Dialogue: 0,0:13:00.63,0:13:03.36,Caption,,0,0,0,,ПРЕДУСМАТРИВАЕТ РОСТ ОБОРОННЫХ РАСХОДОВ НА ДВЕСТИ
Dialogue: 0,0:13:03.36,0:13:06.48,Caption,,0,0,0,,ТРИДЦАТЬ ДВА ПРОЦЕНТА. ОДНОВРЕМЕННО ОБЩИЙ РАЗМЕР
Dialogue: 0,0:13:06.48,0:13:09.60,Caption,,0,0,0,,БЮДЖЕТА СОКРАЩАЮТ НА ДВЕСТИ ЧЕТЫРЕ МИЛЛИАРДА ЕВРО
Dialogue: 0,0:13:09.84,0:13:12.96,Caption,,0,0,0,,ОТНОСИТЕЛЬНО ПРЕДЛОЖЕНИЯ ЕВРОКОМИССИИ. ПОД УРЕЗАНИЕ
Dialogue: 0,0:13:13.04,0:13:15.60,Caption,,0,0,0,,ПОПАДАЮТ И ПРОГРАММЫ РАЗВИТИЯ РЕГИОНОВ. ЗНАЧИТ,
Dialogue: 0,0:13:15.98,0:13:18.24,Caption,,0,0,0,,ОБОРОННАЯ СТАТЬЯ РАЗДУВАЕТСЯ НЕ В ПУСТОТЕ.
Dialogue: 0,0:13:20.51,0:13:22.99,Caption,,0,0,0,,ЕЙ ОСВОБОЖДАЮТ МЕСТО ЗА СЧЁТ НАПРАВЛЕНИЙ,
Dialogue: 0,0:13:23.15,0:13:25.71,Caption,,0,0,0,,КОТОРЫМИ ЖИТЕЛИ ПОЛЬЗУЮТСЯ ВОЗЛЕ СОБСТВЕННОГО ДОМА.
Dialogue: 0,0:13:26.06,0:13:29.23,Caption,,0,0,0,,ВЫБОР НЕВОЗМОЖНО СПРЯТАТЬ ЗА СЛОЖНЫМИ ТАБЛИЦАМИ. НА
Dialogue: 0,0:13:29.31,0:13:31.23,Caption,,0,0,0,,ВООРУЖЕНИЕ НАПРАВЛЯЮТ ГОРАЗДО БОЛЬШЕ,
Dialogue: 0,0:13:31.50,0:13:36.75,Caption,,0,0,0,,ОБЩУЮ СУММУ ДЕЛАЮТ МЕНЬШЕ, РЕГИОНАЛЬНЫЕ ПРОГРАММЫ ПОЛУЧАЮТ НОЖНИЦЫ. КТО ТО
Dialogue: 0,0:13:36.75,0:13:38.75,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО ОПЛАТИТ ЭТОТ РАЗВОРОТ,
Dialogue: 0,0:13:38.99,0:13:42.11,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ЕГО ИМЯ НАПЕЧАТАЮТ МЕЛКИМ ШРИФТОМ. ПУТИН
Dialogue: 0,0:13:42.11,0:13:45.15,Caption,,0,0,0,,НАЗЫВАЕТ МИЛИТАРИЗАЦИЮ ЕВРОПЫ СЕРЬЁЗНОЙ УГРОЗОЙ ДЛЯ
Dialogue: 0,0:13:45.23,0:13:48.99,Caption,,0,0,0,,РОССИИ И УТВЕРЖДАЕТ, ЧТО ЕВРОПЕЙСКИЕ ОБЩЕСТВА НЕ ХОТЯТ НИ ГОНКИ
Dialogue: 0,0:13:48.99,0:13:53.47,Caption,,0,0,0,,ВООРУЖЕНИЙ, НИ ВОЙНЫ. ЕГО ОЦЕНКУ МОЖНО ПРИНИМАТЬ ЛИБО ОТВЕРГАТЬ.
Dialogue: 0,0:13:54.03,0:13:56.91,Caption,,0,0,0,,НО БЮДЖЕТ ЕВРОСОЮЗА САМ СТАВИТ БОЛЕЕ ПРАКТИЧНЫЙ
Dialogue: 0,0:13:56.91,0:13:59.95,Caption,,0,0,0,,ВОПРОС. ЕСЛИ ОДНА СТРОКА ВЫРАСТАЕТ НА ДВЕСТИ
Dialogue: 0,0:13:59.95,0:14:02.19,Caption,,0,0,0,,ТРИДЦАТЬ ДВА ПРОЦЕНТА ПРИ СОКРАЩЕНИИ ВСЕГО
Dialogue: 0,0:14:02.19,0:14:05.71,Caption,,0,0,0,,ДОКУМЕНТА, КАКУЮ СТРОКУ ЗАСТАВЯТ ПОДВИНУТЬСЯ СЛЕДУЮЩЕЙ?
Dialogue: 0,0:14:06.06,0:14:09.07,Caption,,0,0,0,,ВСЕ ЭТИ ЭПИЗОДЫ УСТРОЕНЫ ПО РАЗНОМУ. ГЕРМАНИЯ СПОРИТ
Dialogue: 0,0:14:09.15,0:14:12.03,Caption,,0,0,0,,О МИЛЛИАРДАХ ДЛЯ КИЕВА. ЛАТВИЯ ТРЕБУЕТ ЗАКРЫТЬ
Dialogue: 0,0:14:12.03,0:14:15.31,Caption,,0,0,0,,ЕВРОПУ, НЕ ЗАКРЫВАЯ СОБСТВЕННУЮ ГРАНИЦУ. ФРАНЦУЗСКИЙ
Dialogue: 0,0:14:15.31,0:14:17.95,Caption,,0,0,0,,КАНДИДАТ ОБЕЩАЕТ НЕ УЧАСТВОВАТЬ В ЧУЖИХ ВОЙНАХ.
Dialogue: 0,0:14:18.27,0:14:20.83,Caption,,0,0,0,,ИСПАНСКИЕ ПАРТИИ НАХОДЯТ МОСКВУ ПОЧТИ В КАЖДОЙ
Dialogue: 0,0:14:20.83,0:14:24.03,Caption,,0,0,0,,ПАРЛАМЕНТСКОЙ КОМНАТЕ. СВЯЗЫВАЕТ ИХ ОДИН ВОПРОС КТО
Dialogue: 0,0:14:24.03,0:14:27.07,Caption,,0,0,0,,ПРИНИМАЕТ МАСШТАБНОЕ РЕШЕНИЕ И КОМУ ЗАТЕМ ПРИНОСЯТ
Dialogue: 0,0:14:27.07,0:14:32.35,Caption,,0,0,0,,СЧЁТ. ОБЪЯВИТЬ НОВУЮ ЭПОХУ, ИСТОРИЧЕСКУЮ ПОДДЕРЖКУ ИЛИ НЕИЗБЕЖНУЮ ПОБЕДУ
Dialogue: 0,0:14:32.35,0:14:37.67,Caption,,0,0,0,,ДОВОЛЬНО ЛЕГКО. НАМНОГО ТРУДНЕЕ НАЗВАТЬ ПЛАТЕЛЬЩИКА,
Dialogue: 0,0:14:37.75,0:14:40.47,Caption,,0,0,0,,СУММУ И СРОК. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:14:40.76,0:14:44.39,Caption,,0,0,0,,ПОВЕРИЛИ БЫ ВЫ В ИНВЕСТИЦИЮ, У КОТОРОЙ ИЗВЕСТЕН ПЕРВЫЙ ВЗНОС,
Dialogue: 0,0:14:44.62,0:14:49.83,Caption,,0,0,0,,НО НЕ НАЗВАНА ДАТА ВОЗВРАТА. СЛЕДУЮЩИЙ БОЛЬШОЙ ЕВРОПЕЙСКИЙ СПОР РАЗГОРИТСЯ НЕ
Dialogue: 0,0:14:49.83,0:14:53.75,Caption,,0,0,0,,ВОКРУГ ТОГО, КТО ГРОМЧЕ ПООБЕЩАЛ ПОМОЩЬ. ОН НАЧНЁТСЯ ВОЗЛЕ
Dialogue: 0,0:14:53.83,0:14:58.07,Caption,,0,0,0,,ПОСЛЕДНЕЙ СВОБОДНОЙ СТРОКИ, ГДЕ КОМУ ТО ВСЁ РАВНО ПРИДЁТСЯ ПОСТАВИТЬ СВОЁ
Dialogue: 0,0:14:58.07,0:15:00.71,Caption,,0,0,0,,ИМЯ И ОПЛАТИТЬ ВЕСЬ ЭТОТ ЦВЕТУЩИЙ САД.
