Dialogue: 0,0:00:00.12,0:00:01.70,Caption,,0,0,0,,УКРАИНСКОЕ МИНИСТЕРСТВО ОБОРОНЫ
Dialogue: 0,0:00:01.70,0:00:03.48,Caption,,0,0,0,,ЗАИНТЕРЕСОВАЛОСЬ ДАЖЕ МУЖЧИНАМИ,
Dialogue: 0,0:00:03.72,0:00:05.32,Caption,,0,0,0,,КОТОРЫЕ ОФОРМЛЯЮТ ДОКУМЕНТЫ НА
Dialogue: 0,0:00:05.32,0:00:08.28,Caption,,0,0,0,,ПОСТОЯННОЕ ПРОЖИВАНИЕ ЗА ГРАНИЦЕЙ. КАЗАЛОСЬ БЫ,
Dialogue: 0,0:00:08.44,0:00:10.55,Caption,,0,0,0,,ЭТИМ ДОЛЖНА ЗАНИМАТЬСЯ МИГРАЦИОННАЯ
Dialogue: 0,0:00:10.55,0:00:13.47,Caption,,0,0,0,,СЛУЖБА. НО ТЕПЕРЬ ЭТИ СВЕДЕНИЯ ПОНАДОБИЛИСЬ ЕЩЁ И
Dialogue: 0,0:00:13.47,0:00:16.27,Caption,,0,0,0,,ВОЕННЫМ. ВОТ ТАКОЕ РАСШИРЕНИЕ КРУГА ЗНАКОМСТВ ПРИ
Dialogue: 0,0:00:16.27,0:00:18.97,Caption,,0,0,0,,ОФОРМЛЕНИИ ДОКУМЕНТОВ. А ДЛЯ ЧЕГО МИНИСТЕРСТВУ
Dialogue: 0,0:00:18.97,0:00:21.24,Caption,,0,0,0,,ОБОРОНЫ ПОНАДОБИЛСЯ ИМЕННО ЭТОТ СПИСОК?
Dialogue: 0,0:00:21.56,0:00:23.56,Caption,,0,0,0,,ОТВЕТ СТАНОВИТСЯ ГОРАЗДО ИНТЕРЕСНЕЕ,
Dialogue: 0,0:00:23.80,0:00:25.72,Caption,,0,0,0,,ЕСЛИ ПОСМОТРЕТЬ НЕ НА ОДНУ БУМАГУ,
Dialogue: 0,0:00:25.94,0:00:29.41,Caption,,0,0,0,,А СРАЗУ НА ВСЁ, ЧТО ПРОИСХОДИТ ВОКРУГ НЕЁ. КАБМИН
Dialogue: 0,0:00:29.41,0:00:32.32,Caption,,0,0,0,,ЗАПУСТИЛ ВЕРИФИКАЦИЮ ДАННЫХ МУЖЧИН. ПРИЧЁМ РЕЧЬ
Dialogue: 0,0:00:32.32,0:00:34.91,Caption,,0,0,0,,ИДЁТ НЕ ПРОСТО О ФАМИЛИИ И ДАТЕ РОЖДЕНИЯ.
Dialogue: 0,0:00:34.91,0:00:37.31,Caption,,0,0,0,,МИНОБОРОНЫ ПОЛУЧАЕТ РЕГИСТРАЦИОННЫЙ НОМЕР
Dialogue: 0,0:00:37.31,0:00:39.88,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКА, РЕКВИЗИТЫ ПАСПОРТА,
Dialogue: 0,0:00:40.11,0:00:42.92,Caption,,0,0,0,,УНИКАЛЬНЫЙ НОМЕР ЗАПИСИ В ДЕМОГРАФИЧЕСКОМ РЕЕСТРЕ,
Dialogue: 0,0:00:43.12,0:00:46.93,Caption,,0,0,0,,СВЕДЕНИЯ О ГРАЖДАНСТВЕ, ЗАРЕГИСТРИРОВАННОЕ МЕСТО ЖИТЕЛЬСТВА И
Dialogue: 0,0:00:46.93,0:00:49.48,Caption,,0,0,0,,ПРЕБЫВАНИЯ, А ЕЩЁ ИНФОРМАЦИЮ О МУЖЧИНАХ,
Dialogue: 0,0:00:49.64,0:00:51.29,Caption,,0,0,0,,КОТОРЫЕ ОФОРМЛЯЮТ ДОКУМЕНТЫ ДЛЯ
Dialogue: 0,0:00:51.29,0:00:53.24,Caption,,0,0,0,,ПОСТОЯННОГО ПРОЖИВАНИЯ ЗА ГРАНИЦЕЙ,
Dialogue: 0,0:00:53.47,0:00:55.61,Caption,,0,0,0,,ВМЕСТЕ С ЦИФРОВЫМИ ФОТОГРАФИЯМИ. В
Dialogue: 0,0:00:55.61,0:00:57.92,Caption,,0,0,0,,ОДНОМ ИЗ СООБЩЕНИЙ ФИГУРИРОВАЛ ВОЗРАСТ ОТ
Dialogue: 0,0:00:57.92,0:01:01.03,Caption,,0,0,0,,ВОСЕМНАДЦАТИ ДО ШЕСТИДЕСЯТИ ЛЕТ. В САМОМ ПОСТАНОВЛЕНИИ
Dialogue: 0,0:01:01.03,0:01:03.32,Caption,,0,0,0,,РЕЧЬ ИДЁТ УЖЕ О МУЖЧИНАХ ОТ СЕМНАДЦАТИ ДО
Dialogue: 0,0:01:03.32,0:01:06.70,Caption,,0,0,0,,ШЕСТИДЕСЯТИ. ТО ЕСТЬ КРУГ ДАЖЕ ШИРЕ. ФОРМАЛЬНАЯ ЗАДАЧА
Dialogue: 0,0:01:06.70,0:01:09.56,Caption,,0,0,0,,ПОНЯТНА ПРИВЕСТИ ГОСУДАРСТВЕННЫЕ БАЗЫ В ПОРЯДОК И
Dialogue: 0,0:01:09.56,0:01:15.05,Caption,,0,0,0,,СДЕЛАТЬ СВЕДЕНИЯ ТОЧНЫМИ. НО В НЫНЕШНЕЙ СИТУАЦИИ ТРУДНО НЕ
Dialogue: 0,0:01:15.05,0:01:18.44,Caption,,0,0,0,,ЗАМЕТИТЬ ДРУГОЕ. КОГДА СТРАНЕ ОСТРО НЕ ХВАТАЕТ ЛЮДЕЙ
Dialogue: 0,0:01:18.44,0:01:21.03,Caption,,0,0,0,,ДЛЯ АРМИИ, МАКСИМАЛЬНО ТОЧНЫЙ УЧЁТ МУЖЧИН
Dialogue: 0,0:01:21.03,0:01:24.10,Caption,,0,0,0,,СТАНОВИТСЯ УЖЕ НЕ ПРОСТО БУХГАЛТЕРИЕЙ. НАС СНОВА
Dialogue: 0,0:01:24.10,0:01:26.89,Caption,,0,0,0,,ПОСЧИТАЛИ. ПРИЧЁМ ТЕПЕРЬ РЕШИЛИ ПОСЧИТАТЬ ТАК,
Dialogue: 0,0:01:27.05,0:01:28.86,Caption,,0,0,0,,ЧТОБЫ НИКТО СЛУЧАЙНО НЕ ПОТЕРЯЛСЯ
Dialogue: 0,0:01:28.86,0:01:32.85,Caption,,0,0,0,,МЕЖДУ МИГРАЦИОННОЙ СЛУЖБОЙ, ДЕМОГРАФИЧЕСКИМ РЕЕСТРОМ И ВОИНСКИМ
Dialogue: 0,0:01:32.85,0:01:35.29,Caption,,0,0,0,,УЧЁТОМ. А ЕСЛИ БЕЗ КАНЦЕЛЯРСКИХ ВЫРАЖЕНИЙ,
Dialogue: 0,0:01:35.53,0:01:39.67,Caption,,0,0,0,,ВЛАСТИ ХОТЯТ ЗНАТЬ ОБО ВСЕХ, КОГО ЕЩЁ МОЖНО "БУСИФИЦИРОВАТЬ". ЕСЛИ
Dialogue: 0,0:01:39.67,0:01:41.98,Caption,,0,0,0,,ВАМ ИНТЕРЕСНА ТАКАЯ АНАЛИТИКА БЕЗ ДЛИННЫХ
Dialogue: 0,0:01:41.98,0:01:45.77,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКИХ РЕВЕРАНСОВ, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ И СМОТРИМ,
Dialogue: 0,0:01:45.93,0:01:48.94,Caption,,0,0,0,,ЧТО ПОЛУЧАЕТСЯ, КОГДА НЕСКОЛЬКО ВРОДЕ БЫ ОТДЕЛЬНЫХ
Dialogue: 0,0:01:48.94,0:01:51.65,Caption,,0,0,0,,НОВОСТЕЙ СКЛАДЫВАЮТСЯ В ОДНУ КАРТИНУ. И ВОТ ТУТ
Dialogue: 0,0:01:51.65,0:01:54.21,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ СЛЕДУЮЩИЙ КУСОК ЭТОЙ КАРТИНЫ. ПО
Dialogue: 0,0:01:54.21,0:01:56.25,Caption,,0,0,0,,СЛОВАМ ДЕПУТАТА АЛЕКСЕЯ ГОНЧАРЕНКО,
Dialogue: 0,0:01:56.33,0:01:58.18,Caption,,0,0,0,,В МИНИСТЕРСТВЕ ЭКОНОМИКИ РЕГУЛЯРНО
Dialogue: 0,0:01:58.18,0:02:01.45,Caption,,0,0,0,,ОБСУЖДАЮТ, КАК ВЫВЕСТИ ИЗ БРОНИ ОТ СТА ДО ТРЁХСОТ
Dialogue: 0,0:02:01.45,0:02:03.51,Caption,,0,0,0,,ТЫСЯЧ МУЖЧИН. МИНИСТР ЭКОНОМИКИ
Dialogue: 0,0:02:03.51,0:02:05.37,Caption,,0,0,0,,КРАВЧЕНКО, ПО СЛОВАМ ГОНЧАРЕНКО,
Dialogue: 0,0:02:05.61,0:02:07.77,Caption,,0,0,0,,ОБОЗНАЧИЛ ЭТОТ ВОПРОС КАК ОДИН ИЗ
Dialogue: 0,0:02:07.77,0:02:10.50,Caption,,0,0,0,,ПРИОРИТЕТНЫХ. ВОТ ЭТО УЖЕ СОВСЕМ ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:02:10.50,0:02:14.09,Caption,,0,0,0,,МИНИСТЕРСТВО ЭКОНОМИКИ ЗАНИМАЕТСЯ ЭКОНОМИКОЙ. ДЛЯ ЭКОНОМИКИ
Dialogue: 0,0:02:14.09,0:02:16.75,Caption,,0,0,0,,НУЖНЫ ПРЕДПРИЯТИЯ. ДЛЯ ПРЕДПРИЯТИЙ НУЖНЫ
Dialogue: 0,0:02:16.75,0:02:19.87,Caption,,0,0,0,,ЛЮДИ. КРИТИЧЕСКИ ВАЖНЫМ ПРЕДПРИЯТИЯМ ДЛЯ ЭТОГО И ДАЮТ
Dialogue: 0,0:02:19.87,0:02:21.69,Caption,,0,0,0,,ВОЗМОЖНОСТЬ БРОНИРОВАТЬ РАБОТНИКОВ.
Dialogue: 0,0:02:23.98,0:02:25.93,Caption,,0,0,0,,А ПОТОМ В ТОМ ЖЕ ГОСУДАРСТВЕ НАЧИНАЮТ
Dialogue: 0,0:02:25.93,0:02:29.10,Caption,,0,0,0,,ОБСУЖДАТЬ, КАК ИЗ ЭТОЙ БРОНИ ВЫТАЩИТЬ ЕЩЁ СТО,
Dialogue: 0,0:02:29.19,0:02:32.45,Caption,,0,0,0,,ДВЕСТИ, ТРИСТА ТЫСЯЧ ЧЕЛОВЕК. ТРУДОВЫЕ РЕСУРСЫ
Dialogue: 0,0:02:32.45,0:02:34.70,Caption,,0,0,0,,УЖЕ ПРОСТО РЕСУРСЫ. КАКАЯ СТРАНА,
Dialogue: 0,0:02:34.85,0:02:37.10,Caption,,0,0,0,,ТАКАЯ И ЭКОНОМИКА. И ВЕДЬ РЕЧЬ ИДЁТ НЕ
Dialogue: 0,0:02:37.10,0:02:39.28,Caption,,0,0,0,,ТОЛЬКО О НОВЫХ СПИСКАХ. ОДНОВРЕМЕННО
Dialogue: 0,0:02:39.28,0:02:42.06,Caption,,0,0,0,,ПЕРЕСМАТРИВАЮТ И ОТМЕНЯЮТ БРОНИРОВАНИЯ И ОТСРОЧКИ,
Dialogue: 0,0:02:42.30,0:02:44.30,Caption,,0,0,0,,В ТОМ ЧИСЛЕ ДЛЯ СОТРУДНИКОВ КРИТИЧЕСКИ
Dialogue: 0,0:02:44.30,0:02:46.86,Caption,,0,0,0,,ВАЖНЫХ ПРЕДПРИЯТИЙ. ТО ЕСТЬ САМА ЛОГИКА
Dialogue: 0,0:02:46.86,0:02:49.88,Caption,,0,0,0,,МЕНЯЕТСЯ. РАНЬШЕ СТРАТЕГИЧЕСКИ ВАЖНАЯ РАБОТА МОГЛА
Dialogue: 0,0:02:49.88,0:02:53.01,Caption,,0,0,0,,ЗАЩИЩАТЬ ЧЕЛОВЕКА ОТ ОТПРАВКИ В АРМИЮ. ТЕПЕРЬ ЭТА ЗАЩИТА
Dialogue: 0,0:02:53.01,0:02:55.20,Caption,,0,0,0,,СТАНОВИТСЯ ВСЁ МЕНЕЕ НАДЁЖНОЙ. А ДАЛЬШЕ
Dialogue: 0,0:02:55.20,0:02:58.87,Caption,,0,0,0,,ПРЕДПРИЯТИЕ ОКАЗЫВАЕТСЯ В ЗАМЕЧАТЕЛЬНОМ ПОЛОЖЕНИИ. ЕМУ ГОВОРЯТ
Dialogue: 0,0:02:58.87,0:03:00.94,Caption,,0,0,0,,ТЫ НАМ ОЧЕНЬ НУЖЕН. ПРОИЗВОДИ,
Dialogue: 0,0:03:01.02,0:03:05.01,Caption,,0,0,0,,РЕМОНТИРУЙ, ОБЕСПЕЧИВАЙ, ДЕРЖИ ЭКОНОМИКУ. НО РАБОТНИКОВ МЫ У
Dialogue: 0,0:03:05.01,0:03:07.74,Caption,,0,0,0,,ТЕБЯ ВСЁ РАВНО ЗАБЕРЁМ. И ПОПРОБУЙ САМ РЕШИТЬ,
Dialogue: 0,0:03:07.82,0:03:09.89,Caption,,0,0,0,,КТО ТЕБЕ НУЖЕН ЧУТЬ МЕНЬШЕ ОСТАЛЬНЫХ.
Dialogue: 0,0:03:09.89,0:03:12.77,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО РИСОВАТЬ ТАБЛИЦЫ ВОССТАНОВЛЕНИЯ
Dialogue: 0,0:03:12.77,0:03:15.40,Caption,,0,0,0,,ЭКОНОМИКИ. ТОЛЬКО СТАНОК БЕЗ РАБОЧЕГО САМ НЕ
Dialogue: 0,0:03:15.40,0:03:18.06,Caption,,0,0,0,,РАБОТАЕТ, ЭЛЕКТРОСЕТЬ САМА СЕБЯ НЕ РЕМОНТИРУЕТ,
Dialogue: 0,0:03:18.30,0:03:20.37,Caption,,0,0,0,,А ЗАВОД БЕЗ СПЕЦИАЛИСТОВ ЭФФЕКТИВНЕЕ
Dialogue: 0,0:03:20.37,0:03:23.52,Caption,,0,0,0,,НЕ СТАНОВИТСЯ. ЛЮДЕЙ НЕТ. И СКОРО ВОЕВАТЬ НЕЧЕМ
Dialogue: 0,0:03:23.52,0:03:26.16,Caption,,0,0,0,,БУДЕТ. ДА И ВООБЩЕ РАБОТАТЬ СТАНЕТ НЕКОМУ. И
Dialogue: 0,0:03:26.16,0:03:28.38,Caption,,0,0,0,,НОВЫЕ РЕШЕНИЯ ЭТУ ПРОБЛЕМУ НЕ СОЗДАЮТ.
Dialogue: 0,0:03:30.56,0:03:33.47,Caption,,0,0,0,,ОНИ ПОКАЗЫВАЮТ, НАСКОЛЬКО БЛИЗКО ГОСУДАРСТВО УЖЕ
Dialogue: 0,0:03:33.47,0:03:36.45,Caption,,0,0,0,,ПОДОШЛО К ПРЕДЕЛУ, ГДЕ ОДИН И ТОТ ЖЕ ЧЕЛОВЕК НУЖЕН
Dialogue: 0,0:03:36.45,0:03:39.60,Caption,,0,0,0,,ОДНОВРЕМЕННО АРМИИ, ЗАВОДУ, ЭНЕРГЕТИКЕ,
Dialogue: 0,0:03:39.68,0:03:43.92,Caption,,0,0,0,,ТРАНСПОРТУ И СЕМЬЕ. НО И ЭТО ЕЩЁ НЕ ВСЁ. ПРЕДСТАВИТЕЛИ ТЦК
Dialogue: 0,0:03:43.92,0:03:46.32,Caption,,0,0,0,,ЗАДЕРЖИВАЛИ ДАЖЕ РАБОТНИКОВ ПРЕДПРИЯТИЙ,
Dialogue: 0,0:03:46.42,0:03:48.34,Caption,,0,0,0,,УЖЕ ПОСТРАДАВШИХ ОТ УДАРОВ. ПОД
Dialogue: 0,0:03:48.34,0:03:51.82,Caption,,0,0,0,,ДАВЛЕНИЕ ПОПАДАЮТ И СТУДЕНТЫ. В ОДНОМ СЛУЧАЕ В ЗАКАРПАТЬЕ
Dialogue: 0,0:03:51.82,0:03:54.43,Caption,,0,0,0,,СТУДЕНТА УДАЛОСЬ ОСВОБОДИТЬ ПОСЛЕ ВМЕШАТЕЛЬСТВА
Dialogue: 0,0:03:54.43,0:03:57.16,Caption,,0,0,0,,СМИ И СУДА. ТО ЕСТЬ ЛИНИЯ ДАВЛЕНИЯ ДВИГАЕТСЯ НЕ
Dialogue: 0,0:03:57.16,0:03:59.92,Caption,,0,0,0,,ТОЛЬКО В СТОРОНУ ТЕХ, КТО ВООБЩЕ НИКАК НЕ СВЯЗАН С
Dialogue: 0,0:03:59.92,0:04:02.96,Caption,,0,0,0,,КРИТИЧЕСКОЙ ИНФРАСТРУКТУРОЙ. ОНА НАЧИНАЕТ ЗАХОДИТЬ
Dialogue: 0,0:04:02.96,0:04:05.99,Caption,,0,0,0,,ТУДА, ГДЕ РАНЬШЕ СУЩЕСТВОВАЛИ БОЛЕЕ ПОНЯТНЫЕ
Dialogue: 0,0:04:05.99,0:04:08.49,Caption,,0,0,0,,ГРАНИЦЫ. И ОДНОВРЕМЕННО ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА
Dialogue: 0,0:04:08.49,0:04:11.47,Caption,,0,0,0,,НЕПРИЯТНАЯ ДЕТАЛЬ. ПО СООБЩЕНИЯМ О НЕОФИЦИАЛЬНЫХ
Dialogue: 0,0:04:11.47,0:04:14.17,Caption,,0,0,0,,РАСЦЕНКАХ, ОКОЛО ТРЁХ ТЫСЯЧ ДОЛЛАРОВ СТОИТ
Dialogue: 0,0:04:14.17,0:04:17.12,Caption,,0,0,0,,РЕШЕНИЕ ВОПРОСА НА МЕСТЕ. ОТ ДВАДЦАТИ ТЫСЯЧ,
Dialogue: 0,0:04:17.27,0:04:19.53,Caption,,0,0,0,,ПОЛНОЦЕННАЯ БРОНЬ. ЕСЛИ ЭТИ РАСЦЕНКИ
Dialogue: 0,0:04:19.53,0:04:23.89,Caption,,0,0,0,,ХОТЯ БЫ БЛИЗКИ К РЕАЛЬНОСТИ, КАРТИНА ПОЛУЧАЕТСЯ ОЧЕНЬ ПРОСТАЯ. ОДИН
Dialogue: 0,0:04:23.89,0:04:27.06,Caption,,0,0,0,,ЧЕЛОВЕК ЗАЩИЩЁН ДОКУМЕНТОМ. ДРУГОЙ ДЕНЬГАМИ.
Dialogue: 0,0:04:27.06,0:04:29.86,Caption,,0,0,0,,ТРЕТИЙ ЗНАКОМСТВАМИ. А ЧЕТВЁРТЫЙ ЗАЩИЩЁН
Dialogue: 0,0:04:29.86,0:04:32.96,Caption,,0,0,0,,ТОЛЬКО ТЕМ, ЧТО ПОКА ДО НЕГО НЕ ДОШЛИ. ВОТ ТАКАЯ
Dialogue: 0,0:04:32.96,0:04:34.96,Caption,,0,0,0,,СОЦИАЛЬНАЯ СПРАВЕДЛИВОСТЬ ВОЕННОГО
Dialogue: 0,0:04:34.96,0:04:37.79,Caption,,0,0,0,,ВРЕМЕНИ. ПРИЧЁМ САМА ЭТА СИСТЕМА НАЧИНАЕТ ВСЁ СИЛЬНЕЕ
Dialogue: 0,0:04:37.79,0:04:40.36,Caption,,0,0,0,,НАПОМИНАТЬ РЫНОК. ТОЛЬКО ТОВАР ЗДЕСЬ ОЧЕНЬ
Dialogue: 0,0:04:40.36,0:04:42.96,Caption,,0,0,0,,СПЕЦИФИЧЕСКИЙ. ПРАВО НЕ ОКАЗАТЬСЯ СЛЕДУЮЩИМ.
Dialogue: 0,0:04:45.17,0:04:47.28,Caption,,0,0,0,,ВОТ И ЖЁСТКАЯ ОЦЕНКА МОБИЛИЗАЦИЯ ИЗ
Dialogue: 0,0:04:47.28,0:04:50.27,Caption,,0,0,0,,ОБЯЗАННОСТИ ПО ЗАКОНУ ПРЕВРАЩАЕТСЯ В ПРИНУДИТЕЛЬНОЕ
Dialogue: 0,0:04:50.27,0:04:53.13,Caption,,0,0,0,,ИЗЪЯТИЕ ЧЕЛОВЕЧЕСКОГО РЕСУРСА. А ВЫВОД ЕЩЁ
Dialogue: 0,0:04:53.13,0:04:55.17,Caption,,0,0,0,,РЕЗЧЕ ЕДИНСТВЕННЫЙ СПОСОБ ВЫЖИТЬ,
Dialogue: 0,0:04:55.35,0:04:57.88,Caption,,0,0,0,,УЕЗЖАТЬ ИЗ УКРАИНЫ КАК МОЖНО СКОРЕЕ.
Dialogue: 0,0:04:57.88,0:05:00.20,Caption,,0,0,0,,НА ЭТОМ ФОНЕ В ИНФОРМАЦИОННОМ ПОЛЕ ЗВУЧАТ
Dialogue: 0,0:05:00.20,0:05:03.17,Caption,,0,0,0,,ОЦЕНКИ ПОТЕРЬ СВЫШЕ ТРИДЦАТИ ПЯТИ ТЫСЯЧ ЧЕЛОВЕК В
Dialogue: 0,0:05:03.17,0:05:07.20,Caption,,0,0,0,,МЕСЯЦ. ЭТО ИМЕННО ОЦЕНКА, А НЕ ОФИЦИАЛЬНАЯ СТАТИСТИКА. НО ДАЖЕ
Dialogue: 0,0:05:07.20,0:05:09.35,Caption,,0,0,0,,САМ ФАКТ ПОЯВЛЕНИЯ ТАКИХ ОЦЕНОК ХОРОШО
Dialogue: 0,0:05:09.35,0:05:11.93,Caption,,0,0,0,,ПОКАЗЫВАЕТ, ПОЧЕМУ РАЗГОВОР О ЛЮДСКОМ РЕСУРСЕ
Dialogue: 0,0:05:11.93,0:05:14.69,Caption,,0,0,0,,СТАНОВИТСЯ ЦЕНТРАЛЬНЫМ. ДЕНЬГИ МОЖНО ЗАНЯТЬ,
Dialogue: 0,0:05:14.77,0:05:17.80,Caption,,0,0,0,,БОЕПРИПАСЫ КУПИТЬ, ТЕХНИКУ ЗАКАЗАТЬ. А ЧЕЛОВЕКА
Dialogue: 0,0:05:17.80,0:05:20.85,Caption,,0,0,0,,ПОСТАНОВЛЕНИЕМ КАБМИНА ОБРАТНО В РЕЕСТР НЕ ВЕРНЁШЬ.
Dialogue: 0,0:05:21.48,0:05:23.25,Caption,,0,0,0,,И ТЕПЕРЬ ВОЗВРАЩАЕМСЯ К ТЕМ САМЫМ
Dialogue: 0,0:05:23.25,0:05:25.55,Caption,,0,0,0,,МУЖЧИНАМ, КОТОРЫЕ ОФОРМЛЯЮТ ПОСТОЯННОЕ
Dialogue: 0,0:05:25.55,0:05:29.64,Caption,,0,0,0,,ПРОЖИВАНИЕ ЗА ГРАНИЦЕЙ. ГОСУДАРСТВО ХОЧЕТ ВИДЕТЬ И ИХ. ИХ
Dialogue: 0,0:05:29.64,0:05:33.91,Caption,,0,0,0,,ДОКУМЕНТЫ, ДАННЫЕ, ФОТОГРАФИИ. САМ ПО СЕБЕ ТАКОЙ УЧЁТ ЕЩЁ
Dialogue: 0,0:05:33.91,0:05:36.79,Caption,,0,0,0,,НЕ ОЗНАЧАЕТ, ЧТО ЗАВТРА ВСЕХ НАЧНУТ РАЗВОРАЧИВАТЬ
Dialogue: 0,0:05:36.79,0:05:39.50,Caption,,0,0,0,,НА ГРАНИЦЕ И ОТПРАВЛЯТЬ В ЧАСТЬ. НО СВЯЗЬ С ОБЩЕЙ
Dialogue: 0,0:05:39.50,0:05:42.92,Caption,,0,0,0,,КАРТИНОЙ СЛИШКОМ ОЧЕВИДНА, ЧТОБЫ ЕЁ НЕ ЗАМЕЧАТЬ. И ЗДЕСЬ
Dialogue: 0,0:05:42.92,0:05:45.98,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ НЕУДОБНАЯ АРИФМЕТИКА. ЕСЛИ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:05:45.98,0:05:49.09,Caption,,0,0,0,,ГОСУДАРСТВА ХОТЯТ, ЧТОБЫ УКРАИНА ПРОДОЛЖАЛА ВОЕВАТЬ,
Dialogue: 0,0:05:49.49,0:05:52.13,Caption,,0,0,0,,ВОПРОС О НАХОДЯЩИХСЯ В ЕВРОПЕ УКРАИНСКИХ МУЖЧИНАХ
Dialogue: 0,0:05:52.13,0:05:54.49,Caption,,0,0,0,,БУДЕТ ВОЗНИКАТЬ ВСЁ ЖЁСТЧЕ. СНАЧАЛА
Dialogue: 0,0:05:54.49,0:05:56.77,Caption,,0,0,0,,МЯГКО. ПОТОМ УЖЕ НЕ В ФОРМЕ ПОЖЕЛАНИЙ.
Dialogue: 0,0:05:59.04,0:06:01.85,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ХОТИТЕ ВИДЕТЬ ТАКИЕ СВЯЗИ ДО
Dialogue: 0,0:06:01.85,0:06:04.07,Caption,,0,0,0,,ТОГО, КАК ОНИ ПРЕВРАЩАЮТСЯ В ОЧЕРЕДНУЮ
Dialogue: 0,0:06:04.07,0:06:06.58,Caption,,0,0,0,,ОФИЦИАЛЬНУЮ ФОРМУЛИРОВКУ. ПОТОМУ ЧТО САМОЕ
Dialogue: 0,0:06:06.58,0:06:09.20,Caption,,0,0,0,,ИНТЕРЕСНОЕ ОБЫЧНО НАЧИНАЕТСЯ ИМЕННО ТАМ,
Dialogue: 0,0:06:09.42,0:06:11.44,Caption,,0,0,0,,ГДЕ ОДНА НОВОСТЬ ВДРУГ ОБЪЯСНЯЕТ
Dialogue: 0,0:06:11.44,0:06:15.90,Caption,,0,0,0,,ВТОРУЮ. А ОБЪЯСНЯТЬ ЕСТЬ ЧТО. ПАРАЛЛЕЛЬНО УКРАИНСКОЕ ОБЩЕСТВО УЖЕ
Dialogue: 0,0:06:15.90,0:06:19.13,Caption,,0,0,0,,НАЧИНАЮТ ПРИУЧАТЬ К МЫСЛИ, ЧТО ВОЙНА МОЖЕТ ПРОДОЛЖАТЬСЯ НА
Dialogue: 0,0:06:19.13,0:06:22.26,Caption,,0,0,0,,ПРОТЯЖЕНИИ ВСЕГО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА. ПО
Dialogue: 0,0:06:22.26,0:06:25.66,Caption,,0,0,0,,ОЦЕНКЕ ВЫСТУПАВШЕГО, НЫНЕШНЯЯ ФАЗА ВООБЩЕ НЕ ПОЗВОЛЯЕТ
Dialogue: 0,0:06:25.66,0:06:27.84,Caption,,0,0,0,,ОСТАНОВИТЬ ВОЙНУ. ОН УТВЕРЖДАЕТ,
Dialogue: 0,0:06:28.00,0:06:30.14,Caption,,0,0,0,,ЧТО ПОВТОРЯЕТ ЭТОТ ВЫВОД С САМОГО
Dialogue: 0,0:06:30.14,0:06:33.04,Caption,,0,0,0,,НАЧАЛА. А ШАНСЫ НА ПРЕКРАЩЕНИЕ ОГНЯ В СЛЕДУЮЩЕМ
Dialogue: 0,0:06:33.04,0:06:36.16,Caption,,0,0,0,,ГОДУ ОЦЕНИВАЕТ МАКСИМУМ В ДЕСЯТЬ ПРОЦЕНТОВ. ПРИ ЭТОМ
Dialogue: 0,0:06:36.16,0:06:39.97,Caption,,0,0,0,,ОН ПРЕКРАСНО ПОНИМАЕТ, ЧТО ЛЮДИ ХОТЯТ УСЛЫШАТЬ ДРУГОЕ.
Dialogue: 0,0:06:39.97,0:06:42.46,Caption,,0,0,0,,ХОЧЕТСЯ, ЧТОБЫ КТО ТО СКАЗАЛ ЧТО НИБУДЬ
Dialogue: 0,0:06:42.46,0:06:45.36,Caption,,0,0,0,,ПРИЯТНОЕ, ЧТОБЫ МОЖНО БЫЛО, КАК ОН ВЫРАЗИЛСЯ,
Dialogue: 0,0:06:45.44,0:06:48.63,Caption,,0,0,0,,ОБНЯТЬ ЕГО, ПРИЖАТЬСЯ И СЛЕДОВАТЬ ЗА НИМ КАК ЗА
Dialogue: 0,0:06:48.63,0:06:50.88,Caption,,0,0,0,,ИКОНОЙ. НО РЕАЛЬНОСТЬ, ГОВОРИТ ОН,
Dialogue: 0,0:06:51.02,0:06:53.54,Caption,,0,0,0,,ДРУГАЯ. ТАКОЕ ВОТ С НАСТУПАЮЩИМ НОВЫМ
Dialogue: 0,0:06:53.54,0:06:56.23,Caption,,0,0,0,,ГОДОМ ОТ ОФИСА ПРЕЗИДЕНТА. ТО ЕСТЬ НАСЕЛЕНИЮ
Dialogue: 0,0:06:56.23,0:06:59.33,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРЕДЛАГАЮТ ДВЕ ВЕЩИ. ПЕРВАЯ ГОТОВЬТЕСЬ
Dialogue: 0,0:06:59.33,0:07:02.38,Caption,,0,0,0,,К ТОМУ, ЧТО ВОЙНА НИКУДА НЕ ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:07:02.38,0:07:04.88,Caption,,0,0,0,,ВТОРАЯ ГОСУДАРСТВУ НУЖНО ВСЁ ТОЧНЕЕ ЗНАТЬ,
Dialogue: 0,0:07:05.10,0:07:07.07,Caption,,0,0,0,,ГДЕ НАХОДИТСЯ КАЖДЫЙ ПОТЕНЦИАЛЬНЫЙ
Dialogue: 0,0:07:07.07,0:07:09.88,Caption,,0,0,0,,ВОЕННООБЯЗАННЫЙ. И ДАЛЬШЕ ВОЗНИКАЕТ СОВЕРШЕННО
Dialogue: 0,0:07:09.88,0:07:14.67,Caption,,0,0,0,,НОРМАЛЬНЫЙ ВОПРОС. ЕСЛИ ВОЙНА ВЕСЬ СЛЕДУЮЩИЙ ГОД,
Dialogue: 0,0:07:14.83,0:07:18.48,Caption,,0,0,0,,ТО КТО ИМЕННО БУДЕТ ЕЁ ВЕСТИ? ПОТОМУ ЧТО РЯДОМ УЖЕ ПОЯВЛЯЕТСЯ ДРУГАЯ
Dialogue: 0,0:07:18.48,0:07:21.33,Caption,,0,0,0,,УДИВИТЕЛЬНАЯ ИСТОРИЯ. БАНКОВАЯ СНОВА ВЫТАСКИВАЕТ
Dialogue: 0,0:07:21.33,0:07:25.36,Caption,,0,0,0,,ЗАГАДОЧНОГО ПАВЛЮЧЕНКО, КОГДА ОЧЕРЕДНОМУ ИНСАЙДУ НУЖНО ПРИДАТЬ
Dialogue: 0,0:07:25.36,0:07:27.88,Caption,,0,0,0,,ВЕС. НА ЭТОТ РАЗ РАЗГОНЯЕТСЯ ВЕРСИЯ О БУДУЩЕМ
Dialogue: 0,0:07:27.88,0:07:30.87,Caption,,0,0,0,,УКРАИНСКОМ КОНТРНАСТУПЛЕНИИ. ЯКОБЫ ПУТИН ТАК
Dialogue: 0,0:07:30.87,0:07:33.08,Caption,,0,0,0,,БОИТСЯ ФОРСИРОВАНИЯ ДНЕПРА УКРАИНСКИМИ
Dialogue: 0,0:07:33.08,0:07:35.47,Caption,,0,0,0,,СИЛАМИ, ЧТО ПРОСИТ ТРАМПА ПОВЛИЯТЬ НА
Dialogue: 0,0:07:35.47,0:07:38.84,Caption,,0,0,0,,ЗЕЛЕНСКОГО. А ТЕПЕРЬ ВСПОМНИМ ПОПЫТКИ ВЫСАДКИ В РАЙОНЕ
Dialogue: 0,0:07:38.84,0:07:41.86,Caption,,0,0,0,,ЭНЕРГОДАРА И НЕОДНОКРАТНЫЕ ОПЕРАЦИИ НА КОСЕ. ОНИ
Dialogue: 0,0:07:41.86,0:07:44.53,Caption,,0,0,0,,СОПРОВОЖДАЛИСЬ ТЯЖЁЛЫМИ ПОТЕРЯМИ. ПРИЧЁМ ТАМ
Dialogue: 0,0:07:44.53,0:07:47.79,Caption,,0,0,0,,ДЕЙСТВОВАЛИ ЛУЧШИЕ ПОДРАЗДЕЛЕНИЯ. И ПОСЛЕ ЭТОГО СНОВА
Dialogue: 0,0:07:47.79,0:07:50.99,Caption,,0,0,0,,РАССКАЗЫВАЮТ О НОВОМ ФОРСИРОВАНИИ ДНЕПРА. А ТЕПЕРЬ,
Dialogue: 0,0:07:51.14,0:07:53.85,Caption,,0,0,0,,ЗНАЧИТ, КОМАНДИРЫ БРИГАД ДОЛЖНЫ ВЫСТРОИТЬСЯ В
Dialogue: 0,0:07:53.85,0:07:56.34,Caption,,0,0,0,,ОЧЕРЕДЬ, ЧТОБЫ ИМЕННО ИХ ПОДРАЗДЕЛЕНИЕ
Dialogue: 0,0:07:56.34,0:07:59.22,Caption,,0,0,0,,ВОЗГЛАВИЛО НОВЫЙ КОНТРНАСТУП ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:07:59.22,0:08:02.81,Caption,,0,0,0,,СЕДЬМОГО ГОДА. ТЕМ БОЛЕЕ ЗАДАЧА ПУСТЯКОВАЯ. ФОРСИРОВАТЬ
Dialogue: 0,0:08:02.81,0:08:05.87,Caption,,0,0,0,,ДНЕПР. НА КАРТЕ ДЕЙСТВИТЕЛЬНО ВЫГЛЯДИТ ПРОСТО. ВОТ
Dialogue: 0,0:08:05.87,0:08:09.03,Caption,,0,0,0,,ОДИН БЕРЕГ, ВОТ ВТОРОЙ. ПРОВЁЛ ПАЛЬЦЕМ И ГОТОВО.
Dialogue: 0,0:08:09.03,0:08:12.03,Caption,,0,0,0,,ОСТАЛОСЬ ТОЛЬКО ВЫЯСНИТЬ, ОТКУДА ВЗЯТЬ ЛЮДЕЙ,
Dialogue: 0,0:08:12.14,0:08:15.15,Caption,,0,0,0,,ТЕХНИКУ, СРЕДСТВА ПЕРЕПРАВЫ, ПРИКРЫТИЕ,
Dialogue: 0,0:08:15.23,0:08:17.95,Caption,,0,0,0,,РЕЗЕРВЫ, СНАБЖЕНИЕ И ВСЁ ОСТАЛЬНОЕ,
Dialogue: 0,0:08:18.19,0:08:20.09,Caption,,0,0,0,,ЧТО ПОЧЕМУ ТО НЕ ПОМЕЩАЕТСЯ МЕЖДУ
Dialogue: 0,0:08:20.09,0:08:22.90,Caption,,0,0,0,,ДВУМЯ ЛИНИЯМИ НА КАРТЕ. И ЗДЕСЬ ОСОБЕННО СМЕШНО
Dialogue: 0,0:08:22.90,0:08:24.91,Caption,,0,0,0,,ВЫГЛЯДИТ СОЧЕТАНИЕ ДВУХ НОВОСТЕЙ.
Dialogue: 0,0:08:27.18,0:08:30.26,Caption,,0,0,0,,С ОДНОЙ СТОРОНЫ, РАЗГОВОРЫ О НОВОМ НАСТУПЛЕНИИ. С
Dialogue: 0,0:08:30.26,0:08:32.78,Caption,,0,0,0,,ДРУГОЙ, МИНИСТЕРСТВО ЭКОНОМИКИ ОБСУЖДАЕТ,
Dialogue: 0,0:08:32.86,0:08:35.34,Caption,,0,0,0,,ГДЕ ВЗЯТЬ ЕЩЁ ДО ТРЁХСОТ ТЫСЯЧ МУЖЧИН,
Dialogue: 0,0:08:35.42,0:08:37.90,Caption,,0,0,0,,СНИМАЯ БРОНЬ. ВОТ И ВСЯ РАЗНИЦА МЕЖДУ
Dialogue: 0,0:08:37.90,0:08:40.83,Caption,,0,0,0,,ПРЕЗЕНТАЦИЕЙ И БУХГАЛТЕРИЕЙ. В ПРЕЗЕНТАЦИИ У ТЕБЯ
Dialogue: 0,0:08:40.83,0:08:43.90,Caption,,0,0,0,,МОТИВИРОВАННЫЕ СИЛЫ ИДУТ ВПЕРЁД. В БУХГАЛТЕРИИ ТЫ
Dialogue: 0,0:08:43.90,0:08:46.14,Caption,,0,0,0,,ОТКРЫВАЕШЬ РЕЕСТР И НАЧИНАЕШЬ ИСКАТЬ,
Dialogue: 0,0:08:46.30,0:08:48.98,Caption,,0,0,0,,КОГО ЕЩЁ НЕ ПОСЧИТАЛИ. НО ВПЕРЕДИ ЕЩЁ
Dialogue: 0,0:08:48.98,0:08:52.97,Caption,,0,0,0,,КИЕВ. ЗЕЛЕНСКИЙ, ОТВЕЧАЯ НА ВОПРОС ОБ ЭВАКУАЦИИ ГОРОДОВ
Dialogue: 0,0:08:52.97,0:08:55.98,Caption,,0,0,0,,ЗИМОЙ, ЗАЯВИЛ БЕЗ СТОЛИЦЫ НЕ БУДЕТ СТРАНЫ,
Dialogue: 0,0:08:56.22,0:08:59.04,Caption,,0,0,0,,КИЕВ БУДУТ ЗАЩИЩАТЬ ЛЮБЫМИ СПОСОБАМИ.
Dialogue: 0,0:08:59.04,0:09:01.26,Caption,,0,0,0,,ЛЮДИ, ПО ЕГО СЛОВАМ, ВПРАВЕ УЕЗЖАТЬ,
Dialogue: 0,0:09:01.34,0:09:04.52,Caption,,0,0,0,,ЕСЛИ ХОТЯТ, НО СТОЛИЦА ДОЛЖНА БЫТЬ СОХРАНЕНА.
Dialogue: 0,0:09:04.52,0:09:07.97,Caption,,0,0,0,,ЗВУЧИТ ЖЁСТКО. ТОЛЬКО ФРАЗА "ЛЮБЫМИ СПОСОБАМИ" ВСЕГДА
Dialogue: 0,0:09:07.97,0:09:10.38,Caption,,0,0,0,,ТРЕБУЕТ ВТОРОЙ ЧАСТИ. КАКИМИ ИМЕННО?
Dialogue: 0,0:09:10.78,0:09:12.46,Caption,,0,0,0,,ПОТОМУ ЧТО ОДНОВРЕМЕННО ЗЕЛЕНСКИЙ
Dialogue: 0,0:09:12.46,0:09:15.10,Caption,,0,0,0,,ГОВОРИТ, ЧТО РОССИЯ СТРЕМИТСЯ ОТРЕЗАТЬ ЛЕВЫЙ
Dialogue: 0,0:09:15.10,0:09:18.14,Caption,,0,0,0,,БЕРЕГ ДНЕПРА ОТ ПРАВОГО. ТО ЕСТЬ РЕЧЬ УЖЕ ИДЁТ НЕ О
Dialogue: 0,0:09:18.14,0:09:21.73,Caption,,0,0,0,,КАКОЙ ТО ЛОКАЛЬНОЙ УГРОЗЕ, А О ВОЗМОЖНОМ УДАРЕ ПО СВЯЗНОСТИ
Dialogue: 0,0:09:21.73,0:09:24.85,Caption,,0,0,0,,ОГРОМНОЙ ЧАСТИ СТРАНЫ. И ВОТ ТУТ ВСЁ ПРЕДЕЛЬНО
Dialogue: 0,0:09:24.85,0:09:26.94,Caption,,0,0,0,,ПРОСТО. ВОЙНА БЬЁТ ПО СНАБЖЕНИЮ,
Dialogue: 0,0:09:27.02,0:09:29.74,Caption,,0,0,0,,ДОРОГАМ, УЗЛАМ СВЯЗИ И ПЕРЕПРАВАМ. ЕСЛИ
Dialogue: 0,0:09:29.74,0:09:31.82,Caption,,0,0,0,,ПРОТИВНИК СЧИТАЕТ ИХ КРИТИЧЕСКИМИ,
Dialogue: 0,0:09:32.00,0:09:33.95,Caption,,0,0,0,,ОН БУДЕТ ПЫТАТЬСЯ ИХ УНИЧТОЖАТЬ.
Dialogue: 0,0:09:33.95,0:09:37.18,Caption,,0,0,0,,ВОПРОС НЕ В ТОМ, ИЗВЕСТНО ЛИ ЭТО КИЕВУ. КОНЕЧНО
Dialogue: 0,0:09:37.18,0:09:40.46,Caption,,0,0,0,,ИЗВЕСТНО. ВОПРОС В ТОМ, ХВАТАЕТ ЛИ РЕСУРСОВ ВСЁ ЭТО
Dialogue: 0,0:09:40.46,0:09:44.86,Caption,,0,0,0,,ОДНОВРЕМЕННО ЗАЩИЩАТЬ. СТОЛИЦУ ЗАЩИЩАТЬ. ЭНЕРГЕТИКУ ЗАЩИЩАТЬ.
Dialogue: 0,0:09:47.14,0:09:49.95,Caption,,0,0,0,,МОСТЫ ЗАЩИЩАТЬ. ПРЕДПРИЯТИЯ ДЕРЖАТЬ.
Dialogue: 0,0:09:49.95,0:09:52.84,Caption,,0,0,0,,АРМИЮ ПОПОЛНЯТЬ. ЭКОНОМИКУ СОХРАНЯТЬ. ЛЮДЕЙ
Dialogue: 0,0:09:52.84,0:09:56.76,Caption,,0,0,0,,НЕ ХВАТАЕТ УЖЕ НАСТОЛЬКО, ЧТО ОБСУЖДАЕТСЯ РАЗБРОНИРОВАНИЕ СОТЕН
Dialogue: 0,0:09:56.76,0:09:59.69,Caption,,0,0,0,,ТЫСЯЧ. И ПРИ ЭТОМ ГОТОВИМСЯ ЕЩЁ И НАСТУПАТЬ. ВОТ
Dialogue: 0,0:09:59.69,0:10:01.86,Caption,,0,0,0,,ЗДЕСЬ УЖЕ ХОЧЕТСЯ СПРОСИТЬ НЕ ПРО ПЛАНЫ,
Dialogue: 0,0:10:01.94,0:10:04.14,Caption,,0,0,0,,А ПРО АРИФМЕТИКУ. НО ЗЕЛЕНСКИЙ В ТОМ
Dialogue: 0,0:10:04.14,0:10:06.31,Caption,,0,0,0,,ЖЕ НАБОРЕ ЗАЯВЛЕНИЙ ИДЁТ ДАЛЬШЕ. ОН
Dialogue: 0,0:10:06.31,0:10:08.78,Caption,,0,0,0,,ГОВОРИТ, ЧТО НАЗЫВАТЬ ПУТИНА ДРУГОМ ВСЁ РАВНО
Dialogue: 0,0:10:08.78,0:10:11.66,Caption,,0,0,0,,ЧТО НАЗЫВАТЬ ГИТЛЕРА ДРУГОМ ВО ВРЕМЯ ВТОРОЙ МИРОВОЙ
Dialogue: 0,0:10:11.66,0:10:14.36,Caption,,0,0,0,,ВОЙНЫ. ЭТО УЖЕ НЕ ПОПЫТКА СНИЗИТЬ ТЕМПЕРАТУРУ.
Dialogue: 0,0:10:14.36,0:10:16.97,Caption,,0,0,0,,ЭТО ПРЕДЕЛЬНО ЖЁСТКАЯ ПОЛИТИЧЕСКАЯ РАМКА.
Dialogue: 0,0:10:16.97,0:10:19.78,Caption,,0,0,0,,ОДНОВРЕМЕННО АНОНСИРУЮТСЯ ВСТРЕЧИ ПО ГАРАНТИЯМ
Dialogue: 0,0:10:19.78,0:10:22.88,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТО ЕСТЬ ПЕРЕГОВОРНЫЙ ТРЕК СУЩЕСТВУЕТ.
Dialogue: 0,0:10:22.88,0:10:25.58,Caption,,0,0,0,,ГАРАНТИИ ОБСУЖДАЮТСЯ. КОНТАКТЫ ИДУТ. НО
Dialogue: 0,0:10:25.58,0:10:27.94,Caption,,0,0,0,,ПУБЛИЧНАЯ РИТОРИКА ОСТАЁТСЯ ТАКОЙ,
Dialogue: 0,0:10:28.10,0:10:30.07,Caption,,0,0,0,,БУДТО ПРОСТРАНСТВО ДЛЯ КОМПРОМИССА
Dialogue: 0,0:10:30.07,0:10:33.29,Caption,,0,0,0,,НУЖНО ЗАРАНЕЕ СУЗИТЬ ДО ЩЕЛИ. И ЕЩЁ ОДНА ДЕТАЛЬ.
Dialogue: 0,0:10:33.29,0:10:36.98,Caption,,0,0,0,,ЗЕЛЕНСКИЙ УТВЕРЖДАЕТ, ЧТО УКРАИНА НЕ ПРОВОДИТ ОПЕРАЦИИ,
Dialogue: 0,0:10:37.14,0:10:39.22,Caption,,0,0,0,,ПОДОБНЫЕ АТАКЕ НА РОССИЙСКИЙ КОРАБЛЬ В
Dialogue: 0,0:10:39.22,0:10:41.74,Caption,,0,0,0,,ЛИВИИ, БЕЗ КООРДИНАЦИИ С ПАРТНЁРАМИ. НО
Dialogue: 0,0:10:41.74,0:10:45.01,Caption,,0,0,0,,ЛИВИЙСКАЯ ИСТОРИЯ ЗДЕСЬ ВАЖНА ПО ДРУГОЙ ПРИЧИНЕ. КИЕВ
Dialogue: 0,0:10:45.01,0:10:48.16,Caption,,0,0,0,,САМ ПОКАЗЫВАЕТ, НАСКОЛЬКО СИЛЬНО УКРАИНСКИЕ ВОЕННЫЕ
Dialogue: 0,0:10:48.16,0:10:51.44,Caption,,0,0,0,,ДЕЙСТВИЯ ЗАВИСЯТ ОТ ВНЕШНЕЙ ПОДДЕРЖКИ И ВЗАИМОДЕЙСТВИЯ.
Dialogue: 0,0:10:51.44,0:10:53.86,Caption,,0,0,0,,А ЗНАЧИТ ВОПРОС ЧЕЛОВЕЧЕСКОГО РЕСУРСА ВНУТРИ
Dialogue: 0,0:10:53.86,0:10:56.36,Caption,,0,0,0,,СТРАНЫ СТАНОВИТСЯ ЕЩЁ ЗАМЕТНЕЕ. ПАРТНЁРЫ
Dialogue: 0,0:10:56.36,0:10:58.58,Caption,,0,0,0,,МОГУТ ДАТЬ ДЕНЬГИ, РАЗВЕДДАННЫЕ,
Dialogue: 0,0:10:58.74,0:11:00.82,Caption,,0,0,0,,ОРУЖИЕ, ПОЛИТИЧЕСКУЮ ПОДДЕРЖКУ.
Dialogue: 0,0:11:03.11,0:11:04.97,Caption,,0,0,0,,НО УКРАИНСКОГО ПЕХОТИНЦА ПАРТНЁР ИЗ
Dialogue: 0,0:11:04.97,0:11:07.93,Caption,,0,0,0,,БРЮССЕЛЯ В КОРОБКЕ НЕ ПРИШЛЁТ. ВОТ ПОЭТОМУ РЯДОМ
Dialogue: 0,0:11:07.93,0:11:10.37,Caption,,0,0,0,,В ОДНОМ ИНФОРМАЦИОННОМ ПОЛЕ И СУЩЕСТВУЮТ НА
Dialogue: 0,0:11:10.37,0:11:13.46,Caption,,0,0,0,,ПЕРВЫЙ ВЗГЛЯД СОВЕРШЕННО РАЗНЫЕ СЮЖЕТЫ. ВЕРИФИКАЦИЯ
Dialogue: 0,0:11:13.46,0:11:16.18,Caption,,0,0,0,,МУЖЧИН. РАЗБРОНИРОВАНИЕ ДО ТРЁХСОТ ТЫСЯЧ.
Dialogue: 0,0:11:16.18,0:11:20.15,Caption,,0,0,0,,СТУДЕНТЫ И ТЦК. РАБОТНИКИ КРИТИЧЕСКИХ ПРЕДПРИЯТИЙ.
Dialogue: 0,0:11:20.15,0:11:22.76,Caption,,0,0,0,,МУЖЧИНЫ, ОФОРМЛЯЮЩИЕ ЖИЗНЬ ЗА ГРАНИЦЕЙ.
Dialogue: 0,0:11:22.76,0:11:25.97,Caption,,0,0,0,,РАЗГОВОРЫ О ВОЙНЕ НА ПРОТЯЖЕНИИ ВСЕГО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:11:25.97,0:11:29.38,Caption,,0,0,0,,СЕДЬМОГО ГОДА. РАЗГОВОРЫ О НОВОМ КОНТРНАСТУПЛЕНИИ. И
Dialogue: 0,0:11:29.38,0:11:32.66,Caption,,0,0,0,,ОБЕЩАНИЕ ЗАЩИЩАТЬ КИЕВ ЛЮБЫМИ СПОСОБАМИ. ЭТО НЕ
Dialogue: 0,0:11:32.66,0:11:35.42,Caption,,0,0,0,,ОДИН ДОКАЗАННЫЙ ПЛАН ИЗ ОДНОГО КАБИНЕТА. НО
Dialogue: 0,0:11:35.42,0:11:38.15,Caption,,0,0,0,,ОБЩИЙ ДЕФИЦИТ, НА КОТОРЫЙ ОТВЕЧАЮТ ЭТИ РЕШЕНИЯ,
Dialogue: 0,0:11:38.23,0:11:40.95,Caption,,0,0,0,,ВИДЕН ОЧЕНЬ ХОРОШО. НУЖНЫ ЛЮДИ. ПРИЧЁМ
Dialogue: 0,0:11:40.95,0:11:44.19,Caption,,0,0,0,,НУЖНЫ ВСЕМ СРАЗУ. АРМИИ НУЖНЫ ЛЮДИ ДЛЯ ФРОНТА.
Dialogue: 0,0:11:44.19,0:11:46.90,Caption,,0,0,0,,ЭКОНОМИКЕ НУЖНЫ ЛЮДИ ДЛЯ РАБОТЫ. КРИТИЧЕСКОЙ
Dialogue: 0,0:11:46.90,0:11:50.39,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ НУЖНЫ ЛЮДИ ДЛЯ РЕМОНТА. ГОСУДАРСТВУ НУЖНЫ
Dialogue: 0,0:11:50.39,0:11:53.03,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКИ. СЕМЬЯМ НУЖНЫ МУЖЬЯ,
Dialogue: 0,0:11:53.17,0:11:56.33,Caption,,0,0,0,,ОТЦЫ, СЫНОВЬЯ. ЕВРОПЕ НУЖНЫ РАБОТНИКИ И
Dialogue: 0,0:11:56.33,0:11:59.40,Caption,,0,0,0,,ПОТРЕБИТЕЛИ. А В РЕЕСТРЕ ОДИН И ТОТ ЖЕ ЧЕЛОВЕК ПОЧЕМУ
Dialogue: 0,0:11:59.40,0:12:01.75,Caption,,0,0,0,,ТО НЕ ДЕЛИТСЯ НА ПЯТЬ ЧАСТЕЙ. ВОТ В ЭТОМ
Dialogue: 0,0:12:01.83,0:12:03.67,Caption,,0,0,0,,И ЗАКЛЮЧАЕТСЯ НАСТОЯЩАЯ ПРОБЛЕМА,
Dialogue: 0,0:12:03.91,0:12:05.97,Caption,,0,0,0,,КОТОРУЮ НИКАКАЯ КРАСИВАЯ ПРЕЗЕНТАЦИЯ
Dialogue: 0,0:12:05.97,0:12:09.30,Caption,,0,0,0,,НЕ РЕШАЕТ. МОЖНО СДЕЛАТЬ РЕЕСТР ТОЧНЕЕ. МОЖНО
Dialogue: 0,0:12:09.30,0:12:12.54,Caption,,0,0,0,,СОЕДИНИТЬ БАЗЫ. МОЖНО ДОБАВИТЬ ФОТОГРАФИИ. МОЖНО
Dialogue: 0,0:12:12.54,0:12:15.82,Caption,,0,0,0,,ПЕРЕСМОТРЕТЬ БРОНЬ. МОЖНО ПОДНЯТЬ ЦЕНУ НЕОФИЦИАЛЬНОГО
Dialogue: 0,0:12:15.82,0:12:19.70,Caption,,0,0,0,,ВЫХОДА. МОЖНО ЕЩЁ РАЗ СКАЗАТЬ,
Dialogue: 0,0:12:19.85,0:12:21.99,Caption,,0,0,0,,ЧТО СЛЕДУЮЩИЙ ГОД БУДЕТ ТЯЖЁЛЫМ. НО
Dialogue: 0,0:12:21.99,0:12:24.51,Caption,,0,0,0,,ВСЁ ЭТО НЕ СОЗДАЁТ НОВОГО ЧЕЛОВЕЧЕСКОГО
Dialogue: 0,0:12:24.51,0:12:26.98,Caption,,0,0,0,,РЕСУРСА. И ЧЕМ ДОЛЬШЕ ПРОДОЛЖАЕТСЯ ВОЙНА,
Dialogue: 0,0:12:27.16,0:12:28.91,Caption,,0,0,0,,ТЕМ СИЛЬНЕЕ ГОСУДАРСТВО ВЫНУЖДЕНО
Dialogue: 0,0:12:28.91,0:12:32.08,Caption,,0,0,0,,ВЫБИРАТЬ УЖЕ НЕ МЕЖДУ ХОРОШИМ И ПЛОХИМ ВАРИАНТОМ. ОНО
Dialogue: 0,0:12:32.08,0:12:34.80,Caption,,0,0,0,,ВЫБИРАЕТ, ОТКУДА ИМЕННО ЗАБРАТЬ ЧЕЛОВЕКА
Dialogue: 0,0:12:34.80,0:12:37.61,Caption,,0,0,0,,СЕГОДНЯ, ЧТОБЫ ЗАКРЫТЬ ДЫРУ В ДРУГОМ МЕСТЕ.
Dialogue: 0,0:12:37.61,0:12:41.09,Caption,,0,0,0,,ЗАБРАТЬ С ПРЕДПРИЯТИЯ, ПРОСЯЩЕГО СОХРАНИТЬ ПРОИЗВОДСТВО.
Dialogue: 0,0:12:41.09,0:12:44.21,Caption,,0,0,0,,ЗАБРАТЬ ИЗ СЕМЬИ. ПОПЫТАТЬСЯ ВЕРНУТЬ ИЗ ЗА ГРАНИЦЫ.
Dialogue: 0,0:12:44.21,0:12:47.66,Caption,,0,0,0,,СНЯТЬ БРОНЬ. УЖЕСТОЧИТЬ КОНТРОЛЬ. РАСШИРИТЬ РЕЕСТР.
Dialogue: 0,0:12:47.66,0:12:50.26,Caption,,0,0,0,,И ПОСЛЕ ЭТОГО СНОВА ОТКРЫТЬ КАРТУ И НАРИСОВАТЬ
Dialogue: 0,0:12:50.26,0:12:53.56,Caption,,0,0,0,,СТРЕЛКУ ЧЕРЕЗ ДНЕПР. ВОТ ТОЛЬКО КАРТА ТЕРПЕЛИВАЯ. НА
Dialogue: 0,0:12:53.56,0:12:56.04,Caption,,0,0,0,,НЕЙ ЛЮДЕЙ ВСЕГДА ХВАТАЕТ. А В РЕАЛЬНОСТИ ИХ
Dialogue: 0,0:12:56.04,0:12:57.54,Caption,,0,0,0,,СНАЧАЛА ПРИХОДИТСЯ СЧИТАТЬ.
