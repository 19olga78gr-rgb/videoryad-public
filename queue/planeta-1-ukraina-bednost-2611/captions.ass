Dialogue: 0,0:00:00.12,0:00:02.27,Caption,,0,0,0,,ФРИДРИХ МЕРЦ ОБНАРУЖИЛ В УКРАИНЕ ТАКОЙ
Dialogue: 0,0:00:02.27,0:00:04.68,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЙ ПОДЪЁМ, ЧТО ГЕРМАНИИ,
Dialogue: 0,0:00:04.84,0:00:08.07,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ОСТАЁТСЯ ЛИШЬ СМОТРЕТЬ С ЗАВИСТЬЮ.
Dialogue: 0,0:00:08.07,0:00:12.07,Caption,,0,0,0,,ЗВУЧИТ ЭФФЕКТНО. ПРАВДА, САМИ УКРАИНЦЫ ПОЧЕМУ ТО НЕ СПЕШАТ
Dialogue: 0,0:00:12.07,0:00:14.04,Caption,,0,0,0,,ПОЗДРАВЛЯТЬ ДРУГ ДРУГА С ЭТИМ УСПЕХОМ.
Dialogue: 0,0:00:14.60,0:00:16.76,Caption,,0,0,0,,ВИДИМО, РОСТ ПРОШЁЛ ГДЕ ТО РЯДОМ,
Dialogue: 0,0:00:17.00,0:00:18.97,Caption,,0,0,0,,ВЕЖЛИВО ПОЗДОРОВАЛСЯ С КАНЦЛЕРОМ И
Dialogue: 0,0:00:18.97,0:00:21.81,Caption,,0,0,0,,ПОСТАРАЛСЯ НЕ ПОПАДАТЬСЯ НАСЕЛЕНИЮ НА ГЛАЗА. ЕСЛИ
Dialogue: 0,0:00:21.81,0:00:23.92,Caption,,0,0,0,,ВАМ НРАВИТСЯ ПРОВЕРЯТЬ ГРОМКИЕ РЕЧИ НЕ
Dialogue: 0,0:00:23.92,0:00:25.80,Caption,,0,0,0,,АПЛОДИСМЕНТАМИ, А АРИФМЕТИКОЙ,
Dialogue: 0,0:00:25.96,0:00:27.77,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. СЕЙЧАС У
Dialogue: 0,0:00:27.77,0:00:31.40,Caption,,0,0,0,,АРИФМЕТИКИ ОСОБЕННО ЕХИДНОЕ НАСТРОЕНИЕ. МЕРЦ УВЕРЯЕТ,
Dialogue: 0,0:00:31.56,0:00:34.52,Caption,,0,0,0,,ЧТО УКРАИНСКАЯ ЭКОНОМИКА, НЕВЗИРАЯ НА ВОЙНУ,
Dialogue: 0,0:00:34.73,0:00:36.55,Caption,,0,0,0,,УЖЕ С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ТРЕТЬЕГО
Dialogue: 0,0:00:36.55,0:00:38.70,Caption,,0,0,0,,ГОДА ДЕМОНСТРИРУЕТ УСТОЙЧИВЫЙ РОСТ.
Dialogue: 0,0:00:38.70,0:00:41.74,Caption,,0,0,0,,НЕМЕЦКАЯ ЗА ТО ЖЕ ВРЕМЯ ТАКИМИ РЕЗУЛЬТАТАМИ ПОХВАСТАТЬСЯ
Dialogue: 0,0:00:41.74,0:00:44.92,Caption,,0,0,0,,НЕ МОЖЕТ. ПОЛУЧАЕТСЯ УДИВИТЕЛЬНАЯ КАРТИНА.
Dialogue: 0,0:00:44.92,0:00:48.77,Caption,,0,0,0,,БЕРЛИНУ ТЯЖЕЛО, А КИЕВ ПРЯМО РВЁТСЯ ВПЕРЁД. ОСТАЁТСЯ
Dialogue: 0,0:00:48.77,0:00:51.99,Caption,,0,0,0,,ВЫЯСНИТЬ, ИЗ КАКОЙ ПАПКИ КАНЦЛЕР ВЗЯЛ ЭТОТ
Dialogue: 0,0:00:51.99,0:00:54.57,Caption,,0,0,0,,ПРАЗДНИК. ДЛЯ ОТВЕТА ДАЖЕ НЕ ПРИДЁТСЯ ОБРАЩАТЬСЯ К
Dialogue: 0,0:00:54.57,0:00:57.23,Caption,,0,0,0,,РОССИЙСКИМ ИСТОЧНИКАМ. ВОЗЬМЁМ ВСЕМИРНЫЙ БАНК И
Dialogue: 0,0:00:57.23,0:00:59.98,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ ФОНД. В ЕВРОПЕ ИХ РАСЧЁТЫ
Dialogue: 0,0:00:59.98,0:01:02.79,Caption,,0,0,0,,ЛЮБЯТ ПРИВОДИТЬ КАК ПОСЛЕДНЕЕ СЛОВО ФИНАНСОВОЙ
Dialogue: 0,0:01:02.79,0:01:06.14,Caption,,0,0,0,,МУДРОСТИ. А ТЕПЕРЬ СПУСТИМСЯ С УРОВНЯ КАНЦЛЕРСКИХ
Dialogue: 0,0:01:06.14,0:01:09.08,Caption,,0,0,0,,ВЫСТУПЛЕНИЙ ТУДА, ГДЕ ЛЮДИ ПОЛУЧАЮТ ЗАРПЛАТУ,
Dialogue: 0,0:01:09.32,0:01:11.57,Caption,,0,0,0,,ПОКУПАЮТ ПРОДУКТЫ И ОТКРЫВАЮТ СЧЕТА ЗА
Dialogue: 0,0:01:11.57,0:01:17.50,Caption,,0,0,0,,КОММУНАЛЬНЫЕ УСЛУГИ. ЗА ГРАНИЦЕЙ БЕДНОСТИ НАХОДИТСЯ СОРОК
Dialogue: 0,0:01:17.50,0:01:20.76,Caption,,0,0,0,,ОДИН ПРОЦЕНТ НАСЕЛЕНИЯ УКРАИНЫ. ШЕСТЬ ИЗ ДЕСЯТИ
Dialogue: 0,0:01:20.76,0:01:23.60,Caption,,0,0,0,,ДОМОХОЗЯЙСТВ ОЦЕНИВАЮТ СВОЁ ПОЛОЖЕНИЕ ХУЖЕ,
Dialogue: 0,0:01:23.89,0:01:25.53,Caption,,0,0,0,,ЧЕМ ДО ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:01:25.53,0:01:29.24,Caption,,0,0,0,,ВТОРОГО ГОДА. ДВАДЦАТЬ ШЕСТЬ ПРОЦЕНТОВ СЕМЕЙ НЕ
Dialogue: 0,0:01:29.24,0:01:32.66,Caption,,0,0,0,,РАСПОЛАГАЮТ НИКАКИМИ НАКОПЛЕНИЯМИ. СРЕДИ НАИБОЛЕЕ
Dialogue: 0,0:01:32.66,0:01:36.17,Caption,,0,0,0,,БЕДНЫХ СЕМЕЙ ДОЛЯ ТАКИХ ДОМОХОЗЯЙСТВ ДОСТИГАЕТ
Dialogue: 0,0:01:36.17,0:01:39.20,Caption,,0,0,0,,ТРИДЦАТИ ПЯТИ ПРОЦЕНТОВ. ПОЧТИ ОДНА ИЗ ЧЕТЫРЁХ
Dialogue: 0,0:01:39.20,0:01:42.24,Caption,,0,0,0,,МАЛООБЕСПЕЧЕННЫХ СЕМЕЙ В ПОСЛЕДНЕЕ ВРЕМЯ СТАЛКИВАЛАСЬ С
Dialogue: 0,0:01:42.24,0:01:45.24,Caption,,0,0,0,,ТРУДНОСТЯМИ ПРИ ОПЛАТЕ КОММУНАЛЬНЫХ СЧЕТОВ. ДОХОДЫ
Dialogue: 0,0:01:45.24,0:01:47.66,Caption,,0,0,0,,ОТ АГРАРНОЙ ДЕЯТЕЛЬНОСТИ ЗА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:01:47.66,0:01:50.96,Caption,,0,0,0,,ШЕСТОЙ ГОД УМЕНЬШИЛИСЬ НА ТРИНАДЦАТЬ ПРОЦЕНТОВ. У
Dialogue: 0,0:01:50.96,0:01:53.09,Caption,,0,0,0,,ПРЕДПРИНИМАТЕЛЕЙ И САМОЗАНЯТЫХ ПАДЕНИЕ
Dialogue: 0,0:01:53.09,0:01:55.45,Caption,,0,0,0,,СОСТАВИЛО ДЕВЯТНАДЦАТЬ ПРОЦЕНТОВ. ЗАОДНО
Dialogue: 0,0:01:55.45,0:01:58.71,Caption,,0,0,0,,ЭКСПЕРТЫ ОТМЕЧАЮТ, ЧТО ПРОБЛЕМЫ С ПСИХИЧЕСКИМ ЗДОРОВЬЕМ
Dialogue: 0,0:01:58.71,0:02:01.60,Caption,,0,0,0,,НАСЕЛЕНИЯ ПО ПРЕЖНЕМУ ОСТАЮТСЯ СЕРЬЁЗНЫМИ. ВОТ И
Dialogue: 0,0:02:01.60,0:02:04.64,Caption,,0,0,0,,ВЕСЬ ПАРАД ДОСТИЖЕНИЙ. КАНЦЛЕР ВИДИТ ПОДЪЁМ,
Dialogue: 0,0:02:04.96,0:02:06.92,Caption,,0,0,0,,А ЧЕТЫРЕ ЧЕЛОВЕКА ИЗ ДЕСЯТИ ВИДЯТ
Dialogue: 0,0:02:06.92,0:02:09.04,Caption,,0,0,0,,ЧЕРТУ БЕДНОСТИ С НЕПРАВИЛЬНОЙ СТОРОНЫ.
Dialogue: 0,0:02:09.76,0:02:11.72,Caption,,0,0,0,,ГОСПОДИНУ МЕРЦУ СТОИЛО БЫ ПОКАЗАТЬ ЭТУ
Dialogue: 0,0:02:11.72,0:02:14.32,Caption,,0,0,0,,ТАБЛИЦУ ЦЕЛИКОМ. ЕЁ СОСТАВЛЯЛИ НЕ В МОСКВЕ.
Dialogue: 0,0:02:14.32,0:02:16.40,Caption,,0,0,0,,ПЕРЕД НАМИ ОЦЕНКИ ВСЕМИРНОГО БАНКА,
Dialogue: 0,0:02:16.56,0:02:18.34,Caption,,0,0,0,,КОТОРОМУ ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ
Dialogue: 0,0:02:18.34,0:02:20.16,Caption,,0,0,0,,ОБЫЧНО ВЕРЯТ БЕЗ ДОЛГИХ УГОВОРОВ.
Dialogue: 0,0:02:20.72,0:02:23.20,Caption,,0,0,0,,ТАК ГДЕ ИМЕННО СПРЯТАЛСЯ ТОТ РЕЗУЛЬТАТ,
Dialogue: 0,0:02:23.51,0:02:25.20,Caption,,0,0,0,,КОТОРОМУ ДОЛЖНЫ ЗАВИДОВАТЬ НЕМЦЫ?
Dialogue: 0,0:02:25.39,0:02:27.44,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТЬЮ ЭТОТ ПОДЪЁМ ТОЖЕ НЕ
Dialogue: 0,0:02:27.44,0:02:31.79,Caption,,0,0,0,,СТРАДАЕТ. ЕВРОСОЮЗ УЖЕ РАССЧИТЫВАЕТ,
Dialogue: 0,0:02:31.90,0:02:35.48,Caption,,0,0,0,,СКОЛЬКО ПОТРЕБУЕТСЯ УКРАИНЕ, ЧТОБЫ ГОСУДАРСТВЕННОЕ ФИНАНСИРОВАНИЕ
Dialogue: 0,0:02:35.48,0:02:38.15,Caption,,0,0,0,,ПРОДЕРЖАЛОСЬ ДО КОНЦА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО
Dialogue: 0,0:02:38.15,0:02:40.59,Caption,,0,0,0,,ГОДА. ПРЕДВАРИТЕЛЬНАЯ СУММА СОСТАВЛЯЕТ
Dialogue: 0,0:02:40.59,0:02:44.01,Caption,,0,0,0,,ПРИМЕРНО СЕМЬДЕСЯТ МИЛЛИАРДОВ ЕВРО. ЕВРОКОМИССИЯ ХОЧЕТ
Dialogue: 0,0:02:44.01,0:02:47.64,Caption,,0,0,0,,ПОЛУЧИТЬ СОРОК ПЯТЬ МИЛЛИАРДОВ ЗА СЧЁТ НОВЫХ ЗАЙМОВ.
Dialogue: 0,0:02:47.64,0:02:50.36,Caption,,0,0,0,,ЕЩЁ ОДИН ОБСУЖДАЕМЫЙ ИСТОЧНИК ПРЕДСТАВЛЯЕТ
Dialogue: 0,0:02:50.36,0:02:53.21,Caption,,0,0,0,,СОБОЙ ДВЕСТИ ДЕСЯТЬ МИЛЛИАРДОВ ЕВРО РОССИЙСКИХ
Dialogue: 0,0:02:53.21,0:02:56.27,Caption,,0,0,0,,АКТИВОВ, НАХОДЯЩИХСЯ ПОД ЗАМОРОЗКОЙ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:02:56.27,0:02:58.55,Caption,,0,0,0,,ЗАНЯТНАЯ УСТОЙЧИВОСТЬ. ЧТОБЫ ЭКОНОМИКА
Dialogue: 0,0:02:58.55,0:03:02.16,Caption,,0,0,0,,ПРОДОЛЖАЛА РАБОТАТЬ, ДЛЯ НЕЁ ЗАРАНЕЕ РАЗЫСКИВАЮТ ДЕСЯТКИ
Dialogue: 0,0:03:02.16,0:03:05.23,Caption,,0,0,0,,МИЛЛИАРДОВ, КОТОРЫХ ПОКА НЕТ. ПАЦИЕНТ УВЕРЕННО
Dialogue: 0,0:03:05.23,0:03:08.69,Caption,,0,0,0,,ИДЁТ НА ПОПРАВКУ, ТОЛЬКО КАПЕЛЬНИЦУ ПРОСЯТ НЕ УБИРАТЬ И
Dialogue: 0,0:03:08.69,0:03:11.23,Caption,,0,0,0,,ПРИНЕСТИ ЕЩЁ ДВЕ. ЕВРОПЕЙСКИЕ ДЕНЬГИ,
Dialogue: 0,0:03:11.31,0:03:14.49,Caption,,0,0,0,,ОДНАКО, НЕ ЛЕЖАТ В БЕЗДОННОМ ЯЩИКЕ. ПЯТЬ
Dialogue: 0,0:03:14.49,0:03:17.45,Caption,,0,0,0,,ГОСУДАРСТВ ОТКАЗАЛИСЬ ПОДДЕРЖАТЬ ПРОЕКТ НОВОГО
Dialogue: 0,0:03:17.45,0:03:20.83,Caption,,0,0,0,,БЮДЖЕТА ЕВРОСОЮЗА, ПРЕДУСМАТРИВАЮЩИЙ ДЛЯ УКРАИНЫ СТО
Dialogue: 0,0:03:20.83,0:03:23.73,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО НА СРОК С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО
Dialogue: 0,0:03:23.73,0:03:26.13,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ ГОД. ПРОТИВ
Dialogue: 0,0:03:26.13,0:03:28.91,Caption,,0,0,0,,ВЫСТУПИЛИ ПОЛЬША, ЧЕХИЯ, ВЕНГРИЯ,
Dialogue: 0,0:03:28.99,0:03:32.87,Caption,,0,0,0,,СЛОВАКИЯ И АВСТРИЯ. РОБЕРТ ФИЦО НАЗВАЛ ПРЕДЛОЖЕННУЮ
Dialogue: 0,0:03:32.87,0:03:35.82,Caption,,0,0,0,,КОНСТРУКЦИЮ НЕПРИЕМЛЕМОЙ ДЛЯ ВСЕЙ ПЯТЁРКИ. АНДРЕЙ
Dialogue: 0,0:03:35.82,0:03:38.35,Caption,,0,0,0,,БАБИШ ПОШЁЛ ДАЛЬШЕ И ПРЕДЛОЖИЛ ВООБЩЕ УБРАТЬ
Dialogue: 0,0:03:38.35,0:03:41.31,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ УКРАИНЫ ИЗ ОБЩЕГО БЮДЖЕТА ЕВРОСОЮЗА.
Dialogue: 0,0:03:43.60,0:03:45.84,Caption,,0,0,0,,НА ЭТОМ ФОНЕ УКРАИНСКИЕ АГРАРИИ ПОДАЮТ
Dialogue: 0,0:03:45.84,0:03:48.42,Caption,,0,0,0,,СИГНАЛЫ, КОТОРЫЕ С КАНЦЛЕРСКИМ ОПТИМИЗМОМ
Dialogue: 0,0:03:48.42,0:03:52.18,Caption,,0,0,0,,СОЧЕТАЮТСЯ ПРИМЕРНО КАК ХОРОШИЙ УРОЖАЙ С ПУСТЫМ ТОПЛИВНЫМ
Dialogue: 0,0:03:52.18,0:03:55.96,Caption,,0,0,0,,БАКОМ. ЗЕРНО СОБРАНО, НО БЫСТРО РЕАЛИЗОВАТЬ ЕГО СТАНОВИТСЯ
Dialogue: 0,0:03:55.96,0:03:58.80,Caption,,0,0,0,,ВСЁ ТРУДНЕЕ. БАНКИ ПРИ ЭТОМ НЕ ЗАБЫЛИ НИ ОБ ОДНОМ
Dialogue: 0,0:03:58.80,0:04:01.20,Caption,,0,0,0,,ВЫДАННОМ КРЕДИТЕ И НЕ ПЕРЕНЕСЛИ СРОКИ
Dialogue: 0,0:04:01.20,0:04:04.07,Caption,,0,0,0,,ПЛАТЕЖЕЙ ИЗ СОЧУВСТВИЯ. ПРЕДУПРЕЖДЕНИЯ УЖЕ
Dialogue: 0,0:04:04.07,0:04:07.56,Caption,,0,0,0,,ЗВУЧАЛИ. НЕКОТОРЫЕ ХОЗЯЙСТВА МОГУТ ПОДОЙТИ К ОЧЕРЕДНОЙ
Dialogue: 0,0:04:07.56,0:04:10.47,Caption,,0,0,0,,ПОСЕВНОЙ БЕЗ НЕОБХОДИМЫХ СРЕДСТВ. РУКОВОДИТЕЛЬ
Dialogue: 0,0:04:10.47,0:04:13.12,Caption,,0,0,0,,КОМПАНИИ НИБУЛОН АНДРЕЙ ВАДАТУРСКИЙ СЧИТАЕТ,
Dialogue: 0,0:04:13.43,0:04:15.85,Caption,,0,0,0,,ЧТО ПРИ СОХРАНЕНИИ НЫНЕШНЕЙ СИТУАЦИИ
Dialogue: 0,0:04:15.85,0:04:18.31,Caption,,0,0,0,,ПЕРВЫЕ КРУПНЫЕ АГРАРНЫЕ ПРЕДПРИЯТИЯ СПОСОБНЫ
Dialogue: 0,0:04:18.31,0:04:21.09,Caption,,0,0,0,,ОБАНКРОТИТЬСЯ УЖЕ ВЕСНОЙ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО
Dialogue: 0,0:04:21.09,0:04:24.20,Caption,,0,0,0,,ГОДА. МЕХАНИЗМ ЗДЕСЬ ВПОЛНЕ ЗЕМНОЙ. АТАКИ В
Dialogue: 0,0:04:24.20,0:04:28.76,Caption,,0,0,0,,ЧЁРНОМ МОРЕ МЕШАЮТ ВЫВОЗУ, ПОЭТОМУ ЗЕРНО ОСТАЁТСЯ ВНУТРИ УКРАИНЫ.
Dialogue: 0,0:04:28.76,0:04:31.64,Caption,,0,0,0,,ИЗБЫТОК ДАВИТ НА ЗАКУПОЧНЫЕ ЦЕНЫ. БАНКИ ВСЁ
Dialogue: 0,0:04:31.64,0:04:34.32,Caption,,0,0,0,,ОСТОРОЖНЕЕ ВЫДАЮТ ПРОИЗВОДИТЕЛЯМ НОВЫЕ КРЕДИТЫ.
Dialogue: 0,0:04:34.87,0:04:37.68,Caption,,0,0,0,,ГОСУДАРСТВО, СУДЯ ПО ОПУБЛИКОВАННЫМ СООБЩЕНИЯМ,
Dialogue: 0,0:04:37.94,0:04:40.25,Caption,,0,0,0,,ПОМОГАТЬ С ПОДГОТОВКОЙ СЛЕДУЮЩЕГО СЕВА
Dialogue: 0,0:04:40.25,0:04:43.26,Caption,,0,0,0,,НЕ ТОРОПИТСЯ. ВЕСНОЙ ДЕНЬГИ ОТ УРОЖАЯ ПРИДЁТСЯ
Dialogue: 0,0:04:43.26,0:04:46.67,Caption,,0,0,0,,ДЕЛИТЬ МЕЖДУ ДВУМЯ ОБЯЗАТЕЛЬСТВАМИ. МОЖНО РАССЧИТАТЬСЯ С
Dialogue: 0,0:04:46.67,0:04:49.20,Caption,,0,0,0,,БАНКОМ. МОЖНО ПРИОБРЕСТИ ДИЗЕЛЬНОЕ ТОПЛИВО,
Dialogue: 0,0:04:49.29,0:04:51.56,Caption,,0,0,0,,СЕМЕНА И УДОБРЕНИЯ. НА ВСЁ СРАЗУ
Dialogue: 0,0:04:51.56,0:04:55.60,Caption,,0,0,0,,СРЕДСТВ МОЖЕТ НЕ ХВАТИТЬ, А ПОЛЕ БАНКОВСКОЙ ВЫПИСКОЙ НЕ ЗАСЕЕШЬ.
Dialogue: 0,0:04:57.86,0:04:59.69,Caption,,0,0,0,,ЗЕРНО НА СКЛАДЕ МОЖНО РЕАЛИЗОВАТЬ
Dialogue: 0,0:04:59.69,0:05:02.14,Caption,,0,0,0,,ПОЗЖЕ, КОГДА ОТКРОЕТСЯ ВОЗМОЖНОСТЬ ДЛЯ
Dialogue: 0,0:05:02.14,0:05:05.62,Caption,,0,0,0,,ВЫВОЗА. НЕЗАСЕЯННОЕ ВЕСНОЙ ПОЛЕ ОСЕНЬЮ ДАСТ РОВНО ТО,
Dialogue: 0,0:05:05.86,0:05:09.91,Caption,,0,0,0,,ЧТО В НЕГО ВЛОЖИЛИ. НИЧЕГО. ДАЖЕ ЕСЛИ ЭКСПОРТ ПОСЛЕ ЭТОГО
Dialogue: 0,0:05:09.91,0:05:13.74,Caption,,0,0,0,,ПОЛНОСТЬЮ ВОССТАНОВИТСЯ, ОТПРАВЛЯТЬ БУДЕТ НЕЧЕГО. ВМЕСТЕ С
Dialogue: 0,0:05:13.74,0:05:16.02,Caption,,0,0,0,,УРОЖАЕМ ИСЧЕЗНЕТ И ВАЛЮТНАЯ ВЫРУЧКА,
Dialogue: 0,0:05:16.26,0:05:18.12,Caption,,0,0,0,,КОТОРУЮ УЖЕ НЕВОЗМОЖНО НАВЕРСТАТЬ
Dialogue: 0,0:05:18.12,0:05:21.21,Caption,,0,0,0,,ЗАДНИМ ЧИСЛОМ. СОРОК ОДИН ПРОЦЕНТ УКРАИНЦЕВ УЖЕ
Dialogue: 0,0:05:21.21,0:05:24.75,Caption,,0,0,0,,ОКАЗАЛСЯ ЗА ЧЕРТОЙ БЕДНОСТИ. МИЛЛИОНЫ СЕМЕЙ ЖИВУТ БЕЗ
Dialogue: 0,0:05:24.75,0:05:27.37,Caption,,0,0,0,,НАКОПЛЕНИЙ. У КАЖДОЙ ЧЕТВЁРТОЙ БЕДНОЙ СЕМЬИ
Dialogue: 0,0:05:27.37,0:05:30.93,Caption,,0,0,0,,ВОЗНИКАЛИ СЛОЖНОСТИ С ОПЛАТОЙ КОММУНАЛЬНЫХ СЧЕТОВ. И ИМЕННО
Dialogue: 0,0:05:30.93,0:05:33.52,Caption,,0,0,0,,ДЛЯ ЭТИХ ЛЮДЕЙ ГОТОВЯТ ОБСУЖДЕНИЕ СЕРЬЁЗНОГО
Dialogue: 0,0:05:33.52,0:05:38.06,Caption,,0,0,0,,УВЕЛИЧЕНИЯ ТАРИФОВ. РЕКОМЕНДАЦИИ МВФ ПРЕДУСМАТРИВАЮТ ДВА
Dialogue: 0,0:05:38.06,0:05:40.41,Caption,,0,0,0,,ВАРИАНТА ИЗМЕНЕНИЯ ЦЕН В ПЕРИОД С ДВЕ ТЫСЯЧИ
Dialogue: 0,0:05:40.41,0:05:42.61,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОГО ПО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:05:42.61,0:05:45.61,Caption,,0,0,0,,ДЕВЯТЫЙ ГОД. ЖЁСТКИЙ ВАРИАНТ ПРЕДПОЛАГАЕТ РОСТ СТОИМОСТИ
Dialogue: 0,0:05:45.61,0:05:49.01,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА С ЧЕТЫРЁХ ГРИВЕН ТРИДЦАТИ ДВУХ КОПЕЕК ДО
Dialogue: 0,0:05:49.01,0:05:52.21,Caption,,0,0,0,,ДЕВЯТИ ГРИВЕН СЕМИДЕСЯТИ КОПЕЕК ЗА КИЛОВАТТ ЧАС.
Dialogue: 0,0:05:52.21,0:05:55.66,Caption,,0,0,0,,КУБОМЕТР ГАЗА ПРИ ТАКОМ ПОДХОДЕ ПОДОРОЖАЕТ С СЕМИ ГРИВЕН
Dialogue: 0,0:05:55.66,0:05:58.58,Caption,,0,0,0,,ДЕВЯНОСТА ШЕСТИ КОПЕЕК ДО ДВАДЦАТИ ДВУХ ГРИВЕН.
Dialogue: 0,0:05:59.22,0:06:01.07,Caption,,0,0,0,,БОЛЕЕ СДЕРЖАННЫЙ ВАРИАНТ ПОДНИМАЕТ
Dialogue: 0,0:06:01.07,0:06:03.70,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ДО ШЕСТИ ГРИВЕН ДЕВЯТИ КОПЕЕК,
Dialogue: 0,0:06:03.98,0:06:06.69,Caption,,0,0,0,,А ГАЗ ДО СЕМНАДЦАТИ ГРИВЕН ДВАДЦАТИ.
Dialogue: 0,0:06:06.69,0:06:09.24,Caption,,0,0,0,,СЛОВО СДЕРЖАННЫЙ ЗДЕСЬ ЯВНО ОБЛАДАЕТ ХОРОШИМ
Dialogue: 0,0:06:09.24,0:06:12.05,Caption,,0,0,0,,ЧУВСТВОМ ЮМОРА. БЮДЖЕТНЫЕ РАСХОДЫ ТРЕБУЕТСЯ
Dialogue: 0,0:06:12.05,0:06:17.06,Caption,,0,0,0,,УМЕНЬШАТЬ. ЭНЕРГЕТИЧЕСКИМ ПРЕДПРИЯТИЯМ НЕОБХОДИМО
Dialogue: 0,0:06:17.06,0:06:19.67,Caption,,0,0,0,,ОПЛАЧИВАТЬ ВОССТАНОВИТЕЛЬНЫЕ РАБОТЫ. ГОСУДАРСТВУ
Dialogue: 0,0:06:19.67,0:06:21.83,Caption,,0,0,0,,ПРИХОДИТСЯ НАРАЩИВАТЬ ВНЕШНИЕ ЗАЙМЫ,
Dialogue: 0,0:06:22.09,0:06:24.00,Caption,,0,0,0,,ХОТЯ ДОЛГ УЖЕ ПРИБЛИЗИЛСЯ К СТА
Dialogue: 0,0:06:24.00,0:06:27.40,Caption,,0,0,0,,ПРОЦЕНТАМ ВАЛОВОГО ВНУТРЕННЕГО ПРОДУКТА. ЗАНИЖЕННЫЕ
Dialogue: 0,0:06:27.40,0:06:30.79,Caption,,0,0,0,,ТАРИФЫ СОКРАЩАЮТ НАЛОГОВЫЕ ПОСТУПЛЕНИЯ. КРОМЕ ТОГО,
Dialogue: 0,0:06:31.03,0:06:32.96,Caption,,0,0,0,,В МЕМОРАНДУМЕ С МЕЖДУНАРОДНЫМ ВАЛЮТНЫМ
Dialogue: 0,0:06:32.96,0:06:35.25,Caption,,0,0,0,,ФОНДОМ УКРАИНА УЖЕ ПРИНЯЛА ОБЯЗАТЕЛЬСТВО
Dialogue: 0,0:06:35.25,0:06:38.18,Caption,,0,0,0,,УВЕЛИЧИВАТЬ СТОИМОСТЬ ЖИЛИЩНО КОММУНАЛЬНЫХ УСЛУГ.
Dialogue: 0,0:06:38.18,0:06:40.90,Caption,,0,0,0,,ПОДДЕРЖКА ЦЕН НА ЭНЕРГОНОСИТЕЛИ СЕЙЧАС ОБХОДИТСЯ
Dialogue: 0,0:06:40.90,0:06:43.59,Caption,,0,0,0,,ПОЧТИ В ЧЕТЫРЕ ПРОЦЕНТА ВАЛОВОГО ВНУТРЕННЕГО
Dialogue: 0,0:06:43.59,0:06:47.13,Caption,,0,0,0,,ПРОДУКТА. АДРЕСНАЯ ПОМОЩЬ ТОЖЕ РАБОТАЕТ ВСЁ ХУЖЕ.
Dialogue: 0,0:06:47.13,0:06:50.06,Caption,,0,0,0,,МИГРАЦИЯ, НЕЗАЯВЛЕННЫЕ ЗАРАБОТКИ И ПОСТОЯННЫЕ
Dialogue: 0,0:06:50.06,0:06:53.31,Caption,,0,0,0,,ИЗМЕНЕНИЯ В СОСТАВЕ СЕМЕЙ МЕШАЮТ ГОСУДАРСТВУ ТОЧНО
Dialogue: 0,0:06:53.31,0:06:56.01,Caption,,0,0,0,,ОПРЕДЕЛЯТЬ, КОМУ СУБСИДИЯ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:06:56.01,0:06:59.41,Caption,,0,0,0,,НЕОБХОДИМА. ПОЛНЫЙ НАБОР ПРЕОБРАЗОВАНИЙ В ЖЁСТКОМ ВАРИАНТЕ
Dialogue: 0,0:06:59.41,0:07:02.63,Caption,,0,0,0,,ДОЛЖЕН СЭКОНОМИТЬ ТРИ ЦЕЛЫХ ДВЕ ДЕСЯТЫХ ПРОЦЕНТА
Dialogue: 0,0:07:02.63,0:07:06.84,Caption,,0,0,0,,ВАЛОВОГО ВНУТРЕННЕГО ПРОДУКТА. БОЛЕЕ МЯГКИЙ НАБОР ДАСТ ОДНУ
Dialogue: 0,0:07:06.84,0:07:11.37,Caption,,0,0,0,,ЦЕЛУЮ ПЯТЬ ДЕСЯТЫХ ПРОЦЕНТА. РАСЧЁТЫ МВФ ПОКАЗЫВАЮТ ЕЩЁ ОДНУ
Dialogue: 0,0:07:11.37,0:07:14.53,Caption,,0,0,0,,НЕПРИЯТНУЮ ПРОПОРЦИЮ. НЫНЕШНЯЯ ЦЕНА ЭЛЕКТРИЧЕСТВА
Dialogue: 0,0:07:14.53,0:07:17.35,Caption,,0,0,0,,ПОКРЫВАЕТ ПРИБЛИЗИТЕЛЬНО СОРОК ОДИН ПРОЦЕНТ
Dialogue: 0,0:07:17.35,0:07:20.24,Caption,,0,0,0,,ЗАТРАТ НА ЕГО ВЫРАБОТКУ И ДОСТАВКУ. ДЛЯ ГАЗА
Dialogue: 0,0:07:20.24,0:07:23.95,Caption,,0,0,0,,ПОКРЫТИЕ СОСТАВЛЯЕТ ОКОЛО СОРОКА ДЕВЯТИ ПРОЦЕНТОВ. ПОЭТОМУ
Dialogue: 0,0:07:23.95,0:07:26.84,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ПРЕДЛАГАЮТ СДЕЛАТЬ ДОРОЖЕ ПРИМЕРНО В
Dialogue: 0,0:07:26.84,0:07:28.71,Caption,,0,0,0,,ДВЕ ЦЕЛЫХ ЧЕТЫРЕ ДЕСЯТЫХ РАЗА,
Dialogue: 0,0:07:28.95,0:07:34.31,Caption,,0,0,0,,А ГАЗ ПОЧТИ ВДВОЕ. ТУТ ХОЧЕТСЯ ЗАДАТЬ ОДИН КОРОТКИЙ
Dialogue: 0,0:07:34.31,0:07:37.26,Caption,,0,0,0,,ВОПРОС. ПОЧТИ ПОЛОВИНА СТРАНЫ УЖЕ ЖИВЁТ ЗА ГРАНИЦЕЙ
Dialogue: 0,0:07:37.26,0:07:39.90,Caption,,0,0,0,,БЕДНОСТИ. ТЕПЕРЬ КОММУНАЛЬНЫЕ РАСХОДЫ СОБИРАЮТСЯ
Dialogue: 0,0:07:39.90,0:07:42.67,Caption,,0,0,0,,УВЕЛИЧИТЬ ПРИБЛИЗИТЕЛЬНО ВДВОЕ. КАКОВА ЦЕЛЬ?
Dialogue: 0,0:07:43.04,0:07:44.75,Caption,,0,0,0,,ДОБРОСИТЬ ТУДА И ВТОРУЮ ПОЛОВИНУ?
Dialogue: 0,0:07:45.32,0:07:47.28,Caption,,0,0,0,,ПО ИНФОРМАЦИИ СО ССЫЛКОЙ НА ВСЕМИРНЫЙ
Dialogue: 0,0:07:47.28,0:07:49.37,Caption,,0,0,0,,БАНК, БЕДНОСТЬ ПОДНЯЛАСЬ С ДВАДЦАТИ
Dialogue: 0,0:07:49.37,0:07:52.90,Caption,,0,0,0,,ПРОЦЕНТОВ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ ДО СОРОКА ДВУХ
Dialogue: 0,0:07:52.90,0:07:55.19,Caption,,0,0,0,,ПРОЦЕНТОВ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ. В
Dialogue: 0,0:07:55.19,0:07:58.35,Caption,,0,0,0,,ПОСЛЕДУЮЩИХ МАТЕРИАЛАХ ПРИВОДИТСЯ ПОКАЗАТЕЛЬ В СОРОК ОДИН
Dialogue: 0,0:07:58.35,0:08:01.33,Caption,,0,0,0,,ПРОЦЕНТ. ЭТО НЕ ОТДЕЛЬНАЯ ПРОСЛОЙКА И НЕ НЕБОЛЬШОЙ
Dialogue: 0,0:08:01.33,0:08:04.20,Caption,,0,0,0,,ПРОЦЕНТ ЛЮДЕЙ, КОТОРЫМ МОЖНО ПОСОВЕТОВАТЬ НЕМНОГО
Dialogue: 0,0:08:04.20,0:08:07.05,Caption,,0,0,0,,СОКРАТИТЬ РАСХОДЫ. ЭТО ПОЧТИ ПОЛОВИНА НАСЕЛЕНИЯ
Dialogue: 0,0:08:07.05,0:08:10.91,Caption,,0,0,0,,УКРАИНЫ. НАВЕРНОЕ, ИМЕННО ТАК ВЫГЛЯДИТ ЭКОНОМИКА,
Dialogue: 0,0:08:11.07,0:08:13.42,Caption,,0,0,0,,ЛЕТЯЩАЯ ВВЕРХ В ПРЕДСТАВЛЕНИИ ФРИДРИХА
Dialogue: 0,0:08:13.42,0:08:16.32,Caption,,0,0,0,,МЕРЦА. С ЗЕМЛИ ЕЁ ТРАЕКТОРИЮ ПОЧЕМУ ТО НЕ
Dialogue: 0,0:08:16.32,0:08:18.43,Caption,,0,0,0,,ВИДНО. ЕСЛИ ВАМ НУЖНЫ РАЗБОРЫ,
Dialogue: 0,0:08:18.67,0:08:20.29,Caption,,0,0,0,,В КОТОРЫХ ЗАЯВЛЕНИЯ ЧИНОВНИКОВ
Dialogue: 0,0:08:20.29,0:08:22.88,Caption,,0,0,0,,ВСТРЕЧАЮТСЯ С РЕАЛЬНЫМИ ЧИСЛАМИ БЕЗ ОХРАНЫ И
Dialogue: 0,0:08:22.88,0:08:26.21,Caption,,0,0,0,,ПЕРЕВОДЧИКА, ПОДПИШИТЕСЬ НА КАНАЛ. У ЭТОЙ ИСТОРИИ
Dialogue: 0,0:08:26.21,0:08:29.62,Caption,,0,0,0,,ОСТАЁТСЯ ЧАСТЬ, ГДЕ ФИНАНСОВЫЕ ТАБЛИЦЫ ПРЕВРАЩАЮТСЯ В
Dialogue: 0,0:08:29.62,0:08:32.44,Caption,,0,0,0,,РЕШЕНИЯ КОНКРЕТНЫХ ЛЮДЕЙ. НА ВЕДЕНИЕ ВОЙНЫ
Dialogue: 0,0:08:32.44,0:08:35.31,Caption,,0,0,0,,СРЕДСТВА НАХОДЯТСЯ. И РЕЧЬ ИДЁТ НЕ О МЕЛОЧИ,
Dialogue: 0,0:08:35.55,0:08:38.06,Caption,,0,0,0,,А О ДЕСЯТКАХ МИЛЛИАРДОВ. КОГДА ДЕНЬГИ
Dialogue: 0,0:08:38.06,0:08:42.19,Caption,,0,0,0,,ТРЕБУЮТСЯ ГОСУДАРСТВУ, ЕВРОПЕЙСКИЕ СТРУКТУРЫ ОБСУЖДАЮТ ЗАЙМЫ,
Dialogue: 0,0:08:42.29,0:08:47.59,Caption,,0,0,0,,ФОНДЫ И АКТИВЫ. КОГДА ПОМОЩЬ НУЖНА ЧЕЛОВЕКУ,
Dialogue: 0,0:08:47.77,0:08:51.98,Caption,,0,0,0,,ВНЕЗАПНО ВЫЯСНЯЕТСЯ, ЧТО КАЖДЫЙ ЕВРО ДОЛЖЕН ПРОЙТИ ДОСМОТР
Dialogue: 0,0:08:51.98,0:08:53.99,Caption,,0,0,0,,СТРОЖЕ, ЧЕМ ПАССАЖИР В АЭРОПОРТУ.
Dialogue: 0,0:08:54.63,0:08:56.27,Caption,,0,0,0,,ПОКАЗАТЕЛЬНЫЙ СЛУЧАЙ ПРОИЗОШЁЛ В
Dialogue: 0,0:08:56.27,0:08:58.95,Caption,,0,0,0,,НЕМЕЦКОМ РАЙОНЕ ГРАЙЦ, РАСПОЛОЖЕННОМ В ТЮРИНГИИ.
Dialogue: 0,0:08:59.51,0:09:01.73,Caption,,0,0,0,,ТАМ ПРОВЕРИЛИ ШЕСТЬСОТ ПЯТЬДЕСЯТ ШЕСТЬ
Dialogue: 0,0:09:01.73,0:09:04.65,Caption,,0,0,0,,УКРАИНЦЕВ, ПОЛУЧАВШИХ СОЦИАЛЬНЫЕ ВЫПЛАТЫ. У
Dialogue: 0,0:09:04.65,0:09:07.83,Caption,,0,0,0,,ПЯТИДЕСЯТИ ЧЕТЫРЁХ ЧЕЛОВЕК ОБНАРУЖИЛИСЬ ДОХОДЫ,
Dialogue: 0,0:09:08.15,0:09:10.63,Caption,,0,0,0,,КОТОРЫЕ НЕ БЫЛИ УКАЗАНЫ ПРИ ОФОРМЛЕНИИ
Dialogue: 0,0:09:10.63,0:09:13.53,Caption,,0,0,0,,ПОМОЩИ. ЭТО ВОСЕМЬ ЦЕЛЫХ ДВЕ ДЕСЯТЫХ ПРОЦЕНТА ОТ
Dialogue: 0,0:09:13.53,0:09:16.14,Caption,,0,0,0,,ЧИСЛА ПРОВЕРЕННЫХ. ШЕСТНАДЦАТЬ ПОЛУЧАТЕЛЕЙ
Dialogue: 0,0:09:16.14,0:09:19.02,Caption,,0,0,0,,ПОЛНОСТЬЮ ЛИШИЛИСЬ ПОСОБИЯ. ЕЩЁ ТРИДЦАТИ ВОСЬМИ
Dialogue: 0,0:09:19.02,0:09:23.12,Caption,,0,0,0,,РАЗМЕР ВЫПЛАТ УМЕНЬШИЛИ. СРЕДИ НЕЗАЯВЛЕННЫХ ПОСТУПЛЕНИЙ БЫЛИ
Dialogue: 0,0:09:23.12,0:09:26.69,Caption,,0,0,0,,УКРАИНСКИЕ ПЕНСИИ, АРЕНДНАЯ ПЛАТА ЗА НЕДВИЖИМОСТЬ И ИНЫЕ
Dialogue: 0,0:09:26.69,0:09:29.47,Caption,,0,0,0,,ДОХОДЫ. ВЫЯВИТЬ ИХ НЕМЕЦКИМ СЛУЖАЩИМ ПОМОГЛИ
Dialogue: 0,0:09:29.47,0:09:32.46,Caption,,0,0,0,,СПРАВКИ ИЗ УКРАИНСКОГО ПРИЛОЖЕНИЯ ДІЯ. ПРЯМОГО
Dialogue: 0,0:09:32.46,0:09:35.48,Caption,,0,0,0,,ВХОДА В УКРАИНСКУЮ СИСТЕМУ У ВЕДОМСТВ ГЕРМАНИИ
Dialogue: 0,0:09:35.48,0:09:38.37,Caption,,0,0,0,,НЕТ. ЗАТО ОНИ ВПРАВЕ ПОПРОСИТЬ САМОГО ЗАЯВИТЕЛЯ
Dialogue: 0,0:09:38.37,0:09:41.11,Caption,,0,0,0,,СФОРМИРОВАТЬ ЭЛЕКТРОННЫЙ ДОКУМЕНТ И ПРЕДЪЯВИТЬ ЕГО.
Dialogue: 0,0:09:41.75,0:09:43.64,Caption,,0,0,0,,НЕМЕЦКИЕ НОРМЫ ТРЕБУЮТ СООБЩАТЬ О
Dialogue: 0,0:09:43.64,0:09:46.17,Caption,,0,0,0,,ДОХОДАХ И СОБСТВЕННОСТИ ВСЕМ ПОЛУЧАТЕЛЯМ
Dialogue: 0,0:09:46.17,0:09:49.07,Caption,,0,0,0,,ПОСОБИЙ, НЕЗАВИСИМО ОТ ГРАЖДАНСТВА. ПРИ ЭТОМ
Dialogue: 0,0:09:49.07,0:09:52.06,Caption,,0,0,0,,НЕЛЬЗЯ УТВЕРЖДАТЬ, ЧТО КАЖДЫЙ ИЗ ПЯТИДЕСЯТИ ЧЕТЫРЁХ
Dialogue: 0,0:09:52.06,0:09:54.83,Caption,,0,0,0,,ЧЕЛОВЕК НАМЕРЕННО ЧТО ТО СКРЫВАЛ. КТО ТО МОГ НЕ
Dialogue: 0,0:09:54.83,0:09:58.31,Caption,,0,0,0,,РАЗОБРАТЬСЯ В ТРЕБОВАНИЯХ, КТО ТО МОГ НЕПРАВИЛЬНО ПОНЯТЬ ИХ ИЗ ЗА
Dialogue: 0,0:09:58.39,0:10:02.63,Caption,,0,0,0,,ЯЗЫКА. ЭТИ СЛУЧАИ НЕ ДАЮТ ОСНОВАНИЙ
Dialogue: 0,0:10:02.63,0:10:05.56,Caption,,0,0,0,,ЗАПИСЫВАТЬ ВСЕХ УКРАИНСКИХ БЕЖЕНЦЕВ В НАРУШИТЕЛИ. ЗА
Dialogue: 0,0:10:05.56,0:10:08.56,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫМИ ДЕНЬГАМИ ОБЫЧНО ИДУТ НЕ ИЗ СПОРТИВНОГО
Dialogue: 0,0:10:08.56,0:10:10.67,Caption,,0,0,0,,ИНТЕРЕСА. ЗАКОН НАРУШАТЬ НЕЛЬЗЯ,
Dialogue: 0,0:10:11.18,0:10:13.21,Caption,,0,0,0,,НО И БЕДНОСТЬ ОТ СУРОВОГО ВЫРАЖЕНИЯ
Dialogue: 0,0:10:13.21,0:10:16.27,Caption,,0,0,0,,ЛИЦА ЧИНОВНИКА НИКУДА НЕ ИСЧЕЗАЕТ. ДОХОДЫ,
Dialogue: 0,0:10:16.35,0:10:20.38,Caption,,0,0,0,,ПОДЛЕЖАЩИЕ ДЕКЛАРИРОВАНИЮ, ДОЛЖНЫ БЫТЬ УКАЗАНЫ. ОДНАКО ДОМА У
Dialogue: 0,0:10:20.38,0:10:23.49,Caption,,0,0,0,,ЭТИХ ЛЮДЕЙ СОРОК ОДИН ПРОЦЕНТ НАСЕЛЕНИЯ ЖИВЁТ ЗА
Dialogue: 0,0:10:23.49,0:10:27.53,Caption,,0,0,0,,ЧЕРТОЙ БЕДНОСТИ, А ЗАРАБОТКИ МНОГИХ СЕМЕЙ СОКРАЩАЮТСЯ.
Dialogue: 0,0:10:27.53,0:10:29.98,Caption,,0,0,0,,СОЦИАЛЬНАЯ ПРИЧИНА ЗДЕСЬ НЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:10:29.98,0:10:32.91,Caption,,0,0,0,,ОПРАВДАНИЕ, НО ВЫЧЕРКНУТЬ ЕЁ ТОЖЕ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:10:33.64,0:10:35.21,Caption,,0,0,0,,ДЛЯ КАЗНЫ РАЙОНА ПРОВЕРКА ДАЛА
Dialogue: 0,0:10:35.21,0:10:38.59,Caption,,0,0,0,,ИЗМЕРИМЫЙ РЕЗУЛЬТАТ. ПОСЛЕ ПРЕКРАЩЕНИЯ ПОМОЩИ ШЕСТНАДЦАТИ
Dialogue: 0,0:10:38.59,0:10:41.24,Caption,,0,0,0,,ПОЛУЧАТЕЛЯМ ГОДОВАЯ ЭКОНОМИЯ ДОСТИГЛА СТА
Dialogue: 0,0:10:41.24,0:10:44.44,Caption,,0,0,0,,ПЯТИДЕСЯТИ ОДНОЙ ТЫСЯЧИ ЧЕТЫРЁХСОТ СОРОКА ЕВРО.
Dialogue: 0,0:10:44.44,0:10:47.84,Caption,,0,0,0,,УМЕНЬШЕНИЕ ПОСОБИЙ ЕЩЁ ТРИДЦАТИ ВОСЬМИ ЛЮДЯМ ПОЗВОЛЯЕТ
Dialogue: 0,0:10:47.84,0:10:50.82,Caption,,0,0,0,,СОХРАНЯТЬ ПРИМЕРНО ОТ СЕМИ С ПОЛОВИНОЙ ДО ВОСЬМИ
Dialogue: 0,0:10:50.82,0:10:53.74,Caption,,0,0,0,,ТЫСЯЧ ЕВРО КАЖДЫЙ МЕСЯЦ. ВСЕ ШЕСТНАДЦАТЬ
Dialogue: 0,0:10:53.74,0:10:56.43,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫМ ВЫПЛАТЫ ОТМЕНИЛИ ПОЛНОСТЬЮ,
Dialogue: 0,0:10:56.74,0:10:59.29,Caption,,0,0,0,,ЗАТЕМ УЕХАЛИ ИЗ РАЙОНА ГРАЙЦ. ИХ НОВОЕ
Dialogue: 0,0:10:59.29,0:11:01.93,Caption,,0,0,0,,МЕСТО ЖИТЕЛЬСТВА НЕИЗВЕСТНО. НИ ОДИН ИЗ НИХ
Dialogue: 0,0:11:01.93,0:11:04.71,Caption,,0,0,0,,НЕ СТАЛ ОБЖАЛОВАТЬ ПРИНЯТОЕ РЕШЕНИЕ. ВЛАСТИ
Dialogue: 0,0:11:04.71,0:11:08.18,Caption,,0,0,0,,ПРОДОЛЖАЮТ ПРОВЕРКИ, ВКЛЮЧАЯ КОНТРОЛЬ НОВЫХ ЗАЯВЛЕНИЙ НА
Dialogue: 0,0:11:08.18,0:11:13.62,Caption,,0,0,0,,СОЦИАЛЬНУЮ ПОДДЕРЖКУ. ОБЩЕЙ СТАТИСТИКИ ПО ГЕРМАНИИ ПОКА НЕ
Dialogue: 0,0:11:13.62,0:11:16.43,Caption,,0,0,0,,СУЩЕСТВУЕТ, ПОЭТОМУ ВОСЕМЬ ЦЕЛЫХ ДВЕ ДЕСЯТЫХ
Dialogue: 0,0:11:16.43,0:11:19.22,Caption,,0,0,0,,ПРОЦЕНТА ИЗ ОДНОГО РАЙОНА НЕЛЬЗЯ АВТОМАТИЧЕСКИ
Dialogue: 0,0:11:19.22,0:11:22.99,Caption,,0,0,0,,РАСПРОСТРАНЯТЬ НА ВСЮ СТРАНУ. ЗАТО ПОНЯТЕН РАЗМЕР ВСЕЙ
Dialogue: 0,0:11:22.99,0:11:25.74,Caption,,0,0,0,,СИСТЕМЫ. НЕМЕЦКИЕ СОЦИАЛЬНЫЕ ВЫПЛАТЫ ПОЛУЧАЮТ
Dialogue: 0,0:11:25.74,0:11:29.23,Caption,,0,0,0,,ПРИБЛИЗИТЕЛЬНО ШЕСТЬСОТ ДВАДЦАТЬ ШЕСТЬ ТЫСЯЧ ГРАЖДАН УКРАИНЫ.
Dialogue: 0,0:11:29.23,0:11:31.58,Caption,,0,0,0,,ПОКА НЕМЕЦКИЕ ЧИНОВНИКИ ИЗУЧАЮТ СПРАВКИ И
Dialogue: 0,0:11:31.58,0:11:35.21,Caption,,0,0,0,,ПЕРЕСЧИТЫВАЮТ ПОСОБИЯ, ЛЮДИ С БОЛЕЕ ШИРОКИМИ ВОЗМОЖНОСТЯМИ В
Dialogue: 0,0:11:35.21,0:11:38.01,Caption,,0,0,0,,КИЕВЕ ВЫБИРАЮТ ДРУГОЙ СПОСОБ ПЕРЕЖИТЬ БЫТОВЫЕ
Dialogue: 0,0:11:38.01,0:11:41.17,Caption,,0,0,0,,ПРОБЛЕМЫ. НЕКОТОРЫЕ ИЗВЕСТНЫЕ УКРАИНСКИЕ АРТИСТЫ РЕШИЛИ
Dialogue: 0,0:11:41.17,0:11:44.15,Caption,,0,0,0,,ПРОВЕСТИ ЗИМУ НЕ В СТОЛИЦЕ. ПРИЧИНОЙ СТАЛИ ПЕРЕБОИ С
Dialogue: 0,0:11:44.15,0:11:47.00,Caption,,0,0,0,,ОТОПЛЕНИЕМ, ВОДОЙ И ЭЛЕКТРИЧЕСТВОМ. В ЧИСЛЕ
Dialogue: 0,0:11:47.00,0:11:49.36,Caption,,0,0,0,,УЕХАВШИХ УПОМИНАЮТСЯ ЕЛЕНА КРАВЕЦ,
Dialogue: 0,0:11:49.51,0:11:52.16,Caption,,0,0,0,,ИРИНА СОПОНАРУ, НАЗАР ЗАДНЕПРОВСКИЙ,
Dialogue: 0,0:11:52.32,0:11:54.96,Caption,,0,0,0,,ЕКАТЕРИНА ТЫШКЕВИЧ, ВАЛЕНТИН ТОМУСЯК,
Dialogue: 0,0:11:55.11,0:11:57.76,Caption,,0,0,0,,СВЕТЛАНА ТАРАБАРОВА И ALYONA ALYONA.
Dialogue: 0,0:11:57.76,0:12:00.99,Caption,,0,0,0,,ЧАСТЬ ИЗ НИХ ПЕРЕБРАЛАСЬ НА ЗАПАД УКРАИНЫ. ДРУГИЕ
Dialogue: 0,0:12:00.99,0:12:03.56,Caption,,0,0,0,,ПОКИНУЛИ СТРАНУ. НО ТАКАЯ ВОЗМОЖНОСТЬ ЕСТЬ
Dialogue: 0,0:12:03.56,0:12:06.40,Caption,,0,0,0,,ДАЛЕКО НЕ У ВСЕХ. КУДА УЕХАТЬ СЕМЬЕ,
Dialogue: 0,0:12:06.56,0:12:09.76,Caption,,0,0,0,,У КОТОРОЙ НЕТ НАКОПЛЕНИЙ? ЧТО ПРЕДПРИНЯТЬ ЧЕЛОВЕКУ,
Dialogue: 0,0:12:09.99,0:12:11.93,Caption,,0,0,0,,КОТОРЫЙ УЖЕ СЕЙЧАС С ТРУДОМ ЗАКРЫВАЕТ
Dialogue: 0,0:12:11.93,0:12:15.44,Caption,,0,0,0,,КОММУНАЛЬНЫЕ СЧЕТА? КАК ЕМУ ГОТОВИТЬСЯ К РЫНОЧНЫМ ТАРИФАМ,
Dialogue: 0,0:12:15.64,0:12:17.67,Caption,,0,0,0,,ЕСЛИ НЫНЕШНЯЯ ЦЕНА ЭЛЕКТРИЧЕСТВА УЖЕ
Dialogue: 0,0:12:17.67,0:12:21.99,Caption,,0,0,0,,ТЯЖЕЛА ДЛЯ ДОМАШНЕГО БЮДЖЕТА? НА ЭТОМ МЕСТЕ МАКРОЭКОНОМИЧЕСКИЙ УСПЕХ
Dialogue: 0,0:12:21.99,0:12:25.44,Caption,,0,0,0,,СНИМАЕТ ПИДЖАК, ЗАХОДИТ В КВАРТИРУ И ЛОЖИТСЯ НА СТОЛ
Dialogue: 0,0:12:25.44,0:12:30.46,Caption,,0,0,0,,НОВОЙ ПЛАТЁЖКОЙ. СЕМЕЙНЫЙ БЮДЖЕТ СЛУШАЕТ ТАКИЕ
Dialogue: 0,0:12:30.46,0:12:34.28,Caption,,0,0,0,,ВЫСТУПЛЕНИЯ ПЛОХО. ЕГО ИНТЕРЕСУЕТ ОСТАТОК ПОСЛЕ ОПЛАТЫ СВЕТА,
Dialogue: 0,0:12:34.37,0:12:37.66,Caption,,0,0,0,,ГАЗА, ПРОДУКТОВ И ЛЕКАРСТВ. ЕСЛИ ОСТАТКА
Dialogue: 0,0:12:37.66,0:12:39.76,Caption,,0,0,0,,НЕТ, БОДРЫЙ ПРОЦЕНТ В ДОКЛАДЕ МОЖНО
Dialogue: 0,0:12:39.76,0:12:43.65,Caption,,0,0,0,,ПОСТАВИТЬ НА ПОЛКУ. ЕСТЬ ЕГО ВСЁ РАВНО НЕЛЬЗЯ. ПОЭТОМУ
Dialogue: 0,0:12:43.65,0:12:45.96,Caption,,0,0,0,,ВОСТОРГ МЕРЦА И ВЫЗЫВАЕТ НЕДОУМЕНИЕ.
Dialogue: 0,0:12:46.68,0:12:48.29,Caption,,0,0,0,,НЕКОТОРЫЕ ПОКАЗАТЕЛИ УКРАИНСКОЙ
Dialogue: 0,0:12:48.29,0:12:51.02,Caption,,0,0,0,,ЭКОНОМИКИ ДЕЙСТВИТЕЛЬНО МОГУТ УВЕЛИЧИВАТЬСЯ. НО
Dialogue: 0,0:12:51.02,0:12:53.48,Caption,,0,0,0,,РЯДОМ СУЩЕСТВУЮТ СОРОК ОДИН ПРОЦЕНТ БЕДНЫХ,
Dialogue: 0,0:12:53.94,0:12:55.79,Caption,,0,0,0,,ПАДЕНИЕ ДОХОДОВ ПРЕДПРИНИМАТЕЛЕЙ И
Dialogue: 0,0:12:55.79,0:12:59.86,Caption,,0,0,0,,АГРАРИЕВ, РИСК БАНКРОТСТВ, ВЫБОР МЕЖДУ ВЫПЛАТОЙ КРЕДИТА И НОВОЙ
Dialogue: 0,0:12:59.86,0:13:02.85,Caption,,0,0,0,,ПОСЕВНОЙ, А ТАКЖЕ ПОИСКИ ОЧЕРЕДНЫХ ДЕСЯТКОВ
Dialogue: 0,0:13:02.85,0:13:05.48,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ДЛЯ ПОДДЕРЖАНИЯ ГОСУДАРСТВЕННЫХ
Dialogue: 0,0:13:05.48,0:13:08.70,Caption,,0,0,0,,РАСХОДОВ. ОДНОГО СЛОВА РОСТ ДЛЯ ТАКОЙ КАРТИНЫ
Dialogue: 0,0:13:08.70,0:13:12.93,Caption,,0,0,0,,ЯВНО НЕДОСТАТОЧНО. САМЫЕ НЕПРИЯТНЫЕ ВОЗРАЖЕНИЯ НЕМЕЦКОМУ
Dialogue: 0,0:13:12.93,0:13:15.55,Caption,,0,0,0,,КАНЦЛЕРУ ПРИХОДЯТ ВОВСЕ НЕ ИЗ РОССИИ. ПЕРВОЕ
Dialogue: 0,0:13:15.55,0:13:18.38,Caption,,0,0,0,,ПРИНОСИТ ВСЕМИРНЫЙ БАНК СО СВОИМИ ДАННЫМИ О
Dialogue: 0,0:13:18.38,0:13:22.08,Caption,,0,0,0,,БЕДНОСТИ. ВТОРОЕ ПРЕДЪЯВЛЯЕТ МВФ В РАСЧЁТАХ ТАРИФНОГО
Dialogue: 0,0:13:22.08,0:13:25.02,Caption,,0,0,0,,РАЗРЫВА. ТРЕТЬЕ ПОЯВЛЯЕТСЯ В БЮДЖЕТАХ ЕВРОПЕЙСКИХ
Dialogue: 0,0:13:25.02,0:13:27.86,Caption,,0,0,0,,ГОСУДАРСТВ, КОТОРЫЕ ВСЁ ЧАЩЕ ИНТЕРЕСУЮТСЯ ЦЕНОЙ
Dialogue: 0,0:13:27.86,0:13:32.20,Caption,,0,0,0,,ПРОДОЛЖЕНИЯ ЭТОЙ ПОДДЕРЖКИ. НО САМЫЙ ТОЧНЫЙ ОТВЕТ ДАЁТ ЧЕЛОВЕК,
Dialogue: 0,0:13:32.44,0:13:34.78,Caption,,0,0,0,,ОТКРЫВАЮЩИЙ КОММУНАЛЬНЫЙ СЧЁТ. МОЖНО
Dialogue: 0,0:13:34.78,0:13:37.91,Caption,,0,0,0,,ПОКАЗАТЬ ЕМУ ДЕСЯТОК ДИАГРАММ. СУММА К ОПЛАТЕ ОТ
Dialogue: 0,0:13:37.91,0:13:41.19,Caption,,0,0,0,,ЭТОГО НЕ ПОХУДЕЕТ НИ НА ОДНУ ГРИВНУ. ЗАЙМЫ ЕЩЁ
Dialogue: 0,0:13:41.19,0:13:43.66,Caption,,0,0,0,,МОЖНО ПРОДЛИТЬ. НОВЫЙ ПАКЕТ ПОМОЩИ МОЖНО
Dialogue: 0,0:13:43.66,0:13:45.88,Caption,,0,0,0,,ПРОВЕСТИ ЧЕРЕЗ ОЧЕРЕДНОЕ СОГЛАСОВАНИЕ.
Dialogue: 0,0:13:48.18,0:13:50.35,Caption,,0,0,0,,НЕДОСТАЮЩИЕ МИЛЛИАРДЫ МОЖНО ПОИСКАТЬ В
Dialogue: 0,0:13:50.35,0:13:53.13,Caption,,0,0,0,,ЕВРОПЕЙСКОМ БЮДЖЕТЕ ИЛИ СРЕДИ ЗАМОРОЖЕННЫХ
Dialogue: 0,0:13:53.13,0:13:56.73,Caption,,0,0,0,,АКТИВОВ. С УРОЖАЕМ ЭТОТ ПРИЁМ НЕ СРАБОТАЕТ. ЕСЛИ У
Dialogue: 0,0:13:56.73,0:13:59.54,Caption,,0,0,0,,АГРАРИЯ ВЕСНОЙ НЕ ОКАЗАЛОСЬ ДЕНЕГ НА ПОСЕВНУЮ,
Dialogue: 0,0:13:59.92,0:14:02.02,Caption,,0,0,0,,ОСЕНЬЮ КРЕДИТ УЖЕ НЕ ЗАСТАВИТ ПУСТОЕ
Dialogue: 0,0:14:02.02,0:14:04.95,Caption,,0,0,0,,ПОЛЕ РОДИТЬ ЗЕРНО. СТОЛЬ ЖЕ ОПАСНО РАСХОЖДЕНИЕ
Dialogue: 0,0:14:04.95,0:14:08.12,Caption,,0,0,0,,МЕЖДУ ОТЧЁТНЫМ РОСТОМ И РЕАЛЬНОЙ ЖИЗНЬЮ. ЧЕМ ШИРЕ
Dialogue: 0,0:14:08.12,0:14:11.65,Caption,,0,0,0,,СТАНОВИТСЯ ЭТА ЩЕЛЬ, ТЕМ ТРУДНЕЕ ОТВЕЧАТЬ РАССКАЗАМИ О
Dialogue: 0,0:14:11.65,0:14:14.33,Caption,,0,0,0,,ПРОЦЕНТАХ И ВОССТАНОВЛЕНИИ. В КОНЦЕ ОСТАНЕТСЯ
Dialogue: 0,0:14:14.33,0:14:17.82,Caption,,0,0,0,,ВОПРОС БЕЗ СЛОЖНЫХ ТЕРМИНОВ, МНОГОТОМНЫХ МЕМОРАНДУМОВ И
Dialogue: 0,0:14:17.82,0:14:21.62,Caption,,0,0,0,,КАНЦЛЕРСКОГО ОПТИМИЗМА. КОМУ ИМЕННО СТАЛО ЛУЧШЕ ОТ ЭТОГО
Dialogue: 0,0:14:21.62,0:14:22.02,Caption,,0,0,0,,РОСТА?
