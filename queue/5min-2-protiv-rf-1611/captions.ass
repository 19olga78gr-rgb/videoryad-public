Dialogue: 0,0:00:00.12,0:00:01.80,Caption,,0,0,0,,КОГДА СОСЕД ДОЛЖЕН ВАМ ДЕНЬГИ,
Dialogue: 0,0:00:02.12,0:00:04.68,Caption,,0,0,0,,ВЫ ОБЫЧНО ПРОСИТЕ ВЕРНУТЬ ДОЛГ. КОГДА У ВАС
Dialogue: 0,0:00:04.76,0:00:09.00,Caption,,0,0,0,,ЛЕЖАТ ДЕНЬГИ СОСЕДА, СИТУАЦИЯ УЖЕ ГОРАЗДО ИНТЕРЕСНЕЕ. ОСОБЕННО ЕСЛИ ВЫ
Dialogue: 0,0:00:09.00,0:00:12.28,Caption,,0,0,0,,РЕШИЛИ, ЧТО СОСЕД ЧЕЛОВЕК НЕХОРОШИЙ И ДЕНЬГИ ЕМУ БОЛЬШЕ
Dialogue: 0,0:00:12.36,0:00:17.08,Caption,,0,0,0,,НЕ НУЖНЫ. МОЖНО, КОНЕЧНО, ОБЪЯВИТЬ ИХ СВОИМИ. ТОЛЬКО ЕСТЬ ОДНА МАЛЕНЬКАЯ
Dialogue: 0,0:00:17.08,0:00:19.88,Caption,,0,0,0,,НЕПРИЯТНОСТЬ ОСТАЛЬНЫЕ СОСЕДИ ПОСЛЕ ТАКОГО НАЧИНАЮТ
Dialogue: 0,0:00:19.88,0:00:22.60,Caption,,0,0,0,,КРЕПЧЕ ДЕРЖАТЬСЯ ЗА СОБСТВЕННЫЕ КОШЕЛЬКИ. И ВОТ В
Dialogue: 0,0:00:22.60,0:00:25.32,Caption,,0,0,0,,ЕВРОПЕ СНОВА ВОЗВРАЩАЮТСЯ К ЭТОЙ ИСТОРИИ. ОПЯТЬ
Dialogue: 0,0:00:25.32,0:00:29.40,Caption,,0,0,0,,ОБСУЖДАЮТ, КАК ЗАБРАТЬ РОССИЙСКИЕ ДЕНЬГИ. СНОВА НАСТУПАЮТ НА ТЕ
Dialogue: 0,0:00:29.40,0:00:32.44,Caption,,0,0,0,,ЖЕ ГРАБЛИ. ПРИЧЁМ САМЫЕ НЕУДОБНЫЕ ВОПРОСЫ ЗАДАЮТ
Dialogue: 0,0:00:32.52,0:00:34.52,Caption,,0,0,0,,ЛЮДИ, КОТОРЫЕ ПРЕКРАСНО ЗНАЮТ,
Dialogue: 0,0:00:34.70,0:00:37.24,Caption,,0,0,0,,КАК УСТРОЕНЫ БОЛЬШИЕ ДЕНЬГИ. А ВОТ ОТВЕТЫ У
Dialogue: 0,0:00:37.24,0:00:39.96,Caption,,0,0,0,,ПОЛИТИКОВ ПОКА КАКИЕ ТО УДИВИТЕЛЬНО КОРОТКИЕ.
Dialogue: 0,0:00:40.52,0:00:42.68,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВЯТСЯ ТАКИЕ РАЗБОРЫ БЕЗ ЧИНОВНИЧЬЕЙ
Dialogue: 0,0:00:42.68,0:00:46.20,Caption,,0,0,0,,ЖВАЧКИ, ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:46.52,0:00:48.68,Caption,,0,0,0,,КОГДА ЗА КРАСИВЫМИ СЛОВАМИ НАДО СМОТРЕТЬ НЕ НА
Dialogue: 0,0:00:48.68,0:00:53.08,Caption,,0,0,0,,СЛОВА, А НА КАССУ. НАЧНЁМ С ЛАТВИИ. ТАМ РЕШИЛИ,
Dialogue: 0,0:00:53.30,0:00:58.20,Caption,,0,0,0,,ЧТО ЕВРОПЕ ПОРА, ЦИТИРУЮ, "ОТРАСТИТЬ ЯЙЦА ПОБОЛЬШЕ" И НАКОНЕЦ ЗАБРАТЬ
Dialogue: 0,0:00:58.20,0:00:59.88,Caption,,0,0,0,,ЗАМОРОЖЕННЫЕ РОССИЙСКИЕ АКТИВЫ.
Dialogue: 0,0:01:00.44,0:01:03.64,Caption,,0,0,0,,ЛОГИКА ПРОСТАЯ ДО ИЗЯЩЕСТВА. ДЕНЬГИ ЛЕЖАТ. ДЕНЬГИ
Dialogue: 0,0:01:03.64,0:01:06.76,Caption,,0,0,0,,РОССИЙСКИЕ. УКРАИНЕ ДЕНЬГИ НУЖНЫ. ЗНАЧИТ,
Dialogue: 0,0:01:06.84,0:01:10.28,Caption,,0,0,0,,ЧЕГО ОНИ ЛЕЖАТ? ВООБЩЕ ЭТО ПРЕКРАСНЫЙ УРОВЕНЬ ФИНАНСОВОГО
Dialogue: 0,0:01:10.28,0:01:15.69,Caption,,0,0,0,,ПЛАНИРОВАНИЯ. ПРИМЕРНО КАК ОТКРЫТЬ ЧУЖОЙ КОШЕЛЁК И СКАЗАТЬ НУ
Dialogue: 0,0:01:15.69,0:01:19.93,Caption,,0,0,0,,А ЧЕГО ОН БЕЗ ДЕЛА ЛЕЖИТ, ДАВАЙТЕ ПУСТИМ В ОБОРОТ. ПРИЧЁМ ТОТ ЖЕ ПОЛИТИК
Dialogue: 0,0:01:20.01,0:01:24.01,Caption,,0,0,0,,ПРИЗНАЁТ, ЧТО ПОМОЩЬ УКРАИНЕ САМОЙ ЛАТВИИ ДАЁТСЯ ТЯЖЕЛО. ТО
Dialogue: 0,0:01:24.01,0:01:26.09,Caption,,0,0,0,,ЕСТЬ ДЕНЕГ СТАНОВИТСЯ ЖАЛКО УЖЕ СВОИХ,
Dialogue: 0,0:01:26.42,0:01:29.77,Caption,,0,0,0,,НО ЗАТО ПОЯВИЛСЯ ВЕЛИКОЛЕПНЫЙ ИСТОЧНИК ЧУЖИХ. И ТУТ
Dialogue: 0,0:01:29.77,0:01:32.57,Caption,,0,0,0,,ВСЁ СРАЗУ СТАНОВИТСЯ ЗНАЧИТЕЛЬНО БОДРЕЕ. САМЫЕ
Dialogue: 0,0:01:32.57,0:01:35.53,Caption,,0,0,0,,МАЛЕНЬКИЕ ОПЯТЬ ОКАЗАЛИСЬ САМЫМИ ГРОМКИМИ. ТОЛЬКО
Dialogue: 0,0:01:35.61,0:01:38.57,Caption,,0,0,0,,ПРОБЛЕМА В ТОМ, ЧТО РОССИЙСКИЕ АКТИВЫ ЛЕЖАТ В ОСНОВНОМ НЕ В
Dialogue: 0,0:01:38.57,0:01:41.37,Caption,,0,0,0,,ЛАТВИИ. И ОТВЕЧАТЬ ЗА ПОСЛЕДСТВИЯ ЭТОГО ВЕСЕЛЬЯ
Dialogue: 0,0:01:41.45,0:01:46.17,Caption,,0,0,0,,ПРИДЁТСЯ СОВСЕМ ДРУГИМ ЛЮДЯМ. ВОТ ЗДЕСЬ НА СЦЕНУ ВЫХОДИТ EUROCLEAR. И ТОН
Dialogue: 0,0:01:46.17,0:01:49.37,Caption,,0,0,0,,РАЗГОВОРА РЕЗКО МЕНЯЕТСЯ. ГЛАВА ДЕПОЗИТАРИЯ ВАЛЕРИ
Dialogue: 0,0:01:49.37,0:01:51.37,Caption,,0,0,0,,УРБЕН ГОВОРИТ УЖЕ НЕ ПРО ЯЙЦА И НЕ
Dialogue: 0,0:01:51.37,0:01:54.25,Caption,,0,0,0,,ПРО РЕШИТЕЛЬНОСТЬ. ОНА ГОВОРИТ ПРО ИНВЕСТОРОВ. А
Dialogue: 0,0:01:54.25,0:01:56.73,Caption,,0,0,0,,ИНВЕСТОРЫ НАЧАЛИ ЗАДАВАТЬ ОЧЕНЬ ПРОСТОЙ ВОПРОС ЕСЛИ
Dialogue: 0,0:01:56.81,0:01:59.13,Caption,,0,0,0,,ЕВРОПА СЕГОДНЯ ПОЛИТИЧЕСКИМ РЕШЕНИЕМ ЗАБЕРЁТ
Dialogue: 0,0:01:59.13,0:02:00.73,Caption,,0,0,0,,СОБСТВЕННОСТЬ ОДНОГО ВЛАДЕЛЬЦА,
Dialogue: 0,0:02:01.05,0:02:04.73,Caption,,0,0,0,,КАКИЕ ГАРАНТИИ, ЧТО ЗАВТРА ПРАВИЛА СНОВА НЕ ПОМЕНЯЮТСЯ?
Dialogue: 0,0:02:04.97,0:02:07.45,Caption,,0,0,0,,ДЛЯ ФИНАНСОВОЙ СИСТЕМЫ ЭТО ВОПРОС НЕ МОРАЛИ. ЭТО
Dialogue: 0,0:02:07.53,0:02:10.25,Caption,,0,0,0,,ВОПРОС ДОВЕРИЯ. ЧЕЛОВЕК ПРИНОСИТ ДЕНЬГИ ТУДА,
Dialogue: 0,0:02:10.41,0:02:13.93,Caption,,0,0,0,,ГДЕ УВЕРЕН, ЧТО СУЩЕСТВУЕТ ПРАВИЛО. ОНО ЕМУ НРАВИТСЯ,
Dialogue: 0,0:02:14.09,0:02:16.73,Caption,,0,0,0,,НЕ НРАВИТСЯ, ЭТО ВТОРОЙ ВОПРОС. ГЛАВНОЕ,
Dialogue: 0,0:02:16.97,0:02:19.45,Caption,,0,0,0,,ЧТОБЫ ПРАВИЛО НЕ ПЕРЕПИСЫВАЛИ ЗАДНИМ ЧИСЛОМ,
Dialogue: 0,0:02:19.61,0:02:22.57,Caption,,0,0,0,,КОГДА КОМУ ТО ОЧЕНЬ ПОНАДОБИЛАСЬ КАССА. И УРБЕН
Dialogue: 0,0:02:22.57,0:02:24.73,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ О РИСКЕ ОТТОКА КАПИТАЛА.
Dialogue: 0,0:02:27.00,0:02:29.57,Caption,,0,0,0,,ПРИЧЁМ ЗДЕСЬ НАЧИНАЕТСЯ ОСОБЕННО КРАСИВАЯ ЧАСТЬ
Dialogue: 0,0:02:29.57,0:02:32.93,Caption,,0,0,0,,ИСТОРИИ. ЕВРОПЕ САМОЙ НУЖНЫ ОГРОМНЫЕ ДЕНЬГИ. НА
Dialogue: 0,0:02:33.01,0:02:36.13,Caption,,0,0,0,,ОБОРОНУ НУЖНЫ. НА ЦИФРОВЫЕ ТЕХНОЛОГИИ НУЖНЫ. НА
Dialogue: 0,0:02:36.13,0:02:39.33,Caption,,0,0,0,,ДЕМОГРАФИЧЕСКИЕ ПРОБЛЕМЫ НУЖНЫ. НА УКРАИНУ НУЖНЫ.
Dialogue: 0,0:02:39.57,0:02:42.05,Caption,,0,0,0,,ВЕЗДЕ НУЖНЫ. ТО ЕСТЬ ВЫ СОБИРАЕТЕСЬ ПОКАЗАТЬ
Dialogue: 0,0:02:42.13,0:02:43.81,Caption,,0,0,0,,КРУПНОМУ МЕЖДУНАРОДНОМУ КАПИТАЛУ,
Dialogue: 0,0:02:44.05,0:02:46.53,Caption,,0,0,0,,НАСКОЛЬКО ТВОРЧЕСКИ УМЕЕТЕ ОБРАЩАТЬСЯ С ЧУЖОЙ
Dialogue: 0,0:02:46.53,0:02:50.21,Caption,,0,0,0,,СОБСТВЕННОСТЬЮ, А СРАЗУ ПОСЛЕ ЭТОГО ПОПРОСИТЬ ЭТОТ КАПИТАЛ ПРИЙТИ
Dialogue: 0,0:02:50.29,0:02:52.85,Caption,,0,0,0,,К ВАМ И ВЛОЖИТЬ ЕЩЁ БОЛЬШЕ. ПЛАН ПОЧТИ
Dialogue: 0,0:02:52.85,0:02:55.49,Caption,,0,0,0,,ИДЕАЛЬНЫЙ. ОСТАЛОСЬ ТОЛЬКО ОБЪЯСНИТЬ ИНВЕСТОРУ,
Dialogue: 0,0:02:55.64,0:02:58.69,Caption,,0,0,0,,ПОЧЕМУ ЕГО ДЕНЬГИ ТОЧНО НЕ СТАНУТ СЛЕДУЮЩИМИ. И
Dialogue: 0,0:02:58.77,0:03:00.93,Caption,,0,0,0,,ВЕДЬ РАЗГОВОР О РОССИЙСКИХ АКТИВАХ ИДЁТ НЕ ПЕРВЫЙ
Dialogue: 0,0:03:01.01,0:03:03.81,Caption,,0,0,0,,МЕСЯЦ. К ЭТОЙ ТЕМЕ ВОЗВРАЩАЮТСЯ СНОВА И СНОВА.
Dialogue: 0,0:03:04.20,0:03:06.69,Caption,,0,0,0,,ПОТОМУ ЧТО ЭКОНОМИЧЕСКИХ РЫЧАГОВ ДАВЛЕНИЯ СТАНОВИТСЯ
Dialogue: 0,0:03:06.77,0:03:08.93,Caption,,0,0,0,,ВСЁ МЕНЬШЕ. САНКЦИЙ СКОЛЬКО УЖЕ БЫЛО?
Dialogue: 0,0:03:08.93,0:03:11.25,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТЫЙ ПАКЕТ, ДВАДЦАТЬ ШЕСТОЙ,
Dialogue: 0,0:03:11.49,0:03:14.37,Caption,,0,0,0,,ПОТОМ МОЖНО ТРИСТА ДВАДЦАТЬ ПЯТЫЙ СДЕЛАТЬ. НОМЕР
Dialogue: 0,0:03:14.37,0:03:16.77,Caption,,0,0,0,,ПАКЕТА САМ ПО СЕБЕ ДАВНО НИЧЕГО НЕ ОБЪЯСНЯЕТ.
Dialogue: 0,0:03:17.09,0:03:20.05,Caption,,0,0,0,,ВОТ ОБЪЯВИЛИ ОЧЕРЕДНОЙ НАБОР ОГРАНИЧЕНИЙ. ХОРОШО.
Dialogue: 0,0:03:20.35,0:03:22.61,Caption,,0,0,0,,ЧТО КОНКРЕТНО ОН ДОЛЖЕН ПЕРЕКРЫТЬ ТАКОГО,
Dialogue: 0,0:03:22.85,0:03:25.25,Caption,,0,0,0,,ЧЕГО НЕ ПЕРЕКРЫЛИ ПРЕДЫДУЩИЕ? КАКОЙ ПОТОК?
Dialogue: 0,0:03:25.50,0:03:28.77,Caption,,0,0,0,,КАКОЙ СЕКТОР? КАКОЙ НОВЫЙ РЕЗУЛЬТАТ ДОЛЖЕН ПОЯВИТЬСЯ?
Dialogue: 0,0:03:29.09,0:03:31.65,Caption,,0,0,0,,ИЛИ МЫ ПЕРЕКРЫВАЕМ ДЕНЕЖНЫЙ ПОТОК БАБЫ МАНИ ГДЕ
Dialogue: 0,0:03:31.73,0:03:34.21,Caption,,0,0,0,,НИБУДЬ ЧЁРТ ЗНАЕТ ГДЕ И ПОСЛЕ ЭТОГО ТОРЖЕСТВЕННО
Dialogue: 0,0:03:34.21,0:03:36.93,Caption,,0,0,0,,ОБЪЯВЛЯЕМ, ЧТО РОССИЯ НАКОНЕЦ ИЗОЛИРОВАНА?
Dialogue: 0,0:03:39.21,0:03:41.05,Caption,,0,0,0,,МОСКВА ТЕМ ВРЕМЕНЕМ ПРЯМО ГОВОРИТ,
Dialogue: 0,0:03:41.21,0:03:43.77,Caption,,0,0,0,,ЧТО НЕ ЖДЁТ ОТМЕНЫ САНКЦИЙ ЕЩЁ ШЕСТЬ ЛЕТ.
Dialogue: 0,0:03:44.17,0:03:46.73,Caption,,0,0,0,,ЭТО ВООБЩЕ ВАЖНАЯ ПСИХОЛОГИЧЕСКАЯ ТОЧКА. ОДНА
Dialogue: 0,0:03:46.73,0:03:49.05,Caption,,0,0,0,,СТОРОНА ПРОДОЛЖАЕТ ПРИДУМЫВАТЬ ОГРАНИЧЕНИЯ,
Dialogue: 0,0:03:49.37,0:03:51.77,Caption,,0,0,0,,А ДРУГАЯ УЖЕ СТРОИТ ПЛАНЫ ИСХОДЯ ИЗ ТОГО,
Dialogue: 0,0:03:51.93,0:03:54.81,Caption,,0,0,0,,ЧТО ЭТИ ОГРАНИЧЕНИЯ НИКУДА НЕ ДЕНУТСЯ. ТО ЕСТЬ
Dialogue: 0,0:03:54.81,0:03:57.29,Caption,,0,0,0,,САНКЦИИ ПЕРЕСТАЮТ БЫТЬ ВРЕМЕННЫМ НАКАЗАНИЕМ,
Dialogue: 0,0:03:57.52,0:03:59.85,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО ЧЕЛОВЕК ДОЛЖЕН ОДУМАТЬСЯ И ПРИЙТИ
Dialogue: 0,0:03:59.93,0:04:02.97,Caption,,0,0,0,,ПРОСИТЬ ПРОЩЕНИЯ. ОНИ ПРЕВРАЩАЮТСЯ ПРОСТО В УСЛОВИЯ
Dialogue: 0,0:04:02.97,0:04:06.09,Caption,,0,0,0,,ЖИЗНИ. А ЕСЛИ ПРОТИВНИК УЖЕ СТРОИТ ЭКОНОМИКУ С
Dialogue: 0,0:04:06.09,0:04:08.25,Caption,,0,0,0,,РАСЧЁТОМ НА ДОЛГИЕ ГОДЫ ОГРАНИЧЕНИЙ,
Dialogue: 0,0:04:08.57,0:04:10.97,Caption,,0,0,0,,КАЖДЫЙ СЛЕДУЮЩИЙ ПАКЕТ ДОЛЖЕН ПРИНОСИТЬ ЧТО ТО
Dialogue: 0,0:04:10.97,0:04:13.53,Caption,,0,0,0,,ПРИНЦИПИАЛЬНО НОВОЕ. ИНАЧЕ ЭТО СТАНОВИТСЯ
Dialogue: 0,0:04:13.53,0:04:18.01,Caption,,0,0,0,,КОЛЛЕКЦИОНИРОВАНИЕМ НОМЕРОВ. НО ТУТ ЕСТЬ ЕЩЁ БОЛЕЕ ВЕСЁЛАЯ ИСТОРИЯ. ПОКА
Dialogue: 0,0:04:18.09,0:04:21.77,Caption,,0,0,0,,ЕВРОПА РАССКАЗЫВАЕТ, КАК ОНА ИЗБАВЛЯЕТСЯ ОТ РОССИЙСКИХ ЭНЕРГОРЕСУРСОВ,
Dialogue: 0,0:04:22.18,0:04:25.21,Caption,,0,0,0,,ЕВРОПА ПРОДОЛЖАЕТ ПОКУПАТЬ РОССИЙСКИЙ СПГ. ЗА ПЕРВЫЕ
Dialogue: 0,0:04:25.21,0:04:27.77,Caption,,0,0,0,,ДЕСЯТЬ МЕСЯЦЕВ ЭТОГО ГОДА ЕВРОПЕЙСКИЕ ПОКУПАТЕЛИ
Dialogue: 0,0:04:27.77,0:04:30.65,Caption,,0,0,0,,ПОТРАТИЛИ НА НЕГО ОКОЛО ВОСЬМИ ЦЕЛЫХ СЕМИ ДЕСЯТЫХ
Dialogue: 0,0:04:30.65,0:04:33.85,Caption,,0,0,0,,МИЛЛИАРДА ЕВРО. ЭТО НА ДВАДЦАТЬ ОДИН ПРОЦЕНТ БОЛЬШЕ,
Dialogue: 0,0:04:34.09,0:04:38.73,Caption,,0,0,0,,ЧЕМ ЗА ВЕСЬ ПРЕДЫДУЩИЙ ГОД. ВОТ ТУТ Я УЖЕ ВООБЩЕ ТЕРЯЮСЬ. ВЫ ХОТИТЕ
Dialogue: 0,0:04:38.73,0:04:41.61,Caption,,0,0,0,,ПЕРЕКРЫТЬ РОССИИ ДЕНЕЖНЫЕ ПОТОКИ. ХОРОШО. И
Dialogue: 0,0:04:41.61,0:04:44.01,Caption,,0,0,0,,ОДНОВРЕМЕННО САМИ ПЕРЕЧИСЛЯЕТЕ МИЛЛИАРДЫ ЗА
Dialogue: 0,0:04:44.01,0:04:46.65,Caption,,0,0,0,,РОССИЙСКИЙ ГАЗ. ТАК ВЫ ОПРЕДЕЛИТЕСЬ. КРАН
Dialogue: 0,0:04:46.65,0:04:48.57,Caption,,0,0,0,,ПЕРЕКРЫВАЕМ ИЛИ СЧЁТ ОПЛАЧИВАЕМ?
Dialogue: 0,0:04:48.88,0:04:50.73,Caption,,0,0,0,,ОСОБЕННО КРАСИВО ВЫГЛЯДИТ ОКТЯБРЬ.
Dialogue: 0,0:04:52.93,0:04:56.37,Caption,,0,0,0,,ФИЗИЧЕСКИ ГАЗА КУПИЛИ МЕНЬШЕ. ПОСТАВКИ СНИЗИЛИСЬ. А
Dialogue: 0,0:04:56.37,0:05:00.13,Caption,,0,0,0,,ДЕНЕГ ЗАПЛАТИЛИ БОЛЬШЕ, ПОТОМУ ЧТО ЦЕНА ВЫРОСЛА. ТО ЕСТЬ ДАЖЕ КОГДА
Dialogue: 0,0:05:00.13,0:05:05.17,Caption,,0,0,0,,ТАНКЕРОВ ПРИХОДИТ МЕНЬШЕ, КАССА РАБОТАЕТ ПРЕКРАСНО. ФРАНЦИЯ ПОКУПАЕТ. БЕЛЬГИЯ
Dialogue: 0,0:05:05.17,0:05:08.85,Caption,,0,0,0,,ПОКУПАЕТ. ИСПАНИЯ ПОКУПАЕТ. НИДЕРЛАНДЫ ПОКУПАЮТ.
Dialogue: 0,0:05:09.08,0:05:11.97,Caption,,0,0,0,,ПОРТУГАЛИЯ ПОКУПАЕТ. И ГДЕ ТО РЯДОМ НАВЕРНЯКА УЖЕ
Dialogue: 0,0:05:11.97,0:05:14.77,Caption,,0,0,0,,ПЕЧАТАЮТ СЛЕДУЮЩИЙ ПАКЕТ САНКЦИЙ. ЕСЛИ ДО СИХ ПОР
Dialogue: 0,0:05:14.77,0:05:18.13,Caption,,0,0,0,,НЕ ПОДПИСАЛИСЬ, САМОЕ ВРЕМЯ ЭТО СДЕЛАТЬ. ПОТОМУ ЧТО ДАЛЬШЕ
Dialogue: 0,0:05:18.13,0:05:21.41,Caption,,0,0,0,,НАЧИНАЕТСЯ СОВСЕМ ХОРОШАЯ АРИФМЕТИКА. ТУРЦИЯ ГОВОРИТ
Dialogue: 0,0:05:21.49,0:05:23.17,Caption,,0,0,0,,РОССИИ ПРИМЕРНО СЛЕДУЮЩЕЕ РЕБЯТА,
Dialogue: 0,0:05:23.32,0:05:26.29,Caption,,0,0,0,,ГАЗ ДОРОГОВАТ. ЕСЛИ ЦЕНА ОСТАНЕТСЯ ТАКОЙ,
Dialogue: 0,0:05:26.37,0:05:29.57,Caption,,0,0,0,,БУДЕМ ИСКАТЬ ДРУГОЙ. НИКАКОЙ ВЕЛИКОЙ ГЕОПОЛИТИЧЕСКОЙ
Dialogue: 0,0:05:29.57,0:05:32.69,Caption,,0,0,0,,МИСТИКИ ЗДЕСЬ НЕТ. ПОКУПАТЕЛЬ ТОРГУЕТСЯ С ПРОДАВЦОМ.
Dialogue: 0,0:05:33.01,0:05:35.89,Caption,,0,0,0,,ВЕНГРИЯ ТОЖЕ СМОТРИТ В СТОРОНУ АЛЬТЕРНАТИВ. ЧАСТЬ
Dialogue: 0,0:05:35.89,0:05:38.37,Caption,,0,0,0,,РОССИЙСКОГО ГАЗА РАССЧИТЫВАЮТ ЗАМЕНИТЬ РУМЫНСКИМ.
Dialogue: 0,0:05:38.52,0:05:40.77,Caption,,0,0,0,,ПРИЧЁМ БУДАПЕШТ УЖЕ ГОВОРИТ О ДИВЕРСИФИКАЦИИ
Dialogue: 0,0:05:40.85,0:05:43.89,Caption,,0,0,0,,ПОСТАВОК И ДРУГИХ МАРШРУТАХ. ПЕТЕР МАДЬЯР ВООБЩЕ
Dialogue: 0,0:05:43.89,0:05:46.77,Caption,,0,0,0,,ЗАЯВЛЯЕТ, ЧТО РОССИЙСКИЙ ГАЗ НЕ ТАКОЙ ДЕШЁВЫЙ,
Dialogue: 0,0:05:46.93,0:05:49.57,Caption,,0,0,0,,КАК РАССКАЗЫВАЛО ПРЕЖНЕЕ ПРАВИТЕЛЬСТВО. ОТЛИЧНО.
Dialogue: 0,0:05:49.89,0:05:51.41,Caption,,0,0,0,,ТОЛЬКО ЧЕРЕЗ МИНУТУ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:05:51.72,0:05:54.61,Caption,,0,0,0,,ЧТО АЛЬТЕРНАТИВНЫЙ СПГ ТОЖЕ ДОРОГОЙ. ТО ЕСТЬ ВЫБОР
Dialogue: 0,0:05:54.61,0:05:57.41,Caption,,0,0,0,,ПРИБЛИЗИТЕЛЬНО ТАКОЙ ЭТОТ ГАЗ ВАМ КАЖЕТСЯ ДОРОГИМ,
Dialogue: 0,0:05:57.71,0:06:00.45,Caption,,0,0,0,,А ДРУГОЙ ТОЖЕ ДОРОГОЙ. ТЕПЕРЬ ОСТАЛОСЬ НАЙТИ ТОТ
Dialogue: 0,0:06:00.45,0:06:05.01,Caption,,0,0,0,,САМЫЙ ВОЛШЕБНЫЙ ДЕШЁВЫЙ ГАЗ, КОТОРЫЙ НИКТО БОЛЬШЕ НЕ ХОЧЕТ КУПИТЬ РАНЬШЕ ВАС.
Dialogue: 0,0:06:07.19,0:06:10.47,Caption,,0,0,0,,ВОТ ЭТО УЖЕ НОРМАЛЬНЫЙ РЫНОК. БЕЗ ЛОЗУНГОВ. ЕСТЬ
Dialogue: 0,0:06:10.47,0:06:13.19,Caption,,0,0,0,,ЦЕНА, МАРШРУТ, КОНТРАКТ И ВОПРОС,
Dialogue: 0,0:06:13.43,0:06:16.15,Caption,,0,0,0,,КТО ЗА ВСЁ ЗАПЛАТИТ. МОЛДОВА ПОШЛА ДАЛЬШЕ И
Dialogue: 0,0:06:16.15,0:06:19.35,Caption,,0,0,0,,ОБЪЯВИЛА, ЧТО РОССИЙСКИЙ ГАЗ БОЛЬШЕ ВООБЩЕ НЕ ПОКУПАЕТ.
Dialogue: 0,0:06:19.67,0:06:22.15,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО СТРОЯТСЯ ЭНЕРГЕТИЧЕСКИЕ СОЕДИНЕНИЯ С
Dialogue: 0,0:06:22.15,0:06:25.11,Caption,,0,0,0,,РУМЫНИЕЙ, РАБОТАЕТ НОВАЯ ЛИНИЯ ВУЛКАНЕШТЫ,
Dialogue: 0,0:06:25.27,0:06:28.63,Caption,,0,0,0,,КИШИНЁВ, ГОТОВЯТСЯ ЕЩЁ ЛИНИИ. ТО ЕСТЬ ЗАВИСИМОСТЬ
Dialogue: 0,0:06:28.63,0:06:31.11,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПЕРЕСТРАИВАЕТСЯ ФИЗИЧЕСКИ. НЕ НА
Dialogue: 0,0:06:31.11,0:06:35.99,Caption,,0,0,0,,БУМАГЕ. ПРОВОДА ТЯНУТ, ИНФРАСТРУКТУРУ МЕНЯЮТ. НО ЕСТЬ МАЛЕНЬКАЯ БЫТОВАЯ
Dialogue: 0,0:06:36.07,0:06:39.19,Caption,,0,0,0,,ДЕТАЛЬ, КОТОРАЯ ВСЕГДА ПРИХОДИТ ПОСЛЕ БОЛЬШИХ ПОЛИТИЧЕСКИХ
Dialogue: 0,0:06:39.19,0:06:42.47,Caption,,0,0,0,,РЕЧЕЙ. НОВЫЕ ПОСТАВКИ ДЛЯ ПОТРЕБИТЕЛЯ ДОРОЖЕ. ВОТ И
Dialogue: 0,0:06:42.55,0:06:45.83,Caption,,0,0,0,,ВСЯ МАГИЯ. МОЖНО ПОМЕНЯТЬ ПОСТАВЩИКА. МОЖНО ПОМЕНЯТЬ
Dialogue: 0,0:06:45.83,0:06:49.19,Caption,,0,0,0,,МАРШРУТ. МОЖНО ПОЛИТИЧЕСКИ ОБЪЯВИТЬ ПОБЕДУ. НО СЧЁТ
Dialogue: 0,0:06:49.27,0:06:51.83,Caption,,0,0,0,,ЗА ЭЛЕКТРИЧЕСТВО ВСЁ РАВНО ПРИХОДИТ В ПОЧТОВЫЙ ЯЩИК.
Dialogue: 0,0:06:52.13,0:06:55.03,Caption,,0,0,0,,И ЗДЕСЬ ВСЯ ЭНЕРГЕТИЧЕСКАЯ ИСТОРИЯ ЕВРОПЫ СТАНОВИТСЯ
Dialogue: 0,0:06:55.03,0:06:58.23,Caption,,0,0,0,,ОЧЕНЬ ПРОСТОЙ. ОТ РОССИЙСКОГО ГАЗА ХОТЯТ ОТКАЗАТЬСЯ.
Dialogue: 0,0:06:58.40,0:07:03.67,Caption,,0,0,0,,ХОРОШО. НО ПОКА ОТКАЗЫВАЮТСЯ, РОССИЙСКИЙ СПГ ПРОДОЛЖАЮТ ПОКУПАТЬ. ОДНИ ИЩУТ
Dialogue: 0,0:07:03.67,0:07:07.19,Caption,,0,0,0,,РУМЫНСКИЙ ГАЗ. ДРУГИЕ АМЕРИКАНСКИЙ. ТРЕТЬИ СТРОЯТ
Dialogue: 0,0:07:07.19,0:07:10.23,Caption,,0,0,0,,НОВЫЕ ЛИНИИ. ЧЕТВЁРТЫЕ ЖДУТ ЗАПРЕТА И ДО ЕГО
Dialogue: 0,0:07:10.23,0:07:12.79,Caption,,0,0,0,,ВСТУПЛЕНИЯ ПРОДОЛЖАЮТ ГРУЗИТЬ РОССИЙСКИЙ ГАЗ ПО
Dialogue: 0,0:07:12.79,0:07:15.59,Caption,,0,0,0,,СУЩЕСТВУЮЩИМ КОНТРАКТАМ. ПОЭТОМУ ФРАЗА "МЫ
Dialogue: 0,0:07:15.59,0:07:18.23,Caption,,0,0,0,,ОТКАЗАЛИСЬ" В ЭНЕРГЕТИКЕ ВООБЩЕ НИЧЕГО НЕ СТОИТ,
Dialogue: 0,0:07:18.55,0:07:21.83,Caption,,0,0,0,,ПОКА НЕ ПОСМОТРЕЛ НА ТАНКЕР, ТРУБУ И БАНКОВСКИЙ ПЕРЕВОД.
Dialogue: 0,0:07:24.12,0:07:27.24,Caption,,0,0,0,,МОЛЕКУЛА ГАЗА ПАСПОРТ НА ГРАНИЦЕ НЕ ПОКАЗЫВАЕТ. И
Dialogue: 0,0:07:27.32,0:07:29.56,Caption,,0,0,0,,ВОТ НА ЭТОМ ФОНЕ РОССИЙСКИЕ АКТИВЫ СТАНОВЯТСЯ
Dialogue: 0,0:07:29.56,0:07:32.12,Caption,,0,0,0,,ОСОБЕННО ИНТЕРЕСНЫМИ. ПОТОМУ ЧТО ЭТО УЖЕ НЕ
Dialogue: 0,0:07:32.12,0:07:34.76,Caption,,0,0,0,,ОЧЕРЕДНОЙ МЕЛКИЙ ВИНТИК. ЭТО БОЛЬШАЯ,
Dialogue: 0,0:07:34.93,0:07:39.24,Caption,,0,0,0,,ВИДИМАЯ СУММА, ДО КОТОРОЙ МОЖНО ФИЗИЧЕСКИ ДОТЯНУТЬСЯ. ВОТ ДЕНЬГИ.
Dialogue: 0,0:07:39.54,0:07:42.36,Caption,,0,0,0,,ОНИ УЖЕ ЗДЕСЬ. НЕ НАДО ПРИДУМЫВАТЬ НОВЫЙ НАЛОГ.
Dialogue: 0,0:07:42.54,0:07:45.24,Caption,,0,0,0,,НЕ НАДО ЖДАТЬ ЕЩЁ ОДИН САНКЦИОННЫЙ ЭФФЕКТ. НЕ
Dialogue: 0,0:07:45.24,0:07:47.64,Caption,,0,0,0,,НАДО УБЕЖДАТЬ ИЗБИРАТЕЛЯ ЗАНЯТЬ ЕЩЁ СОРОК
Dialogue: 0,0:07:47.72,0:07:51.24,Caption,,0,0,0,,МИЛЛИАРДОВ. БЕРИ И ИСПОЛЬЗУЙ. ПОЭТОМУ К ЭТОЙ ТЕМЕ
Dialogue: 0,0:07:51.24,0:07:53.72,Caption,,0,0,0,,ЕВРОПА И ВОЗВРАЩАЕТСЯ СНОВА. НЕ ПОТОМУ,
Dialogue: 0,0:07:53.96,0:07:56.60,Caption,,0,0,0,,ЧТО НИКТО НЕ ПОНИМАЕТ ПОСЛЕДСТВИЙ. КАК РАЗ ПОНИМАЮТ
Dialogue: 0,0:07:56.60,0:07:59.56,Caption,,0,0,0,,ПРЕКРАСНО. EUROCLEAR РАССКАЗЫВАЕТ О ПОСЛЕДСТВИЯХ
Dialogue: 0,0:07:59.64,0:08:02.60,Caption,,0,0,0,,ВСЛУХ. И ЕСЛИ ЕВРОПА СОБИРАЕТСЯ ДАЛЬШЕ ФИНАНСИРОВАТЬ
Dialogue: 0,0:08:02.68,0:08:06.76,Caption,,0,0,0,,УКРАИНУ И ДАВИТЬ НА РОССИЮ, А ПРЕЖНИЕ ЭКОНОМИЧЕСКИЕ РЫЧАГИ ДАЮТ ВСЁ МЕНЬШЕ
Dialogue: 0,0:08:06.84,0:08:10.68,Caption,,0,0,0,,РЕЗУЛЬТАТА, РОССИЙСКИЕ АКТИВЫ В ИТОГЕ КОНФИСКУЮТ. ПОСЛЕДСТВИЯ
Dialogue: 0,0:08:10.68,0:08:13.80,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЮТ. ТОЛЬКО ДРУГОГО СТОЛЬ ЗАМЕТНОГО
Dialogue: 0,0:08:13.80,0:08:17.00,Caption,,0,0,0,,ФИНАНСОВОГО РЫЧАГА У ЕВРОПЫ УЖЕ НЕ ОСТАЁТСЯ. ТОЛЬКО
Dialogue: 0,0:08:17.08,0:08:20.84,Caption,,0,0,0,,НЕ НАДО ДУМАТЬ, ЧТО ОТ ИХ КОНФИСКАЦИИ РОССИЯ ВНЕЗАПНО СОДРОГНЁТСЯ И
Dialogue: 0,0:08:20.92,0:08:23.40,Caption,,0,0,0,,НА СЛЕДУЮЩИЙ ДЕНЬ ВСЁ ЗАКОНЧИТСЯ. ЭТО БОЛЕЗНЕННАЯ
Dialogue: 0,0:08:23.48,0:08:26.84,Caption,,0,0,0,,ТОЧКА. БОЛЬШАЯ СУММА. ПОЛИТИЧЕСКИ ОЧЕНЬ ЗАМЕТНЫЙ
Dialogue: 0,0:08:26.84,0:08:29.96,Caption,,0,0,0,,ШАГ. НО ЭТО НЕ КНОПКА "ВЫКЛЮЧИТЬ ПРОТИВНИКА". МОСКВА
Dialogue: 0,0:08:30.04,0:08:33.72,Caption,,0,0,0,,УЖЕ ЗАЯВЛЯЕТ, ЧТО ДОПОЛНИТЕЛЬНЫЕ ОТВЕТНЫЕ МЕРЫ НА СЛУЧАЙ ИЗЪЯТИЯ
Dialogue: 0,0:08:33.72,0:08:38.07,Caption,,0,0,0,,АКТИВОВ ПОДГОТОВЛЕНЫ. КАКИЕ ИМЕННО,
Dialogue: 0,0:08:38.31,0:08:41.03,Caption,,0,0,0,,НЕ РАССКАЗЫВАЕТ. И ВОТ ТУТ НАЧИНАЕТСЯ СЛЕДУЮЩАЯ
Dialogue: 0,0:08:41.03,0:08:44.15,Caption,,0,0,0,,СЕРИЯ. ПОТОМУ ЧТО ЕСЛИ ЕВРОПА ЗАБИРАЕТ РОССИЙСКИЕ
Dialogue: 0,0:08:44.15,0:08:47.03,Caption,,0,0,0,,АКТИВЫ, РОССИЯ ИЩЕТ, ЧТО МОЖНО ЗАБРАТЬ,
Dialogue: 0,0:08:47.19,0:08:51.11,Caption,,0,0,0,,ОГРАНИЧИТЬ, ЗАБЛОКИРОВАТЬ ИЛИ ПРЕДЪЯВИТЬ В ОТВЕТ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:08:51.11,0:08:52.95,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ ФИНАНСОВАЯ ДРАКА,
Dialogue: 0,0:08:53.19,0:08:57.03,Caption,,0,0,0,,ГДЕ КАЖДЫЙ СНАЧАЛА ОБЪЯСНЯЕТ, ЧТО ЗАЩИЩАЕТ ЗАКОН И СПРАВЕДЛИВОСТЬ,
Dialogue: 0,0:08:57.35,0:09:01.83,Caption,,0,0,0,,А ПОТОМ НАЧИНАЕТ СМОТРЕТЬ, ГДЕ У ВТОРОЙ СТОРОНЫ ЛЕЖИТ ИМУЩЕСТВО. ВСТРЕЧНЫЙ СЧЁТ
Dialogue: 0,0:09:01.91,0:09:06.23,Caption,,0,0,0,,ЕЩЁ НИКТО НЕ ВИДЕЛ, НО КАССОВЫЙ АППАРАТ УЖЕ ВКЛЮЧИЛИ. А ТЕПЕРЬ ГЕРМАНИЯ.
Dialogue: 0,0:09:06.71,0:09:08.71,Caption,,0,0,0,,И ЗДЕСЬ ИСТОРИЯ УЖЕ СОВСЕМ НЕ ПРО ДЕНЬГИ.
Dialogue: 0,0:09:09.03,0:09:11.99,Caption,,0,0,0,,БУНДЕСТАГ РАСШИРИЛ ПОЛНОМОЧИЯ НЕМЕЦКИХ СПЕЦСЛУЖБ.
Dialogue: 0,0:09:12.31,0:09:14.63,Caption,,0,0,0,,ФЕДЕРАЛЬНАЯ РАЗВЕДЫВАТЕЛЬНАЯ СЛУЖБА И ВЕДОМСТВО ПО
Dialogue: 0,0:09:14.71,0:09:17.03,Caption,,0,0,0,,ЗАЩИТЕ КОНСТИТУЦИИ ПОЛУЧАЮТ ЗНАЧИТЕЛЬНО БОЛЕЕ
Dialogue: 0,0:09:17.11,0:09:20.07,Caption,,0,0,0,,ДЛИННЫЕ РУКИ. ТРИСТА ВОСЕМЬ ДЕПУТАТОВ ПРОГОЛОСОВАЛИ
Dialogue: 0,0:09:20.15,0:09:23.19,Caption,,0,0,0,,ЗА РЕФОРМУ. СТО ДЕВЯНОСТО ПРОТИВ. СЕМЬДЕСЯТ ОДИН
Dialogue: 0,0:09:23.19,0:09:25.51,Caption,,0,0,0,,ВОЗДЕРЖАЛСЯ. И РЕЧЬ НЕ ТОЛЬКО О ТОМ,
Dialogue: 0,0:09:25.74,0:09:28.31,Caption,,0,0,0,,ЧТОБЫ СИДЕТЬ В КАБИНЕТЕ И ЧИТАТЬ ЧУЖУЮ ПЕРЕПИСКУ.
Dialogue: 0,0:09:28.63,0:09:31.27,Caption,,0,0,0,,НЕМЕЦКАЯ РАЗВЕДКА ПОЛУЧАЕТ ИНСТРУМЕНТЫ ДЛЯ АКТИВНЫХ
Dialogue: 0,0:09:31.35,0:09:34.15,Caption,,0,0,0,,ОПЕРАЦИЙ ЗА ГРАНИЦЕЙ. ВЫВОДИТЬ ИЗ СТРОЯ СЕРВЕРЫ.
Dialogue: 0,0:09:34.39,0:09:37.11,Caption,,0,0,0,,ПРОНИКАТЬ В КОМПЬЮТЕРНЫЕ СИСТЕМЫ. ВМЕШИВАТЬСЯ В
Dialogue: 0,0:09:37.11,0:09:40.95,Caption,,0,0,0,,РАБОТУ ПРЕДПРИЯТИЙ, СВЯЗАННЫХ С ПРОИЗВОДСТВОМ БЕСПИЛОТНИКОВ. ЛЕЗТЬ В
Dialogue: 0,0:09:40.95,0:09:43.75,Caption,,0,0,0,,ЦЕПОЧКИ ПОСТАВОК ВООРУЖЕНИЙ. ВЫВОДИТЬ ИЗ СТРОЯ
Dialogue: 0,0:09:43.75,0:09:46.55,Caption,,0,0,0,,ОТДЕЛЬНЫЕ СИСТЕМЫ. ВОТ ЭТО УЖЕ СОВЕРШЕННО ДРУГОЙ
Dialogue: 0,0:09:46.55,0:09:52.03,Caption,,0,0,0,,УРОВЕНЬ. И ЗДЕСЬ ВОЗНИКАЕТ ВОПРОС БЕЗ ВСЯКИХ КРУЖЕВ УГАДАЙТЕ,
Dialogue: 0,0:09:52.35,0:09:54.27,Caption,,0,0,0,,ПРОТИВ КОГО ВСЁ ЭТО БУДУТ ИСПОЛЬЗОВАТЬ?
Dialogue: 0,0:09:54.74,0:09:58.91,Caption,,0,0,0,,ОДИН ИЗ ВОЗМОЖНЫХ СЦЕНАРИЕВ, ЦИФРОВАЯ СФЕРА СТАНЕТ ОДНОЙ ИЗ ПЕРВЫХ ПЛОЩАДОК
Dialogue: 0,0:09:58.91,0:10:01.87,Caption,,0,0,0,,ЭСКАЛАЦИИ. НАЧАТЬСЯ ВСЁ МОЖЕТ С НЕБОЛЬШИХ ОПЕРАЦИЙ
Dialogue: 0,0:10:01.95,0:10:04.19,Caption,,0,0,0,,ПРОТИВ ВОЕННОЙ ИНФРАСТРУКТУРЫ. И ВЕДЬ ЗДЕСЬ
Dialogue: 0,0:10:04.19,0:10:06.91,Caption,,0,0,0,,ИНТЕРЕСЕН НЕ ТОЛЬКО РОССИЙСКИЙ СЮЖЕТ. В НЕМЕЦКОЙ
Dialogue: 0,0:10:06.91,0:10:11.15,Caption,,0,0,0,,РЕФОРМЕ ЕСТЬ ЕЩЁ ОДИН СЛОЙ, КОТОРЫЙ ВООБЩЕ НЕЛЬЗЯ ПОТЕРЯТЬ. РАСШИРЯЮТСЯ
Dialogue: 0,0:10:11.15,0:10:13.87,Caption,,0,0,0,,ВОЗМОЖНОСТИ РАБОТЫ ВНУТРИ САМОЙ ГЕРМАНИИ. В
Dialogue: 0,0:10:13.95,0:10:16.43,Caption,,0,0,0,,ОТДЕЛЬНЫХ СЛУЧАЯХ СОТРУДНИКИ ПОЛУЧАТ ПРАВО ПРОНИКАТЬ
Dialogue: 0,0:10:16.51,0:10:18.59,Caption,,0,0,0,,В ПОМЕЩЕНИЯ ДЛЯ ВМЕШАТЕЛЬСТВА В ТЕХНИЧЕСКИЕ
Dialogue: 0,0:10:18.67,0:10:21.47,Caption,,0,0,0,,УСТРОЙСТВА. ЛЕВЫЕ УЖЕ ЗАГОВОРИЛИ ОБ ОПАСНОСТИ
Dialogue: 0,0:10:21.47,0:10:24.83,Caption,,0,0,0,,ЧРЕЗМЕРНОГО УСИЛЕНИЯ ТАЙНЫХ СЛУЖБ. "ЗЕЛЁНЫЕ" СПОРЯТ
Dialogue: 0,0:10:24.91,0:10:27.31,Caption,,0,0,0,,ИЗ ЗА ВОЗМОЖНОСТИ ПРИВЛЕКАТЬ НЕСОВЕРШЕННОЛЕТНИХ К
Dialogue: 0,0:10:27.31,0:10:30.27,Caption,,0,0,0,,СОТРУДНИЧЕСТВУ. А ЕЩЁ ЗАКОН ПОЗВОЛЯЕТ ОГРАНИЧИВАТЬ
Dialogue: 0,0:10:30.27,0:10:32.75,Caption,,0,0,0,,ПЕРЕДАЧУ РАЗВЕДДАННЫХ МЕЖДУ ФЕДЕРАЛЬНЫМ ЦЕНТРОМ И
Dialogue: 0,0:10:32.75,0:10:36.75,Caption,,0,0,0,,ЗЕМЛЯМИ, ЕСЛИ ВОЗНИКАЕТ РИСК УТЕЧКИ СЕКРЕТНОЙ ИНФОРМАЦИИ. И
Dialogue: 0,0:10:36.75,0:10:39.79,Caption,,0,0,0,,ТУТ СРАЗУ ПОЯВЛЯЕТСЯ АДГ. ТО ЕСТЬ РЕФОРМА,
Dialogue: 0,0:10:39.95,0:10:42.03,Caption,,0,0,0,,КОТОРУЮ ОБЪЯСНЯЮТ ВНЕШНЕЙ УГРОЗОЙ,
Dialogue: 0,0:10:42.19,0:10:44.59,Caption,,0,0,0,,ОДНОВРЕМЕННО КАСАЕТСЯ ВНУТРЕННЕЙ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:10:44.59,0:10:47.63,Caption,,0,0,0,,БОРЬБЫ. ОЧЕНЬ УДОБНО ПОЛУЧАЕТСЯ. СНАРУЖИ У НАС
Dialogue: 0,0:10:47.63,0:10:50.35,Caption,,0,0,0,,ИНОСТРАННЫЙ ПРОТИВНИК. ВНУТРИ У НАС НЕУДОБНАЯ
Dialogue: 0,0:10:50.35,0:10:53.31,Caption,,0,0,0,,ПАРТИЯ. А ПОСРЕДИНЕ СПЕЦСЛУЖБЫ С РАСШИРЕННЫМИ
Dialogue: 0,0:10:53.31,0:10:56.11,Caption,,0,0,0,,ПОЛНОМОЧИЯМИ. ПРИЧЁМ ГЕРМАНИЯ ЗДЕСЬ НЕ ИЗОБРЕЛА
Dialogue: 0,0:10:56.11,0:11:01.74,Caption,,0,0,0,,РАЗВЕДКУ ВЧЕРА УТРОМ. СПЕЦСЛУЖБЫ ВООБЩЕ ЖИВУТ ЗНАЧИТЕЛЬНО ДОЛЬШЕ
Dialogue: 0,0:11:01.74,0:11:05.10,Caption,,0,0,0,,КОНКРЕТНЫХ ПРАВИТЕЛЬСТВ. МЕНЯЮТСЯ КАНЦЛЕРЫ. МЕНЯЮТСЯ
Dialogue: 0,0:11:05.10,0:11:08.22,Caption,,0,0,0,,МИНИСТРЫ. МЕНЯЮТСЯ ПАРТИИ. А АГЕНТУРА,
Dialogue: 0,0:11:08.31,0:11:13.10,Caption,,0,0,0,,СВЯЗИ, БАЗЫ ДАННЫХ, ТЕХНИЧЕСКИЕ ВОЗМОЖНОСТИ И НАКОПЛЕННАЯ ИНФРАСТРУКТУРА
Dialogue: 0,0:11:13.10,0:11:16.22,Caption,,0,0,0,,ОСТАЮТСЯ. ПОЭТОМУ СМОТРЕТЬ НАДО НЕ ТОЛЬКО НА ТО,
Dialogue: 0,0:11:16.37,0:11:19.26,Caption,,0,0,0,,ЧТО СЕГОДНЯ ГОВОРИТ ПОЛИТИК У МИКРОФОНА. СМОТРЕТЬ
Dialogue: 0,0:11:19.34,0:11:22.30,Caption,,0,0,0,,НАДО, КАКИЕ ИНСТРУМЕНТЫ ГОСУДАРСТВО СОЗДАЁТ У СЕБЯ В
Dialogue: 0,0:11:22.30,0:11:26.06,Caption,,0,0,0,,РУКАХ. ДЕНЬГИ МОЖНО ЗАМОРОЗИТЬ. ГАЗ МОЖНО ЗАМЕНИТЬ.
Dialogue: 0,0:11:26.30,0:11:29.66,Caption,,0,0,0,,САНКЦИИ МОЖНО ДОПЕЧАТАТЬ. А ПОЛНОМОЧИЯ СПЕЦСЛУЖБЫ,
Dialogue: 0,0:11:29.82,0:11:33.90,Caption,,0,0,0,,ОДНАЖДЫ РАСШИРЕННЫЕ, ОБРАТНО В КОРОБКУ ОБЫЧНО ЗАПИХИВАЮТСЯ ЗНАЧИТЕЛЬНО
Dialogue: 0,0:11:33.90,0:11:36.70,Caption,,0,0,0,,ТЯЖЕЛЕЕ. И ВОТ ЕСЛИ СОБРАТЬ ВСЁ ВМЕСТЕ,
Dialogue: 0,0:11:36.95,0:11:39.82,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ ИНТЕРЕСНАЯ КАРТИНА. ЕВРОПА
Dialogue: 0,0:11:39.82,0:11:43.50,Caption,,0,0,0,,ПРОДОЛЖАЕТ ИСКАТЬ РЫЧАГИ. САНКЦИОННЫЕ. ФИНАНСОВЫЕ.
Dialogue: 0,0:11:43.66,0:11:46.94,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИЕ. РАЗВЕДЫВАТЕЛЬНЫЕ. ТОЛЬКО КАЖДЫЙ
Dialogue: 0,0:11:46.94,0:11:49.98,Caption,,0,0,0,,НОВЫЙ РЫЧАГ СТАНОВИТСЯ ВСЁ ДОРОЖЕ. ОТКАЗЫВАЕШЬСЯ ОТ
Dialogue: 0,0:11:50.06,0:11:53.50,Caption,,0,0,0,,ОДНОГО ГАЗА, ПОКУПАЕШЬ ДРУГОЙ ДОРОЖЕ. ДАВИШЬ САНКЦИЯМИ,
Dialogue: 0,0:11:53.74,0:11:55.58,Caption,,0,0,0,,НО ПРОДОЛЖАЕШЬ ПЛАТИТЬ МИЛЛИАРДЫ ЗА СПГ.
Dialogue: 0,0:11:56.24,0:11:58.06,Caption,,0,0,0,,ХОЧЕШЬ ЗАБРАТЬ РОССИЙСКИЕ АКТИВЫ,
Dialogue: 0,0:11:58.22,0:12:00.46,Caption,,0,0,0,,СОБСТВЕННЫЙ КРУПНЕЙШИЙ ДЕПОЗИТАРИЙ НАЧИНАЕТ
Dialogue: 0,0:12:00.46,0:12:03.10,Caption,,0,0,0,,ПРЕДУПРЕЖДАТЬ О ДОВЕРИИ ИНВЕСТОРОВ. РАСШИРЯЕШЬ
Dialogue: 0,0:12:03.18,0:12:05.42,Caption,,0,0,0,,ПОЛНОМОЧИЯ СПЕЦСЛУЖБ ПРОТИВ ВНЕШНЕЙ УГРОЗЫ,
Dialogue: 0,0:12:05.74,0:12:10.86,Caption,,0,0,0,,СРАЗУ ПОЛУЧАЕШЬ СПОР О ТОМ, КАК ЭТИ ПОЛНОМОЧИЯ БУДУТ РАБОТАТЬ ВНУТРИ СТРАНЫ. ВОТ
Dialogue: 0,0:12:10.94,0:12:16.82,Caption,,0,0,0,,ГДЕ НАСТОЯЩИЙ ВОПРОС. ХВАТИТ ЛИ У ЕВРОПЫ ФАНТАЗИИ ПРИДУМАТЬ СЛЕДУЮЩИЙ
Dialogue: 0,0:12:16.82,0:12:21.38,Caption,,0,0,0,,ИНСТРУМЕНТ ДАВЛЕНИЯ? ХВАТИТ. ЗДЕСЬ ФАНТАЗИЯ БОГАТАЯ. ВОПРОС В ДРУГОМ.
Dialogue: 0,0:12:21.62,0:12:24.50,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ТАКИХ ИНСТРУМЕНТОВ МОЖНО ИСПОЛЬЗОВАТЬ,
Dialogue: 0,0:12:24.74,0:12:27.54,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ЦЕНА КАЖДОГО СЛЕДУЮЩЕГО ШАГА НАЧНЁТ ВСЁ
Dialogue: 0,0:12:27.62,0:12:29.78,Caption,,0,0,0,,СИЛЬНЕЕ ПРИЛЕТАТЬ УЖЕ ПО САМОЙ ЕВРОПЕ?
Dialogue: 0,0:12:30.11,0:12:32.34,Caption,,0,0,0,,ПОТОМУ ЧТО РОССИЙСКИЕ ДЕНЬГИ ДЕЙСТВИТЕЛЬНО ЛЕЖАТ
Dialogue: 0,0:12:32.34,0:12:34.34,Caption,,0,0,0,,РЯДОМ. РУКА УЖЕ НЕ ПЕРВЫЙ РАЗ К НИМ
Dialogue: 0,0:12:34.34,0:12:37.22,Caption,,0,0,0,,ТЯНЕТСЯ. ТОЛЬКО ПОСЛЕ ТОГО КАК КАССУ ОТКРОЮТ,
Dialogue: 0,0:12:37.54,0:12:39.86,Caption,,0,0,0,,ЗАКРЫТЬ ЭТУ ИСТОРИЮ ОБРАТНО УЖЕ НЕ ПОЛУЧИТСЯ.
