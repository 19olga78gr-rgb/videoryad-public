Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,ЕСТЬ У МИРНЫХ ПЕРЕГОВОРОВ ОДНА ЛЮБОПЫТНАЯ ЧЕРТА.
Dialogue: 0,0:00:03.22,0:00:05.88,Caption,,0,0,0,,НЕУДАЧНЫХ СРЕДИ НИХ НЕ БЫВАЕТ. ЛЮБАЯ ВСТРЕЧА
Dialogue: 0,0:00:05.88,0:00:09.16,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ ХОРОШО, УЧАСТНИКИ ВЫХОДЯТ ДОВОЛЬНЫЕ,
Dialogue: 0,0:00:09.32,0:00:14.44,Caption,,0,0,0,,АТМОСФЕРА РАБОЧАЯ, СТОРОНЫ ГОТОВЫ ПРОДОЛЖАТЬ. КРАСОТА. ТОЛЬКО ВОЙНА ЗА
Dialogue: 0,0:00:14.52,0:00:16.36,Caption,,0,0,0,,ОКНОМ ПРО ЭТОТ УСПЕХ ПОКА НЕ СЛЫШАЛА.
Dialogue: 0,0:00:17.00,0:00:19.48,Caption,,0,0,0,,И ТУТ ХОЧЕТСЯ УТОЧНИТЬ А ЧТО ИМЕННО ОНИ
Dialogue: 0,0:00:19.48,0:00:21.88,Caption,,0,0,0,,КАЖДЫЙ РАЗ ЗАНОСЯТ СЕБЕ В ГРАФУ ДОСТИЖЕНИЙ?
Dialogue: 0,0:00:22.26,0:00:24.76,Caption,,0,0,0,,ЕСЛИ ВАМ БЛИЖЕ РАЗГОВОР НЕ ПО ПРЕСС РЕЛИЗАМ,
Dialogue: 0,0:00:24.94,0:00:29.08,Caption,,0,0,0,,А ПО СУТИ, ПОДПИШИТЕСЬ. ЗДЕСЬ СМОТРЯТ НЕ НА ФОРМУЛИРОВКИ ПОСЛЕ
Dialogue: 0,0:00:29.08,0:00:33.88,Caption,,0,0,0,,ВСТРЕЧИ, А НА ТО, ЧТО ПОСЛЕ НЕЁ РЕАЛЬНО ПОМЕНЯЛОСЬ. УИТКОФФ ПРИЕХАЛ К
Dialogue: 0,0:00:33.88,0:00:36.52,Caption,,0,0,0,,ПУТИНУ УЖЕ ДЕСЯТЫЙ РАЗ. С НИМ ОПЯТЬ КУШНЕР.
Dialogue: 0,0:00:37.00,0:00:39.80,Caption,,0,0,0,,ПЕРЕД МОСКВОЙ КОМАНДА ОТРАБОТАЛА В АБУ ДАБИ. ПОСЛЕ
Dialogue: 0,0:00:39.80,0:00:42.52,Caption,,0,0,0,,МОСКВЫ ИЗ ВАШИНГТОНА СНОВА ЗВУЧИТ ЗНАКОМЫЙ НАБОР
Dialogue: 0,0:00:42.60,0:00:44.92,Caption,,0,0,0,,РАЗГОВОР ПОЛЕЗНЫЙ, ПРОГРЕСС ЕСТЬ,
Dialogue: 0,0:00:45.00,0:00:48.12,Caption,,0,0,0,,СЛЕДУЮЩИЙ РАУНД ГОТОВИТСЯ. ЗВУЧИТ БОДРО. НО ЕСЛИ
Dialogue: 0,0:00:48.12,0:00:51.16,Caption,,0,0,0,,УБРАТЬ ИЗ КАДРА РУКОПОЖАТИЯ И СЛОВО "КОНСТРУКТИВНО",
Dialogue: 0,0:00:51.39,0:00:55.08,Caption,,0,0,0,,ОСТАЁТСЯ ВОПРОС КОРОЧЕ НЕКУДА. ЧТО ИЗМЕНИЛОСЬ ПО ТЕМ
Dialogue: 0,0:00:55.08,0:00:57.64,Caption,,0,0,0,,ПУНКТАМ, РАДИ КОТОРЫХ ВСЁ ЭТО И ЗАТЕВАЛОСЬ?
Dialogue: 0,0:00:57.85,0:01:00.52,Caption,,0,0,0,,ПЕРВЫМ ДЕЛОМ НАМ ПОКАЗЫВАЮТ ГУМАНИТАРНУЮ ЧАСТЬ.
Dialogue: 0,0:01:00.83,0:01:03.72,Caption,,0,0,0,,ОБМЕН ПЛЕННЫМИ. И ЗДЕСЬ БЕЗ УХМЫЛОК ДЛЯ ТЕХ,
Dialogue: 0,0:01:03.88,0:01:06.28,Caption,,0,0,0,,КТО ВЕРНЁТСЯ ДОМОЙ, ДЛЯ ИХ МАТЕРЕЙ,
Dialogue: 0,0:01:06.37,0:01:09.08,Caption,,0,0,0,,ЖЁН И ДЕТЕЙ ЭТО СОБЫТИЕ РАЗМЕРОМ В ЦЕЛУЮ
Dialogue: 0,0:01:09.08,0:01:11.64,Caption,,0,0,0,,ЖИЗНЬ. МЕЛОЧЕЙ В ТАКОМ ДЕЛЕ НЕ БЫВАЕТ. НО
Dialogue: 0,0:01:11.72,0:01:14.36,Caption,,0,0,0,,ЕСЛИ МЕРИТЬ ЕГО МАСШТАБОМ РАЗГОВОРА О ПРЕКРАЩЕНИИ
Dialogue: 0,0:01:14.36,0:01:16.68,Caption,,0,0,0,,ВОЙНЫ, УРОВЕНЬ ЗАДАЧИ СОВСЕМ ДРУГОЙ.
Dialogue: 0,0:01:18.96,0:01:21.44,Caption,,0,0,0,,ОБМЕНЫ ШЛИ И РАНЬШЕ. ПО НИМ ДОГОВАРИВАЛИСЬ ДАЖЕ
Dialogue: 0,0:01:21.52,0:01:25.04,Caption,,0,0,0,,В ТЕ МЕСЯЦЫ, КОГДА ПО ВСЕМУ ОСТАЛЬНОМУ СТОРОНЫ НЕ УСТУПАЛИ НИ
Dialogue: 0,0:01:25.04,0:01:28.48,Caption,,0,0,0,,САНТИМЕТРА. ДЛЯ ЭТОГО СУЩЕСТВУЮТ ОТДЕЛЬНЫЕ КАНАЛЫ,
Dialogue: 0,0:01:28.56,0:01:34.00,Caption,,0,0,0,,ОМБУДСМЕНЫ, УПОЛНОМОЧЕННЫЕ, РАБОЧИЕ ГРУППЫ. В ГУМАНИТАРНУЮ ТЕМУ УСПЕЛА ЗАЙТИ
Dialogue: 0,0:01:34.08,0:01:38.56,Caption,,0,0,0,,ДАЖЕ МЕЛАНИЯ ТРАМП. И ВОТ ТУТ НАЧИНАЕТСЯ НЕЛОВКОСТЬ. ЕСЛИ ПОСЛЕ ВСТРЕЧИ
Dialogue: 0,0:01:38.56,0:01:41.20,Caption,,0,0,0,,ТАКОГО КАЛИБРА ГЛАВНЫМ ПРЕДЪЯВЛЕННЫМ РЕЗУЛЬТАТОМ
Dialogue: 0,0:01:41.28,0:01:45.04,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ ОБМЕН, ВОЗНИКАЕТ РЕЗОННОЕ ДЛЯ ЧЕГО ТОГДА ГОНЯТЬ ЧЕРЕЗ
Dialogue: 0,0:01:45.04,0:01:49.60,Caption,,0,0,0,,ПОЛМИРА ЛЮДЕЙ ТАКОГО РАНГА? ЗАЧЕМ ДЕСЯТАЯ ПО СЧЁТУ ПОЕЗДКА К ПУТИНУ,
Dialogue: 0,0:01:49.83,0:01:52.88,Caption,,0,0,0,,ЕСЛИ НА ВЫХОДЕ ЛЕЖИТ ТО, ЧТО СОГЛАСОВЫВАЛИ И БЕЗ НЕЁ?
Dialogue: 0,0:01:53.35,0:01:55.84,Caption,,0,0,0,,ОБМЕН НУЖЕН. НО ПОДАВАТЬ ЕГО КАК ШАГ К
Dialogue: 0,0:01:55.92,0:01:58.56,Caption,,0,0,0,,МИРУ УЖЕ НЕЛЬЗЯ ЛЮДИ СПРАШИВАЮТ ПРО ТЕРРИТОРИИ,
Dialogue: 0,0:01:58.73,0:02:01.04,Caption,,0,0,0,,ПРО ВОЙСКА, ПРО УСЛОВИЯ ФИНАЛА,
Dialogue: 0,0:02:01.32,0:02:04.00,Caption,,0,0,0,,А ИМ ОТВЕЧАЮТ ПРО ВОЗВРАЩЕНИЕ ПЛЕННЫХ. ОТЛИЧНО.
Dialogue: 0,0:02:04.23,0:02:06.56,Caption,,0,0,0,,ВОЕВАТЬ ОТ ЭТОГО МЕНЬШЕ НЕ СТАЛИ. ДЛЯ СПИСКОВ
Dialogue: 0,0:02:06.64,0:02:08.88,Caption,,0,0,0,,НА ОБМЕН СПЕЦПОСЛАННИК С ЗЯТЕМ ПРЕЗИДЕНТА НЕ
Dialogue: 0,0:02:08.88,0:02:11.84,Caption,,0,0,0,,ТРЕБУЕТСЯ ЭТУ РАБОТУ ГОДАМИ ТЯНУТ РАБОЧИЕ ГРУППЫ И
Dialogue: 0,0:02:11.84,0:02:15.04,Caption,,0,0,0,,ПОСРЕДНИКИ, И ТЯНУЛИ ЕЁ РОВНО ТАК ЖЕ В МЕСЯЦЫ,
Dialogue: 0,0:02:15.28,0:02:18.00,Caption,,0,0,0,,КОГДА РАЗГОВАРИВАТЬ БЫЛО БОЛЬШЕ НЕ О ЧЕМ. ОТДЕЛЬНО
Dialogue: 0,0:02:18.00,0:02:20.80,Caption,,0,0,0,,ИДЁТ КОНСТАНТИНОВКА. ПУТИН ПРЕДЛОЖИЛ УСТРОИТЬ ТАМ
Dialogue: 0,0:02:20.80,0:02:25.36,Caption,,0,0,0,,ГУМАНИТАРНУЮ МИССИЮ, АМЕРИКАНЦЫ ИДЕЮ ПОДДЕРЖАЛИ. СНАРУЖИ ЭТО ВЫГЛЯДИТ КАК
Dialogue: 0,0:02:25.44,0:02:28.40,Caption,,0,0,0,,ЕЩЁ ОДИН ГУМАНИТАРНЫЙ ПУНКТ. ВНУТРИ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:02:30.66,0:02:33.54,Caption,,0,0,0,,ЛЮБАЯ ТАКАЯ МИССИЯ НЕМЕДЛЕННО СПОТЫКАЕТСЯ ОБ ОДИН
Dialogue: 0,0:02:33.54,0:02:36.82,Caption,,0,0,0,,ВОПРОС КТО ДЕРЖИТ ТЕРРИТОРИЮ, КТО ПУСКАЕТ,
Dialogue: 0,0:02:37.07,0:02:39.62,Caption,,0,0,0,,КТО ОТВЕЧАЕТ ЗА БЕЗОПАСНОСТЬ ЛЮДЕЙ И С КЕМ
Dialogue: 0,0:02:39.70,0:02:40.98,Caption,,0,0,0,,ВООБЩЕ РАЗГОВАРИВАТЬ НА ЗЕМЛЕ.
Dialogue: 0,0:02:41.61,0:02:44.10,Caption,,0,0,0,,ТО ЕСТЬ ДАЖЕ СПАСАТЕЛЬНЫЙ СЮЖЕТ ЧЕРЕЗ ДВА ШАГА
Dialogue: 0,0:02:44.10,0:02:48.98,Caption,,0,0,0,,ПРИВОДИТ РОВНО ТУДА, ОТКУДА ВСЕ ДРУЖНО УХОДЯТ КРАСИВЫМИ СЛОВАМИ. ЧТОБЫ В
Dialogue: 0,0:02:48.98,0:02:52.02,Caption,,0,0,0,,ГОРОД ЗАШЛА МИССИЯ, КТО ТО ДОЛЖЕН ВЫДАТЬ КОРИДОР,
Dialogue: 0,0:02:52.18,0:02:55.14,Caption,,0,0,0,,ГАРАНТИРОВАТЬ ТИШИНУ НА ВРЕМЯ РАБОТЫ И ОТВЕЧАТЬ ЗА
Dialogue: 0,0:02:55.14,0:02:58.66,Caption,,0,0,0,,ЛЮДЕЙ, КОТОРЫЕ ТУДА ПОЕДУТ. А ЭТО ЗНАЧИТ ПРИЗНАТЬ,
Dialogue: 0,0:02:58.90,0:03:00.66,Caption,,0,0,0,,КТО НА ЭТОЙ ЗЕМЛЕ РАСПОРЯЖАЕТСЯ.
Dialogue: 0,0:03:01.34,0:03:04.82,Caption,,0,0,0,,ВОПРОС, ОТ КОТОРОГО СТОРОНЫ БЕГУТ ПО ВСЕМ ОСТАЛЬНЫМ ПУНКТАМ,
Dialogue: 0,0:03:05.14,0:03:07.78,Caption,,0,0,0,,В ГУМАНИТАРНОМ СЮЖЕТЕ ВСТАЁТ СРАЗУ И В ПОЛНЫЙ
Dialogue: 0,0:03:07.86,0:03:10.50,Caption,,0,0,0,,РОСТ. ПО ТЕРРИТОРИЯМ МОСКВА ОСТАЛАСЬ ТАМ,
Dialogue: 0,0:03:10.66,0:03:13.70,Caption,,0,0,0,,ГДЕ СТОЯЛА. ПУТИН ПРОИЗНЁС ДЛЯ РОССИИ СУЩЕСТВУЕТ
Dialogue: 0,0:03:13.70,0:03:19.22,Caption,,0,0,0,,ОДНА ЛИНИЯ РАЗГРАНИЧЕНИЯ, ГОСУДАРСТВЕННАЯ ГРАНИЦА. ВОТ И ВСЯ ЛИНИЯ. ДАЛЬШЕ
Dialogue: 0,0:03:19.22,0:03:22.18,Caption,,0,0,0,,ТАНЦУЙТЕ ОТ НЕЁ. ИСТОРИЧЕСКИЙ ЭКСКУРС ТУТ НИ К
Dialogue: 0,0:03:22.26,0:03:25.70,Caption,,0,0,0,,ЧЕМУ. ВАЖНА САМА ФОРМУЛА. МОСКВА НЕ ПРЕДЛАГАЕТ
Dialogue: 0,0:03:25.78,0:03:28.58,Caption,,0,0,0,,ОБВЕСТИ НЫНЕШНИЙ ФРОНТ ФЛОМАСТЕРОМ И ОБЪЯВИТЬ ЭТО
Dialogue: 0,0:03:28.58,0:03:31.46,Caption,,0,0,0,,КОМПРОМИССОМ. ОНА ГОВОРИТ О ГРАНИЦЕ В ТОМ ВИДЕ,
Dialogue: 0,0:03:31.70,0:03:34.10,Caption,,0,0,0,,В КАКОМ САМА ЕЁ ЗАПИСАЛА. ДОНЕЦКАЯ,
Dialogue: 0,0:03:34.26,0:03:38.26,Caption,,0,0,0,,ЛУГАНСКАЯ, ЗАПОРОЖСКАЯ И ХЕРСОНСКАЯ ОБЛАСТИ ВНЕСЕНЫ В
Dialogue: 0,0:03:38.26,0:03:41.62,Caption,,0,0,0,,РОССИЙСКУЮ КОНСТИТУЦИЮ КАК СУБЪЕКТЫ ФЕДЕРАЦИИ. ЛИНИЯ
Dialogue: 0,0:03:41.62,0:03:44.26,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ С ЭТИМИ РУБЕЖАМИ НЕ СОВПАДАЕТ.
Dialogue: 0,0:03:46.55,0:03:50.07,Caption,,0,0,0,,ЗНАЧИТ, КОГДА КТО ТО БОДРО ПРЕДЛАГАЕТ РЕШИТЬ ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:03:50.07,0:03:53.35,Caption,,0,0,0,,ВОПРОС, У СТОРОН НА СТОЛЕ ЛЕЖАТ РАЗНЫЕ КАРТЫ ЕЩЁ
Dialogue: 0,0:03:53.43,0:03:56.31,Caption,,0,0,0,,ДО ПЕРВОГО СЛОВА. ОДНА КОРОТКАЯ ФРАЗА ИНОГДА
Dialogue: 0,0:03:56.39,0:03:59.35,Caption,,0,0,0,,ОБЪЯСНЯЕТ БОЛЬШЕ, ЧЕМ ДЕСЯТОК ПРЕСС КОНФЕРЕНЦИЙ.
Dialogue: 0,0:03:59.90,0:04:02.63,Caption,,0,0,0,,ЕСЛИ МОСКВА ГОВОРИТ, ЧТО ГРАНИЦА ВОТ ЗДЕСЬ,
Dialogue: 0,0:04:03.19,0:04:05.83,Caption,,0,0,0,,ТОРГ НАЧИНАЕТСЯ НЕ С НУЛЯ, А С ПОЗИЦИИ,
Dialogue: 0,0:04:06.07,0:04:08.95,Caption,,0,0,0,,КОТОРУЮ РОССИЯ УЖЕ ЗАКРЕПИЛА КАК ГОСУДАРСТВЕННУЮ.
Dialogue: 0,0:04:09.43,0:04:14.07,Caption,,0,0,0,,НРАВИТСЯ ЭТО КОМУ ТО ИЛИ НЕТ, СПОРИТЬ ПРИДЁТСЯ ИМЕННО С НЕЙ. С ИНОСТРАННЫМИ
Dialogue: 0,0:04:14.15,0:04:16.79,Caption,,0,0,0,,ВОЙСКАМИ ВООБЩЕ ДЕЖАВЮ. МОСКВА ПОВТОРЯЕТ ЧУЖОЙ
Dialogue: 0,0:04:16.79,0:04:18.95,Caption,,0,0,0,,КОНТИНГЕНТ НА УКРАИНЕ НЕПРИЕМЛЕМ,
Dialogue: 0,0:04:19.18,0:04:22.31,Caption,,0,0,0,,ТАКИЕ ВОЙСКА БУДУТ ЗАКОННОЙ ЦЕЛЬЮ. ЕВРОПА ПОВТОРЯЕТ
Dialogue: 0,0:04:22.31,0:04:25.27,Caption,,0,0,0,,КОНТИНГЕНТ И ЕСТЬ ГАРАНТИЯ БЕЗОПАСНОСТИ. И ОБЕ
Dialogue: 0,0:04:25.27,0:04:27.11,Caption,,0,0,0,,СТОРОНЫ СТАРАТЕЛЬНО ДЕЛАЮТ ВИД,
Dialogue: 0,0:04:27.35,0:04:30.31,Caption,,0,0,0,,ЧТО ОБНАРУЖИЛИ СВЕЖИЙ ВОПРОС. НУ ЗАХОДИТЕ. ТОЛЬКО
Dialogue: 0,0:04:30.31,0:04:32.95,Caption,,0,0,0,,УДИВЛЯТЬСЯ ПОТОМ НЕ ПРИДЁТСЯ ВАМ ЗАРАНЕЕ ОБЪЯСНИЛИ,
Dialogue: 0,0:04:33.11,0:04:36.07,Caption,,0,0,0,,ЧЕМ МОСКВА СЧИТАЕТ ТАКОЕ ПРИСУТСТВИЕ. ЗАГАДКИ ТУТ
Dialogue: 0,0:04:36.07,0:04:39.11,Caption,,0,0,0,,НИКАКОЙ. ЗАГАДКА В ДРУГОМ ЗАЧЕМ ВОЗВРАЩАТЬ ЭТОТ
Dialogue: 0,0:04:39.11,0:04:41.03,Caption,,0,0,0,,ПУНКТ НА СТОЛ В НЕИЗМЕННОМ ВИДЕ,
Dialogue: 0,0:04:41.27,0:04:43.27,Caption,,0,0,0,,ЕСЛИ ОТВЕТ ПО НЕМУ ТОЖЕ НЕ МЕНЯЕТСЯ?
Dialogue: 0,0:04:43.61,0:04:46.23,Caption,,0,0,0,,ЗДЕСЬ ЖЕ ВЫПЛЫВАЕТ ПИСЬМО ПУТИНА БАЙДЕНУ ЗА ДВЕ
Dialogue: 0,0:04:46.23,0:04:48.95,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ПЕРВЫЙ ГОД. РОССИЙСКАЯ ДЕЛЕГАЦИЯ
Dialogue: 0,0:04:48.95,0:04:52.31,Caption,,0,0,0,,ОПЯТЬ УВОДИТ РАЗГОВОР ТУДА, К ТРЕБОВАНИЯМ БЕЗОПАСНОСТИ,
Dialogue: 0,0:04:52.49,0:04:55.11,Caption,,0,0,0,,КОТОРЫЕ МОСКВА ВЫСТАВЛЯЛА ЕЩЁ ДО НАЧАЛА БОЛЬШОЙ
Dialogue: 0,0:04:55.11,0:04:58.07,Caption,,0,0,0,,ВОЙНЫ. ЛЮБОПЫТНО НЕ САМО ОБРАЩЕНИЕ К АРХИВУ.
Dialogue: 0,0:05:00.35,0:05:04.10,Caption,,0,0,0,,ЛЮБОПЫТНО, ЧТО СПУСТЯ ПЯТЬ ЛЕТ ПЕРЕГОВОРЩИКИ ТАЩАТ НА СТОЛ
Dialogue: 0,0:05:04.19,0:05:08.18,Caption,,0,0,0,,ТОТ ЖЕ САМЫЙ УЗЕЛ. ЕСЛИ БЫ СЕГОДНЯШНИЙ СПОР СВОДИЛСЯ К ЛИНИИ НА
Dialogue: 0,0:05:08.26,0:05:11.94,Caption,,0,0,0,,КАРТЕ, ПИСЬМО МОЖНО БЫЛО БЫ ОТДАТЬ ИСТОРИКАМ. ЕГО ДОСТАЮТ
Dialogue: 0,0:05:11.94,0:05:16.58,Caption,,0,0,0,,СЕЙЧАС. ВЫХОДИТ, РОССИЙСКАЯ СТОРОНА ПРИВЯЗЫВАЕТ БУДУЩЕЕ СОГЛАШЕНИЕ НЕ
Dialogue: 0,0:05:16.67,0:05:20.35,Caption,,0,0,0,,ТОЛЬКО К ЗЕМЛЕ, НО И К УСТРОЙСТВУ БЕЗОПАСНОСТИ ВОКРУГ НЕЁ. И
Dialogue: 0,0:05:20.42,0:05:24.42,Caption,,0,0,0,,СРАЗУ ПОНЯТНЕЕ, ПОЧЕМУ ТЕМА ЧУЖИХ ВОЙСК ТАК ЗЛИТ МОСКВУ ДЛЯ
Dialogue: 0,0:05:24.50,0:05:26.18,Caption,,0,0,0,,ОДНИХ ЭТО СТРАХОВКА ПОСЛЕ ВОЙНЫ,
Dialogue: 0,0:05:26.58,0:05:30.58,Caption,,0,0,0,,ДЛЯ ДРУГИХ РОВНО ТО, ПРОТИВ ЧЕГО ОНИ ВЫСТУПАЛИ ДО НЕЁ. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:05:30.66,0:05:34.50,Caption,,0,0,0,,АМЕРИКАНЦЫ СООБЩАЮТ, ЧТО К СЛЕДУЮЩЕМУ РАУНДУ ПОДКЛЮЧАТ ЕВРОПЕЙЦЕВ.
Dialogue: 0,0:05:34.65,0:05:37.22,Caption,,0,0,0,,ПОДКЛЮЧАЙТЕ. ВОПРОС ОДИН С ЧЕМ ОНИ ПРИЕДУТ?
Dialogue: 0,0:05:37.52,0:05:40.66,Caption,,0,0,0,,ЕСЛИ ГЛАВНАЯ ЕВРОПЕЙСКАЯ ГАРАНТИЯ ЭТО КОНТИНГЕНТ,
Dialogue: 0,0:05:40.88,0:05:43.78,Caption,,0,0,0,,А МОСКВА ЗАРАНЕЕ ГОВОРИТ, ЧТО КОНТИНГЕНТ НЕ ПРОЙДЁТ,
Dialogue: 0,0:05:44.26,0:05:46.82,Caption,,0,0,0,,ТО ДОБАВЛЕНИЕ КРЕСЕЛ НИЧЕГО НЕ СДВИНЕТ. КРЕСЕЛ
Dialogue: 0,0:05:46.90,0:05:50.02,Caption,,0,0,0,,СТАНЕТ БОЛЬШЕ. КОФЕ УЙДЁТ БОЛЬШЕ. ПЕРЕВОДЧИКИ
Dialogue: 0,0:05:50.02,0:05:53.06,Caption,,0,0,0,,ЗАРАБОТАЮТ БОЛЬШЕ. ТОЧКА СТОЛКНОВЕНИЯ ОСТАНЕТСЯ НА
Dialogue: 0,0:05:53.06,0:05:55.78,Caption,,0,0,0,,СВОЁМ МЕСТЕ. КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:05:55.90,0:05:57.94,Caption,,0,0,0,,КОГДА СЧИТАЮТ НЕ КОЛИЧЕСТВО ДЕЛЕГАЦИЙ,
Dialogue: 0,0:05:58.24,0:06:02.42,Caption,,0,0,0,,А РЕАЛЬНЫЕ ПРОТИВОРЕЧИЯ, ПОДПИШИТЕСЬ. САМОЕ ИНТЕРЕСНОЕ НАЧИНАЕТСЯ ДАЛЬШЕ.
Dialogue: 0,0:06:02.72,0:06:04.82,Caption,,0,0,0,,ПОТОМУ ЧТО ДАЛЬШЕ В КАДР ВХОДИТ СТАРШИЛД.
Dialogue: 0,0:06:05.68,0:06:10.42,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ЗАЯВЛЯЕТ, ЧТО СКОРОСТЬ ВОЕННОЙ СПУТНИКОВОЙ СВЯЗИ УРЕЗАЛИ И ИЗ
Dialogue: 0,0:06:10.50,0:06:13.06,Caption,,0,0,0,,ЗА ЭТОГО УКРАИНСКИМ БЕСПИЛОТНИКАМ ТЯЖЕЛЕЕ
Dialogue: 0,0:06:13.06,0:06:15.30,Caption,,0,0,0,,ПЕРЕХВАТЫВАТЬ РОССИЙСКИЕ РЕАКТИВНЫЕ ДРОНЫ.
Dialogue: 0,0:06:17.59,0:06:21.75,Caption,,0,0,0,,КОМПАНИЯ ОТВЕЧАЕТ, ЧТО УСЛОВИЙ НЕ МЕНЯЛА. В МЕГАБИТАХ МЫ РАЗБИРАТЬСЯ
Dialogue: 0,0:06:21.83,0:06:26.71,Caption,,0,0,0,,НЕ СТАНЕМ. ВАЖНЕЕ ДРУГОЕ. СТАРЛИНК И СТАРШИЛД ДЛЯ УКРАИНСКОЙ
Dialogue: 0,0:06:26.71,0:06:29.99,Caption,,0,0,0,,АРМИИ ДАВНО НЕ ПРОСТО ИНТЕРНЕТ В ОКОПЕ. СВЯЗЬ,
Dialogue: 0,0:06:30.15,0:06:33.19,Caption,,0,0,0,,УПРАВЛЕНИЕ, ДРОНЫ, ПЕРЕДАЧА ДАННЫХ,
Dialogue: 0,0:06:33.51,0:06:36.07,Caption,,0,0,0,,ВСЯ ЭТА ВОЕННАЯ МЕХАНИКА КРЕПКО ВИСИТ НА
Dialogue: 0,0:06:36.07,0:06:38.95,Caption,,0,0,0,,АМЕРИКАНСКОЙ СПУТНИКОВОЙ ИНФРАСТРУКТУРЕ. А ЕСЛИ ЧТО
Dialogue: 0,0:06:39.03,0:06:42.87,Caption,,0,0,0,,ТО МОЖНО ЗАМЕДЛИТЬ, ОГРАНИЧИТЬ ИЛИ ПЕРЕПОДПИСАТЬ НА НОВЫХ УСЛОВИЯХ,
Dialogue: 0,0:06:43.12,0:06:46.87,Caption,,0,0,0,,ЗНАЧИТ, В РУКАХ ПОЯВЛЯЕТСЯ РЫЧАГ. НАЖИМАТЬ ДО УПОРА ПРИ
Dialogue: 0,0:06:46.87,0:06:48.87,Caption,,0,0,0,,ЭТОМ НЕОБЯЗАТЕЛЬНО. ХВАТАЕТ ТОГО,
Dialogue: 0,0:06:49.03,0:06:53.35,Caption,,0,0,0,,ЧТОБЫ ВСЕ ЗНАЛИ, ГДЕ КНОПКА И ЧЬЯ РУКА РЯДОМ. ЗАМЕНИТЬ ТАКУЮ
Dialogue: 0,0:06:53.35,0:06:56.23,Caption,,0,0,0,,СВЯЗЬ ЗА НЕДЕЛЮ НЕВОЗМОЖНО ЭТО НЕ ПОСТАВКА СНАРЯДОВ,
Dialogue: 0,0:06:56.49,0:06:59.03,Caption,,0,0,0,,КОТОРУЮ МОЖНО ПЕРЕКРЫТЬ У ОДНОГО ПРОДАВЦА И ОТКРЫТЬ
Dialogue: 0,0:06:59.11,0:07:01.83,Caption,,0,0,0,,У ДРУГОГО. ФРОНТ, КОТОРЫЙ ВОЮЕТ ДРОНАМИ,
Dialogue: 0,0:07:01.99,0:07:05.59,Caption,,0,0,0,,ВИСИТ НА СПУТНИКАХ, А СПУТНИКИ ПРИНАДЛЕЖАТ ЧАСТНОЙ АМЕРИКАНСКОЙ
Dialogue: 0,0:07:05.59,0:07:08.63,Caption,,0,0,0,,КОМПАНИИ. И ВСЯ ЭТА КОНСТРУКЦИЯ ДЕРЖИТСЯ РОВНО ДО
Dialogue: 0,0:07:08.71,0:07:12.15,Caption,,0,0,0,,ТОГО ДНЯ, ПОКА В ВАШИНГТОНЕ СЧИТАЮТ НУЖНЫМ ЕЁ ДЕРЖАТЬ.
Dialogue: 0,0:07:12.72,0:07:14.55,Caption,,0,0,0,,НО И КИЕВ НЕ СТОИТ С ПУСТЫМИ РУКАМИ.
Dialogue: 0,0:07:15.01,0:07:17.91,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ВЫТАСКИВАЕТ ИСТОРИЮ НАРУЖУ И ГОВОРИТ УЖЕ
Dialogue: 0,0:07:17.91,0:07:21.19,Caption,,0,0,0,,НЕ ПРО ТЕХНИКУ. ОН ПРИВЯЗЫВАЕТ ОГРАНИЧЕНИЯ К ТОМУ,
Dialogue: 0,0:07:21.35,0:07:23.91,Caption,,0,0,0,,ЧТО КТО ТО В США СЧИТАЕТ ЧАСТЬ УКРАИНСКОЙ
Dialogue: 0,0:07:23.99,0:07:26.87,Caption,,0,0,0,,ТЕРРИТОРИИ НЕ УКРАИНСКОЙ. ЭТО УЖЕ НЕ ИНЖЕНЕРНЫЙ
Dialogue: 0,0:07:26.87,0:07:31.59,Caption,,0,0,0,,СПОР. ЭТО ГРАНАТА, АККУРАТНО ЗАНЕСЁННАЯ ОБРАТНО В ВАШИНГТОН. ПОТОМУ ЧТО
Dialogue: 0,0:07:31.59,0:07:33.51,Caption,,0,0,0,,ДАЛЬШЕ РАБОТАЕТ АМЕРИКАНСКАЯ КУХНЯ.
Dialogue: 0,0:07:35.80,0:07:39.56,Caption,,0,0,0,,ЕСЛИ ТЕМА РАЗГОНИТСЯ, ДЕМОКРАТЫ ПОЛУЧАТ ЗАКОННЫЙ ПОВОД СПРАШИВАТЬ
Dialogue: 0,0:07:39.56,0:07:42.60,Caption,,0,0,0,,АДМИНИСТРАЦИЮ ТРАМПА, КТО ОГРАНИЧИВАЛ СВЯЗЬ,
Dialogue: 0,0:07:42.83,0:07:45.08,Caption,,0,0,0,,ПО КАКОМУ РЕШЕНИЮ И НЕ ДАВЯТ ЛИ ТАК
Dialogue: 0,0:07:45.08,0:07:47.88,Caption,,0,0,0,,НА КИЕВ. ПОЙДУТ ЗАПРОСЫ, СЛУШАНИЯ,
Dialogue: 0,0:07:48.04,0:07:52.76,Caption,,0,0,0,,КОМИССИИ, ГРОМКИЕ ЗАЯВЛЕНИЯ. И ОПРАВДЫВАТЬСЯ БУДЕТ УЖЕ НЕ КИЕВ
Dialogue: 0,0:07:52.76,0:07:57.08,Caption,,0,0,0,,ПЕРЕД ВАШИНГТОНОМ, А ВАШИНГТОН ПЕРЕД СОБСТВЕННЫМ КОНГРЕССОМ. КРАСИВО
Dialogue: 0,0:07:57.08,0:08:00.28,Caption,,0,0,0,,СДЕЛАНО. РЫЧАГ ДАВЛЕНИЯ НАЧИНАЕТ РАБОТАТЬ СРАЗУ В
Dialogue: 0,0:08:00.28,0:08:04.36,Caption,,0,0,0,,ОБЕ СТОРОНЫ. ПРИЧЁМ ВЫЯСНЯТЬ, КТО ИМЕННО КРУТИЛ НАСТРОЙКИ,
Dialogue: 0,0:08:04.61,0:08:07.16,Caption,,0,0,0,,НИКОМУ И НЕ ОБЯЗАТЕЛЬНО. ИСТОРИЯ УЖЕ ЖИВЁТ.
Dialogue: 0,0:08:07.51,0:08:11.56,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СКАЗАЛ, ЧТО ОГРАНИЧЕНИЯ БЫЛИ. КОМПАНИЯ СКАЗАЛА,
Dialogue: 0,0:08:11.72,0:08:15.08,Caption,,0,0,0,,ЧТО НИЧЕГО НЕ ТРОГАЛА. ДАЛЬШЕ КАЖДЫЙ ЛАГЕРЬ ВЫНИМАЕТ
Dialogue: 0,0:08:15.08,0:08:18.60,Caption,,0,0,0,,ИЗ ЭТОГО ТО, ЧТО ЕМУ НУЖНО. ДЛЯ ОДНИХ ЭТО ПРО ПОМОЩЬ
Dialogue: 0,0:08:18.68,0:08:21.64,Caption,,0,0,0,,УКРАИНЕ. ДЛЯ ДРУГИХ ПРО ПОЛНОМОЧИЯ АДМИНИСТРАЦИИ.
Dialogue: 0,0:08:22.04,0:08:24.28,Caption,,0,0,0,,ДЛЯ ТРЕТЬИХ ПРОСТО ЕЩЁ ОДИН КАМЕНЬ В ТРАМПА.
Dialogue: 0,0:08:24.58,0:08:27.32,Caption,,0,0,0,,И МЕЛКАЯ НАСТРОЙКА СВЯЗИ ПРЕВРАЩАЕТСЯ В ЭПИЗОД
Dialogue: 0,0:08:27.32,0:08:32.44,Caption,,0,0,0,,БОЛЬШОЙ ДРАКИ В ВАШИНГТОНЕ. НА ТАКОМ ФОНЕ СЛОВА ОБ УСПЕШНЫХ ПЕРЕГОВОРАХ ЗВУЧАТ
Dialogue: 0,0:08:32.44,0:08:35.80,Caption,,0,0,0,,ОСОБЕННО НАРЯДНО. ПРО ОБМЕН ДОГОВОРИЛИСЬ. ПРО
Dialogue: 0,0:08:35.80,0:08:39.00,Caption,,0,0,0,,ГУМАНИТАРНУЮ МИССИЮ ГОТОВЫ ГОВОРИТЬ. СЛЕДУЮЩИЙ РАУНД
Dialogue: 0,0:08:39.00,0:08:42.68,Caption,,0,0,0,,ГОТОВЯТ. ЕВРОПЕЙЦЕВ ПОЗОВУТ. ДВИЖЕНИЕ НАЛИЦО. А
Dialogue: 0,0:08:42.76,0:08:45.08,Caption,,0,0,0,,ТЕПЕРЬ ТЯЖЁЛАЯ ЧАСТЬ. МОСКВА ГОВОРИТ О
Dialogue: 0,0:08:45.08,0:08:48.20,Caption,,0,0,0,,ГОСУДАРСТВЕННОЙ ГРАНИЦЕ. МОСКВА НЕ ПРИНИМАЕТ ЧУЖИЕ
Dialogue: 0,0:08:48.20,0:08:51.24,Caption,,0,0,0,,ВОЙСКА. РОССИЙСКАЯ СТОРОНА СНОВА ВОЗВРАЩАЕТ
Dialogue: 0,0:08:51.24,0:08:54.28,Caption,,0,0,0,,ТРЕБОВАНИЯ БЕЗОПАСНОСТИ ОБРАЗЦА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:54.28,0:08:59.52,Caption,,0,0,0,,ПЕРВОГО ГОДА. ЗЕЛЕНСКИЙ ТЕМ ВРЕМЕНЕМ ВТЯГИВАЕТ В ТЕРРИТОРИАЛЬНЫЙ
Dialogue: 0,0:08:59.60,0:09:02.32,Caption,,0,0,0,,СПОР АМЕРИКАНСКИЕ СПУТНИКИ И ВНУТРЕННЮЮ БОРЬБУ В
Dialogue: 0,0:09:02.32,0:09:05.12,Caption,,0,0,0,,США. ТАК ГДЕ ТОТ САМЫЙ БОЛЬШОЙ ПРОГРЕСС?
Dialogue: 0,0:09:05.43,0:09:07.84,Caption,,0,0,0,,ВОПРОС НЕ РАДИ КРАСНОГО СЛОВЦА. ПЕРЕГОВОРЫ НЕ
Dialogue: 0,0:09:07.84,0:09:10.32,Caption,,0,0,0,,БЕССМЫСЛЕННЫ РАЗГОВАРИВАТЬ ВСЁ РАВНО ПРИДЁТСЯ,
Dialogue: 0,0:09:10.56,0:09:12.56,Caption,,0,0,0,,ГУМАНИТАРНЫЕ ДОГОВОРЁННОСТИ НУЖНЫ,
Dialogue: 0,0:09:12.72,0:09:15.20,Caption,,0,0,0,,ПЛЕННЫХ НУЖНО ВОЗВРАЩАТЬ, МИССИЮ,
Dialogue: 0,0:09:15.28,0:09:19.20,Caption,,0,0,0,,КОТОРАЯ ПОМОЖЕТ ЛЮДЯМ, НУЖНО ОРГАНИЗОВЫВАТЬ. ТОЛЬКО ВСЁ ЭТО НЕ РАВНО
Dialogue: 0,0:09:19.20,0:09:22.00,Caption,,0,0,0,,РЕШЕНИЮ ВОПРОСОВ, ИЗ ЗА КОТОРЫХ ВОЙНА И ИДЁТ.
Dialogue: 0,0:09:22.56,0:09:25.12,Caption,,0,0,0,,ДЕСЯТЬ ВСТРЕЧ ЭТО УЖЕ НЕ СЛУЧАЙНЫЙ КОНТАКТ,
Dialogue: 0,0:09:25.35,0:09:28.72,Caption,,0,0,0,,А ПОЛНОЦЕННАЯ СЕРИЯ. И ПОСЛЕ ДЕСЯТИ ХОЧЕТСЯ УВИДЕТЬ
Dialogue: 0,0:09:28.80,0:09:30.88,Caption,,0,0,0,,НЕ ПОДТВЕРЖДЕНИЕ ГОТОВНОСТИ ВСТРЕТИТЬСЯ В
Dialogue: 0,0:09:30.88,0:09:35.68,Caption,,0,0,0,,ОДИННАДЦАТЫЙ РАЗ, А МЕСТО, ГДЕ КТО ТО ДЕЙСТВИТЕЛЬНО СДВИНУЛСЯ ПО ПУНКТУ,
Dialogue: 0,0:09:35.92,0:09:38.72,Caption,,0,0,0,,КОТОРЫЙ ВЧЕРА НАЗЫВАЛ ПРИНЦИПИАЛЬНЫМ. ПО ГРАНИЦЕ
Dialogue: 0,0:09:38.72,0:09:40.96,Caption,,0,0,0,,МОСКВА НЕ ОТСТУПИЛА НИ НА МЕТР. ПО ЧУЖИМ
Dialogue: 0,0:09:40.96,0:09:43.44,Caption,,0,0,0,,ВОЙСКАМ ОТВЕТ ТОТ ЖЕ, ЧТО БЫЛ ДО ПОЕЗДКИ.
Dialogue: 0,0:09:44.08,0:09:46.40,Caption,,0,0,0,,ТРЕБОВАНИЯ БЕЗОПАСНОСТИ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО
Dialogue: 0,0:09:46.48,0:09:48.96,Caption,,0,0,0,,ГОДА ВЕРНУЛИСЬ НА СТОЛ В ПРЕЖНЕМ ВИДЕ. ИЗ
Dialogue: 0,0:09:49.04,0:09:51.20,Caption,,0,0,0,,ВСЕЙ СЕРИИ В СУХОМ ОСТАТКЕ ОБМЕН,
Dialogue: 0,0:09:51.53,0:09:54.96,Caption,,0,0,0,,ИДЕЯ МИССИИ И СОГЛАСИЕ ВСТРЕТИТЬСЯ ЕЩЁ РАЗ. ПУБЛИЧНО
Dialogue: 0,0:09:55.04,0:09:57.36,Caption,,0,0,0,,ТАКОГО МЕСТА ПОКА НЕТ. ЕСТЬ ДРУГОЕ.
Dialogue: 0,0:09:57.92,0:10:00.56,Caption,,0,0,0,,АМЕРИКАНЦЫ ПРОДОЛЖАЮТ ЛЕТАТЬ. МОСКВА ПРОДОЛЖАЕТ
Dialogue: 0,0:10:00.56,0:10:02.88,Caption,,0,0,0,,ПОВТОРЯТЬ УСЛОВИЯ. ЕВРОПА ИЩЕТ,
Dialogue: 0,0:10:03.21,0:10:05.76,Caption,,0,0,0,,КАК ВОЙТИ В СЛЕДУЮЩИЙ РАУНД СО СВОИМИ ГАРАНТИЯМИ.
Dialogue: 0,0:10:06.06,0:10:08.16,Caption,,0,0,0,,КИЕВ УЧИТСЯ НЕ ТОЛЬКО ДЕРЖАТЬ УДАР,
Dialogue: 0,0:10:08.32,0:10:11.12,Caption,,0,0,0,,НО И ОТПРАВЛЯТЬ ДАВЛЕНИЕ ОБРАТНО ЗА ОКЕАН.
Dialogue: 0,0:10:13.40,0:10:16.12,Caption,,0,0,0,,ТАК ЧТО СЛЕДУЮЩУЮ ВСТРЕЧУ СТОИТ МЕРИТЬ НЕ УЛЫБКАМИ
Dialogue: 0,0:10:16.20,0:10:19.48,Caption,,0,0,0,,И НЕ СЛОВОМ "ПРОГРЕСС". ВСЁ ПРОЩЕ. ИЗМЕНИЛСЯ ХОТЯ
Dialogue: 0,0:10:19.48,0:10:21.88,Caption,,0,0,0,,БЫ ОДИН ИЗ ГЛАВНЫХ ПУНКТОВ, ЗНАЧИТ,
Dialogue: 0,0:10:22.01,0:10:27.08,Caption,,0,0,0,,ПРОЦЕСС ПОШЁЛ. СНОВА ОБМЕН, ТЁПЛАЯ АТМОСФЕРА И ОБЕЩАНИЕ СОЗВОНИТЬСЯ,
Dialogue: 0,0:10:27.31,0:10:30.28,Caption,,0,0,0,,ЗНАЧИТ, ЭТО НЕ ПУТЬ К МИРУ. ЭТО ПОДПИСКА С
Dialogue: 0,0:10:30.28,0:10:31.08,Caption,,0,0,0,,АВТОПРОДЛЕНИЕМ.
