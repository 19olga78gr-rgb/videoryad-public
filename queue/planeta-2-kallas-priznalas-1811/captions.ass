Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,ЕВРОПА ПОЛУЧИЛА ШАНС ПОПАСТЬ НА БОЛЬШИЕ ПЕРЕГОВОРЫ И
Dialogue: 0,0:00:02.92,0:00:05.32,Caption,,0,0,0,,ТУТ ЖЕ УСТРОИЛА СПОР У ВХОДА. КТО ВОЙДЁТ
Dialogue: 0,0:00:05.32,0:00:09.00,Caption,,0,0,0,,ПЕРВЫМ, КОМУ ДАДУТ СЛОВО И ПОЧЕМУ СОСЕД ВООБЩЕ ОКАЗАЛСЯ
Dialogue: 0,0:00:09.08,0:00:11.32,Caption,,0,0,0,,В СПИСКЕ. ДЕЛЕГАЦИЮ ЕЩЁ НЕ ОТПРАВИЛИ,
Dialogue: 0,0:00:11.48,0:00:15.88,Caption,,0,0,0,,А НЕДОВОЛЬНЫХ УЖЕ БОЛЬШЕ, ЧЕМ УЧАСТНИКОВ. ЕЩЁ НЕДАВНО ЭТА КОМПАНИЯ УВЕРЯЛА
Dialogue: 0,0:00:15.88,0:00:19.56,Caption,,0,0,0,,ВСЕХ, ЧТО ДЕЙСТВУЕТ КАК ЕДИНОЕ ЦЕЛОЕ. ТЕПЕРЬ У ЦЕЛОГО
Dialogue: 0,0:00:19.56,0:00:21.40,Caption,,0,0,0,,ОБНАРУЖИЛОСЬ СЛИШКОМ МНОГО ГОЛОВ,
Dialogue: 0,0:00:21.65,0:00:24.68,Caption,,0,0,0,,И КАЖДАЯ СЧИТАЕТ ГЛАВНОЙ СЕБЯ. ПОДПИШИТЕСЬ НА КАНАЛ.
Dialogue: 0,0:00:25.71,0:00:28.52,Caption,,0,0,0,,ЗА СПОРОМ О СОСТАВЕ ДЕЛЕГАЦИИ ПРЯЧЕТСЯ ВОПРОС КУДА
Dialogue: 0,0:00:28.52,0:00:31.48,Caption,,0,0,0,,НЕПРИЯТНЕЕ СПОСОБНА ЛИ ЕВРОПА ВООБЩЕ ДОГОВОРИТЬСЯ ОТ
Dialogue: 0,0:00:31.48,0:00:36.28,Caption,,0,0,0,,СОБСТВЕННОГО ИМЕНИ. ГЛАВА АВСТРИЙСКОГО МИД БЕАТЕ МАЙНЛЬ РАЙЗИНГЕР
Dialogue: 0,0:00:36.57,0:00:39.08,Caption,,0,0,0,,ОПИСАЛА ПОЛОЖЕНИЕ ЕВРОПЫ НА ВСТРЕЧЕ В АБУ ДАБИ
Dialogue: 0,0:00:39.08,0:00:41.24,Caption,,0,0,0,,ПРЕДЕЛЬНО НАГЛЯДНО. ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:00:41.32,0:00:46.04,Caption,,0,0,0,,ПО ЕЁ СЛОВАМ, УСАДИЛИ ЗА ДЕТСКИЙ СТОЛ. ОБИДНО. ГОДАМИ ОБЪЯСНЯТЬ
Dialogue: 0,0:00:46.04,0:00:49.08,Caption,,0,0,0,,ОСТАЛЬНЫМ ПРАВИЛА ПОВЕДЕНИЯ, А ПОТОМ ОБНАРУЖИТЬ,
Dialogue: 0,0:00:49.40,0:00:52.28,Caption,,0,0,0,,ЧТО СЕРЬЁЗНЫЙ РАЗГОВОР НАЧАЛСЯ БЕЗ ТЕБЯ. ЕЩЁ
Dialogue: 0,0:00:52.28,0:00:54.68,Caption,,0,0,0,,НЕМНОГО, И ПРИНЕСУТ СОК С ТРУБОЧКОЙ,
Dialogue: 0,0:00:54.92,0:00:57.48,Caption,,0,0,0,,ЧТОБЫ ВЗРОСЛЫМ НЕ МЕШАЛИ. ТОЛЬКО ПЕРЕСАДКА ЗА
Dialogue: 0,0:00:57.48,0:01:00.52,Caption,,0,0,0,,ГЛАВНЫЙ СТОЛ НИЧЕГО НЕ РЕШАЕТ. СНАЧАЛА НАДО ПОНЯТЬ,
Dialogue: 0,0:01:00.67,0:01:03.32,Caption,,0,0,0,,КОГО ТУДА ОТПРАВЛЯТЬ. ОДНОГО ПРЕДСТАВИТЕЛЯ?
Dialogue: 0,0:01:03.47,0:01:07.72,Caption,,0,0,0,,СЕМЕРЫХ? КАЖДОГО, КТО СЧИТАЕТ ПРЕДСТАВИТЕЛЕМ ИМЕННО СЕБЯ?
Dialogue: 0,0:01:08.11,0:01:10.76,Caption,,0,0,0,,ИНАЧЕ РАЗГОВОР БУДЕТ НАПОМИНАТЬ СОБРАНИЕ ЖИЛЬЦОВ,
Dialogue: 0,0:01:11.00,0:01:14.76,Caption,,0,0,0,,ГДЕ ПОЛОВИНА ОБСУЖДАЕТ КРЫШУ, А ВТОРАЯ УЖЕ МЕНЯЕТ ПРЕДСЕДАТЕЛЯ.
Dialogue: 0,0:01:17.05,0:01:19.69,Caption,,0,0,0,,УРСУЛА ФОН ДЕР ЛЯЙЕН ПОДТВЕРДИЛА ФОРМАТ ПЯТИ
Dialogue: 0,0:01:19.69,0:01:22.97,Caption,,0,0,0,,ГОСУДАРСТВ ПЛЮС ЕВРОСОЮЗ. УЧАСТВОВАТЬ ДОЛЖНЫ
Dialogue: 0,0:01:23.06,0:01:26.57,Caption,,0,0,0,,ЕВРОКОМИССИЯ, ЕВРОСОВЕТ, ВЕЛИКОБРИТАНИЯ,
Dialogue: 0,0:01:26.73,0:01:31.77,Caption,,0,0,0,,ГЕРМАНИЯ, ИТАЛИЯ, ПОЛЬША И ФРАНЦИЯ. ВЫГЛЯДИТ ВНУШИТЕЛЬНО,
Dialogue: 0,0:01:31.89,0:01:36.09,Caption,,0,0,0,,ПОКА НИКТО НЕ ЗАГОВОРИЛ. ГЛАВА МИД ИСПАНИИ ХОСЕ МАНУЭЛЬ АЛЬБАРЕС
Dialogue: 0,0:01:36.09,0:01:39.53,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ, ЧТО ТАКОЕ КОЛИЧЕСТВО ГОЛОСОВ ЛЕГКО ПРЕВРАТИТ
Dialogue: 0,0:01:39.53,0:01:42.49,Caption,,0,0,0,,ОБСУЖДЕНИЕ В КАКОФОНИЮ. ДО РАЗГОВОРА С МОСКВОЙ
Dialogue: 0,0:01:42.49,0:01:45.05,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ТРЕБУЕТСЯ ОТДЕЛЬНЫЙ РАЗГОВОР О ТОМ,
Dialogue: 0,0:01:45.37,0:01:48.25,Caption,,0,0,0,,КТО БУДЕТ РАЗГОВАРИВАТЬ С МОСКВОЙ. НАДО ВЫБРАТЬ
Dialogue: 0,0:01:48.25,0:01:50.97,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЯ, ОПРЕДЕЛИТЬ ЕГО ПОЛНОМОЧИЯ,
Dialogue: 0,0:01:51.13,0:01:53.37,Caption,,0,0,0,,СОГЛАСОВАТЬ ФОРМУЛИРОВКИ И ДОБИТЬСЯ,
Dialogue: 0,0:01:53.58,0:01:56.25,Caption,,0,0,0,,ЧТОБЫ ПОСЛЕ ВСТРЕЧИ НИКТО НЕ СООБЩИЛ ЖУРНАЛИСТАМ
Dialogue: 0,0:01:56.25,0:01:59.05,Caption,,0,0,0,,ПРЯМО ПРОТИВОПОЛОЖНОЕ. ПОСЛЕ ЭТОГО МОЖНО НАЧИНАТЬ
Dialogue: 0,0:01:59.13,0:02:02.09,Caption,,0,0,0,,ПЕРЕГОВОРЫ. ЕСЛИ К ТОМУ МОМЕНТУ НЕ ПОНАДОБИТСЯ НОВАЯ
Dialogue: 0,0:02:02.09,0:02:04.97,Caption,,0,0,0,,ДЕЛЕГАЦИЯ ДЛЯ ПЕРЕГОВОРОВ СО СТАРОЙ. ИСПАНСКИЙ
Dialogue: 0,0:02:05.05,0:02:07.69,Caption,,0,0,0,,ВОПРОС РАЗУМЕН. КОГДА ЗА СТОЛОМ СЕМЬ ЦЕНТРОВ
Dialogue: 0,0:02:07.69,0:02:10.97,Caption,,0,0,0,,ВЛИЯНИЯ, ГДЕ НАХОДИТСЯ КНОПКА ОКОНЧАТЕЛЬНОГО РЕШЕНИЯ?
Dialogue: 0,0:02:11.37,0:02:14.73,Caption,,0,0,0,,БЕРЛИН ПРЕДЛАГАЕТ ОДНО, ПАРИЖ НАСТАИВАЕТ НА ДРУГОМ,
Dialogue: 0,0:02:14.96,0:02:20.25,Caption,,0,0,0,,ВАРШАВА ТРЕБУЕТ ТРЕТЬЕГО, БРЮССЕЛЬ ВЫПУСКАЕТ ЧЕТВЁРТОЕ. КАКАЯ ПОЗИЦИЯ ОБЩАЯ И
Dialogue: 0,0:02:20.33,0:02:23.05,Caption,,0,0,0,,КТО ОБЪЯСНИТ ЕЁ ОСТАЛЬНЫМ БЕЗ НОВОЙ МНОГОЧАСОВОЙ
Dialogue: 0,0:02:23.05,0:02:26.89,Caption,,0,0,0,,ВСТРЕЧИ? ВОТ ТУТ ЗНАМЕНИТОЕ ЕВРОПЕЙСКОЕ ЕДИНСТВО ПРОХОДИТ
Dialogue: 0,0:02:26.89,0:02:30.01,Caption,,0,0,0,,НАСТОЯЩУЮ ПРОВЕРКУ. ОБЪЕДИНЯТЬСЯ ПРОТИВ ОБЩЕГО
Dialogue: 0,0:02:30.01,0:02:36.05,Caption,,0,0,0,,ПРОТИВНИКА УДОБНО. ДЛЯ ЭТОГО НЕ НУЖНО ОДИНАКОВО ПОНИМАТЬ БУДУЩЕЕ,
Dialogue: 0,0:02:36.13,0:02:39.41,Caption,,0,0,0,,ДЕЛИТЬ РАСХОДЫ ИЛИ ДОВЕРЯТЬ СОСЕДЯМ. МОЖНО СПОРИТЬ О
Dialogue: 0,0:02:39.41,0:02:44.21,Caption,,0,0,0,,МИГРАЦИИ, ПРОМЫШЛЕННОСТИ, АМЕРИКАНСКОМ ВЛИЯНИИ И УСТРОЙСТВЕ ЕВРОСОЮЗА.
Dialogue: 0,0:02:44.74,0:02:49.57,Caption,,0,0,0,,ДОСТАТОЧНО ОБЩЕЙ МИШЕНИ, И РАЗНОГЛАСИЯ УБИРАЮТСЯ В ШКАФ. ДВЕРЦА ЗАКРЫВАЕТСЯ
Dialogue: 0,0:02:49.65,0:02:53.01,Caption,,0,0,0,,ПЛОХО, НО НА ОБЩЕЙ ФОТОГРАФИИ ЭТОГО НЕ ВИДНО. УБЕРИТЕ
Dialogue: 0,0:02:53.01,0:02:57.41,Caption,,0,0,0,,ИЗ СХЕМЫ РОССИЮ, И СОДЕРЖИМОЕ ШКАФА ВЫВАЛИТСЯ НА ПОЛ. ГЕРМАНИЯ
Dialogue: 0,0:02:57.41,0:03:00.45,Caption,,0,0,0,,ЗАЩИЩАЕТ ЭКОНОМИКУ, ФРАНЦИЯ ВЕДУЩУЮ РОЛЬ,
Dialogue: 0,0:03:00.75,0:03:02.93,Caption,,0,0,0,,ПОЛЬША ПО СВОЕМУ ПОНИМАЕТ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:03:03.08,0:03:06.45,Caption,,0,0,0,,ИТАЛИЯ СЧИТАЕТ РАСХОДЫ. ВЕНГРИЯ ЧИТАЕТ БРЮССЕЛЬСКИЕ
Dialogue: 0,0:03:06.53,0:03:09.17,Caption,,0,0,0,,ИНСТРУКЦИИ ВЫБОРОЧНО. ИСПАНИЯ НЕ ПОНИМАЕТ,
Dialogue: 0,0:03:09.33,0:03:12.53,Caption,,0,0,0,,ЗАЧЕМ НА ВСТРЕЧУ ВЕДУТ ТАКУЮ КОМПАНИЮ. АВСТРИЯ
Dialogue: 0,0:03:12.53,0:03:16.05,Caption,,0,0,0,,ВОЗМУЩЕНА ТЕМ, ЧТО ЕВРОПУ НЕ СЧИТАЮТ САМОСТОЯТЕЛЬНОЙ СИЛОЙ.
Dialogue: 0,0:03:16.42,0:03:18.61,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ ПОКИНУЛА ЕВРОСОЮЗ,
Dialogue: 0,0:03:18.85,0:03:20.93,Caption,,0,0,0,,НО ОТ ПРАВА ОПРЕДЕЛЯТЬ СУДЬБУ КОНТИНЕНТА НЕ
Dialogue: 0,0:03:20.93,0:03:24.29,Caption,,0,0,0,,ОТКАЗАЛАСЬ. ОБЩИЙ ПРОТИВНИК БОЛЬШЕ НЕ ЗАМЕНЯЕТ ОБЩИЙ
Dialogue: 0,0:03:24.29,0:03:26.69,Caption,,0,0,0,,ПРОЕКТ. ЕВРОПЕЙЦАМ ПРИХОДИТСЯ РЕШАТЬ,
Dialogue: 0,0:03:26.85,0:03:29.73,Caption,,0,0,0,,РАДИ ЧЕГО ОНИ ВМЕСТЕ И КАКОЙ РЕЗУЛЬТАТ СЧИТАЮТ
Dialogue: 0,0:03:29.73,0:03:34.93,Caption,,0,0,0,,ПРИЕМЛЕМЫМ. ЭТО ТЯЖЕЛЕЕ, ЧЕМ ДРУЖНО ПРИНЯТЬ ОЧЕРЕДНУЮ РЕЗОЛЮЦИЮ. БУДУЩЕЕ
Dialogue: 0,0:03:34.93,0:03:38.05,Caption,,0,0,0,,ТРЕБУЕТ КОНКРЕТИКИ. КТО ОПЛАЧИВАЕТ ОБЯЗАТЕЛЬСТВА,
Dialogue: 0,0:03:38.29,0:03:43.17,Caption,,0,0,0,,КОМУ ДОСТАЮТСЯ ГАРАНТИИ, КТО ОТВЕЧАЕТ ЗА БЕЗОПАСНОСТЬ И ОПРЕДЕЛЯЕТ УСЛОВИЯ
Dialogue: 0,0:03:43.25,0:03:45.73,Caption,,0,0,0,,ДЛЯ УКРАИНЫ? КТО ЗАПИШЕТ УСПЕХ НА СВОЙ СЧЁТ,
Dialogue: 0,0:03:46.04,0:03:47.73,Caption,,0,0,0,,А КТО ПОЛУЧИТ ТОЛЬКО СЧЁТ К ОПЛАТЕ?
Dialogue: 0,0:03:47.93,0:03:52.08,Caption,,0,0,0,,У КАЖДОГО ЕСТЬ ОТВЕТ. БЕДА В ТОМ,
Dialogue: 0,0:03:52.17,0:03:56.64,Caption,,0,0,0,,ЧТО ОТВЕТЫ РАЗНЫЕ, А ИСПОЛНЯТЬ ПРЕДЛАГАЕТСЯ ВСЕМ. ОСОБЕННО ЯРКО ЭТО
Dialogue: 0,0:03:56.64,0:03:59.52,Caption,,0,0,0,,ВИДНО ПО КАЕ КАЛЛАС. В ПЕРЕГОВОРНУЮ ГРУППУ ЕЁ
Dialogue: 0,0:03:59.52,0:04:01.68,Caption,,0,0,0,,НЕ ВКЛЮЧИЛИ. КАЛЛАС ДАЛА ПОНЯТЬ,
Dialogue: 0,0:04:01.91,0:04:04.48,Caption,,0,0,0,,ЧТО ОТСУТСТВИЕ КРЕСЛА НЕ ПОМЕШАЕТ ЕЙ ВЛИЯТЬ НА
Dialogue: 0,0:04:04.48,0:04:07.76,Caption,,0,0,0,,ПРОИСХОДЯЩЕЕ. В ЕЁ РАСПОРЯЖЕНИИ ЕСТЬ СПЕЦИАЛИСТЫ ПО
Dialogue: 0,0:04:07.76,0:04:10.40,Caption,,0,0,0,,РОССИЙСКОМУ НАПРАВЛЕНИЮ. ОНИ ЗНАЮТ ВНУТРЕННЮЮ
Dialogue: 0,0:04:10.40,0:04:13.04,Caption,,0,0,0,,МЕХАНИКУ ПЕРЕГОВОРОВ И ДОЛЖНЫ ПОМОЧЬ УДЕРЖИВАТЬ
Dialogue: 0,0:04:13.04,0:04:15.12,Caption,,0,0,0,,НУЖНУЮ ЛИНИЮ. ПРИГЛАШЕНИЯ НЕТ,
Dialogue: 0,0:04:15.28,0:04:18.48,Caption,,0,0,0,,НО РУКОВОДСТВО ПРОЦЕССОМ УЖЕ НАМЕЧЕНО. ДВЕРЬ ЗАКРЫТА
Dialogue: 0,0:04:18.48,0:04:21.92,Caption,,0,0,0,,ЛИШЬ ДЛЯ ТЕХ, КТО НЕ УМЕЕТ ОТДАВАТЬ РАСПОРЯЖЕНИЯ ИЗ КОРИДОРА.
Dialogue: 0,0:04:22.56,0:04:25.92,Caption,,0,0,0,,КАЛЛАС ТРЕБУЕТ НАЧИНАТЬ С ПРЕКРАЩЕНИЯ ОГНЯ И СЧИТАЕТ
Dialogue: 0,0:04:25.92,0:04:29.36,Caption,,0,0,0,,РОССИЙСКИЕ УСЛОВИЯ АБСУРДНЫМИ. ПРЕЗИДЕНТ ФИНЛЯНДИИ
Dialogue: 0,0:04:29.36,0:04:32.40,Caption,,0,0,0,,АЛЕКСАНДР СТУББ ПРЕДЛАГАЕТ СМОТРЕТЬ ПРАКТИЧНЕЕ. ПО
Dialogue: 0,0:04:32.48,0:04:36.32,Caption,,0,0,0,,ЕГО МНЕНИЮ, ОТКАЗ ОТ ПРЯМОГО ОБЩЕНИЯ С РОССИЕЙ БЕЗОТВЕТСТВЕНЕН,
Dialogue: 0,0:04:36.64,0:04:39.28,Caption,,0,0,0,,ПОСКОЛЬКУ СОГЛАШЕНИЕ БЕЗ РОССИЙСКОГО СОГЛАСИЯ НЕ
Dialogue: 0,0:04:39.28,0:04:43.04,Caption,,0,0,0,,ПОЯВИТСЯ. ПЕРВЫЙ ПОДХОД ПРЕДЛАГАЕТ ВЫСТАВИТЬ ТРЕБОВАНИЯ ДО
Dialogue: 0,0:04:43.04,0:04:45.52,Caption,,0,0,0,,НАЧАЛА РАЗГОВОРА. ВТОРОЙ НАПОМИНАЕТ,
Dialogue: 0,0:04:45.76,0:04:48.24,Caption,,0,0,0,,ЧТО РАДИ СДЕЛКИ ПРИДЁТСЯ ХОТЯ БЫ ОТКРЫТЬ КАНАЛ
Dialogue: 0,0:04:48.24,0:04:50.88,Caption,,0,0,0,,С ДРУГОЙ СТОРОНОЙ. МЫСЛЬ ЭЛЕМЕНТАРНАЯ,
Dialogue: 0,0:04:51.12,0:04:53.60,Caption,,0,0,0,,НО В ЕВРОПЕ ЕЁ УЖЕ ПРИХОДИТСЯ ПРОИЗНОСИТЬ КАК
Dialogue: 0,0:04:53.60,0:04:56.88,Caption,,0,0,0,,СМЕЛОЕ ИНТЕЛЛЕКТУАЛЬНОЕ ОТКРЫТИЕ. У КАЛЛАС НАШЛОСЬ И
Dialogue: 0,0:04:56.88,0:05:03.00,Caption,,0,0,0,,ДРУГОЕ НАПРАВЛЕНИЕ РАБОТЫ. ОНА ЗАГОВОРИЛА О ЦИФРОВЫХ ДАННЫХ РОССИЙСКИХ
Dialogue: 0,0:05:03.00,0:05:05.24,Caption,,0,0,0,,УЧАСТНИКОВ БОЕВЫХ ДЕЙСТВИЙ, КОТОРЫЕ,
Dialogue: 0,0:05:05.47,0:05:09.00,Caption,,0,0,0,,ПО ЕЁ МНЕНИЮ, МОЖНО ПОЛУЧИТЬ И ИСПОЛЬЗОВАТЬ ДЛЯ ОГРАНИЧЕНИЙ.
Dialogue: 0,0:05:09.56,0:05:11.24,Caption,,0,0,0,,ОТВЕТ ИЗ МОСКВЫ ПРИШЁЛ БЫСТРЕЕ,
Dialogue: 0,0:05:11.40,0:05:14.28,Caption,,0,0,0,,ЧЕМ ЕВРОПЕЙЦЫ СОГЛАСОВАЛИ ОЧЕРЕДНОЕ МЕСТО ЗА СТОЛОМ.
Dialogue: 0,0:05:15.24,0:05:18.12,Caption,,0,0,0,,ВЯЧЕСЛАВ ВОЛОДИН НАСЧИТАЛ КАЛЛАС ДО ДВАДЦАТИ ЛЕТ ПО
Dialogue: 0,0:05:18.12,0:05:20.76,Caption,,0,0,0,,РОССИЙСКОМУ УГОЛОВНОМУ КОДЕКСУ И ПОСОВЕТОВАЛ
Dialogue: 0,0:05:20.76,0:05:24.04,Caption,,0,0,0,,ЗАНЯТЬСЯ ИСТОРИЕЙ. СЦЕНА ВЫШЛА ВЫРАЗИТЕЛЬНАЯ. В
Dialogue: 0,0:05:24.04,0:05:28.04,Caption,,0,0,0,,ДЕЛЕГАЦИЮ КАЛЛАС НЕ ПОЗВАЛИ, ВЛИЯТЬ НА НЕЁ ОНА ВСЁ РАВНО НАМЕРЕНА,
Dialogue: 0,0:05:28.20,0:05:30.12,Caption,,0,0,0,,РОССИЙСКИЕ ДАННЫЕ УЖЕ ОБСУЖДАЕТ,
Dialogue: 0,0:05:30.50,0:05:33.00,Caption,,0,0,0,,А В МОСКВЕ ДЛЯ НЕЁ МЫСЛЕННО ОСВОБОДИЛИ МЕСТО
Dialogue: 0,0:05:33.00,0:05:37.16,Caption,,0,0,0,,СОВСЕМ В ДРУГОМ УЧРЕЖДЕНИИ. ЕСЛИ ВАМ НУЖНЫ ТАКИЕ РАЗБОРЫ ИНТЕРЕСОВ И
Dialogue: 0,0:05:37.16,0:05:39.08,Caption,,0,0,0,,ПОСЛЕДСТВИЙ, ПОДПИШИТЕСЬ НА КАНАЛ.
Dialogue: 0,0:05:40.01,0:05:42.76,Caption,,0,0,0,,САМЫЙ СЕРЬЁЗНЫЙ РАСКОЛ НАЧИНАЕТСЯ ДАЛЬШЕ. В
Dialogue: 0,0:05:42.84,0:05:45.48,Caption,,0,0,0,,ОКРУЖЕНИИ ЭММАНУЭЛЯ МАКРОНА ОБВИНЯЮТ СОЕДИНЁННЫЕ
Dialogue: 0,0:05:45.48,0:05:48.28,Caption,,0,0,0,,ШТАТЫ УЖЕ НЕ ПРОСТО В СОКРАЩЕНИИ ПОМОЩИ УКРАИНЕ.
Dialogue: 0,0:05:48.68,0:05:52.60,Caption,,0,0,0,,ТАМ СЧИТАЮТ, ЧТО ВАШИНГТОН СОЗНАТЕЛЬНО ЛИШАЕТ КИЕВ ВОЗМОЖНОСТИ
Dialogue: 0,0:05:52.60,0:05:56.84,Caption,,0,0,0,,ПРОДОЛЖАТЬ КОНФЛИКТ. ФОРМУЛИРОВКА ЖЁСТКАЯ АМЕРИКАНЦЫ ЯКОБЫ ПЫТАЮТСЯ
Dialogue: 0,0:05:56.84,0:05:59.64,Caption,,0,0,0,,УТОПИТЬ УКРАИНУ. ПАРИЖ ПРИЗЫВАЕТ СОХРАНИТЬ
Dialogue: 0,0:05:59.64,0:06:01.88,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ПОДДЕРЖКУ И СКЛОНИТЬ К ТОМУ ЖЕ
Dialogue: 0,0:06:01.88,0:06:04.52,Caption,,0,0,0,,ОСТАЛЬНЫХ. ЕСЛИ ВАШИНГТОН ОТХОДИТ НАЗАД,
Dialogue: 0,0:06:04.84,0:06:07.40,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ПРЕДЛАГАЮТ ШАГНУТЬ ВПЕРЁД И ПРИНЯТЬ
Dialogue: 0,0:06:07.40,0:06:10.52,Caption,,0,0,0,,БОЛЬШЕ ОБЯЗАТЕЛЬСТВ. ПОКА СОЕДИНЁННЫЕ ШТАТЫ И ЕВРОПА
Dialogue: 0,0:06:10.52,0:06:14.76,Caption,,0,0,0,,ДАВИЛИ В ОДНОМ НАПРАВЛЕНИИ, РАСХОЖДЕНИЯ МОЖНО БЫЛО НЕ ВЫНОСИТЬ НАРУЖУ.
Dialogue: 0,0:06:17.04,0:06:18.80,Caption,,0,0,0,,НО РАЗГОВОР О КОНЕЧНОМ РЕЗУЛЬТАТЕ,
Dialogue: 0,0:06:18.96,0:06:23.12,Caption,,0,0,0,,СРОКАХ И ЦЕНЕ СЛОМАЛ РОВНЫЙ СТРОЙ. ОДНИ ПОДТАЛКИВАЮТ
Dialogue: 0,0:06:23.12,0:06:27.52,Caption,,0,0,0,,КИЕВ К УСТУПКАМ, ДРУГИЕ ВИДЯТ В ЛЮБОЙ УСТУПКЕ ПОРАЖЕНИЕ. ОДНИ ХОТЯТ
Dialogue: 0,0:06:27.52,0:06:29.92,Caption,,0,0,0,,УСКОРИТЬ СОГЛАШЕНИЕ, ДРУГИЕ БОЯТСЯ,
Dialogue: 0,0:06:30.08,0:06:33.52,Caption,,0,0,0,,ЧТО ОНО ЗАКРЕПИТ НЕВЫГОДНЫЙ ИСХОД. И ВСЕ ПРОДОЛЖАЮТ
Dialogue: 0,0:06:33.52,0:06:36.08,Caption,,0,0,0,,ССЫЛАТЬСЯ НА ОБЩУЮ ЗАПАДНУЮ ПОЗИЦИЮ,
Dialogue: 0,0:06:36.32,0:06:38.88,Caption,,0,0,0,,ХОТЯ ОБЩЕЙ ОНА ОСТАЁТСЯ ГЛАВНЫМ ОБРАЗОМ В
Dialogue: 0,0:06:38.88,0:06:42.00,Caption,,0,0,0,,ЗАЯВЛЕНИЯХ. ЕВРОКОМИССИЯ ГОТОВИТ ДЛЯ УКРАИНЫ НОВЫЙ
Dialogue: 0,0:06:42.00,0:06:45.36,Caption,,0,0,0,,КРЕДИТ НА СОРОК ПЯТЬ МИЛЛИАРДОВ ЕВРО. ОН ПРИБАВИТСЯ
Dialogue: 0,0:06:45.44,0:06:49.36,Caption,,0,0,0,,К ДЕВЯНОСТА МИЛЛИАРДАМ, ВЫДЕЛЕННЫМ РАНЕЕ. СУММЫ УЖЕ ТАКИЕ,
Dialogue: 0,0:06:49.66,0:06:52.40,Caption,,0,0,0,,ЧТО ДРУЖЕСКОЕ ПОХЛОПЫВАНИЕ ПО ПЛЕЧУ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:06:52.40,0:06:54.48,Caption,,0,0,0,,НЕРВНОЕ ДВИЖЕНИЕ РУКОЙ К КОШЕЛЬКУ.
Dialogue: 0,0:06:55.04,0:06:58.80,Caption,,0,0,0,,ЧЕХИЯ, СЛОВАКИЯ И ВЕНГРИЯ В ПРОШЛОЙ СХЕМЕ НЕ УЧАСТВОВАЛИ.
Dialogue: 0,0:06:59.12,0:07:01.68,Caption,,0,0,0,,ТЕПЕРЬ К НИМ ПРИСОЕДИНИЛАСЬ БОЛГАРИЯ. ПОПЫТКА
Dialogue: 0,0:07:01.68,0:07:04.24,Caption,,0,0,0,,СВЯЗАТЬ УКРАИНСКУЮ ПОМОЩЬ С ОБЩИМ ЕВРОПЕЙСКИМ
Dialogue: 0,0:07:04.24,0:07:07.04,Caption,,0,0,0,,БЮДЖЕТОМ ВЫЗВАЛА КОНФЛИКТ. ДАЖЕ ИРЛАНДИЯ,
Dialogue: 0,0:07:07.20,0:07:10.00,Caption,,0,0,0,,ПОДДЕРЖИВАЮЩАЯ КИЕВ, ВСТРЕВОЖЕНА СПОСОБОМ,
Dialogue: 0,0:07:10.16,0:07:13.04,Caption,,0,0,0,,КОТОРЫМ ПРОВОДЯТ РЕШЕНИЕ. ПРОВОЗГЛАСИТЬ ЕДИНСТВО
Dialogue: 0,0:07:13.04,0:07:15.84,Caption,,0,0,0,,ЛЕГКО. ДЛЯ ЭТОГО ДОСТАТОЧНО МИКРОФОНА И СЕРЬЁЗНОГО
Dialogue: 0,0:07:15.84,0:07:18.72,Caption,,0,0,0,,ЛИЦА. ФИНАНСИРОВАТЬ ЕГО ЗАМЕТНО ТРУДНЕЕ.
Dialogue: 0,0:07:19.41,0:07:21.52,Caption,,0,0,0,,КОГДА НА СТОЛ КЛАДУТ ДЕСЯТКИ МИЛЛИАРДОВ,
Dialogue: 0,0:07:21.77,0:07:25.04,Caption,,0,0,0,,ВОЗНИКАЮТ НЕПРИЯТНЫЕ ВОПРОСЫ. ПОЧЕМУ ОДНА СТРАНА
Dialogue: 0,0:07:25.16,0:07:28.40,Caption,,0,0,0,,ПЛАТИТ БОЛЬШЕ ДРУГОЙ? КТО ЗАКРОЕТ ДОЛЮ ОТКАЗАВШИХСЯ?
Dialogue: 0,0:07:28.59,0:07:31.20,Caption,,0,0,0,,МОЖНО ЛИ ИСПОЛЬЗОВАТЬ ОБЩИЙ БЮДЖЕТ ДЛЯ ДАВЛЕНИЯ НА
Dialogue: 0,0:07:31.20,0:07:36.69,Caption,,0,0,0,,НЕСОГЛАСНЫХ? ПОЧЕМУ ГРАЖДАНЕ ДОЛЖНЫ ОПЛАЧИВАТЬ РЕШЕНИЕ,
Dialogue: 0,0:07:36.92,0:07:38.85,Caption,,0,0,0,,КОТОРОЕ ИХ ВЛАСТИ НЕ ПОДДЕРЖИВАЮТ?
Dialogue: 0,0:07:39.15,0:07:42.05,Caption,,0,0,0,,РАЗГОВОР О ЦЕННОСТЯХ БЫСТРО ОСВАИВАЕТ БУХГАЛТЕРСКИЙ
Dialogue: 0,0:07:42.05,0:07:45.09,Caption,,0,0,0,,СЛОВАРЬ. ПРОТИВ ОБЩЕГО ПРОТИВНИКА МОЖНО ВЫСТУПАТЬ
Dialogue: 0,0:07:45.09,0:07:48.85,Caption,,0,0,0,,ВСЕМ ЗАЛОМ, НО СОБСТВЕННЫЕ РАСХОДЫ КАЖДЫЙ СЧИТАЕТ ОТДЕЛЬНО.
Dialogue: 0,0:07:49.41,0:07:52.13,Caption,,0,0,0,,ПОЭТОМУ ФИНАНСОВЫЙ СПОР ПОКАЗЫВАЕТ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:07:52.13,0:07:56.05,Caption,,0,0,0,,УСТРОЙСТВО ЧЕСТНЕЕ ТОРЖЕСТВЕННОЙ ДЕКЛАРАЦИИ. АНТОНИУ
Dialogue: 0,0:07:56.05,0:07:58.93,Caption,,0,0,0,,ГУТЕРРИШ НЕ ОЖИДАЕТ БЫСТРОГО ЗАВЕРШЕНИЯ КОНФЛИКТА.
Dialogue: 0,0:07:59.22,0:08:02.85,Caption,,0,0,0,,ДМИТРИЙ ПЕСКОВ ГОВОРИТ, ЧТО МОСКВЕ НЕ НУЖНА КОРОТКАЯ ПАУЗА,
Dialogue: 0,0:08:03.07,0:08:06.45,Caption,,0,0,0,,ТРЕБУЕТСЯ ДОЛГОСРОЧНОЕ РЕШЕНИЕ. ДЕПУТАТ РАДЫ СЕРГЕЙ
Dialogue: 0,0:08:06.53,0:08:10.61,Caption,,0,0,0,,СОБОЛЕВ ПОЛАГАЕТ, ЧТО НОВЫХ РОССИЙСКИХ ПРЕДЛОЖЕНИЙ НЕ БУДЕТ И КРЕМЛЬ
Dialogue: 0,0:08:10.61,0:08:15.65,Caption,,0,0,0,,СОХРАНИТ ПРЕЖНИЕ УСЛОВИЯ. КАЛЛАС ПРОДОЛЖАЕТ НАСТАИВАТЬ НА ПРЕКРАЩЕНИИ ОГНЯ КАК
Dialogue: 0,0:08:15.65,0:08:18.61,Caption,,0,0,0,,ПЕРВОМ ШАГЕ. СТОРОНЫ ДАЖЕ НАЧАЛО ПРОЦЕССА
Dialogue: 0,0:08:18.61,0:08:21.49,Caption,,0,0,0,,ПРЕДСТАВЛЯЮТ ПО РАЗНОМУ. ДЛЯ ОДНИХ СНАЧАЛА ДОЛЖНЫ
Dialogue: 0,0:08:21.49,0:08:26.13,Caption,,0,0,0,,ПРЕКРАТИТЬСЯ БОЕВЫЕ ДЕЙСТВИЯ, А УСЛОВИЯ МОЖНО ОБСУЖДАТЬ ПОТОМ. ДЛЯ ДРУГИХ
Dialogue: 0,0:08:26.13,0:08:28.85,Caption,,0,0,0,,НЕОБХОДИМО ЗАРАНЕЕ ОПРЕДЕЛИТЬ УСТРОЙСТВО ПОСЛЕ
Dialogue: 0,0:08:28.85,0:08:32.13,Caption,,0,0,0,,ОСТАНОВКИ, ИНАЧЕ ПЕРЕДЫШКА ЛИШЬ ПЕРЕНЕСЁТ СЛЕДУЮЩИЙ РАУНД.
Dialogue: 0,0:08:32.53,0:08:35.73,Caption,,0,0,0,,ЕВРОПЕ МАЛО ВЫБРАТЬ МЕЖДУ ЭТИМИ ВАРИАНТАМИ. ЕЙ НУЖНО
Dialogue: 0,0:08:35.73,0:08:40.05,Caption,,0,0,0,,НАЙТИ РЕШЕНИЕ, КОТОРОЕ ВСЕ УЧАСТНИКИ ПРИЗНАЮТ СОБСТВЕННЫМ. ИНАЧЕ К
Dialogue: 0,0:08:40.13,0:08:44.05,Caption,,0,0,0,,МОСКВЕ ПОЕДЕТ ГРУППА, ГДЕ КАЖДЫЙ ВЕЗЁТ ОТДЕЛЬНУЮ ИНСТРУКЦИЮ И ГОТОВ
Dialogue: 0,0:08:44.05,0:08:47.33,Caption,,0,0,0,,ОБЪЯСНИТЬ, ПОЧЕМУ СОСЕДИ ВСЁ ПОНЯЛИ НЕПРАВИЛЬНО.
Dialogue: 0,0:08:49.60,0:08:51.52,Caption,,0,0,0,,ЖАЛОБА НА ДЕТСКИЙ СТОЛ ПОПАЛА В ЦЕЛЬ,
Dialogue: 0,0:08:51.77,0:08:55.76,Caption,,0,0,0,,ХОТЯ НЕ ТАК, КАК ХОТЕЛОСЬ ЕЁ АВТОРУ. МЕСТО СРЕДИ ВЗРОСЛЫХ МОЖНО
Dialogue: 0,0:08:55.76,0:08:58.96,Caption,,0,0,0,,ПОТРЕБОВАТЬ. ЕДИНУЮ ПОЗИЦИЮ ПОТРЕБОВАТЬ НЕ У КОГО.
Dialogue: 0,0:08:59.27,0:09:01.60,Caption,,0,0,0,,ОНА ВОЗНИКАЕТ ПОСЛЕ СОГЛАСОВАНИЯ ИНТЕРЕСОВ,
Dialogue: 0,0:09:01.76,0:09:04.16,Caption,,0,0,0,,А НЕ ПОСЛЕ ВЫДАЧИ КРАСИВОЙ ТАБЛИЧКИ УЧАСТНИКА.
Dialogue: 0,0:09:05.10,0:09:07.44,Caption,,0,0,0,,ДАВЛЕНИЕ НА РОССИЮ ТЕМ ВРЕМЕНЕМ ПРОДОЛЖАЕТСЯ.
Dialogue: 0,0:09:07.81,0:09:10.64,Caption,,0,0,0,,ВОЕННЫЕ ВЫСАДИЛИСЬ НА ТАНКЕР ПОД ФЛАГОМ ЗИМБАБВЕ,
Dialogue: 0,0:09:10.96,0:09:12.96,Caption,,0,0,0,,КОТОРЫЙ В БРЮССЕЛЕ СВЯЗЫВАЮТ С ПЕРЕВОЗКАМИ
Dialogue: 0,0:09:12.96,0:09:15.84,Caption,,0,0,0,,РОССИЙСКОЙ НЕФТИ. КАЛЛАС ОБЕЩАЕТ УСИЛИВАТЬ МЕРЫ
Dialogue: 0,0:09:15.92,0:09:19.12,Caption,,0,0,0,,ПРОТИВ ТАК НАЗЫВАЕМОГО ТЕНЕВОГО ФЛОТА. ГОТОВЯТСЯ
Dialogue: 0,0:09:19.12,0:09:22.32,Caption,,0,0,0,,НОВЫЕ ОГРАНИЧЕНИЯ ДЛЯ БАНКОВ И КОМПАНИЙ. ПЕРЕГОВОРЫ
Dialogue: 0,0:09:22.32,0:09:26.48,Caption,,0,0,0,,ПРИБЛИЖАЮТСЯ, НО ПРЕЖНИЕ МЕТОДЫ ОСТАЮТСЯ. ЕВРОПА ОДНОВРЕМЕННО
Dialogue: 0,0:09:26.56,0:09:29.04,Caption,,0,0,0,,ОБСУЖДАЕТ БУДУЩЕЕ И УСИЛИВАЕТ ИНСТРУМЕНТЫ
Dialogue: 0,0:09:29.04,0:09:32.08,Caption,,0,0,0,,ПРОТИВОСТОЯНИЯ. ДЛЯ ОДНИХ ГОСУДАРСТВ ЭТО УКРЕПЛЕНИЕ
Dialogue: 0,0:09:32.08,0:09:34.88,Caption,,0,0,0,,ПОЗИЦИИ ПЕРЕД РАЗГОВОРОМ. ДЛЯ ДРУГИХ ЭТО РИСК
Dialogue: 0,0:09:34.88,0:09:37.92,Caption,,0,0,0,,СДЕЛАТЬ САМ РАЗГОВОР БЕССМЫСЛЕННЫМ. ЧЕЙ БОУЗ
Dialogue: 0,0:09:37.94,0:09:40.56,Caption,,0,0,0,,ВОЗВРАЩАЕТ ИСТОРИЮ К ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМУ
Dialogue: 0,0:09:40.56,0:09:44.80,Caption,,0,0,0,,ГОДУ. ОН НАПОМИНАЕТ, ЧТО РОССИЙСКИЕ ТРЕБОВАНИЯ В СФЕРЕ БЕЗОПАСНОСТИ
Dialogue: 0,0:09:44.89,0:09:48.32,Caption,,0,0,0,,ОБСУЖДАЛИСЬ УЖЕ ТОГДА. ЕВРОПА ВЫБРАЛА ИНОЙ ПУТЬ,
Dialogue: 0,0:09:48.56,0:09:53.36,Caption,,0,0,0,,КОНФЛИКТ СТАЛ ГЛУБЖЕ, А УСЛОВИЯ МОСКВЫ ОКАЗАЛИСЬ ЖЁСТЧЕ. КАЯ КАЛЛАС В
Dialogue: 0,0:09:53.44,0:09:55.92,Caption,,0,0,0,,ТОТ ПЕРИОД ВЫСТУПАЛА ПРОТИВ ПОЛНОЦЕННОЙ ВСТРЕЧИ
Dialogue: 0,0:09:55.92,0:10:00.16,Caption,,0,0,0,,ЕВРОСОЮЗА С РОССИЕЙ, ПОКА МОСКВА НЕ ВЫПОЛНИТ ПРЕДВАРИТЕЛЬНЫЕ УСЛОВИЯ.
Dialogue: 0,0:10:00.56,0:10:02.96,Caption,,0,0,0,,НЫНЕШНИЙ ТУПИК НЕ СВАЛИЛСЯ С ЯСНОГО НЕБА.
Dialogue: 0,0:10:05.25,0:10:09.97,Caption,,0,0,0,,ЕГО ВЫРАЩИВАЛИ РЕШЕНИЯМИ, ПРИ КОТОРЫХ РАЗГОВОР РАЗРЕШАЛСЯ ЛИШЬ ПОСЛЕ СОГЛАСИЯ
Dialogue: 0,0:10:10.05,0:10:12.13,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ С ТРЕБУЕМЫМ РЕЗУЛЬТАТОМ.
Dialogue: 0,0:10:12.90,0:10:15.01,Caption,,0,0,0,,МНОГО ЛЕТ БРЮССЕЛЮ НЕ ПРИХОДИЛОСЬ ПОДРОБНО
Dialogue: 0,0:10:15.01,0:10:18.53,Caption,,0,0,0,,ОБЪЯСНЯТЬ, КАКИМИ ДОЛЖНЫ СТАТЬ ОТНОШЕНИЯ С РОССИЕЙ ПОСЛЕ
Dialogue: 0,0:10:18.53,0:10:21.49,Caption,,0,0,0,,КОНФЛИКТА. ГЛАВНОЙ ЗАДАЧЕЙ БЫЛО ПРОТИВОСТОЯНИЕ,
Dialogue: 0,0:10:21.72,0:10:23.73,Caption,,0,0,0,,И ЭТОГО ХВАТАЛО ДЛЯ ВНЕШНЕГО ЕДИНСТВА.
Dialogue: 0,0:10:24.35,0:10:26.77,Caption,,0,0,0,,ТЕПЕРЬ ВОПРОС О БУДУЩЕМ ПРИШЁЛ САМ И СЕЛ
Dialogue: 0,0:10:26.85,0:10:29.89,Caption,,0,0,0,,БЕЗ ПРИГЛАШЕНИЯ. У ГЕРМАНИИ, ФРАНЦИИ,
Dialogue: 0,0:10:29.96,0:10:33.41,Caption,,0,0,0,,ПОЛЬШИ, ИТАЛИИ, ВЕНГРИИ, ИСПАНИИ,
Dialogue: 0,0:10:33.58,0:10:37.97,Caption,,0,0,0,,АВСТРИИ, ВЕЛИКОБРИТАНИИ И ЕВРОПЕЙСКИХ ИНСТИТУТОВ НЕТ ОДНОГО
Dialogue: 0,0:10:37.97,0:10:42.29,Caption,,0,0,0,,ОТВЕТА. НЕЯСНО И ТО, КТО ВПРАВЕ СФОРМУЛИРОВАТЬ ЕГО ОТ ИМЕНИ ОСТАЛЬНЫХ.
Dialogue: 0,0:10:42.72,0:10:45.89,Caption,,0,0,0,,ПОЭТОМУ СПОР О ДЕЛЕГАЦИИ ВАЖНЕЕ ОБЫЧНОЙ ССОРЫ ИЗ
Dialogue: 0,0:10:45.97,0:10:49.25,Caption,,0,0,0,,ЗА МЕСТ. ОН ПОКАЗЫВАЕТ ПРОЧНОСТЬ ВСЕЙ КОНСТРУКЦИИ,
Dialogue: 0,0:10:49.49,0:10:51.81,Caption,,0,0,0,,КОГДА ИСЧЕЗАЕТ КОМАНДА ВЫСТУПАТЬ ПРОТИВ ОДНОГО
Dialogue: 0,0:10:51.81,0:10:54.93,Caption,,0,0,0,,ПРОТИВНИКА. ГОДАМИ МОЖНО ОТКЛАДЫВАТЬ РАЗГОВОР О
Dialogue: 0,0:10:54.93,0:10:58.29,Caption,,0,0,0,,РАСПРЕДЕЛЕНИИ СИЛЫ ВНУТРИ ЕВРОПЫ. МИР ТАКОЙ ОТСРОЧКИ
Dialogue: 0,0:10:58.29,0:11:01.09,Caption,,0,0,0,,НЕ ДАЁТ. КТО РУКОВОДИТ КОНТИНЕНТОМ И ПРИНИМАЕТ
Dialogue: 0,0:11:01.09,0:11:05.01,Caption,,0,0,0,,ОКОНЧАТЕЛЬНЫЕ РЕШЕНИЯ? ПОЧЕМУ НАЦИОНАЛЬНЫЕ ИНТЕРЕСЫ ДОЛЖНЫ УСТУПАТЬ
Dialogue: 0,0:11:05.01,0:11:08.69,Caption,,0,0,0,,БРЮССЕЛЬСКИМ? КАКОЕ МЕСТО ОСТАЁТСЯ ВЕЛИКОБРИТАНИИ ПОСЛЕ ВЫХОДА ИЗ
Dialogue: 0,0:11:08.69,0:11:12.77,Caption,,0,0,0,,ЕВРОСОЮЗА? ГОТОВЫ ЛИ ГЕРМАНИЯ И ФРАНЦИЯ ЖЕРТВОВАТЬ ВЫГОДАМИ?
Dialogue: 0,0:11:13.15,0:11:15.81,Caption,,0,0,0,,МОЖНО ЛИ ЗАСТАВИТЬ НЕСОГЛАСНЫЕ СТРАНЫ СЛЕДОВАТЬ
Dialogue: 0,0:11:15.81,0:11:19.57,Caption,,0,0,0,,ОБЩЕЙ ЛИНИИ? КТО ЗАПЛАТИТ ЗА ПОСЛЕДСТВИЯ И ОБЪЯВИТ СЕБЯ
Dialogue: 0,0:11:19.57,0:11:24.09,Caption,,0,0,0,,ПОБЕДИТЕЛЕМ? ПОКА ЕСТЬ ОБЩИЙ ПРОТИВНИК,
Dialogue: 0,0:11:24.24,0:11:27.45,Caption,,0,0,0,,НА ЭТИ ВОПРОСЫ УДОБНО ОТВЕЧАТЬ ОБЩИМИ СЛОВАМИ. КОГДА
Dialogue: 0,0:11:27.45,0:11:31.05,Caption,,0,0,0,,НАЧИНАЕТСЯ УСТРОЙСТВО МИРА, КАЖДОЕ СЛОВО ТРЕБУЕТ СУММЫ,
Dialogue: 0,0:11:31.21,0:11:36.01,Caption,,0,0,0,,ПОЛНОМОЧИЙ И ПОДПИСИ. ВОТ ТУТ ЕВРОПЕЙСКОЕ ЕДИНСТВО ПЕРЕСТАЁТ БЫТЬ КРАСИВОЙ
Dialogue: 0,0:11:36.09,0:11:39.29,Caption,,0,0,0,,ПОЗОЙ ДЛЯ ОБЩЕЙ ФОТОГРАФИИ. ЕВРОПА ДОЛГО ДОБИВАЛАСЬ
Dialogue: 0,0:11:39.29,0:11:42.09,Caption,,0,0,0,,УЧАСТИЯ В РАЗГОВОРЕ С РОССИЕЙ. КОГДА ВОЗМОЖНОСТЬ
Dialogue: 0,0:11:42.09,0:11:46.89,Caption,,0,0,0,,ПРИБЛИЗИЛАСЬ, ВЫЯСНИЛОСЬ, ЧТО ПЕРВЫМ СОБЕСЕДНИКОМ ЕВРОПЫ ДОЛЖНА СТАТЬ САМА
Dialogue: 0,0:11:46.97,0:11:49.85,Caption,,0,0,0,,ЕВРОПА. И ЭТА ВСТРЕЧА МОЖЕТ ЗАТЯНУТЬСЯ СИЛЬНЕЕ
Dialogue: 0,0:11:49.93,0:11:53.13,Caption,,0,0,0,,ОСНОВНОЙ. ДОГОВОРИТЬСЯ, КОМУ ПРОТИВОСТОЯТЬ,
Dialogue: 0,0:11:53.21,0:11:55.61,Caption,,0,0,0,,СРАВНИТЕЛЬНО ЛЕГКО. ДОГОВОРИТЬСЯ,
Dialogue: 0,0:11:55.69,0:11:59.85,Caption,,0,0,0,,КАКИМ БУДЕТ МИР, КТО ИМ РАСПОРЯДИТСЯ И СКОЛЬКО ЗА НЕГО ЗАПЛАТИТ,
Dialogue: 0,0:12:00.09,0:12:03.29,Caption,,0,0,0,,НАМНОГО ТРУДНЕЕ. ТАК ЧТО СПОР О КОЛИЧЕСТВЕ СТУЛЬЕВ
Dialogue: 0,0:12:03.29,0:12:06.65,Caption,,0,0,0,,ЛИШЬ ОТКРЫВАЕТ ПРЕДСТАВЛЕНИЕ. ГЛАВНЫЙ ВОПРОС НЕ В ТОМ,
Dialogue: 0,0:12:06.79,0:12:09.77,Caption,,0,0,0,,ПОСАДЯТ ЛИ ЕВРОПЕЙЦЕВ ЗА БОЛЬШОЙ СТОЛ. СУМЕЮТ ЛИ
Dialogue: 0,0:12:09.77,0:12:11.85,Caption,,0,0,0,,ОНИ ПРОИЗНЕСТИ ЗА НИМ ОДНУ ПОЗИЦИЮ,
Dialogue: 0,0:12:12.17,0:12:14.81,Caption,,0,0,0,,НЕ ПЕРЕБИВАЯ ДРУГ ДРУГА УЖЕ НА ПЕРВОМ ПРЕДЛОЖЕНИИ?
