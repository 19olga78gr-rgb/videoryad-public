Dialogue: 0,0:00:00.12,0:00:03.24,Caption,,0,0,0,,МНЕ ВОТ ИНТЕРЕСНО, А АМЕРИКАНЦЫ САМИ ДОВОЛЬНЫ ТЕМ,
Dialogue: 0,0:00:03.42,0:00:05.30,Caption,,0,0,0,,ЧТО РЕШИЛИ ПОДКЛЮЧИТЬ ЕВРОПЕЙЦЕВ К
Dialogue: 0,0:00:05.30,0:00:07.88,Caption,,0,0,0,,ПЕРЕГОВОРАМ? ХОТЕЛИ, КАК ГОВОРИТСЯ,
Dialogue: 0,0:00:08.04,0:00:10.12,Caption,,0,0,0,,ОБЛЕГЧИТЬ СЕБЕ РАБОТУ. НУ ЧТО,
Dialogue: 0,0:00:10.20,0:00:13.15,Caption,,0,0,0,,ОБЛЕГЧИЛИ? ТЕПЕРЬ ПОПРОБУЙТЕ ДОГОВОРИТЬСЯ ЕЩЁ И С
Dialogue: 0,0:00:13.15,0:00:15.77,Caption,,0,0,0,,ЭТИМИ ТОВАРИЩАМИ. ПРИЧЁМ ОДНИМИ ЕВРОПЕЙЦАМИ
Dialogue: 0,0:00:15.77,0:00:18.95,Caption,,0,0,0,,ГОЛОВНАЯ БОЛЬ АМЕРИКАНЦЕВ ДАЛЕКО НЕ ОГРАНИЧИВАЕТСЯ.
Dialogue: 0,0:00:18.95,0:00:22.30,Caption,,0,0,0,,КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ, КОГДА МЫ НЕ ПРОСТО ПЕРЕСКАЗЫВАЕМ
Dialogue: 0,0:00:22.30,0:00:25.08,Caption,,0,0,0,,НОВОСТИ, А ПЫТАЕМСЯ ПОНЯТЬ, ЧТО ЗА НИМИ СТОИТ,
Dialogue: 0,0:00:25.26,0:00:27.59,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ЗДЕСЬ КАК РАЗ
Dialogue: 0,0:00:27.59,0:00:30.76,Caption,,0,0,0,,ТОТ СЛУЧАЙ, КОГДА ОФИЦИАЛЬНЫЕ ЗАЯВЛЕНИЯ ОТДЕЛЬНО,
Dialogue: 0,0:00:31.02,0:00:34.60,Caption,,0,0,0,,А ЛОГИКА ПРОИСХОДЯЩЕГО ВООБЩЕ ОТДЕЛЬНО. УРСУЛА ФОН
Dialogue: 0,0:00:34.60,0:00:36.50,Caption,,0,0,0,,ДЕР ЛЯЙЕН РЕШИЛА СРАЗУ ОБЪЯСНИТЬ
Dialogue: 0,0:00:36.50,0:00:39.31,Caption,,0,0,0,,МОСКВЕ, КАК ИМЕННО НАДО ДОКАЗЫВАТЬ СЕРЬЁЗНОСТЬ
Dialogue: 0,0:00:39.31,0:00:43.61,Caption,,0,0,0,,НАМЕРЕНИЙ. РОССИЯ, ГОВОРИТ, ДОЛЖНА СОГЛАСИТЬСЯ НА ПРЕКРАЩЕНИЕ
Dialogue: 0,0:00:43.61,0:00:46.39,Caption,,0,0,0,,УДАРОВ ПО ЭНЕРГЕТИЧЕСКОЙ ИНФРАСТРУКТУРЕ НА ВСЮ
Dialogue: 0,0:00:46.39,0:00:49.63,Caption,,0,0,0,,ЗИМУ. КРОМЕ ТОГО, НУЖНО ОБЕСПЕЧИТЬ БЕЗОПАСНЫЙ ПРОХОД
Dialogue: 0,0:00:49.63,0:00:52.73,Caption,,0,0,0,,СУДОВ С ПРОДОВОЛЬСТВИЕМ ЧЕРЕЗ ЧЁРНОЕ МОРЕ. ВОТ
Dialogue: 0,0:00:52.73,0:00:55.56,Caption,,0,0,0,,ТОГДА, ДЕСКАТЬ, МОЖНО БУДЕТ ГОВОРИТЬ О ТОМ,
Dialogue: 0,0:00:55.72,0:00:57.52,Caption,,0,0,0,,ЧТО МОСКВА ДЕЙСТВИТЕЛЬНО СЕРЬЁЗНО
Dialogue: 0,0:00:57.52,0:01:00.63,Caption,,0,0,0,,ОТНОСИТСЯ К ПЕРЕГОВОРАМ. НУ ПРЕКРАСНО. ТО ЕСТЬ
Dialogue: 0,0:01:00.63,0:01:03.32,Caption,,0,0,0,,СХЕМА ТАКАЯ. ЕСЛИ ВЫ ХОТИТЕ СО МНОЙ ПОГОВОРИТЬ,
Dialogue: 0,0:01:03.64,0:01:05.85,Caption,,0,0,0,,СНАЧАЛА ВЫПОЛНИТЕ МОИ УСЛОВИЯ. ИНАЧЕ Я
Dialogue: 0,0:01:05.85,0:01:08.36,Caption,,0,0,0,,С ВАМИ ЗА СТОЛ НЕ СЯДУ. У МЕНЯ ЗДЕСЬ ОДИН
Dialogue: 0,0:01:08.36,0:01:10.78,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС. КТО ВООБЩЕ ТЕБЕ ВНУШИЛ
Dialogue: 0,0:01:10.78,0:01:13.16,Caption,,0,0,0,,В ТВОЙ МОЗГ, ЧТО С ТОБОЙ ХОТЯТ ГОВОРИТЬ?
Dialogue: 0,0:01:15.43,0:01:18.33,Caption,,0,0,0,,ТУТ ДЛЯ НАЧАЛА БЫ ПОНЯТЬ, ЕСТЬ ЛИ СМЫСЛ ВООБЩЕ С ТОБОЙ
Dialogue: 0,0:01:18.33,0:01:20.63,Caption,,0,0,0,,РАЗГОВАРИВАТЬ? СПОСОБЕН ЛИ ТЫ ВООБЩЕ ГОВОРИТЬ?
Dialogue: 0,0:01:20.95,0:01:22.63,Caption,,0,0,0,,ПОТОМУ ЧТО ЛАВРОВ КАК РАЗ ОБЪЯСНЯЕТ
Dialogue: 0,0:01:22.63,0:01:25.03,Caption,,0,0,0,,СОВЕРШЕННО ДРУГУЮ ЛОГИКУ. РОССИЯ,
Dialogue: 0,0:01:25.11,0:01:27.35,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, СНАЧАЛА ХОЧЕТ ПОНЯТЬ,
Dialogue: 0,0:01:27.59,0:01:29.61,Caption,,0,0,0,,КАКУЮ РОЛЬ ЕВРОПА ВООБЩЕ СОБИРАЕТСЯ
Dialogue: 0,0:01:29.61,0:01:32.57,Caption,,0,0,0,,ИГРАТЬ В ПЕРЕГОВОРАХ И С ЧЕМ ОНА ТУДА ПРИХОДИТ.
Dialogue: 0,0:01:32.57,0:01:34.86,Caption,,0,0,0,,И ВЕДЬ ЭТО НЕ ПРИДИРКА К ЦВЕТУ ГАЛСТУКА.
Dialogue: 0,0:01:34.86,0:01:37.98,Caption,,0,0,0,,МОСКВА, ПО СЛОВАМ ЛАВРОВА, ВООБЩЕ НЕ ВЕЛА ПЕРЕГОВОРОВ С
Dialogue: 0,0:01:37.98,0:01:41.08,Caption,,0,0,0,,ЕВРОКОМИССИЕЙ ПО УКРАИНСКОМУ ВОПРОСУ. А ЕВРОПЕЙЦЫ УЖЕ
Dialogue: 0,0:01:41.08,0:01:43.35,Caption,,0,0,0,,СОБРАЛИ ЦЕЛУЮ КОМАНДУ. ФРАНЦИЯ,
Dialogue: 0,0:01:43.43,0:01:46.07,Caption,,0,0,0,,ГЕРМАНИЯ, БРИТАНИЯ, ИТАЛИЯ,
Dialogue: 0,0:01:46.16,0:01:50.74,Caption,,0,0,0,,ПОЛЬША, ЕВРОСОЮЗ, НАТО. ЛАВРОВ ДАЖЕ ПОСЧИТАЛ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:01:50.74,0:01:54.47,Caption,,0,0,0,,УЖЕ НЕ ПЯТЁРКА, А СЕМЁРКА. СЕМЬ ЧЕЛОВЕК ЕЩЁ НЕ ПРИШЛИ,
Dialogue: 0,0:01:54.71,0:01:57.14,Caption,,0,0,0,,НО СПИСОК ТРЕБОВАНИЙ УЖЕ ПРИНЕСЛИ.
Dialogue: 0,0:01:57.14,0:01:59.80,Caption,,0,0,0,,КРАСОТА. САМ ЛАВРОВ ОПИСАЛ ПЕРСПЕКТИВУ СОВСЕМ
Dialogue: 0,0:01:59.80,0:02:03.11,Caption,,0,0,0,,ПРОСТО. С ТАКИМИ МАНЕРАМИ ЕВРОПА СЯДЕТ ЗА СТОЛ И ТУТ ЖЕ
Dialogue: 0,0:02:03.11,0:02:05.06,Caption,,0,0,0,,ПОЛОЖИТ НОГИ НА ЭТОТ СТОЛ. И ВЕДЬ
Dialogue: 0,0:02:05.06,0:02:07.67,Caption,,0,0,0,,ЗДЕСЬ САМОЕ ЗАБАВНОЕ В ДРУГОМ. ЕВРОПЕЙЦЕВ
Dialogue: 0,0:02:07.67,0:02:10.05,Caption,,0,0,0,,ВООБЩЕ ПРИГЛАСИЛИ ИЗЛОЖИТЬ СВОЮ ПОЗИЦИЮ.
Dialogue: 0,0:02:10.05,0:02:13.49,Caption,,0,0,0,,УШАКОВ ГОВОРИТ, ЧТО ПРЯМОГО ОТКАЗА МОСКВА НЕ ПОЛУЧАЛА.
Dialogue: 0,0:02:13.49,0:02:16.07,Caption,,0,0,0,,ПУБЛИЧНО ЗВУЧИТ ОДНО, А ПО ДРУГИМ КАНАЛАМ,
Dialogue: 0,0:02:16.14,0:02:19.44,Caption,,0,0,0,,ВКЛЮЧАЯ ТЕЛЕФОННЫЕ, ИДУТ КАКИЕ ТО СИГНАЛЫ. ПРИГЛАШЕНИЕ
Dialogue: 0,0:02:19.44,0:02:22.23,Caption,,0,0,0,,ОСТАЁТСЯ В СИЛЕ. ТО ЕСТЬ ВАМ ГОВОРЯТ ПРИЕЗЖАЙТЕ,
Dialogue: 0,0:02:22.39,0:02:25.57,Caption,,0,0,0,,ОБЪЯСНИТЕ, ЧЕГО ВЫ ХОТИТЕ. ОТВЕТ ПРИМЕРНО ТАКОЙ
Dialogue: 0,0:02:25.57,0:02:28.03,Caption,,0,0,0,,НЕТ, ОБЪЯСНЯТЬ ЗАРАНЕЕ НИЧЕГО НЕ БУДЕМ. МЫ
Dialogue: 0,0:02:28.03,0:02:33.73,Caption,,0,0,0,,СРАЗУ ПРИДЁМ НА ПЕРЕГОВОРЫ. НО ПЕРЕД ЭТИМ ВЫ ЕЩЁ ВЫПОЛНИТЕ НАШИ
Dialogue: 0,0:02:33.73,0:02:36.03,Caption,,0,0,0,,УСЛОВИЯ. НУ А КАК С ВАМИ ТОГДА РАЗГОВАРИВАТЬ?
Dialogue: 0,0:02:36.35,0:02:38.20,Caption,,0,0,0,,РЯБКОВ ТОЖЕ ПРОШЁЛСЯ ПО ЭТОЙ ЛОГИКЕ
Dialogue: 0,0:02:38.20,0:02:40.59,Caption,,0,0,0,,ДОВОЛЬНО ПРЯМО. ПЕРЕГОВОРЫ РОССИИ,
Dialogue: 0,0:02:40.73,0:02:44.57,Caption,,0,0,0,,США И УКРАИНЫ, ГОВОРИТ ОН, НЕ ОСТАНОВИЛИСЬ. МОСКВА ГОТОВА
Dialogue: 0,0:02:44.57,0:02:48.31,Caption,,0,0,0,,ПРОДОЛЖАТЬ В ТОМ ФОРМАТЕ, КОТОРЫЙ УЖЕ ИСПОЛЬЗОВАЛСЯ В АБУ ДАБИ
Dialogue: 0,0:02:48.31,0:02:50.88,Caption,,0,0,0,,ДЕСЯТОГО И ОДИННАДЦАТОГО НОЯБРЯ. НО КОГДА БУДЕТ
Dialogue: 0,0:02:50.88,0:02:53.88,Caption,,0,0,0,,СЛЕДУЮЩИЙ РАУНД, ПОНИМАНИЯ НЕТ. И ОТДЕЛЬНО РЯБКОВ
Dialogue: 0,0:02:53.88,0:02:56.41,Caption,,0,0,0,,ГОВОРИТ О ЕВРОПЕЙЦАХ. ЕСЛИ ОНИ НАЧИНАЮТ С
Dialogue: 0,0:02:56.41,0:02:59.99,Caption,,0,0,0,,ВЫДВИЖЕНИЯ УСЛОВИЙ, ОНИ САМИ ОБНУЛЯЮТ СВОИ ШАНСЫ НА
Dialogue: 0,0:02:59.99,0:03:03.15,Caption,,0,0,0,,ДИАЛОГ. ПРИ ЭТОМ КОНТАКТЫ РОССИИ И США ПО ВЗАИМНЫМ
Dialogue: 0,0:03:03.15,0:03:07.44,Caption,,0,0,0,,РАЗДРАЖИТЕЛЯМ, ПО ЕГО СЛОВАМ, ПРОДОЛЖАТСЯ ДО КОНЦА ГОДА. ВОТ ВАМ И
Dialogue: 0,0:03:07.44,0:03:09.80,Caption,,0,0,0,,ВСЯ МАГИЯ. ЕВРОПА ХОТЕЛА ВНЕДРИТЬСЯ В
Dialogue: 0,0:03:09.80,0:03:12.83,Caption,,0,0,0,,ПЕРЕГОВОРНЫЙ ПРОЦЕСС. КУШНЕР, СУДЯ ПО ВСЕМУ,
Dialogue: 0,0:03:12.91,0:03:15.18,Caption,,0,0,0,,ПОМОГ ЭТУ ДВЕРЬ ОТКРЫТЬ. А ТЕПЕРЬ ЕМУ
Dialogue: 0,0:03:15.18,0:03:16.75,Caption,,0,0,0,,САМОМУ ПРИХОДИТСЯ РАЗБИРАТЬСЯ,
Dialogue: 0,0:03:16.91,0:03:20.11,Caption,,0,0,0,,ЧТО ДЕЛАТЬ С ЛЮДЬМИ, КОТОРЫЕ В КОМНАТУ ЕЩЁ НЕ ВОШЛИ,
Dialogue: 0,0:03:20.35,0:03:24.14,Caption,,0,0,0,,НО УЖЕ РАССКАЗЫВАЮТ ХОЗЯЕВАМ, ГДЕ ДОЛЖНА СТОЯТЬ МЕБЕЛЬ. ПРИЧЁМ
Dialogue: 0,0:03:24.14,0:03:27.96,Caption,,0,0,0,,ПРОБЛЕМА ЗДЕСЬ ГЛУБЖЕ, ЧЕМ ОДНА УРСУЛА. ЕВРОПЕЙЦЫ НЕ ХОТЯТ
Dialogue: 0,0:03:27.96,0:03:30.61,Caption,,0,0,0,,ОТДЕЛЯТЬ УКРАИНСКИЙ ВОПРОС ОТ ВСЕЙ КОНСТРУКЦИИ
Dialogue: 0,0:03:30.61,0:03:33.19,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. А МОСКВА КАК РАЗ
Dialogue: 0,0:03:33.19,0:03:36.20,Caption,,0,0,0,,СЧИТАЕТ, ЧТО ЭТИ ВЕЩИ СВЯЗАНЫ НАПРЯМУЮ И ХОЧЕТ
Dialogue: 0,0:03:36.20,0:03:38.44,Caption,,0,0,0,,ПОНИМАТЬ, ЧТО ЕВРОПА ВООБЩЕ СОБИРАЕТСЯ
Dialogue: 0,0:03:38.44,0:03:43.22,Caption,,0,0,0,,ОБСУЖДАТЬ. ЕСЛИ ОДНА СТОРОНА ПРИХОДИТ ОБСУЖДАТЬ
Dialogue: 0,0:03:43.22,0:03:46.20,Caption,,0,0,0,,СИСТЕМУ БЕЗОПАСНОСТИ, А ДРУГАЯ ПРИХОДИТ С ЗАРАНЕЕ
Dialogue: 0,0:03:46.20,0:03:50.09,Caption,,0,0,0,,ВЫПИСАННЫМИ ТРЕБОВАНИЯМИ, ЭТО НЕ УСКОРЕНИЕ ПЕРЕГОВОРОВ. ЭТО ЕЩЁ
Dialogue: 0,0:03:50.09,0:03:53.74,Caption,,0,0,0,,ОДИН ТОРМОЗ. НО ДАЛЬШЕ СТАНОВИТСЯ ЕЩЁ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:03:53.74,0:03:55.88,Caption,,0,0,0,,ЛУКАШЕНКО НЕОЖИДАННО ЗАГОВОРИЛ УЖЕ НЕ О
Dialogue: 0,0:03:55.88,0:03:59.05,Caption,,0,0,0,,ЗАЯВЛЕНИЯХ, А О ВПОЛНЕ КОНКРЕТНОМ ОРУЖИИ. ЕГО
Dialogue: 0,0:03:59.05,0:04:01.72,Caption,,0,0,0,,СПРОСИЛИ, ГОТОВА ЛИ БЕЛОРУССИЯ ПОЙТИ НА ВЫВОД
Dialogue: 0,0:04:01.72,0:04:04.07,Caption,,0,0,0,,РОССИЙСКОГО ВООРУЖЕНИЯ, ЕСЛИ ЗАПАД,
Dialogue: 0,0:04:04.15,0:04:07.06,Caption,,0,0,0,,В СВОЮ ОЧЕРЕДЬ, ОБЯЗУЕТСЯ НЕ ПРИБЛИЖАТЬ РАКЕТЫ И
Dialogue: 0,0:04:07.06,0:04:10.34,Caption,,0,0,0,,ЯДЕРНОЕ ОРУЖИЕ К РОССИЙСКИМ ГРАНИЦАМ. И ЛУКАШЕНКО ТАКОЙ
Dialogue: 0,0:04:10.34,0:04:13.03,Caption,,0,0,0,,ВАРИАНТ НЕ ОТВЕРГ. ГЛАВНОЕ, ГОВОРИТ,
Dialogue: 0,0:04:13.11,0:04:17.35,Caption,,0,0,0,,ЧТОБЫ БЫЛ МИР. КАКОЕ ОРУЖИЕ, КТО И КУДА БУДЕТ ВЫВОДИТЬ,
Dialogue: 0,0:04:17.59,0:04:19.62,Caption,,0,0,0,,ЭТО УЖЕ МОЖЕТ СТАТЬ ЧАСТЬЮ САМОГО
Dialogue: 0,0:04:19.62,0:04:21.97,Caption,,0,0,0,,РЕШЕНИЯ. А ВЕДЬ В БЕЛОРУССИИ УЖЕ СТОИТ НА БОЕВОМ
Dialogue: 0,0:04:21.97,0:04:26.13,Caption,,0,0,0,,ДЕЖУРСТВЕ КОМПЛЕКС "ОРЕШНИК", СПОСОБНЫЙ НЕСТИ ЯДЕРНЫЙ ЗАРЯД. ЕСТЬ И
Dialogue: 0,0:04:26.13,0:04:28.98,Caption,,0,0,0,,"ИСКАНДЕР М" С АНАЛОГИЧНЫМИ ВОЗМОЖНОСТЯМИ. ТО ЕСТЬ
Dialogue: 0,0:04:28.98,0:04:31.99,Caption,,0,0,0,,МЫ УЖЕ ГОВОРИМ НЕ ПРОСТО О КРАСИВЫХ ФОРМУЛИРОВКАХ ПРО
Dialogue: 0,0:04:31.99,0:04:36.17,Caption,,0,0,0,,МИР. МЫ ГОВОРИМ О ТОМ, КТО, КУДА И НАСКОЛЬКО ДАЛЕКО ОТОДВИНЕТ
Dialogue: 0,0:04:36.17,0:04:39.23,Caption,,0,0,0,,ВПОЛНЕ РЕАЛЬНЫЕ РАКЕТЫ. И ВОТ ТУТ СРАЗУ ВОЗНИКАЕТ
Dialogue: 0,0:04:39.23,0:04:41.67,Caption,,0,0,0,,ВОПРОС, КОТОРЫЙ НАМНОГО СЕРЬЁЗНЕЕ ВСЕХ
Dialogue: 0,0:04:41.67,0:04:44.71,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ДЕКЛАРАЦИЙ. ХОРОШО. ДОПУСТИМ,
Dialogue: 0,0:04:44.85,0:04:47.19,Caption,,0,0,0,,ДОГОВОРИЛИСЬ. РОССИЯ ЧТО ТО ВЫВЕЛА.
Dialogue: 0,0:04:47.19,0:04:50.39,Caption,,0,0,0,,ЗАПАД ЧТО ТО ПООБЕЩАЛ НЕ РАЗМЕЩАТЬ. А ДАЛЬШЕ ЧТО?
Dialogue: 0,0:04:52.66,0:04:55.61,Caption,,0,0,0,,КТО ГАРАНТИРУЕТ, ЧТО ЧЕРЕЗ ПАРУ ЛЕТ КТО НИБУДЬ НЕ
Dialogue: 0,0:04:55.61,0:04:57.38,Caption,,0,0,0,,СКАЖЕТ ОБСТОЯТЕЛЬСТВА ИЗМЕНИЛИСЬ,
Dialogue: 0,0:04:57.62,0:05:00.90,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА ПОМЕНЯЛИСЬ, ДОГОВОР БЫЛ ПРИ ДРУГИХ ЛЮДЯХ,
Dialogue: 0,0:05:01.07,0:05:03.54,Caption,,0,0,0,,ТЕПЕРЬ У НАС НОВОЕ ПОНИМАНИЕ БЕЗОПАСНОСТИ?
Dialogue: 0,0:05:04.06,0:05:05.93,Caption,,0,0,0,,ВОТ ЗДЕСЬ И НАЧИНАЕТСЯ НАСТОЯЩАЯ
Dialogue: 0,0:05:05.93,0:05:09.05,Caption,,0,0,0,,ПРОБЛЕМА ЛЮБОЙ БОЛЬШОЙ СДЕЛКИ. НЕ КАК ПОДПИСАТЬ
Dialogue: 0,0:05:09.05,0:05:13.07,Caption,,0,0,0,,БУМАГУ. КАК СДЕЛАТЬ ТАК, ЧТОБЫ ЕЁ БЫЛО НЕВЫГОДНО НАРУШАТЬ.
Dialogue: 0,0:05:13.07,0:05:15.54,Caption,,0,0,0,,КУШНЕР НА ЭТОМ ФОНЕ ГОВОРИТ ВООБЩЕ ВЕЩИ,
Dialogue: 0,0:05:15.79,0:05:17.47,Caption,,0,0,0,,КОТОРЫЕ ЕЩЁ НЕКОТОРОЕ ВРЕМЯ НАЗАД
Dialogue: 0,0:05:17.47,0:05:19.79,Caption,,0,0,0,,ЗВУЧАЛИ БЫ СОВСЕМ ИНАЧЕ. ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:05:20.11,0:05:22.23,Caption,,0,0,0,,КОНФЛИКТ УЖЕ ПРЕВРАТИЛСЯ В ПРОКСИ
Dialogue: 0,0:05:22.23,0:05:25.29,Caption,,0,0,0,,ВОЙНУ. ЕВРОПА ФИНАНСИРУЕТ И ВООРУЖАЕТ УКРАИНУ ПРОТИВ
Dialogue: 0,0:05:25.29,0:05:27.62,Caption,,0,0,0,,РОССИИ. ДОСТАТОЧНО НЕБОЛЬШОЙ ОШИБКИ В
Dialogue: 0,0:05:27.62,0:05:30.40,Caption,,0,0,0,,РАСЧЁТАХ, ЧТОБЫ ПОЛУЧИТЬ НАМНОГО БОЛЕЕ КРУПНУЮ
Dialogue: 0,0:05:30.40,0:05:32.82,Caption,,0,0,0,,ЭСКАЛАЦИЮ. ПРИ ЭТОМ КУШНЕР ОТДЕЛЬНО ГОВОРИТ,
Dialogue: 0,0:05:33.04,0:05:34.71,Caption,,0,0,0,,ЧТО ПУТИН ЗАВЕРЯЛ АМЕРИКАНЦЕВ В
Dialogue: 0,0:05:34.71,0:05:38.20,Caption,,0,0,0,,ОТСУТСТВИИ НАМЕРЕНИЯ ПРИМЕНЯТЬ ЯДЕРНОЕ ОРУЖИЕ. ВОТ ЭТА
Dialogue: 0,0:05:38.20,0:05:41.14,Caption,,0,0,0,,СВЯЗКА ВАЖНЕЕ, ЧЕМ КАЖЕТСЯ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:05:41.35,0:05:43.52,Caption,,0,0,0,,ИДЁТ НАРАЩИВАНИЕ ОБЫЧНЫХ ВООРУЖЕНИЙ И
Dialogue: 0,0:05:43.52,0:05:46.26,Caption,,0,0,0,,ПОСТОЯННОЕ ПОВЫШЕНИЕ СТАВОК. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:05:46.50,0:05:48.47,Caption,,0,0,0,,СТОРОНЫ ПЫТАЮТСЯ ПОСТАВИТЬ ХОТЯ БЫ
Dialogue: 0,0:05:48.47,0:05:51.41,Caption,,0,0,0,,ЯДЕРНУЮ ЧАСТЬ КОНФЛИКТА В КАКИЕ ТО РАМКИ. И ЗДЕСЬ
Dialogue: 0,0:05:51.41,0:05:53.93,Caption,,0,0,0,,ХОРОШО ВИДЕН СМЫСЛ ВСЕЙ КОНСТРУКЦИИ С ЯДЕРНЫМ
Dialogue: 0,0:05:53.93,0:05:57.78,Caption,,0,0,0,,СДЕРЖИВАНИЕМ. НЕ В ТОМ, ЧТО КТО ТО КОМУ ТО ПОВЕРИЛ НА СЛОВО.
Dialogue: 0,0:05:58.18,0:06:01.28,Caption,,0,0,0,,СМЫСЛ В ТОМ, ЧТОБЫ СОЗДАТЬ ТАКУЮ ЦЕНУ НАРУШЕНИЯ
Dialogue: 0,0:06:01.28,0:06:04.26,Caption,,0,0,0,,ДОГОВОРЁННОСТИ, ПРИ КОТОРОЙ НАРУШАТЬ ЕЁ СТАНОВИТСЯ
Dialogue: 0,0:06:04.26,0:06:09.23,Caption,,0,0,0,,ПРОСТО НЕВЫГОДНО. ПОТОМУ ЧТО НАДЕЖДА НА ДОБРУЮ ВОЛЮ В
Dialogue: 0,0:06:09.23,0:06:11.76,Caption,,0,0,0,,БОЛЬШОЙ ПОЛИТИКЕ ВООБЩЕ ВЕЩЬ ДОРОГАЯ. ЕСТЬ
Dialogue: 0,0:06:11.76,0:06:14.97,Caption,,0,0,0,,ДОВОЛЬНО ЖЁСТКАЯ МЫСЛЬ. ЗАПАДНЫЕ ПОЛИТИКИ ВЫПОЛНЯЮТ
Dialogue: 0,0:06:14.97,0:06:19.13,Caption,,0,0,0,,ДОГОВОРЁННОСТИ ДО ТЕХ ПОР, ПОКА СЧИТАЮТ ИХ ВЫГОДНЫМИ ДЛЯ СЕБЯ.
Dialogue: 0,0:06:19.13,0:06:22.07,Caption,,0,0,0,,ЗНАЧИТ, ЕСЛИ ХОЧЕШЬ, ЧТОБЫ ДОГОВОР РАБОТАЛ,
Dialogue: 0,0:06:22.31,0:06:24.01,Caption,,0,0,0,,НУЖНО ПОСТАВИТЬ ДРУГУЮ СТОРОНУ В
Dialogue: 0,0:06:24.01,0:06:26.49,Caption,,0,0,0,,ПОЛОЖЕНИЕ, ГДЕ НАРУШЕНИЕ ОБХОДИТСЯ ДОРОЖЕ
Dialogue: 0,0:06:26.49,0:06:29.42,Caption,,0,0,0,,ИСПОЛНЕНИЯ. ИРАН В ЭТОМ СМЫСЛЕ ПОКАЗАЛ ДОВОЛЬНО
Dialogue: 0,0:06:29.42,0:06:32.42,Caption,,0,0,0,,ЗАНЯТНЫЙ ПРИМЕР. ПОТЕНЦИАЛЫ ИРАНА И США ВООБЩЕ
Dialogue: 0,0:06:32.42,0:06:35.51,Caption,,0,0,0,,НЕСОПОСТАВИМЫ. НО ТЕГЕРАН СУМЕЛ РАБОТАТЬ НЕ ТОЛЬКО
Dialogue: 0,0:06:35.51,0:06:37.67,Caption,,0,0,0,,РАКЕТАМИ. ОН БИЛ ПО МЕДИАПОВЕСТКЕ,
Dialogue: 0,0:06:37.79,0:06:40.23,Caption,,0,0,0,,ПО РЫНКАМ, ПО ЭКОНОМИЧЕСКИМ ОЖИДАНИЯМ,
Dialogue: 0,0:06:40.39,0:06:42.70,Caption,,0,0,0,,ПО ЦЕНЕ САМОГО ПРОДОЛЖЕНИЯ КОНФЛИКТА.
Dialogue: 0,0:06:42.70,0:06:45.22,Caption,,0,0,0,,И В КАКОЙ ТО МОМЕНТ ВОПРОС УЖЕ ЗВУЧАЛ НЕ ТАК
Dialogue: 0,0:06:45.22,0:06:49.08,Caption,,0,0,0,,МОЖЕТ ЛИ АМЕРИКА ПРОДОЛЖАТЬ? КОНЕЧНО МОЖЕТ. ВОПРОС ЗВУЧИТ ИНАЧЕ А
Dialogue: 0,0:06:49.08,0:06:52.18,Caption,,0,0,0,,ЗАЧЕМ ЕЙ ПРОДОЛЖАТЬ, ЕСЛИ ЦЕНА НАЧИНАЕТ СТАНОВИТЬСЯ
Dialogue: 0,0:06:52.18,0:06:54.11,Caption,,0,0,0,,НЕПРИЯТНОЙ? ВОТ И С ЛЮБЫМИ БУДУЩИМИ
Dialogue: 0,0:06:54.11,0:06:57.87,Caption,,0,0,0,,ДОГОВОРЁННОСТЯМИ ВОКРУГ УКРАИНЫ БУДЕТ ТО ЖЕ САМОЕ. БУМАГА САМА
Dialogue: 0,0:06:57.87,0:07:00.70,Caption,,0,0,0,,СЕБЯ НЕ ЗАЩИЩАЕТ. ДОГОВОР ЗАЩИЩАЕТ МЕХАНИЗМ
Dialogue: 0,0:07:00.70,0:07:03.91,Caption,,0,0,0,,ПОСЛЕДСТВИЙ. ЕСЛИ НАРУШИЛ И НИЧЕГО НЕ ПРОИЗОШЛО,
Dialogue: 0,0:07:04.01,0:07:06.26,Caption,,0,0,0,,ЭТО НЕ ДОГОВОР. ЭТО ПРОСЬБА. ЕСЛИ
Dialogue: 0,0:07:06.26,0:07:08.39,Caption,,0,0,0,,НАРУШИЛ И СТАЛО ХУЖЕ ТЕБЕ САМОМУ,
Dialogue: 0,0:07:08.63,0:07:10.65,Caption,,0,0,0,,ВОТ ТОГДА НАЧИНАЕТСЯ НАСТОЯЩАЯ
Dialogue: 0,0:07:10.65,0:07:13.24,Caption,,0,0,0,,ГАРАНТИЯ. ЕСЛИ СЧИТАЕТЕ ТАКОЙ РАЗБОР ПОЛЕЗНЕЕ
Dialogue: 0,0:07:13.24,0:07:16.83,Caption,,0,0,0,,ОБЫЧНОГО ПЕРЕСКАЗА ЗАЯВЛЕНИЙ, ПОДПИШИТЕСЬ. ЗДЕСЬ ДАЛЬШЕ КАК РАЗ
Dialogue: 0,0:07:16.83,0:07:22.67,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ НЕУДОБНОЕ. ПОТОМУ ЧТО ПОКА ЕВРОПА РАССКАЗЫВАЕТ,
Dialogue: 0,0:07:22.91,0:07:24.99,Caption,,0,0,0,,КАКИЕ УСЛОВИЯ ДОЛЖНА ВЫПОЛНИТЬ РОССИЯ,
Dialogue: 0,0:07:25.31,0:07:27.52,Caption,,0,0,0,,ВНУТРИ САМОЙ УКРАИНЫ УЖЕ ЗВУЧАТ СОВСЕМ
Dialogue: 0,0:07:27.52,0:07:31.04,Caption,,0,0,0,,ДРУГИЕ СЛОВА. ДМИТРИЙ РАЗУМКОВ ГОВОРИТ ПРЯМО У
Dialogue: 0,0:07:31.04,0:07:35.04,Caption,,0,0,0,,УКРАИНЫ НЕТ НИ СЦЕНАРИЯ МИРА, НИ СЦЕНАРИЯ ВОЙНЫ. И ЕЩЁ ЗАДАЁТ
Dialogue: 0,0:07:35.04,0:07:38.72,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС. КУДА ДЕЛСЯ ГЕНИАЛЬНЫЙ ПЛАН ВЫХОДА К
Dialogue: 0,0:07:38.72,0:07:41.23,Caption,,0,0,0,,ГРАНИЦАМ ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО ПЕРВОГО ГОДА?
Dialogue: 0,0:07:41.39,0:07:44.24,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ВЕРНУТЬ ЭТИ ТЕРРИТОРИИ В НЫНЕШНИХ
Dialogue: 0,0:07:44.24,0:07:47.47,Caption,,0,0,0,,УСЛОВИЯХ НЕВОЗМОЖНО, КАК БЫ ЭТОГО НИ ХОТЕЛОСЬ. ЭТО УЖЕ НЕ
Dialogue: 0,0:07:47.47,0:07:49.47,Caption,,0,0,0,,МОСКВА ГОВОРИТ. ЭТО УКРАИНСКИЙ
Dialogue: 0,0:07:49.47,0:07:52.71,Caption,,0,0,0,,ДЕПУТАТ. И РЯДОМ С ЭТИМ ЛЕЖАТ СЛОВА КУШНЕРА. ПО ЕГО
Dialogue: 0,0:07:52.71,0:07:55.11,Caption,,0,0,0,,СЛОВАМ, С ФЕВРАЛЯ ПО СЕНТЯБРЬ АМЕРИКАНСКИЕ
Dialogue: 0,0:07:55.11,0:07:58.21,Caption,,0,0,0,,ПЕРЕГОВОРЩИКИ ПОСТОЯННО КОНТАКТИРОВАЛИ СО СТОРОНАМИ
Dialogue: 0,0:07:58.21,0:08:01.18,Caption,,0,0,0,,И НЕ УВИДЕЛИ ДОСТАТОЧНОЙ ГИБКОСТИ НИ У ОДНОЙ ИЗ
Dialogue: 0,0:08:01.18,0:08:03.24,Caption,,0,0,0,,НИХ. ТО ЕСТЬ ПРОБЛЕМА НЕ СВОДИТСЯ К ОДНОЙ
Dialogue: 0,0:08:03.24,0:08:05.96,Caption,,0,0,0,,ФРАЗЕ "РОССИЯ НЕ ХОЧЕТ" ИЛИ "УКРАИНА НЕ ХОЧЕТ".
Dialogue: 0,0:08:05.96,0:08:09.76,Caption,,0,0,0,,АМЕРИКАНЦЫ САМИ ГОВОРЯТ, ЧТО УПЁРЛИСЬ СРАЗУ В НЕСКОЛЬКО СТЕН.
Dialogue: 0,0:08:09.76,0:08:12.98,Caption,,0,0,0,,ТЕРРИТОРИИ. ГАРАНТИИ БЕЗОПАСНОСТИ. ОТСУТСТВИЕ
Dialogue: 0,0:08:12.98,0:08:16.12,Caption,,0,0,0,,КОМПРОМИССА. И ТОГДА ВОЗНИКАЕТ СЛЕДУЮЩИЙ ВОПРОС.
Dialogue: 0,0:08:16.12,0:08:18.35,Caption,,0,0,0,,ХОРОШО. ЕСЛИ АМЕРИКАНЦЫ УЖЕ ПОНИМАЮТ,
Dialogue: 0,0:08:18.43,0:08:21.47,Caption,,0,0,0,,ГДЕ СТОЯТ СТЕНЫ, ЧТО ОНИ СОБИРАЮТСЯ С НИМИ ДЕЛАТЬ?
Dialogue: 0,0:08:21.71,0:08:23.42,Caption,,0,0,0,,ПОТОМУ ЧТО ПРОСТО ДИАГНОСТИРОВАТЬ
Dialogue: 0,0:08:23.42,0:08:26.48,Caption,,0,0,0,,ПРОБЛЕМУ МОЖНО ЕЩЁ ЛЕТ ПЯТЬ. КУШНЕР РАССКАЗЫВАЕТ И ЕЩЁ
Dialogue: 0,0:08:26.48,0:08:29.31,Caption,,0,0,0,,ОДНУ ЛЮБОПЫТНУЮ ВЕЩЬ. ТРАМП ВЫСТУПИЛ ЗА ПРОВЕДЕНИЕ
Dialogue: 0,0:08:29.31,0:08:33.12,Caption,,0,0,0,,ВЫБОРОВ НА УКРАИНЕ. ПРИЧЁМ,
Dialogue: 0,0:08:33.28,0:08:36.40,Caption,,0,0,0,,ПО СЛОВАМ КУШНЕРА, ПРОИЗОШЛО ЭТО УЖЕ ПОСЛЕ ТОГО,
Dialogue: 0,0:08:36.60,0:08:38.84,Caption,,0,0,0,,КАК ЗЕЛЕНСКИЙ ПУБЛИЧНО КРИТИКОВАЛ
Dialogue: 0,0:08:38.84,0:08:41.52,Caption,,0,0,0,,ТРАМПА. А ТРАМП, КАК АККУРАТНО ЗАМЕТИЛ КУШНЕР,
Dialogue: 0,0:08:41.77,0:08:43.76,Caption,,0,0,0,,УМЕЕТ ОЧЕНЬ ЖЁСТКО ОТВЕЧАТЬ НА ВЫПАДЫ
Dialogue: 0,0:08:43.76,0:08:46.32,Caption,,0,0,0,,В СВОЙ АДРЕС. ЭТО УЖЕ НЕ РАЗГОВОР О ТОМ,
Dialogue: 0,0:08:46.40,0:08:50.81,Caption,,0,0,0,,КОМУ КТО НРАВИТСЯ. ВЫБОРЫ, ЭТО КОНКРЕТНЫЙ ПОЛИТИЧЕСКИЙ МЕХАНИЗМ.
Dialogue: 0,0:08:50.81,0:08:54.84,Caption,,0,0,0,,И ЕСЛИ ВАШИНГТОН СЧИТАЕТ, ЧТО НЫНЕШНЯЯ КОНСТРУКЦИЯ ВЛАСТИ МЕШАЕТ
Dialogue: 0,0:08:54.84,0:08:58.07,Caption,,0,0,0,,ДОСТИЖЕНИЮ СДЕЛКИ, ТОГДА ВОПРОС ВЫБОРОВ ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:08:58.07,0:09:00.87,Caption,,0,0,0,,АБСТРАКТНОЙ ЛЕКЦИЕЙ О ДЕМОКРАТИИ. ЭТО СТАНОВИТСЯ
Dialogue: 0,0:09:00.87,0:09:04.08,Caption,,0,0,0,,РЫЧАГОМ. ОСОБЕННО ЕСЛИ УЧЕСТЬ ЕЩЁ ОДНУ ДЕТАЛЬ.
Dialogue: 0,0:09:04.08,0:09:06.27,Caption,,0,0,0,,ВО ВРЕМЯ КОНТАКТОВ С АМЕРИКАНЦАМИ ПУТИН
Dialogue: 0,0:09:06.27,0:09:09.20,Caption,,0,0,0,,ОБСУЖДАЛ С НИМИ ПОВЕДЕНИЕ ЗЕЛЕНСКОГО В ОТНОШЕНИИ
Dialogue: 0,0:09:09.20,0:09:12.66,Caption,,0,0,0,,ТРАМПА. А САМОГО ПУТИНА КУШНЕР ОПИСЫВАЕТ ОЧЕНЬ ТЕПЛО.
Dialogue: 0,0:09:12.66,0:09:15.29,Caption,,0,0,0,,НАЗЫВАЕТ ВЫДАЮЩИМСЯ ПОЛИТИКОМ И ИСТОРИЧЕСКОЙ
Dialogue: 0,0:09:15.29,0:09:18.48,Caption,,0,0,0,,ФИГУРОЙ. ГОВОРИТ, ЧТО ПУТИН ВСЕГДА ПОДГОТОВЛЕН,
Dialogue: 0,0:09:18.72,0:09:20.64,Caption,,0,0,0,,ДЕЛАЕТ ЗАМЕТКИ ВО ВРЕМЯ РАЗГОВОРА,
Dialogue: 0,0:09:20.88,0:09:23.03,Caption,,0,0,0,,ГЛУБОКО ПОНИМАЕТ ПРОБЛЕМЫ И ИМЕЕТ
Dialogue: 0,0:09:23.03,0:09:26.29,Caption,,0,0,0,,ЧЁТКИЕ ВЗГЛЯДЫ. МОЖНО ПО РАЗНОМУ ОТНОСИТЬСЯ К ЭТОЙ
Dialogue: 0,0:09:26.29,0:09:29.05,Caption,,0,0,0,,ОЦЕНКЕ, НО ДЛЯ ПЕРЕГОВОРОВ ВАЖНО ДРУГОЕ.
Dialogue: 0,0:09:29.05,0:09:32.01,Caption,,0,0,0,,АМЕРИКАНЦЫ УЖЕ СОСТАВИЛИ СВОЁ МНЕНИЕ О ЛЮДЯХ ПО ОБЕ
Dialogue: 0,0:09:32.01,0:09:36.74,Caption,,0,0,0,,СТОРОНЫ СТОЛА. ОНИ ВИДЯТ, КТО КАК ВЕДЁТ ПЕРЕГОВОРЫ. КТО ЧТО
Dialogue: 0,0:09:36.74,0:09:39.97,Caption,,0,0,0,,ОБЕЩАЕТ. КТО КАК РЕАГИРУЕТ. КТО ГОТОВ МЕНЯТЬ
Dialogue: 0,0:09:39.97,0:09:42.88,Caption,,0,0,0,,ПОЗИЦИЮ. И ВОТ ГЛАВНЫЙ ВОПРОС. А ЧТО АМЕРИКАНЦЫ
Dialogue: 0,0:09:42.88,0:09:46.40,Caption,,0,0,0,,НАМЕРЕНЫ СО ВСЕМ ЭТИМ ДЕЛАТЬ, КРОМЕ УПРЁКОВ ЗЕЛЕНСКОМУ В ПРЕССЕ?
Dialogue: 0,0:09:48.68,0:09:50.46,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ВЫ САМИ ПРИШЛИ К
Dialogue: 0,0:09:50.46,0:09:52.86,Caption,,0,0,0,,ВЫВОДУ, ЧТО ОДИН ИЗ УЧАСТНИКОВ ПРОЦЕССА
Dialogue: 0,0:09:52.86,0:09:55.00,Caption,,0,0,0,,ПОСТОЯННО СОЗДАЁТ ВАМ НОВУЮ ПРОБЛЕМУ,
Dialogue: 0,0:09:55.24,0:09:57.10,Caption,,0,0,0,,СЛЕДУЮЩИЙ ШАГ ДОЛЖЕН БЫТЬ КАКИМ ТО
Dialogue: 0,0:09:57.10,0:10:00.45,Caption,,0,0,0,,ПРАКТИЧЕСКИМ. И ТУТ МЫ НАКОНЕЦ ПОДХОДИМ К ИСТОРИИ,
Dialogue: 0,0:10:00.68,0:10:02.64,Caption,,0,0,0,,КОТОРУЮ КАК РАЗ ЛУЧШЕ ОСТАВИТЬ НА
Dialogue: 0,0:10:02.64,0:10:05.07,Caption,,0,0,0,,КОНЕЦ. ПОТОМУ ЧТО КУШНЕР И ЛУКАШЕНКО ПОЧТИ
Dialogue: 0,0:10:05.07,0:10:06.92,Caption,,0,0,0,,ОДНОВРЕМЕННО НАЧАЛИ РАССКАЗЫВАТЬ,
Dialogue: 0,0:10:07.17,0:10:08.94,Caption,,0,0,0,,НАСКОЛЬКО БЛИЗКО ПЕРЕГОВОРЫ УЖЕ
Dialogue: 0,0:10:08.94,0:10:11.54,Caption,,0,0,0,,ПОДХОДИЛИ К СОВЕРШЕННО ДРУГОЙ ТОЧКЕ. КУШНЕР
Dialogue: 0,0:10:11.54,0:10:13.97,Caption,,0,0,0,,ГОВОРИТ, ЧТО ПРИМЕРНО В НОЯБРЕ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:10:13.97,0:10:16.90,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТОГО ГОДА АМЕРИКАНЦЫ НАЧАЛИ ДОБИВАТЬСЯ
Dialogue: 0,0:10:16.90,0:10:20.04,Caption,,0,0,0,,ОЩУТИМОГО ПРОГРЕССА. ПОТОМ, ПО РАССКАЗУ КУШНЕРА,
Dialogue: 0,0:10:20.23,0:10:22.15,Caption,,0,0,0,,В КОНЦЕ ДЕКАБРЯ ПРОИЗОШЛА АТАКА
Dialogue: 0,0:10:22.15,0:10:25.32,Caption,,0,0,0,,УКРАИНСКИХ БЕСПИЛОТНИКОВ НА РЕЗИДЕНЦИЮ ПУТИНА. ПО
Dialogue: 0,0:10:25.32,0:10:28.36,Caption,,0,0,0,,ОЦЕНКЕ КУШНЕРА, ПОСЛЕ ЭТОГО ПУТИН ОТСТУПИЛ НАЗАД В
Dialogue: 0,0:10:28.36,0:10:31.48,Caption,,0,0,0,,ПЕРЕГОВОРНОМ ПРОЦЕССЕ. ЛУКАШЕНКО РАССКАЗЫВАЕТ ЕЩЁ
Dialogue: 0,0:10:31.48,0:10:35.40,Caption,,0,0,0,,ЖЁСТЧЕ. ПО ЕГО СЛОВАМ, РЕЧЬ ШЛА О ДОГОВОРЁННОСТЯХ ПО СОЗДАНИЮ
Dialogue: 0,0:10:35.40,0:10:37.60,Caption,,0,0,0,,ДЕМИЛИТАРИЗОВАННОЙ ЗОНЫ И ОСТАНОВКЕ
Dialogue: 0,0:10:37.60,0:10:39.96,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ. ПРИЧЁМ ОСТАНОВКА,
Dialogue: 0,0:10:40.05,0:10:43.28,Caption,,0,0,0,,КАК ОН УТВЕРЖДАЕТ, МОГЛА ПРОЙТИ ПО СУЩЕСТВУЮЩЕЙ ЛИНИИ
Dialogue: 0,0:10:43.28,0:10:46.34,Caption,,0,0,0,,СОПРИКОСНОВЕНИЯ. А УЖЕ ПОТОМ СТОРОНЫ ПРОДОЛЖИЛИ БЫ
Dialogue: 0,0:10:46.34,0:10:49.57,Caption,,0,0,0,,РАЗГОВАРИВАТЬ О ТОМ, ГДЕ БУДЕТ ГРАНИЦА И КАК ВООБЩЕ
Dialogue: 0,0:10:49.57,0:10:52.77,Caption,,0,0,0,,ОФОРМЛЯТЬ ДАЛЬНЕЙШЕЕ УРЕГУЛИРОВАНИЕ. ТО ЕСТЬ ЕСЛИ ВЕРИТЬ
Dialogue: 0,0:10:52.77,0:10:56.44,Caption,,0,0,0,,ЭТОЙ ВЕРСИИ СОБЫТИЙ, РЕЧЬ ШЛА УЖЕ НЕ О ФРАЗАХ "КОГДА НИБУДЬ
Dialogue: 0,0:10:56.44,0:10:58.59,Caption,,0,0,0,,НАДО ЗАКОНЧИТЬ ВОЙНУ". РЕЧЬ ШЛА О
Dialogue: 0,0:10:58.59,0:11:00.60,Caption,,0,0,0,,ВПОЛНЕ ПОНЯТНОЙ ПОСЛЕДОВАТЕЛЬНОСТИ.
Dialogue: 0,0:11:02.87,0:11:05.10,Caption,,0,0,0,,ОСТАНОВИЛИ БОЕВЫЕ ДЕЙСТВИЯ. РАЗВЕЛИ
Dialogue: 0,0:11:05.10,0:11:08.31,Caption,,0,0,0,,СТОРОНЫ. ПОТОМ РАЗБИРАЕМСЯ С ГРАНИЦЕЙ. И ВОТ ПОСЛЕ
Dialogue: 0,0:11:08.31,0:11:12.13,Caption,,0,0,0,,ЭТОГО, ПО ВЕРСИИ ЛУКАШЕНКО, ПРОИСХОДИТ УДАР ПО РЕЗИДЕНЦИИ.
Dialogue: 0,0:11:12.13,0:11:15.96,Caption,,0,0,0,,ЛУКАШЕНКО ОТДЕЛЬНО ГОВОРИТ, ЧТО ПУТИН ПОСЛЕ ЭТОЙ ИСТОРИИ СДЕЛАЛ
Dialogue: 0,0:11:15.96,0:11:18.79,Caption,,0,0,0,,ВЫВОД, ЧТО ДОВЕРЯТЬ КИЕВУ И ЗАПАДУ НЕЛЬЗЯ.
Dialogue: 0,0:11:18.79,0:11:20.87,Caption,,0,0,0,,БОЛЕЕ ТОГО, ЛУКАШЕНКО СЧИТАЕТ,
Dialogue: 0,0:11:21.04,0:11:23.18,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ НЕ РЕШИЛСЯ БЫ НА ТАКОЙ
Dialogue: 0,0:11:23.18,0:11:25.63,Caption,,0,0,0,,ШАГ БЕЗ ОДОБРЕНИЯ В ЕВРОПЕ. ЭТО УЖЕ ОЦЕНКА
Dialogue: 0,0:11:25.63,0:11:28.95,Caption,,0,0,0,,ЛУКАШЕНКО. НО САМ ФАКТ ТОГО, ЧТО И КУШНЕР,
Dialogue: 0,0:11:29.11,0:11:31.10,Caption,,0,0,0,,И ЛУКАШЕНКО СВЯЗЫВАЮТ ТОТ ЭПИЗОД С
Dialogue: 0,0:11:31.10,0:11:35.08,Caption,,0,0,0,,ОТКАТОМ ПЕРЕГОВОРОВ НАЗАД, ВЫГЛЯДИТ ОЧЕНЬ ПОКАЗАТЕЛЬНО. А ТЕПЕРЬ
Dialogue: 0,0:11:35.08,0:11:37.27,Caption,,0,0,0,,СМОТРИМ НА ТО, ЧТО ПРОИСХОДИТ ДАЛЬШЕ.
Dialogue: 0,0:11:37.87,0:11:39.92,Caption,,0,0,0,,В ПОВЕСТКЕ ОПЯТЬ КРЫМСКИЙ МОСТ.
Dialogue: 0,0:11:39.92,0:11:42.47,Caption,,0,0,0,,РУКОВОДИТЕЛЬ НИДЕРЛАНДСКОЙ КОМПАНИИ DESTINUS
Dialogue: 0,0:11:42.47,0:11:46.50,Caption,,0,0,0,,АЛЕКСАНДР ДАНИЛЮК ЗАЯВИЛ, ЧТО ДЕВЯТЬ ЕЁ КРЫЛАТЫХ РАКЕТ RUTA И
Dialogue: 0,0:11:46.50,0:11:48.82,Caption,,0,0,0,,УДАРНЫЕ БЕСПИЛОТНИКИ УЧАСТВОВАЛИ В АТАКЕ НА
Dialogue: 0,0:11:48.82,0:11:51.75,Caption,,0,0,0,,КРЫМСКИЙ МОСТ СЕМНАДЦАТОГО НОЯБРЯ. И ДАЖЕ СКАЗАЛ,
Dialogue: 0,0:11:51.91,0:11:54.43,Caption,,0,0,0,,ЧТО КОМПАНИЯ ЭТИМ ГОРДИТСЯ. НО ДАЛЬШЕ
Dialogue: 0,0:11:54.43,0:11:57.13,Caption,,0,0,0,,ЕЩЁ ИНТЕРЕСНЕЕ. ПО ДАННЫМ НИДЕРЛАНДСКОЙ
Dialogue: 0,0:11:57.13,0:11:59.54,Caption,,0,0,0,,ГАЗЕТЫ NRC, СОТРУДНИКИ КОМПАНИИ МОГЛИ
Dialogue: 0,0:11:59.54,0:12:02.70,Caption,,0,0,0,,НЕПОСРЕДСТВЕННО ПОМОГАТЬ УКРАИНСКИМ ВОЕННЫМ С ЗАПУСКОМ И
Dialogue: 0,0:12:02.70,0:12:05.32,Caption,,0,0,0,,УПРАВЛЕНИЕМ БЕСПИЛОТНИКАМИ. САМА DESTINUS
Dialogue: 0,0:12:05.32,0:12:08.07,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО РЕЧЬ ШЛА ТОЛЬКО О ТЕХНИЧЕСКОЙ
Dialogue: 0,0:12:08.07,0:12:10.85,Caption,,0,0,0,,ПОДДЕРЖКЕ. РОССИЙСКОЕ ПОСОЛЬСТВО В ГААГЕ ПОСЛЕ
Dialogue: 0,0:12:10.85,0:12:13.27,Caption,,0,0,0,,ЭТОГО ПОТРЕБОВАЛО ОБЪЯСНЕНИЙ ОТ НИДЕРЛАНДОВ.
Dialogue: 0,0:12:15.54,0:12:17.30,Caption,,0,0,0,,ТО ЕСТЬ ВОПРОС ТЕПЕРЬ НЕ ТОЛЬКО В ТОМ,
Dialogue: 0,0:12:17.46,0:12:19.78,Caption,,0,0,0,,ЧЬИ РАКЕТЫ ИСПОЛЬЗОВАЛИСЬ, НО И В ТОМ,
Dialogue: 0,0:12:19.94,0:12:22.05,Caption,,0,0,0,,НАСКОЛЬКО НЕПОСРЕДСТВЕННО ЕВРОПЕЙСКАЯ
Dialogue: 0,0:12:22.05,0:12:24.56,Caption,,0,0,0,,КОМПАНИЯ УЧАСТВОВАЛА В ОПЕРАЦИИ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:12:24.56,0:12:26.93,Caption,,0,0,0,,МОЯ ВЕРСИЯ ПРОСТАЯ. КАК ТОЛЬКО ПЕРЕГОВОРЫ
Dialogue: 0,0:12:26.93,0:12:30.30,Caption,,0,0,0,,НАЧИНАЮТ ХОТЬ НЕМНОГО ПРИОБРЕТАТЬ ОЧЕРТАНИЯ И ПОЯВЛЯЕТСЯ
Dialogue: 0,0:12:30.30,0:12:33.78,Caption,,0,0,0,,БОЛЕЕ МЕНЕЕ ОЩУТИМАЯ ТОЧКА, ЗА КОТОРУЮ МОЖНО ЗАЦЕПИТЬСЯ,
Dialogue: 0,0:12:34.02,0:12:36.56,Caption,,0,0,0,,СЛЕДОМ ПРИХОДИТ НОВАЯ ЭСКАЛАЦИЯ. ТОГДА
Dialogue: 0,0:12:36.56,0:12:39.09,Caption,,0,0,0,,БЫЛА РЕЗИДЕНЦИЯ ПУТИНА. ТЕПЕРЬ КРЫМСКИЙ
Dialogue: 0,0:12:39.09,0:12:41.66,Caption,,0,0,0,,МОСТ. И КАЖДЫЙ РАЗ АМЕРИКАНСКИМ ПЕРЕГОВОРЩИКАМ
Dialogue: 0,0:12:41.66,0:12:44.26,Caption,,0,0,0,,ПРИХОДИТСЯ ВОЗВРАЩАТЬСЯ И СНОВА СОБИРАТЬ ТО,
Dialogue: 0,0:12:44.42,0:12:46.66,Caption,,0,0,0,,ЧТО ОНИ ТОЛЬКО НАЧАЛИ СКЛАДЫВАТЬ. МОЯ
Dialogue: 0,0:12:46.66,0:12:49.43,Caption,,0,0,0,,ОЦЕНКА ЗДЕСЬ ЖЁСТКАЯ. КРЕАТИВНОСТИ У ДЕВЯНОСТО
Dialogue: 0,0:12:49.43,0:12:52.58,Caption,,0,0,0,,ПЯТОГО КВАРТАЛА, ВОТ ЭТОЙ КРОВАВОЙ КРЕАТИВНОСТИ,
Dialogue: 0,0:12:52.74,0:12:54.78,Caption,,0,0,0,,НЕ ОТНЯТЬ. НО ТОГДА АМЕРИКАНЦАМ
Dialogue: 0,0:12:54.78,0:12:57.46,Caption,,0,0,0,,ПРИДЁТСЯ ОПРЕДЕЛИТЬСЯ. ЕСЛИ ОНИ СЧИТАЮТ,
Dialogue: 0,0:12:57.70,0:12:59.70,Caption,,0,0,0,,ЧТО ЭТО ДЕЙСТВИТЕЛЬНО МЕШАЕТ ПЕРЕГОВОРАМ,
Dialogue: 0,0:13:00.00,0:13:01.69,Caption,,0,0,0,,БЕСКОНЕЧНО РАССКАЗЫВАТЬ ОБ ЭТОМ В
Dialogue: 0,0:13:01.69,0:13:04.26,Caption,,0,0,0,,ИНТЕРВЬЮ БЕССМЫСЛЕННО. НУЖЕН МЕХАНИЗМ,
Dialogue: 0,0:13:04.34,0:13:06.55,Caption,,0,0,0,,КОТОРЫЙ МЕНЯЕТ ПОВЕДЕНИЕ. ПОТОМУ ЧТО
Dialogue: 0,0:13:06.55,0:13:09.74,Caption,,0,0,0,,ИНАЧЕ ВСЁ БУДЕТ ПОВТОРЯТЬСЯ СНОВА И СНОВА. НАМЕТИЛСЯ
Dialogue: 0,0:13:09.74,0:13:12.62,Caption,,0,0,0,,ДИАЛОГ. ПОЯВИЛАСЬ ЭСКАЛАЦИЯ. ПЕРЕГОВОРЩИКИ
Dialogue: 0,0:13:12.62,0:13:15.93,Caption,,0,0,0,,ВЕРНУЛИСЬ НАЗАД. СНОВА НАЧАЛИ СОБИРАТЬ КОНСТРУКЦИЮ.
Dialogue: 0,0:13:15.93,0:13:19.37,Caption,,0,0,0,,СНОВА ПОДОШЛИ БЛИЖЕ. И СНОВА НОВЫЙ ЭПИЗОД. ТАК МОЖНО
Dialogue: 0,0:13:19.37,0:13:22.58,Caption,,0,0,0,,РАЗГОВАРИВАТЬ ОЧЕНЬ ДОЛГО. И ВОТ ЗДЕСЬ ВОПРОС УЖЕ НЕ
Dialogue: 0,0:13:22.66,0:13:24.93,Caption,,0,0,0,,В ТОМ, СОСТОИТСЯ ЛИ СЛЕДУЮЩИЙ РАУНД
Dialogue: 0,0:13:24.93,0:13:29.83,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ВОПРОС В ДРУГОМ. ЕСТЬ ЛИ У ТЕХ,
Dialogue: 0,0:13:29.92,0:13:31.67,Caption,,0,0,0,,КТО ВЗЯЛСЯ ДОГОВАРИВАТЬСЯ О МИРЕ,
Dialogue: 0,0:13:31.91,0:13:34.41,Caption,,0,0,0,,ИНСТРУМЕНТ, КОТОРЫЙ НЕ ПОЗВОЛИТ КАЖДЫЙ РАЗ
Dialogue: 0,0:13:34.41,0:13:37.70,Caption,,0,0,0,,НАЧИНАТЬ ПОЧТИ С НУЛЯ? ПОТОМУ ЧТО ЕСЛИ НИЧЕГО С ЭТИМ НЕ
Dialogue: 0,0:13:37.70,0:13:40.23,Caption,,0,0,0,,ДЕЛАТЬ, ЭТОТ ПРОЦЕСС БУДЕТ ОЧЕНЬ ДОЛГИМ.
