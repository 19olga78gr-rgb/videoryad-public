Dialogue: 0,0:00:00.12,0:00:03.64,Caption,,0,0,0,,ЕСТЬ ВЕЩИ, КОТОРЫЕ ОЧЕНЬ ХОТЕЛОСЬ БЫ ОСТАВИТЬ ГДЕ НИБУДЬ В
Dialogue: 0,0:00:03.64,0:00:06.20,Caption,,0,0,0,,ПРОШЛОМ. НАПРИМЕР, ИНСТРУКЦИИ О ТОМ,
Dialogue: 0,0:00:06.36,0:00:09.32,Caption,,0,0,0,,ЧТО ДЕЛАТЬ ПРИ ЯДЕРНОМ УДАРЕ. ЛЮДИ ПОСТАРШЕ ЭТО
Dialogue: 0,0:00:09.32,0:00:12.44,Caption,,0,0,0,,ПРЕКРАСНО ПОМНЯТ. ТОГДА ТАКОЕ УЧИЛИ НЕ ОТ ХОРОШЕЙ
Dialogue: 0,0:00:12.52,0:00:15.00,Caption,,0,0,0,,ЖИЗНИ. ПОТОМ ВРОДЕ ОТПУСТИЛО. И ВОТ,
Dialogue: 0,0:00:15.08,0:00:17.72,Caption,,0,0,0,,ЗДРАСЬТЕ, ПРИЕХАЛИ. СНОВА ОБЪЯСНЯЮТ,
Dialogue: 0,0:00:17.96,0:00:21.56,Caption,,0,0,0,,КУДА БЕЖАТЬ, ГДЕ ПРЯТАТЬСЯ И ЧТО ДЕЛАТЬ ПОСЛЕ ВСПЫШКИ. НУ
Dialogue: 0,0:00:21.56,0:00:23.88,Caption,,0,0,0,,ЧТО, ОПЯТЬ НАЧИНАЕМ ВСПОМИНАТЬ МОЛОДОСТЬ?
Dialogue: 0,0:00:24.36,0:00:27.08,Caption,,0,0,0,,НО НАЧНЁМ ВСЁ ТАКИ С АМЕРИКИ. ТАМ ДЕМОКРАТЫ
Dialogue: 0,0:00:27.16,0:00:32.04,Caption,,0,0,0,,ЗАБРАЛИ ОБЕ ПАЛАТЫ КОНГРЕССА, А РЕСПУБЛИКАНЦЫ ПОЛУЧИЛИ ХОРОШИЙ ТАКОЙ ХОЛОДНЫЙ ДУШ.
Dialogue: 0,0:00:32.51,0:00:37.00,Caption,,0,0,0,,ХОТЯ Я ВООБЩЕ НЕ ПОНИМАЮ, ПОЧЕМУ ВСЕ ТАК УДИВИЛИСЬ. ЧТО ДОЛЖНО БЫЛО ПРОИЗОЙТИ?
Dialogue: 0,0:00:37.25,0:00:40.76,Caption,,0,0,0,,НЕБО РАСКРЫТЬСЯ? ИЗБИРАТЕЛЬ ВНЕЗАПНО ЗАБЫТЬ ПРО ЦЕНЫ,
Dialogue: 0,0:00:40.92,0:00:43.48,Caption,,0,0,0,,БЕНЗИН И ВОЙНУ С ИРАНОМ? НЕ ЗАБЫЛ.
Dialogue: 0,0:00:44.04,0:00:47.16,Caption,,0,0,0,,ТРАМП ТЕПЕРЬ ОБЪЯСНЯЕТ ПОРАЖЕНИЕ ПРОСТО. ДЕЛО,
Dialogue: 0,0:00:47.24,0:00:49.24,Caption,,0,0,0,,ГОВОРИТ, НЕ СТОЛЬКО В САМОЙ ВОЙНЕ,
Dialogue: 0,0:00:49.40,0:00:52.44,Caption,,0,0,0,,СКОЛЬКО В ЦЕНЕ БЕНЗИНА. ЛЮДЯМ ВРОДЕ НРАВИТСЯ ТО,
Dialogue: 0,0:00:52.67,0:00:56.20,Caption,,0,0,0,,ЧТО ОН ДЕЛАЕТ С ИРАНОМ, НО ПЛАТИТЬ ЗА ЭТО НА ЗАПРАВКЕ ОНИ ПОЧЕМУ
Dialogue: 0,0:00:56.28,0:00:59.88,Caption,,0,0,0,,ТО НЕ ЗАХОТЕЛИ. ВОТ НЕБЛАГОДАРНЫЕ. ГЕОПОЛИТИКА ИМ,
Dialogue: 0,0:01:00.27,0:01:03.16,Caption,,0,0,0,,ПОНИМАЕШЬ, МИРОВАЯ, ВЕЛИКАЯ АМЕРИКА,
Dialogue: 0,0:01:03.32,0:01:06.60,Caption,,0,0,0,,БОЛЬШАЯ СТРАТЕГИЯ. А ЧЕЛОВЕК ПОДЪЕЗЖАЕТ К КОЛОНКЕ,
Dialogue: 0,0:01:06.76,0:01:09.80,Caption,,0,0,0,,СМОТРИТ НА ЦИФРЫ И НАЧИНАЕТ ГОЛОСОВАТЬ СОВСЕМ НЕ
Dialogue: 0,0:01:09.80,0:01:12.12,Caption,,0,0,0,,ГЕОПОЛИТИЧЕСКИ. ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:01:12.41,0:01:14.68,Caption,,0,0,0,,КОГДА МЫ НЕ ПРОСТО ПЕРЕСКАЗЫВАЕМ НОВОСТИ,
Dialogue: 0,0:01:14.93,0:01:17.56,Caption,,0,0,0,,А СМОТРИМ, ЧТО ЗА НИМИ НАЧИНАЕТСЯ ДАЛЬШЕ,
Dialogue: 0,0:01:17.78,0:01:23.59,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ТУТ КАК РАЗ ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ ЗАНЯТНОЕ. ПЛЮС
Dialogue: 0,0:01:23.59,0:01:27.03,Caption,,0,0,0,,ТРАМП НАПОМНИЛ, ЧТО САМОГО ЕГО В БЮЛЛЕТЕНЕ НЕ БЫЛО. А
Dialogue: 0,0:01:27.11,0:01:29.35,Caption,,0,0,0,,ВОТ ЕСЛИ БЫ БЫЛ, ТОГДА, КОНЕЧНО,
Dialogue: 0,0:01:29.45,0:01:32.39,Caption,,0,0,0,,ВСЕХ БЫ РАЗНЁС. НУ ЭТО ВООБЩЕ УДОБНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:01:32.71,0:01:35.35,Caption,,0,0,0,,КОМАНДА ПРОИГРАЛА, НО ТРЕНЕР СООБЩАЕТ,
Dialogue: 0,0:01:35.51,0:01:38.31,Caption,,0,0,0,,ЧТО ЛИЧНО ОН ВСЁ РАВНО ЧЕМПИОН. ОСТАЛОСЬ ТОЛЬКО
Dialogue: 0,0:01:38.31,0:01:41.11,Caption,,0,0,0,,КУБОК СЕБЕ ЗАКАЗАТЬ. НО ДОЛГО КОПАТЬСЯ В ЭТИХ
Dialogue: 0,0:01:41.11,0:01:44.15,Caption,,0,0,0,,ВЫБОРАХ СМЫСЛА НЕТ. ПРОИГРАЛ И ПРОИГРАЛ. ТРАМП ОТ
Dialogue: 0,0:01:44.15,0:01:46.63,Caption,,0,0,0,,ЭТОГО НЕ ПЕРЕСТАЛ БЫТЬ ТРАМПОМ. ПРОСТО ТЕПЕРЬ У
Dialogue: 0,0:01:46.63,0:01:49.27,Caption,,0,0,0,,НЕГО ЗА СПИНОЙ УЖЕ НЕТ ТОЙ ПОЛИТИЧЕСКОЙ ОПОРЫ,
Dialogue: 0,0:01:49.43,0:01:52.79,Caption,,0,0,0,,КОТОРАЯ БЫЛА РАНЬШЕ. А ВПЕРЕДИ ДВА ГОДА БОДАНИЯ
Dialogue: 0,0:01:52.87,0:01:55.51,Caption,,0,0,0,,С КОНГРЕССОМ. КТО ОТ ЭТОГО В ИТОГЕ ВЫИГРАЕТ,
Dialogue: 0,0:01:55.65,0:02:00.63,Caption,,0,0,0,,ЕЩЁ ПОСМОТРИМ. АМЕРИКА ТОЧНО КРЕПЧЕ ОТ ПОСТОЯННОЙ ДРАКИ БЕЛОГО ДОМА
Dialogue: 0,0:02:00.63,0:02:03.19,Caption,,0,0,0,,С СОБСТВЕННЫМ ПАРЛАМЕНТОМ НЕ СТАНЕТ. ПОТОМУ ЧТО
Dialogue: 0,0:02:03.19,0:02:05.19,Caption,,0,0,0,,АЛЕКСАНДР ЛУКАШЕНКО, Я СМОТРЮ,
Dialogue: 0,0:02:05.36,0:02:08.55,Caption,,0,0,0,,РЕШИЛ ТРАМПА ЗАРАНЕЕ МОРАЛЬНО ПОДДЕРЖАТЬ. Я ЖЕ
Dialogue: 0,0:02:08.63,0:02:12.07,Caption,,0,0,0,,ТРАМПИСТ, ГОВОРИТ. И ВООБЩЕ ДОНАЛЬДА НАДО ПОСТАВИТЬ РУКОВОДИТЬ
Dialogue: 0,0:02:12.07,0:02:15.51,Caption,,0,0,0,,ООН. КРАСИВО. ТО ЕСТЬ ВЫБОРЫ НЕ ОЧЕНЬ ЗАДАЛИСЬ,
Dialogue: 0,0:02:15.72,0:02:17.91,Caption,,0,0,0,,ДОМА ТЕПЕРЬ БУДЕТ ВЕСЕЛО, НУ НИЧЕГО,
Dialogue: 0,0:02:17.99,0:02:21.91,Caption,,0,0,0,,ДОНАЛЬД, НЕ ПЕРЕЖИВАЙ. ВОТ ТЕБЕ УТЕШИТЕЛЬНЫЙ ПРИЗ. ВОЗГЛАВИШЬ
Dialogue: 0,0:02:21.91,0:02:24.63,Caption,,0,0,0,,ОРГАНИЗАЦИЮ ОБЪЕДИНЁННЫХ НАЦИЙ. Я БЫ ВООБЩЕ НЕ
Dialogue: 0,0:02:24.63,0:02:27.51,Caption,,0,0,0,,МЕЛОЧИЛСЯ. МОЖНО СРАЗУ ДАТЬ ТИТУЛ КОРОЛЯ МИРА.
Dialogue: 0,0:02:27.75,0:02:32.71,Caption,,0,0,0,,КОРОНА, КРАСИВОЕ КРЕСЛО, ТАБЛИЧКА ЗОЛОТАЯ. ПОЛНОМОЧИЯ ПОТОМ КАК НИБУДЬ
Dialogue: 0,0:02:32.71,0:02:35.67,Caption,,0,0,0,,ОБСУДИМ. ПОТОМУ ЧТО С ООН СЕГОДНЯ ВООБЩЕ ИСТОРИЯ
Dialogue: 0,0:02:35.67,0:02:41.14,Caption,,0,0,0,,ИНТЕРЕСНАЯ. ОРГАНИЗАЦИЯ КОГДА ТО СОЗДАВАЛАСЬ КАК МЕСТО,
Dialogue: 0,0:02:41.33,0:02:43.62,Caption,,0,0,0,,ГДЕ КРУПНЕЙШИЕ ДЕРЖАВЫ ХОТЯ БЫ ПЫТАЮТСЯ
Dialogue: 0,0:02:43.62,0:02:48.50,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ ДО ТОГО, КАК НАЧИНАЮТ ВЫЯСНЯТЬ ОТНОШЕНИЯ ДРУГИМИ СПОСОБАМИ. А
Dialogue: 0,0:02:48.50,0:02:51.94,Caption,,0,0,0,,СЕГОДНЯ РЕШЕНИЯ ООН ВСЁ ЧАЩЕ ЧИТАЮТ ПРИМЕРНО КАК
Dialogue: 0,0:02:51.94,0:02:55.06,Caption,,0,0,0,,ПРОГНОЗ ПОГОДЫ НА ПРОШЛУЮ НЕДЕЛЮ. КОМУ УДОБНО,
Dialogue: 0,0:02:55.29,0:02:59.70,Caption,,0,0,0,,ТОТ ССЫЛАЕТСЯ. КОМУ НЕУДОБНО, ТОТ ИДЁТ ДАЛЬШЕ ПО СВОИМ ДЕЛАМ. ТАК ЧТО
Dialogue: 0,0:02:59.78,0:03:03.54,Caption,,0,0,0,,Я ДАЖЕ НЕ ПОНЯЛ, ЛУКАШЕНКО ЗДЕСЬ ТРАМПУ ПОЛЬСТИЛ ИЛИ СЛЕГКА ЕГО
Dialogue: 0,0:03:03.54,0:03:07.30,Caption,,0,0,0,,ПОДКОЛОЛ. МОЛ, ДОНАЛЬД, ЕСЛИ ДОМА СОВСЕМ ДОСТАНУТ,
Dialogue: 0,0:03:07.46,0:03:10.58,Caption,,0,0,0,,ЕСТЬ ПРЕКРАСНАЯ ПОЧЁТНАЯ ДОЛЖНОСТЬ. ЗВУЧИТ ГРОМКО.
Dialogue: 0,0:03:10.83,0:03:13.78,Caption,,0,0,0,,РАБОТАТЬ МОЖНО ДОЛГО. А ОТВЕЧАТЬ ЗА ПРОИСХОДЯЩЕЕ В
Dialogue: 0,0:03:13.78,0:03:16.02,Caption,,0,0,0,,МИРЕ ВСЁ РАВНО БУДУТ СОВСЕМ ДРУГИЕ ЛЮДИ.
Dialogue: 0,0:03:16.66,0:03:18.50,Caption,,0,0,0,,И ВОТ КАК РАЗ С ЭТИМИ ДРУГИМИ ЛЮДЬМИ
Dialogue: 0,0:03:18.68,0:03:22.02,Caption,,0,0,0,,У ТРАМПА СЕЙЧАС ПРОБЛЕМ ХВАТАЕТ. THE ATLANTIC ПИШЕТ,
Dialogue: 0,0:03:22.26,0:03:24.90,Caption,,0,0,0,,ЧТО В ОКРУЖЕНИИ ПРЕЗИДЕНТА УЖЕ ОБСУЖДАЮТ,
Dialogue: 0,0:03:25.14,0:03:28.34,Caption,,0,0,0,,НА КОГО ПОВЕСИТЬ ЗАТЯНУВШУЮСЯ ВОЙНУ С ИРАНОМ. СРЕДИ
Dialogue: 0,0:03:28.42,0:03:31.06,Caption,,0,0,0,,ТЕХ, НА КОГО СМОТРЯТ ОСОБЕННО ВНИМАТЕЛЬНО,
Dialogue: 0,0:03:31.36,0:03:34.26,Caption,,0,0,0,,ГЛАВА ПЕНТАГОНА ПИТ ХЕГСЕТ И ПРЕДСЕДАТЕЛЬ
Dialogue: 0,0:03:34.26,0:03:37.30,Caption,,0,0,0,,ОБЪЕДИНЁННОГО КОМИТЕТА НАЧАЛЬНИКОВ ШТАБОВ ДЭН КЕЙН.
Dialogue: 0,0:03:37.91,0:03:41.14,Caption,,0,0,0,,ВОТ ЭТО УЖЕ ЗНАКОМАЯ ЧЕЛОВЕЧЕСКАЯ ТРАДИЦИЯ. КОГДА
Dialogue: 0,0:03:41.22,0:03:44.98,Caption,,0,0,0,,ВСЁ ИДЁТ ХОРОШО, У ПОБЕДЫ ЧЕЛОВЕК ПЯТЬДЕСЯТ РОДСТВЕННИКОВ. КОГДА
Dialogue: 0,0:03:44.98,0:03:48.02,Caption,,0,0,0,,ПЛОХО, НАЧИНАЮТ ИСКАТЬ ТОГО САМОГО МУЖИКА,
Dialogue: 0,0:03:48.20,0:03:51.94,Caption,,0,0,0,,КОТОРЫЙ ОДНАЖДЫ СКАЗАЛ, ЧТО ВСЁ ЗАКОНЧИТСЯ БЫСТРО. ТРАМПУ,
Dialogue: 0,0:03:52.02,0:03:54.42,Caption,,0,0,0,,СУДЯ ПО ЭТИМ СООБЩЕНИЯМ, НЕ НРАВИТСЯ,
Dialogue: 0,0:03:54.66,0:03:56.82,Caption,,0,0,0,,ЧТО БЫСТРОЙ ПРОГУЛКИ НЕ ПОЛУЧИЛОСЬ.
Dialogue: 0,0:03:59.09,0:04:01.09,Caption,,0,0,0,,СОВЕТНИКИ ДАВАЛИ БОДРЫЕ ОЦЕНКИ,
Dialogue: 0,0:04:01.26,0:04:03.97,Caption,,0,0,0,,ВОЙНА ЗАТЯНУЛАСЬ, БЕНЗИН ПОДОРОЖАЛ,
Dialogue: 0,0:04:04.13,0:04:07.33,Caption,,0,0,0,,ВЫБОРЫ ПРОИГРАНЫ. И ТЕПЕРЬ НАВЕРХУ НАЧИНАЮТ ЗАДАВАТЬ
Dialogue: 0,0:04:07.40,0:04:09.81,Caption,,0,0,0,,ОЧЕНЬ НЕПРИЯТНЫЙ ВОПРОС. МУЖИКИ,
Dialogue: 0,0:04:10.13,0:04:13.33,Caption,,0,0,0,,А КТО МНЕ ВООБЩЕ РАССКАЗЫВАЛ, ЧТО ВСЁ БУДЕТ БЫСТРО И КРАСИВО?
Dialogue: 0,0:04:13.83,0:04:16.53,Caption,,0,0,0,,ТОЛЬКО ИРАНУ, ПОХОЖЕ, СОВЕРШЕННО ВСЁ РАВНО,
Dialogue: 0,0:04:16.69,0:04:19.65,Caption,,0,0,0,,КОГО В ВАШИНГТОНЕ НАЗНАЧАТ ВИНОВАТЫМ. ТЕГЕРАН УЖЕ
Dialogue: 0,0:04:19.65,0:04:23.41,Caption,,0,0,0,,ПРЕДУПРЕДИЛ, ЧТО ПРИ НОВЫХ АМЕРИКАНСКИХ УДАРАХ ОТВЕТ ПРИЛЕТИТ НЕ
Dialogue: 0,0:04:23.49,0:04:26.37,Caption,,0,0,0,,ТОЛЬКО ТУДА, ГДЕ АМЕРИКАНЦЫ ПРИВЫКЛИ ЕГО ЖДАТЬ.
Dialogue: 0,0:04:27.08,0:04:29.41,Caption,,0,0,0,,КОРПУС СТРАЖЕЙ ИСЛАМСКОЙ РЕВОЛЮЦИИ ГОВОРИТ ОБ
Dialogue: 0,0:04:29.41,0:04:31.57,Caption,,0,0,0,,АМЕРИКАНСКИХ ВОЕННЫХ ОБЪЕКТАХ В ЕВРОПЕ.
Dialogue: 0,0:04:32.31,0:04:35.49,Caption,,0,0,0,,ВОТ ТУТ ЕВРОПЕЙЦАМ ДОЛЖНО СТАТЬ ОСОБЕННО ТЕПЛО.
Dialogue: 0,0:04:35.89,0:04:38.21,Caption,,0,0,0,,ПОТОМУ ЧТО ОДНО ДЕЛО СМОТРЕТЬ ВОЙНУ ПО ТЕЛЕВИЗОРУ
Dialogue: 0,0:04:38.29,0:04:42.05,Caption,,0,0,0,,И ОБСУЖДАТЬ, КАКОЙ СЛЕДУЮЩИЙ ПАКЕТ МЕР НУЖЕН ПРОТИВ ИРАНА. И
Dialogue: 0,0:04:42.05,0:04:44.13,Caption,,0,0,0,,СОВСЕМ ДРУГОЕ, КОГДА ТЕБЕ ГОВОРЯТ,
Dialogue: 0,0:04:44.39,0:04:47.01,Caption,,0,0,0,,ЧТО АМЕРИКАНСКАЯ БАЗА ГДЕ НИБУДЬ НА ЕВРОПЕЙСКОЙ
Dialogue: 0,0:04:47.01,0:04:49.17,Caption,,0,0,0,,ТЕРРИТОРИИ ТОЖЕ ВХОДИТ В СПИСОК.
Dialogue: 0,0:04:49.76,0:04:52.45,Caption,,0,0,0,,ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ ПОЛУЧАЕТСЯ. РЕШЕНИЕ
Dialogue: 0,0:04:52.45,0:04:55.49,Caption,,0,0,0,,ПРИНИМАЮТ В ВАШИНГТОНЕ. ВОЕВАТЬ НАЧИНАЮТ НА БЛИЖНЕМ
Dialogue: 0,0:04:55.57,0:04:58.05,Caption,,0,0,0,,ВОСТОКЕ. А ПРИЛЕТЕТЬ ЗА ЭТО СПОСОБНО УЖЕ В
Dialogue: 0,0:04:58.05,0:05:01.49,Caption,,0,0,0,,ЕВРОПУ. ЕСЛИ ВАМ ИНТЕРЕСНЫ ИМЕННО ТАКИЕ СВЯЗИ МЕЖДУ
Dialogue: 0,0:05:01.49,0:05:04.53,Caption,,0,0,0,,НОВОСТЯМИ, А НЕ ДВАДЦАТЬ ОДИНАКОВЫХ ЗАГОЛОВКОВ ЗА ДЕНЬ,
Dialogue: 0,0:05:04.75,0:05:07.97,Caption,,0,0,0,,ПОДПИШИТЕСЬ. СТРАНЫ ПЕРСИДСКОГО ЗАЛИВА ТОЖЕ ЧТО ТО
Dialogue: 0,0:05:08.05,0:05:10.69,Caption,,0,0,0,,ПЕРЕСТАЛИ ХЛОПАТЬ В ЛАДОШИ. BLOOMBERG ПИШЕТ,
Dialogue: 0,0:05:11.01,0:05:13.41,Caption,,0,0,0,,ЧТО ТАМ СЕРЬЁЗНО ОПАСАЮТСЯ НОВОГО РАУНДА
Dialogue: 0,0:05:13.41,0:05:19.60,Caption,,0,0,0,,АМЕРИКАНСКИХ УДАРОВ. ПОТОМУ ЧТО ИРАН ЗА ВРЕМЯ КОНФЛИКТА УЖЕ ПОКАЗАЛ,
Dialogue: 0,0:05:19.73,0:05:22.32,Caption,,0,0,0,,ЧТО СПОСОБЕН ОТВЕЧАТЬ РАКЕТАМИ И БЕСПИЛОТНИКАМИ В
Dialogue: 0,0:05:22.32,0:05:26.24,Caption,,0,0,0,,ОГРОМНЫХ КОЛИЧЕСТВАХ. А ЕСЛИ СНОВА РАЗГОНИТСЯ БОЛЬШАЯ ВОЙНА,
Dialogue: 0,0:05:26.64,0:05:29.52,Caption,,0,0,0,,РАСПЛАЧИВАТЬСЯ БУДУТ НЕ ТОЛЬКО ИРАН И США. БУДУТ
Dialogue: 0,0:05:29.52,0:05:32.72,Caption,,0,0,0,,РАСПЛАЧИВАТЬСЯ ВСЕ ВОКРУГ. ЧЕРЕЗ НЕФТЬ. ЧЕРЕЗ
Dialogue: 0,0:05:32.80,0:05:37.44,Caption,,0,0,0,,ОРМУЗСКИЙ ПРОЛИВ. ЧЕРЕЗ ТОРГОВЛЮ. ЧЕРЕЗ ИНВЕСТИЦИИ. ЧЕРЕЗ СОБСТВЕННУЮ
Dialogue: 0,0:05:37.44,0:05:40.56,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. И ВОТ В ЭТОМ МЕСТЕ СТАРАЯ ДОБРАЯ
Dialogue: 0,0:05:40.56,0:05:43.28,Caption,,0,0,0,,СХЕМА, ГДЕ КТО ТО НАЧИНАЕТ ВОЙНУ,
Dialogue: 0,0:05:43.52,0:05:45.92,Caption,,0,0,0,,А ВСЕ ОСТАЛЬНЫЕ СПОКОЙНО СТОЯТ РЯДОМ И СЧИТАЮТ
Dialogue: 0,0:05:45.92,0:05:48.08,Caption,,0,0,0,,ПРИБЫЛЬ, НАЧИНАЕТ НЕМНОГО ЛОМАТЬСЯ.
Dialogue: 0,0:05:48.92,0:05:53.68,Caption,,0,0,0,,А ТЕПЕРЬ ВОЗВРАЩАЕМСЯ К ТОМУ, С ЧЕГО НАЧАЛИ. ПОТОМУ ЧТО ИРАН НАЧАЛ ПУБЛИКОВАТЬ
Dialogue: 0,0:05:53.76,0:05:55.44,Caption,,0,0,0,,ДЛЯ НАСЕЛЕНИЯ ИНСТРУКЦИИ О ТОМ,
Dialogue: 0,0:05:55.72,0:05:58.64,Caption,,0,0,0,,КАК ВЕСТИ СЕБЯ ПРИ ЯДЕРНОМ ВЗРЫВЕ. НЕ СМОТРЕТЬ
Dialogue: 0,0:05:58.72,0:06:02.32,Caption,,0,0,0,,НА ВСПЫШКУ. НАЙТИ УКРЫТИЕ. ЛЕЧЬ НА ЗЕМЛЮ. ЗАКРЫТЬ
Dialogue: 0,0:06:02.32,0:06:06.00,Caption,,0,0,0,,ГОЛОВУ. ПОТОМ ВОЙТИ В ПОМЕЩЕНИЕ. УЙТИ ОТ ОКОН.
Dialogue: 0,0:06:06.38,0:06:09.28,Caption,,0,0,0,,СНЯТЬ ВЕРХНЮЮ ОДЕЖДУ. ИСПОЛЬЗОВАТЬ ЗАПАС ВОДЫ И
Dialogue: 0,0:06:09.36,0:06:12.80,Caption,,0,0,0,,ПРОДУКТОВ. БЫТЬ ГОТОВЫМ ОСТАВАТЬСЯ В УКРЫТИИ. ВОТ
Dialogue: 0,0:06:12.88,0:06:14.80,Caption,,0,0,0,,ЭТИ СЛОВА Я СЕЙЧАС ЧИТАЮ И ПОНИМАЮ,
Dialogue: 0,0:06:14.96,0:06:17.60,Caption,,0,0,0,,ЧТО ОЧЕНЬ МНОГИЕ ЗРИТЕЛИ МОЕГО ВОЗРАСТА И СТАРШЕ
Dialogue: 0,0:06:17.68,0:06:20.96,Caption,,0,0,0,,УЖЕ ГДЕ ТО ЭТО СЛЫШАЛИ. СОВЕТСКИЙ СОЮЗ. ГРАЖДАНСКАЯ
Dialogue: 0,0:06:20.96,0:06:25.28,Caption,,0,0,0,,ОБОРОНА. ШКОЛЫ. ПЛАКАТЫ. ПРОТИВОГАЗЫ. ЧТО ДЕЛАТЬ ПРИ
Dialogue: 0,0:06:25.28,0:06:28.40,Caption,,0,0,0,,ВСПЫШКЕ. КУДА БЕЖАТЬ. ГДЕ УКРЫВАТЬСЯ. КАК
Dialogue: 0,0:06:28.40,0:06:31.12,Caption,,0,0,0,,ДЕЙСТВОВАТЬ ПОСЛЕ СИГНАЛА ТРЕВОГИ. КТО ЖИЛ В ТЕ
Dialogue: 0,0:06:31.20,0:06:35.04,Caption,,0,0,0,,ГОДЫ, ПРЕКРАСНО ПОМНИТ ЭТУ АТМОСФЕРУ. НАТО С ОДНОЙ
Dialogue: 0,0:06:35.12,0:06:41.41,Caption,,0,0,0,,СТОРОНЫ. СССР И ВАРШАВСКИЙ ДОГОВОР С ДРУГОЙ. ЯДЕРНОЕ ОРУЖИЕ
Dialogue: 0,0:06:41.41,0:06:45.25,Caption,,0,0,0,,У ВСЕХ. РИТОРИКА ТАКАЯ, ЧТО ВЗРОСЛЫЕ ОБСУЖДАЮТ РАКЕТЫ,
Dialogue: 0,0:06:45.63,0:06:49.33,Caption,,0,0,0,,А ДЕТЕЙ УЧАТ, КАК ПРАВИЛЬНО ЛЕЧЬ НОГАМИ В СТОРОНУ ВЗРЫВА. И
Dialogue: 0,0:06:49.41,0:06:51.25,Caption,,0,0,0,,ВЕДЬ ПОТОМ ДЕСЯТИЛЕТИЯМИ КАЗАЛОСЬ,
Dialogue: 0,0:06:51.49,0:06:54.21,Caption,,0,0,0,,ЧТО ЧЕЛОВЕЧЕСТВО ВСЁ ТАКИ НЕМНОГО ПОУМНЕЛО. НЕ
Dialogue: 0,0:06:54.21,0:06:57.73,Caption,,0,0,0,,НАСТОЛЬКО, ЧТОБЫ ПЕРЕСТАТЬ ВОЕВАТЬ. НО ХОТЯ БЫ НАСТОЛЬКО,
Dialogue: 0,0:06:57.96,0:07:00.69,Caption,,0,0,0,,ЧТОБЫ ТАКИЕ ИНСТРУКЦИИ НЕ ВОЗВРАЩАЛИСЬ В ОБЫЧНУЮ
Dialogue: 0,0:07:00.69,0:07:03.97,Caption,,0,0,0,,ИНФОРМАЦИОННУЮ ПОВЕСТКУ. А ТЕПЕРЬ ВЕРНУЛИСЬ. ТРАМП
Dialogue: 0,0:07:03.97,0:07:07.57,Caption,,0,0,0,,ГОВОРИТ, ЧТО ПРИМЕНЯТЬ ЯДЕРНОЕ ОРУЖИЕ ПРОТИВ ИРАНА ОН НЕ
Dialogue: 0,0:07:07.57,0:07:12.05,Caption,,0,0,0,,СОБИРАЕТСЯ. ХОРОШО. ТОЛЬКО ПРО ЯДЕРНЫЙ УДАР ЗА ПОСЛЕДНИЕ ДНИ ГОВОРИЛИ
Dialogue: 0,0:07:12.13,0:07:14.61,Caption,,0,0,0,,УЖЕ СТОЛЬКО, ЧТО ОДНОГО ЗАЯВЛЕНИЯ МАЛО,
Dialogue: 0,0:07:14.77,0:07:17.57,Caption,,0,0,0,,ЧТОБЫ ВСЕ ДРУЖНО РАССЛАБИЛИСЬ. ТАКЕР КАРЛСОН
Dialogue: 0,0:07:17.57,0:07:21.57,Caption,,0,0,0,,ПУБЛИЧНО ЗАЯВИЛ, ЧТО В ОКРУЖЕНИИ ТРАМПА ОБСУЖДАЕТСЯ ИМЕННО ТАКОЙ
Dialogue: 0,0:07:21.65,0:07:25.09,Caption,,0,0,0,,СЦЕНАРИЙ И ЧТО ДАВЛЕНИЕ ИДЁТ ВОКРУГ ВОЗМОЖНОГО УДАРА
Dialogue: 0,0:07:25.09,0:07:28.53,Caption,,0,0,0,,ПО ГЛУБОКО РАСПОЛОЖЕННОМУ ИРАНСКОМУ ОБЪЕКТУ. КАРЛСОН
Dialogue: 0,0:07:28.53,0:07:31.09,Caption,,0,0,0,,НЕ СИДИТ В ПЕНТАГОНЕ И НЕ ОТДАЁТ ПРИКАЗЫ.
Dialogue: 0,0:07:31.38,0:07:33.65,Caption,,0,0,0,,НО ЕГО ЗАЯВЛЕНИЕ РАЗЛЕТЕЛОСЬ ПО ВСЕМУ МИРУ.
Dialogue: 0,0:07:33.88,0:07:36.21,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ИДУТ РАЗГОВОРЫ О НОВЫХ АМЕРИКАНСКИХ
Dialogue: 0,0:07:36.21,0:07:39.73,Caption,,0,0,0,,УДАРАХ. ПАРАЛЛЕЛЬНО ИРАН ГОТОВИТ НАСЕЛЕНИЕ К САМОМУ
Dialogue: 0,0:07:39.73,0:07:42.93,Caption,,0,0,0,,ТЯЖЁЛОМУ СЦЕНАРИЮ. ПАРАЛЛЕЛЬНО САМ ТРАМП ГОВОРИТ О
Dialogue: 0,0:07:42.93,0:07:46.61,Caption,,0,0,0,,СОКРУШИТЕЛЬНОМ УДАРЕ, ЕСЛИ СОЕДИНЁННЫМ ШТАТАМ ПРИДЁТСЯ ПРЕДПРИНИМАТЬ
Dialogue: 0,0:07:46.61,0:07:52.17,Caption,,0,0,0,,СЕРЬЁЗНЫЕ ШАГИ. И ПОСЛЕ ЭТОГО НАМ ПРЕДЛАГАЮТ ПРОСТО УСПОКОИТЬСЯ,
Dialogue: 0,0:07:52.41,0:07:56.73,Caption,,0,0,0,,ПОТОМУ ЧТО ПРЕЗИДЕНТ СКАЗАЛ, ЧТО ЯДЕРНОЕ ОРУЖИЕ ИСПОЛЬЗОВАТЬ НЕ СОБИРАЕТСЯ. НУ
Dialogue: 0,0:07:56.81,0:07:59.21,Caption,,0,0,0,,ХОРОШО. ТОЛЬКО ДЫМ БЕЗ ОГНЯ ОБЫЧНО САМ ПО
Dialogue: 0,0:07:59.21,0:08:01.93,Caption,,0,0,0,,СЕБЕ НЕ ПОЯВЛЯЕТСЯ. Я СЕЙЧАС НЕ ПРО ТО,
Dialogue: 0,0:08:02.17,0:08:04.81,Caption,,0,0,0,,ЧТО ЗАВТРА ОБЯЗАТЕЛЬНО ЧТО ТО ПРОИЗОЙДЁТ. Я ПРО
Dialogue: 0,0:08:04.89,0:08:08.01,Caption,,0,0,0,,ДРУГОЕ. КОГДА СЛОВО ЯДЕРНЫЙ НАЧИНАЕТ СЛИШКОМ ЧАСТО
Dialogue: 0,0:08:08.09,0:08:09.85,Caption,,0,0,0,,ЗВУЧАТЬ СРАЗУ В НЕСКОЛЬКИХ МЕСТАХ,
Dialogue: 0,0:08:10.25,0:08:11.85,Caption,,0,0,0,,А ЛЮДЯМ ПАРАЛЛЕЛЬНО ОБЪЯСНЯЮТ,
Dialogue: 0,0:08:12.01,0:08:16.49,Caption,,0,0,0,,ЧТО ДЕЛАТЬ ПОСЛЕ ВСПЫШКИ, САМА МЕЖДУНАРОДНАЯ ОБСТАНОВКА УЖЕ ДОШЛА ДО ОЧЕНЬ
Dialogue: 0,0:08:16.49,0:08:19.21,Caption,,0,0,0,,ПЛОХОЙ ТОЧКИ. ИРАН, СУДЯ ПО ВСЕМУ,
Dialogue: 0,0:08:19.45,0:08:23.69,Caption,,0,0,0,,РЕШИЛ ВООБЩЕ НЕ ГАДАТЬ, ЧТО ИМЕННО БУДЕТ ДЕЛАТЬ ТРАМП. ТАМ ГОТОВЯТСЯ КО
Dialogue: 0,0:08:23.69,0:08:26.73,Caption,,0,0,0,,ВСЕМУ. И ЗНАЕТЕ, ЧТО ЗДЕСЬ ОСОБЕННО ПЕЧАЛЬНО?
Dialogue: 0,0:08:27.00,0:08:31.37,Caption,,0,0,0,,МЫ СНОВА ДОШЛИ ДО МОМЕНТА, КОГДА НОРМАЛЬНОМУ ЧЕЛОВЕКУ ПРИХОДИТСЯ ОБСУЖДАТЬ НЕ
Dialogue: 0,0:08:31.37,0:08:35.61,Caption,,0,0,0,,ЦЕНЫ, НЕ РАБОТУ, НЕ ОТПУСК И ДАЖЕ НЕ ОБЫЧНУЮ ВОЙНУ,
Dialogue: 0,0:08:35.93,0:08:39.45,Caption,,0,0,0,,А ТО, ЧТО ДЕЛАТЬ ПОСЛЕ ЯДЕРНОЙ ВСПЫШКИ. ВОТ ЭТО
Dialogue: 0,0:08:39.45,0:08:42.33,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ДОСТИЖЕНИЕ ДВАДЦАТЬ ПЕРВОГО ВЕКА. А
Dialogue: 0,0:08:42.41,0:08:44.89,Caption,,0,0,0,,ТРАМП ПРИ ЭТОМ ОКАЗАЛСЯ В ОЧЕНЬ СТРАННОМ ПОЛОЖЕНИИ.
Dialogue: 0,0:08:45.37,0:08:47.85,Caption,,0,0,0,,ДОМА ОН ТОЛЬКО ЧТО ПОЛУЧИЛ КОНГРЕСС ПРОТИВ СЕБЯ.
Dialogue: 0,0:08:48.06,0:08:50.33,Caption,,0,0,0,,ВОЙНА С ИРАНОМ УЖЕ УДАРИЛА ПО НЕМУ ВНУТРИ
Dialogue: 0,0:08:50.33,0:08:53.37,Caption,,0,0,0,,СТРАНЫ ЧЕРЕЗ БЕНЗИН И ВЫБОРЫ. ВОЕННЫЕ РЕЗУЛЬТАТЫ НЕ
Dialogue: 0,0:08:53.37,0:08:57.29,Caption,,0,0,0,,ВЫГЛЯДЯТ ТАК, КАК ОБЕЩАЛИ ОПТИМИСТЫ. СТРАНЫ ЗАЛИВА ХОТЯТ
Dialogue: 0,0:08:57.29,0:09:00.17,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ВЫХОД. ИРАН УГРОЖАЕТ АМЕРИКАНСКИМ
Dialogue: 0,0:09:00.17,0:09:02.73,Caption,,0,0,0,,ОБЪЕКТАМ УЖЕ ЗА ПРЕДЕЛАМИ БЛИЖНЕГО ВОСТОКА.
Dialogue: 0,0:09:05.01,0:09:07.49,Caption,,0,0,0,,И НА ЭТОМ ФОНЕ ВАШИНГТОН ЕЩЁ ХОЧЕТ РАЗГОВАРИВАТЬ
Dialogue: 0,0:09:07.57,0:09:10.77,Caption,,0,0,0,,С СЕВЕРНОЙ КОРЕЕЙ. А ПХЕНЬЯН ОТВЕЧАЕТ ПРИМЕРНО ТАК.
Dialogue: 0,0:09:11.24,0:09:14.77,Caption,,0,0,0,,РЕБЯТА, ДА НУ ВАС. КИМ Ё ЧЖОН ПРЯМО ЗАЯВИЛА,
Dialogue: 0,0:09:14.97,0:09:17.81,Caption,,0,0,0,,ЧТО СЕВЕРНАЯ КОРЕЯ НЕ ВИДИТ НЕОБХОДИМОСТИ САДИТЬСЯ
Dialogue: 0,0:09:17.89,0:09:20.61,Caption,,0,0,0,,ЗА СТОЛ С НЕНАДЁЖНЫМИ И ВРАЖДЕБНЫМИ ЛЮДЬМИ,
Dialogue: 0,0:09:20.85,0:09:25.09,Caption,,0,0,0,,КОТОРЫЕ ГОВОРЯТ О ДИАЛОГЕ, НО ПРОДОЛЖАЮТ ПОЛИТИКУ ДАВЛЕНИЯ. ВОТ ЭТО ХОТЯ БЫ
Dialogue: 0,0:09:25.09,0:09:27.89,Caption,,0,0,0,,ЧЕСТНО. НЕ ДИПЛОМАТИЧЕСКАЯ ПРОСТЫНЯ НА СОРОК
Dialogue: 0,0:09:27.89,0:09:30.29,Caption,,0,0,0,,СТРАНИЦ. НЕ ЗАЯВЛЕНИЕ О ПРИВЕРЖЕННОСТИ
Dialogue: 0,0:09:30.29,0:09:32.77,Caption,,0,0,0,,КОНСТРУКТИВНОМУ ВЗАИМОДЕЙСТВИЮ. НОРМАЛЬНЫМ
Dialogue: 0,0:09:32.77,0:09:35.97,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКИМ ЯЗЫКОМ. МЫ ВАМ НЕ ВЕРИМ. ВАШИНГТОН
Dialogue: 0,0:09:35.97,0:09:38.37,Caption,,0,0,0,,ГОВОРИТ О ПЕРЕГОВОРАХ. ПАРАЛЛЕЛЬНО ИДУТ ВОЕННЫЕ
Dialogue: 0,0:09:38.37,0:09:41.65,Caption,,0,0,0,,УЧЕНИЯ. ВАШИНГТОН ТРЕБУЕТ ДЕНУКЛЕАРИЗАЦИИ. ПХЕНЬЯН
Dialogue: 0,0:09:41.65,0:09:44.69,Caption,,0,0,0,,СМОТРИТ НА ПРОИСХОДЯЩЕЕ ВОКРУГ ИРАНА. И ЧЕГО,
Dialogue: 0,0:09:44.80,0:09:47.65,Caption,,0,0,0,,СОБСТВЕННО, СЕВЕРНАЯ КОРЕЯ ДОЛЖНА РЕШИТЬ?
Dialogue: 0,0:09:47.93,0:09:52.29,Caption,,0,0,0,,РЕБЯТА, ОТЛИЧНАЯ ИДЕЯ. ДАВАЙТЕ ОТДАДИМ СВОЮ ЯДЕРНУЮ ДУБИНУ,
Dialogue: 0,0:09:52.53,0:09:55.81,Caption,,0,0,0,,А ДАЛЬШЕ БУДЕМ НАДЕЯТЬСЯ, ЧТО ВЫ ВСЕГДА БУДЕТЕ ДОБРЫМИ,
Dialogue: 0,0:09:55.90,0:09:58.61,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНЫМИ И БУДЕТЕ ВЫПОЛНЯТЬ ВСЁ,
Dialogue: 0,0:09:58.77,0:10:01.81,Caption,,0,0,0,,ЧТО КОГДА НИБУДЬ ОБЕЩАЛИ. НУ КОНЕЧНО. КНДР
Dialogue: 0,0:10:01.81,0:10:04.69,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯМИ СТРОИЛА ВСЮ СВОЮ БЕЗОПАСНОСТЬ ВОКРУГ
Dialogue: 0,0:10:04.69,0:10:07.57,Caption,,0,0,0,,ТОГО, ЧТОБЫ НИКТО ДАЖЕ НЕ ПОДУМАЛ РЕШАТЬ ВОПРОС С
Dialogue: 0,0:10:07.57,0:10:10.61,Caption,,0,0,0,,НЕЙ СИЛОЙ. И СЕЙЧАС ОНИ СОВЕРШЕННО ОТКРЫТО ГОВОРЯТ,
Dialogue: 0,0:10:10.88,0:10:13.65,Caption,,0,0,0,,ЧТО АМЕРИКАНЦЕВ СЧИТАЮТ НЕНАДЁЖНЫМИ. ИРАН ЗДЕСЬ
Dialogue: 0,0:10:13.65,0:10:16.61,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ОЧЕНЬ ПЛОХАЯ РЕКЛАМА ЛЮБЫХ РАЗГОВОРОВ
Dialogue: 0,0:10:16.69,0:10:21.94,Caption,,0,0,0,,О ДОВЕРИИ. ПОТОМУ ЧТО КОГДА ОДНА СТРАНА СМОТРИТ НА ДРУГУЮ
Dialogue: 0,0:10:22.02,0:10:25.30,Caption,,0,0,0,,И РЕШАЕТ, ОТДАВАТЬ ЛИ ЕЙ ГЛАВНЫЙ ИНСТРУМЕНТ СОБСТВЕННОГО
Dialogue: 0,0:10:25.30,0:10:29.62,Caption,,0,0,0,,СДЕРЖИВАНИЯ, ОНА ИЗУЧАЕТ НЕ КРАСИВЫЕ РЕЧИ. ОНА ИЗУЧАЕТ,
Dialogue: 0,0:10:29.85,0:10:32.90,Caption,,0,0,0,,ЧТО ПРОИСХОДИЛО С ДРУГИМИ СТРАНАМИ. КТО ДОГОВОРИЛСЯ.
Dialogue: 0,0:10:33.30,0:10:36.42,Caption,,0,0,0,,КТО ОТКАЗАЛСЯ. КОМУ ЧТО ОБЕЩАЛИ. КОГО ПОТОМ
Dialogue: 0,0:10:36.42,0:10:39.46,Caption,,0,0,0,,АТАКОВАЛИ. ВОТ ЭТО И ЕСТЬ РЕАЛЬНАЯ ДИПЛОМАТИЯ,
Dialogue: 0,0:10:39.78,0:10:42.66,Caption,,0,0,0,,БЕЗ ГАЛСТУКОВ И КРАСИВЫХ ЗАЛОВ. ПОЭТОМУ СЕЙЧАС
Dialogue: 0,0:10:42.66,0:10:45.70,Caption,,0,0,0,,ВОКРУГ ТРАМПА СЛОЖИЛАСЬ ЗАНЯТНАЯ КОНСТРУКЦИЯ. ВНУТРИ
Dialogue: 0,0:10:45.78,0:10:47.94,Caption,,0,0,0,,США ЕМУ ГОВОРЯТ МЫ УСТАЛИ ПЛАТИТЬ ЗА ЭТУ
Dialogue: 0,0:10:47.94,0:10:50.90,Caption,,0,0,0,,ПОЛИТИКУ. ЛУКАШЕНКО ПРЕДЛАГАЕТ УТЕШИТЬСЯ КРЕСЛОМ В
Dialogue: 0,0:10:50.98,0:10:54.10,Caption,,0,0,0,,ООН. ИРАН ГОВОРИТ МЫ ГОТОВИМСЯ КО ВСЕМУ. КНДР
Dialogue: 0,0:10:54.18,0:10:56.26,Caption,,0,0,0,,ГОВОРИТ МЫ ВАМ НЕ ВЕРИМ. И ВСЁ ЭТО
Dialogue: 0,0:10:56.26,0:10:58.02,Caption,,0,0,0,,ПРОИСХОДИТ ПРАКТИЧЕСКИ ОДНОВРЕМЕННО.
Dialogue: 0,0:10:58.76,0:11:00.82,Caption,,0,0,0,,И Я БЫ СЕЙЧАС НЕ СПЕШИЛ СМЕЯТЬСЯ НАД
Dialogue: 0,0:11:00.82,0:11:03.62,Caption,,0,0,0,,КАЖДЫМ ИЗ ЭТИХ ЭПИЗОДОВ ОТДЕЛЬНО. ПОТОМУ ЧТО У
Dialogue: 0,0:11:03.70,0:11:06.82,Caption,,0,0,0,,НИХ ЕСТЬ ОДНА НЕПРИЯТНАЯ ОБЩАЯ ДЕТАЛЬ. СЛОВА ВСЁ
Dialogue: 0,0:11:06.90,0:11:08.82,Caption,,0,0,0,,ДЕШЕВЛЕ. КАЖДЫЙ ХОЧЕТ УВИДЕТЬ,
Dialogue: 0,0:11:08.99,0:11:11.22,Caption,,0,0,0,,ЧТО ТЫ РЕАЛЬНО СПОСОБЕН СДЕЛАТЬ И ЧТО ТЫ
Dialogue: 0,0:11:11.30,0:11:13.94,Caption,,0,0,0,,РЕАЛЬНО ГОТОВ ВЫПОЛНИТЬ. А ВОТ С ЭТИМ У
Dialogue: 0,0:11:13.94,0:11:16.26,Caption,,0,0,0,,СОВРЕМЕННОЙ БОЛЬШОЙ ПОЛИТИКИ ВСЁ ХУЖЕ.
Dialogue: 0,0:11:17.02,0:11:19.70,Caption,,0,0,0,,РАНЬШЕ ЯДЕРНЫЕ ИНСТРУКЦИИ ВИСЕЛИ В СОВЕТСКИХ ШКОЛАХ,
Dialogue: 0,0:11:20.02,0:11:22.58,Caption,,0,0,0,,ПОТОМУ ЧТО МИР СТОЯЛ МЕЖДУ ДВУМЯ ВОЕННЫМИ БЛОКАМИ
Dialogue: 0,0:11:22.66,0:11:27.14,Caption,,0,0,0,,И КАЖДЫЙ ПРЕКРАСНО ПОНИМАЛ, ЧЕМ ЗАКОНЧИТСЯ ОШИБКА. ПОТОМ ЭТИ ПЛАКАТЫ УБРАЛИ.
Dialogue: 0,0:11:27.69,0:11:30.90,Caption,,0,0,0,,ОЧЕНЬ ХОТЕЛОСЬ ВЕРИТЬ, ЧТО НАВСЕГДА. НЕ ПОЛУЧИЛОСЬ.
