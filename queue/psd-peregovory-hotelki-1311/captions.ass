Dialogue: 0,0:00:00.12,0:00:03.40,Caption,,0,0,0,,РАУНД В АБУ ДАБИ ЗАКРЫЛИ, И В ЭФИР СРАЗУ ПОШЛО СЛОВО,
Dialogue: 0,0:00:03.64,0:00:06.44,Caption,,0,0,0,,КОТОРОЕ МЫ СЛЫШИМ ВТОРОЙ ГОД ПОДРЯД. ПРОГРЕСС.
Dialogue: 0,0:00:06.84,0:00:09.16,Caption,,0,0,0,,ПЕРЕВОДИМ С ДИПЛОМАТИЧЕСКОГО ВСТРЕТИЛИСЬ,
Dialogue: 0,0:00:09.26,0:00:13.32,Caption,,0,0,0,,ПОГОВОРИЛИ, УСЛОВИЛИСЬ ВСТРЕТИТЬСЯ ЕЩЁ РАЗ. А ПОКА ВСЕ СЧИТАЮТ
Dialogue: 0,0:00:13.32,0:00:16.60,Caption,,0,0,0,,РУКОПОЖАТИЯ, ИЗ ВИДУ ТЕРЯЕТСЯ ЕДИНСТВЕННЫЙ ВОПРОС,
Dialogue: 0,0:00:16.76,0:00:19.80,Caption,,0,0,0,,ОТ КОТОРОГО ЗАВИСИТ ВООБЩЕ ВСЁ. О КАКОЙ УКРАИНЕ
Dialogue: 0,0:00:19.88,0:00:22.84,Caption,,0,0,0,,ИДЁТ РЕЧЬ, КОГДА ЗА СТОЛОМ ОБСУЖДАЮТ ЕЁ БУДУЩЕЕ?
Dialogue: 0,0:00:23.24,0:00:25.56,Caption,,0,0,0,,О ТОЙ, ЧТО СУЩЕСТВУЕТ СЕГОДНЯ,
Dialogue: 0,0:00:25.84,0:00:27.96,Caption,,0,0,0,,ИЛИ О ГОСУДАРСТВЕ С ДРУГИМИ ГРАНИЦАМИ,
Dialogue: 0,0:00:28.12,0:00:30.36,Caption,,0,0,0,,ДРУГОЙ АРМИЕЙ И ДРУГИМ КУРСОМ?
Dialogue: 0,0:00:32.56,0:00:34.40,Caption,,0,0,0,,ЕСЛИ ВАМ БЛИЖЕ РАЗБОР УСЛОВИЙ,
Dialogue: 0,0:00:34.56,0:00:38.00,Caption,,0,0,0,,А НЕ ПРОТОКОЛ ВСТРЕЧ, ПОДПИШИТЕСЬ. ДАЛЬШЕ ПОЙДУТ ЦИФРЫ,
Dialogue: 0,0:00:38.25,0:00:41.04,Caption,,0,0,0,,РЯДОМ С КОТОРЫМИ СЛОВО "ПРОГРЕСС" ЗВУЧИТ ОСОБЕННО
Dialogue: 0,0:00:41.04,0:00:46.44,Caption,,0,0,0,,НАРЯДНО. В ОФИЦИАЛЬНОМ ИЗЛОЖЕНИИ ИТОГ РАУНДА ВЫГЛЯДИТ ПОЧТИ
Dialogue: 0,0:00:46.44,0:00:49.16,Caption,,0,0,0,,ПРАЗДНИЧНЫМ. ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ ЕСТЬ
Dialogue: 0,0:00:49.16,0:00:52.60,Caption,,0,0,0,,ДВИЖЕНИЕ. ОБМЕН ПЛЕННЫМИ СОГЛАСОВАН. АМЕРИКАНСКАЯ
Dialogue: 0,0:00:52.68,0:00:55.32,Caption,,0,0,0,,ДЕЛЕГАЦИЯ ПОЕДЕТ ДАЛЬШЕ. СЛЕДУЮЩАЯ ВСТРЕЧА
Dialogue: 0,0:00:55.32,0:00:58.28,Caption,,0,0,0,,НАЗНАЧЕНА. ЕСЛИ СЛУШАТЬ ТОЛЬКО ЭТИ ФОРМУЛИРОВКИ,
Dialogue: 0,0:00:58.51,0:01:01.24,Caption,,0,0,0,,ОСТАЁТСЯ ЗАКАЗАТЬ ЗАЛ И НАПЕЧАТАТЬ ПРИГЛАШЕНИЯ.
Dialogue: 0,0:01:03.52,0:01:06.40,Caption,,0,0,0,,НАЗНАЧЕННАЯ ВСТРЕЧА ЭТО ПОКА НЕ СОГЛАСИЕ. ЭТО
Dialogue: 0,0:01:06.40,0:01:12.52,Caption,,0,0,0,,РАСПИСАНИЕ. ОБМЕН ПЛЕННЫМИ ТОЖЕ СТОИТ ОЦЕНИВАТЬ ТРЕЗВО. ЭТО
Dialogue: 0,0:01:12.52,0:01:16.36,Caption,,0,0,0,,ГУМАНИТАРНЫЙ ПУНКТ, ПО НЕМУ ДОГОВАРИВАЮТСЯ И В САМЫЕ ГЛУХИЕ ПЕРИОДЫ
Dialogue: 0,0:01:16.36,0:01:19.96,Caption,,0,0,0,,КОНФЛИКТА. ОН ВОЗВРАЩАЕТ ЛЮДЕЙ ДОМОЙ И НЕ СДВИГАЕТ
Dialogue: 0,0:01:19.96,0:01:23.00,Caption,,0,0,0,,НИ ОДНОГО УСЛОВИЯ БУДУЩЕГО СОГЛАШЕНИЯ НИ ЛИНИИ НА
Dialogue: 0,0:01:23.00,0:01:26.76,Caption,,0,0,0,,КАРТЕ, НИ ЧИСЛЕННОСТИ ВОЙСК, НИ ОБЯЗАТЕЛЬСТВ ЕВРОПЫ.
Dialogue: 0,0:01:29.04,0:01:31.28,Caption,,0,0,0,,ПРОВЕРИТЬ РЕЗУЛЬТАТ МОЖНО БЕЗ СЛОЖНЫХ СХЕМ.
Dialogue: 0,0:01:31.51,0:01:34.08,Caption,,0,0,0,,ДОСТАТОЧНО ЗАДАТЬ ЧЕТЫРЕ ВОПРОСА И ДОЖДАТЬСЯ
Dialogue: 0,0:01:34.08,0:01:37.52,Caption,,0,0,0,,ОТВЕТОВ. МОСКВА СНЯЛА ТРЕБОВАНИЕ О ДЕМИЛИТАРИЗАЦИИ?
Dialogue: 0,0:01:37.68,0:01:40.72,Caption,,0,0,0,,НЕ СНЯЛА. ОТКАЗАЛАСЬ ОТ ТЕРРИТОРИАЛЬНЫХ ПРЕТЕНЗИЙ?
Dialogue: 0,0:01:40.80,0:01:45.52,Caption,,0,0,0,,НЕ ОТКАЗАЛАСЬ. СООБЩИЛА, ЧТО ЕЁ УСТРОИТ ЛЮБАЯ УКРАИНА С ЛЮБЫМ КУРСОМ
Dialogue: 0,0:01:45.60,0:01:48.00,Caption,,0,0,0,,И ЛЮБОЙ АРМИЕЙ, ЛИШЬ БЫ ПОДПИСЬ СТОЯЛА?
Dialogue: 0,0:01:48.15,0:01:50.24,Caption,,0,0,0,,ТАКОГО НЕ ПРОЗВУЧАЛО. ОБЪЯВИЛА,
Dialogue: 0,0:01:50.40,0:01:52.64,Caption,,0,0,0,,ЧТО ЗАЯВЛЕННЫЕ ЦЕЛИ БОЛЬШЕ НЕ ДЕЙСТВУЮТ?
Dialogue: 0,0:01:52.84,0:01:57.95,Caption,,0,0,0,,ТОЖЕ НЕТ. СЕРГЕЙ ЛАВРОВ ПОСЛЕ ПЕРЕГОВОРОВ ПОВТОРИЛ,
Dialogue: 0,0:01:58.27,0:02:00.83,Caption,,0,0,0,,ЧТО РОССИЙСКАЯ ЛИНИЯ ПРИВЯЗАНА К ДОСТИЖЕНИЮ ЦЕЛЕЙ
Dialogue: 0,0:02:00.83,0:02:03.79,Caption,,0,0,0,,МОСКВЫ. В АБУ ДАБИ ОБСУЖДАЛИ БУДУЩУЮ СИСТЕМУ
Dialogue: 0,0:02:03.79,0:02:07.95,Caption,,0,0,0,,БЕЗОПАСНОСТИ В ЕВРОПЕ, А ПО ТЕРРИТОРИЯМ ПУБЛИЧНОГО ПРОРЫВА НЕ СЛУЧИЛОСЬ.
Dialogue: 0,0:02:10.24,0:02:13.04,Caption,,0,0,0,,ЗНАЧИТ, СЧИТАЕМ НЕ КОЛИЧЕСТВО ТЁПЛЫХ СЛОВ,
Dialogue: 0,0:02:13.21,0:02:17.96,Caption,,0,0,0,,А СОВПАДЕНИЕ УСЛОВИЙ. НАЧНЁМ С ТЕРРИТОРИЙ,
Dialogue: 0,0:02:18.20,0:02:21.08,Caption,,0,0,0,,ПОТОМУ ЧТО ТАМ ПРЕДЛОЖИЛИ САМЫЙ ИЗЯЩНЫЙ ХОД СЕЗОНА.
Dialogue: 0,0:02:21.41,0:02:23.72,Caption,,0,0,0,,БРИТАНСКАЯ ПРЕССА ОПИСАЛА СХЕМУ ИЗМЕНИТЬ
Dialogue: 0,0:02:23.72,0:02:26.20,Caption,,0,0,0,,АДМИНИСТРАТИВНЫЕ ГРАНИЦЫ ДОНЕЦКОЙ И ЛУГАНСКОЙ
Dialogue: 0,0:02:26.20,0:02:28.84,Caption,,0,0,0,,ОБЛАСТЕЙ ТАК, ЧТОБЫ РОССИЯ МОГЛА ЗАЯВИТЬ,
Dialogue: 0,0:02:29.00,0:02:31.08,Caption,,0,0,0,,ЧТО КОНТРОЛИРУЕТ НУЖНЫЕ ЕЙ ЗЕМЛИ,
Dialogue: 0,0:02:31.25,0:02:33.80,Caption,,0,0,0,,А КИЕВ ПРИ ЭТОМ ФОРМАЛЬНО НИЧЕГО НЕ ПЕРЕДАВАЛ.
Dialogue: 0,0:02:36.06,0:02:38.79,Caption,,0,0,0,,ПЕРЕВОДИМ С ДИПЛОМАТИЧЕСКОГО ТЕРРИТОРИАЛЬНЫЙ СПОР
Dialogue: 0,0:02:38.79,0:02:40.63,Caption,,0,0,0,,ПРЕДЛАГАЕТСЯ ЗАКРЫТЬ КАРАНДАШОМ.
Dialogue: 0,0:02:42.91,0:02:46.12,Caption,,0,0,0,,СЛЕДИТЕ ЗА РУКАМИ. БЫЛА ОБЛАСТЬ. СТАЛА ОБЛАСТЬ
Dialogue: 0,0:02:46.12,0:02:49.96,Caption,,0,0,0,,ДРУГОЙ КОНФИГУРАЦИИ. ЗЕМЛЯ ПРЕЖНЯЯ. ГОРОДА ПРЕЖНИЕ.
Dialogue: 0,0:02:50.20,0:02:53.96,Caption,,0,0,0,,ЛЮДИ ПРЕЖНИЕ. ПРЕТЕНЗИИ ОБЕИХ СТОРОН ПРЕЖНИЕ. ЗАТО
Dialogue: 0,0:02:53.96,0:02:58.12,Caption,,0,0,0,,ЛИНИЯ НА КАРТЕ СВЕЖАЯ, И ПО ЗАМЫСЛУ АВТОРОВ ВСЕ ДОЛЖНЫ СОГЛАСИТЬСЯ,
Dialogue: 0,0:02:58.35,0:03:04.06,Caption,,0,0,0,,ЧТО СПОРИТЬ БОЛЬШЕ НЕ О ЧЕМ. КОГО ЭТА ПЕРЕРИСОВКА ДОЛЖНА УБЕДИТЬ,
Dialogue: 0,0:03:04.37,0:03:07.34,Caption,,0,0,0,,АВТОРЫ СХЕМЫ НЕ УТОЧНИЛИ. ДЛЯ МОСКВЫ ВОПРОС ДАВНО
Dialogue: 0,0:03:07.42,0:03:09.58,Caption,,0,0,0,,ВЫШЕЛ ЗА ПРЕДЕЛЫ УКРАИНСКОГО АДМИНИСТРАТИВНОГО
Dialogue: 0,0:03:09.58,0:03:12.54,Caption,,0,0,0,,УСТРОЙСТВА ДОНЕЦКАЯ И ЛУГАНСКАЯ НАРОДНЫЕ РЕСПУБЛИКИ
Dialogue: 0,0:03:12.54,0:03:16.94,Caption,,0,0,0,,ВКЛЮЧЕНЫ В СОСТАВ ФЕДЕРАЦИИ, ВОКРУГ НИХ ВЫСТРОЕНА СОБСТВЕННАЯ ЮРИДИЧЕСКАЯ
Dialogue: 0,0:03:16.94,0:03:20.30,Caption,,0,0,0,,КОНСТРУКЦИЯ. КИЕВ ЕЁ НЕ ПРИЗНАЁТ. ЕСЛИ ЗАВТРА В
Dialogue: 0,0:03:20.30,0:03:22.78,Caption,,0,0,0,,УКРАИНСКИХ ДОКУМЕНТАХ ПОЯВИТСЯ НОВАЯ ВНУТРЕННЯЯ
Dialogue: 0,0:03:22.78,0:03:26.22,Caption,,0,0,0,,ГРАНИЦА, РОССИЙСКАЯ ПОЗИЦИЯ ОТ ЭТОГО НИКУДА НЕ ДЕНЕТСЯ.
Dialogue: 0,0:03:28.50,0:03:31.54,Caption,,0,0,0,,У КИЕВА РОВНО ТА ЖЕ АРИФМЕТИКА НАОБОРОТ. ПЕРЕНОС
Dialogue: 0,0:03:31.62,0:03:36.02,Caption,,0,0,0,,ЛИНИИ ОБЛАСТИ ОЗНАЧАЕТ, ЧТО ОН ПЕРЕСТАЁТ СЧИТАТЬ КОНКРЕТНЫЕ ЗЕМЛИ СВОИМИ?
Dialogue: 0,0:03:36.33,0:03:39.54,Caption,,0,0,0,,ЕСЛИ НЕ ПЕРЕСТАЁТ, ТО ИЗМЕНИЛОСЬ РОВНО ОДНО ЧЕРТЁЖ.
Dialogue: 0,0:03:41.82,0:03:44.06,Caption,,0,0,0,,ПО ТАКОЙ ЛОГИКЕ ЛЮБУЮ ПРОБЛЕМУ МОЖНО РЕШАТЬ
Dialogue: 0,0:03:44.06,0:03:47.26,Caption,,0,0,0,,ПЕРЕИМЕНОВАНИЕМ. ДОЛГ ПЕРЕПИСАТЬ НА ДРУГУЮ ФАМИЛИЮ,
Dialogue: 0,0:03:47.43,0:03:49.98,Caption,,0,0,0,,ТРЕЩИНУ В СТЕНЕ ОБЪЯВИТЬ ЭЛЕМЕНТОМ ИНТЕРЬЕРА.
Dialogue: 0,0:03:50.22,0:03:53.10,Caption,,0,0,0,,ДЁШЕВО, БЫСТРО, БУМАГИ ПОЧТИ НЕ НУЖНО.
Dialogue: 0,0:03:55.38,0:03:59.06,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЧТО КИЕВ ЭТУ СХЕМУ, СУДЯ ПО СООБЩЕНИЯМ С ПЕРЕГОВОРОВ,
Dialogue: 0,0:03:59.22,0:04:01.70,Caption,,0,0,0,,ОТКЛОНИЛ. ЗЕЛЕНСКИЙ ОТДЕЛЬНО ГОВОРИЛ,
Dialogue: 0,0:04:01.95,0:04:04.50,Caption,,0,0,0,,ЧТО АМЕРИКАНСКАЯ СТОРОНА ПОСТОЯННО ВОЗВРАЩАЕТСЯ К
Dialogue: 0,0:04:04.50,0:04:07.54,Caption,,0,0,0,,ДОНБАССУ И К ВЫВОДУ УКРАИНСКИХ ВОЙСК. РОССИЙСКАЯ
Dialogue: 0,0:04:07.62,0:04:10.18,Caption,,0,0,0,,СТОРОНА СВОИ ТРЕБОВАНИЯ ПО ТЕРРИТОРИЯМ НЕ СНИМАЕТ.
Dialogue: 0,0:04:10.50,0:04:13.22,Caption,,0,0,0,,КРАСИВЫЙ ЧЕРТЁЖ ПОКА НЕ ЗАКРЫЛ НИ ОДНОГО ПУНКТА.
Dialogue: 0,0:04:15.49,0:04:18.21,Caption,,0,0,0,,ВОЗВРАЩАЕМСЯ К ПРОВЕРКЕ. МОСКВА ГОВОРИТ ЦЕЛИ
Dialogue: 0,0:04:18.21,0:04:22.05,Caption,,0,0,0,,ОСТАЮТСЯ. ХОРОШО, БЕРЁМ ЭТИ ЦЕЛИ И ПРИКЛАДЫВАЕМ К ТОМУ,
Dialogue: 0,0:04:22.13,0:04:28.16,Caption,,0,0,0,,ЧТО ЛЕЖИТ НА СТОЛЕ. САМЫЙ ВЫРАЗИТЕЛЬНЫЙ ПРИМЕР ДАЖЕ НЕ ТЕРРИТОРИИ.
Dialogue: 0,0:04:28.48,0:04:33.88,Caption,,0,0,0,,АРМИЯ. КИЕВ ХОЧЕТ ПОСЛЕ ОКОНЧАНИЯ КОНФЛИКТА СОХРАНИТЬ
Dialogue: 0,0:04:33.96,0:04:36.44,Caption,,0,0,0,,ВООРУЖЁННЫЕ СИЛЫ ЧИСЛЕННОСТЬЮ ВОСЕМЬСОТ ТЫСЯЧ
Dialogue: 0,0:04:36.44,0:04:39.64,Caption,,0,0,0,,ЧЕЛОВЕК И ПОЛУЧАТЬ НА ИХ СОДЕРЖАНИЕ ЗАПАДНЫЕ ДЕНЬГИ
Dialogue: 0,0:04:39.64,0:04:42.76,Caption,,0,0,0,,МИНИМУМ ДЕСЯТЬ ЛЕТ. ЭТУ ЦИФРУ УКРАИНСКАЯ СТОРОНА
Dialogue: 0,0:04:42.76,0:04:45.72,Caption,,0,0,0,,ОЗВУЧИЛА ЧЕРЕЗ АГЕНТСТВО ФРАНС ПРЕСС ПРЯМО ВО ВРЕМЯ
Dialogue: 0,0:04:45.80,0:04:52.07,Caption,,0,0,0,,НЫНЕШНЕГО РАУНДА. ВОСЕМЬСОТ ТЫСЯЧ. ПОСЛЕ ВОЙНЫ. ДЕСЯТЬ ЛЕТ.
Dialogue: 0,0:04:54.36,0:04:56.68,Caption,,0,0,0,,ТЕПЕРЬ ДОСТАЁМ ИЗ АРХИВА СТАМБУЛЬСКИЙ ПРОЕКТ
Dialogue: 0,0:04:56.76,0:04:58.60,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОГО ГОДА, ТОТ САМЫЙ,
Dialogue: 0,0:04:58.83,0:05:01.24,Caption,,0,0,0,,КОТОРЫЙ ОБЕ СТОРОНЫ КОГДА ТО ДЕРЖАЛИ В РУКАХ.
Dialogue: 0,0:05:01.64,0:05:04.92,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ПЯТЬ ТЫСЯЧ ВОЕННОСЛУЖАЩИХ. ТРИСТА СОРОК
Dialogue: 0,0:05:04.92,0:05:07.96,Caption,,0,0,0,,ДВА ТАНКА. ПЯТЬСОТ ДЕВЯТНАДЦАТЬ СТВОЛОВ АРТИЛЛЕРИИ.
Dialogue: 0,0:05:08.19,0:05:11.00,Caption,,0,0,0,,ПОТОЛОК ПО ДАЛЬНОСТИ РАКЕТ. ЗАКРЫТАЯ ДВЕРЬ ДЛЯ
Dialogue: 0,0:05:11.00,0:05:13.88,Caption,,0,0,0,,ИНОСТРАННОГО ОРУЖИЯ. УКРАИНА ТОГДА ТОРГОВАЛАСЬ ЗА
Dialogue: 0,0:05:13.88,0:05:17.08,Caption,,0,0,0,,БОЛЬШЕЕ, МОСКВА ТРЕБОВАЛА УРЕЗАТЬ ВОЕННЫЙ ПОТЕНЦИАЛ
Dialogue: 0,0:05:17.08,0:05:21.21,Caption,,0,0,0,,РАДИКАЛЬНО. ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:05:21.45,0:05:23.85,Caption,,0,0,0,,ИЗ ЧЕГО СОСТОЯЛ ТОТ СПИСОК. ТАМ НЕ ТОЛЬКО
Dialogue: 0,0:05:23.85,0:05:26.65,Caption,,0,0,0,,ЛЮДСКОЙ СЧЁТ, ТАМ ЕЩЁ И ПОТОЛОК ПО ДАЛЬНОСТИ,
Dialogue: 0,0:05:26.97,0:05:29.45,Caption,,0,0,0,,И ЗАКРЫТАЯ ДВЕРЬ ДЛЯ ЧУЖОГО ОРУЖИЯ. ТО ЕСТЬ
Dialogue: 0,0:05:29.45,0:05:32.33,Caption,,0,0,0,,МОСКВА СЧИТАЛА ПОТЕНЦИАЛ ЦЕЛИКОМ СКОЛЬКО ЛЮДЕЙ,
Dialogue: 0,0:05:32.41,0:05:36.73,Caption,,0,0,0,,СКОЛЬКО ТЕХНИКИ, КАК ДАЛЕКО БЬЁТ И ЧЬЁ ОНО. НЫНЕШНИЙ ЗАПРОС
Dialogue: 0,0:05:36.73,0:05:39.53,Caption,,0,0,0,,КИЕВА УСТРОЕН НАОБОРОТ И НАЧИНАЕТСЯ С ЦИФРЫ,
Dialogue: 0,0:05:39.70,0:05:42.41,Caption,,0,0,0,,КОТОРАЯ ПЕРЕКРЫВАЕТ ПРЕЖНЮЮ РАМКУ СРАЗУ ПО ВСЕМ
Dialogue: 0,0:05:42.41,0:05:48.13,Caption,,0,0,0,,ПУНКТАМ. ВОСЕМЬДЕСЯТ ПЯТЬ ТЫСЯЧ ТОГДА. ВОСЕМЬСОТ ТЫСЯЧ
Dialogue: 0,0:05:48.21,0:05:50.77,Caption,,0,0,0,,СЕЙЧАС. ПОЧТИ В ДЕВЯТЬ С ПОЛОВИНОЙ РАЗ БОЛЬШЕ.
Dialogue: 0,0:05:52.98,0:05:55.46,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ПРОСТОЙ ВОПРОС. РОССИЯ НА ЭТО
Dialogue: 0,0:05:55.46,0:06:00.79,Caption,,0,0,0,,СОГЛАСНА? ПОТОМУ ЧТО ПЕРВЫМ ПУНКТОМ В ЦЕЛЯХ МОСКВЫ СТОИТ
Dialogue: 0,0:06:00.79,0:06:05.27,Caption,,0,0,0,,РАЗОРУЖЕНИЕ ПРОТИВНИКА, А ВОСЕМЬСОТ ТЫСЯЧ ЧЕЛОВЕК НА ЗАПАДНОМ ДОВОЛЬСТВИИ
Dialogue: 0,0:06:05.50,0:06:07.83,Caption,,0,0,0,,ВЫГЛЯДЯТ ДОВОЛЬНО МУСКУЛИСТЫМ ЕГО ВАРИАНТОМ.
Dialogue: 0,0:06:08.15,0:06:11.75,Caption,,0,0,0,,СОКРАТИЛИ ТАК, ЧТО СОЛДАТ СТАЛО ПОЧТИ ВДЕСЯТЕРО БОЛЬШЕ,
Dialogue: 0,0:06:12.05,0:06:14.47,Caption,,0,0,0,,ЧЕМ ПРЕДЛАГАЛОСЬ ОСТАВИТЬ В ДВАДЦАТЬ ВТОРОМ ГОДУ.
Dialogue: 0,0:06:16.75,0:06:19.23,Caption,,0,0,0,,ЭТО НЕ РАЗНИЦА В ДЕТАЛЯХ. ЭТО ДВЕ РАЗНЫЕ
Dialogue: 0,0:06:19.31,0:06:25.27,Caption,,0,0,0,,СТРАНЫ НА ВЫХОДЕ. В ПЕРВОЙ МОДЕЛИ ВООРУЖЁННЫЕ СИЛЫ ЖЁСТКО ОГРАНИЧЕНЫ
Dialogue: 0,0:06:25.35,0:06:28.31,Caption,,0,0,0,,ПО ЧИСЛЕННОСТИ И ПО ТЕХНИКЕ. ВО ВТОРОЙ СУЩЕСТВУЕТ
Dialogue: 0,0:06:28.39,0:06:30.31,Caption,,0,0,0,,ОДНА ИЗ КРУПНЕЙШИХ АРМИЙ ЕВРОПЫ,
Dialogue: 0,0:06:30.48,0:06:33.19,Caption,,0,0,0,,КОТОРУЮ ДЕСЯТЬ ЛЕТ СОДЕРЖАТ ВНЕШНИЕ СПОНСОРЫ.
Dialogue: 0,0:06:35.48,0:06:37.88,Caption,,0,0,0,,И ЗДЕСЬ УЖЕ НЕ ОТДЕЛАТЬСЯ ФРАЗОЙ ПРО ГАРАНТИИ
Dialogue: 0,0:06:37.88,0:06:42.01,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ГАРАНТИИ КОМУ?
Dialogue: 0,0:06:42.36,0:06:45.13,Caption,,0,0,0,,ВОТ ЭТОТ ВОПРОС ИНТЕРЕСНЕЕ САМОГО СЛОВА. КАКОЙ
Dialogue: 0,0:06:45.21,0:06:47.93,Caption,,0,0,0,,УКРАИНЕ? В КАКИХ ГРАНИЦАХ? С КАКИМ РУКОВОДСТВОМ?
Dialogue: 0,0:06:47.93,0:06:50.89,Caption,,0,0,0,,С КАКОЙ АРМИЕЙ? С КАКИМ ВНЕШНЕПОЛИТИЧЕСКИМ КУРСОМ?
Dialogue: 0,0:06:50.97,0:06:57.32,Caption,,0,0,0,,С КАКИМ ОТНОШЕНИЕМ К МОСКВЕ? ОБЕЗОПАСИТЬ СТРАНУ ОТ УДАРА И ЗАКОНСЕРВИРОВАТЬ
Dialogue: 0,0:06:57.40,0:06:59.72,Caption,,0,0,0,,НЫНЕШНЮЮ КОНСТРУКЦИЮ ВЛАСТИ ЭТО ДВА РАЗНЫХ
Dialogue: 0,0:06:59.72,0:07:03.56,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА, ХОТЯ НА БУМАГЕ ОБА ВЫГЛЯДЯТ ОДИНАКОВО НАРЯДНО.
Dialogue: 0,0:07:05.84,0:07:08.56,Caption,,0,0,0,,ПРЕДСТАВЬТЕ КОРОБКУ. НА КРЫШКЕ КРУПНО ГАРАНТИИ
Dialogue: 0,0:07:08.56,0:07:11.76,Caption,,0,0,0,,БЕЗОПАСНОСТИ УКРАИНЫ. ПРЕКРАСНАЯ КРЫШКА. ВОПРОС В
Dialogue: 0,0:07:11.76,0:07:15.46,Caption,,0,0,0,,СОДЕРЖИМОМ. ДОПУСТИМ,
Dialogue: 0,0:07:15.54,0:07:18.34,Caption,,0,0,0,,ЗАВТРА ЗЕЛЕНСКОГО В КАБИНЕТЕ НЕТ. ПРИХОДИТ ДРУГОЙ
Dialogue: 0,0:07:18.34,0:07:21.06,Caption,,0,0,0,,ЧЕЛОВЕК. ДРУГАЯ ФАМИЛИЯ, ДРУГОЙ КОСТЮМ,
Dialogue: 0,0:07:21.22,0:07:24.50,Caption,,0,0,0,,ДРУГАЯ МАНЕРА ГОВОРИТЬ. А КУРС ПРЕЖНИЙ. ОТНОШЕНИЕ К
Dialogue: 0,0:07:24.58,0:07:27.62,Caption,,0,0,0,,РОССИИ ПРЕЖНЕЕ. ВОЕННОЕ ПЛАНИРОВАНИЕ ПРЕЖНЕЕ.
Dialogue: 0,0:07:27.78,0:07:31.22,Caption,,0,0,0,,ЗАПАДНАЯ ИНФРАСТРУКТУРА ПРЕЖНЯЯ. АРМИЯ ПРЕЖНЯЯ.
Dialogue: 0,0:07:31.38,0:07:33.94,Caption,,0,0,0,,ЯЗЫКОВАЯ И ИСТОРИЧЕСКАЯ ПОЛИТИКА ПРЕЖНИЕ.
Dialogue: 0,0:07:36.22,0:07:38.38,Caption,,0,0,0,,ЧТО ИЗМЕНИЛОСЬ? ТАБЛИЧКА НА ДВЕРИ.
Dialogue: 0,0:07:40.66,0:07:43.70,Caption,,0,0,0,,ПОЭТОМУ РАЗГОВОР О ДЕНАЦИФИКАЦИИ НЕ СВОДИТСЯ К ТОМУ,
Dialogue: 0,0:07:43.94,0:07:46.74,Caption,,0,0,0,,КТО КОНКРЕТНО СИДИТ В КАБИНЕТЕ. РЕЧЬ О СМЕНЕ
Dialogue: 0,0:07:46.74,0:07:49.38,Caption,,0,0,0,,ВСЕЙ ДЕЙСТВУЮЩЕЙ ВЛАСТИ ВМЕСТЕ С ЕЁ КУРСОМ,
Dialogue: 0,0:07:49.54,0:07:52.18,Caption,,0,0,0,,А НЕ О ЗАМЕНЕ ПОДПИСИ НА ДОКУМЕНТАХ. ЕСЛИ
Dialogue: 0,0:07:52.26,0:07:54.26,Caption,,0,0,0,,ВМЕСТО ЗЕЛЕНСКОГО ПРИДЁТ ЧЕЛОВЕК С ТОЙ ЖЕ
Dialogue: 0,0:07:54.26,0:07:58.18,Caption,,0,0,0,,ПРОГРАММОЙ, ДЛЯ МОСКВЫ НЕ ПОМЕНЯЕТСЯ НИЧЕГО. ДРУГАЯ ВЛАСТЬ,
Dialogue: 0,0:07:58.30,0:08:02.50,Caption,,0,0,0,,ДРУГОЙ КУРС, ДРУГОЕ ОТНОШЕНИЕ К РОССИИ И РАДИКАЛЬНО УРЕЗАННАЯ
Dialogue: 0,0:08:02.50,0:08:05.62,Caption,,0,0,0,,АРМИЯ. ВОТ С ТАКОЙ УКРАИНОЙ РАЗГОВОР О ГАРАНТИЯХ
Dialogue: 0,0:08:05.62,0:08:10.14,Caption,,0,0,0,,ВЫГЛЯДЕЛ БЫ СОВСЕМ ИНАЧЕ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:08:10.29,0:08:13.26,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. САМОЕ ВАЖНОЕ НЕ КТО
Dialogue: 0,0:08:13.26,0:08:15.26,Caption,,0,0,0,,БУДЕТ СТОЯТЬ У ФЛАГА НА ПОДПИСАНИИ,
Dialogue: 0,0:08:15.50,0:08:17.82,Caption,,0,0,0,,А КАКОЕ ГОСУДАРСТВО ОСТАНЕТСЯ ПОСЛЕ НЕГО.
Dialogue: 0,0:08:20.02,0:08:22.74,Caption,,0,0,0,,ДАЛЬШЕ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА НЕУДОБНАЯ ЦИФРА,
Dialogue: 0,0:08:22.98,0:08:29.49,Caption,,0,0,0,,И ОНА НЕ ПРО ДЕНЬГИ. ВОСЕМЬСОТ ТЫСЯЧ ВОЕННЫХ ЭТО ЛЮДИ. ОТКУДА ИХ БРАТЬ
Dialogue: 0,0:08:29.49,0:08:35.28,Caption,,0,0,0,,ДЕСЯТЬ ЛЕТ ПОДРЯД? АРМИЯ ТАКОГО РАЗМЕРА В МИРНОЕ ВРЕМЯ ТРЕБУЕТ
Dialogue: 0,0:08:35.28,0:08:37.84,Caption,,0,0,0,,ПОСТОЯННОГО ПОПОЛНЕНИЯ. КОНТРАКТ,
Dialogue: 0,0:08:37.92,0:08:43.68,Caption,,0,0,0,,РЕЗЕРВ, УЧЁТ, РОТАЦИИ, ОГРАНИЧЕНИЯ ДЛЯ ВОЕННООБЯЗАННЫХ. КАКАЯ ИМЕННО МОДЕЛЬ
Dialogue: 0,0:08:43.68,0:08:45.84,Caption,,0,0,0,,БУДЕТ ВЫБРАНА, ПОКА ОТДЕЛЬНЫЙ РАЗГОВОР.
Dialogue: 0,0:08:48.11,0:08:50.35,Caption,,0,0,0,,НО У ОБЫЧНОГО ЧЕЛОВЕКА В КИЕВЕ ИЛИ ЛЬВОВЕ
Dialogue: 0,0:08:50.43,0:08:52.59,Caption,,0,0,0,,ВОПРОС КОРОЧЕ. ГРАНИЦУ ОТКРОЮТ?
Dialogue: 0,0:08:54.87,0:08:58.07,Caption,,0,0,0,,ТОМУ, КТО НЕСКОЛЬКО ЛЕТ ПРОЖИЛ В РЕЖИМЕ МОБИЛИЗАЦИИ И
Dialogue: 0,0:08:58.07,0:09:00.79,Caption,,0,0,0,,ЗАПРЕТА НА ВЫЕЗД, ГЛУБОКО БЕЗРАЗЛИЧНО,
Dialogue: 0,0:09:00.99,0:09:03.91,Caption,,0,0,0,,КАКОЕ ИМЯ ПОДБЕРУТ БУДУЩЕЙ СИСТЕМЕ БЕЗОПАСНОСТИ В
Dialogue: 0,0:09:03.91,0:09:09.03,Caption,,0,0,0,,ЕВРОПЕ. ЕМУ ВАЖНО, СМОЖЕТ ЛИ ОН ПОСЛЕ ОКОНЧАНИЯ БОЕВЫХ ДЕЙСТВИЙ СОБРАТЬ
Dialogue: 0,0:09:09.11,0:09:12.07,Caption,,0,0,0,,СУМКУ, СЕСТЬ В АВТОБУС И СПОКОЙНО УЕХАТЬ.
Dialogue: 0,0:09:14.28,0:09:17.08,Caption,,0,0,0,,СКЛАДЫВАЕТСЯ ЗАНЯТНАЯ КАРТИНА. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:09:17.32,0:09:20.44,Caption,,0,0,0,,НАМ ОПИСЫВАЮТ ПОСЛЕВОЕННУЮ УКРАИНУ. С ДРУГОЙ,
Dialogue: 0,0:09:20.73,0:09:23.00,Caption,,0,0,0,,В ТЕХ ЖЕ ДОКУМЕНТАХ ПЛАНИРУЮТ АРМИЮ ПОЧТИ В
Dialogue: 0,0:09:23.00,0:09:25.08,Caption,,0,0,0,,МИЛЛИОН ЧЕЛОВЕК НА ДЕСЯТЬ ЛЕТ ВПЕРЁД.
Dialogue: 0,0:09:27.37,0:09:30.01,Caption,,0,0,0,,ТАК ВОЙНА ЗАКАНЧИВАЕТСЯ ИЛИ ВОЕННАЯ МОДЕЛЬ
Dialogue: 0,0:09:30.01,0:09:32.57,Caption,,0,0,0,,ГОСУДАРСТВА ПРОСТО ПЕРЕЕЗЖАЕТ В МИРНОЕ ВРЕМЯ И
Dialogue: 0,0:09:32.57,0:09:39.74,Caption,,0,0,0,,ПОЛУЧАЕТ ПОСТОЯННУЮ ПРОПИСКУ? ОТДЕЛЬНО ВСТАЁТ ВОПРОС ОПЛАТЫ. КИЕВ САМ ПРОСИТ
Dialogue: 0,0:09:39.74,0:09:42.86,Caption,,0,0,0,,ЗАПАДНОЕ ФИНАНСИРОВАНИЕ НА ДЕСЯТЬ ЛЕТ. ТО ЕСТЬ ПОСЛЕ
Dialogue: 0,0:09:42.94,0:09:45.34,Caption,,0,0,0,,ОКОНЧАНИЯ БОЕВЫХ ДЕЙСТВИЙ ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:09:45.34,0:09:47.74,Caption,,0,0,0,,УКРАИНСКОЙ ВОЕННОЙ МАШИНЫ ОСТАЁТСЯ НА ВНЕШНЕМ
Dialogue: 0,0:09:47.74,0:09:53.87,Caption,,0,0,0,,ОБЕСПЕЧЕНИИ. ЭТО УЖЕ НЕ ГАРАНТИЯ БЕЗОПАСНОСТИ. ЭТО ДОЛГОСРОЧНЫЙ
Dialogue: 0,0:09:53.87,0:09:57.31,Caption,,0,0,0,,АБОНЕМЕНТ, КОТОРЫЙ ВЫПИСЫВАЮТ ЕВРОПЕЙСКИМ И АМЕРИКАНСКИМ
Dialogue: 0,0:09:57.31,0:10:02.46,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКАМ. ПРИЧЁМ ВЫПИСЫВАЮТ ЕГО НА СРОК,
Dialogue: 0,0:10:02.70,0:10:05.82,Caption,,0,0,0,,КОТОРЫЙ ПЕРЕЖИВЁТ НЫНЕШНИЕ ПРАВИТЕЛЬСТВА. ДЕСЯТЬ ЛЕТ
Dialogue: 0,0:10:05.90,0:10:08.46,Caption,,0,0,0,,ЭТО МИНИМУМ ДВА ЭЛЕКТОРАЛЬНЫХ ЦИКЛА В БОЛЬШИНСТВЕ
Dialogue: 0,0:10:08.46,0:10:11.42,Caption,,0,0,0,,ЗАПАДНЫХ СТРАН. ПОДПИСЬ СТАВЯТ ОДНИ КАБИНЕТЫ,
Dialogue: 0,0:10:11.74,0:10:14.38,Caption,,0,0,0,,А ПЛАТИТЬ ПРИДЁТСЯ ТЕМ, КОГО ЕЩЁ НЕ ВЫБРАЛИ,
Dialogue: 0,0:10:14.62,0:10:16.46,Caption,,0,0,0,,И ОБЪЯСНЯТЬ РАСХОДЫ ИЗБИРАТЕЛЯМ,
Dialogue: 0,0:10:16.68,0:10:18.86,Caption,,0,0,0,,У КОТОРЫХ К ТОМУ ВРЕМЕНИ БУДУТ СВОИ СЧЕТА
Dialogue: 0,0:10:18.94,0:10:25.21,Caption,,0,0,0,,И СВОИ ПРЕТЕНЗИИ. А ЕСЛИ МОСКВА ТРЕБУЕТ ДЕМИЛИТАРИЗАЦИИ И УВЕРЕННОСТИ
Dialogue: 0,0:10:25.29,0:10:28.81,Caption,,0,0,0,,В ТОМ, ЧТО УКРАИНА ПЕРЕСТАНЕТ БЫТЬ ДЛЯ НЕЁ ВОЕННОЙ УГРОЗОЙ,
Dialogue: 0,0:10:29.05,0:10:31.61,Caption,,0,0,0,,ВОПРОС ВОЗВРАЩАЕТСЯ НА МЕСТО. СХОДИТСЯ?
Dialogue: 0,0:10:33.79,0:10:39.87,Caption,,0,0,0,,ПОКА НЕТ. ТЕПЕРЬ ЕВРОПА. АМЕРИКАНЦЫ ХОТЯТ ВИДЕТЬ ЕВРОПЕЙЦЕВ В
Dialogue: 0,0:10:39.87,0:10:42.99,Caption,,0,0,0,,СЛЕДУЮЩИХ РАУНДАХ АКТИВНЕЕ. ДЖАРЕД КУШНЕР ПРЯМО
Dialogue: 0,0:10:42.99,0:10:46.35,Caption,,0,0,0,,СКАЗАЛ, ЧТО ЕВРОПЕ СТОИЛО БЫ ВЫБРАТЬ ОДНОГО ЧЕЛОВЕКА,
Dialogue: 0,0:10:46.59,0:10:49.47,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ ГОВОРИТЬ ОТ ЕЁ ИМЕНИ. РОССИЯ В
Dialogue: 0,0:10:49.55,0:10:52.03,Caption,,0,0,0,,АБУ ДАБИ С ЕВРОПЕЙСКИМИ ПРЕДСТАВИТЕЛЯМИ ОТДЕЛЬНО НЕ
Dialogue: 0,0:10:52.03,0:10:54.59,Caption,,0,0,0,,ВСТРЕЧАЛАСЬ, А ВЛАДИМИР МЕДИНСКИЙ ЗАЯВИЛ,
Dialogue: 0,0:10:54.85,0:10:57.47,Caption,,0,0,0,,ЧТО КОНКРЕТНЫХ МИРНЫХ ПРЕДЛОЖЕНИЙ ОТ НИХ МОСКВА НЕ
Dialogue: 0,0:10:57.47,0:11:01.67,Caption,,0,0,0,,ПОЛУЧАЛА. ПРОБЛЕМА ДАЖЕ НЕ В ТОМ,
Dialogue: 0,0:11:01.82,0:11:05.19,Caption,,0,0,0,,ПУСТЯТ ЕВРОПЕЙЦЕВ ЗА СТОЛ ИЛИ НЕ ПУСТЯТ. ДОПУСТИМ,
Dialogue: 0,0:11:05.27,0:11:07.91,Caption,,0,0,0,,ВЫБЕРУТ ОДНОГО. ДАЛЬШЕ ЧТО ОН ПРИНЕСЁТ?
Dialogue: 0,0:11:08.14,0:11:11.91,Caption,,0,0,0,,НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ? СОГЛАСИЕ НА РОССИЙСКИЕ ТРЕБОВАНИЯ?
Dialogue: 0,0:11:12.14,0:11:15.67,Caption,,0,0,0,,ДРУГУЮ МОДЕЛЬ УКРАИНЫ? ИЛИ В ЗАЛЕ ПРОСТО СТАНЕТ НА ОДИН СТУЛ
Dialogue: 0,0:11:15.75,0:11:19.94,Caption,,0,0,0,,БОЛЬШЕ? СТУЛ ЭТО ЕЩЁ НЕ ПОЗИЦИЯ.
Dialogue: 0,0:11:22.20,0:11:24.76,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЧТО ГАРАНТИИ БЫВАЮТ ОЧЕНЬ РАЗНОГО ВЕСА.
Dialogue: 0,0:11:25.08,0:11:27.88,Caption,,0,0,0,,ОДНО ДЕЛО ОБЯЗАТЕЛЬСТВО ВСТУПИТЬ В КОНФЛИКТ НА ЧЬЕЙ
Dialogue: 0,0:11:27.96,0:11:31.88,Caption,,0,0,0,,ТО СТОРОНЕ, ДРУГОЕ ОБЯЗАТЕЛЬСТВО СОБРАТЬСЯ И ОБСУДИТЬ СИТУАЦИЮ.
Dialogue: 0,0:11:32.27,0:11:34.60,Caption,,0,0,0,,МЕЖДУ ЭТИМИ ДВУМЯ СТРОЧКАМИ ЛЕЖИТ ПРОПАСТЬ,
Dialogue: 0,0:11:34.87,0:11:37.48,Caption,,0,0,0,,НО В ЗАЯВЛЕНИЯХ ОНИ ЗВУЧАТ ОДИНАКОВО СОЛИДНО,
Dialogue: 0,0:11:37.72,0:11:40.28,Caption,,0,0,0,,И ИМЕННО ПОЭТОМУ КАЖДАЯ СТОРОНА ЧИТАЕТ СЛОВО
Dialogue: 0,0:11:40.36,0:11:44.95,Caption,,0,0,0,,"ГАРАНТИИ" ПО СВОЕМУ. САМОЕ ИНТЕРЕСНОЕ,
Dialogue: 0,0:11:45.27,0:11:48.15,Caption,,0,0,0,,ЧТО ВАШИНГТОН И МОСКВА ОБСУЖДАЮТ ВОПРОС ШИРЕ САМОЙ
Dialogue: 0,0:11:48.15,0:11:50.79,Caption,,0,0,0,,УКРАИНЫ. В АБУ ДАБИ РЕЧЬ ШЛА О БУДУЩЕЙ
Dialogue: 0,0:11:50.79,0:11:54.07,Caption,,0,0,0,,АРХИТЕКТУРЕ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. РОССИЯ СНОВА
Dialogue: 0,0:11:54.15,0:11:57.11,Caption,,0,0,0,,ПОДНИМАЕТ ТЕМУ ДОЛГОСРОЧНЫХ ГАРАНТИЙ И ПРЕДЛАГАЕТ
Dialogue: 0,0:11:57.11,0:11:59.03,Caption,,0,0,0,,ВАРИАНТЫ ДОГОВОРЁННОСТЕЙ С ЕВРОПЕЙСКИМИ
Dialogue: 0,0:11:59.03,0:12:01.59,Caption,,0,0,0,,ГОСУДАРСТВАМИ ВПЛОТЬ ДО ПАКТОВ О НЕНАПАДЕНИИ.
Dialogue: 0,0:12:01.99,0:12:04.15,Caption,,0,0,0,,АМЕРИКАНСКАЯ СТОРОНА ЭТОТ РАЗГОВОР БОЛЬШЕ НЕ
Dialogue: 0,0:12:04.15,0:12:10.43,Caption,,0,0,0,,ОТБРАСЫВАЕТ С ПОРОГА. УКРАИНА В ТАКОЙ РАМКЕ ПЕРЕСТАЁТ БЫТЬ ВСЕЙ КАРТИНОЙ
Dialogue: 0,0:12:10.52,0:12:15.92,Caption,,0,0,0,,И СТАНОВИТСЯ ЕЁ ЧАСТЬЮ. ПОТОМУ ЧТО ЕСЛИ МОСКВА ГОВОРИТ,
Dialogue: 0,0:12:16.16,0:12:18.80,Caption,,0,0,0,,ЧТО ПРИЧИНЫ КОНФЛИКТА ЛЕЖАТ В УСТРОЙСТВЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:12:18.80,0:12:22.88,Caption,,0,0,0,,БЕЗОПАСНОСТИ, В РАСШИРЕНИИ НАТО И В ВОЕННОМ ПОЛОЖЕНИИ УКРАИНЫ,
Dialogue: 0,0:12:23.26,0:12:26.08,Caption,,0,0,0,,ТО БУМАГА С КРАСИВЫМ ЗАГОЛОВКОМ ДЛЯ КИЕВА ЭТИХ
Dialogue: 0,0:12:26.08,0:12:30.35,Caption,,0,0,0,,ПРИЧИН НЕ ЗАКРЫВАЕТ. НУЖНО ПОНИМАТЬ,
Dialogue: 0,0:12:30.50,0:12:34.35,Caption,,0,0,0,,ЧТО ГАРАНТИРУЮТ РОССИИ. ЧТО ГАРАНТИРУЮТ УКРАИНЕ. ЧТО
Dialogue: 0,0:12:34.35,0:12:37.71,Caption,,0,0,0,,ОБЯЗУЕТСЯ ДЕЛАТЬ ЕВРОПА. ЧТО ОНА ПЕРЕСТАЁТ ДЕЛАТЬ.
Dialogue: 0,0:12:37.95,0:12:40.67,Caption,,0,0,0,,КАКИМ ОСТАЁТСЯ УКРАИНСКОЕ ГОСУДАРСТВО. КАКИМ
Dialogue: 0,0:12:40.67,0:12:43.55,Caption,,0,0,0,,ОСТАЁТСЯ ЕГО ВОЕННЫЙ ПОТЕНЦИАЛ. ВОТ ПОСЛЕ ЭТОГО
Dialogue: 0,0:12:43.55,0:12:45.95,Caption,,0,0,0,,МОЖНО СМОТРЕТЬ, ВЫПОЛНЕНЫ ЦЕЛИ ИЛИ НЕТ.
Dialogue: 0,0:12:48.15,0:12:51.35,Caption,,0,0,0,,А ПОКА КОНСТРУКЦИЯ ВЫГЛЯДИТ ТАК. РОССИЯ СООБЩАЕТ,
Dialogue: 0,0:12:51.46,0:12:54.55,Caption,,0,0,0,,ЧТО ЦЕЛИ БУДУТ ДОСТИГНУТЫ. КИЕВ ПРОСИТ ВОСЕМЬСОТ
Dialogue: 0,0:12:54.55,0:12:57.83,Caption,,0,0,0,,ТЫСЯЧ ВОЕННЫХ И ДЕСЯТЬ ЛЕТ СОДЕРЖАНИЯ. ТЕРРИТОРИИ
Dialogue: 0,0:12:57.83,0:13:01.11,Caption,,0,0,0,,ПРЕДЛАГАЮТ ПОПРАВИТЬ ЧЕРТЕЖОМ. ЕВРОПУ ХОТЯТ ПОСАДИТЬ
Dialogue: 0,0:13:01.19,0:13:04.07,Caption,,0,0,0,,ЗА СТОЛ. ГАРАНТИИ ОБСУЖДАЮТ. И ВСЕ ВМЕСТЕ
Dialogue: 0,0:13:04.07,0:13:09.23,Caption,,0,0,0,,РАССКАЗЫВАЮТ ПРО ПРОГРЕСС. ГДЕ ИМЕННО ОН НАХОДИТСЯ,
Dialogue: 0,0:13:09.39,0:13:15.74,Caption,,0,0,0,,НИКТО НЕ ПОКАЗЫВАЕТ. ПО ТЕРРИТОРИЯМ ПУБЛИЧНОГО СОГЛАШЕНИЯ НЕТ. ПО РАЗМЕРУ
Dialogue: 0,0:13:15.74,0:13:18.30,Caption,,0,0,0,,БУДУЩЕЙ АРМИИ РАЗРЫВ МЕЖДУ ПРЕЖНИМ РОССИЙСКИМ
Dialogue: 0,0:13:18.30,0:13:20.70,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕМ И НЫНЕШНИМ УКРАИНСКИМ ЗАПРОСОМ
Dialogue: 0,0:13:20.70,0:13:24.22,Caption,,0,0,0,,ОГРОМНЫЙ. ПО УСТРОЙСТВУ ПОСЛЕВОЕННОЙ УКРАИНЫ ЯСНОСТИ
Dialogue: 0,0:13:24.30,0:13:27.34,Caption,,0,0,0,,НЕТ. ПО ЕВРОПЕЙСКОЙ СИСТЕМЕ БЕЗОПАСНОСТИ РАЗГОВОР
Dialogue: 0,0:13:27.34,0:13:32.17,Caption,,0,0,0,,ТОЛЬКО ОТКРЫЛИ. ПЕРЕГОВОРЫ ЭТО НЕ ФУТБОЛЬНЫЙ МАТЧ,
Dialogue: 0,0:13:32.33,0:13:35.05,Caption,,0,0,0,,ГДЕ ЗА КАЖДУЮ ВСТРЕЧУ НАЧИСЛЯЮТ ОЧКО. ПО ТАКОМУ
Dialogue: 0,0:13:35.13,0:13:37.69,Caption,,0,0,0,,СЧЁТУ АБУ ДАБИ УЖЕ ВЫГЛЯДИТ ПОБЕДОЙ ДЕЛЕГАЦИИ
Dialogue: 0,0:13:37.69,0:13:43.13,Caption,,0,0,0,,СЪЕХАЛИСЬ, ОБМЕН СОГЛАСОВАЛИ, ДАТУ СЛЕДУЮЩЕГО РАУНДА НАЗВАЛИ. ТОЛЬКО НИ ОДИН ИЗ
Dialogue: 0,0:13:43.13,0:13:45.05,Caption,,0,0,0,,ЭТИХ ПУНКТОВ НЕ ОТВЕЧАЕТ НА ВОПРОС,
Dialogue: 0,0:13:45.29,0:13:47.37,Caption,,0,0,0,,КАКОЙ ВЫЙДЕТ ИЗ СОГЛАШЕНИЯ УКРАИНА.
Dialogue: 0,0:13:49.64,0:13:53.40,Caption,,0,0,0,,НЕТ. ЕСТЬ УСЛОВИЯ. ЕСТЬ ТРЕБОВАНИЯ. ЕСТЬ СОДЕРЖАНИЕ
Dialogue: 0,0:13:53.40,0:13:58.07,Caption,,0,0,0,,БУДУЩЕГО ДОКУМЕНТА. МОСКВА НЕ ОБЪЯВЛЯЛА,
Dialogue: 0,0:13:58.16,0:14:00.39,Caption,,0,0,0,,ЧТО ОТКАЗАЛАСЬ ОТ ЦЕЛЕЙ. ЗНАЧИТ,
Dialogue: 0,0:14:00.47,0:14:03.51,Caption,,0,0,0,,БЕРЁМ ИХ И СВЕРЯЕМ СО СТОЛОМ. ДЕМИЛИТАРИЗАЦИЯ?
Dialogue: 0,0:14:03.66,0:14:08.55,Caption,,0,0,0,,ВОСЕМЬСОТ ТЫСЯЧ. ТЕРРИТОРИИ? СОГЛАСИЯ НЕТ. ПОЛИТИЧЕСКОЕ УСТРОЙСТВО БУДУЩЕЙ
Dialogue: 0,0:14:08.55,0:14:12.15,Caption,,0,0,0,,УКРАИНЫ? НЕ ОПРЕДЕЛЕНО. НОВАЯ СИСТЕМА БЕЗОПАСНОСТИ?
Dialogue: 0,0:14:12.23,0:14:16.92,Caption,,0,0,0,,ОБСУЖДАЕТСЯ. ДАЛЬШЕ КАЖДЫЙ САМ РЕШАЕТ,
Dialogue: 0,0:14:17.07,0:14:19.24,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО ПРОДВИНУЛИСЬ ПЕРЕГОВОРЫ.
Dialogue: 0,0:14:21.51,0:14:24.47,Caption,,0,0,0,,ПОДПИСАТЬ ДОКУМЕНТ МОЖНО ЗА ОДИН ДЕНЬ. ТРУДНОСТИ
Dialogue: 0,0:14:24.47,0:14:26.95,Caption,,0,0,0,,НАЧИНАЮТСЯ ТАМ, ГДЕ НУЖНО ДОГОВОРИТЬСЯ,
Dialogue: 0,0:14:27.15,0:14:29.75,Caption,,0,0,0,,ЧТО ИМЕННО БУДЕТ НАПИСАНО МЕЛКИМ ШРИФТОМ.
Dialogue: 0,0:14:32.03,0:14:34.04,Caption,,0,0,0,,ВОТ ТАМ СЕЙЧАС И ЛЕЖИТ ВСЯ ИСТОРИЯ.
