Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,ВИТАЛИЙ КИМ ЗАГОВОРИЛ О ТОМ, ЧТО БУДЕТ,
Dialogue: 0,0:00:02.76,0:00:05.32,Caption,,0,0,0,,КОГДА ВОЕННЫЕ ВЕРНУТСЯ С ФРОНТА. И ЗНАЕТЕ,
Dialogue: 0,0:00:05.53,0:00:08.60,Caption,,0,0,0,,ЧТО УДИВИТЕЛЬНО? В ЕГО СЛОВАХ КУДА БОЛЬШЕ ТРЕВОГИ,
Dialogue: 0,0:00:08.74,0:00:11.32,Caption,,0,0,0,,ЧЕМ РАДОСТИ. ХОТЯ, КАЗАЛОСЬ БЫ,
Dialogue: 0,0:00:11.40,0:00:14.12,Caption,,0,0,0,,СВОИ ЛЮДИ ВОЗВРАЩАЮТСЯ ДОМОЙ. РАБОТАТЬ,
Dialogue: 0,0:00:14.25,0:00:17.48,Caption,,0,0,0,,ЖИТЬ, СЕМЬИ ВОССТАНАВЛИВАТЬ. ТАК ЧЕГО ЖЕ ТОГДА ТАК
Dialogue: 0,0:00:17.48,0:00:20.84,Caption,,0,0,0,,НЕРВНИЧАТЬ? И ПОЧЕМУ В ЭТИХ РАЗГОВОРАХ ВСЁ ЧАЩЕ ВСПЛЫВАЕТ
Dialogue: 0,0:00:20.84,0:00:24.60,Caption,,0,0,0,,ВОПРОС О ЗАКРЫТЫХ ГРАНИЦАХ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:24.76,0:00:27.72,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДЛЯ НАЧАЛА СОВСЕМ КОРОТКО ПРО ДЕНЬГИ.
Dialogue: 0,0:00:27.88,0:00:30.52,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ ФОНД РЕЗКО УХУДШИЛ ПРОГНОЗ
Dialogue: 0,0:00:30.52,0:00:33.48,Caption,,0,0,0,,ДЛЯ УКРАИНСКОЙ ЭКОНОМИКИ. В ОПУБЛИКОВАННОЙ ОЦЕНКЕ НА
Dialogue: 0,0:00:33.48,0:00:35.56,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ ГОД ВМЕСТО РОСТА В
Dialogue: 0,0:00:35.56,0:00:37.96,Caption,,0,0,0,,ОДИН ПРОЦЕНТ ФИГУРИРУЕТ ПАДЕНИЕ НА ПОЛОВИНУ
Dialogue: 0,0:00:37.96,0:00:41.24,Caption,,0,0,0,,ПРОЦЕНТА, А НА СЛЕДУЮЩИЙ ГОД ЕЩЁ МИНУС ОДИН ПРОЦЕНТ.
Dialogue: 0,0:00:41.56,0:00:44.12,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ЗВУЧАТ ТРЕБОВАНИЯ РАСШИРЯТЬ НАЛОГОВУЮ
Dialogue: 0,0:00:44.12,0:00:47.08,Caption,,0,0,0,,БАЗУ И СОБИРАТЬ БОЛЬШЕ ДЕНЕГ. КАРТИНА КРАСИВАЯ.
Dialogue: 0,0:00:47.26,0:00:51.72,Caption,,0,0,0,,ЭКОНОМИКА УМЕНЬШАЕТСЯ, А НАЛОГОВ С НЕЁ ХОТЯТ ПОЛУЧИТЬ БОЛЬШЕ. ЭНЕРГЕТИКА
Dialogue: 0,0:00:51.80,0:00:56.12,Caption,,0,0,0,,ЗДЕСЬ НЕ ОТДЕЛЬНАЯ ИСТОРИЯ, А ОДИН ИЗ МЕХАНИЗМОВ ЭТОГО СПАДА. НЬЮ ЙОРК
Dialogue: 0,0:00:56.12,0:00:59.08,Caption,,0,0,0,,ТАЙМС ПИШЕТ О КРАЙНЕЙ УЯЗВИМОСТИ УКРАИНСКИХ ГОРОДОВ.
Dialogue: 0,0:00:59.41,0:01:02.04,Caption,,0,0,0,,ЛЮДЕЙ УЖЕ ГОТОВЯТ К НЕСКОЛЬКИМ ЧАСАМ ЭЛЕКТРИЧЕСТВА В
Dialogue: 0,0:01:02.12,0:01:04.04,Caption,,0,0,0,,СУТКИ. КОРОЛЬЧУК ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:01:04.24,0:01:07.08,Caption,,0,0,0,,ЧТО ТАКОЙ РЕЖИМ СПОСОБЕН ТЯНУТЬСЯ НЕДЕЛЯМИ И БИТЬ
Dialogue: 0,0:01:07.08,0:01:09.64,Caption,,0,0,0,,ПО ШКОЛАМ, БОЛЬНИЦАМ И ДЕТСКИМ САДАМ.
Dialogue: 0,0:01:11.93,0:01:14.01,Caption,,0,0,0,,НО СПОРИТЬ О ДВУХ ИЛИ ЧЕТЫРЁХ ЧАСАХ СВЕТА
Dialogue: 0,0:01:14.01,0:01:16.49,Caption,,0,0,0,,БЕССМЫСЛЕННО, ЕСЛИ СЛЕДОМ ВСТАЁТ ВОПРОС,
Dialogue: 0,0:01:16.75,0:01:19.21,Caption,,0,0,0,,БУДЕТ ЛИ РАБОТАТЬ ПРЕДПРИЯТИЕ И БУДЕТ ЛИ У
Dialogue: 0,0:01:19.21,0:01:23.21,Caption,,0,0,0,,ЧЕЛОВЕКА ЗАРПЛАТА. И ВОТ НА ЭТОМ ФОНЕ ПОЯВЛЯЕТСЯ ВИТАЛИЙ КИМ
Dialogue: 0,0:01:23.29,0:01:26.25,Caption,,0,0,0,,СО СВОИМ ПОСЛЕВОЕННЫМ БУДУЩИМ. ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:01:26.49,0:01:28.73,Caption,,0,0,0,,ПОСЛЕ ОКОНЧАНИЯ БОЕВЫХ ДЕЙСТВИЙ В СТРАНЕ БУДЕТ
Dialogue: 0,0:01:28.73,0:01:31.77,Caption,,0,0,0,,БОЛЬШЕ ТРЁХ МИЛЛИОНОВ ВЕТЕРАНОВ. ВМЕСТЕ С СЕМЬЯМИ
Dialogue: 0,0:01:31.85,0:01:34.81,Caption,,0,0,0,,РЕЧЬ ИДЁТ ПРИМЕРНО О ДЕВЯТИ МИЛЛИОНАХ ЧЕЛОВЕК. ПОЧТИ
Dialogue: 0,0:01:34.89,0:01:37.45,Caption,,0,0,0,,ТРЕТЬ СТРАНЫ. И КИМ СОВЕРШЕННО ПРАВИЛЬНО ГОВОРИТ
Dialogue: 0,0:01:37.45,0:01:40.33,Caption,,0,0,0,,ОДНУ ВЕЩЬ. ПОСАДИТЬ ЭТИ МИЛЛИОНЫ НА ПОСОБИЯ И
Dialogue: 0,0:01:40.33,0:01:42.97,Caption,,0,0,0,,СКАЗАТЬ, ЧТО ГОСУДАРСТВО ТЕПЕРЬ ВСЕХ СОДЕРЖИТ,
Dialogue: 0,0:01:43.21,0:01:47.13,Caption,,0,0,0,,НЕ ПОЛУЧИТСЯ. НО ДАЛЬШЕ НАЧИНАЕТСЯ НАМНОГО ИНТЕРЕСНЕЕ. КИМА
Dialogue: 0,0:01:47.13,0:01:50.73,Caption,,0,0,0,,СПРАШИВАЮТ, ГОТОВА ЛИ СТРАНА К ВОЗВРАЩЕНИЮ БОЛЬШОГО КОЛИЧЕСТВА
Dialogue: 0,0:01:50.73,0:01:54.17,Caption,,0,0,0,,ВОЕННЫХ. ОТВЕТ КОРОТКИЙ. НЕТ. ПОТОМ ОН НАЧИНАЕТ
Dialogue: 0,0:01:54.17,0:01:57.29,Caption,,0,0,0,,ГОВОРИТЬ О ПРЕСТУПНОСТИ, СОЦИАЛЬНОЙ НАПРЯЖЁННОСТИ,
Dialogue: 0,0:01:57.45,0:02:00.89,Caption,,0,0,0,,РЕВОЛЮЦИЯХ. ПРИЧЁМ ФОРМУЛИРУЕТ ЭТО ЖЁСТКО. ТАКОЕ
Dialogue: 0,0:02:00.97,0:02:05.13,Caption,,0,0,0,,БУДЕТ. ОН ГОВОРИТ, ЧТО ПОСЛЕ ВОЙНЫ ЭКОНОМИКА ДОЛЖНА БЫТЬ ГОТОВА ПРИНЯТЬ
Dialogue: 0,0:02:05.13,0:02:10.01,Caption,,0,0,0,,ВЕТЕРАНОВ, ДАТЬ ИМ РАБОТУ, ВОЗМОЖНОСТЬ СОДЕРЖАТЬ СЕБЯ И СЕМЬИ. И ТУТ У
Dialogue: 0,0:02:10.09,0:02:13.21,Caption,,0,0,0,,МЕНЯ ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. ПОЧЕМУ ВИТАЛИЙ КИМ,
Dialogue: 0,0:02:13.45,0:02:16.01,Caption,,0,0,0,,ГОВОРЯ О ВОЗВРАЩЕНИИ СОБСТВЕННЫХ СОЛДАТ ДОМОЙ,
Dialogue: 0,0:02:16.25,0:02:18.81,Caption,,0,0,0,,ТАК БЫСТРО ДОХОДИТ ДО ПРЕСТУПНОСТИ И РЕВОЛЮЦИЙ?
Dialogue: 0,0:02:19.21,0:02:21.37,Caption,,0,0,0,,ПОТОМУ ЧТО ВОЗВРАЩАТЬСЯ БУДУТ НЕ ЛЮДИ ПОСЛЕ
Dialogue: 0,0:02:21.37,0:02:23.29,Caption,,0,0,0,,ПЯТИЛЕТНЕЙ КОМАНДИРОВКИ В БУХГАЛТЕРИИ.
Dialogue: 0,0:02:25.57,0:02:29.89,Caption,,0,0,0,,ВОЗВРАЩАТЬСЯ БУДУТ МУЖЧИНЫ, МНОГИЕ ИЗ КОТОРЫХ ГОДАМИ ЖИЛИ ПЛЕЧОМ К ПЛЕЧУ
Dialogue: 0,0:02:29.97,0:02:31.97,Caption,,0,0,0,,С ОДНИМИ И ТЕМИ ЖЕ ЛЮДЬМИ. У НИХ
Dialogue: 0,0:02:32.05,0:02:35.09,Caption,,0,0,0,,ЗА СПИНОЙ ФРОНТ. У НИХ ПОГИБШИЕ ТОВАРИЩИ. У
Dialogue: 0,0:02:35.09,0:02:38.21,Caption,,0,0,0,,НИХ ОПЫТ, КОТОРЫЙ НЕ ПОЛУЧАЮТ НА КУРСАХ И НЕ ПОКУПАЮТ
Dialogue: 0,0:02:38.29,0:02:41.09,Caption,,0,0,0,,ЗА ДЕНЬГИ. ОНИ ЗНАЮТ, КТО РЯДОМ НЕ ПОБЕЖИТ,
Dialogue: 0,0:02:41.25,0:02:46.05,Caption,,0,0,0,,КТО ВЫТАЩИТ, КТО ПРИКРОЕТ, КТО ВЫПОЛНИТ СЛОВО. ВОТ ЭТО И НАЗЫВАЕТСЯ БОЕВЫМ
Dialogue: 0,0:02:46.05,0:02:50.05,Caption,,0,0,0,,БРАТСТВОМ. КОНЕЧНО, ВСЕ ВЕТЕРАНЫ НЕ ПОСТРОЯТСЯ ОДНАЖДЫ УТРОМ В ОДНУ
Dialogue: 0,0:02:50.05,0:02:52.61,Caption,,0,0,0,,КОЛОННУ И НЕ ПОЙДУТ КУДА ТО ВМЕСТЕ. НО
Dialogue: 0,0:02:52.69,0:02:58.45,Caption,,0,0,0,,У ЭТИХ ЛЮДЕЙ УЖЕ ЕСТЬ ТО, ЧЕГО НЕТ У ОБЫЧНОЙ СЛУЧАЙНОЙ ТОЛПЫ. СВЯЗИ. ДОВЕРИЕ.
Dialogue: 0,0:02:58.79,0:03:01.57,Caption,,0,0,0,,ОПЫТ СОВМЕСТНЫХ ДЕЙСТВИЙ. АВТОРИТЕТ ЛЮДЕЙ,
Dialogue: 0,0:03:01.81,0:03:04.61,Caption,,0,0,0,,С КОТОРЫМИ ОНИ ПРОШЛИ ОЧЕНЬ ТЯЖЁЛЫЕ ГОДЫ. А
Dialogue: 0,0:03:04.61,0:03:07.09,Caption,,0,0,0,,ПРЕТЕНЗИИ К ПРОИСХОДЯЩЕМУ ИМ ЕЩЁ НЕ НАДО БУДЕТ
Dialogue: 0,0:03:07.09,0:03:09.97,Caption,,0,0,0,,СПЕЦИАЛЬНО ПРИДУМЫВАТЬ ПОСЛЕ ВОЗВРАЩЕНИЯ ДОМОЙ. ОНИ
Dialogue: 0,0:03:09.97,0:03:14.61,Caption,,0,0,0,,УЖЕ ПЯТЬ ЛЕТ ВИДЯТ, КАК РАБОТАЕТ МОБИЛИЗАЦИЯ. ВИДЯТ ИСТОРИИ С ЛЮДЬМИ,
Dialogue: 0,0:03:14.77,0:03:17.49,Caption,,0,0,0,,КОТОРЫХ ХВАТАЮТ НА УЛИЦАХ. ВИДЯТ ПРОБЛЕМЫ СО
Dialogue: 0,0:03:17.49,0:03:20.61,Caption,,0,0,0,,СНАБЖЕНИЕМ. ВИДЯТ СООБЩЕНИЯ О КОРРУПЦИОННЫХ ДЕЛАХ.
Dialogue: 0,0:03:20.93,0:03:24.13,Caption,,0,0,0,,ВИДЯТ, КАК ОГРОМНЫЕ ДЕНЬГИ ПРОХОДЯТ ЧЕРЕЗ ГОСУДАРСТВО ВО
Dialogue: 0,0:03:24.21,0:03:27.33,Caption,,0,0,0,,ВРЕМЯ КОНФЛИКТА. И ПРЕКРАСНО ПОНИМАЮТ РАЗНИЦУ МЕЖДУ
Dialogue: 0,0:03:27.33,0:03:30.53,Caption,,0,0,0,,ОКОПОМ И КАБИНЕТОМ. ВОТ ЗДЕСЬ РАЗГОВОР О ТОМ,
Dialogue: 0,0:03:30.76,0:03:33.17,Caption,,0,0,0,,ЧТО ПОСЛЕ ВОЗВРАЩЕНИЯ ОНИ ПРОСТО ДРУЖНО ПОЙДУТ
Dialogue: 0,0:03:33.17,0:03:37.57,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬ СТРАНУ, ВЫГЛЯДИТ СЛИШКОМ УДОБНЫМ. КТО ТО ПОЙДЁТ РАБОТАТЬ,
Dialogue: 0,0:03:37.66,0:03:40.85,Caption,,0,0,0,,КТО ТО ОТКРОЕТ БИЗНЕС, КТО ТО ПРОСТО ВЕРНЁТСЯ К СЕМЬЕ.
Dialogue: 0,0:03:43.13,0:03:45.29,Caption,,0,0,0,,НО КИМ САМ ГОВОРИТ НЕ ТОЛЬКО О РАБОТЕ.
Dialogue: 0,0:03:45.68,0:03:48.25,Caption,,0,0,0,,ОН ПРОИЗНОСИТ СЛОВА ПРО СОЦИАЛЬНУЮ НАПРЯЖЁННОСТЬ И
Dialogue: 0,0:03:48.33,0:03:51.53,Caption,,0,0,0,,РЕВОЛЮЦИИ. И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ САМОЕ НЕПРИЯТНОЕ
Dialogue: 0,0:03:51.53,0:03:54.09,Caption,,0,0,0,,ДЛЯ САМОГО КИМА И ТАКИХ ЖЕ ЧИНОВНИКОВ. ОНИ
Dialogue: 0,0:03:54.17,0:03:56.41,Caption,,0,0,0,,МОГУТ БОЯТЬСЯ НЕ СТОЛЬКО РАСХОДОВ НА ВЕТЕРАНОВ,
Dialogue: 0,0:03:56.64,0:03:59.61,Caption,,0,0,0,,СКОЛЬКО ВСТРЕЧИ С ЛЮДЬМИ, КОТОРЫЕ УЖЕ ПРЕКРАСНО ЗНАЮТ,
Dialogue: 0,0:03:59.84,0:04:02.49,Caption,,0,0,0,,ЗА ЧТО ХОТЯТ СПРОСИТЬ С ВЛАСТИ. ЭТИ ПРЕТЕНЗИИ
Dialogue: 0,0:04:02.49,0:04:05.37,Caption,,0,0,0,,НЕ ВОЗНИКНУТ ВНЕЗАПНО ПОСЛЕ ДЕМОБИЛИЗАЦИИ. ОНИ
Dialogue: 0,0:04:05.37,0:04:08.49,Caption,,0,0,0,,НАКАПЛИВАЛИСЬ ГОДАМИ. ПОКА ОДНИ СИДЕЛИ В ОКОПАХ,
Dialogue: 0,0:04:08.65,0:04:10.41,Caption,,0,0,0,,ДРУГИЕ РАСПОРЯЖАЛИСЬ БЮДЖЕТАМИ,
Dialogue: 0,0:04:10.64,0:04:13.53,Caption,,0,0,0,,РАСПРЕДЕЛЯЛИ КОНТРАКТЫ И ПРИНИМАЛИ РЕШЕНИЯ. И
Dialogue: 0,0:04:13.61,0:04:16.25,Caption,,0,0,0,,ВЕРНУВШИЕСЯ ВОЕННЫЕ ВПОЛНЕ МОГУТ ПОТРЕБОВАТЬ ОТВЕТА
Dialogue: 0,0:04:16.33,0:04:18.25,Caption,,0,0,0,,НЕ ОТ КАКОГО ТО АБСТРАКТНОГО ГОСУДАРСТВА,
Dialogue: 0,0:04:18.57,0:04:21.13,Caption,,0,0,0,,А ОТ ВПОЛНЕ КОНКРЕТНЫХ ЛЮДЕЙ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:04:21.21,0:04:23.53,Caption,,0,0,0,,НЕ ВОПРОС О ПОСОБИЯХ. ЭТО ВОПРОС О ТОМ,
Dialogue: 0,0:04:23.68,0:04:26.65,Caption,,0,0,0,,КОМУ ПРИДЁТСЯ ОТВЕЧАТЬ. ГДЕ БЫЛО СНАБЖЕНИЕ?
Dialogue: 0,0:04:26.81,0:04:30.49,Caption,,0,0,0,,КУДА УШЛИ ДЕНЬГИ? ПОЧЕМУ ОДИН ПЯТЬ ЛЕТ СИДЕЛ В ОКОПЕ,
Dialogue: 0,0:04:30.81,0:04:32.73,Caption,,0,0,0,,А ДРУГОЙ ЗА ЭТИ ЖЕ ПЯТЬ ЛЕТ ПРЕКРАСНО
Dialogue: 0,0:04:32.73,0:04:34.81,Caption,,0,0,0,,УСТРОИЛСЯ? КТО ПРИНИМАЛ РЕШЕНИЯ?
Dialogue: 0,0:04:35.05,0:04:39.05,Caption,,0,0,0,,КТО ОТВЕЧАЛ ЗА МОБИЛИЗАЦИЮ? КТО НАЖИВАЛСЯ НА ГОСУДАРСТВЕННЫХ ПОТОКАХ?
Dialogue: 0,0:04:39.39,0:04:42.25,Caption,,0,0,0,,КТО ТЕПЕРЬ СОБИРАЕТСЯ ОБЪЯСНЯТЬ ВСЁ ЭТО ЛЮДЯМ ЛИЧНО,
Dialogue: 0,0:04:42.56,0:04:46.89,Caption,,0,0,0,,А НЕ ЧЕРЕЗ ТЕЛЕВИЗОР? ВОТ ТУТ ПОСЛЕВОЕННАЯ ИСТОРИЯ НАЧИНАЕТ ВЫГЛЯДЕТЬ УЖЕ
Dialogue: 0,0:04:46.89,0:04:49.85,Caption,,0,0,0,,СОВСЕМ ИНАЧЕ. ПОТОМУ ЧТО НЕДОВОЛЬНЫЙ ЧЕЛОВЕК С УЛИЦЫ
Dialogue: 0,0:04:49.93,0:04:52.57,Caption,,0,0,0,,И ФРОНТОВИК С МНОГОЛЕТНИМ БОЕВЫМ ОПЫТОМ ВОСПРИНИМАЮТ
Dialogue: 0,0:04:52.57,0:04:54.65,Caption,,0,0,0,,ДАВЛЕНИЕ ВЛАСТИ СОВЕРШЕННО ПО РАЗНОМУ.
Dialogue: 0,0:04:56.92,0:04:59.64,Caption,,0,0,0,,ПОЛИЦЕЙСКОГО МОЖНО ПОДГОТОВИТЬ НА СТРЕЛЬБИЩЕ. НО
Dialogue: 0,0:04:59.72,0:05:02.84,Caption,,0,0,0,,СТРЕЛЬБИЩЕ НЕ ЗАМЕНИТ ГОДЫ ФРОНТА. ТАМ ЛЮДИ УЧАТСЯ
Dialogue: 0,0:05:02.84,0:05:07.00,Caption,,0,0,0,,ДЕЙСТВОВАТЬ ВМЕСТЕ, ДОВЕРЯТЬ ТОВАРИЩАМ И ПРИНИМАТЬ РЕШЕНИЯ В УСЛОВИЯХ,
Dialogue: 0,0:05:07.16,0:05:10.28,Caption,,0,0,0,,КОГДА ОШИБКА СТОИТ ЖИЗНИ. ЭТОТ ОПЫТ НИКУДА НЕ
Dialogue: 0,0:05:10.36,0:05:13.40,Caption,,0,0,0,,ИСЧЕЗАЕТ ПОСЛЕ ВОЗВРАЩЕНИЯ ДОМОЙ. ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:05:13.64,0:05:16.28,Caption,,0,0,0,,ЧТО ВСЕ ВЕТЕРАНЫ АВТОМАТИЧЕСКИ СТАНУТ ЕДИНОЙ СИЛОЙ.
Dialogue: 0,0:05:16.73,0:05:19.56,Caption,,0,0,0,,НО СЧИТАТЬ ИХ ОБЫЧНОЙ РАЗРОЗНЕННОЙ ТОЛПОЙ ДЛЯ ВЛАСТИ
Dialogue: 0,0:05:19.88,0:05:21.96,Caption,,0,0,0,,БЫЛО БЫ БОЛЬШОЙ ОШИБКОЙ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:05:22.04,0:05:24.68,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ЕСТЬ И ЕЩЁ ОДНА
Dialogue: 0,0:05:24.68,0:05:27.24,Caption,,0,0,0,,ВЕЩЬ. ВЕТЕРАНСКИЕ ОБЪЕДИНЕНИЯ СПОСОБНЫ СТАТЬ
Dialogue: 0,0:05:27.24,0:05:29.32,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОЙ ПОЛИТИЧЕСКОЙ СИЛОЙ,
Dialogue: 0,0:05:29.56,0:05:31.96,Caption,,0,0,0,,КОТОРУЮ НЕЛЬЗЯ ПРОСТО ВСТРОИТЬ В СУЩЕСТВУЮЩУЮ
Dialogue: 0,0:05:31.96,0:05:34.76,Caption,,0,0,0,,ВЕРТИКАЛЬ ВЛАСТИ. ПОТОМУ ЧТО ВО ВРЕМЯ КОНФЛИКТА
Dialogue: 0,0:05:35.00,0:05:37.16,Caption,,0,0,0,,ВЛАСТЬ ЖИВЁТ В ОЧЕНЬ УДОБНОЙ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:05:37.16,0:05:40.92,Caption,,0,0,0,,КОНСТРУКЦИИ. НА ВСЁ ЕСТЬ ОДИН ОГРОМНЫЙ ОТВЕТ. ИДУТ
Dialogue: 0,0:05:40.92,0:05:45.64,Caption,,0,0,0,,БОЕВЫЕ ДЕЙСТВИЯ. ДЕНЕГ МАЛО, ПОТОМУ ЧТО КОНФЛИКТ. ЭКОНОМИКА ПРОСЕДАЕТ,
Dialogue: 0,0:05:45.80,0:05:48.04,Caption,,0,0,0,,ПОТОМУ ЧТО КОНФЛИКТ. ОГРАНИЧЕНИЯ,
Dialogue: 0,0:05:48.15,0:05:50.20,Caption,,0,0,0,,ПОТОМУ ЧТО КОНФЛИКТ. ПРОБЛЕМЫ,
Dialogue: 0,0:05:50.44,0:05:52.92,Caption,,0,0,0,,ПОТОМУ ЧТО КОНФЛИКТ. А ПОТОМ БОЕВЫЕ ДЕЙСТВИЯ
Dialogue: 0,0:05:52.92,0:05:55.64,Caption,,0,0,0,,ЗАКАНЧИВАЮТСЯ. И В КАБИНЕТ ПРИХОДИТ ЧЕЛОВЕК,
Dialogue: 0,0:05:55.80,0:05:58.04,Caption,,0,0,0,,КОТОРЫЙ САМ ЭТИ ПЯТЬ ЛЕТ ПРОВЁЛ ТАМ,
Dialogue: 0,0:05:58.12,0:06:00.84,Caption,,0,0,0,,КУДА ЕГО ОТПРАВИЛО ГОСУДАРСТВО. ЕМУ УЖЕ НЕМНОГО
Dialogue: 0,0:06:00.84,0:06:05.32,Caption,,0,0,0,,ТРУДНЕЕ ОБЪЯСНИТЬ, ЧТО НАДО ЕЩЁ ПОТЕРПЕТЬ. ОСОБЕННО ЕСЛИ РАБОТЫ НЕТ.
Dialogue: 0,0:06:05.64,0:06:08.68,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ ЖИЛЬЁ РАЗРУШЕНО. ОСОБЕННО ЕСЛИ ЦЕНЫ
Dialogue: 0,0:06:08.68,0:06:13.69,Caption,,0,0,0,,ВЫРОСЛИ. ОСОБЕННО ЕСЛИ ОН ВИДИТ ПЕРЕД СОБОЙ ЧЕЛОВЕКА,
Dialogue: 0,0:06:14.01,0:06:16.49,Caption,,0,0,0,,КОТОРЫЙ ВСЕ ЭТИ ГОДЫ ЖИЛ СОВСЕМ ДРУГОЙ ЖИЗНЬЮ.
Dialogue: 0,0:06:17.11,0:06:18.97,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ПОСМОТРИТЕ НА СЛОВА КИМА С
Dialogue: 0,0:06:18.97,0:06:23.61,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ. ОН ГОВОРИТ, ЧТО ГОСУДАРСТВО ДОЛЖНО ПОДГОТОВИТЬСЯ К ВОЗВРАЩЕНИЮ
Dialogue: 0,0:06:23.61,0:06:28.17,Caption,,0,0,0,,ВЕТЕРАНОВ. А ЧТО, ЕСЛИ ДЛЯ ЧАСТИ ЧИНОВНИКОВ ГЛАВНАЯ ЗАДАЧА ЗАКЛЮЧАЕТСЯ
Dialogue: 0,0:06:28.17,0:06:30.49,Caption,,0,0,0,,СОВСЕМ НЕ В ТОМ, КАК ПОМОЧЬ ЭТИМ ЛЮДЯМ?
Dialogue: 0,0:06:30.71,0:06:33.13,Caption,,0,0,0,,ЧТО, ЕСЛИ ОНИ ПРЕЖДЕ ВСЕГО ДУМАЮТ,
Dialogue: 0,0:06:33.23,0:06:35.93,Caption,,0,0,0,,КАК САМИМ СОХРАНИТЬ ДОЛЖНОСТИ И СПОКОЙНУЮ ЖИЗНЬ,
Dialogue: 0,0:06:36.17,0:06:38.65,Caption,,0,0,0,,КОГДА С ФРОНТА ВЕРНУТСЯ ЛЮДИ С УЖЕ НАКОПИВШИМИСЯ
Dialogue: 0,0:06:38.65,0:06:42.01,Caption,,0,0,0,,ПРЕТЕНЗИЯМИ? ВОТ ЭТОГО КИМ ВСЛУХ НЕ ГОВОРИТ. НО ИМЕННО
Dialogue: 0,0:06:42.09,0:06:44.57,Caption,,0,0,0,,ТАКОЙ ВОПРОС ВОЗНИКАЕТ ПОСЛЕ ЕГО ПРЕДУПРЕЖДЕНИЙ О
Dialogue: 0,0:06:44.57,0:06:47.53,Caption,,0,0,0,,СОЦИАЛЬНОЙ НАПРЯЖЁННОСТИ И РЕВОЛЮЦИЯХ. ПОСМОТРИТЕ,
Dialogue: 0,0:06:47.69,0:06:50.57,Caption,,0,0,0,,КАК ИНТЕРЕСНО РЯДОМ ПОЯВЛЯЕТСЯ ТЕМА ГРАНИЦ. КИМ
Dialogue: 0,0:06:50.57,0:06:53.05,Caption,,0,0,0,,ПРЯМО ГОВОРИТ, ЧТО ЕСЛИ ОТКРЫТЬ ГРАНИЦЫ,
Dialogue: 0,0:06:53.15,0:06:56.01,Caption,,0,0,0,,ЛЮДИ ПОЕДУТ. ТО ЕСТЬ ВЛАСТИ ЗАРАНЕЕ ПОНИМАЮТ,
Dialogue: 0,0:06:56.25,0:06:59.05,Caption,,0,0,0,,ЧТО ПОСЛЕ СНЯТИЯ ОГРАНИЧЕНИЙ ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:06:59.05,0:07:01.93,Caption,,0,0,0,,НАСЕЛЕНИЯ МОЖЕТ ПРОСТО СОБРАТЬ ВЕЩИ И УЕХАТЬ. ПО
Dialogue: 0,0:07:01.93,0:07:03.53,Caption,,0,0,0,,ДАННЫМ ОПРОСА GRADUS RESEARCH,
Dialogue: 0,0:07:03.68,0:07:05.53,Caption,,0,0,0,,КОТОРЫЕ ПРИВОДИЛИСЬ В ЭТОЙ ДИСКУССИИ,
Dialogue: 0,0:07:05.85,0:07:08.01,Caption,,0,0,0,,ДОЛЯ УКРАИНЦЕВ В СТРАНАХ ЕВРОСОЮЗА,
Dialogue: 0,0:07:08.25,0:07:10.89,Caption,,0,0,0,,НЕ ПЛАНИРУЮЩИХ ВОЗВРАЩАТЬСЯ ДАЖЕ ПОСЛЕ ОКОНЧАНИЯ
Dialogue: 0,0:07:10.89,0:07:13.21,Caption,,0,0,0,,КОНФЛИКТА НА ПРИЕМЛЕМЫХ ДЛЯ КИЕВА УСЛОВИЯХ,
Dialogue: 0,0:07:13.60,0:07:16.17,Caption,,0,0,0,,ВЫРОСЛА ЗА ГОД С СЕМНАДЦАТИ ДО ТРИДЦАТИ ЧЕТЫРЁХ
Dialogue: 0,0:07:16.17,0:07:19.37,Caption,,0,0,0,,ПРОЦЕНТОВ. КАЖДЫЙ ТРЕТИЙ. И ПРОБЛЕМА ТУТ ДВОЙНАЯ.
Dialogue: 0,0:07:21.64,0:07:23.88,Caption,,0,0,0,,ЭКОНОМИКЕ ЭТИ ЛЮДИ НУЖНЫ КАК РАБОЧИЕ,
Dialogue: 0,0:07:23.96,0:07:28.20,Caption,,0,0,0,,СПЕЦИАЛИСТЫ, ПРЕДПРИНИМАТЕЛИ И НАЛОГОПЛАТЕЛЬЩИКИ. БЕЗ НИХ НЕКОМУ
Dialogue: 0,0:07:28.20,0:07:30.36,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬ СТРАНУ И ФИНАНСИРОВАТЬ ТЕ ЖЕ
Dialogue: 0,0:07:30.36,0:07:33.00,Caption,,0,0,0,,СОЦИАЛЬНЫЕ ПРОГРАММЫ. ТО ЕСТЬ ОТКРЫТЬ ГРАНИЦЫ
Dialogue: 0,0:07:33.00,0:07:36.36,Caption,,0,0,0,,СТРАШНО. ЛЮДИ УЕДУТ. А ТЕПЕРЬ ПОСМОТРИМ НА ОТКРЫТЫЕ
Dialogue: 0,0:07:36.36,0:07:40.52,Caption,,0,0,0,,ГРАНИЦЫ ГЛАЗАМИ ЧИНОВНИКА, КОТОРЫЙ ОПАСАЕТСЯ ВОЗВРАЩЕНИЯ НЕДОВОЛЬНЫХ
Dialogue: 0,0:07:40.52,0:07:43.56,Caption,,0,0,0,,ФРОНТОВИКОВ. ЕСЛИ ЧАСТЬ ЭТИХ ЛЮДЕЙ САМА УЕДЕТ ИЗ
Dialogue: 0,0:07:43.64,0:07:46.44,Caption,,0,0,0,,СТРАНЫ, СПРАШИВАТЬ С НЕГО ДОМА БУДЕТ УЖЕ НЕКОМУ ИЗ
Dialogue: 0,0:07:46.52,0:07:49.88,Caption,,0,0,0,,ТЕХ, КТО УЕХАЛ. ДЛЯ ТАКОГО ЧИНОВНИКА ЭТО МОЖЕТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:07:49.96,0:07:52.52,Caption,,0,0,0,,КУДА ПРИВЛЕКАТЕЛЬНЕЕ, ЧЕМ ВСТРЕЧА С ВЕТЕРАНАМИ,
Dialogue: 0,0:07:52.74,0:07:57.24,Caption,,0,0,0,,КОТОРЫЕ ЗАХОТЯТ ВЫЯСНИТЬ, КУДА УХОДИЛИ ДЕНЬГИ И КТО ПРИНИМАЛ РЕШЕНИЯ. ДЛЯ
Dialogue: 0,0:07:57.24,0:07:59.96,Caption,,0,0,0,,ЭКОНОМИКИ ПЛОХО. ДЛЯ БЮДЖЕТА ПЛОХО. ДЛЯ
Dialogue: 0,0:07:59.96,0:08:02.60,Caption,,0,0,0,,ВОССТАНОВЛЕНИЯ СТРАНЫ ПЛОХО. А ДЛЯ ОТДЕЛЬНОГО
Dialogue: 0,0:08:02.60,0:08:07.40,Caption,,0,0,0,,КАБИНЕТА, ГЛЯДИШЬ, ДАЖЕ СПОКОЙНЕЕ. ВОТ ВАМ И ЗАМЕЧАТЕЛЬНАЯ ПОСЛЕВОЕННАЯ
Dialogue: 0,0:08:07.40,0:08:09.64,Caption,,0,0,0,,АРИФМЕТИКА. ОДНИХ НАДО УДЕРЖАТЬ,
Dialogue: 0,0:08:09.80,0:08:12.52,Caption,,0,0,0,,ПОТОМУ ЧТО БЕЗ НИХ НЕКОМУ РАБОТАТЬ. ДРУГИХ НАДО
Dialogue: 0,0:08:12.52,0:08:16.60,Caption,,0,0,0,,ТРУДОУСТРОИТЬ, ПОТОМУ ЧТО ПОСОБИЯМИ МИЛЛИОНЫ НЕ ПРОКОРМИШЬ. ТРЕТЬИ
Dialogue: 0,0:08:16.60,0:08:19.24,Caption,,0,0,0,,УЖЕ ЖИВУТ В ЕВРОПЕ И ВОЗВРАЩАТЬСЯ НЕ СОБИРАЮТСЯ.
Dialogue: 0,0:08:19.56,0:08:23.88,Caption,,0,0,0,,А ТЕ, КТО ВЕРНЁТСЯ С ФРОНТА, МОГУТ ОКАЗАТЬСЯ САМОЙ ОРГАНИЗОВАННОЙ И САМОЙ
Dialogue: 0,0:08:23.88,0:08:26.76,Caption,,0,0,0,,НЕУДОБНОЙ ЧАСТЬЮ ОБЩЕСТВА. И НА ЭТОМ ФОНЕ НА
Dialogue: 0,0:08:26.84,0:08:29.88,Caption,,0,0,0,,ГРАНИЦЕ С РУМЫНИЕЙ УЖЕ ОБСУЖДАЮТ КОЛЮЧУЮ ПРОВОЛОКУ.
Dialogue: 0,0:08:30.26,0:08:33.00,Caption,,0,0,0,,ЕЁ НАЗНАЧЕНИЕ В КОНКРЕТНОМ МЕСТЕ ОТДЕЛЬНЫЙ ВОПРОС.
Dialogue: 0,0:08:35.28,0:08:38.24,Caption,,0,0,0,,НО САМ ОБРАЗ ПОЛУЧИЛСЯ СИМВОЛИЧНЫЙ. СТРАНА,
Dialogue: 0,0:08:38.40,0:08:41.04,Caption,,0,0,0,,КОТОРОЙ ПОСЛЕ КОНФЛИКТА ОТЧАЯННО ПОНАДОБЯТСЯ ЛЮДИ,
Dialogue: 0,0:08:41.29,0:08:44.88,Caption,,0,0,0,,УЖЕ СЕЙЧАС ЖИВЁТ В РЕЖИМЕ, ГДЕ ГЛАВНЫЙ СТРАХ СВЯЗАН С ТЕМ,
Dialogue: 0,0:08:44.97,0:08:49.20,Caption,,0,0,0,,ЧТО ЛЮДИ РАЗБЕГУТСЯ. И ТУТ ЭКОНОМИКА СНОВА ВОЗВРАЩАЕТСЯ В ИСТОРИЮ,
Dialogue: 0,0:08:49.44,0:08:51.04,Caption,,0,0,0,,НО УЖЕ СОВСЕМ С ДРУГОЙ СТОРОНЫ.
Dialogue: 0,0:08:51.62,0:08:55.20,Caption,,0,0,0,,МВФ ТРЕБУЕТ БОЛЬШЕ ДОХОДОВ БЮДЖЕТА. ХОРОШО. А КТО
Dialogue: 0,0:08:55.28,0:08:58.88,Caption,,0,0,0,,ИХ ПРИНЕСЁТ? МАЛЫЙ БИЗНЕС, КОТОРОМУ ДОБАВЯТ НАЛОГОВУЮ НАГРУЗКУ?
Dialogue: 0,0:08:59.17,0:09:01.84,Caption,,0,0,0,,ПРЕДПРИЯТИЯ, КОТОРЫЕ ЗАВИСЯТ ОТ ЭЛЕКТРИЧЕСТВА?
Dialogue: 0,0:09:02.24,0:09:04.32,Caption,,0,0,0,,ЛЮДИ, КОТОРЫЕ СОБИРАЮТСЯ УЕХАТЬ?
Dialogue: 0,0:09:04.56,0:09:07.52,Caption,,0,0,0,,ВЕТЕРАНЫ, КОТОРЫМ СНАЧАЛА НАДО НАЙТИ РАБОТУ,
Dialogue: 0,0:09:07.64,0:09:09.60,Caption,,0,0,0,,ЖИЛЬЁ И ВОЗМОЖНОСТЬ НОРМАЛЬНО ЖИТЬ?
Dialogue: 0,0:09:10.16,0:09:12.88,Caption,,0,0,0,,НА БУМАГЕ ВСЁ СХОДИТСЯ. БУМАГЕ ЭЛЕКТРИЧЕСТВО НЕ
Dialogue: 0,0:09:12.88,0:09:15.36,Caption,,0,0,0,,НУЖНО И ЗАРПЛАТУ ЕЙ ПЛАТИТЬ НЕ НАДО. А
Dialogue: 0,0:09:15.44,0:09:18.56,Caption,,0,0,0,,САМОЕ НЕПРИЯТНОЕ НАЧИНАЕТСЯ ДАЛЬШЕ. ПОСЛЕ ОКОНЧАНИЯ
Dialogue: 0,0:09:18.56,0:09:21.36,Caption,,0,0,0,,КОНФЛИКТА УКРАИНЕ ПОНАДОБИТСЯ НЕ ТОЛЬКО МНОГО ДЕНЕГ.
Dialogue: 0,0:09:21.68,0:09:23.92,Caption,,0,0,0,,БЕТОН МОЖНО КУПИТЬ, КАБЕЛЬ ЗАМЕНИТЬ,
Dialogue: 0,0:09:24.12,0:09:27.20,Caption,,0,0,0,,КРЕДИТ ВЗЯТЬ ЕЩЁ ОДИН. А ВОТ ДОВЕРИЕ ЧЕЛОВЕКА,
Dialogue: 0,0:09:27.44,0:09:30.00,Caption,,0,0,0,,КОТОРЫЙ ПЯТЬ ЛЕТ ВЫПОЛНЯЛ ПРИКАЗЫ ГОСУДАРСТВА,
Dialogue: 0,0:09:30.24,0:09:33.52,Caption,,0,0,0,,А ПОТОМ ВЕРНУЛСЯ И РЕШИЛ, ЧТО ГОСУДАРСТВО ЕГО ОБМАНУЛО,
Dialogue: 0,0:09:33.76,0:09:36.00,Caption,,0,0,0,,В БАНКЕ УЖЕ НЕ ОДОЛЖИШЬ. И КИМ,
Dialogue: 0,0:09:36.24,0:09:38.80,Caption,,0,0,0,,СУДЯ ПО ЕГО СОБСТВЕННЫМ СЛОВАМ О ПРЕСТУПНОСТИ,
Dialogue: 0,0:09:38.96,0:09:41.12,Caption,,0,0,0,,СОЦИАЛЬНОЙ НАПРЯЖЁННОСТИ И РЕВОЛЮЦИЯХ,
Dialogue: 0,0:09:41.36,0:09:45.68,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЕТ, НАСКОЛЬКО ТЯЖЁЛЫМ БУДЕТ ЭТОТ РАЗГОВОР. ПОЭТОМУ
Dialogue: 0,0:09:45.68,0:09:48.96,Caption,,0,0,0,,ВОПРОС ЗДЕСЬ НЕ ТОЛЬКО В ТОМ, ХВАТИТ ЛИ ДЕНЕГ НА ВОССТАНОВЛЕНИЕ.
Dialogue: 0,0:09:51.24,0:09:55.57,Caption,,0,0,0,,ВОПРОС В ТОМ, КТО БУДЕТ ВОССТАНАВЛИВАТЬ СТРАНУ. КТО ОСТАНЕТСЯ. КТО
Dialogue: 0,0:09:55.57,0:09:58.04,Caption,,0,0,0,,УЕДЕТ. КТО ВЕРНЁТСЯ. И ГЛАВНОЕ,
Dialogue: 0,0:09:58.22,0:10:02.76,Caption,,0,0,0,,ЧТО ЭТИ ЛЮДИ СКАЖУТ ТЕМ, КТО ВСТРЕТИТ ИХ В КАБИНЕТАХ. ПОТОМУ ЧТО ЗАКОНЧИТЬ
Dialogue: 0,0:10:02.84,0:10:05.33,Caption,,0,0,0,,БОЕВЫЕ ДЕЙСТВИЯ И ЗАКОНЧИТЬ ПОСЛЕДСТВИЯ БОЕВЫХ
Dialogue: 0,0:10:05.33,0:10:06.92,Caption,,0,0,0,,ДЕЙСТВИЙ ЭТО СОВСЕМ НЕ ОДНО И ТО ЖЕ.
Dialogue: 0,0:10:07.40,0:10:09.96,Caption,,0,0,0,,ИНОГДА ИМЕННО ПОСЛЕ ВОЗВРАЩЕНИЯ ДОМОЙ И НАЧИНАЕТСЯ
Dialogue: 0,0:10:09.96,0:10:11.40,Caption,,0,0,0,,САМЫЙ НЕУДОБНЫЙ РАЗГОВОР.
