Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ЕСТЬ ЗАМЕЧАТЕЛЬНАЯ ПОЛИТИЧЕСКАЯ ПРИВЫЧКА. СНАЧАЛА
Dialogue: 0,0:00:03.08,0:00:05.16,Caption,,0,0,0,,ОБЪЯВИТЬ, КУДА СОБИРАЕШЬСЯ ИДТИ,
Dialogue: 0,0:00:05.40,0:00:09.80,Caption,,0,0,0,,А ПОТОМ УЖЕ РАЗБИРАТЬСЯ, КАК ТУДА ДОБРАТЬСЯ. АРМЕНИЯ РЕШИЛА ДВИГАТЬСЯ В
Dialogue: 0,0:00:09.80,0:00:13.24,Caption,,0,0,0,,ЕВРОСОЮЗ. ЗВУЧИТ ПОНЯТНО. ТОЛЬКО ПО ДОРОГЕ ВНЕЗАПНО
Dialogue: 0,0:00:13.24,0:00:16.28,Caption,,0,0,0,,ОБНАРУЖИЛИСЬ ОДКБ, ЕАЭС, РОССИЯ,
Dialogue: 0,0:00:16.37,0:00:18.52,Caption,,0,0,0,,ГРУЗИЯ И ЕЩЁ НЕСКОЛЬКО ДВЕРЕЙ,
Dialogue: 0,0:00:18.68,0:00:20.92,Caption,,0,0,0,,КЛЮЧИ ОТ КОТОРЫХ ЛЕЖАТ ВООБЩЕ НЕ В ЕРЕВАНЕ.
Dialogue: 0,0:00:21.16,0:00:24.04,Caption,,0,0,0,,И ВОТ ТУТ МАРШРУТ СТАНОВИТСЯ ГОРАЗДО ВЕСЕЛЕЕ. ЕСЛИ
Dialogue: 0,0:00:24.04,0:00:28.20,Caption,,0,0,0,,ВАМ НРАВЯТСЯ ТАКИЕ РАЗБОРЫ, ГДЕ МЫ СМОТРИМ НЕ ТОЛЬКО НА ГРОМКОЕ ЗАЯВЛЕНИЕ,
Dialogue: 0,0:00:28.45,0:00:31.40,Caption,,0,0,0,,НО И НА ТО, ЧТО ПОТОМ ПРИХОДИТСЯ ДЕЛАТЬ РУКАМИ,
Dialogue: 0,0:00:31.53,0:00:34.76,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:34.96,0:00:37.64,Caption,,0,0,0,,КОГДА САМО ЗАЯВЛЕНИЕ ЗАНИМАЕТ ОДНУ СТРОЧКУ,
Dialogue: 0,0:00:37.96,0:00:40.20,Caption,,0,0,0,,А ПОСЛЕДСТВИЯ НАЧИНАЮТ РАСПОЛЗАТЬСЯ СРАЗУ В
Dialogue: 0,0:00:40.20,0:00:42.12,Caption,,0,0,0,,НЕСКОЛЬКО СТОРОН. ПАШИНЯН СКАЗАЛ,
Dialogue: 0,0:00:42.44,0:00:45.08,Caption,,0,0,0,,ЧТО АРМЕНИЯ МОЖЕТ ПОДАТЬ ЗАЯВКУ НА ВСТУПЛЕНИЕ В
Dialogue: 0,0:00:45.08,0:00:47.32,Caption,,0,0,0,,ЕВРОСОЮЗ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ИЛИ ДВЕ
Dialogue: 0,0:00:47.32,0:00:50.04,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ОБРАТИТЕ ВНИМАНИЕ НА
Dialogue: 0,0:00:50.04,0:00:53.64,Caption,,0,0,0,,ФОРМУЛИРОВКУ. ПОДАТЬ ЗАЯВКУ. НЕ ВСТУПИТЬ. НЕ
Dialogue: 0,0:00:53.72,0:00:56.20,Caption,,0,0,0,,ПОЛУЧИТЬ ЧЛЕНСКИЙ БИЛЕТ. НЕ НАЧАТЬ РАЗМАХИВАТЬ
Dialogue: 0,0:00:56.20,0:00:58.52,Caption,,0,0,0,,ЕВРОПЕЙСКИМ ФЛАГОМ ВОЗЛЕ КАЖДОГО МИНИСТЕРСТВА.
Dialogue: 0,0:00:58.76,0:01:02.04,Caption,,0,0,0,,ПРОСТО ПОДАТЬ ЗАЯВКУ. НО ПОЛИТИКА УСТРОЕНА ДОВОЛЬНО
Dialogue: 0,0:01:02.04,0:01:05.00,Caption,,0,0,0,,ХИТРО. ИНОГДА ТЫ ЕЩЁ ДАЖЕ ЗАЯВЛЕНИЕ НЕ НАПИСАЛ,
Dialogue: 0,0:01:05.24,0:01:08.36,Caption,,0,0,0,,А ПЛАТИТЬ ЗА НОВЫЙ МАРШРУТ УЖЕ НАЧИНАЕШЬ. АРМЕНИЯ
Dialogue: 0,0:01:08.44,0:01:11.00,Caption,,0,0,0,,МНОГО ЛЕТ БЫЛА ВСТРОЕНА СОВСЕМ В ДРУГУЮ СИСТЕМУ.
Dialogue: 0,0:01:13.29,0:01:16.25,Caption,,0,0,0,,ЕАЭС, РОССИЙСКИЙ РЫНОК, РОССИЙСКИЕ ТОВАРЫ,
Dialogue: 0,0:01:16.35,0:01:20.17,Caption,,0,0,0,,РОССИЙСКАЯ ЛОГИСТИКА, ОДКБ, СТАРЫЕ ДОГОВОРЁННОСТИ,
Dialogue: 0,0:01:20.27,0:01:23.45,Caption,,0,0,0,,СТАРЫЕ СВЯЗИ. ВСЁ ЭТО НЕЛЬЗЯ ВЫКЛЮЧИТЬ ОДНОЙ КНОПКОЙ
Dialogue: 0,0:01:23.53,0:01:26.33,Caption,,0,0,0,,В КАБИНЕТЕ ПРЕМЬЕРА. НЕЛЬЗЯ УТРОМ ПРОСНУТЬСЯ,
Dialogue: 0,0:01:26.49,0:01:29.53,Caption,,0,0,0,,СКАЗАТЬ ВСЁ, РЕБЯТА, С ПОНЕДЕЛЬНИКА МЫ ЕВРОПА,
Dialogue: 0,0:01:29.77,0:01:32.49,Caption,,0,0,0,,И К ОБЕДУ ОБНАРУЖИТЬ ВОЗЛЕ ЕРЕВАНА НОВЫЙ РОТТЕРДАМ.
Dialogue: 0,0:01:32.95,0:01:35.37,Caption,,0,0,0,,ЭКОНОМИКА ТАК НЕ РАБОТАЕТ. У АРМЯНСКИХ
Dialogue: 0,0:01:35.37,0:01:38.57,Caption,,0,0,0,,ПРОИЗВОДИТЕЛЕЙ ЕСТЬ ПРИВЫЧНЫЕ РЫНКИ. ЕСТЬ МАРШРУТЫ.
Dialogue: 0,0:01:38.81,0:01:44.09,Caption,,0,0,0,,ЕСТЬ СТАНДАРТЫ. ЕСТЬ ЛЮДИ, КОТОРЫЕ ГОДАМИ ПОКУПАЮТ КОНКРЕТНЫЙ ТОВАР. ЕСТЬ
Dialogue: 0,0:01:44.09,0:01:46.81,Caption,,0,0,0,,КОМПАНИИ, КОТОРЫЕ ЗНАЮТ, КОМУ ЗВОНИТЬ,
Dialogue: 0,0:01:46.89,0:01:49.29,Caption,,0,0,0,,КУДА ВЕЗТИ, СКОЛЬКО СТОИТ МАШИНА,
Dialogue: 0,0:01:49.45,0:01:52.57,Caption,,0,0,0,,СКОЛЬКО ЗАНИМАЕТ ТАМОЖНЯ. А ПОТОМ ПОЛИТИКА НАЧИНАЕТ
Dialogue: 0,0:01:52.57,0:01:55.37,Caption,,0,0,0,,ЭТОТ ПРИВЫЧНЫЙ СТОЛ ШАТАТЬ. РОССИЯ ВВОДИТ
Dialogue: 0,0:01:55.37,0:01:58.57,Caption,,0,0,0,,ОГРАНИЧЕНИЯ НА ОТДЕЛЬНЫЕ АРМЯНСКИЕ ТОВАРЫ. ЕВРОСОЮЗ
Dialogue: 0,0:01:58.57,0:02:01.69,Caption,,0,0,0,,ОТВЕЧАЕТ ТОРГОВЫМИ ПОСЛАБЛЕНИЯМИ. ТО ЕСТЬ СПОР УЖЕ
Dialogue: 0,0:02:01.69,0:02:04.17,Caption,,0,0,0,,ИДЁТ НЕ ВОКРУГ КРАСИВЫХ СЛОВ О ЦИВИЛИЗАЦИОННОМ
Dialogue: 0,0:02:04.25,0:02:06.57,Caption,,0,0,0,,ВЫБОРЕ. ОН ПРИХОДИТ ПРЯМО К ЧЕЛОВЕКУ,
Dialogue: 0,0:02:06.83,0:02:09.45,Caption,,0,0,0,,КОТОРЫЙ ВЧЕРА СПОКОЙНО ПРОДАВАЛ СВОЙ ТОВАР ТУДА,
Dialogue: 0,0:02:09.68,0:02:12.33,Caption,,0,0,0,,КУДА ПРОДАВАЛ ДЕСЯТЬ ЛЕТ. И ВОТ СИДИТ ЭТОТ
Dialogue: 0,0:02:12.33,0:02:14.57,Caption,,0,0,0,,УСЛОВНЫЙ АРМЯНСКИЙ ПРЕДПРИНИМАТЕЛЬ И СЛУШАЕТ
Dialogue: 0,0:02:14.57,0:02:18.25,Caption,,0,0,0,,ПОЛИТИКОВ. ОДНИ ГОВОРЯТ ЕВРОПЕЙСКОЕ БУДУЩЕЕ. ДРУГИЕ
Dialogue: 0,0:02:18.25,0:02:20.97,Caption,,0,0,0,,ГОВОРЯТ СТАРЫЙ РЫНОК. А ОН СМОТРИТ НА СКЛАД
Dialogue: 0,0:02:21.05,0:02:24.25,Caption,,0,0,0,,И ДУМАЕТ МУЖИКИ, МНЕ НЕ БУДУЩЕЕ СЕЙЧАС НАДО. МНЕ ВОТ ЭТИ
Dialogue: 0,0:02:24.25,0:02:30.22,Caption,,0,0,0,,ЯЩИКИ КУДА ДЕВАТЬ? ВОТ ТАК БОЛЬШАЯ ГЕОПОЛИТИКА В КАКОЙ ТО МОМЕНТ
Dialogue: 0,0:02:30.22,0:02:33.26,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В СОВЕРШЕННО БЫТОВОЙ ВОПРОС. КОМУ ТЫ
Dialogue: 0,0:02:33.26,0:02:35.58,Caption,,0,0,0,,ПРОДАШЬ АБРИКОСЫ? КУДА ПОВЕЗЁШЬ ВИНО?
Dialogue: 0,0:02:35.83,0:02:39.90,Caption,,0,0,0,,КТО КУПИТ ПРОДУКЦИЮ ЗАВОДА? И СКОЛЬКО ВСЁ ЭТО БУДЕТ СТОИТЬ ПОСЛЕ ТОГО,
Dialogue: 0,0:02:40.12,0:02:42.62,Caption,,0,0,0,,КАК ПОЛИТИЧЕСКИЙ КУРС ОКОНЧАТЕЛЬНО РАЗВЕРНЁТСЯ?
Dialogue: 0,0:02:43.35,0:02:46.38,Caption,,0,0,0,,ЕВРОСОЮЗ СПОСОБЕН ОТКРЫТЬ НОВЫЕ ВОЗМОЖНОСТИ. НО
Dialogue: 0,0:02:46.46,0:02:48.86,Caption,,0,0,0,,НОВЫЙ РЫНОК НАДО ЕЩЁ ЗАНЯТЬ. ТАМ ТЕБЯ НИКТО
Dialogue: 0,0:02:48.94,0:02:51.10,Caption,,0,0,0,,С ОРКЕСТРОМ НЕ ЖДЁТ. ТАМ УЖЕ СИДЯТ СВОИ
Dialogue: 0,0:02:51.10,0:02:53.26,Caption,,0,0,0,,ПРОИЗВОДИТЕЛИ, СВОИ ПОСТАВЩИКИ,
Dialogue: 0,0:02:53.34,0:02:57.34,Caption,,0,0,0,,СВОИ СЕТИ, СВОИ ПРАВИЛА. ПОЭТОМУ АРМЯНСКИЙ ЕВРОПЕЙСКИЙ ВЫБОР
Dialogue: 0,0:02:57.34,0:03:01.50,Caption,,0,0,0,,ИНТЕРЕСЕН НЕ ТЕМ, ЧТО ПАШИНЯН НАЗВАЛ ДВЕ ДАТЫ. ГОРАЗДО ИНТЕРЕСНЕЕ
Dialogue: 0,0:03:01.50,0:03:04.70,Caption,,0,0,0,,ДРУГОЕ. ЦЕНА ДВИЖЕНИЯ НАЧИНАЕТ ПОЯВЛЯТЬСЯ РАНЬШЕ
Dialogue: 0,0:03:04.70,0:03:08.46,Caption,,0,0,0,,САМОЙ ЗАЯВКИ. КСТАТИ, ЕСЛИ ВАМ ИНТЕРЕСЕН ИМЕННО ТАКОЙ ВЗГЛЯД,
Dialogue: 0,0:03:08.70,0:03:10.62,Caption,,0,0,0,,БЕЗ ПЛАКАТОВ И ПАРТИЙНЫХ ЛОЗУНГОВ,
Dialogue: 0,0:03:10.70,0:03:13.34,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО РЕАЛЬНАЯ ПОЛИТИКА ЧАЩЕ
Dialogue: 0,0:03:13.42,0:03:15.90,Caption,,0,0,0,,ВСЕГО ПРЯЧЕТСЯ ИМЕННО В ТАКИХ СКУЧНЫХ ДЕТАЛЯХ,
Dialogue: 0,0:03:16.22,0:03:19.66,Caption,,0,0,0,,НА КОТОРЫХ ПОТОМ ЛОМАЮТСЯ ОЧЕНЬ КРАСИВЫЕ ОБЕЩАНИЯ. И
Dialogue: 0,0:03:19.66,0:03:24.14,Caption,,0,0,0,,ТУТ НА СЦЕНУ ВЫХОДИТ ОДКБ. АРМЕНИЯ УЖЕ ДАВНО ЗАМОРОЗИЛА СВОЁ УЧАСТИЕ В
Dialogue: 0,0:03:24.14,0:03:27.10,Caption,,0,0,0,,ОРГАНИЗАЦИИ. ФАКТИЧЕСКИ ЕРЕВАН СКАЗАЛ РЕБЯТА,
Dialogue: 0,0:03:27.29,0:03:29.18,Caption,,0,0,0,,МЫ С ВАМИ ЗА ОДНИМ СТОЛОМ ВРОДЕ СИДИМ,
Dialogue: 0,0:03:29.33,0:03:32.54,Caption,,0,0,0,,НО ЕСТЬ НЕ БУДЕМ. ХОРОШО. ТОЛЬКО РЕСТОРАН ВНЕЗАПНО
Dialogue: 0,0:03:32.54,0:03:35.82,Caption,,0,0,0,,ПРИСЛАЛ СЧЁТ. АРМЕНИЯ ПЕРЕСТАЛА ПЛАТИТЬ ВЗНОСЫ. В
Dialogue: 0,0:03:35.90,0:03:37.90,Caption,,0,0,0,,ОДКБ ТЕПЕРЬ ОБСУЖДАЮТ ВОПРОС О ТОМ,
Dialogue: 0,0:03:38.06,0:03:44.99,Caption,,0,0,0,,ЧТОБЫ ЛИШИТЬ ЕЁ ПРАВА ГОЛОСА. И СИТУАЦИЯ ПОЛУЧАЕТСЯ ДОВОЛЬНО КОМИЧНАЯ. ТЫ В КЛУБ
Dialogue: 0,0:03:44.99,0:03:48.27,Caption,,0,0,0,,ПОЧТИ НЕ ХОДИШЬ. СОБРАНИЯ ПРОПУСКАЕШЬ. С ПРАВИЛАМИ
Dialogue: 0,0:03:48.35,0:03:51.23,Caption,,0,0,0,,НЕ СОГЛАСЕН. ВЗНОСЫ НЕ ПЛАТИШЬ. НО ФОРМАЛЬНО
Dialogue: 0,0:03:51.23,0:03:53.95,Caption,,0,0,0,,КАРТОЧКУ УЧАСТНИКА ПОКА НЕ СДАЛ. А ТЕПЕРЬ КЛУБ
Dialogue: 0,0:03:54.03,0:03:55.71,Caption,,0,0,0,,ГОВОРИТ ЕСЛИ ПЛАТИТЬ НЕ ХОЧЕШЬ,
Dialogue: 0,0:03:55.88,0:03:58.59,Caption,,0,0,0,,ТОГДА И ГОЛОСОВАТЬ ЗДЕСЬ ТОЖЕ НЕ БУДЕШЬ. ЛОГИКА,
Dialogue: 0,0:03:58.75,0:04:02.11,Caption,,0,0,0,,В ОБЩЕМ, ЧЕЛОВЕЧЕСКАЯ. ПОПРОБУЙТЕ ПРИЙТИ В СПОРТЗАЛ ЧЕРЕЗ ДВА
Dialogue: 0,0:04:02.11,0:04:04.75,Caption,,0,0,0,,ГОДА ПОСЛЕ ПОСЛЕДНЕГО ПЛАТЕЖА И СКАЗАТЬ ТРЕНАЖЁРАМИ
Dialogue: 0,0:04:04.75,0:04:08.11,Caption,,0,0,0,,Я ПОЛЬЗОВАТЬСЯ НЕ БУДУ, РАЗДЕВАЛКА МНЕ ТОЖЕ НЕ НУЖНА,
Dialogue: 0,0:04:08.35,0:04:10.99,Caption,,0,0,0,,НО НА СОБРАНИИ ВЛАДЕЛЬЦЕВ ХОЧУ ГОЛОСОВАТЬ. ВАС
Dialogue: 0,0:04:10.99,0:04:14.27,Caption,,0,0,0,,ПОЙМУТ. НО ОЧЕНЬ СВОЕОБРАЗНО. САМОЕ ВАЖНОЕ ЗДЕСЬ
Dialogue: 0,0:04:14.35,0:04:17.39,Caption,,0,0,0,,ДАЖЕ НЕ САМО ГОЛОСОВАНИЕ. АРМЕНИЯ ШАГ ЗА ШАГОМ
Dialogue: 0,0:04:17.39,0:04:19.63,Caption,,0,0,0,,РАЗБИРАЕТ СТАРУЮ КОНСТРУКЦИЮ ОТНОШЕНИЙ,
Dialogue: 0,0:04:19.87,0:04:22.91,Caption,,0,0,0,,ПРИ ЭТОМ НОВАЯ КОНСТРУКЦИЯ ЕЩЁ НЕ ПОСТРОЕНА. ВОТ
Dialogue: 0,0:04:22.99,0:04:25.87,Caption,,0,0,0,,ГДЕ НАЧИНАЕТСЯ НАСТОЯЩИЙ РИСК. СТАРЫЙ МОСТ УЖЕ
Dialogue: 0,0:04:25.87,0:04:29.23,Caption,,0,0,0,,ЗАКРЫВАЮТ НА РЕМОНТ, НОВЫЙ ЕЩЁ ТОЛЬКО РИСУЮТ НА БУМАГЕ,
Dialogue: 0,0:04:29.55,0:04:31.87,Caption,,0,0,0,,А ЕХАТЬ ТО НАДО СЕГОДНЯ. И ПРИМЕРНО В
Dialogue: 0,0:04:31.95,0:04:34.67,Caption,,0,0,0,,ЭТОТ МОМЕНТ НАША ИСТОРИЯ НЕОЖИДАННО ПЕРЕЕЗЖАЕТ ИЗ
Dialogue: 0,0:04:34.67,0:04:37.63,Caption,,0,0,0,,АРМЕНИИ В ДРУГУЮ ЧАСТЬ ЕВРОПЫ. ПОТОМУ ЧТО ПОКА
Dialogue: 0,0:04:37.63,0:04:39.95,Caption,,0,0,0,,ЕРЕВАН ТОЛЬКО СОБИРАЕТСЯ ПОДАВАТЬ ЗАЯВКУ,
Dialogue: 0,0:04:40.26,0:04:43.87,Caption,,0,0,0,,ДВЕ СТРАНЫ, КОТОРЫЕ УЖЕ ДАВНО СТОЯТ В ЕВРОПЕЙСКОЙ ОЧЕРЕДИ,
Dialogue: 0,0:04:44.11,0:04:46.67,Caption,,0,0,0,,ВНЕЗАПНО НАЧАЛИ ДВИГАТЬСЯ С СОВЕРШЕННО РАЗНОЙ
Dialogue: 0,0:04:46.67,0:04:50.03,Caption,,0,0,0,,СКОРОСТЬЮ. МОЛДОВА И УКРАИНА. ТУТ ВООБЩЕ ПРЕКРАСНАЯ
Dialogue: 0,0:04:50.03,0:04:55.35,Caption,,0,0,0,,АРИФМЕТИКА. В ЕВРОПЕЙСКОЙ ДОРОЖНОЙ КАРТЕ НА СЛЕДУЮЩИЙ ГОД ДЛЯ
Dialogue: 0,0:04:55.35,0:04:57.83,Caption,,0,0,0,,МОЛДОВЫ СТОИТ ПЛАН ПО ПРЕДВАРИТЕЛЬНОМУ ЗАКРЫТИЮ
Dialogue: 0,0:04:57.83,0:05:01.11,Caption,,0,0,0,,ДВАДЦАТИ ПЯТИ ПЕРЕГОВОРНЫХ ГЛАВ. ДЛЯ УКРАИНЫ СЕМЬ.
Dialogue: 0,0:05:01.35,0:05:05.03,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТЬ И СЕМЬ. НЕ ПРОЦЕНТЫ. НЕ РЕЙТИНГ
Dialogue: 0,0:05:05.11,0:05:08.71,Caption,,0,0,0,,ЛЮБВИ БРЮССЕЛЯ. НЕ ТАБЛИЦА ЛУЧШИХ УЧЕНИКОВ. РЕЧЬ О
Dialogue: 0,0:05:08.71,0:05:12.63,Caption,,0,0,0,,ПЕРЕГОВОРНЫХ ГЛАВАХ, ПО КОТОРЫМ СТРАНЫ ДОЛЖНЫ ПРИВОДИТЬ ЗАКОНОДАТЕЛЬСТВО,
Dialogue: 0,0:05:12.87,0:05:15.59,Caption,,0,0,0,,ИНСТИТУТЫ И ПРАВИЛА В СООТВЕТСТВИЕ С ТРЕБОВАНИЯМИ
Dialogue: 0,0:05:15.59,0:05:18.39,Caption,,0,0,0,,ЕВРОСОЮЗА. НО РАЗНИЦА ВСЁ РАВНО ВЫГЛЯДИТ ОЧЕНЬ
Dialogue: 0,0:05:18.39,0:05:20.55,Caption,,0,0,0,,ХОРОШО. ОСОБЕННО ЕСЛИ ВСПОМНИТЬ,
Dialogue: 0,0:05:20.79,0:05:23.35,Caption,,0,0,0,,КАК ДОЛГО УКРАИНА И МОЛДОВА ПОЛИТИЧЕСКИ ШЛИ
Dialogue: 0,0:05:23.35,0:05:26.15,Caption,,0,0,0,,ПРАКТИЧЕСКИ ОДНИМ ПАКЕТОМ. ВСЕМ РАССКАЗЫВАЛИ,
Dialogue: 0,0:05:26.31,0:05:29.83,Caption,,0,0,0,,ЧТО ЭТО ОБЩИЙ ЕВРОПЕЙСКИЙ ПУТЬ. ОБЩИЙ ВЕКТОР. ОБЩЕЕ
Dialogue: 0,0:05:29.83,0:05:33.19,Caption,,0,0,0,,БУДУЩЕЕ. А ПОТОМ ОТКРЫЛИ РАБОЧУЮ ТЕТРАДКУ И ОКАЗАЛОСЬ,
Dialogue: 0,0:05:33.43,0:05:35.75,Caption,,0,0,0,,ЧТО ОДНОМУ УЧЕНИКУ НА СЛЕДУЮЩИЙ ГОД ПОСТАВИЛИ
Dialogue: 0,0:05:35.75,0:05:38.31,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТЬ ЗАДАНИЙ С ПЕРСПЕКТИВОЙ ЗАКРЫТИЯ,
Dialogue: 0,0:05:38.47,0:05:41.59,Caption,,0,0,0,,А ВТОРОМУ СЕМЬ. УЧИТЕЛЬ ВРОДЕ ОДИН. КЛАСС ОДИН.
Dialogue: 0,0:05:41.91,0:05:44.63,Caption,,0,0,0,,А ДНЕВНИКИ ОЧЕНЬ РАЗНЫЕ. И ВОТ ЗДЕСЬ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:05:44.63,0:05:47.43,Caption,,0,0,0,,УДОБНАЯ ФОРМУЛА УКРАИНА ОТСТАЁТ ИЗ ЗА КОРРУПЦИИ.
Dialogue: 0,0:05:47.58,0:05:49.83,Caption,,0,0,0,,ОЧЕНЬ КРАСИВАЯ ФОРМУЛА. ОДНО СЛОВО,
Dialogue: 0,0:05:50.07,0:05:53.11,Caption,,0,0,0,,И ВРОДЕ ВСЁ ОБЪЯСНИЛИ. КОРРУПЦИЯ. МОЖНО ВЫКЛЮЧАТЬ
Dialogue: 0,0:05:53.11,0:05:56.15,Caption,,0,0,0,,СВЕТ. ТОЛЬКО РЕАЛЬНАЯ ЕВРОПЕЙСКАЯ ПРОЦЕДУРА УСТРОЕНА
Dialogue: 0,0:05:56.15,0:05:59.03,Caption,,0,0,0,,СЛОЖНЕЕ. ТАМ СМОТРЯТ НА СУДЕБНУЮ СИСТЕМУ,
Dialogue: 0,0:05:59.22,0:06:02.15,Caption,,0,0,0,,ГОСУДАРСТВЕННОЕ УПРАВЛЕНИЕ, РАБОТУ ИНСТИТУТОВ,
Dialogue: 0,0:06:02.38,0:06:05.19,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ ОРГАНЫ, ЗАКОНОДАТЕЛЬСТВО,
Dialogue: 0,0:06:05.43,0:06:07.51,Caption,,0,0,0,,ВЫПОЛНЕНИЕ УЖЕ ВЗЯТЫХ ОБЯЗАТЕЛЬСТВ.
Dialogue: 0,0:06:09.77,0:06:12.02,Caption,,0,0,0,,ТО ЕСТЬ БРЮССЕЛЮ МАЛО ЗАЯВЛЕНИЯ МЫ ОЧЕНЬ ХОТИМ
Dialogue: 0,0:06:12.02,0:06:14.82,Caption,,0,0,0,,К ВАМ. ТАМ СПРАШИВАЮТ ХОРОШО. А ЧТО КОНКРЕТНО
Dialogue: 0,0:06:14.90,0:06:17.46,Caption,,0,0,0,,ВЫ ПОМЕНЯЛИ? ГДЕ ЗАКОН? ГДЕ РАБОТАЮЩИЙ СУД?
Dialogue: 0,0:06:17.54,0:06:20.18,Caption,,0,0,0,,ГДЕ ПРОЦЕДУРА? ГДЕ РЕШЕНИЕ? ГДЕ ИСПОЛНЕНИЕ?
Dialogue: 0,0:06:20.58,0:06:22.74,Caption,,0,0,0,,ВОТ ТУТ РОМАНТИКА ЗАКАНЧИВАЕТСЯ И НАЧИНАЕТСЯ
Dialogue: 0,0:06:22.74,0:06:25.38,Caption,,0,0,0,,БУХГАЛТЕРИЯ. А БУХГАЛТЕРИЯ В БОЛЬШОЙ ПОЛИТИКЕ ВООБЩЕ
Dialogue: 0,0:06:25.46,0:06:28.26,Caption,,0,0,0,,ВЕЩЬ БЕЗЖАЛОСТНАЯ. НА МИТИНГЕ МОЖНО ДВАДЦАТЬ РАЗ
Dialogue: 0,0:06:28.26,0:06:31.94,Caption,,0,0,0,,СКАЗАТЬ, ЧТО СТРАНА ЯВЛЯЕТСЯ ЧАСТЬЮ ЕВРОПЫ. БУХГАЛТЕР ПОТОМ
Dialogue: 0,0:06:31.94,0:06:34.58,Caption,,0,0,0,,МОЛЧА ОТКРЫВАЕТ ПАПКУ И ГОВОРИТ ПРЕКРАСНО. ВОТ
Dialogue: 0,0:06:34.66,0:06:36.82,Caption,,0,0,0,,СПИСОК. НА СЛЕДУЮЩИЙ ГОД У ВАС В ПЛАНЕ
Dialogue: 0,0:06:36.82,0:06:39.38,Caption,,0,0,0,,СЕМЬ ГЛАВ. А ОСТАЛЬНЫЕ ВОПРОСЫ КУДА ДЕВАТЬ?
Dialogue: 0,0:06:39.74,0:06:44.02,Caption,,0,0,0,,И СПОРИТЬ С ПАПКОЙ СЛОЖНЕЕ, ЧЕМ С ЖУРНАЛИСТОМ. НО У УКРАИНСКОЙ ИСТОРИИ ЕСТЬ
Dialogue: 0,0:06:44.02,0:06:46.58,Caption,,0,0,0,,ЕЩЁ ОДИН СЛОЙ. СТРАНА ЖИВЁТ В УСЛОВИЯХ
Dialogue: 0,0:06:46.58,0:06:49.70,Caption,,0,0,0,,ПРОДОЛЖАЮЩЕГОСЯ ТЯЖЕЛЕЙШЕГО КОНФЛИКТА. ОГРОМНАЯ
Dialogue: 0,0:06:49.78,0:06:51.94,Caption,,0,0,0,,ЧАСТЬ ГОСУДАРСТВЕННЫХ РЕСУРСОВ РАБОТАЕТ НА
Dialogue: 0,0:06:51.94,0:06:54.50,Caption,,0,0,0,,БЕЗОПАСНОСТЬ, АРМИЮ, ЭНЕРГЕТИКУ,
Dialogue: 0,0:06:54.67,0:06:58.82,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ, БЮДЖЕТ. ОДНОВРЕМЕННО ЕВРОСОЮЗ ТРЕБУЕТ МЕНЯТЬ
Dialogue: 0,0:06:58.82,0:07:01.46,Caption,,0,0,0,,ИНСТИТУТЫ ПО СВОИМ СТАНДАРТАМ. ТО ЕСТЬ УКРАИНА
Dialogue: 0,0:07:01.46,0:07:04.34,Caption,,0,0,0,,ДОЛЖНА ОДНОВРЕМЕННО ТАЩИТЬ НА СЕБЕ ВОЕННУЮ МАШИНУ,
Dialogue: 0,0:07:04.58,0:07:09.14,Caption,,0,0,0,,БЮДЖЕТНЫЙ ДЕФИЦИТ, РАЗРУШЕННУЮ ИНФРАСТРУКТУРУ И ЕЩЁ СДАВАТЬ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:07:09.14,0:07:11.86,Caption,,0,0,0,,ЭКЗАМЕНЫ. А ЭКЗАМЕНАТОР ПРИ ЭТОМ ГОВОРИТ ВОЙНА
Dialogue: 0,0:07:11.86,0:07:14.98,Caption,,0,0,0,,ВОЙНОЙ, А ВОТ ЭТУ ГЛАВУ ВСЁ РАВНО ПЕРЕДЕЛЫВАЙТЕ. ДЛЯ
Dialogue: 0,0:07:14.98,0:07:21.49,Caption,,0,0,0,,БРЮССЕЛЯ ЭТО ТОЖЕ ЛОГИЧНО. ЕСЛИ ПРИНЯТЬ СТРАНУ С НЕРАБОТАЮЩИМИ МЕХАНИЗМАМИ,
Dialogue: 0,0:07:21.81,0:07:24.45,Caption,,0,0,0,,ПОТОМ ВСЮ ЭТУ КОНСТРУКЦИЮ ПРИДЁТСЯ ЧИНИТЬ УЖЕ ВНУТРИ
Dialogue: 0,0:07:24.45,0:07:27.33,Caption,,0,0,0,,ЕВРОСОЮЗА. А ЧИНИТЬ ВНУТРИ ОБЫЧНО ДОРОЖЕ,
Dialogue: 0,0:07:27.41,0:07:29.09,Caption,,0,0,0,,ЧЕМ ЗАСТАВИТЬ ПЕРЕДЕЛАТЬ ДО ВХОДА.
Dialogue: 0,0:07:29.66,0:07:32.45,Caption,,0,0,0,,И ТУТ РЯДОМ СТОИТ МОЛДОВА. СТРАНА МАЛЕНЬКАЯ.
Dialogue: 0,0:07:32.77,0:07:36.21,Caption,,0,0,0,,РЕСУРСОВ МЕНЬШЕ. ЕСТЬ ПРИДНЕСТРОВЬЕ. ЕСТЬ НЕРЕШЁННЫЙ
Dialogue: 0,0:07:36.21,0:07:38.93,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЙ ВОПРОС. ЕСТЬ СОБСТВЕННЫЕ ПРОБЛЕМЫ С
Dialogue: 0,0:07:38.93,0:07:41.81,Caption,,0,0,0,,ИНСТИТУТАМИ. НО ГРАФИК ЕВРОПЕЙСКОГО ДВИЖЕНИЯ У НЕЁ
Dialogue: 0,0:07:41.81,0:07:44.69,Caption,,0,0,0,,СЕЙЧАС ВЫГЛЯДИТ БОДРЕЕ УКРАИНСКОГО. И ЭТО ОЧЕНЬ
Dialogue: 0,0:07:44.77,0:07:47.25,Caption,,0,0,0,,ВАЖНЫЙ МОМЕНТ. ПОТОМУ ЧТО НАЛИЧИЕ НЕРЕШЁННОГО
Dialogue: 0,0:07:47.25,0:07:50.05,Caption,,0,0,0,,КОНФЛИКТА САМО ПО СЕБЕ НЕ ОСТАНОВИЛО ПЕРЕГОВОРНУЮ
Dialogue: 0,0:07:50.05,0:07:52.85,Caption,,0,0,0,,МАШИНУ. ТО ЕСТЬ ФОРМУЛА СНАЧАЛА РЕШИТЕ ВООБЩЕ ВСЕ
Dialogue: 0,0:07:52.85,0:07:57.81,Caption,,0,0,0,,ПРОБЛЕМЫ, ПОТОМ ПРИХОДИТЕ, НЕ РАБОТАЕТ. ЕВРОСОЮЗ СПОСОБЕН ДВИГАТЬ ПЕРЕГОВОРЫ
Dialogue: 0,0:07:57.81,0:08:00.61,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО С ПРОБЛЕМАМИ. НО КОГДА РЕЧЬ ДОЙДЁТ ДО
Dialogue: 0,0:08:00.61,0:08:05.09,Caption,,0,0,0,,ОКОНЧАТЕЛЬНЫХ РЕШЕНИЙ, ВОТ ТОГДА КАЖДАЯ ТАКАЯ ПРОБЛЕМА СНОВА ОКАЖЕТСЯ НА
Dialogue: 0,0:08:05.17,0:08:07.09,Caption,,0,0,0,,СТОЛЕ. И ТУТ МЫ ПОДХОДИМ К ВЕЩИ,
Dialogue: 0,0:08:07.41,0:08:09.65,Caption,,0,0,0,,КОТОРУЮ ОСОБЕННО ЛЮБЯТ ЗАБЫВАТЬ В КРАСИВЫХ
Dialogue: 0,0:08:09.65,0:08:12.53,Caption,,0,0,0,,РАЗГОВОРАХ О ЕВРОПЕЙСКОЙ СЕМЬЕ. ЕВРОКОМИССИЯ НЕ
Dialogue: 0,0:08:12.61,0:08:15.17,Caption,,0,0,0,,СИДИТ В БРЮССЕЛЕ С ВОЛШЕБНОЙ ПЕЧАТЬЮ ПРИНЯТЬ,
Dialogue: 0,0:08:15.25,0:08:18.93,Caption,,0,0,0,,ОТКАЗАТЬ, СЛЕДУЮЩИЙ. ЕВРОКОМИССИЯ ГОТОВИТ ОЦЕНКИ,
Dialogue: 0,0:08:19.09,0:08:24.21,Caption,,0,0,0,,ПЛАНЫ, РЕКОМЕНДАЦИИ, ДОРОЖНЫЕ КАРТЫ. А ДАЛЬШЕ НАЧИНАЮТСЯ ГОСУДАРСТВА. И
Dialogue: 0,0:08:24.21,0:08:26.93,Caption,,0,0,0,,ВОТ ТАМ УЖЕ ВЕСЕЛО. ПОТОМУ ЧТО ЕВРОСОЮЗ ЭТО
Dialogue: 0,0:08:26.93,0:08:29.81,Caption,,0,0,0,,НЕ ОДИН ЧЕЛОВЕК. ЭТО НЕ ОДИН ПРЕЗИДЕНТ. НЕ
Dialogue: 0,0:08:29.81,0:08:34.96,Caption,,0,0,0,,ОДИН ПРЕМЬЕР. НЕ ОДНА ПАРТИЯ. ЭТО КУЧА СТРАН,
Dialogue: 0,0:08:35.12,0:08:37.52,Caption,,0,0,0,,У КАЖДОЙ СВОИ ВЫБОРЫ, СВОИ ФЕРМЕРЫ,
Dialogue: 0,0:08:37.60,0:08:39.84,Caption,,0,0,0,,СВОИ ПРЕДПРИЯТИЯ, СВОИ СТРАХИ,
Dialogue: 0,0:08:40.08,0:08:43.68,Caption,,0,0,0,,СВОИ РЫНКИ, СВОИ ОТНОШЕНИЯ С СОСЕДЯМИ И СВОИ ПОЛИТИКИ,
Dialogue: 0,0:08:43.92,0:08:45.84,Caption,,0,0,0,,КОТОРЫМ ПОТОМ ОБЪЯСНЯТЬ ИЗБИРАТЕЛЮ,
Dialogue: 0,0:08:46.04,0:08:48.88,Caption,,0,0,0,,ПОЧЕМУ ИМЕННО ЭТО РЕШЕНИЕ ВЫГОДНО ЕГО СТРАНЕ.
Dialogue: 0,0:08:49.60,0:08:52.16,Caption,,0,0,0,,В ОДНОЙ СТОЛИЦЕ СКАЖУТ РАСШИРЕНИЕ НЕОБХОДИМО РАДИ
Dialogue: 0,0:08:52.16,0:08:54.88,Caption,,0,0,0,,БЕЗОПАСНОСТИ. В ДРУГОЙ СПРОСЯТ А СКОЛЬКО ЭТО БУДЕТ
Dialogue: 0,0:08:54.88,0:08:58.40,Caption,,0,0,0,,СТОИТЬ? В ТРЕТЬЕЙ ВСПОМНЯТ СЕЛЬСКОЕ ХОЗЯЙСТВО. В ЧЕТВЁРТОЙ
Dialogue: 0,0:08:58.40,0:09:01.68,Caption,,0,0,0,,МИГРАЦИЮ. В ПЯТОЙ СОБСТВЕННЫЙ СПОР С КАНДИДАТОМ. И
Dialogue: 0,0:09:01.68,0:09:05.12,Caption,,0,0,0,,ВСЁ. БОЛЬШАЯ КРАСИВАЯ ДОРОГА В ЕВРОПУ УПИРАЕТСЯ В
Dialogue: 0,0:09:05.12,0:09:08.08,Caption,,0,0,0,,МАЛЕНЬКОГО НАЦИОНАЛЬНОГО ЧИНОВНИКА С ПАПКОЙ. А ТОТ
Dialogue: 0,0:09:08.08,0:09:12.80,Caption,,0,0,0,,ГОВОРИТ ПРОСТИТЕ, У НАС ВОПРОСЫ. ИМЕННО ПОЭТОМУ ЕВРОПЕЙСКАЯ ИНТЕГРАЦИЯ
Dialogue: 0,0:09:12.88,0:09:16.24,Caption,,0,0,0,,ЭТО НЕ ПОЕЗД, КОТОРЫЙ ОДНАЖДЫ ОТПРАВИЛСЯ И ТЕПЕРЬ ОБЯЗАН ПРИЕХАТЬ
Dialogue: 0,0:09:16.32,0:09:20.00,Caption,,0,0,0,,НА КОНЕЧНУЮ. ЭТО МАРШРУТ С КУЧЕЙ ШЛАГБАУМОВ. ПРИЧЁМ
Dialogue: 0,0:09:20.08,0:09:22.16,Caption,,0,0,0,,НЕКОТОРЫЕ ШЛАГБАУМЫ СТАВЯТ ВООБЩЕ ЛЮДИ,
Dialogue: 0,0:09:22.40,0:09:25.28,Caption,,0,0,0,,КОТОРЫХ В НАЧАЛЕ ПУТИ НИКТО НЕ ЗАМЕЧАЛ. АРМЕНИЯ
Dialogue: 0,0:09:25.28,0:09:28.24,Caption,,0,0,0,,ЗДЕСЬ ОСОБЕННО ИНТЕРЕСНА. ПОТОМУ ЧТО У ЕРЕВАНА ЕСТЬ
Dialogue: 0,0:09:28.24,0:09:32.88,Caption,,0,0,0,,ЕЩЁ ОДНА ПРОБЛЕМА, КОТОРУЮ НИКАКИМ ЗАЯВЛЕНИЕМ НЕ ОТМЕНИШЬ. ГЕОГРАФИЯ.
Dialogue: 0,0:09:33.36,0:09:36.56,Caption,,0,0,0,,АРМЕНИЯ НЕ ЛЕЖИТ ВОЗЛЕ ФРАНЦИИ. МЕЖДУ ЕРЕВАНОМ И
Dialogue: 0,0:09:36.64,0:09:39.12,Caption,,0,0,0,,ЕВРОПЕЙСКИМИ РЫНКАМИ НЕТ ПРЯМОЙ ШИРОКОЙ ДВЕРИ С
Dialogue: 0,0:09:39.12,0:09:41.76,Caption,,0,0,0,,НАДПИСЬЮ ДОБРО ПОЖАЛОВАТЬ. ЕСТЬ СОСЕДНИЕ
Dialogue: 0,0:09:41.76,0:09:45.36,Caption,,0,0,0,,ГОСУДАРСТВА. ЕСТЬ ДОРОГИ. ЕСТЬ ПОРТЫ. ЕСТЬ
Dialogue: 0,0:09:45.36,0:09:51.16,Caption,,0,0,0,,ТРАНСПОРТНЫЕ КОРИДОРЫ. И ОДИН ИЗ ГЛАВНЫХ МАРШРУТОВ В СТОРОНУ ЕВРОПЫ
Dialogue: 0,0:09:51.24,0:09:53.96,Caption,,0,0,0,,ИДЁТ ЧЕРЕЗ ГРУЗИЮ. А ТЕПЕРЬ СТАНОВИТСЯ СОВСЕМ
Dialogue: 0,0:09:53.96,0:09:57.40,Caption,,0,0,0,,КРАСИВО. АРМЕНИЯ ХОЧЕТ ДВИГАТЬСЯ В ЕВРОСОЮЗ. ПРИ
Dialogue: 0,0:09:57.40,0:09:59.96,Caption,,0,0,0,,ЭТОМ САМА АРМЯНСКАЯ СТОРОНА ПРИЗНАЁТ ВАЖНОСТЬ
Dialogue: 0,0:09:59.96,0:10:02.92,Caption,,0,0,0,,ГРУЗИНСКОГО НАПРАВЛЕНИЯ. А У ГРУЗИИ ОТНОШЕНИЯ С
Dialogue: 0,0:10:02.92,0:10:05.00,Caption,,0,0,0,,ЕВРОСОЮЗОМ КАК РАЗ ВОШЛИ В ТОТ ЭТАП,
Dialogue: 0,0:10:05.32,0:10:07.72,Caption,,0,0,0,,КОГДА СТОРОНЫ НАЧИНАЮТ ОБЪЯСНЯТЬ ДРУГ ДРУГУ,
Dialogue: 0,0:10:07.88,0:10:10.52,Caption,,0,0,0,,КТО ИМЕННО ВЕДЁТ СЕБЯ НЕПРАВИЛЬНО. ТО ЕСТЬ ВЫ
Dialogue: 0,0:10:10.52,0:10:12.76,Caption,,0,0,0,,СОБРАЛИСЬ ЕХАТЬ В ГОСТИ, А ЧЕЛОВЕК,
Dialogue: 0,0:10:12.87,0:10:14.44,Caption,,0,0,0,,ЧЕРЕЗ ЧЕЙ ДВОР ПРОХОДИТ ДОРОГА,
Dialogue: 0,0:10:14.60,0:10:17.72,Caption,,0,0,0,,САМ С ХОЗЯИНОМ ДОМА ПОРУГАЛСЯ. ОТЛИЧНЫЙ МАРШРУТ.
Dialogue: 0,0:10:17.88,0:10:21.88,Caption,,0,0,0,,НАДЁЖНЫЙ. ГЛАВНОЕ, ЧТОБЫ КАЛИТКУ НЕ ЗАКРЫЛИ В САМЫЙ НЕПОДХОДЯЩИЙ
Dialogue: 0,0:10:21.88,0:10:25.64,Caption,,0,0,0,,МОМЕНТ. КОНЕЧНО, ТОРГОВЛЯ ЧЕРЕЗ ГРУЗИЮ ОТ ПОЛИТИЧЕСКИХ СПОРОВ
Dialogue: 0,0:10:25.64,0:10:28.84,Caption,,0,0,0,,АВТОМАТИЧЕСКИ НЕ ИСЧЕЗАЕТ. МАШИНЫ НЕ РАЗВОРАЧИВАЮТСЯ
Dialogue: 0,0:10:28.92,0:10:32.52,Caption,,0,0,0,,ТОЛЬКО ПОТОМУ, ЧТО ДВА ЧИНОВНИКА ОБМЕНЯЛИСЬ ЖЁСТКИМИ ЗАЯВЛЕНИЯМИ.
Dialogue: 0,0:10:32.73,0:10:35.40,Caption,,0,0,0,,НО ЧЕМ ГЛУБЖЕ КОНФЛИКТ МЕЖДУ ТБИЛИСИ И БРЮССЕЛЕМ,
Dialogue: 0,0:10:35.72,0:10:38.52,Caption,,0,0,0,,ТЕМ СЛОЖНЕЕ СТРОИТЬ БОЛЬШИЕ ДОЛГОСРОЧНЫЕ ПРОЕКТЫ,
Dialogue: 0,0:10:38.77,0:10:41.24,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ СВЯЗЫВАТЬ КАВКАЗ С ЕВРОПЕЙСКИМИ
Dialogue: 0,0:10:41.24,0:10:44.60,Caption,,0,0,0,,РЫНКАМИ. А ТЕПЕРЬ САМ ТБИЛИСИ. ГРУЗИЯ ПОЛУЧИЛА
Dialogue: 0,0:10:44.68,0:10:47.56,Caption,,0,0,0,,СТАТУС КАНДИДАТА В ЕВРОСОЮЗ. ТО ЕСТЬ ФОРМАЛЬНО
Dialogue: 0,0:10:47.64,0:10:50.60,Caption,,0,0,0,,СТРАНА СТОИТ НАМНОГО ДАЛЬШЕ АРМЕНИИ. АРМЕНИЯ ТОЛЬКО
Dialogue: 0,0:10:50.60,0:10:53.80,Caption,,0,0,0,,ОБСУЖДАЕТ БУДУЩУЮ ЗАЯВКУ. ГРУЗИЯ УЖЕ КАНДИДАТ.
Dialogue: 0,0:10:54.04,0:10:59.08,Caption,,0,0,0,,КАЗАЛОСЬ БЫ, ВОТ ОН, ЧЕЛОВЕК, КОТОРЫЙ ПЕРВЫМ ЗАНЯЛ ОЧЕРЕДЬ. СЕЙЧАС СПОКОЙНО
Dialogue: 0,0:10:59.08,0:11:04.64,Caption,,0,0,0,,ПОДОЙДЁТ К ОКОШКУ. А ОН ВНЕЗАПНО НАЧИНАЕТ РУГАТЬСЯ С КАССИРОМ.
Dialogue: 0,0:11:05.12,0:11:07.68,Caption,,0,0,0,,ГРУЗИНСКОЕ РУКОВОДСТВО ОБВИНЯЕТ ЕВРОКОМИССИЮ ВО
Dialogue: 0,0:11:07.68,0:11:10.64,Caption,,0,0,0,,ВМЕШАТЕЛЬСТВЕ ВО ВНУТРЕННИЕ ДЕЛА. ЕВРОКОМИССИЯ
Dialogue: 0,0:11:10.72,0:11:13.20,Caption,,0,0,0,,ОТВЕЧАЕТ ПРЕТЕНЗИЯМИ К СОСТОЯНИЮ ДЕМОКРАТИИ,
Dialogue: 0,0:11:13.44,0:11:17.92,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ КОНКУРЕНЦИИ, ПРАВ ЧЕЛОВЕКА И ВЕРХОВЕНСТВА ЗАКОНА. И ПРОЦЕСС
Dialogue: 0,0:11:17.92,0:11:21.12,Caption,,0,0,0,,ДВИЖЕНИЯ ВПЕРЁД ФАКТИЧЕСКИ ТОРМОЗИТСЯ. ЗДЕСЬ СПОР
Dialogue: 0,0:11:21.20,0:11:23.28,Caption,,0,0,0,,УЖЕ ИДЁТ НЕ О ТЕХНИЧЕСКОЙ ГЛАВЕ И НЕ
Dialogue: 0,0:11:23.28,0:11:26.16,Caption,,0,0,0,,О РАЗМЕРЕ ВЗНОСА. ЗДЕСЬ ДВЕ СТОРОНЫ СПОРЯТ О
Dialogue: 0,0:11:26.16,0:11:29.04,Caption,,0,0,0,,САМОМ ПРИНЦИПЕ. БРЮССЕЛЬ ГОВОРИТ ЕСЛИ ХОТИТЕ БЫТЬ
Dialogue: 0,0:11:29.04,0:11:33.68,Caption,,0,0,0,,ЧАСТЬЮ НАШЕГО ОБЪЕДИНЕНИЯ, МЕНЯЙТЕ ПРАВИЛА ПО ЭТИМ ТРЕБОВАНИЯМ. ТБИЛИСИ
Dialogue: 0,0:11:33.76,0:11:36.00,Caption,,0,0,0,,ОТВЕЧАЕТ А ВЫ НЕ СЛИШКОМ ГЛУБОКО ПОЛЕЗЛИ В
Dialogue: 0,0:11:36.08,0:11:40.32,Caption,,0,0,0,,НАШУ ВНУТРЕННЮЮ ПОЛИТИКУ? И ОБЕ СТОРОНЫ ПРЕКРАСНО ПОНИМАЮТ ЦЕНУ ВОПРОСА.
Dialogue: 0,0:11:40.60,0:11:43.04,Caption,,0,0,0,,ЕВРОСОЮЗ НЕ ХОЧЕТ ПРИНИМАТЬ ГОСУДАРСТВО,
Dialogue: 0,0:11:43.28,0:11:45.52,Caption,,0,0,0,,КОТОРОЕ НЕ СООТВЕТСТВУЕТ ЕГО ПОЛИТИЧЕСКИМ
Dialogue: 0,0:11:45.52,0:11:48.24,Caption,,0,0,0,,ТРЕБОВАНИЯМ. ГРУЗИНСКАЯ ВЛАСТЬ НЕ ХОЧЕТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:11:48.24,0:11:50.80,Caption,,0,0,0,,АДМИНИСТРАЦИЕЙ, КОТОРОЙ ИЗ БРЮССЕЛЯ ДИКТУЮТ,
Dialogue: 0,0:11:51.04,0:11:53.76,Caption,,0,0,0,,КАКИЕ ВНУТРЕННИЕ РЕШЕНИЯ ПРИНИМАТЬ. ВОТ И ВСЯ
Dialogue: 0,0:11:53.76,0:11:56.08,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ РОМАНТИКА. ПОКА ГОВОРИШЬ ПРО
Dialogue: 0,0:11:56.08,0:12:00.16,Caption,,0,0,0,,ЦИВИЛИЗАЦИОННЫЙ ВЫБОР, ВСЁ ЗВУЧИТ КРАСИВО. КОГДА НАЧИНАЕТСЯ РЕАЛЬНОЕ
Dialogue: 0,0:12:00.16,0:12:04.64,Caption,,0,0,0,,ВСТУПЛЕНИЕ, ПОЯВЛЯЕТСЯ ОГРОМНАЯ ИНСТРУКЦИЯ МЕЛКИМ ШРИФТОМ. А ТАМ
Dialogue: 0,0:12:04.71,0:12:07.84,Caption,,0,0,0,,НАЛОГИ, СУДЫ, ТОРГОВЛЯ, ПРАВИЛА,
Dialogue: 0,0:12:07.93,0:12:11.12,Caption,,0,0,0,,БЮДЖЕТЫ, ВНЕШНЯЯ ПОЛИТИКА, СТАНДАРТЫ,
Dialogue: 0,0:12:11.20,0:12:16.40,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА, ГОЛОСОВАНИЯ, ИНТЕРЕСЫ СОСЕДЕЙ. И САМОЕ ИНТЕРЕСНОЕ ВО ВСЕЙ ЭТОЙ
Dialogue: 0,0:12:16.40,0:12:22.12,Caption,,0,0,0,,ИСТОРИИ ИМЕННО ЭТО. СТРАНА НАЧИНАЕТ МЕНЯТЬСЯ НЕ ТОГДА,
Dialogue: 0,0:12:22.20,0:12:25.48,Caption,,0,0,0,,КОГДА ЕЁ ПРИНИМАЮТ В ЕВРОСОЮЗ. ОНА НАЧИНАЕТ МЕНЯТЬСЯ
Dialogue: 0,0:12:25.48,0:12:28.44,Caption,,0,0,0,,НАМНОГО РАНЬШЕ. АРМЕНИЯ ЕЩЁ ТОЛЬКО СОБИРАЕТСЯ
Dialogue: 0,0:12:28.44,0:12:31.72,Caption,,0,0,0,,ПОДАВАТЬ ЗАЯВКУ, А УЖЕ ПЕРЕСМАТРИВАЕТ ОТНОШЕНИЯ С ОДКБ,
Dialogue: 0,0:12:32.22,0:12:34.68,Caption,,0,0,0,,СТАЛКИВАЕТСЯ С ВОПРОСАМИ ТОРГОВЛИ И ДУМАЕТ,
Dialogue: 0,0:12:34.93,0:12:39.08,Caption,,0,0,0,,ЧЕМ ЗАМЕНИТЬ СТАРЫЕ СВЯЗИ. МОЛДОВА ЕЩЁ НЕ ЧЛЕН ЕВРОСОЮЗА,
Dialogue: 0,0:12:39.32,0:12:41.72,Caption,,0,0,0,,НО УЖЕ ПЕРЕСТРАИВАЕТ ЗАКОНЫ ПОД ЕВРОПЕЙСКИЕ
Dialogue: 0,0:12:41.72,0:12:44.76,Caption,,0,0,0,,ТРЕБОВАНИЯ. УКРАИНА ЕЩЁ НЕ ЧЛЕН ЕВРОСОЮЗА,
Dialogue: 0,0:12:45.00,0:12:47.96,Caption,,0,0,0,,НО КАЖДЫЙ ЕВРОПЕЙСКИЙ ОТЧЁТ ПРЕВРАЩАЕТСЯ ДЛЯ КИЕВА В
Dialogue: 0,0:12:48.04,0:12:51.88,Caption,,0,0,0,,СПИСОК ТОГО, ЧТО НАДО ПЕРЕДЕЛАТЬ. ГРУЗИЯ УЖЕ КАНДИДАТ,
Dialogue: 0,0:12:52.20,0:12:54.76,Caption,,0,0,0,,НО САМ СТАТУС КАНДИДАТА НЕ СПАСАЕТ ОТ ОСТАНОВКИ
Dialogue: 0,0:12:54.76,0:12:56.92,Caption,,0,0,0,,ПРОЦЕССА, ЕСЛИ БРЮССЕЛЬ СЧИТАЕТ,
Dialogue: 0,0:12:57.12,0:13:00.60,Caption,,0,0,0,,ЧТО СТРАНА ДВИЖЕТСЯ НЕ ТУДА. ПОЭТОМУ ДАТА ВСТУПЛЕНИЯ,
Dialogue: 0,0:13:00.76,0:13:02.44,Caption,,0,0,0,,НА КОТОРОЙ ВСЕ ЛЮБЯТ ЗАЦИКЛИВАТЬСЯ,
Dialogue: 0,0:13:02.68,0:13:05.64,Caption,,0,0,0,,ВООБЩЕ НЕ САМОЕ ИНТЕРЕСНОЕ. ГЛАВНОЕ ПРОИСХОДИТ ПО
Dialogue: 0,0:13:05.64,0:13:07.80,Caption,,0,0,0,,ДОРОГЕ. ТЫ ЕЩЁ НИКУДА НЕ ВСТУПИЛ,
Dialogue: 0,0:13:08.04,0:13:11.16,Caption,,0,0,0,,А УЖЕ МЕНЯЕШЬ ЗАКОНЫ. МЕНЯЕШЬ РЫНКИ. МЕНЯЕШЬ
Dialogue: 0,0:13:11.24,0:13:14.12,Caption,,0,0,0,,ПАРТНЁРОВ. МЕНЯЕШЬ ВОЕННЫЕ СВЯЗИ. МЕНЯЕШЬ
Dialogue: 0,0:13:14.20,0:13:17.56,Caption,,0,0,0,,ТРАНСПОРТНЫЕ МАРШРУТЫ. МЕНЯЕШЬ ВНЕШНЮЮ ПОЛИТИКУ. А
Dialogue: 0,0:13:17.64,0:13:21.88,Caption,,0,0,0,,ПОТОМ ОДНАЖДЫ ВЫЯСНЯЕТСЯ, ЧТО ДО КОНЕЧНОЙ СТАНЦИИ ЕЩЁ ЕХАТЬ НЕСКОЛЬКО ЛЕТ.
Dialogue: 0,0:13:22.28,0:13:23.96,Caption,,0,0,0,,ВОТ ТОГДА И СТАНОВИТСЯ ПОНЯТНО,
Dialogue: 0,0:13:24.12,0:13:26.84,Caption,,0,0,0,,НАСКОЛЬКО ХОРОШИЙ МАРШРУТ ТЫ ВЫБРАЛ. ПОТОМУ ЧТО В
Dialogue: 0,0:13:26.84,0:13:29.24,Caption,,0,0,0,,БОЛЬШОЙ ПОЛИТИКЕ БИЛЕТ ДЕЙСТВИТЕЛЬНО МОЖНО КУПИТЬ
Dialogue: 0,0:13:29.24,0:13:31.40,Caption,,0,0,0,,ЗАРАНЕЕ. ТОЛЬКО ВОТ ПЛАТИШЬ ТЫ ЗА НЕГО ВСЮ
Dialogue: 0,0:13:31.40,0:13:31.96,Caption,,0,0,0,,ДОРОГУ.
