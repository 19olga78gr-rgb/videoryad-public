Dialogue: 0,0:00:00.12,0:00:05.08,Caption,,0,0,0,,НУ ЧТО, ПОХОЖЕ, ГЕГЕМОН СДУЛСЯ. ЕЩЁ НЕДАВНО АМЕРИКА ОБЪЯСНЯЛА ВСЕМУ
Dialogue: 0,0:00:05.16,0:00:08.04,Caption,,0,0,0,,МИРУ, КОМУ С КЕМ ДРУЖИТЬ, КОМУ ТОРГОВАТЬ,
Dialogue: 0,0:00:08.36,0:00:10.84,Caption,,0,0,0,,А КОМУ СИДЕТЬ ПОД САНКЦИЯМИ. А ТЕПЕРЬ ТРАМП
Dialogue: 0,0:00:10.84,0:00:14.68,Caption,,0,0,0,,ВДРУГ ОБНАРУЖИЛ, ЧТО НА ПЛАНЕТЕ ЕСТЬ ЕЩЁ ДВОЕ ОЧЕНЬ СЕРЬЁЗНЫХ
Dialogue: 0,0:00:14.76,0:00:19.40,Caption,,0,0,0,,РЕБЯТ. И, ОКАЗЫВАЕТСЯ, С НИМИ ДАЖЕ МОЖНО ПРЕКРАСНО ДРУЖИТЬ. КАКАЯ
Dialogue: 0,0:00:19.40,0:00:22.60,Caption,,0,0,0,,НЕОЖИДАННОСТЬ! ТОЛЬКО ВОТ НЕКОТОРЫЕ АМЕРИКАНСКИЕ СОЮЗНИКИ,
Dialogue: 0,0:00:22.75,0:00:27.32,Caption,,0,0,0,,ПОХОЖЕ, ЕЩЁ НЕ ПОНЯЛИ, ЧТО ПРАВИЛА ИГРЫ УЖЕ МЕНЯЮТСЯ. И ОЧЕНЬ СКОРО
Dialogue: 0,0:00:27.40,0:00:29.72,Caption,,0,0,0,,ИМ ПРИДЁТСЯ ЗАДАТЬ СЕБЕ ОДИН КРАЙНЕ НЕПРИЯТНЫЙ
Dialogue: 0,0:00:29.72,0:00:32.44,Caption,,0,0,0,,ВОПРОС. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:32.64,0:00:35.32,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО СДУЛСЯ ЗДЕСЬ НЕ
Dialogue: 0,0:00:35.32,0:00:40.12,Caption,,0,0,0,,АМЕРИКАНСКИЙ АВИАНОСНЫЙ ФЛОТ, НЕ АМЕРИКАНСКАЯ ЭКОНОМИКА И НЕ АМЕРИКАНСКАЯ АРМИЯ.
Dialogue: 0,0:00:40.44,0:00:42.92,Caption,,0,0,0,,АМЕРИКА НИКУДА НЕ ИСЧЕЗЛА И СЛАБОЙ ТОЧНО НЕ
Dialogue: 0,0:00:42.92,0:00:46.28,Caption,,0,0,0,,СТАЛА. СДУЛОСЬ ДРУГОЕ. ПРАВО ОДНОГО НАЧАЛЬНИКА
Dialogue: 0,0:00:46.36,0:00:49.08,Caption,,0,0,0,,ХОДИТЬ ПО ПЛАНЕТЕ С УКАЗКОЙ И ОБЪЯСНЯТЬ ОСТАЛЬНЫМ,
Dialogue: 0,0:00:49.20,0:00:51.72,Caption,,0,0,0,,КАК ИМ ПРАВИЛЬНО ЖИТЬ. САМОЕ СМЕШНОЕ,
Dialogue: 0,0:00:51.80,0:00:53.64,Caption,,0,0,0,,ЧТО ЭТО УЖЕ ОСОБО НИКТО И НЕ ПРЯЧЕТ.
Dialogue: 0,0:00:54.08,0:00:56.52,Caption,,0,0,0,,ТРАМП ПОСЛЕ ВСТРЕЧИ С ПУТИНЫМ И СИ ЦЗИНЬПИНОМ
Dialogue: 0,0:00:56.60,0:00:58.52,Caption,,0,0,0,,РАССКАЗЫВАЕТ ПРО НЕВЕРОЯТНУЮ ХИМИЮ,
Dialogue: 0,0:00:58.76,0:01:00.84,Caption,,0,0,0,,ЭЛЕКТРИЧЕСКИЙ ТОК И ТАКУЮ ДРУЖБУ,
Dialogue: 0,0:01:01.08,0:01:03.48,Caption,,0,0,0,,КАКОЙ МЕЖДУ ТРЕМЯ СТРАНАМИ ЕЩЁ НИКОГДА НЕ БЫЛО.
Dialogue: 0,0:01:03.88,0:01:08.76,Caption,,0,0,0,,И ОТДЕЛЬНО НАЗЫВАЕТ США, РОССИЮ И КИТАЙ ТРЕМЯ САМЫМИ МОГУЩЕСТВЕННЫМИ
Dialogue: 0,0:01:08.76,0:01:11.00,Caption,,0,0,0,,ДЕРЖАВАМИ МИРА. КРАСИВО ПОЛУЧИЛОСЬ.
Dialogue: 0,0:01:13.29,0:01:15.69,Caption,,0,0,0,,ЕЩЁ НЕСКОЛЬКО ЛЕТ НАЗАД ОДНА ИЗ ЭТИХ ДЕРЖАВ
Dialogue: 0,0:01:15.77,0:01:20.25,Caption,,0,0,0,,ДОЛЖНА БЫЛА БЫТЬ ИЗОЛИРОВАНА, ВТОРАЯ СЧИТАЛАСЬ ГЛАВНЫМ СТРАТЕГИЧЕСКИМ КОНКУРЕНТОМ,
Dialogue: 0,0:01:20.54,0:01:22.73,Caption,,0,0,0,,А АМЕРИКА ДОЛЖНА БЫЛА КОМАНДОВАТЬ ВСЕМ ЭТИМ
Dialogue: 0,0:01:22.81,0:01:25.77,Caption,,0,0,0,,ХОЗЯЙСТВОМ СВЕРХУ. А ТЕПЕРЬ ВСЕ ТРОЕ СИДЯТ ЗА
Dialogue: 0,0:01:25.85,0:01:30.09,Caption,,0,0,0,,ОДНИМ СТОЛОМ И ОБСУЖДАЮТ, КАК ДАЛЬШЕ ЖИТЬ ПЛАНЕТЕ. ВОТ ЭТО И ЕСТЬ
Dialogue: 0,0:01:30.09,0:01:32.89,Caption,,0,0,0,,ТА САМАЯ ЖИРНАЯ ЧЕРТА ПОД СТАРЫМ ПОРЯДКОМ. НЕ
Dialogue: 0,0:01:32.89,0:01:37.05,Caption,,0,0,0,,ПОТОМУ, ЧТО ПУТИН, ТРАМП И СИ ТЕПЕРЬ БРАТЬЯ НАВЕК И ЗАВТРА
Dialogue: 0,0:01:37.05,0:01:40.33,Caption,,0,0,0,,БУДУТ ВМЕСТЕ ЖАРИТЬ ШАШЛЫК. МЕЖДУ НИМИ ХВАТАЕТ ТАКИХ
Dialogue: 0,0:01:40.33,0:01:44.17,Caption,,0,0,0,,ПРОТИВОРЕЧИЙ, ЧТО ОДНОГО СТОЛА МАЛО. НО БЫВШИЙ ЕДИНОЛИЧНЫЙ
Dialogue: 0,0:01:44.25,0:01:47.37,Caption,,0,0,0,,НАЧАЛЬНИК УЖЕ ПРИЗНАЁТ ПРОСТУЮ ВЕЩЬ. МНЕНИЕ ДВУХ
Dialogue: 0,0:01:47.37,0:01:52.33,Caption,,0,0,0,,ДРУГИХ ВЕСИТ СЛИШКОМ МНОГО, ЧТОБЫ ЕГО ПРОСТО ИГНОРИРОВАТЬ. И ЭТУ ПАСТУ ОБРАТНО
Dialogue: 0,0:01:52.41,0:01:55.05,Caption,,0,0,0,,В ТЮБИК УЖЕ НЕ ЗАПИХНЁШЬ. НОВЫЙ ПОРЯДОК ПРИ
Dialogue: 0,0:01:55.05,0:01:57.29,Caption,,0,0,0,,ЭТОМ ЕЩЁ НЕ ПОЯВИЛСЯ. ЗДЕСЬ КАК РАЗ ОЧЕНЬ
Dialogue: 0,0:01:57.29,0:01:59.93,Caption,,0,0,0,,ТОЧНЫЙ ОБРАЗ ПОД СТАРЫМ МИРОМ УЖЕ ПРОВЕЛИ ЖИРНУЮ
Dialogue: 0,0:02:00.01,0:02:04.01,Caption,,0,0,0,,ЧЕРТУ, А НОВЫЙ ПОКА РИСУЮТ ОСТОРОЖНЫМ ПУНКТИРОМ. МИР СЕЙЧАС
Dialogue: 0,0:02:04.01,0:02:08.01,Caption,,0,0,0,,ВООБЩЕ ПОХОЖ НА КАСТРЮЛЮ, КОТОРУЮ ХОРОШЕНЬКО РАЗОГРЕЛИ. СТАРОЕ УЖЕ
Dialogue: 0,0:02:08.01,0:02:10.81,Caption,,0,0,0,,РАСПЛАВИЛОСЬ, А ЧТО ИМЕННО ЗАСТЫНЕТ ПОТОМ,
Dialogue: 0,0:02:10.89,0:02:13.45,Caption,,0,0,0,,ЕЩЁ НИКТО ТОЛКОМ НЕ ЗНАЕТ. И ПОТРЯСЕНИЙ ДО
Dialogue: 0,0:02:13.53,0:02:16.73,Caption,,0,0,0,,ЭТОГО МОМЕНТА БУДЕТ ПРЕДОСТАТОЧНО. НО ВАЖНЕЕ ДРУГОЕ.
Dialogue: 0,0:02:19.01,0:02:21.73,Caption,,0,0,0,,ЕСЛИ ТАКОЙ ФОРМАТ ВСТРЕЧ НЕ ОСТАНЕТСЯ ОДНОРАЗОВЫМ
Dialogue: 0,0:02:21.73,0:02:23.97,Caption,,0,0,0,,ШОУ, А ПОЯВИТСЯ ВТОРОЙ САММИТ,
Dialogue: 0,0:02:24.13,0:02:26.21,Caption,,0,0,0,,ПОТОМ ТРЕТИЙ, ПОТОМ ЧЕТВЁРТЫЙ,
Dialogue: 0,0:02:26.45,0:02:29.01,Caption,,0,0,0,,САМА РЕГУЛЯРНОСТЬ ЗАСТАВИТ ЭТУ ТРОЙКУ НАПОЛНЯТЬ
Dialogue: 0,0:02:29.01,0:02:32.29,Caption,,0,0,0,,РАЗГОВОР КОНКРЕТНЫМИ РЕШЕНИЯМИ. И КОЕ ЧТО КОНКРЕТНОЕ
Dialogue: 0,0:02:32.37,0:02:35.49,Caption,,0,0,0,,УЖЕ ПОЯВИЛОСЬ. БЕРЁМ ХОТЯ БЫ ИДЕЮ РЕФОРМЫ ООН.
Dialogue: 0,0:02:35.81,0:02:40.45,Caption,,0,0,0,,РОССИЯ, КИТАЙ И США, ТРИ ПОСТОЯННЫХ ЧЛЕНА СОВЕТА БЕЗОПАСНОСТИ,
Dialogue: 0,0:02:40.69,0:02:44.21,Caption,,0,0,0,,ЗАЯВЛЯЮТ, ЧТО ОРГАНИЗАЦИЮ НАДО МЕНЯТЬ. ВСЁ ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:02:44.44,0:02:47.01,Caption,,0,0,0,,ТОЛЬКО ПОСТОЯННЫХ ЧЛЕНОВ С ПРАВОМ ВЕТО ВООБЩЕ ТО
Dialogue: 0,0:02:47.01,0:02:49.97,Caption,,0,0,0,,ПЯТЬ. А ГДЕ ФРАНЦИЯ? А ВЕЛИКОБРИТАНИЯ ГДЕ?
Dialogue: 0,0:02:50.34,0:02:53.49,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ИНТЕРЕСНАЯ АРИФМЕТИКА. ТРОЕ ОБСУЖДАЮТ,
Dialogue: 0,0:02:53.59,0:02:55.57,Caption,,0,0,0,,КАК ДОЛЖНА РАБОТАТЬ ОРГАНИЗАЦИЯ,
Dialogue: 0,0:02:55.81,0:02:58.77,Caption,,0,0,0,,В РУКОВОДСТВЕ КОТОРОЙ СИДЯТ ПЯТЕРО. ОСОБЕННО ЗАБАВНО
Dialogue: 0,0:02:58.77,0:03:01.41,Caption,,0,0,0,,ЭТО ВЫГЛЯДИТ НА ФОНЕ ЕВРОПЕЙСКИХ РАЗГОВОРОВ О ТОМ,
Dialogue: 0,0:03:01.65,0:03:06.37,Caption,,0,0,0,,КТО ТАМ ЭКОНОМИЧЕСКИЙ КАРЛИК, А КТО МИРОВОЙ МОНСТР. ПОТОМУ ЧТО КАРЛИК ПОЧЕМУ
Dialogue: 0,0:03:06.45,0:03:10.69,Caption,,0,0,0,,ТО СИДИТ ЗА СТОЛОМ, ГДЕ ОБСУЖДАЮТ УСТРОЙСТВО ООН. А ДВА ЕВРОПЕЙСКИХ
Dialogue: 0,0:03:10.77,0:03:13.73,Caption,,0,0,0,,МОНСТРА УЗНАЮТ О РАЗГОВОРЕ УЖЕ ПОТОМ. РЕБЯТА,
Dialogue: 0,0:03:14.03,0:03:15.73,Caption,,0,0,0,,ВЫ ТАМ ТОЧНО НИКОГО НЕ ПЕРЕПУТАЛИ?
Dialogue: 0,0:03:16.45,0:03:19.49,Caption,,0,0,0,,ПРОВЕСТИ РЕФОРМУ ООН ВТРОЁМ, КОНЕЧНО,
Dialogue: 0,0:03:19.57,0:03:22.53,Caption,,0,0,0,,НИКТО ПРОСТЫМ ПОДНЯТИЕМ РУКИ НЕ СМОЖЕТ. НО САМ
Dialogue: 0,0:03:22.53,0:03:25.57,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ЖЕСТ УЖЕ ОЧЕНЬ ВЫРАЗИТЕЛЬНЫЙ. РАЗГОВОР
Dialogue: 0,0:03:25.65,0:03:28.37,Caption,,0,0,0,,О БУДУЩЕМ СИСТЕМЫ НАЧИНАЕТСЯ БЕЗ ДВУХ ЕВРОПЕЙСКИХ
Dialogue: 0,0:03:28.37,0:03:31.49,Caption,,0,0,0,,ПОСТОЯННЫХ ЧЛЕНОВ СОВБЕЗА. ТО ЕСТЬ ЯЛТЫ НОМЕР ДВА
Dialogue: 0,0:03:31.49,0:03:36.25,Caption,,0,0,0,,В ЧИСТОМ ВИДЕ НЕ ПОЛУЧИЛОСЬ. И НЕ НАДО ДЕЛАТЬ ВИД,
Dialogue: 0,0:03:36.41,0:03:40.33,Caption,,0,0,0,,БУДТО ПУТИН, ТРАМП И СИ УЖЕ ПОДЕЛИЛИ ГЛОБУС ЛИНЕЙКОЙ. НО
Dialogue: 0,0:03:40.41,0:03:43.13,Caption,,0,0,0,,НАМЁТКИ ПОЯВИЛИСЬ. ПРИЧЁМ РЕЧЬ ИДЁТ НЕ ТОЛЬКО ОБ
Dialogue: 0,0:03:43.13,0:03:46.41,Caption,,0,0,0,,ООН. В ДЕКЛАРАЦИИ ЕСТЬ ЭНЕРГЕТИКА. НА ПЕРВЫЙ ВЗГЛЯД
Dialogue: 0,0:03:46.49,0:03:48.97,Caption,,0,0,0,,ВООБЩЕ СКУКА. ПРОИЗВОДСТВО НЕФТЕПРОДУКТОВ,
Dialogue: 0,0:03:49.07,0:03:53.69,Caption,,0,0,0,,СТАБИЛЬНЫЕ ПОСТАВКИ, ОБЕСПЕЧЕНИЕ РЫНКОВ. УСНУТЬ МОЖНО. А ПОТОМ НАЧИНАЕШЬ
Dialogue: 0,0:03:53.69,0:03:57.53,Caption,,0,0,0,,СМОТРЕТЬ, КТО ЗА ЭТИМ СТОЛОМ СИДИТ. КИТАЙ МОЖЕТ ПЕРЕРАБАТЫВАТЬ
Dialogue: 0,0:03:57.61,0:04:00.49,Caption,,0,0,0,,БОЛЬШЕ НЕФТИ. РОССИЯ МОЖЕТ ПОСТАВЛЯТЬ БОЛЬШЕ СЫРЬЯ.
Dialogue: 0,0:04:00.73,0:04:05.61,Caption,,0,0,0,,ЕСТЬ ИРАН, ЕСТЬ ВЕНЕСУЭЛА, ЕСТЬ АМЕРИКАНСКИЕ ПОСТАВКИ. И СРАЗУ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:04:05.69,0:04:07.93,Caption,,0,0,0,,ПРЕКРАСНЫЙ МАЛЕНЬКИЙ ВОПРОС А ЧТО ДЕЛАТЬ СО ВСЕМИ
Dialogue: 0,0:04:07.93,0:04:10.97,Caption,,0,0,0,,САНКЦИЯМИ, ОГРАНИЧЕНИЯМИ, РАСЧЁТАМИ,
Dialogue: 0,0:04:11.06,0:04:15.85,Caption,,0,0,0,,СТРАХОВАНИЕМ И ТАНКЕРАМИ? ВОТ ЗДЕСЬ КРАСИВЫЕ СЛОВА ЗАКАНЧИВАЮТСЯ. ПОТОМУ ЧТО
Dialogue: 0,0:04:15.93,0:04:18.57,Caption,,0,0,0,,НАСТОЯЩИЙ СМЫСЛ ТАКИХ ДОГОВОРЁННОСТЕЙ ВИДЕН НЕ В
Dialogue: 0,0:04:18.57,0:04:21.61,Caption,,0,0,0,,ТОРЖЕСТВЕННОЙ ДЕКЛАРАЦИИ. ОН ПОЯВЛЯЕТСЯ ПОТОМ. В
Dialogue: 0,0:04:21.61,0:04:25.29,Caption,,0,0,0,,РАЗРЕШЕНИЯХ. В ПЛАТЕЖАХ. В МАРШРУТАХ. В ТОМ,
Dialogue: 0,0:04:25.42,0:04:29.93,Caption,,0,0,0,,КАКОЙ ТАНКЕР ПРОПУСТИЛИ, КАКОЙ БАНК ПРОВЁЛ ДЕНЬГИ И НА КАКОЕ ОГРАНИЧЕНИЕ
Dialogue: 0,0:04:29.93,0:04:32.65,Caption,,0,0,0,,ВДРУГ РЕШИЛИ ПОСМОТРЕТЬ НЕМНОГО ШИРЕ. А ЭТО УЖЕ
Dialogue: 0,0:04:32.73,0:04:35.61,Caption,,0,0,0,,СОВСЕМ ДРУГОЙ РАЗГОВОР. ЕЩЁ ИНТЕРЕСНЕЕ ПУНКТ ПРО
Dialogue: 0,0:04:35.61,0:04:37.69,Caption,,0,0,0,,ИММУНИТЕТЫ ГОСУДАРСТВЕННЫХ РУКОВОДИТЕЛЕЙ И
Dialogue: 0,0:04:37.77,0:04:40.41,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ СУДЫ. ТРИ ДЕРЖАВЫ ФАКТИЧЕСКИ
Dialogue: 0,0:04:40.41,0:04:42.33,Caption,,0,0,0,,ОБОЗНАЧАЮТ ОЧЕНЬ ПРОСТУЮ ПОЗИЦИЮ.
Dialogue: 0,0:04:44.62,0:04:46.86,Caption,,0,0,0,,ВЫ МОЖЕТЕ СТРОИТЬ СКОЛЬКО УГОДНО МЕЖДУНАРОДНЫХ
Dialogue: 0,0:04:46.86,0:04:50.86,Caption,,0,0,0,,КОНСТРУКЦИЙ, НО ПРАВО ВНЕШНИХ СТРУКТУР СУДИТЬ НАШИХ РУКОВОДИТЕЛЕЙ
Dialogue: 0,0:04:50.94,0:04:53.50,Caption,,0,0,0,,МЫ БЕЗУСЛОВНЫМ НЕ ПРИЗНАЁМ. И ЗДЕСЬ МЫ СНОВА
Dialogue: 0,0:04:53.50,0:04:56.46,Caption,,0,0,0,,УПИРАЕМСЯ В ТУ ЖЕ СТЕНУ. В ПОСЛЕДНИЕ ДЕСЯТИЛЕТИЯ
Dialogue: 0,0:04:56.54,0:04:59.18,Caption,,0,0,0,,НАД ГОСУДАРСТВАМИ ВЫРОС ЦЕЛЫЙ ЛЕС ОРГАНИЗАЦИЙ,
Dialogue: 0,0:04:59.33,0:05:02.78,Caption,,0,0,0,,СУДОВ, КОМИССИЙ, АГЕНТСТВ И ПРОЧИХ НАДСТРОЕК,
Dialogue: 0,0:05:03.02,0:05:05.26,Caption,,0,0,0,,КОТОРЫЕ ПОСТЕПЕННО НАЧАЛИ ВЕСТИ СЕБЯ ТАК,
Dialogue: 0,0:05:05.50,0:05:08.06,Caption,,0,0,0,,БУДТО ГОСУДАРСТВО УЖЕ САМО ПО СЕБЕ НЕДОСТАТОЧНО
Dialogue: 0,0:05:08.06,0:05:11.18,Caption,,0,0,0,,ГОСУДАРСТВО. ГДЕ ТО СВЕРХУ ВСЕГДА НАЙДЁТСЯ ЕЩЁ ОДИН
Dialogue: 0,0:05:11.26,0:05:13.98,Caption,,0,0,0,,КАБИНЕТ, КОТОРЫЙ ЛУЧШЕ ЗНАЕТ, КОГО СУДИТЬ,
Dialogue: 0,0:05:14.14,0:05:16.94,Caption,,0,0,0,,КОГО НАКАЗЫВАТЬ И ЧТО СЧИТАТЬ ПРАВИЛЬНЫМ. А ТЕПЕРЬ
Dialogue: 0,0:05:16.94,0:05:20.30,Caption,,0,0,0,,СРАЗУ ТРИ ОГРОМНЫЕ ДЕРЖАВЫ ГОВОРЯТ СТОП. СУВЕРЕНИТЕТ
Dialogue: 0,0:05:20.30,0:05:23.18,Caption,,0,0,0,,ВООБЩЕ ТО ЕЩЁ СУЩЕСТВУЕТ. ДЛЯ ЕВРОПЫ ЭТО ОЧЕНЬ
Dialogue: 0,0:05:23.18,0:05:25.98,Caption,,0,0,0,,НЕПРИЯТНАЯ ТЕМА. ПОТОМУ ЧТО ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:05:25.98,0:05:28.70,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ПОЛИТИЧЕСКОГО ВЛИЯНИЯ КАК РАЗ СТРОИЛАСЬ
Dialogue: 0,0:05:28.78,0:05:31.34,Caption,,0,0,0,,НЕ НА КОЛИЧЕСТВЕ ДИВИЗИЙ, А НА ИНСТИТУТАХ,
Dialogue: 0,0:05:31.42,0:05:35.10,Caption,,0,0,0,,ПРАВИЛАХ, СУДАХ И НАДГОСУДАРСТВЕННЫХ МЕХАНИЗМАХ. И ЕСЛИ
Dialogue: 0,0:05:35.10,0:05:37.82,Caption,,0,0,0,,КРУПНЕЙШИЕ ДЕРЖАВЫ НАЧНУТ ЭТИ МЕХАНИЗМЫ ВСЕРЬЁЗ
Dialogue: 0,0:05:37.82,0:05:41.42,Caption,,0,0,0,,ОГРАНИЧИВАТЬ, НЕКОТОРЫЕ ПРИВЫЧНЫЕ ИНСТРУМЕНТЫ ВНЕЗАПНО СТАНУТ
Dialogue: 0,0:05:41.50,0:05:43.58,Caption,,0,0,0,,ГОРАЗДО КОРОЧЕ. НО ДРУЖБА ДРУЖБОЙ,
Dialogue: 0,0:05:43.82,0:05:46.46,Caption,,0,0,0,,А ЯДЕРНЫЙ ЧЕМОДАНЧИК ЛУЧШЕ ВСЁ ТАКИ ДЕРЖАТЬ РЯДОМ.
Dialogue: 0,0:05:46.99,0:05:49.34,Caption,,0,0,0,,С ЯДЕРНЫМ ПУНКТОМ ВООБЩЕ ПОЛУЧИЛАСЬ ОТДЕЛЬНАЯ
Dialogue: 0,0:05:49.34,0:05:52.62,Caption,,0,0,0,,КРАСОТА. КИТАЙСКАЯ СТОРОНА ПРОДВИГАЛА ИДЕЮ ПОЛНОГО
Dialogue: 0,0:05:52.62,0:05:55.58,Caption,,0,0,0,,ЗАПРЕТА И УНИЧТОЖЕНИЯ ЯДЕРНОГО ОРУЖИЯ. ОЧЕНЬ
Dialogue: 0,0:05:55.66,0:06:02.34,Caption,,0,0,0,,ГУМАННО. ОЧЕНЬ КРАСИВО. ОСОБЕННО КОГДА У ТЕБЯ САМОГО ЯДЕРНЫЙ АРСЕНАЛ МЕНЬШЕ,
Dialogue: 0,0:06:02.66,0:06:05.86,Caption,,0,0,0,,ЧЕМ У ДВУХ ТВОИХ СОБЕСЕДНИКОВ. НЕПЛОХОЙ ХОД. ДАВАЙТЕ
Dialogue: 0,0:06:05.94,0:06:07.46,Caption,,0,0,0,,ВСЕ УБЕРЁМ СО СТОЛА ТОТ КОЗЫРЬ,
Dialogue: 0,0:06:07.70,0:06:10.18,Caption,,0,0,0,,ГДЕ У ВАС ПРЕИМУЩЕСТВО. А У МЕНЯ ОСТАНУТСЯ
Dialogue: 0,0:06:10.18,0:06:12.58,Caption,,0,0,0,,ОГРОМНАЯ ПРОМЫШЛЕННОСТЬ, ЭКОНОМИКА,
Dialogue: 0,0:06:12.68,0:06:16.90,Caption,,0,0,0,,ТЕХНОЛОГИИ, ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ И ПРОИЗВОДСТВО. НОРМАЛЬНАЯ
Dialogue: 0,0:06:16.90,0:06:20.02,Caption,,0,0,0,,ТАКАЯ ДРУЖЕСКАЯ АРИФМЕТИКА. В ИТОГОВОЙ ФОРМУЛИРОВКЕ
Dialogue: 0,0:06:20.10,0:06:23.22,Caption,,0,0,0,,ПОЛНОГО УНИЧТОЖЕНИЯ ЯДЕРНОГО ОРУЖИЯ НЕ ОСТАЛОСЬ. ТАМ
Dialogue: 0,0:06:23.22,0:06:26.10,Caption,,0,0,0,,УЖЕ РАЗГОВОР О СНИЖЕНИИ РИСКОВ И НЕРАСПРОСТРАНЕНИИ.
Dialogue: 0,0:06:26.49,0:06:29.14,Caption,,0,0,0,,ТО ЕСТЬ ХИТРОСТЬ НЕ ПРОШЛА. И ПРАВИЛЬНО. ПОТОМУ
Dialogue: 0,0:06:29.22,0:06:31.70,Caption,,0,0,0,,ЧТО ВСЯ ЭТА НОВАЯ ДРУЖБА СУЩЕСТВУЕТ РОВНО ДО
Dialogue: 0,0:06:31.78,0:06:35.46,Caption,,0,0,0,,ТОГО МОМЕНТА, ПОКА ИНТЕРЕСЫ СОВПАДАЮТ. КАК ТОЛЬКО ИНТЕРЕСЫ
Dialogue: 0,0:06:35.46,0:06:37.86,Caption,,0,0,0,,РАЗЪЕХАЛИСЬ, КАЖДЫЙ СНОВА ВСПОМИНАЕТ,
Dialogue: 0,0:06:38.02,0:06:40.42,Caption,,0,0,0,,ГДЕ У НЕГО ЛЕЖИТ ЧЕМОДАНЧИК. И ВОТ НА
Dialogue: 0,0:06:40.50,0:06:43.38,Caption,,0,0,0,,ЭТОМ ФОНЕ ПРОИСХОДИТ МАЛЕНЬКАЯ ПОЛЬСКАЯ ИСТОРИЯ. ПО
Dialogue: 0,0:06:43.38,0:06:46.02,Caption,,0,0,0,,РЕАКЦИИ ВАШИНГТОНА НА ПОЛЬСКИЙ ЭПИЗОД УЖЕ ВИДНО,
Dialogue: 0,0:06:46.26,0:06:49.38,Caption,,0,0,0,,КАК НОВЫЙ РАСКЛАД НАЧИНАЕТ РАБОТАТЬ НА ПРАКТИКЕ. В
Dialogue: 0,0:06:49.38,0:06:51.54,Caption,,0,0,0,,ПОЛЬСКОМ ВОЗДУШНОМ ПРОСТРАНСТВЕ ОКАЗЫВАЮТСЯ
Dialogue: 0,0:06:51.62,0:06:54.82,Caption,,0,0,0,,РОССИЙСКИЕ РАКЕТЫ И БЕСПИЛОТНИК. ВАРШАВА ПОДНИМАЕТ
Dialogue: 0,0:06:54.82,0:06:59.06,Caption,,0,0,0,,ТРЕВОГУ. ТУСК ГОВОРИТ, ЧТО ЭТО НЕ БЕЗОБИДНЫЙ СЛУЧАЙ И ТРЕБУЕТ НОРМАЛЬНОЙ
Dialogue: 0,0:06:59.06,0:07:01.94,Caption,,0,0,0,,РЕАКЦИИ. А ТРАМП ОТВЕЧАЕТ ПРИМЕРНО ТАК ДА,
Dialogue: 0,0:07:02.09,0:07:06.10,Caption,,0,0,0,,РОССИЙСКИЕ. ДА, ПОПАЛИ В ПОЛЬШУ. СЛУЧАЙНО. НУ И ЧТО Я
Dialogue: 0,0:07:06.18,0:07:10.10,Caption,,0,0,0,,С ЭТИМ СДЕЛАЮ? КРАСИВО. ТУСК ПОСЛЕ ЭТОГО ВЫДАЁТ ПРЕКРАСНУЮ ФРАЗУ
Dialogue: 0,0:07:10.10,0:07:13.06,Caption,,0,0,0,,БОЖЕ, СОХРАНИ НАС ОТ ТАКИХ ДРУЗЕЙ. А ЧТО НЕ
Dialogue: 0,0:07:13.06,0:07:17.98,Caption,,0,0,0,,ТАК? ВЫ ЖЕ ИМЕННО АМЕРИКАНСКОГО ДРУГА СТОЛЬКО ЛЕТ И
Dialogue: 0,0:07:18.06,0:07:21.82,Caption,,0,0,0,,ХОТЕЛИ. БОЛЬШОГО. СИЛЬНОГО. КОТОРЫЙ В НУЖНЫЙ МОМЕНТ
Dialogue: 0,0:07:21.90,0:07:25.18,Caption,,0,0,0,,СТУКНЕТ КУЛАКОМ ПО СТОЛУ. ВОТ НУЖНЫЙ МОМЕНТ ПРИШЁЛ.
Dialogue: 0,0:07:25.66,0:07:27.26,Caption,,0,0,0,,А ДРУГ ТОЛЬКО ЧТО ВЕРНУЛСЯ С РАЗГОВОРА С
Dialogue: 0,0:07:27.26,0:07:29.66,Caption,,0,0,0,,ПУТИНЫМ И СИ ЦЗИНЬПИНОМ И ПОЧЕМУ ТО СОВЕРШЕННО
Dialogue: 0,0:07:29.66,0:07:32.46,Caption,,0,0,0,,НЕ ГОРИТ ЖЕЛАНИЕМ УСТРАИВАТЬ НОВЫЙ ВИТОК ЭСКАЛАЦИИ
Dialogue: 0,0:07:32.54,0:07:36.62,Caption,,0,0,0,,РАДИ ТОГО, ЧТОБЫ ТУСК ПОЧУВСТВОВАЛ СЕБЯ СПОКОЙНЕЕ. ВОТ ВАМ ЕЩЁ
Dialogue: 0,0:07:36.70,0:07:38.38,Caption,,0,0,0,,ОДНО МАЛЕНЬКОЕ ПОДТВЕРЖДЕНИЕ ТОГО,
Dialogue: 0,0:07:38.54,0:07:41.82,Caption,,0,0,0,,ЧТО ГЕГЕМОН СДУЛСЯ. НЕ АМЕРИКА СДУЛАСЬ. СДУЛОСЬ
Dialogue: 0,0:07:41.82,0:07:45.66,Caption,,0,0,0,,АВТОМАТИЧЕСКОЕ ПРАВИЛО, ПО КОТОРОМУ ВАШИНГТОН ДОЛЖЕН БЫЛ КАЖДЫЙ РАЗ
Dialogue: 0,0:07:45.66,0:07:48.22,Caption,,0,0,0,,ОБСЛУЖИВАТЬ ЕВРОПЕЙСКУЮ ТРАКТОВКУ ПРОИСХОДЯЩЕГО.
Dialogue: 0,0:07:48.61,0:07:51.18,Caption,,0,0,0,,ПОЛЬША ГОВОРИТ ЭТО ТРЕБУЕТ РЕАКЦИИ. ВАШИНГТОН
Dialogue: 0,0:07:51.26,0:07:54.86,Caption,,0,0,0,,ГОВОРИТ УСПОКОЙТЕСЬ, ЭТО БЫЛА ОШИБКА. ПОЛЬША ГОВОРИТ МЫ НЕ СОГЛАСНЫ
Dialogue: 0,0:07:54.94,0:07:56.94,Caption,,0,0,0,,С ВАШЕЙ ОЦЕНКОЙ. НУ НЕ СОГЛАСНЫ И НЕ
Dialogue: 0,0:07:56.94,0:07:59.82,Caption,,0,0,0,,СОГЛАСНЫ. И ЗДЕСЬ ОСОБЕННО ВЕСЕЛО ВЫГЛЯДИТ ИСТОРИЯ С
Dialogue: 0,0:07:59.82,0:08:02.62,Caption,,0,0,0,,ПОЛЬСКИМИ ПЭТРИОТАМИ. РАНЬШЕ КИЕВУ ОБЪЯСНЯЛИ,
Dialogue: 0,0:08:02.81,0:08:05.66,Caption,,0,0,0,,ЧТО ДОПОЛНИТЕЛЬНЫЕ РАКЕТЫ ПЕРЕДАВАТЬ НЕЛЬЗЯ. САМИМ
Dialogue: 0,0:08:05.66,0:08:10.78,Caption,,0,0,0,,НУЖНЫ. ЛОГИЧНО. СОСЕД ВОЮЕТ, МАЛО ЛИ ЧТО ПРИЛЕТИТ. И ВОТ ПРИЛЕТЕЛО. ПОСЛЕ
Dialogue: 0,0:08:10.86,0:08:13.42,Caption,,0,0,0,,ЧЕГО КОМПЛЕКСЫ ПЭТРИОТ СРОЧНО ПРИВОДЯТ В ПОЛНУЮ
Dialogue: 0,0:08:13.42,0:08:16.70,Caption,,0,0,0,,БОЕВУЮ ГОТОВНОСТЬ. ТАК СТОП. РАКЕТЫ САМИМ НУЖНЫ.
Dialogue: 0,0:08:16.86,0:08:19.34,Caption,,0,0,0,,ХОРОШО. А КОМПЛЕКСЫ ДО ЭТОГО В КАКОМ РЕЖИМЕ
Dialogue: 0,0:08:19.42,0:08:21.50,Caption,,0,0,0,,БЫЛИ? ПОЛУЧАЕТСЯ СТРАННАЯ КАРТИНА.
Dialogue: 0,0:08:23.79,0:08:26.27,Caption,,0,0,0,,ДОРОГУЩАЯ СИСТЕМА СУЩЕСТВУЕТ ИМЕННО ДЛЯ ТАКИХ
Dialogue: 0,0:08:26.35,0:08:29.79,Caption,,0,0,0,,СЛУЧАЕВ, НО МАКСИМАЛЬНУЮ ГОТОВНОСТЬ ЕЙ УСТРАИВАЮТ УЖЕ ПОСЛЕ
Dialogue: 0,0:08:29.79,0:08:32.99,Caption,,0,0,0,,ТОГО, КАК ДВЕ РАКЕТЫ И БЕСПИЛОТНИК ОКАЗАЛИСЬ НАД ПОЛЬСКОЙ
Dialogue: 0,0:08:32.99,0:08:36.59,Caption,,0,0,0,,ТЕРРИТОРИЕЙ. ДАЛЬШЕ ЕЩЁ ИНТЕРЕСНЕЕ. ШВЕДСКИЙ ГРИПЕН
Dialogue: 0,0:08:36.59,0:08:39.71,Caption,,0,0,0,,СОПРОВОЖДАЛ Х СТО ОДИН. ПИЛОТ ПОЛУЧИЛ РАЗРЕШЕНИЕ НА
Dialogue: 0,0:08:39.71,0:08:43.07,Caption,,0,0,0,,ПРИМЕНЕНИЕ ОРУЖИЯ. ЦЕЛЬ ВИДЕЛ НА ПРИБОРАХ. НО ПОГОДА
Dialogue: 0,0:08:43.07,0:08:46.67,Caption,,0,0,0,,БЫЛА ПЛОХАЯ, ПОДТВЕРДИТЬ ЕЁ ВИЗУАЛЬНО И ОПТИЧЕСКИМИ СРЕДСТВАМИ НЕ
Dialogue: 0,0:08:46.67,0:08:50.51,Caption,,0,0,0,,ПОЛУЧИЛОСЬ, ПОЭТОМУ СТРЕЛЯТЬ НЕ СТАЛ. ПОЛЬСКИЕ ЭФ ШЕСТНАДЦАТЬ
Dialogue: 0,0:08:50.51,0:08:53.63,Caption,,0,0,0,,ТОЖЕ УЧАСТВОВАЛИ. И ТОЖЕ НЕ ОТКРЫЛИ ОГОНЬ. БЫЛ
Dialogue: 0,0:08:53.63,0:08:56.91,Caption,,0,0,0,,САМОЛЁТ ДАЛЬНЕГО ОБНАРУЖЕНИЯ. БЫЛ ЗАПРАВЩИК. БЫЛА
Dialogue: 0,0:08:56.91,0:09:00.43,Caption,,0,0,0,,АВИАЦИЯ. ЕСТЬ ПЭТРИОТ. А РАКЕТА ВСЁ РАВНО ПРИЛЕТЕЛА.
Dialogue: 0,0:09:00.71,0:09:03.47,Caption,,0,0,0,,ВОТ ТАК РАБОТАЕТ РЕАЛЬНАЯ ЖИЗНЬ. ОНА ОЧЕНЬ ПЛОХО
Dialogue: 0,0:09:03.47,0:09:05.95,Caption,,0,0,0,,СМОТРИТ РЕКЛАМНЫЕ БУКЛЕТЫ. МОЖНО НА БУМАГЕ
Dialogue: 0,0:09:05.95,0:09:08.67,Caption,,0,0,0,,НАРИСОВАТЬ ИДЕАЛЬНЫЙ ЗАЩИТНЫЙ КУПОЛ. НО ПОТОМ
Dialogue: 0,0:09:08.67,0:09:11.47,Caption,,0,0,0,,ПРИХОДЯТ ПОГОДА, ПРАВИЛА ПРИМЕНЕНИЯ ОРУЖИЯ,
Dialogue: 0,0:09:11.74,0:09:14.75,Caption,,0,0,0,,СЕКУНДЫ НА РЕШЕНИЕ, НЕЯСНАЯ ОТМЕТКА НА РАДАРЕ,
Dialogue: 0,0:09:15.07,0:09:18.19,Caption,,0,0,0,,ЧУЖАЯ ГРАНИЦА И СТРАХ ОШИБИТЬСЯ. И ВСЁ. ВСЯ
Dialogue: 0,0:09:18.27,0:09:21.47,Caption,,0,0,0,,КРАСИВАЯ СХЕМА НАЧИНАЕТ СКРИПЕТЬ. ЕСЛИ ВАМ ИНТЕРЕСЕН
Dialogue: 0,0:09:21.47,0:09:24.35,Caption,,0,0,0,,ИМЕННО ТАКОЙ РАЗБОР, А НЕ ПРОСТО ПОТОК ЗАГОЛОВКОВ,
Dialogue: 0,0:09:24.54,0:09:27.15,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:09:27.24,0:09:30.51,Caption,,0,0,0,,ЧТО ЗДЕСЬ ВАЖНЕЕ САМА РАКЕТА ИЛИ РЕАКЦИЯ ВАШИНГТОНА
Dialogue: 0,0:09:30.59,0:09:33.47,Caption,,0,0,0,,НА НЕЁ? ПОТОМУ ЧТО С РАКЕТАМИ ЕСТЬ ЕЩЁ ОДНА ОЧЕНЬ
Dialogue: 0,0:09:33.47,0:09:39.02,Caption,,0,0,0,,НЕПРИЯТНАЯ ДЕТАЛЬ. ОНИ ПОЯВИЛИСЬ НА ФОНЕ УЧЕНИЙ В НОВОЙ ДЕМБЕ,
Dialogue: 0,0:09:39.30,0:09:41.74,Caption,,0,0,0,,ГДЕ ТЫСЯЧИ ВОЕННЫХ ИЗ ОДИННАДЦАТИ ГОСУДАРСТВ
Dialogue: 0,0:09:41.74,0:09:43.42,Caption,,0,0,0,,РЕПЕТИРОВАЛИ ПЕРЕБРОСКУ ВОЙСК,
Dialogue: 0,0:09:43.58,0:09:47.50,Caption,,0,0,0,,СНАБЖЕНИЕ, УПРАВЛЕНИЕ КОНТИНГЕНТОМ И ЗАЩИТУ ОТ БЕСПИЛОТНИКОВ.
Dialogue: 0,0:09:47.95,0:09:50.29,Caption,,0,0,0,,ТО ЕСТЬ ГОТОВИЛИСЬ К ТОЙ САМОЙ БОЛЬШОЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:09:50.29,0:09:53.02,Caption,,0,0,0,,МИССИИ НА УКРАИНЕ ПОСЛЕ ЗАВЕРШЕНИЯ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:09:53.34,0:09:55.98,Caption,,0,0,0,,И ТУТ РЯДОМ ПАДАЮТ РАКЕТЫ. ВЕРСИЙ ЗДЕСЬ ДВЕ.
Dialogue: 0,0:09:56.27,0:09:59.58,Caption,,0,0,0,,ПЕРВАЯ, МОСКВА ТАКИМ ОБРАЗОМ ПРОВЕРЯЛА ПОЛЬСКУЮ ПВО И
Dialogue: 0,0:09:59.58,0:10:02.46,Caption,,0,0,0,,РЕАКЦИЮ НАТО. ИМЕННО ТАКУЮ ТРАКТОВКУ НАЧАЛИ
Dialogue: 0,0:10:02.54,0:10:05.17,Caption,,0,0,0,,ОБСУЖДАТЬ ЗАПАДНЫЕ ЭКСПЕРТЫ. ВТОРАЯ,
Dialogue: 0,0:10:05.34,0:10:07.74,Caption,,0,0,0,,ОДНА ИЗ РАКЕТ ИЗМЕНИЛА ТРАЕКТОРИЮ ПОСЛЕ РАБОТЫ
Dialogue: 0,0:10:07.74,0:10:11.50,Caption,,0,0,0,,УКРАИНСКОЙ ПВО, ПОЭТОМУ НАМЕРЕННОГО РОССИЙСКОГО УДАРА ПО ПОЛЬСКОЙ
Dialogue: 0,0:10:11.58,0:10:13.90,Caption,,0,0,0,,ТЕРРИТОРИИ ВООБЩЕ НЕ БЫЛО. И ЗНАЕТЕ,
Dialogue: 0,0:10:14.07,0:10:18.22,Caption,,0,0,0,,ЧТО СМЕШНО? ДЛЯ ЕВРОПЕЙЦЕВ ОБЕ ВЕРСИИ ПАРШИВЫЕ. ЕСЛИ ПЕРВАЯ
Dialogue: 0,0:10:18.22,0:10:20.22,Caption,,0,0,0,,ВЕРНА, ЗНАЧИТ КТО ТО ПРОВЕРЯЕТ,
Dialogue: 0,0:10:20.36,0:10:23.02,Caption,,0,0,0,,НАСКОЛЬКО ХОРОШО ОНИ ГОТОВЫ К ТОЙ САМОЙ МИССИИ,
Dialogue: 0,0:10:23.23,0:10:25.58,Caption,,0,0,0,,КОТОРУЮ СОБИРАЮТСЯ ОТПРАВЛЯТЬ НА УКРАИНУ. ЕСЛИ
Dialogue: 0,0:10:25.58,0:10:29.10,Caption,,0,0,0,,ВТОРАЯ, ЗНАЧИТ ЕВРОПЕЙСКИЙ КОНТИНГЕНТ СОБИРАЮТСЯ ОТПРАВЛЯТЬ
Dialogue: 0,0:10:29.10,0:10:33.02,Caption,,0,0,0,,ТУДА, ГДЕ ДАЖЕ ЧУЖАЯ РАБОТА ПВО СПОСОБНА ВНЕЗАПНО ПРИСЛАТЬ
Dialogue: 0,0:10:33.02,0:10:35.90,Caption,,0,0,0,,ВОСЬМИСОТКИЛОГРАММОВУЮ БОЕВУЮ ЧАСТЬ В СОВЕРШЕННО
Dialogue: 0,0:10:35.90,0:10:39.02,Caption,,0,0,0,,ДРУГУЮ СТРАНУ. ПРЕКРАСНАЯ РЕПЕТИЦИЯ. НО ЕЩЁ
Dialogue: 0,0:10:39.02,0:10:42.05,Caption,,0,0,0,,ИНТЕРЕСНЕЕ ТО, ЧТО ПРОИСХОДИТ УЖЕ НЕ НАД ПОЛЬШЕЙ,
Dialogue: 0,0:10:42.30,0:10:44.93,Caption,,0,0,0,,А МЕЖДУ ВАШИНГТОНОМ И ЕВРОПЕЙСКИМИ СТОЛИЦАМИ.
Dialogue: 0,0:10:47.22,0:10:50.02,Caption,,0,0,0,,ТРАМП ПОСЛЕ ПЕРЕГОВОРОВ С ПУТИНЫМ И СИ ПОДКЛЮЧАЕТСЯ
Dialogue: 0,0:10:50.10,0:10:52.42,Caption,,0,0,0,,ПРЯМО С БОРТА САМОЛЁТА К ЕВРОПЕЙСКОЙ ВСТРЕЧЕ В
Dialogue: 0,0:10:52.42,0:10:55.62,Caption,,0,0,0,,БЕРЛИНЕ. ЗВОНИТ КУШНЕРУ. КУШНЕР ВКЛЮЧАЕТ ГРОМКУЮ
Dialogue: 0,0:10:55.62,0:10:58.82,Caption,,0,0,0,,СВЯЗЬ. И ТАМ КАК РАЗ ОБСУЖДАЮТ ОЧЕРЕДНЫЕ СЕМЬДЕСЯТ
Dialogue: 0,0:10:58.82,0:11:03.46,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ДЛЯ УКРАИНЫ. ТРАМП СЛУШАЕТ ВСЁ ЭТО И ЗАДАЁТ ВОПРОС А
Dialogue: 0,0:11:03.54,0:11:08.42,Caption,,0,0,0,,ДАЛЬШЕ ТО ЧТО? ОН ЗАЯВЛЯЕТ, ЧТО ПУТИН НАСТРОЕН НА СОГЛАШЕНИЕ. ГОВОРИТ,
Dialogue: 0,0:11:08.66,0:11:11.46,Caption,,0,0,0,,ЧТО НАДО КОНЦЕНТРИРОВАТЬСЯ НА ПРЕКРАЩЕНИИ КОНФЛИКТА.
Dialogue: 0,0:11:11.67,0:11:14.58,Caption,,0,0,0,,И ДОВОЛЬНО ПРОХЛАДНО СМОТРИТ НА ИДЕЮ ПРОСТО ПРИНЕСТИ
Dialogue: 0,0:11:14.58,0:11:18.02,Caption,,0,0,0,,КИЕВУ ЕЩЁ ОДНУ ОГРОМНУЮ ПАЧКУ ДЕНЕГ. ПРИЧЁМ РАЗНЫЕ
Dialogue: 0,0:11:18.02,0:11:20.98,Caption,,0,0,0,,УЧАСТНИКИ РАЗГОВОРА ОПИСЫВАЮТ ЕГО ПО РАЗНОМУ. КТО ТО
Dialogue: 0,0:11:21.06,0:11:24.26,Caption,,0,0,0,,ГОВОРИТ, ЧТО ТРАМП БЫЛ РЕЗКИМ И ЭМОЦИОНАЛЬНЫМ. КТО ТО
Dialogue: 0,0:11:24.26,0:11:26.98,Caption,,0,0,0,,ОПИСЫВАЕТ РАЗГОВОР СПОКОЙНЕЕ. НО СОДЕРЖАНИЕ ОТ ЭТОГО
Dialogue: 0,0:11:27.06,0:11:30.82,Caption,,0,0,0,,НЕ МЕНЯЕТСЯ. ЕВРОПА ГОВОРИТ ЕЩЁ ДЕНЕГ. ТРАМП ГОВОРИТ
Dialogue: 0,0:11:30.93,0:11:34.58,Caption,,0,0,0,,А ПЕРЕГОВОРЫ? И ВОТ ЗДЕСЬ ХОЧЕТСЯ ЗАДАТЬ СОВСЕМ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:11:34.67,0:11:38.10,Caption,,0,0,0,,ХОРОШО. ДАДИТЕ ЕЩЁ СЕМЬДЕСЯТ МИЛЛИАРДОВ. ПОТОМ ЕЩЁ.
Dialogue: 0,0:11:38.34,0:11:40.90,Caption,,0,0,0,,ПОТОМ ЕЩЁ. А ДО КАКОЙ ТОЧКИ ВЫ СОБИРАЕТЕСЬ
Dialogue: 0,0:11:40.98,0:11:44.66,Caption,,0,0,0,,ИДТИ? ДО МОСКВЫ? ДО УРАЛА? ГДЕ ТА САМАЯ ТОЧКА,
Dialogue: 0,0:11:44.83,0:11:47.46,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ СМОГУТ ВЫЙТИ
Dialogue: 0,0:11:47.54,0:11:49.22,Caption,,0,0,0,,К СВОИМ ИЗБИРАТЕЛЯМ И СКАЗАТЬ ВСЁ,
Dialogue: 0,0:11:49.32,0:11:51.94,Caption,,0,0,0,,РЕБЯТА, ПОБЕДИЛИ, МОЖНО БОЛЬШЕ НЕ ПЛАТИТЬ?
Dialogue: 0,0:11:52.42,0:11:54.82,Caption,,0,0,0,,ПОТОМУ ЧТО СТРАТЕГИЯ ИЗ ОДНОГО СЛОВА "ДАЛЬШЕ" ЭТО
Dialogue: 0,0:11:54.83,0:11:57.70,Caption,,0,0,0,,ОЧЕНЬ ИНТЕРЕСНАЯ СТРАТЕГИЯ. ОСОБЕННО КОГДА СЧЁТ
Dialogue: 0,0:11:57.78,0:11:59.54,Caption,,0,0,0,,КАЖДЫЙ РАЗ ОПЛАЧИВАЕТ КТО ТО ДРУГОЙ.
Dialogue: 0,0:12:01.75,0:12:04.31,Caption,,0,0,0,,А ТЕПЕРЬ КУШНЕР ДОБАВЛЯЕТ ЕЩЁ ОДНУ ЗАМЕЧАТЕЛЬНУЮ
Dialogue: 0,0:12:04.39,0:12:08.87,Caption,,0,0,0,,ДЕТАЛЬ. ПО ЕГО СЛОВАМ, ТРАМП БЫЛ БЫ СЧАСТЛИВ ВООБЩЕ ПРЕКРАТИТЬ ПРОДАЖИ
Dialogue: 0,0:12:08.95,0:12:12.71,Caption,,0,0,0,,ОРУЖИЯ УКРАИНЕ, ЕСЛИ ЭТО ПОМОЖЕТ ЗАКОНЧИТЬ КОНФЛИКТ. ДОХОДЫ
Dialogue: 0,0:12:12.71,0:12:14.95,Caption,,0,0,0,,ОБОРОННОЙ ПРОМЫШЛЕННОСТИ, ГОВОРИТ КУШНЕР,
Dialogue: 0,0:12:15.27,0:12:17.99,Caption,,0,0,0,,ДЛЯ АМЕРИКАНСКОЙ ЭКОНОМИКИ НЕ ТАКАЯ ВЕЛИКАЯ ПОТЕРЯ.
Dialogue: 0,0:12:18.31,0:12:21.11,Caption,,0,0,0,,ДЕНЬГИ МОЖНО НАПРАВИТЬ НА ДРУГИЕ ВЕЩИ. ПРЕКРАСНО.
Dialogue: 0,0:12:21.51,0:12:24.07,Caption,,0,0,0,,ТОГДА ЕСТЬ СОВСЕМ ПРОСТОЙ ВОПРОС. ЧТО МЕШАЕТ
Dialogue: 0,0:12:24.15,0:12:26.15,Caption,,0,0,0,,ПРЕКРАТИТЬ ПРЯМО СЕЙЧАС? ВОТ ОН,
Dialogue: 0,0:12:26.31,0:12:30.07,Caption,,0,0,0,,ПРЕКРАСНЫЙ МОМЕНТ, КОГДА КРАСИВЫЕ СЛОВА СТАЛКИВАЮТСЯ С КАССОВЫМ
Dialogue: 0,0:12:30.15,0:12:32.95,Caption,,0,0,0,,АППАРАТОМ. С ОДНОЙ СТОРОНЫ, ВАШИНГТОН ГОВОРИТ,
Dialogue: 0,0:12:33.15,0:12:35.67,Caption,,0,0,0,,ЧТО ХОЧЕТ ЗАКОНЧИТЬ КОНФЛИКТ. С ДРУГОЙ,
Dialogue: 0,0:12:35.81,0:12:38.31,Caption,,0,0,0,,ОРУЖИЕ ПРОДОЛЖАЕТ ПРОДАВАТЬСЯ. С ТРЕТЬЕЙ,
Dialogue: 0,0:12:38.39,0:12:42.31,Caption,,0,0,0,,ЕВРОПА ПЛАТИТ. С ЧЕТВЁРТОЙ, ТРАМП УЖЕ СПРАШИВАЕТ ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:12:42.55,0:12:45.83,Caption,,0,0,0,,ЗАЧЕМ ОНИ ХОТЯТ ЗАНОСИТЬ ЕЩЁ ДЕСЯТКИ МИЛЛИАРДОВ. И
Dialogue: 0,0:12:45.91,0:12:48.55,Caption,,0,0,0,,ВСЁ ЭТО ПРОИСХОДИТ ОДНОВРЕМЕННО. ВОТ ПОЭТОМУ
Dialogue: 0,0:12:48.63,0:12:51.83,Caption,,0,0,0,,НЫНЕШНЯЯ ИСТОРИЯ НАМНОГО БОЛЬШЕ УКРАИНЫ. УКРАИНСКИЙ
Dialogue: 0,0:12:51.91,0:12:54.63,Caption,,0,0,0,,КОНФЛИКТ ЗДЕСЬ ВСЁ СИЛЬНЕЕ ВЫГЛЯДИТ НЕ ЦЕНТРОМ ВСЕЙ
Dialogue: 0,0:12:54.63,0:12:58.23,Caption,,0,0,0,,КОНСТРУКЦИИ, А ОДНИМ ИЗ ВОПРОСОВ ВНУТРИ ГОРАЗДО БОЛЕЕ КРУПНОГО
Dialogue: 0,0:12:58.31,0:13:03.83,Caption,,0,0,0,,ТОРГА. РОССИЯ, США И КИТАЙ ОБСУЖДАЮТ ООН. ОБСУЖДАЮТ ЭНЕРГЕТИКУ.
Dialogue: 0,0:13:04.07,0:13:07.27,Caption,,0,0,0,,ОБСУЖДАЮТ СУВЕРЕНИТЕТ. ОБСУЖДАЮТ МЕЖДУНАРОДНЫЕ СУДЫ.
Dialogue: 0,0:13:07.53,0:13:10.55,Caption,,0,0,0,,ОБСУЖДАЮТ ЯДЕРНЫЕ РИСКИ. А ЕВРОПЕЙЦЫ В ЭТО ВРЕМЯ
Dialogue: 0,0:13:10.55,0:13:14.15,Caption,,0,0,0,,СПОРЯТ, СКОЛЬКО ЕЩЁ МИЛЛИАРДОВ ДАТЬ КИЕВУ И НАСКОЛЬКО СИЛЬНО
Dialogue: 0,0:13:14.15,0:13:16.39,Caption,,0,0,0,,ТРАМП ДОЛЖЕН ВОЗМУТИТЬСЯ РАКЕТОЙ В ПОЛЬШЕ.
Dialogue: 0,0:13:18.68,0:13:21.72,Caption,,0,0,0,,МАСШТАБЫ РАЗГОВОРОВ НЕМНОГО РАЗНЫЕ. А ПРЕДМЕТ ТОРГА
Dialogue: 0,0:13:21.72,0:13:24.44,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО ШИРЕ УКРАИНЫ. ЕСЛИ ЭТИ ТРОЕ
Dialogue: 0,0:13:24.52,0:13:26.92,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО НАЧНУТ ДОГОВАРИВАТЬСЯ ПО КРУПНОМУ,
Dialogue: 0,0:13:27.16,0:13:29.32,Caption,,0,0,0,,ОНИ БУДУТ ДЕЛИТЬ НЕ УКРАИНУ. ОНИ БУДУТ
Dialogue: 0,0:13:29.32,0:13:32.52,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ О ГОРАЗДО БОЛЕЕ ШИРОКИХ ПРАВИЛАХ. КТО
Dialogue: 0,0:13:32.60,0:13:35.88,Caption,,0,0,0,,ТОРГУЕТ. КТО ПОЛУЧАЕТ ДОСТУП К РЫНКАМ. КАК РАБОТАЮТ
Dialogue: 0,0:13:35.88,0:13:39.16,Caption,,0,0,0,,САНКЦИИ. КТО ОПРЕДЕЛЯЕТ МЕЖДУНАРОДНЫЕ НОРМЫ. КАКИЕ
Dialogue: 0,0:13:39.24,0:13:41.80,Caption,,0,0,0,,ГОСУДАРСТВА ИМЕЮТ ПРАВО ВМЕШИВАТЬСЯ В ДЕЛА ДРУГИХ.
Dialogue: 0,0:13:42.09,0:13:44.28,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЕТСЯ ВЛАСТЬ НАДГОСУДАРСТВЕННЫХ
Dialogue: 0,0:13:44.28,0:13:47.64,Caption,,0,0,0,,СТРУКТУР. КАК СНИЖАЮТСЯ ЯДЕРНЫЕ РИСКИ. ВОТ КАКОЙ
Dialogue: 0,0:13:47.72,0:13:49.88,Caption,,0,0,0,,ТОРТ ЛЕЖИТ НА СТОЛЕ. И ГДЕ НА ЭТОМ
Dialogue: 0,0:13:49.88,0:13:54.92,Caption,,0,0,0,,СТОЛЕ ЕВРОПА? ПОКА РЯДОМ. ПОКА ВАЖНА. ПОКА ОГРОМНЫЙ РЫНОК. ПОКА
Dialogue: 0,0:13:54.92,0:13:58.36,Caption,,0,0,0,,СОЮЗНИК США. НО ЕСЛИ ЕВРОПЕЙСКИЕ СТОЛИЦЫ ПРОДОЛЖАТ
Dialogue: 0,0:13:58.44,0:14:00.92,Caption,,0,0,0,,ВЕСТИ СЕБЯ ТАК, СЛОВНО НИЧЕГО НЕ ИЗМЕНИЛОСЬ,
Dialogue: 0,0:14:01.24,0:14:03.64,Caption,,0,0,0,,КАРЕТА ОДНАЖДЫ ДЕЙСТВИТЕЛЬНО МОЖЕТ ПРЕВРАТИТЬСЯ В
Dialogue: 0,0:14:03.64,0:14:07.80,Caption,,0,0,0,,ТЫКВУ. НЕ ПОТОМУ, ЧТО КТО ТО ЗАВТРА ОТМЕНИТ ЕВРОПУ. А ПОТОМУ,
Dialogue: 0,0:14:08.11,0:14:10.76,Caption,,0,0,0,,ЧТО ВЛИЯНИЕ НЕ СУЩЕСТВУЕТ САМО ПО СЕБЕ. ОНО
Dialogue: 0,0:14:10.76,0:14:15.40,Caption,,0,0,0,,СУЩЕСТВУЕТ РОВНО ДО ТЕХ ПОР, ПОКА ДРУГИЕ КРУПНЫЕ ИГРОКИ СЧИТАЮТ НУЖНЫМ С ТОБОЙ
Dialogue: 0,0:14:15.40,0:14:17.80,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ. И ЭТО, ПОЖАЛУЙ,
Dialogue: 0,0:14:17.88,0:14:19.72,Caption,,0,0,0,,ГЛАВНЫЙ ИТОГ ВСЕЙ ЭТОЙ ИСТОРИИ.
Dialogue: 0,0:14:20.40,0:14:24.44,Caption,,0,0,0,,ГЕГЕМОН СДУЛСЯ. НЕ РУХНУЛ. НЕ ИСЧЕЗ. НЕ ПРЕВРАТИЛСЯ
Dialogue: 0,0:14:24.44,0:14:26.84,Caption,,0,0,0,,В СЛАБУЮ СТРАНУ. ОН ПРОСТО ПЕРЕСТАЛ БЫТЬ
Dialogue: 0,0:14:26.92,0:14:28.60,Caption,,0,0,0,,ЕДИНСТВЕННЫМ ЧЕЛОВЕКОМ В КОМНАТЕ,
Dialogue: 0,0:14:28.84,0:14:33.24,Caption,,0,0,0,,КОТОРЫЙ РЕШАЕТ, КОГДА НАЧИНАЕТСЯ СОВЕЩАНИЕ И КТО ИМЕЕТ ПРАВО ОТКРЫТЬ
Dialogue: 0,0:14:33.24,0:14:38.33,Caption,,0,0,0,,РОТ. ТЕПЕРЬ ЗА СТОЛОМ СИДЯТ ТРОЕ. ОНИ ДРУГ ДРУГУ
Dialogue: 0,0:14:38.41,0:14:41.29,Caption,,0,0,0,,НЕ ДОВЕРЯЮТ. ОНИ БУДУТ ТОРГОВАТЬСЯ. БУДУТ ПЫТАТЬСЯ
Dialogue: 0,0:14:41.37,0:14:44.41,Caption,,0,0,0,,ДРУГ ДРУГА ПЕРЕИГРАТЬ. КИТАЙ УЖЕ ПОПРОБОВАЛ КРАСИВЫЙ
Dialogue: 0,0:14:44.41,0:14:47.21,Caption,,0,0,0,,НОМЕР С ЯДЕРНЫМ ОРУЖИЕМ. АМЕРИКА БУДЕТ ТЯНУТЬ В
Dialogue: 0,0:14:47.29,0:14:50.25,Caption,,0,0,0,,СВОЮ СТОРОНУ. РОССИЯ В СВОЮ. НО САМ ФАКТ
Dialogue: 0,0:14:50.33,0:14:53.21,Caption,,0,0,0,,ЭТОГО СТОЛА УЖЕ МЕНЯЕТ ВСЁ. И ПОЛЬСКИЕ РАКЕТЫ
Dialogue: 0,0:14:53.29,0:14:55.53,Caption,,0,0,0,,ЗДЕСЬ ВСЕГО ЛИШЬ МАЛЕНЬКАЯ КОНТРОЛЬНАЯ ЛАМПОЧКА НА
Dialogue: 0,0:14:55.61,0:14:58.25,Caption,,0,0,0,,ПРИБОРНОЙ ПАНЕЛИ. ПОЛЬША ПОТРЕБОВАЛА ПРИВЫЧНОЙ
Dialogue: 0,0:14:58.25,0:15:01.05,Caption,,0,0,0,,РЕАКЦИИ ОТ СТАРОЙ АМЕРИКИ. А ОТВЕТИЛА ЕЙ УЖЕ
Dialogue: 0,0:15:01.05,0:15:04.17,Caption,,0,0,0,,НЕМНОГО ДРУГАЯ АМЕРИКА. И ЕСЛИ ЭТА БОЛЬШАЯ ТРОЙКА
Dialogue: 0,0:15:04.17,0:15:08.17,Caption,,0,0,0,,СОБЕРЁТСЯ ВТОРОЙ РАЗ, ВОТ ТОГДА ЕВРОПЕЙЦАМ СТОИТ СМОТРЕТЬ НЕ СТОЛЬКО НА
Dialogue: 0,0:15:08.17,0:15:12.25,Caption,,0,0,0,,ФОТОГРАФИИ ПУТИНА, ТРАМПА И СИ. ИМ ЛУЧШЕ ПОСМОТРЕТЬ НА СТУЛЬЯ.
Dialogue: 0,0:15:12.62,0:15:14.89,Caption,,0,0,0,,И ПОСЧИТАТЬ, СКОЛЬКО ИХ СТОИТ ЗА СТОЛОМ.
